from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_set_difference(a, b):
    return a.difference(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Form = Sq | Ci | Wedge
journal: list[str] = []
def traced(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [5, 3]))
print((out, journal))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([5, 1, 9, -1]))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 2
        return n
    return next_
clock = ticker(7)
print((clock(None), clock(None), clock(None)))
log: list[str] = ["dee", "dee", "bo", "eli", "ada", "cy", "cy", "dee", "dee", "eli"]
m = dict()
for w in log:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
hist: dict[str, int] = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(hist)))
sa: set[int] = set([1, 2, 4, 10, 16, 18])
sb: set[int] = set([1, 3, 4, 7, 11, 19])
print(_pf_sort(list(_pf_set_difference(sa, sb))))
print((len(sa), 4 in sb, _pf_set_is_subset(set([1]), sa)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, hist))
print((_pf_map_try_find("cy", hist), "cy" in hist))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((7, 7)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 3)))
def adjust(n: int) -> int:
    _pf_t1 = n % 3
    if _pf_t1 == 0:
        _n = n // 3
        return _n + 9
    else:
        k = _pf_t1
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(adjust, [26, 7, 23, 17]))
def extent(s: Form) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(9), Ci(5), Wedge(3, 1), Wedge(1, 9)]))
