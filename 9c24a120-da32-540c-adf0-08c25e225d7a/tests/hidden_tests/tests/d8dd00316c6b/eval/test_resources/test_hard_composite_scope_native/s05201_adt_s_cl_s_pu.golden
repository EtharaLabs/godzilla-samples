from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    _1: str
    def __repr__(self):
        return f"Rest({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    def __repr__(self):
        return "Turn"
_Turn: Turn = Turn()
Msg = Store | Rest | Jump | Turn
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
def render(t: Msg) -> str:
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    else:
        if isinstance(t, Rest):
            n0 = t._0
            s1 = t._1
            if 0 <= n0 < 14:
                return f"rest!({n0},{s1})"
        if isinstance(t, Rest):
            n0 = t._0
            s1 = t._1
            return f"rest({n0},{s1})"
        elif isinstance(t, Jump) and t._0 == 0:
            return "jump-0"
        elif isinstance(t, Jump):
            n0 = t._0
            return f"jump({n0})"
        else:
            return f"turn"
def rank(t: Msg) -> int:
    if isinstance(t, Jump):
        x0 = t._0
        return x0 * 3
    else:
        return 0
stream: list[Msg] = [Rest(5, "quin"), Store(8), _Turn, Jump(10)]
print(_pf_map(render, stream))
grandSum: int = _pf_sum_by(rank, stream)
print(f"grandSum={grandSum}")
print((_pf_head(stream), _pf_last(stream)))
def numbered(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["ada", "sue", "oz"]))
journal: list[str] = []
def logged(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [6, 7]))
print((out, journal))
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([2, 9, -6, 1, 5, -1]))
panels: list[Box] = [Box(5, 9, "cog"), Box(7, 8, "nut"), Box(8, 6, "cog"), Box(4, 4, "sq")]
def describe(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, panels)))
def surface(_pf_arg0: Box) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, panels)))
def relabel(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), panels)))
