def surface(_pf_arg0: Box) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, boxes)))
def stackOf(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
