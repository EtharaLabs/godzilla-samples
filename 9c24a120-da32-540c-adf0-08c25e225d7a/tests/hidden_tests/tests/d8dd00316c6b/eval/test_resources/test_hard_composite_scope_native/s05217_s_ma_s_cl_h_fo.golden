from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
Shape2 = Sq | Disc | Tri
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Delta = Put | Push | Skip
def settle(n: int) -> int:
    _pf_t0 = n % 3
    if _pf_t0 == 0:
        _n = n // 3
        return _n + 2
    else:
        k = _pf_t0
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [24, 6, 22, 5]))
def extent(s: Shape2) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(4), Disc(3), Tri(1, 6), Tri(1, 9)]))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((1, 6)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 8)))
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t1 = _pf_last(xs)
        if isinstance(_pf_t1, Some):
            _x = _pf_t1._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t1, Some):
            y = _pf_t1._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([1, 9]), dig([4, 9]), dig([])))
trail: list[str] = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [6, 8]))
print((out, trail))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 2
        return n
    return next_
tick = ticker(3)
print((tick(None), tick(None), tick(None)))
def replay(script: list[Delta]) -> list[int]:
    def fold1(xs: list[int], op: Delta) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Push):
                n = op._0
                if n > 3:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 3:
                _pf_t2 = n * 10
                xs.append(_pf_t2)
            case _:
                pass
    return xs
script: list[Delta] = [Push(-1), Push(0), _Skip, Put("gear", 9), _Skip]
outcome: list[int] = replay(script)
print(outcome)
sumSq: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [4, 6, 4, 9])
print(sumSq)
