from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
Form = Sq | Disc | Tri
tiles: list[Tile] = [Tile(1, 4, "wick"), Tile(7, 7, "pin"), Tile(1, 6, "nut"), Tile(4, 4, "sq")]
def relabel(prefix: str, b: Tile) -> Tile:
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "x-"), tiles)))
def area(_pf_arg0: Tile) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, tiles)))
def grow(b: Tile) -> Tile:
    w = b.w
    h = b.h
    _pf_t3 = b
    return Tile(w + 2, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, tiles)))
def caption(b: Tile) -> str:
    if isinstance(b, Tile):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Tile) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, tiles)))
def stamp(xs) -> tuple[list[str], int]:
    i = 1
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["lu", "pam", "gus"]))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([2, 15, 2]))
def size(s: Form) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Sq(2), Disc(1), Tri(3, 3), Tri(1, 9)]))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 3
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(9, []), score(1, [6]), score(1, [7, 2, 3])))
def probe2(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t4 = _pf_last(xs)
        if isinstance(_pf_t4, Some):
            _x = _pf_t4._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t4, Some):
            y = _pf_t4._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([8, 6]), probe2([7, 9]), probe2([])))
def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((5, 2)), 0), pick(Some((1, 5)), 0), pick(_None_, 8)))
