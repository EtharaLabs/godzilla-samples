from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: "Box"
    bottom: "Box"
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Form = Sq | Disc | Wedge
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("101011") + int("121", base=8))
print(_pf_str_rev(str.upper("pam")))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
print(_pf_map(math.isqrt, [343, 85, 107, 366]))
boxes: list[Box] = [Box(2, 7, "gear"), Box(1, 8, "rod"), Box(4, 1, "nut"), Box(6, 8, "bolt"), Box(5, 4, "tap"), Box(4, 4, "sq")]
def caption(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, boxes)))
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "old-"), boxes)))
def heavier(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def stretch(b: Box) -> Box:
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 3, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, boxes)))
def settle(n: int) -> int:
    _pf_t4 = n % 3
    if _pf_t4 == 0:
        _n = n // 3
        return _n + 3
    else:
        k = _pf_t4
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [2, 6, 30, 6]))
def size(s: Form) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Sq(4), Disc(1), Wedge(4, 1), Wedge(1, 9)]))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 3
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(5, []), score(1, [6]), score(1, [7, 2, 3])))
def probe2(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t5 = _pf_last(xs)
        if isinstance(_pf_t5, Some):
            _x = _pf_t5._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t5, Some):
            y = _pf_t5._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([1, 5]), probe2([5, 9]), probe2([])))
