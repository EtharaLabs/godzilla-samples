from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: str
    def __repr__(self):
        return f"Emit({self._0!r})"
Instr = Jump | Turn | Emit
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Shape2 = Square | Disc | Wedge
def describe(t: Instr) -> str:
    if isinstance(t, Jump):
        s0 = t._0
        return f"jump({s0})"
    else:
        if isinstance(t, Turn):
            n0 = t._0
            if n0 > 4:
                return f"turn!({n0})"
        if isinstance(t, Turn):
            n0 = t._0
            return f"turn({n0})"
        else:
            s0 = t._0
            return f"emit({s0})"
def rank(t: Instr) -> int:
    if isinstance(t, Emit):
        return 6
    else:
        return 2
prog: list[Instr] = [Jump("oz"), Jump("sue"), Emit("fay"), Emit("ivy"), Emit("ada"), Emit("bo"), Turn(-3)]
print(_pf_str_join(" ", _pf_map(describe, prog)))
tally: int = _pf_sum_by(rank, prog)
print(f"tally={tally}")
print((_pf_head(prog), _pf_last(prog)))
def numbered(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["ray", "fay", "sue"]))
def tally2(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally2([16, 10, 11, 11]))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 4
        return n
    return next_
tick = ticker(5)
print((tick(None), tick(None), tick(None)))
limit2: int = 32
def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(2)), bound(Some(-3)), bound(_None_), limit2))
def extent(s: Shape2) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Square(5), Disc(1), Wedge(5, 5), Wedge(1, 9)]))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((0, 0)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 2)))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 5
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(6, []), score(1, [5]), score(1, [8, 2, 3])))
