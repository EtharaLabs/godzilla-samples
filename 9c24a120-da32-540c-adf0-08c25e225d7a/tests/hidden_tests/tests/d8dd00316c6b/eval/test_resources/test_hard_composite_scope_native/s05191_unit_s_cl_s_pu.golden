from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
laps: list[float] = [76.3, 198.7, 162.0]
times: list[float] = [5.5, 42.1, 38.0]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
pace: float = total / dur
print(_pf_fmt_fixed(1, pace))
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(laps, times))
print(best)
side: float = math.sqrt(16.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 1
        return n
    return next_
clock = ticker(7)
print((clock(None), clock(None), clock(None)))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([5, 19, 3, 12, 13]))
trail: list[str] = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [1, 3]))
print((out, trail))
tiles: list[Panel] = [Panel(7, 1, "wick"), Panel(7, 7, "pin"), Panel(7, 6, "bolt"), Panel(4, 2, "gear"), Panel(4, 8, "tap"), Panel(4, 4, "sq")]
def relabel(prefix: str, b: Panel) -> Panel:
    label = b.label
    _pf_t1 = b
    return Panel(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), tiles)))
def surface(_pf_arg0: Panel) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, tiles)))
def describe(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
