from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Box"
    bottom: "Box"
    slot: int
def numbered(xs) -> tuple[list[str], int]:
    i = 1
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["kit", "gus", "ray"]))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([19, 11, 13, 2, 5]))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([2, 4, 3, -5]))
legs: list[float] = [185.0, 143.5, 34.1, 403.9, 84.5]
splits: list[float] = [75.5, 55.1, 20.9, 78.7, 18.6]
dist: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed: float = dist / elapsed
print(_pf_fmt_fixed(3, speed))
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
boxes: list[Box] = [Box(7, 8, "wick"), Box(9, 7, "wick"), Box(8, 8, "wick"), Box(8, 7, "tap"), Box(4, 4, "sq")]
def stretch(b: Box) -> Box:
    w = b.w
    h = b.h
    _pf_t1 = b
    return Box(w + 3, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, boxes)))
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t3 = b
    return Box(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "new "), boxes)))
