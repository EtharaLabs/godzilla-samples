limit2: int = 35
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(8)), clip(Some(-3)), clip(_None_), limit2))
def adjust(n: int) -> int:
    _pf_t2 = n % 3
    if _pf_t2 == 0:
        _n = n // 3
        return _n + 9
    else:
        k = _pf_t2
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(adjust, [20, 0, 17, 9]))
def probe2(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t3 = _pf_last(xs)
        if isinstance(_pf_t3, Some):
            _x = _pf_t3._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t3, Some):
            y = _pf_t3._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([3, 1]), probe2([2, 9]), probe2([])))
def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((2, 4)), 0), pick(Some((1, 5)), 0), pick(_None_, 4)))
