legs: list[float] = [76.1, 265.5, 364.6, 386.5]
durations: list[float] = [37.7, 7.3, 44.8, 82.3]
dist: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed: float = dist / dur
print(_pf_fmt_fixed(3, speed))
