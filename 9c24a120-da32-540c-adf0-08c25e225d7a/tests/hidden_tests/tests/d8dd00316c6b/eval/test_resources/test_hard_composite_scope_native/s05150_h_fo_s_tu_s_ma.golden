def size(s: Shape2) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Sq(5), Ci(5), Wedge(6, 3), Wedge(1, 9)]))
def settle(n: int) -> int:
    _pf_t1 = n % 3
    if _pf_t1 == 0:
        _n = n // 3
        return _n + 7
    else:
        k = _pf_t1
        _n2 = n * k
        _k = _n2 - 1
        return _k
