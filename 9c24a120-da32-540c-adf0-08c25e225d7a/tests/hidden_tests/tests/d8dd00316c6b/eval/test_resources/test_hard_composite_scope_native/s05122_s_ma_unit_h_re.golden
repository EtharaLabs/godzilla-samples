print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t2 = p
        return Active(Person(_pf_t2.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 4:
                _pf_t3 = t
                return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Seat] = _pf_map(promote, [Parked(Team("cog", 5)), Parked(Team("cog", 4)), _Gone, _Gone, _Gone])
