from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_set_intersect(a, b):
    return a.intersection(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_snd(p):
    return p[1]
pairs: list[tuple[str, int]] = [("cap", 15), ("rod", -1), ("nut", 7)]
def validate(rows) -> Ok | Error:
    def _pf_fn0():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn0()
print((validate(pairs), validate([("ok", 1)])))
def _pf_fn1():
    for (name, qty) in pairs:
        doubled = qty * 2
        yield f"{name}={doubled}"
lines2 = _pf_fn1()
print(_pf_str_join(",", list(lines2)))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes: tuple[int, int] = _pf_fold(_pf_fn2, (1000, -1000), pairs)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(pairs, pairs):
    _pf_t1 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t1
byName: dict[str, int] = acc
print(_pf_map_to_list(byName))
laps: list[float] = [109.1, 316.9, 186.7, 77.3, 443.7]
times: list[float] = [87.8, 47.7, 44.7, 17.0, 7.1]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
speed: float = dist / dur
print(_pf_fmt_fixed(3, speed))
side: float = math.sqrt(36.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
log: list[str] = ["bo", "dee", "bo", "fay", "eli", "fay", "fay", "fay"]
m = dict()
for w in log:
    _pf_t2 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t2
counts: dict[str, int] = m
def _pf_fn3(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn3, _pf_map_to_list(counts)))
sa: set[int] = set([1, 8, 10, 15, 16, 17])
sb: set[int] = set([3, 6, 7, 12, 14, 16])
print(_pf_sort(list(_pf_set_intersect(sa, sb))))
print((len(sa), 8 in sb, _pf_set_is_subset(set([1]), sa)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, counts))
extra: dict[str, int] = dict([("zed", 5), ("bo", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, counts))))
