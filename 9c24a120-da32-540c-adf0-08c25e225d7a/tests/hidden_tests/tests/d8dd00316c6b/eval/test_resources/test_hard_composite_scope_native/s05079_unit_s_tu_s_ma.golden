from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
laps: list[float] = [87.0, 213.5, 21.5, 277.1, 181.3]
splits: list[float] = [51.1, 48.6, 86.0, 59.3, 18.4]
total: float = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace: float = total / dur
print(_pf_fmt_fixed(1, pace))
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
side: float = math.sqrt(9.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
pairs: list[tuple[str, int]] = [("hub", 13), ("cap", 7), ("tap", 9)]
def lookupAll(keys, table) -> Some | None_:
    def _pf_fn0():
        for (k, expected) in keys:
            _pf_t0 = _pf_map_try_find(k, table)
            if isinstance(_pf_t0, Some):
                v = _pf_t0._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t0
        return Some(len(keys))
    return _pf_fn0()
print((lookupAll(_pf_take(2, pairs), dict(pairs)), lookupAll([("zz", 0)], dict(pairs))))
def _pf_fn1(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes: tuple[int, int] = _pf_fold(_pf_fn1, (1000, -1000), pairs)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(pairs, pairs):
    _pf_t1 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t1
byName: dict[str, int] = acc
print(_pf_map_to_list(byName))
def _pf_fn2():
    for (name, qty) in pairs:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn2()
print(_pf_str_join(",", list(labels)))
def _pf_fn3(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn3, _pf_indexed(pairs))
cap: int = 34
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((clip(Some(6)), clip(Some(-3)), clip(_None_), cap))
def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((7, 7)), 0), pick(Some((1, 5)), 0), pick(_None_, 6)))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 3
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(6, []), score(1, [4]), score(1, [6, 2, 3])))
