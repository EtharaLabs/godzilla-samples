        if isinstance(_pf_t4, Ok):
            k, v = _pf_t4._0
            _pf_t7 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t7, Ok):
                n = _pf_t7._0
                _pf_t6 = Error("negative") if n < 0 else Ok(n)
                if isinstance(_pf_t6, Ok):
                    checked = _pf_t6._0
                    return Ok((k, checked))
                else:
                    return _pf_t6
            else:
                return _pf_t7
        else:
            return _pf_t4
    return _pf_fn0()
lines: list[str] = ["ivy=36", "gus=7=1", "bo = 6", "dee=x", "ray"]
parsed: list[Ok | Error] = _pf_map(readPair, lines)
_pf_iter(print, parsed)
