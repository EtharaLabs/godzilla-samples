from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Box"
    bottom: "Box"
    slot: int
pairs: list[tuple[str, int]] = [("wick", 16), ("gear", 12), ("bolt", 13), ("tap", 9), ("hub", -2)]
spans: list[tuple[str, tuple[int, int]]] = [("max", (1, 7)), ("quin", (0, 11)), ("ada", (5, 10))]
def _pf_fn0():
    for (name, (lo, hi)) in spans:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
spansOut = _pf_fn0()
print(list(spansOut))
def allKnown(keys, table) -> Some | None_:
    def _pf_fn1():
        for (k, expected) in keys:
            _pf_t0 = _pf_map_try_find(k, table)
            if isinstance(_pf_t0, Some):
                v = _pf_t0._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t0
        return Some(len(keys))
    return _pf_fn1()
print((allKnown(_pf_take(2, pairs), dict(pairs)), allKnown([("zz", 0)], dict(pairs))))
def _pf_fn2(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn2, _pf_indexed(pairs))
boxes: list[Box] = [Box(7, 1, "wick"), Box(8, 8, "gear"), Box(6, 7, "cog"), Box(8, 6, "wick"), Box(4, 4, "sq")]
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t2 = b
    return Box(_pf_t2.w, _pf_t2.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), boxes)))
def _pf_fn3(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn4(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn3, _pf_filter(_pf_fn4, boxes)))
def caption(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, boxes)))
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def stamp(xs) -> tuple[list[str], int]:
    i = 0
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["dee", "ray", "cy"]))
journal: list[str] = []
def logged(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [6, 9]))
print((out, journal))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 4
        return n
    return next_
clock = ticker(3)
print((clock(None), clock(None), clock(None)))
