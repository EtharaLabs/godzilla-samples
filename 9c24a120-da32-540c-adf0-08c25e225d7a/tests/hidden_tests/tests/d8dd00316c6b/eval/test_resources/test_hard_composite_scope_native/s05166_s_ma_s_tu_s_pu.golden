acc = dict()
for (k, v) in _pf_concat(tallies, tallies):
    _pf_t1 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t1
index: dict[str, int] = acc
print(_pf_map_to_list(index))
def _pf_fn1(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn1, _pf_indexed(tallies))
def validate(rows) -> Ok | Error:
    def _pf_fn2():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t2 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t2, Ok):
            total = _pf_t2._0
            return Ok(total)
        else:
            return _pf_t2
    return _pf_fn2()
print((validate(tallies), validate([("ok", 1)])))
boxes: list[Tile] = [Tile(5, 3, "cap"), Tile(3, 2, "gear"), Tile(9, 6, "tap"), Tile(4, 4, "sq")]
def heavier(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Tile):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def surface(_pf_arg0: Tile) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, boxes)))
def describe(b: Tile) -> str:
    if isinstance(b, Tile):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Tile) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, boxes)))
