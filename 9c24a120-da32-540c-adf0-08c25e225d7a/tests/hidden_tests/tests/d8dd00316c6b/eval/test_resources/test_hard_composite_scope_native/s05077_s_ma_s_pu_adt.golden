from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Panel"
    bottom: "Panel"
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: str
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
_Push: Push = Push()
Signal = Mark | Rest | Push
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 2
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(4, []), score(1, [3]), score(1, [3, 2, 3])))
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([2, 3]), dig([9, 9]), dig([])))
cap: int = 28
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((clip(Some(3)), clip(Some(-3)), clip(_None_), cap))
def settle(n: int) -> int:
    _pf_t1 = n % 3
    if _pf_t1 == 0:
        _n = n // 3
        return _n + 2
    else:
        k = _pf_t1
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [17, 15, 0, 22]))
boxes: list[Panel] = [Panel(3, 4, "cap"), Panel(6, 5, "nut"), Panel(3, 8, "cog"), Panel(5, 8, "hub"), Panel(4, 4, "sq")]
def rename(prefix: str, b: Panel) -> Panel:
    label = b.label
    _pf_t3 = b
    return Panel(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "new "), boxes)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def caption(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, boxes)))
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def show(t: Signal) -> str:
    if isinstance(t, Mark):
        n0 = t._0
        if n0 % 2 == 0:
            return f"mark!({n0})"
    if isinstance(t, Mark):
        n0 = t._0
        return f"mark({n0})"
    elif isinstance(t, Rest):
        s0 = t._0
        return f"rest({s0})"
    else:
        return f"push"
def score2(t: Signal) -> int:
    if isinstance(t, Push):
        return 6
    elif isinstance(t, Mark):
        x0 = t._0
        return x0 * 5
    else:
        return 3
prog: list[Signal] = [Rest("ray"), _Push, Rest("tom"), Mark(6), Rest("fay")]
print(_pf_str_join(" ", _pf_map(show, prog)))
grandSum: int = _pf_sum_by(score2, prog)
print(f"grandSum={grandSum}")
print((_pf_head(prog), _pf_last(prog)))
