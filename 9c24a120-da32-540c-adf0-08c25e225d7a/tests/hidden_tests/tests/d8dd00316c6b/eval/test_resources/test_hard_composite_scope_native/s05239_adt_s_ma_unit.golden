from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: int
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
Move = Store | Drop | Turn
def render(t: Move) -> str:
    if isinstance(t, Store):
        n0 = t._0
        if n0 % 2 == 0:
            return f"store!({n0})"
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    else:
        if isinstance(t, Drop):
            n0 = t._0
            if n0 > 7:
                return f"drop!({n0})"
        if isinstance(t, Drop):
            n0 = t._0
            return f"drop({n0})"
        else:
            n0 = t._0
            n1 = t._1
            return f"turn({n0},{n1})"
def weight(t: Move) -> int:
    if isinstance(t, Store):
        x0 = t._0
        return x0 * 2
    elif isinstance(t, Turn):
        x0 = t._0
        x1 = t._1
        return x0 + x1 * 2
    else:
        return 1
stream: list[Move] = [Drop(0), Drop(1), Turn(4, 11), Drop(-1)]
_pf_iter(lambda t: print(render(t)), stream)
tally: int = _pf_sum_by(weight, stream)
print(f"tally={tally}")
print(_pf_max_by(weight, stream))
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 5
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(8, []), weigh(1, [7]), weigh(1, [9, 2, 3])))
cap: int = 17
def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(2)), bound(Some(-3)), bound(_None_), cap))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((4, 9)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 4)))
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([1, 0]), dig([8, 9]), dig([])))
legs: list[float] = [258.7, 472.6, 148.3, 262.7]
durations: list[float] = [30.6, 26.0, 74.5, 46.2]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace: float = total / dur
print(_pf_fmt_fixed(2, pace))
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
side: float = math.sqrt(2.25)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
