def priority(o: Invoice) -> str:
    if isinstance(o, Invoice) and o.urgent is True:
        amount = o.amount
        if amount > 115:
            return "rush-big"
    if isinstance(o, Invoice) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 115:
            return "big"
        else:
            return "normal"
