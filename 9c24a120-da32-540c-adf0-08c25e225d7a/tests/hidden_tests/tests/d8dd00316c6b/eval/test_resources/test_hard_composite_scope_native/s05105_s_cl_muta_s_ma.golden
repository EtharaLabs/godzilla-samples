from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
Fig = Sq | Ci | Tri
def numbered(xs) -> tuple[list[str], int]:
    i = 0
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["pam", "ivy", "bo"]))
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([4, 4, 5, -6, -9]))
calls: int = 0
def track(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 4
def profile(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-5, 24, 33, 26, 10, 19]))
doubled: list[int] = _pf_map(track, [-5, 24, 33, 26])
print(f"{doubled} after {calls} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), calls))
def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((2, 2)), 0), pick(Some((1, 5)), 0), pick(_None_, 2)))
def adjust(n: int) -> int:
    _pf_t0 = n % 3
    if _pf_t0 == 0:
        _n = n // 3
        return _n + 3
    else:
        k = _pf_t0
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(adjust, [8, 11, 11, 23]))
def extent(s: Fig) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(2), Ci(7), Tri(6, 8), Tri(1, 9)]))
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t1 = _pf_last(xs)
        if isinstance(_pf_t1, Some):
            _x = _pf_t1._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t1, Some):
            y = _pf_t1._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([4, 5]), dig([4, 9]), dig([])))
