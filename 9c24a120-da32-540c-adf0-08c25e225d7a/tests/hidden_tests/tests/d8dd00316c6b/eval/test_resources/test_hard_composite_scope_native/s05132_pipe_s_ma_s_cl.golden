from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_reduce(f, xs):
    return Some(functools.reduce(f, xs)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Form = Square | Disc | Wedge
samples: list[int] = [12, 33, -3, -8, 48, 6]
def shift(k: int, x: int) -> int:
    return x + k
def _pf_fn3(_pf_x):
    def _pf_fn5(_pf_x):
        def _pf_fn6(_pf_arg0):
            a, b = _pf_arg0
            return b - a
        return _pf_map(_pf_fn6, _pf_pairwise(_pf_x))
    return _pf_fn5((lambda _pf_x: _pf_drop(1, (lambda _pf_x: _pf_map(lambda b: 2 * b, _pf_map(lambda x: x // 5 + x % 5, _pf_x)))(_pf_x)))(_pf_x))
stage = _pf_fn3
answer: Some | None_ = _pf_reduce(lambda a, b: a + b, stage(samples))
print(answer)
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 3
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(7, []), weigh(1, [2]), weigh(1, [8, 2, 3])))
def size(s: Form) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Square(6), Disc(9), Wedge(8, 4), Wedge(1, 9)]))
cap: int = 31
def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(1)), bound(Some(-3)), bound(_None_), cap))
def probe2(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([5, 8]), probe2([9, 9]), probe2([])))
trail: list[str] = []
def traced(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [8, 4]))
print((out, trail))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([12, 7, 12]))
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 1
        return n
    return next_
clock = makeCounter(9)
print((clock(None), clock(None), clock(None)))
