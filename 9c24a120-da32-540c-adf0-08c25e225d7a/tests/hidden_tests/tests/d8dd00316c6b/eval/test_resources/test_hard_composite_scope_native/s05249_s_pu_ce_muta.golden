        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
def _pf_id(x):
    return x
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Panel"
    bottom: "Panel"
    slot: int
panels: list[Panel] = [Panel(8, 7, "cap"), Panel(2, 3, "pin"), Panel(2, 3, "bolt"), Panel(4, 8, "nut"), Panel(4, 4, "sq")]
def stackOf(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
