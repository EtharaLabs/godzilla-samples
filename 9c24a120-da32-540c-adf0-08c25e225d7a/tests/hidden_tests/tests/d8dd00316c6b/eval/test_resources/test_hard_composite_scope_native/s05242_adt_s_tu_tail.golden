def powAcc(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(powAcc(2, 7, 1))
def digitSum(n: int) -> int:
    if n == 0:
        return 0
    else:
        return n % 10 + digitSum(n // 10)
