@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    _1: int
    def __repr__(self):
        return f"Store({self._0!r}, {self._1!r})"
Action = Drop | Push | Pop | Store
def render(t: Action) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Push):
        n0 = t._0
        return f"push({n0})"
    elif isinstance(t, Pop):
        return f"pop"
    else:
        if isinstance(t, Store):
            n0 = t._0
            n1 = t._1
            if 0 <= n0 < 17:
                return f"store!({n0},{n1})"
        n0 = t._0
        n1 = t._1
        return f"store({n0},{n1})"
