    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
