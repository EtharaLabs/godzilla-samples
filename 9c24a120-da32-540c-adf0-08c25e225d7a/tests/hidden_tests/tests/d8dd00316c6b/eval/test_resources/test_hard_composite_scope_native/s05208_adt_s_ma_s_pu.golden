def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(3)), bound(Some(-3)), bound(_None_), cap))
def settle(n: int) -> int:
    _pf_t1 = n % 3
    if _pf_t1 == 0:
        _n = n // 3
        return _n + 4
    else:
        k = _pf_t1
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [5, 22, 25, 5]))
tiles: list[Box] = [Box(3, 6, "cap"), Box(9, 7, "pin"), Box(7, 2, "gear"), Box(3, 8, "cog"), Box(2, 8, "cap"), Box(4, 4, "sq")]
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def relabel(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t3 = b
    return Box(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "new "), tiles)))
def stretch(b: Box) -> Box:
    w = b.w
    h = b.h
    _pf_t5 = b
    return Box(w + 2, h * 2, _pf_t5.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, tiles)))
