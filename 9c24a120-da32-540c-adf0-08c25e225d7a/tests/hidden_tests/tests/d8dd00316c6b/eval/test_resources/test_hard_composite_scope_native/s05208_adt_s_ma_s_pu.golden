from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    _1: str
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
Token = Load | Skip | Mark
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Box"
    bottom: "Box"
    slot: int
def show(t: Token) -> str:
    if isinstance(t, Load):
        n0 = t._0
        if n0 > 2:
            return f"load!({n0})"
    if isinstance(t, Load):
        n0 = t._0
        return f"load({n0})"
    elif isinstance(t, Skip):
        n0 = t._0
        return f"skip({n0})"
    else:
        s0 = t._0
        s1 = t._1
        return f"mark({s0},{s1})"
def cost(t: Token) -> int:
    if isinstance(t, Mark):
        return 6
    elif isinstance(t, Skip):
        x0 = t._0
        return x0
    else:
        return 1
prog: list[Token] = [Mark("fay", "max"), Load(5), Mark("hal", "sue"), Load(1), Mark("sue", "ned"), Mark("max", "ada")]
_pf_iter(lambda t: print(show(t)), prog)
total: int = _pf_sum_by(cost, prog)
print(f"total={total}")
print(len(_pf_filter(lambda t: cost(t) > 6, prog)))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 2
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(1, []), score(1, [4]), score(1, [5, 2, 3])))
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([6, 1]), dig([0, 9]), dig([])))
