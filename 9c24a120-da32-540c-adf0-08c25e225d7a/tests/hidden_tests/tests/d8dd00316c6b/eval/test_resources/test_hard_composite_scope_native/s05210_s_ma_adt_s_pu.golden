from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
Form = Square | Disc | Tri
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: str
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
Cmd = Drop | Pop | Push | Store
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((3, 8)), 0), pick(Some((1, 5)), 0), pick(_None_, 4)))
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 4
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(4, []), weigh(1, [4]), weigh(1, [7, 2, 3])))
def extent(s: Form) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Square(4), Disc(6), Tri(3, 8), Tri(1, 9)]))
def explain(t: Cmd) -> str:
    if isinstance(t, Drop):
        s0 = t._0
        return f"drop({s0})"
    else:
        if isinstance(t, Pop):
            n0 = t._0
            if n0 > 5:
                return f"pop!({n0})"
        if isinstance(t, Pop):
            n0 = t._0
            return f"pop({n0})"
        elif isinstance(t, Push):
            n0 = t._0
            return f"push({n0})"
        else:
            n0 = t._0
            return f"store({n0})"
def weight(t: Cmd) -> int:
    if isinstance(t, Drop):
        return 2
    elif isinstance(t, Pop):
        x0 = t._0
        return x0
    else:
        return 2
batch: list[Cmd] = [Drop("gus"), Push(-1), Store(7), Store(-3)]
print(_pf_str_join(" ", _pf_map(explain, batch)))
tally: int = _pf_sum_by(weight, batch)
print(f"tally={tally}")
print(_pf_max_by(weight, batch))
panels: list[Panel] = [Panel(5, 2, "pin"), Panel(6, 8, "cap"), Panel(7, 9, "gear"), Panel(4, 4, "sq")]
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, panels)))
def surface(_pf_arg0: Panel) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, panels)))
def describe(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
