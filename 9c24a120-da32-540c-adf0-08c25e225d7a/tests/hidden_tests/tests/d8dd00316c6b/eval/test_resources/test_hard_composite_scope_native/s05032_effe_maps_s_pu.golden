from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_set_intersect(a, b):
    return a.intersection(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Box"
    bottom: "Box"
    slot: int
def discount(price: int, qty: int) -> int:
    return price * qty - 5 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("tap", 20, 6), ("cog", 38, 1), ("cap", 44, 2), ("nut", 17, 4)]))
print(grand)
visits: list[str] = ["cy", "eli", "ada", "cy", "bo", "fay", "eli"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in visits:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
hist: dict[str, int] = m
def _pf_fn1(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn1, _pf_map_to_list(hist)))
sa: set[int] = set([1, 7, 9, 12, 15, 16])
sb: set[int] = set([5, 11, 12, 16, 17, 19])
print(_pf_sort(list(_pf_set_intersect(sa, sb))))
print((len(sa), 9 in sb, _pf_set_is_subset(set([1]), sa)))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(hist))))
panels: list[Box] = [Box(7, 9, "bolt"), Box(7, 9, "tap"), Box(2, 8, "bolt"), Box(4, 1, "wick"), Box(4, 4, "sq")]
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t2 = b
    return Box(_pf_t2.w, _pf_t2.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), panels)))
def stretch(b: Box) -> Box:
    w = b.w
    h = b.h
    _pf_t4 = b
    return Box(w + 1, h * 2, _pf_t4.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, panels)))
def describe(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
def stackOf(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), panels, _pf_rev(panels)))
