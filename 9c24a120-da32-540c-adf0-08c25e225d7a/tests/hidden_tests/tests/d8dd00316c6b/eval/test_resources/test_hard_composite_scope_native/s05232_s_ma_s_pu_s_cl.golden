from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
Fig = Sq | Ci | Tri
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Panel"
    bottom: "Panel"
    slot: int
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((5, 7)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 7)))
def size(s: Fig) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Sq(6), Ci(7), Tri(3, 5), Tri(1, 9)]))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 2
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(4, []), score(1, [4]), score(1, [1, 2, 3])))
boxes: list[Panel] = [Panel(7, 7, "hub"), Panel(5, 9, "hub"), Panel(8, 1, "tap"), Panel(7, 9, "cog"), Panel(4, 4, "sq")]
def stretch(b: Panel) -> Panel:
    w = b.w
    h = b.h
    _pf_t1 = b
    return Panel(w + 3, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, boxes)))
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def relabel(prefix: str, b: Panel) -> Panel:
    label = b.label
    _pf_t3 = b
    return Panel(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), boxes)))
def caption(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, boxes)))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([8, 2, 20, 0, 17]))
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 3
        return n
    return next_
clock = makeCounter(1)
print((clock(None), clock(None), clock(None)))
