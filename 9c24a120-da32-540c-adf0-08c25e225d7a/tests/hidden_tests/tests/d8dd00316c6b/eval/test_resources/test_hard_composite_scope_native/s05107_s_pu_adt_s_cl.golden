def describe(t: Instr) -> str:
    if isinstance(t, Mark):
        s0 = t._0
        return f"mark({s0})"
    elif isinstance(t, Jump):
        n0 = t._0
        n1 = t._1
        return f"jump({n0},{n1})"
    elif isinstance(t, Store):
        s0 = t._0
        s1 = t._1
        return f"store({s0},{s1})"
    else:
        n0 = t._0
        n1 = t._1
        return f"pop({n0},{n1})"
def weight(t: Instr) -> int:
    if isinstance(t, Jump):
        x0 = t._0
        x1 = t._1
        return x0 + x1
    else:
        return 2
