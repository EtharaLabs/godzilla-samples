def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 2
        return n
    return next_
clock = ticker(9)
print((clock(None), clock(None), clock(None)))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([12, 8, 0, 2, 9, 0]))
