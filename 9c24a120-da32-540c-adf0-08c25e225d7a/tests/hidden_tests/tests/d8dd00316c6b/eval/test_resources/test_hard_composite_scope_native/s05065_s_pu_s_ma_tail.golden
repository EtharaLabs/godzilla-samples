@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Shape2 = Square | Ci | Wedge
panels: list[Panel] = [Panel(1, 6, "bolt"), Panel(4, 5, "bolt"), Panel(1, 2, "cog"), Panel(4, 4, "sq")]
def stretch(b: Panel) -> Panel:
    w = b.w
    h = b.h
    _pf_t1 = b
    return Panel(w + 1, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, panels)))
def describe(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
