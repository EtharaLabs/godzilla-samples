from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
pairs: list[tuple[str, int]] = [("nut", 11), ("pin", 4), ("wick", 15)]
def _pf_fn0(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn0, _pf_indexed(pairs))
def _pf_fn1(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds: tuple[int, int] = _pf_fold(_pf_fn1, (1000, -1000), pairs)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(pairs, pairs):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
index: dict[str, int] = acc
print(_pf_map_to_list(index))
def _pf_fn2():
    for (name, qty) in pairs:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn2()
print(_pf_str_join(",", list(labels)))
def allKnown(keys, table) -> Some | None_:
    def _pf_fn3():
        for (k, expected) in keys:
            _pf_t1 = _pf_map_try_find(k, table)
            if isinstance(_pf_t1, Some):
                v = _pf_t1._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t1
        return Some(len(keys))
    return _pf_fn3()
print((allKnown(_pf_take(2, pairs), dict(pairs)), allKnown([("zz", 0)], dict(pairs))))
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([-7, 7, -5, -3, -1]))
def numbered(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["gus", "eli", "oz"]))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([9, 19, 9, 11, 3, 2]))
def net(price: int, qty: int) -> int:
    return price * qty - 3 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn4(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
