def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 5
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(8, []), score(1, [4]), score(1, [8, 2, 3])))
def settle(n: int) -> int:
    _pf_t4 = n % 3
    if _pf_t4 == 0:
        _n = n // 3
        return _n + 5
    else:
        k = _pf_t4
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [25, 11, 24, 4]))
def size(s: Fig) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Square(9), Disc(1), Tri(9, 4), Tri(1, 9)]))
