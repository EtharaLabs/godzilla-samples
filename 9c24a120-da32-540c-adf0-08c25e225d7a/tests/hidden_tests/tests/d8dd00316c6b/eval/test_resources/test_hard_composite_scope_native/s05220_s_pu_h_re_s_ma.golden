def promote(s: Status) -> Status:
    if isinstance(s, Active):
        p = s._0
        _pf_t2 = p
        return Active(Member(_pf_t2.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 5:
                _pf_t3 = t
                return Idle(Club(_pf_str_upper(t.name), t.size - 1))
