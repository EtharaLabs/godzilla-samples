from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
trail: list[str] = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [6, 9]))
print((out, trail))
def numbered(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["dee", "hal", "ray"]))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([3, -2, -7, -8, -9]))
data: list[int] = [11, 5, 30, 6, 12, 44, 14, 7]
def addK(k: int, x: int) -> int:
    return x + k
def keep(n: int) -> bool:
    return n > 7 and n % 4 != 0
process = lambda _pf_x: _pf_collect(lambda x: [x, x + 1], (lambda _pf_x: (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(3, _pf_x)))(_pf_filter(lambda x: x % 2 == 0, _pf_x)))(_pf_x))
answer: bool = _pf_forall(lambda x: x >= 0, process(data))
print(answer)
tiles: list[Box] = [Box(6, 4, "bolt"), Box(8, 4, "wick"), Box(6, 7, "bolt"), Box(9, 2, "rod"), Box(4, 4, "sq")]
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), tiles)))
def stretch(b: Box) -> Box:
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 3, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, tiles)))
def describe(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
