times: list[float] = [64.8, 73.3, 70.5, 85.2, 26.8]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
rate: float = total / dur
print(_pf_fmt_fixed(1, rate))
mass: float = 11.0
accel: float = 3.5
push: float = mass * accel
limit: float = 383.0
print("over" if push > limit else "under")
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
side: float = math.sqrt(49.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 4
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(5, []), weigh(1, [2]), weigh(1, [6, 2, 3])))
def extent(s: Form) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Square(5), Disc(6), Tri(9, 7), Tri(1, 9)]))
