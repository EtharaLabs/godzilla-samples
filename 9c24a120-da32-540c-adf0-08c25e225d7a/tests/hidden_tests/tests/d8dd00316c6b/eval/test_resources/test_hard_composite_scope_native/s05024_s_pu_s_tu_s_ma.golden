def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(2)), bound(Some(-3)), bound(_None_), limit2))
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 4
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(9, []), weigh(1, [7]), weigh(1, [6, 2, 3])))
def adjust(n: int) -> int:
    _pf_t4 = n % 3
    if _pf_t4 == 0:
        _n = n // 3
        return _n + 8
    else:
        k = _pf_t4
        _n2 = n * k
        _k = _n2 - 1
        return _k
