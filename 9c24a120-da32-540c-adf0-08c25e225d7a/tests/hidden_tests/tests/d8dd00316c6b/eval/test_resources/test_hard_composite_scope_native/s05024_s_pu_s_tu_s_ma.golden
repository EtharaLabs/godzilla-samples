def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((0, 4)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 4)))
