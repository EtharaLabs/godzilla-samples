from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: "Box"
    bottom: "Box"
    slot: int
panels: list[Box] = [Box(2, 5, "nut"), Box(2, 3, "tap"), Box(2, 3, "rod"), Box(5, 4, "wick"), Box(4, 4, "sq")]
def grow(b: Box) -> Box:
    w = b.w
    h = b.h
    _pf_t1 = b
    return Box(w + 3, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, panels)))
def stackOf(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def relabel(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t3 = b
    return Box(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "new "), panels)))
def area(_pf_arg0: Box) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, panels)))
pairs: list[tuple[str, int]] = [("nut", 20), ("rod", 6), ("gear", 6), ("cog", 15)]
