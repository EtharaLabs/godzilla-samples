from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Form = Sq | Disc | Wedge
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
Action = Drop | Jump | Emit | Rest | Mark
def extent(s: Form) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(7), Disc(5), Wedge(1, 1), Wedge(1, 9)]))
limit2: int = 32
def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(7)), bound(Some(-3)), bound(_None_), limit2))
def adjust(n: int) -> int:
    _pf_t0 = n % 3
    if _pf_t0 == 0:
        _n = n // 3
        return _n + 9
    else:
        k = _pf_t0
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(adjust, [4, 14, 26, 23]))
def show(t: Action) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        if 0 <= n0 < 17:
            return f"drop!({n0})"
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    else:
        if isinstance(t, Jump):
            n0 = t._0
            if n0 > 6:
                return f"jump!({n0})"
        if isinstance(t, Jump):
            n0 = t._0
            return f"jump({n0})"
        elif isinstance(t, Emit):
            n0 = t._0
            return f"emit({n0})"
        else:
            if isinstance(t, Rest):
                n0 = t._0
                if n0 > 4:
                    return f"rest!({n0})"
            if isinstance(t, Rest):
                n0 = t._0
                return f"rest({n0})"
            else:
                n0 = t._0
                return f"mark({n0})"
def score(t: Action) -> int:
    if isinstance(t, Mark):
        x0 = t._0
        return x0 * 5
    elif isinstance(t, Drop):
        x0 = t._0
        return x0
    else:
        return 1
queue: list[Action] = [Drop(4), Jump(9), Mark(8), Mark(-2), Rest(2), Rest(3), Jump(3)]
print(_pf_str_join("; ", _pf_map(show, queue)))
grandSum: int = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print((_pf_head(queue), _pf_last(queue)))
def sumDigits(n: int) -> int:
    if n == 0:
        return 0
    else:
        return n % 10 + sumDigits(n // 10)
print(sumDigits(86317))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [14, 26, 15, 22, 9]))
def collatz(n: int, acc: int) -> int:
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [33, 26, 25]))
