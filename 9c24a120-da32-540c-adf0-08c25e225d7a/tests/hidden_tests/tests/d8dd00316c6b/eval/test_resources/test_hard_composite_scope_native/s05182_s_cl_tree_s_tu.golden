from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Tree"
    _1: int
    _2: "Tree"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Tree = Leaf | Node
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([15, 19, 3, 16, 15]))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([3, 2, -1, -3, -4, -1, -8]))
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 5
        return n
    return next_
tick = makeCounter(3)
print((tick(None), tick(None), tick(None)))
def add(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(add(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, add(x, rt))
        return t
root: Tree = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [9, 48, 18, 57, 52, 28])
def minOf(t: Tree) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minOf(root))
def depthOf(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        rt = t._2
        return 1 + max(depthOf(l), depthOf(rt))
print(depthOf(root))
def sumOf(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumOf(l) + v + sumOf(rt)
print(sumOf(root))
def toListOf(t: Tree) -> list[int]:
    if isinstance(t, Leaf):
        return []
    else:
        l = t._0
        v = t._1
        rt = t._2
        return _pf_concat(toListOf(l), _pf_concat([v], toListOf(rt)))
print(toListOf(root))
