        return _k
print(_pf_map(adjust, [4, 5, 4, 20]))
def probe2(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t5 = _pf_last(xs)
        if isinstance(_pf_t5, Some):
            _x = _pf_t5._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t5, Some):
            y = _pf_t5._0
