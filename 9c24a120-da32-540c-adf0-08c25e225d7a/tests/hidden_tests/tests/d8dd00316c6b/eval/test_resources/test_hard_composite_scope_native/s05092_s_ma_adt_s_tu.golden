def explain(t: Move) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Jump):
        return f"jump"
    else:
        if isinstance(t, Halt):
            n0 = t._0
            s1 = t._1
            if n0 % 2 == 0:
                return f"halt!({n0},{s1})"
        n0 = t._0
        s1 = t._1
        return f"halt({n0},{s1})"
