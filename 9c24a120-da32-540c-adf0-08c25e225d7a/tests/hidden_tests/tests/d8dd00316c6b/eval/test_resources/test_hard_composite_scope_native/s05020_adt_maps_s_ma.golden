def explain(t: Move) -> str:
    if isinstance(t, Jump):
        n0 = t._0
        if n0 % 2 == 0:
            return f"jump!({n0})"
    if isinstance(t, Jump):
        n0 = t._0
        return f"jump({n0})"
    else:
        if isinstance(t, Rest):
            n0 = t._0
            if n0 > 2:
                return f"rest!({n0})"
        if isinstance(t, Rest):
            n0 = t._0
            return f"rest({n0})"
        elif isinstance(t, Halt):
            s0 = t._0
            n1 = t._1
            return f"halt({s0},{n1})"
        else:
            s0 = t._0
            return f"drop({s0})"
def score(t: Move) -> int:
    if isinstance(t, Halt):
        x1 = t._1
        return x1
    elif isinstance(t, Drop):
        return 8
    else:
        return 1
