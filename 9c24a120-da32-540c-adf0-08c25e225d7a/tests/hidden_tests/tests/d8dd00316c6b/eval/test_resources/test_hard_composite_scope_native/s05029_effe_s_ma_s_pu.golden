from dataclasses import dataclass
from typing import Any
import functools
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Fig = Sq | Ci | Wedge
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: "Tile"
    bottom: "Tile"
    slot: int
def net(price: int, qty: int) -> int:
    return price * qty - 7 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("nut", 50, 2), ("hub", 21, 5), ("cog", 17, 6)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(15)([1, 2, 3]))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 2
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(6, []), score(1, [9]), score(1, [6, 2, 3])))
def size(s: Fig) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Sq(3), Ci(5), Wedge(5, 2), Wedge(1, 9)]))
def settle(n: int) -> int:
    _pf_t0 = n % 3
    if _pf_t0 == 0:
        _n = n // 3
        return _n + 3
    else:
        k = _pf_t0
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [18, 19, 28, 24]))
panels: list[Tile] = [Tile(3, 2, "hub"), Tile(5, 8, "hub"), Tile(2, 6, "gear"), Tile(7, 4, "hub"), Tile(4, 4, "sq")]
def stretch(b: Tile) -> Tile:
    w = b.w
    h = b.h
    _pf_t2 = b
    return Tile(w + 2, h * 2, _pf_t2.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, panels)))
def stackOf(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Tile):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def caption(b: Tile) -> str:
    if isinstance(b, Tile):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Tile) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, panels)))
