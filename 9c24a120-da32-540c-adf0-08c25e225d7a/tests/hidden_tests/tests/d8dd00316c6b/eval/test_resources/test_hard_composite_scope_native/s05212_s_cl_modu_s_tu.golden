from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_snd(p):
    return p[1]
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([1, 1, -7, 9]))
journal: list[str] = []
def traced(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [4, 1]))
print((out, journal))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([2, 9, 16, 16, 3, 20]))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
obs: list[int] = [19, -13, -11, 23, -7, -4]
print(Calc_mean(obs))
print(_pf_filter(functools.partial(Calc_between, -3, 18), obs))
print(Calc_scaleAll(3, obs))
stock: list[tuple[str, int]] = [("bolt", 5), ("nut", 5), ("rod", 2), ("wick", 11), ("gear", 3)]
def lookupAll(keys, table) -> Some | None_:
    def _pf_fn0():
        for (k, expected) in keys:
            _pf_t0 = _pf_map_try_find(k, table)
            if isinstance(_pf_t0, Some):
                v = _pf_t0._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t0
        return Some(len(keys))
    return _pf_fn0()
print((lookupAll(_pf_take(2, stock), dict(stock)), lookupAll([("zz", 0)], dict(stock))))
widths: list[tuple[str, tuple[int, int]]] = [("cy", (2, 12)), ("gus", (1, 18)), ("fay", (5, 13))]
def _pf_fn1():
    for (name, (lo, hi)) in widths:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
widthsOut = _pf_fn1()
print(list(widthsOut))
def _pf_fn2(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn2, _pf_indexed(stock))
def validate(rows) -> Ok | Error:
    def _pf_fn3():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t1 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t1, Ok):
            total = _pf_t1._0
            return Ok(total)
        else:
            return _pf_t1
    return _pf_fn3()
print((validate(stock), validate([("ok", 1)])))
