from dataclasses import dataclass
import functools
import itertools
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Delta = Put | Push | Skip
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([5, 15, 5, 18, 14, 6]))
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([9, -8, 2, -9, 5, -4]))
def replay(script: list[Delta]) -> tuple[int, int]:
    def step(acc, op):
        return acc
    def step(acc: tuple[int, int], op: Delta) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Push):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(step, (0, 0), script)
ops: list[Delta] = [_Skip, _Skip, Put("nut", 4), Put("cog", 3)]
state: tuple[int, int] = replay(ops)
print(state)
values: list[int] = [39, -10, 2, -2, 28, -10, -9, 12, -4, 40]
def accept(n: int) -> bool:
    return n > 9 and n % 2 != 0
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
result: int = sum(_pf_take_while(lambda x: x < 59, _pf_map(lambda b: 43 - b, _pf_distinct(_pf_fn1(_pf_sort_by(lambda x: x % 2, values))))))
print(result)
