from dataclasses import dataclass
from typing import Any
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Ast"
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
Ast = Num | Add | Mul | Neg | Var
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Panel"
    bottom: "Panel"
    slot: int
env: dict[str, int] = dict([("x", 4), ("y", -4)])
def evaluate(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evaluate(a) + evaluate(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evaluate(a) * evaluate(b)
    elif isinstance(e, Neg):
        a = e._0
        return -evaluate(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, env)
def render(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{render(a)}"
    else:
        v = e._0
        return v
exprs: list[Ast] = [Num(3), Mul(Num(4), Mul(Add(Num(1), Var("y")), Num(4))), Var("y")]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evaluate, exprs))
panels: list[Panel] = [Panel(1, 7, "rod"), Panel(7, 8, "gear"), Panel(9, 9, "cog"), Panel(4, 4, "sq")]
def describe(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
def area(_pf_arg0: Panel) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, panels)))
def grow(b: Panel) -> Panel:
    w = b.w
    h = b.h
    _pf_t1 = b
    return Panel(w + 1, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, panels)))
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def numbered(xs) -> tuple[list[str], int]:
    i = 1
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["dee", "jo", "kit"]))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-4, -9, -7, 2, -9, 6, 5]))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([20, 14, 1]))
