from dataclasses import dataclass
from typing import Any
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
    def __eq__(self, other):
        return type(other) is Store and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
    def __eq__(self, other):
        return type(other) is Emit and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Emit: Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    def __repr__(self):
        return "Turn"
    def __eq__(self, other):
        return type(other) is Turn and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
