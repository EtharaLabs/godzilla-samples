_Pop: Pop = Pop()
Signal = Store | Emit | Turn | Pop
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: "Tile"
    bottom: "Tile"
    slot: int
def show(t: Signal) -> str:
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    elif isinstance(t, Pop):
        return f"pop"
    elif isinstance(t, Emit):
        return "emit/turn"
    else:
        return "emit/turn"
def cost(t: Signal) -> int:
    if isinstance(t, Emit):
        return 9
    elif isinstance(t, Store):
        x0 = t._0
        return x0 * 2
    elif isinstance(t, Turn):
        return 9
    else:
        return 2
queue: list[Signal] = [Store(-1), _Emit, _Pop, _Pop, Store(-3), _Pop, Store(6)]
print(_pf_map(show, queue))
total: int = _pf_sum_by(cost, queue)
print(f"total={total}")
print(_pf_sort(queue))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([6, 18, 5, 9]))
trail: list[str] = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [5, 6]))
print((out, trail))
boxes: list[Tile] = [Tile(8, 1, "cap"), Tile(1, 8, "bolt"), Tile(1, 5, "cap"), Tile(4, 4, "sq")]
def surface(_pf_arg0: Tile) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, boxes)))
def heavier(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Tile):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def describe(b: Tile) -> str:
    if isinstance(b, Tile):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Tile) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, boxes)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
