from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Change = Put | Append | Skip
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([6, 16, 19, 14, 4, 17]))
def numbered(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["ada", "hal", "cy"]))
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([-7, -5, 1, 1, 1, 5, 7]))
def execute(script: list[Change]) -> tuple[int, int]:
    def fold1(acc: tuple[int, int], op: Change) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Append):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(fold1, (0, 0), script)
changes: list[Change] = [Put("bolt", 4), Append(0), Put("gear", 7), _Skip, Put("gear", 1), Append(7), Put("cog", 1)]
state: tuple[int, int] = execute(changes)
print(state)
acc: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [6, 5, 3, 3])
print(acc)
hits: int = 0
def record(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 4
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-5, 15, 49, 21]))
doubled: list[int] = _pf_map(record, [-5, 15, 49, 21])
print(f"{doubled} after {hits} calls")
