from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_snd(p):
    return p[1]
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([6, -6, 5, -8, -2]))
trail: list[str] = []
def traced(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [5, 4]))
print((out, trail))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_square(x):
    return x * x
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
pts: list[int] = [-7, 1, 28, 20, 9, -15, -6]
print(_pf_filter(functools.partial(Geo_between, -3, 22), pts))
print(Geo_norm1(pts))
print(_pf_map(Geo_square, pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 9), pts))
pairs: list[tuple[str, int]] = [("hub", 10), ("gear", 14), ("bolt", 18)]
def _pf_fn0(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds: tuple[int, int] = _pf_fold(_pf_fn0, (1000, -1000), pairs)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(pairs, pairs):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
index: dict[str, int] = acc
print(_pf_map_to_list(index))
def lookupAll(keys, table) -> Some | None_:
    def _pf_fn1():
        for (k, expected) in keys:
            _pf_t1 = _pf_map_try_find(k, table)
            if isinstance(_pf_t1, Some):
                v = _pf_t1._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t1
        return Some(len(keys))
    return _pf_fn1()
print((lookupAll(_pf_take(2, pairs), dict(pairs)), lookupAll([("zz", 0)], dict(pairs))))
def audit2(rows) -> Ok | Error:
    def _pf_fn2():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t2 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t2, Ok):
            total = _pf_t2._0
            return Ok(total)
        else:
            return _pf_t2
    return _pf_fn2()
print((audit2(pairs), audit2([("ok", 1)])))
spans: list[tuple[str, tuple[int, int]]] = [("eli", (4, 16)), ("bo", (4, 15)), ("max", (0, 17))]
def _pf_fn3():
    for (name, (lo, hi)) in spans:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
spansOut = _pf_fn3()
print(list(spansOut))
