from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_snd(p):
    return p[1]
tallies: list[tuple[str, int]] = [("pin", 4), ("tap", 3), ("nut", 8), ("rod", 14), ("hub", 17)]
def _pf_fn0(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds: tuple[int, int] = _pf_fold(_pf_fn0, (1000, -1000), tallies)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(tallies, tallies):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
index: dict[str, int] = acc
print(_pf_map_to_list(index))
def validate(rows) -> Ok | Error:
    def _pf_fn1():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t1 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t1, Ok):
            total = _pf_t1._0
            return Ok(total)
        else:
            return _pf_t1
    return _pf_fn1()
print((validate(tallies), validate([("ok", 1)])))
def _pf_fn2(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn2, _pf_indexed(tallies))
widths: list[tuple[str, tuple[int, int]]] = [("jo", (2, 6)), ("kit", (5, 11)), ("dee", (3, 17))]
def _pf_fn3():
    for (name, (lo, hi)) in widths:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
widthsOut = _pf_fn3()
print(list(widthsOut))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([5, 2, 15]))
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([0, -2, -9, -5]))
def margin(price: int, qty: int) -> int:
    return price * qty - 2 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn4(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall: int = sum(_pf_map(_pf_fn4, [("gear", 41, 3), ("nut", 42, 5), ("pin", 32, 6), ("bolt", 19, 6)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(16)([1, 2, 3]))
