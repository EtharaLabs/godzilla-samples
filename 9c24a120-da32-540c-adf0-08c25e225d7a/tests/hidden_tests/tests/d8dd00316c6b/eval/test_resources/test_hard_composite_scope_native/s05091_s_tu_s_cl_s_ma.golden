from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Shape2 = Square | Ci | Wedge
tallies: list[tuple[str, int]] = [("cog", 1), ("hub", -1), ("wick", 11)]
spans: list[tuple[str, tuple[int, int]]] = [("lu", (3, 19)), ("eli", (2, 13)), ("kit", (3, 12))]
def _pf_fn0():
    for (name, (lo, hi)) in spans:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
spansOut = _pf_fn0()
print(list(spansOut))
def _pf_fn1():
    for (name, qty) in tallies:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn1()
print(_pf_str_join(",", list(labels)))
def validate(rows) -> Ok | Error:
    def _pf_fn2():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn2()
print((validate(tallies), validate([("ok", 1)])))
def stamp(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["lu", "max", "quin"]))
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([3, 4, 2, -3, -3, -7, 2]))
def extent(s: Shape2) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Square(2), Ci(6), Wedge(7, 3), Wedge(1, 9)]))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((8, 0)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 2)))
limit2: int = 38
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(7)), clip(Some(-3)), clip(_None_), limit2))
def adjust(n: int) -> int:
    _pf_t1 = n % 3
    if _pf_t1 == 0:
        _n = n // 3
        return _n + 8
    else:
        k = _pf_t1
        _n2 = n * k
        _k = _n2 - 1
        return _k
