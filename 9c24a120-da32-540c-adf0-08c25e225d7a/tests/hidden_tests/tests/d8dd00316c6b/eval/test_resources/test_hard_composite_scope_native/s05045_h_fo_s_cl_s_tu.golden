from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Op = Put | Append | Skip
def apply(xs: list[int], op: Op) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Append):
            n = op._0
            if n > 0:
                return _pf_concat(xs, [n * 10])
        return xs
def execute(script: list[Op]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 0:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
ops: list[Op] = [Put("nut", 6), Append(-1), _Skip, Append(1)]
outcome: list[int] = execute(ops)
print(outcome)
sumSq: int = _pf_fold(lambda apply, x: apply + x * x, 0, [7, 3, 2, 5])
print(sumSq)
def stamp(xs) -> tuple[list[str], int]:
    i = 2
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["ray", "hal", "bo"]))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 4
        return n
    return next_
clock = ticker(5)
print((clock(None), clock(None), clock(None)))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([15, 1, 13, 3, 20, 18]))
stock: list[tuple[str, int]] = [("tap", 10), ("cog", 11), ("cap", 1)]
spans: list[tuple[str, tuple[int, int]]] = [("fay", (2, 9)), ("kit", (3, 18)), ("pam", (2, 6))]
def _pf_fn0():
    for (name, (lo, hi)) in spans:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
spansOut = _pf_fn0()
print(list(spansOut))
def _pf_fn1():
    for (name, qty) in stock:
        doubled = qty * 2
        yield f"{name}={doubled}"
lines2 = _pf_fn1()
print(_pf_str_join(",", list(lines2)))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds: tuple[int, int] = _pf_fold(_pf_fn2, (1000, -1000), stock)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(stock, stock):
    _pf_t1 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t1
byName: dict[str, int] = acc
print(_pf_map_to_list(byName))
