from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    _1: str
    def __repr__(self):
        return f"Skip({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
Action = Rest | Skip | Jump | Store
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((4, 0)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 3)))
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([4, 4]), dig([9, 9]), dig([])))
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 4
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(8, []), weigh(1, [9]), weigh(1, [1, 2, 3])))
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 2
        return n
    return next_
clock = makeCounter(7)
print((clock(None), clock(None), clock(None)))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-4, 8, -8, -3, -8]))
def explain(t: Action) -> str:
    if isinstance(t, Rest):
        n0 = t._0
        return f"rest({n0})"
    else:
        if isinstance(t, Skip):
            n0 = t._0
            s1 = t._1
            if 0 <= n0 < 9:
                return f"skip!({n0},{s1})"
        if isinstance(t, Skip):
            n0 = t._0
            s1 = t._1
            return f"skip({n0},{s1})"
        elif isinstance(t, Jump):
            n0 = t._0
            return f"jump({n0})"
        else:
            if isinstance(t, Store):
                n0 = t._0
                if n0 % 2 == 0:
                    return f"store!({n0})"
            n0 = t._0
            return f"store({n0})"
def weight(t: Action) -> int:
    if isinstance(t, Jump):
        x0 = t._0
        return x0 * 2
    elif isinstance(t, Skip):
        x0 = t._0
        return x0 * 3
    elif isinstance(t, Rest):
        x0 = t._0
        return x0 * 3
    else:
        return 2
prog: list[Action] = [Skip(4, "oz"), Store(8), Store(6), Store(4)]
_pf_iter(lambda t: print(explain(t)), prog)
grandSum: int = _pf_sum_by(weight, prog)
print(f"grandSum={grandSum}")
print(_pf_max_by(weight, prog))
