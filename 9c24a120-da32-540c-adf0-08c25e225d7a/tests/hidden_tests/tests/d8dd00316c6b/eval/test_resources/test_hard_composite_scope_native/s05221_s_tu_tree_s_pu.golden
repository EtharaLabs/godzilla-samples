tallies: list[tuple[str, int]] = [("cap", -2), ("rod", 8), ("hub", 5), ("nut", 14), ("bolt", 3)]
def validate(rows) -> Ok | Error:
    def _pf_fn0():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn0()
print((validate(tallies), validate([("ok", 1)])))
widths: list[tuple[str, tuple[int, int]]] = [("dee", (5, 15)), ("ray", (2, 6)), ("ada", (5, 13))]
