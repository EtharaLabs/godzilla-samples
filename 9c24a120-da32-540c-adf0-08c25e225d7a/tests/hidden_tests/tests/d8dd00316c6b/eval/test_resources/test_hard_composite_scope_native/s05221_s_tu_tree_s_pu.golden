def containsOf(x: int, t: Bst) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
