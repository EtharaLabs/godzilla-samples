from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Box"
    bottom: "Box"
    slot: int
stock: list[tuple[str, int]] = [("bolt", 6), ("cog", 1), ("wick", 15), ("hub", 11)]
def _pf_fn0(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes: tuple[int, int] = _pf_fold(_pf_fn0, (1000, -1000), stock)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(stock, stock):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
index: dict[str, int] = acc
print(_pf_map_to_list(index))
def allKnown(keys, table) -> Some | None_:
    def _pf_fn1():
        for (k, expected) in keys:
            _pf_t1 = _pf_map_try_find(k, table)
            if isinstance(_pf_t1, Some):
                v = _pf_t1._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t1
        return Some(len(keys))
    return _pf_fn1()
print((allKnown(_pf_take(2, stock), dict(stock)), allKnown([("zz", 0)], dict(stock))))
def _pf_fn2(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn2, _pf_indexed(stock))
laps: list[float] = [200.1, 45.1, 150.2, 183.2, 498.5]
times: list[float] = [28.3, 87.9, 23.5, 28.8, 26.1]
total: float = _pf_fold(lambda a, b: a + b, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
rate: float = total / dur
print(_pf_fmt_fixed(3, rate))
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
panels: list[Box] = [Box(6, 9, "tap"), Box(5, 8, "hub"), Box(7, 1, "hub"), Box(4, 9, "gear"), Box(4, 4, "sq")]
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t3 = b
    return Box(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "new "), panels)))
def area(_pf_arg0: Box) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, panels)))
def stackOf(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def describe(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
