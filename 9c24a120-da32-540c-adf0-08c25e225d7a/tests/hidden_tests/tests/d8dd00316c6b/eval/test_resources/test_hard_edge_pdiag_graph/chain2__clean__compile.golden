# ==== a.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class ACircle:
    _0: float
    def __repr__(self):
        return f"ACircle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class ARect:
    _0: float
    _1: float
    def __repr__(self):
        return f"ARect({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
@dataclass(frozen=True, slots=True, order=True)
class APt:
    ax: int
    ay: int
aOrigin = APt(1, 2)
def aTwice(k):
    return k * 2
def aTick(k):
    print(f"A tick {k}")
    return k + 1
def aArea(s):
    match s:
        case ACircle(r):
            return 3.0 * r * r
        case ARect(w, h):
            return w * h
        case _:
            raise RuntimeError("non-exhaustive match")
def aCode(s):
    return s
aWidth = 3.0

