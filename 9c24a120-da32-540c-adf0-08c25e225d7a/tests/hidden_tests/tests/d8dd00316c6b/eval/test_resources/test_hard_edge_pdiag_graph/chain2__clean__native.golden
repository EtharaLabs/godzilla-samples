# ==== a.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class ACircle:
    _0: float
    def __repr__(self):
        return f"ACircle({self._0!r})"
    def __eq__(self, other):
        return type(other) is ACircle and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class ARect:
    _0: float
    _1: float
    def __repr__(self):
        return f"ARect({self._0!r}, {self._1!r})"
    def __eq__(self, other):
        return type(other) is ARect and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
AShape = ACircle | ARect
@dataclass(frozen=True, slots=True, order=True)
class APt:
    ax: int
    ay: int
aOrigin: APt = APt(1, 2)
def aTwice(k: int) -> int:
    return k * 2
def aTick(k: int) -> int:
    print(f"A tick {k}")
    return k + 1
def aArea(s: AShape) -> float:
    if isinstance(s, ACircle):
        r = s._0
        return 3.0 * r * r
    else:
        w = s._0
        h = s._1
        return w * h
def aCode(s: str):
    return s
aWidth: float = 3.0

