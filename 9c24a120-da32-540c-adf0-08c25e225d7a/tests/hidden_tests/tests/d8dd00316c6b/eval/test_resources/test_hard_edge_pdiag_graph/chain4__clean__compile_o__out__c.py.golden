from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class CCircle:
    _0: float
    def __repr__(self):
        return f"CCircle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class CRect:
    _0: float
    _1: float
    def __repr__(self):
        return f"CRect({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
@dataclass(frozen=True, slots=True, order=True)
class CPt:
    cx: int
    cy: int
cOrigin = CPt(1, 2)
def cTwice(k):
    return k * 2
def cTick(k):
    print(f"C tick {k}")
    return k + 1
def cArea(s):
    match s:
        case CCircle(r):
            return 3.0 * r * r
        case CRect(w, h):
            return w * h
        case _:
            raise RuntimeError("non-exhaustive match")
def cCode(s):
    return s
cWidth = 3.0
