# ==== c.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class CCircle:
    _0: float
    def __repr__(self):
        return f"CCircle({self._0!r})"
    def __eq__(self, other):
        return type(other) is CCircle and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class CRect:
    _0: float
    _1: float
    def __repr__(self):
        return f"CRect({self._0!r}, {self._1!r})"
    def __eq__(self, other):
        return type(other) is CRect and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
CShape = CCircle | CRect
@dataclass(frozen=True, slots=True, order=True)
class CPt:
    cx: int
    cy: int
cOrigin: CPt = CPt(1, 2)
def cTwice(k: int) -> int:
    return k * 2
def cTick(k: int) -> int:
    print(f"C tick {k}")
    return k + 1
def cArea(s: CShape) -> float:
    if isinstance(s, CCircle):
        r = s._0
        return 3.0 * r * r
    else:
        w = s._0
        h = s._1
        return w * h
def cCode(s: str):
    return s
cWidth: float = 3.0

