mWidth: float = 3.0
mFromC: int = c.cTwice(c.cOrigin.cx + c.cOrigin.cy)
mFromA: int = a.aTwice(a.aOrigin.ax + a.aOrigin.ay)
mFromB: int = b.bTwice(b.bOrigin.bx + b.bOrigin.by)
