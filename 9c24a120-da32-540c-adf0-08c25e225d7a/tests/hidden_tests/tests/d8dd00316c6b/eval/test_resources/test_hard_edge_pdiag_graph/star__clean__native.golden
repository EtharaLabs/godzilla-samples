from dataclasses import dataclass
import a
import b
import c
@dataclass(frozen=True, slots=True, repr=False)
class MCircle:
    _0: float
    def __repr__(self):
        return f"MCircle({self._0!r})"
    def __eq__(self, other):
        return type(other) is MCircle and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class MRect:
    _0: float
    _1: float
    def __repr__(self):
        return f"MRect({self._0!r}, {self._1!r})"
    def __eq__(self, other):
        return type(other) is MRect and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
MShape = MCircle | MRect
@dataclass(frozen=True, slots=True, order=True)
class MPt:
    mx: int
    my: int
mOrigin: MPt = MPt(1, 2)
def mTwice(k: int) -> int:
    return k * 2
def mTick(k: int) -> int:
    print(f"main tick {k}")
    return k + 1
def mArea(s: MShape) -> float:
    if isinstance(s, MCircle):
        r = s._0
        return 3.0 * r * r
    else:
