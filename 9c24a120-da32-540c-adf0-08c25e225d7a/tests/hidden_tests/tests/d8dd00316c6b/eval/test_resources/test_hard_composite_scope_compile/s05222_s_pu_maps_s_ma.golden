from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
tiles = [Box(1, 7, "wick"), Box(9, 7, "bolt"), Box(7, 1, "pin"), Box(9, 9, "pin"), Box(4, 4, "sq")]
def stackOf(s):
    match s:
        case Shelf(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, tiles)))
def relabel(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), tiles)))
log = ["cy", "dee", "dee", "dee", "ada", "bo", "ada"]
m = dict()
for w in log:
    _pf_t2 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t2
counts = m
def _pf_fn2(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn2, _pf_map_to_list(counts)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, counts))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(counts))))
limit2 = 26
def clip(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(4)), clip(Some(-3)), clip(_None_), limit2))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(1, []), weigh(1, [8]), weigh(1, [9, 2, 3])))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((9, 6)), 0), pick(Some((1, 5)), 0), pick(_None_, 8)))
