from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
tiles = [Box(6, 1, "hub"), Box(8, 6, "bolt"), Box(1, 3, "wick"), Box(9, 5, "pin"), Box(5, 6, "pin"), Box(4, 4, "sq")]
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), tiles)))
def stretch(b):
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 2, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, tiles)))
def stackOf(s):
    match s:
        case Rack(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((7, 8)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 7)))
def size(s):
    match s:
        case Sq(n) | Disc(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Sq(9), Disc(5), Tri(9, 8), Tri(1, 9)]))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 5
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(adjust, [4, 5, 4, 20]))
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t4 = _pf_last(xs)
        if isinstance(_pf_t4, Some):
            _x = _pf_t4._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t4, Some):
            y = _pf_t4._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([7, 3]), probe2([5, 9]), probe2([])))
tickets = [Order(100, "sue", 187, True), Order(101, "tom", 228, False), Order(102, "tom", 229, False), Order(103, "tom", 16, True), Order(104, "sue", 228, False), Order(105, "sue", 293, True)]
