from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([1, 7, 5, 9, -6]))
def stamp(xs):
    i = 2
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["bo", "gus", "quin"]))
def step(m, op):
    match op:
        case Put(k, v):
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        case Push(n):
            return _pf_map_add("pushed", n, m)
        case Skip():
            return m
        case _:
            raise RuntimeError("non-exhaustive match")
def execute(script):
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
script = [Push(0), Put("nut", 2), Put("bolt", 8), Push(0)]
outcome = execute(script)
print(_pf_map_to_list(outcome))
sumSq = _pf_fold(lambda step, x: step + x * x, 0, [8, 4, 2, 8])
print(sumSq)
def extent(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Square(6), Disc(7), Wedge(6, 9), Wedge(1, 9)]))
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(2, []), score(1, [5]), score(1, [8, 2, 3])))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 7
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(settle, [18, 1, 29, 24]))
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t1 = _pf_last(xs)
        if isinstance(_pf_t1, Some):
            _x = _pf_t1._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t1, Some):
            y = _pf_t1._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([4, 9]), probe2([2, 9]), probe2([])))
