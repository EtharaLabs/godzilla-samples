from dataclasses import dataclass
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def stamp(xs):
    i = 1
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["lu", "pam", "ray"]))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 1
        return n
    return next_
tick = makeCounter(2)
print((tick(None), tick(None), tick(None)))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([19, 16, 19, 13]))
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([21, 44, 25, 50, 37, 5, 32, 46]))
doubled = _pf_map(record, [21, 44, 25, 50])
print(f"{doubled} after {hits} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), hits))
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Add(Num(0), Neg(Add(Num(1), Num(6)))), Add(Num(0), Mul(Add(Num(0), Num(-1)), Num(9)))]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(calc, exprs))
