from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_reduce(f, xs):
    return Some(functools.reduce(f, xs)) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
panels = [Box(3, 1, "wick"), Box(3, 4, "nut"), Box(2, 1, "rod"), Box(4, 4, "sq")]
def heavier(s):
    match s:
        case Shelf(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, panels)))
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), panels)))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([10, 13, 10]))
def numbered(xs):
    i = 3
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["eli", "sue", "dee"]))
readings = [-8, 40, -2, 40, 43, 32, 23, 25, 10]
def addK(k, x):
    return x + k
def isBig(n):
    return n > 17 and n % 5 != 0
pipeline = lambda _pf_x: _pf_drop(1, (lambda _pf_x: _pf_filter(isBig, (lambda _pf_x: _pf_map(lambda b: 3 + b, (lambda _pf_x: (lambda _pf_x: _pf_map(sum, _pf_chunk(4, _pf_x)))((lambda _pf_x: _pf_map(functools.partial(addK, 5), _pf_sort_by(lambda x: -x, _pf_x)))(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
digest = _pf_reduce(lambda a, b: a + b, pipeline(readings))
print(digest)
