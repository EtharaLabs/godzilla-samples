def describe(t):
    match t:
        case Skip(0):
            return "skip-0"
        case Skip(n0):
            return f"skip({n0})"
        case Rest(1):
            return "rest-1"
        case Rest(n0):
            return f"rest({n0})"
        case Load(s0, n1):
            return f"load({s0},{n1})"
        case Jump(n0) if n0 > 8:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
