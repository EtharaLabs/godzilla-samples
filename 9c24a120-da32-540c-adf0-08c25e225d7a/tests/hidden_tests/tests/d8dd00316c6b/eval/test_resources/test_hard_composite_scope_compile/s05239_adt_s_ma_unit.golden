from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: int
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
def render(t):
    match t:
        case Store(n0) if n0 % 2 == 0:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case Drop(n0) if n0 > 7:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case Turn(n0, n1):
            return f"turn({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Store(x0):
            return x0 * 2
        case Turn(x0, x1):
            return x0 + x1 * 2
        case _:
            return 1
stream = [Drop(0), Drop(1), Turn(4, 11), Drop(-1)]
_pf_iter(lambda t: print(render(t)), stream)
tally = _pf_sum_by(weight, stream)
print(f"tally={tally}")
print(_pf_max_by(weight, stream))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(8, []), weigh(1, [7]), weigh(1, [9, 2, 3])))
cap = 17
def bound(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(2)), bound(Some(-3)), bound(_None_), cap))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((4, 9)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 4)))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([1, 0]), dig([8, 9]), dig([])))
legs = [258.7, 472.6, 148.3, 262.7]
durations = [30.6, 26.0, 74.5, 46.2]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace = total / dur
print(_pf_fmt_fixed(2, pace))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
side = math.sqrt(2.25)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
