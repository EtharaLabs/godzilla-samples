from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 2
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(8, []), score(1, [4]), score(1, [8, 2, 3])))
def size(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Square(2), Disc(2), Tri(4, 2), Tri(1, 9)]))
cap = 47
def bound(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(5)), bound(Some(-3)), bound(_None_), cap))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([11, 4, 16, 16]))
def stamp(xs):
    i = 2
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["ada", "tom", "bo"]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 5
        return n
    return next_
tick = ticker(7)
print((tick(None), tick(None), tick(None)))
tiles = [Tile(8, 4, "rod"), Tile(6, 8, "wick"), Tile(8, 6, "hub"), Tile(7, 8, "cap"), Tile(4, 4, "sq")]
def area(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, tiles)))
def describe(b):
    match b:
        case Tile(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Tile(label=label, w=1):
            return f"{label} thin"
        case Tile(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
def stretch(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Tile(w + 2, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, tiles)))
def rename(prefix, b):
    label = b.label
    _pf_t3 = b
    return Tile(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
