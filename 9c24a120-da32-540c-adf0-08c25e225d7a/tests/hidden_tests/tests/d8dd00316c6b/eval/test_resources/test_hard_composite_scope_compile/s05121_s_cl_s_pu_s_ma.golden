from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 1
        return n
    return next_
clock = ticker(4)
print((clock(None), clock(None), clock(None)))
def numbered(xs):
    i = 0
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["tom", "dee", "quin"]))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([8, 12, 16, 9, 8]))
boxes = [Tile(9, 7, "cap"), Tile(5, 6, "bolt"), Tile(3, 1, "pin"), Tile(4, 4, "sq")]
def stackOf(s):
    match s:
        case Shelf(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def caption(b):
    match b:
        case Tile(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Tile(label=label, w=1):
            return f"{label} thin"
        case Tile(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, boxes)))
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "old-"), boxes)))
def extent(s):
    match s:
        case Sq(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(5), Disc(4), Wedge(8, 6), Wedge(1, 9)]))
cap = 40
def clip(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((clip(Some(1)), clip(Some(-3)), clip(_None_), cap))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t2 = _pf_last(xs)
        if isinstance(_pf_t2, Some):
            _x = _pf_t2._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t2, Some):
            y = _pf_t2._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([6, 2]), dig([1, 9]), dig([])))
