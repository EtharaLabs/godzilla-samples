widths = [("hal", (3, 7)), ("pam", (3, 20)), ("bo", (4, 10))]
def _pf_fn2():
    for (name, (lo, hi)) in widths:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
widthsOut = _pf_fn2()
