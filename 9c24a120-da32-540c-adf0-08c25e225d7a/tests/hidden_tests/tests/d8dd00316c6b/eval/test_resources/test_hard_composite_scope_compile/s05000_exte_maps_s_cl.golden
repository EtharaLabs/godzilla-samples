import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_map_values(m):
    return list(m.values())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [8, 7, 9, 3]))
print(_pf_str_rev(str.upper("sue")))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1001110") + int("107", base=8))
log = ["dee", "dee", "fay", "cy", "ada", "cy"]
m = dict()
for w in log:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
freq = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(freq)))
extra = dict([("zed", 5), ("dee", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, freq))))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, freq))))
print(len(_pf_map_filter(lambda k, v: v > 1, freq)))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(freq))))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([6, 16, 16, 19, 18]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 3
        return n
    return next_
tick = ticker(6)
print((tick(None), tick(None), tick(None)))
def stamp(xs):
    i = 3
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["lu", "jo", "oz"]))
