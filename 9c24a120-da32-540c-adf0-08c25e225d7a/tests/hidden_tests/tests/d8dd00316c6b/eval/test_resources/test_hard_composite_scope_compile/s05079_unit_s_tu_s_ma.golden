km = total / 1000.0
print(_pf_fmt_fixed(1, km))
pairs = [("hub", 13), ("cap", 7), ("tap", 9)]
def lookupAll(keys, table):
    def _pf_fn0():
        for (k, expected) in keys:
            _pf_t0 = _pf_map_try_find(k, table)
            if isinstance(_pf_t0, Some):
                v = _pf_t0._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t0
        return Some(len(keys))
    return _pf_fn0()
print((lookupAll(_pf_take(2, pairs), dict(pairs)), lookupAll([("zz", 0)], dict(pairs))))
def _pf_fn1(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes = _pf_fold(_pf_fn1, (1000, -1000), pairs)
