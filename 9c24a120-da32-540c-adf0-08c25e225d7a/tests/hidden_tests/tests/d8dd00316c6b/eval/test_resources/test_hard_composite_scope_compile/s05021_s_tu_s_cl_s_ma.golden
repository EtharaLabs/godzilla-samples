from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
tallies = [("pin", 5), ("cap", 16), ("nut", 3), ("tap", 18)]
def _pf_fn0():
    for (name, qty) in tallies:
        doubled = qty * 2
        yield f"{name}={doubled}"
lines2 = _pf_fn0()
print(_pf_str_join(",", list(lines2)))
def validate(rows):
    def _pf_fn1():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn1()
print((validate(tallies), validate([("ok", 1)])))
def allKnown(keys, table):
    def _pf_fn2():
        for (k, expected) in keys:
            _pf_t1 = _pf_map_try_find(k, table)
            if isinstance(_pf_t1, Some):
                v = _pf_t1._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t1
        return Some(len(keys))
    return _pf_fn2()
print((allKnown(_pf_take(2, tallies), dict(tallies)), allKnown([("zz", 0)], dict(tallies))))
def _pf_fn3(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
