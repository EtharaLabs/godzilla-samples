def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-3, 0, -9, 0, 1, 3]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 3
        return n
    return next_
tick = ticker(3)
print((tick(None), tick(None), tick(None)))
def size(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Square(7), Disc(2), Tri(8, 4), Tri(1, 9)]))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((4, 2)), 0), pick(Some((1, 5)), 0), pick(_None_, 6)))
cap = 36
def clip(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((clip(Some(3)), clip(Some(-3)), clip(_None_), cap))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 2
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(7, []), weigh(1, [6]), weigh(1, [7, 2, 3])))
