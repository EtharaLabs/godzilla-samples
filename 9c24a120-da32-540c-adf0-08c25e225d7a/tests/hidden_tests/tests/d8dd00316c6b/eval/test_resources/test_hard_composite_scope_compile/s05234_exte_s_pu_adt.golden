def show(t):
    match t:
        case Pop(n0) if n0 > 0:
            return f"pop!({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Emit(s0, s1):
            return f"emit({s0},{s1})"
        case Halt(n0, n1):
            return f"halt({n0},{n1})"
        case Jump():
            return f"jump"
        case Store(n0, s1) if n0 > 1:
            return f"store!({n0},{s1})"
        case Store(n0, s1):
            return f"store({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Store(x0, _):
            return x0 * 2
        case Emit(_, _):
            return 4
        case Halt(x0, x1):
            return x0 + x1 * 4
        case Jump():
            return 2
        case _:
            return 1
