from dataclasses import dataclass
from functools import total_ordering
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_snd(p):
    return p[1]
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    _1: str
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
def show(t):
    match t:
        case Load(s0):
            return f"load({s0})"
        case Push(n0, s1) if 0 <= n0 < 6:
            return f"push!({n0},{s1})"
        case Push(n0, s1):
            return f"push({n0},{s1})"
        case Mark(s0):
            return f"mark({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Push(x0, _):
            return x0 * 5
        case _:
            return 0
batch = [Push(5, "max"), Push(12, "gus"), Load("ada"), Load("dee"), Push(-2, "fay"), Load("oz")]
print(_pf_map(show, batch))
tally = _pf_sum_by(cost, batch)
print(f"tally={tally}")
print(_pf_sort(batch))
tallies = [("hub", -2), ("gear", 19), ("bolt", 8)]
def validate(rows):
    def _pf_fn0():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn0()
print((validate(tallies), validate([("ok", 1)])))
def _pf_fn1(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn1, _pf_indexed(tallies))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes = _pf_fold(_pf_fn2, (1000, -1000), tallies)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(tallies, tallies):
    _pf_t1 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t1
index = acc
print(_pf_map_to_list(index))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_square(x):
    return x * x
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
obs = [-12, -2, -6, 29, -3, 7]
print(_pf_filter(functools.partial(Geo_between, 5, 15), obs))
print(Geo_scaleAll(5, obs))
print(_pf_map(Geo_square, obs))
print(Geo_norm1(obs))
