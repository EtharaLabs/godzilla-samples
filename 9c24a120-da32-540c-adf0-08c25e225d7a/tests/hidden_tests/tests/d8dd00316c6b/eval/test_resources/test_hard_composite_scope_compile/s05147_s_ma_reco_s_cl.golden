from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(2, []), weigh(1, [5]), weigh(1, [9, 2, 3])))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((6, 9)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 3)))
def extent(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Square(4), Disc(1), Wedge(4, 6), Wedge(1, 9)]))
parcels = [Ticket(100, "bo", 170, False, Addr("Lima", 1)), Ticket(101, "bo", 253, False, Addr("Riga", 4)), Ticket(102, "bo", 153, True, Addr("Rome", 4)), Ticket(103, "eli", 217, False, Addr("Baku", 4)), Ticket(104, "bo", 143, True, Addr("Oslo", 2))]
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
perOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, parcels))
print(perOwner)
def bucket(o):
    match o:
        case Ticket(urgent=True, amount=amount) if amount > 140:
            return "rush-big"
        case Ticket(urgent=True):
            return "rush"
        case Ticket(amount=amount):
            if amount > 140:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, parcels))
print(_pf_count_by(bucket, parcels))
print(_pf_max_by(lambda o: o.amount, parcels))
def tag(_pf_arg0):
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, parcels)))
def adjust(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 6), parcels)))
journal = []
def traced(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [8, 8]))
print((out, journal))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 2
        return n
    return next_
tick = ticker(5)
print((tick(None), tick(None), tick(None)))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([1, 15, 8, 1, 14]))
