def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
