    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    _1: str
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    _1: int
    def __repr__(self):
        return f"Skip({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
def extent(s):
    match s:
        case Sq(n) | Disc(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(5), Disc(3), Tri(1, 6), Tri(1, 9)]))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 8
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(settle, [26, 10, 23, 16]))
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 4
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(8, []), score(1, [6]), score(1, [5, 2, 3])))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((7, 2)), 0), pick(Some((1, 5)), 0), pick(_None_, 2)))
tiles = [Panel(6, 5, "pin"), Panel(7, 4, "gear"), Panel(6, 3, "tap"), Panel(9, 3, "cog"), Panel(9, 9, "pin"), Panel(4, 4, "sq")]
def surface(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, tiles)))
def stackOf(s):
    match s:
        case Rack(top=Panel(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def caption(b):
    match b:
        case Panel(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Panel(label=label, w=1):
            return f"{label} thin"
        case Panel(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, tiles)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Panel(w + 1, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, tiles)))
def explain(t):
    match t:
        case Mark(n0) if 0 <= n0 < 6:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Push(n0, s1) if n0 > 1:
            return f"push!({n0},{s1})"
        case Push(n0, s1):
            return f"push({n0},{s1})"
        case Store(s0):
            return f"store({s0})"
        case Skip(n0, n1) if n0 % 2 == 0:
            return f"skip!({n0},{n1})"
        case Skip(n0, n1):
            return f"skip({n0},{n1})"
        case Load(s0):
            return f"load({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Push(x0, _):
            return x0 * 3
        case Skip(x0, x1):
            return x0 + x1
        case Store(_):
            return 7
        case _:
            return 0
batch = [Mark(11), Load("ada"), Store("cy"), Push(2, "dee"), Skip(10, -1)]
print(_pf_map(explain, batch))
total = _pf_sum_by(cost, batch)
print(f"total={total}")
print((_pf_head(batch), _pf_last(batch)))
