lines2 = _pf_fn2()
print(_pf_str_join(",", list(lines2)))
book = [Ticket(100, "lu", 128, True, Addr("Doha", 4)), Ticket(101, "lu", 146, False, Addr("Oslo", 1)), Ticket(102, "ivy", 211, False, Addr("Oslo", 4)), Ticket(103, "ada", 232, True, Addr("Rome", 4)), Ticket(104, "lu", 8, True, Addr("Riga", 1)), Ticket(105, "ivy", 163, False, Addr("Kyiv", 2))]
