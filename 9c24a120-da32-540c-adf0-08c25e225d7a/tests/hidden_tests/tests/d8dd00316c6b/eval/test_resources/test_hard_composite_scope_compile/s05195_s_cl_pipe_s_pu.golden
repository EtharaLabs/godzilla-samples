from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
trail = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [6, 9]))
print((out, trail))
def numbered(xs):
    i = 3
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["dee", "hal", "ray"]))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([3, -2, -7, -8, -9]))
data = [11, 5, 30, 6, 12, 44, 14, 7]
def addK(k, x):
    return x + k
def keep(n):
    return n > 7 and n % 4 != 0
process = lambda _pf_x: _pf_collect(lambda x: [x, x + 1], (lambda _pf_x: (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(3, _pf_x)))(_pf_filter(lambda x: x % 2 == 0, _pf_x)))(_pf_x))
answer = _pf_forall(lambda x: x >= 0, process(data))
print(answer)
tiles = [Box(6, 4, "bolt"), Box(8, 4, "wick"), Box(6, 7, "bolt"), Box(9, 2, "rod"), Box(4, 4, "sq")]
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), tiles)))
def stretch(b):
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 3, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, tiles)))
def describe(b):
    match b:
        case Box(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Box(label=label, w=1):
            return f"{label} thin"
        case Box(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
