from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([14, 0, 7, 8, 19, 10]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 5
        return n
    return next_
clock = ticker(7)
print((clock(None), clock(None), clock(None)))
parcels = [Invoice(100, "ivy", 294, False), Invoice(101, "gus", 299, False), Invoice(102, "fay", 197, True), Invoice(103, "fay", 55, True), Invoice(104, "ivy", 152, True)]
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, parcels))))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn0, (0, 0), parcels)
print(f"{cnt} records, {amt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 156, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def tag(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, parcels)))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((6, 7)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 6)))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 8
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(settle, [25, 30, 6, 24]))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t1 = _pf_last(xs)
        if isinstance(_pf_t1, Some):
            _x = _pf_t1._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t1, Some):
            y = _pf_t1._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([2, 5]), dig([1, 9]), dig([])))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(4, []), weigh(1, [3]), weigh(1, [3, 2, 3])))
