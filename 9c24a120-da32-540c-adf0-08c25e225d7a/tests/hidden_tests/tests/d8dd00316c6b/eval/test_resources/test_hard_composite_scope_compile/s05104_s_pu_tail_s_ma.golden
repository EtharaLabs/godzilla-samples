        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(8)), bound(Some(-3)), bound(_None_), limit2))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
