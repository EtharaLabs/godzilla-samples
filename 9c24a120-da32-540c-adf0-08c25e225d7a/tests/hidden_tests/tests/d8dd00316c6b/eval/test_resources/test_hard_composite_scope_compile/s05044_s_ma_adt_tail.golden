def extent(s):
    match s:
        case Sq(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(7), Disc(5), Wedge(1, 1), Wedge(1, 9)]))
limit2 = 32
def bound(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(7)), bound(Some(-3)), bound(_None_), limit2))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 9
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(adjust, [4, 14, 26, 23]))
def show(t):
    match t:
        case Drop(n0) if 0 <= n0 < 17:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case Jump(n0) if n0 > 6:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Rest(n0) if n0 > 4:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Mark(x0):
            return x0 * 5
        case Drop(x0):
            return x0
        case _:
            return 1
queue = [Drop(4), Jump(9), Mark(8), Mark(-2), Rest(2), Rest(3), Jump(3)]
print(_pf_str_join("; ", _pf_map(show, queue)))
grandSum = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print((_pf_head(queue), _pf_last(queue)))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(86317))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [14, 26, 15, 22, 9]))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [33, 26, 25]))
