def apply(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Push(n):
                    return (puts, total + n)
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def execute(script):
    return _pf_fold(apply, (0, 0), script)
changes = [Put("nut", 8), Put("gear", 8), Push(8), Put("nut", 5), _Skip, _Skip]
