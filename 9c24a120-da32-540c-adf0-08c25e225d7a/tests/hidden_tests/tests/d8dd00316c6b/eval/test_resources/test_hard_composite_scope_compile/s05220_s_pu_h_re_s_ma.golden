def bound(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(1)), bound(Some(-3)), bound(_None_), cap))
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(8, []), score(1, [4]), score(1, [8, 2, 3])))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 5
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(settle, [25, 11, 24, 4]))
def size(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Square(9), Disc(1), Tri(9, 4), Tri(1, 9)]))
