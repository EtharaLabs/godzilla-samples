boxes = [Box(1, 1, "tap"), Box(9, 6, "pin"), Box(2, 4, "gear"), Box(4, 4, "sq")]
def grow(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Box(w + 3, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, boxes)))
def heavier(s):
    match s:
        case Rack(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
