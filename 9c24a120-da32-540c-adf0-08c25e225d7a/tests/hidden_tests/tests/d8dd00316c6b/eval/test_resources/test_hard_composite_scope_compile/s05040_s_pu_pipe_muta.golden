from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
tiles = [Tile(2, 2, "nut"), Tile(8, 4, "wick"), Tile(7, 5, "gear"), Tile(4, 4, "sq")]
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "new "), tiles)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, tiles)))
def stackOf(s):
    match s:
        case Shelf(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
data = [3, 24, 47, 47, 11, 18, 42, 4, 24, 30]
def addK(k, x):
    return x + k
def isBig(n):
    return n > 8 and n % 4 != 0
def _pf_fn3(_pf_x):
    def _pf_fn4(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn4, _pf_indexed(_pf_x))
result = _pf_list_find(lambda x: x % 3 == 1, _pf_fn3(_pf_sort_by(lambda x: x % 3, (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(3, _pf_x)))(data))))
print(result)
print(len(data))
ticks = 0
def record(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-20, 7, -17, -18, 22]))
doubled = _pf_map(record, [-20, 7, -17, -18])
print(f"{doubled} after {ticks} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), ticks))
