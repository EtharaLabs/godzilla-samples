from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
panels = [Tile(6, 5, "nut"), Tile(9, 2, "cap"), Tile(1, 6, "bolt"), Tile(4, 8, "tap"), Tile(4, 4, "sq")]
def heavier(s):
    match s:
        case Rack(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def describe(b):
    match b:
        case Tile(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Tile(label=label, w=1):
            return f"{label} thin"
        case Tile(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "old-"), panels)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t3 = b
    return Tile(w + 2, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, panels)))
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 4
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(8, []), score(1, [5]), score(1, [2, 2, 3])))
def extent(s):
    match s:
        case Square(n) | Ci(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Square(5), Ci(3), Wedge(4, 3), Wedge(1, 9)]))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t4 = _pf_last(xs)
        if isinstance(_pf_t4, Some):
            _x = _pf_t4._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t4, Some):
            y = _pf_t4._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([3, 8]), dig([2, 9]), dig([])))
cap = 28
def bound(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(3)), bound(Some(-3)), bound(_None_), cap))
def runAll(script):
    def apply(acc, op):
        return acc
    def apply(xs, op):
        match op:
            case Put(k, v):
                return _pf_concat(xs, [v])
            case Append(n) if n > 4:
                return _pf_concat(xs, [n * 10])
            case _:
                return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 4:
                _pf_t5 = n * 10
                xs.append(_pf_t5)
            case _:
                pass
    return xs
script = [Put("bolt", 2), _Skip, _Skip, _Skip, Append(5), Append(7)]
final = runAll(script)
print(final)
sumSq = _pf_fold(lambda apply, x: apply + x * x, 0, [8, 4, 6, 5])
print(sumSq)
