from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
tiles = [Box(5, 5, "rod"), Box(7, 9, "wick"), Box(4, 1, "nut"), Box(5, 1, "tap"), Box(5, 5, "wick"), Box(4, 4, "sq")]
def describe(b):
    match b:
        case Box(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Box(label=label, w=1):
            return f"{label} thin"
        case Box(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
def relabel(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), tiles)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, tiles)))
def area(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, tiles)))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((7, 2)), 0), pick(Some((1, 5)), 0), pick(_None_, 4)))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t2 = _pf_last(xs)
        if isinstance(_pf_t2, Some):
            _x = _pf_t2._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t2, Some):
            y = _pf_t2._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([0, 2]), dig([5, 9]), dig([])))
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(8, []), score(1, [9]), score(1, [9, 2, 3])))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 4
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(adjust, [2, 7, 8, 7]))
def numbered(xs):
    i = 1
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["quin", "hal", "ned"]))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 1
        return n
    return next_
tick = makeCounter(1)
print((tick(None), tick(None), tick(None)))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([18, 1, 9, 9]))
