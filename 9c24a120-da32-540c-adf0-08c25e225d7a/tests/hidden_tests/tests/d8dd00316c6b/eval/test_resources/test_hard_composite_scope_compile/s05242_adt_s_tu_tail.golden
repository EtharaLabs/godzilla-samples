def render(t):
    match t:
        case Drop(n0):
            return f"drop({n0})"
        case Push(n0):
            return f"push({n0})"
        case Pop():
            return f"pop"
        case Store(n0, n1) if 0 <= n0 < 17:
            return f"store!({n0},{n1})"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
