_Skip = Skip()
def size(s):
    match s:
        case Sq(n) | Ci(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Sq(7), Ci(1), Tri(5, 1), Tri(1, 9)]))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 2
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(adjust, [17, 12, 21, 10]))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(8, []), weigh(1, [1]), weigh(1, [7, 2, 3])))
tiles = [Tile(7, 4, "hub"), Tile(7, 5, "rod"), Tile(1, 9, "gear"), Tile(3, 6, "cap"), Tile(3, 5, "rod"), Tile(4, 4, "sq")]
def heavier(s):
    match s:
        case Shelf(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Tile(w + 2, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, tiles)))
