print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, tiles)))
def show(t):
    match t:
        case Turn(s0):
            return f"turn({s0})"
        case Emit(2):
            return "emit-2"
        case Emit(n0):
            return f"emit({n0})"
        case Mark(s0):
            return f"mark({s0})"
        case Halt() | Skip():
            return "halt/skip"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Halt():
            return 8
        case Mark(_):
            return 2
        case Turn(_):
            return 7
        case _:
            return 3
