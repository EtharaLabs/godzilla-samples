from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
legs = [192.4, 31.2, 473.1, 412.6]
times = [52.0, 28.7, 45.8, 61.7]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = total / elapsed
print(_pf_fmt_fixed(3, pace))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
speeds = _pf_map2(lambda d, t: d / t, legs, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 4
        return n
    return next_
tick = makeCounter(9)
print((tick(None), tick(None), tick(None)))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-2, 6, 9, 1, -2]))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([11, 0, 20, 18, 9]))
tickets = [Ticket(100, "bo", 280, False, Site("Riga", 2)), Ticket(101, "jo", 264, False, Site("Doha", 2)), Ticket(102, "bo", 18, True, Site("Oslo", 2)), Ticket(103, "jo", 238, False, Site("Kyiv", 2)), Ticket(104, "jo", 124, False, Site("Baku", 3)), Ticket(105, "jo", 287, False, Site("Baku", 3))]
print(_pf_max_by(lambda o: o.amount, tickets))
def bump2(o):
    if o.urgent:
        _pf_t0 = o
        return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + 3, _pf_t0.urgent, _pf_t0.dest)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(bump2, tickets)))
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by_desc(lambda o: o.amount, tickets))))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn0, (0, 0), tickets)
print(f"{nrec} records, {amt} total")
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
