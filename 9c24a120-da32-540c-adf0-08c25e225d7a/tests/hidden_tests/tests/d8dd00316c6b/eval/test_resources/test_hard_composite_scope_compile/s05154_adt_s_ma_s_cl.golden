from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    _1: str
    def __repr__(self):
        return f"Rest({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
def show(t):
    match t:
        case Load(n0) if 0 <= n0 < 19:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Store(s0):
            return f"store({s0})"
        case Rest(n0, s1):
            return f"rest({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Load(x0):
            return x0
        case _:
            return 0
batch = [Store("pam"), Load(3), Load(-1), Store("cy")]
print(_pf_map(show, batch))
tally = _pf_sum_by(rank, batch)
print(f"tally={tally}")
print((_pf_head(batch), _pf_last(batch)))
cap = 10
def bound(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(3)), bound(Some(-3)), bound(_None_), cap))
def extent(s):
    match s:
        case Sq(n) | Ci(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(5), Ci(9), Wedge(4, 1), Wedge(1, 9)]))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 2
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(1, []), weigh(1, [7]), weigh(1, [1, 2, 3])))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([2, 2, 17, 17, 15]))
journal = []
def logged(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [2, 7]))
print((out, journal))
def numbered(xs):
    i = 1
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["dee", "gus", "max"]))
