from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [12, 12, 11, 8]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("101000") + int("40", base=8))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 3
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(adjust, [13, 13, 6, 3]))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(8, []), weigh(1, [8]), weigh(1, [9, 2, 3])))
cap = 40
def bound(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(1)), bound(Some(-3)), bound(_None_), cap))
tallies = [("tap", 10), ("bolt", 13), ("cog", 11)]
def _pf_fn0(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn0, _pf_indexed(tallies))
def _pf_fn1():
    for (name, qty) in tallies:
        doubled = qty * 2
        yield f"{name}={doubled}"
lines2 = _pf_fn1()
print(_pf_str_join(",", list(lines2)))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes = _pf_fold(_pf_fn2, (1000, -1000), tallies)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(tallies, tallies):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
index = acc
print(_pf_map_to_list(index))
