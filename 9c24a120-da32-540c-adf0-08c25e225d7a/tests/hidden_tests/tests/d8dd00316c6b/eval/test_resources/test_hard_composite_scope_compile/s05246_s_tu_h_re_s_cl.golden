from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
pairs = [("nut", 11), ("bolt", 16), ("rod", 13)]
def _pf_fn0():
    for (name, qty) in pairs:
        doubled = qty * 2
        yield f"{name}={doubled}"
lines2 = _pf_fn0()
print(_pf_str_join(",", list(lines2)))
def _pf_fn1(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds = _pf_fold(_pf_fn1, (1000, -1000), pairs)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(pairs, pairs):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
index = acc
print(_pf_map_to_list(index))
def _pf_fn2(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn2, _pf_indexed(pairs))
spans = [("quin", (1, 8)), ("pam", (3, 20)), ("lu", (2, 8))]
def _pf_fn3():
    for (name, (lo, hi)) in spans:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
spansOut = _pf_fn3()
print(list(spansOut))
def promote(s):
    match s:
        case Active(p):
            _pf_t1 = p
            return Active(Member(_pf_t1.name, p.age + 1))
        case Idle(t) if t.size > 3:
            _pf_t2 = t
            return Idle(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [Idle(Team("wick", 7)), Idle(Team("rod", 8)), _Gone, Active(Member("bo", 26)), _Gone])
print(slots)
people = [Member("hal", 6), Member("bo", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([15, 13, 12, 5, 13, 6]))
def scanSum(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([-2, 0, -6, -8, 5, 9, 4]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 2
        return n
    return next_
clock = ticker(6)
print((clock(None), clock(None), clock(None)))
