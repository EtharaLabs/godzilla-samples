def depthOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, _, rt):
            return 1 + max(depthOf(l), depthOf(rt))
        case _:
            raise RuntimeError("non-exhaustive match")
print(depthOf(tree))
