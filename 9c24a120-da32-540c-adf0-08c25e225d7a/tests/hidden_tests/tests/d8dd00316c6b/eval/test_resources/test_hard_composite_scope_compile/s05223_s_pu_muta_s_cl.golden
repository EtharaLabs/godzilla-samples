from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
tiles = [Panel(4, 5, "pin"), Panel(4, 5, "nut"), Panel(3, 4, "wick"), Panel(4, 4, "sq")]
def grow(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Panel(w + 1, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, tiles)))
def relabel(prefix, b):
    label = b.label
    _pf_t3 = b
    return Panel(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), tiles)))
def stackOf(s):
    match s:
        case Rack(top=Panel(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([2, -3, 41, 42, 41]))
doubled = _pf_map(track, [2, -3, 41, 42])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 4
        return n
    return next_
clock = makeCounter(1)
print((clock(None), clock(None), clock(None)))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([1, 0, 3, 2, 2, 10]))
