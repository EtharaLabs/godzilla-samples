from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_snd(p):
    return p[1]
stock = [("rod", 17), ("tap", 5), ("bolt", 2), ("nut", -2), ("gear", 19)]
def _pf_fn0(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn0, _pf_indexed(stock))
def audit2(rows):
    def _pf_fn1():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn1()
print((audit2(stock), audit2([("ok", 1)])))
widths = [("gus", (5, 7)), ("eli", (3, 20)), ("dee", (3, 13))]
def _pf_fn2():
    for (name, (lo, hi)) in widths:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
widthsOut = _pf_fn2()
print(list(widthsOut))
def _pf_fn3():
    for (name, qty) in stock:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn3()
print(_pf_str_join(",", list(labels)))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
def safe(s):
    try:
        _pf_t1 = Ok(int(s))
    except Exception as _pf_t2:
        _pf_t1 = Error(_Exception(type(_pf_t2).__name__, str(_pf_t2)))
    if isinstance(_pf_t1, Ok):
        n = _pf_t1._0
        return f"ok {n}"
    else:
        e = _pf_t1._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x7", "42"]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
def numbered(xs):
    i = 2
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["ada", "cy", "hal"]))
trail = []
def traced(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [4, 1]))
print((out, trail))
