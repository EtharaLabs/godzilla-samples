def size(s):
    match s:
        case Square(n) | Ci(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Square(6), Ci(1), Wedge(7, 9), Wedge(1, 9)]))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((9, 4)), 0), pick(Some((1, 5)), 0), pick(_None_, 2)))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 2
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
