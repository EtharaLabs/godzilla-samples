from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
data = [0, -6, -6, -8, -2, 42, -8, -4, 49, 2]
stage = lambda _pf_x: _pf_map(lambda x: (-x if x < 0 else x * 5), (lambda _pf_x: _pf_choose(lambda x: (Some(x // 4) if x % 4 == 0 else _None_), (lambda _pf_x: _pf_take(4, (lambda _pf_x: _pf_distinct((lambda _pf_x: _pf_map(sum, _pf_chunk(3, _pf_x)))(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
answer = _pf_forall(lambda x: x >= 0, stage(data))
print(answer)
print(len(data))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([5, 6, 18, 1]))
def numbered(xs):
    i = 2
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
