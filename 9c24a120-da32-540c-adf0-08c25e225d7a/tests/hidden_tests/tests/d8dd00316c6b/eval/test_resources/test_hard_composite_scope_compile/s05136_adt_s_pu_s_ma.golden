        else:
            return x
    else:
        return -1
print((probe2([8, 8]), probe2([7, 9]), probe2([])))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((5, 1)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 8)))
limit2 = 35
