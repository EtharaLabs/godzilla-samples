        return "Emit"
_Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    _1: int
    def __repr__(self):
        return f"Load({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    _1: int
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
def describe(t):
    match t:
        case Halt(n0):
            return f"halt({n0})"
        case Store(n0, n1) if n0 > 6:
            return f"store!({n0},{n1})"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case Emit():
            return f"emit"
        case Load(0, _):
            return "load-0"
        case Load(n0, n1):
            return f"load({n0},{n1})"
        case Push(s0, n1):
            return f"push({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Halt(x0):
            return x0 * 3
        case Emit():
            return 8
        case Load(x0, x1):
            return x0 + x1
        case Store(x0, x1):
            return x0 + x1 * 5
        case _:
            return 2
prog = [_Emit, Store(-1, 9), Push("bo", -2), Halt(5), Store(-2, 9), Push("jo", 6)]
print(_pf_map(describe, prog))
tally = _pf_sum_by(score, prog)
print(f"tally={tally}")
print(_pf_max_by(score, prog))
panels = [Box(5, 5, "hub"), Box(4, 7, "cog"), Box(2, 9, "cog"), Box(4, 4, "sq")]
def surface(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, panels)))
def describe2(b):
    match b:
        case Box(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Box(label=label, w=1):
            return f"{label} thin"
        case Box(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe2, panels)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Box(w + 2, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, panels)))
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t2 = _pf_last(xs)
        if isinstance(_pf_t2, Some):
            _x = _pf_t2._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t2, Some):
            y = _pf_t2._0
