_Gone = Gone()
def stamp(xs):
    i = 1
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["ada", "ivy", "pam"]))
trail = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [8, 7]))
print((out, trail))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(1, []), weigh(1, [2]), weigh(1, [4, 2, 3])))
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([3, 3]), probe2([9, 9]), probe2([])))
def extent(s):
    match s:
        case Sq(n) | Ci(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(8), Ci(5), Wedge(8, 1), Wedge(1, 9)]))
limit2 = 25
def bound(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(4)), bound(Some(-3)), bound(_None_), limit2))
def promote(s):
    match s:
        case Active(p):
            _pf_t1 = p
            return Active(Pilot(_pf_t1.name, p.age + 1))
        case Parked(t) if t.size > 5:
            _pf_t2 = t
            return Parked(Club(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
