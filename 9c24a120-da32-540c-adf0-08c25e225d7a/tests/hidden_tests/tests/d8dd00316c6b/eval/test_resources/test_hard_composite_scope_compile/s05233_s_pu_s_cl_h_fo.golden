from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
boxes = [Panel(1, 7, "cap"), Panel(8, 5, "hub"), Panel(7, 9, "rod"), Panel(4, 4, "rod"), Panel(9, 3, "cap"), Panel(4, 4, "sq")]
def caption(b):
    match b:
        case Panel(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Panel(label=label, w=1):
            return f"{label} thin"
        case Panel(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, boxes)))
def heavier(s):
    match s:
        case Shelf(top=Panel(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([2, -8, 0, -9]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 2
        return n
    return next_
clock = ticker(9)
print((clock(None), clock(None), clock(None)))
def numbered(xs):
    i = 2
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["ada", "quin", "jo"]))
def replay(script):
    def apply(acc, op):
        return acc
    def apply(m, op):
        match op:
            case Put(k, v):
                return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
            case Append(n):
                return _pf_map_add("pushed", n, m)
            case Skip():
                return m
            case _:
                raise RuntimeError("non-exhaustive match")
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Append(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
script = [Put("cog", 7), Put("gear", 5), Append(4), Put("gear", 5), Put("bolt", 2)]
final = replay(script)
print(_pf_map_to_list(final))
sumSq = _pf_fold(lambda apply, x: apply + x * x, 0, [6, 5, 2, 7])
print(sumSq)
