from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
def fold1(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Push(n):
                    return (puts, total + n)
                case Noop():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def runAll(script):
    return _pf_fold(fold1, (0, 0), script)
script = [Push(5), _Noop, Push(6), Put("nut", 5), Put("cog", 6)]
state = runAll(script)
print(state)
acc = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [5, 4, 7, 4])
print(acc)
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_square(x):
    return x * x
obs = [-12, -14, 6, -1]
print(Calc_mean(obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 14), obs))
print(_pf_filter(functools.partial(Calc_between, 3, 21), obs))
print(_pf_map(Calc_square, obs))
tallies = [("rod", -1), ("cog", 14), ("tap", 8), ("bolt", 10), ("gear", 8)]
def _pf_fn0(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn0, _pf_indexed(tallies))
def lookupAll(keys, table):
    def _pf_fn1():
        for (k, expected) in keys:
            _pf_t0 = _pf_map_try_find(k, table)
            if isinstance(_pf_t0, Some):
                v = _pf_t0._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t0
        return Some(len(keys))
    return _pf_fn1()
print((lookupAll(_pf_take(2, tallies), dict(tallies)), lookupAll([("zz", 0)], dict(tallies))))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds = _pf_fold(_pf_fn2, (1000, -1000), tallies)
print(bounds)
def _pf_fn3(acc, _pf_arg1):
    k, v = _pf_arg1
    return _pf_map_add(k, v + _pf_map_find_or(k, 0, acc), acc)
index = _pf_fold(_pf_fn3, dict(), _pf_concat(tallies, tallies))
print(_pf_map_to_list(index))
