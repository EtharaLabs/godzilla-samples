def explain(t):
    match t:
        case Jump(n0) if n0 % 2 == 0:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Rest(n0) if n0 > 2:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Halt(s0, n1):
            return f"halt({s0},{n1})"
        case Drop(s0):
            return f"drop({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Halt(_, x1):
            return x1
        case Drop(_):
            return 8
        case _:
            return 1
