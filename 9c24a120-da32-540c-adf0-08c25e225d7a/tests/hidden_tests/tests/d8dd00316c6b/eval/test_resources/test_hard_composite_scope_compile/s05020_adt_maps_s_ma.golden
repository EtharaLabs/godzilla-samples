limit2 = 44
def bound(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(7)), bound(Some(-3)), bound(_None_), limit2))
def extent(s):
    match s:
        case Square(n) | Ci(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Square(9), Ci(6), Tri(1, 8), Tri(1, 9)]))
