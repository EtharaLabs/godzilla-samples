from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 4:
        return _Low()
    elif scaled < 26:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    match _pf_str_split("=", s):
        case [k, v]:
            _pf_t0 = _pf_str_to_int(v)
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some((_pf_str_strip(k), n))
            else:
                return _None_
        case _:
            return _None_
def tier(n):
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    elif isinstance(_pf_t1, _Mid):
        return "mid"
    elif isinstance(_pf_t1, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def grade(s):
    _pf_t2 = _ap_KeyVal(s)
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(grade, ["cy=-1", "hal=21", "bo=23", "ada=x"]))
def runAll(script):
    def step(acc, op):
        return acc
    def step(xs, op):
        match op:
            case Put(k, v):
                return _pf_concat(xs, [v])
            case Append(n) if n > 5:
                return _pf_concat(xs, [n * 10])
            case _:
                return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 5:
                _pf_t3 = n * 10
                xs.append(_pf_t3)
            case _:
                pass
    return xs
changes = [Append(8), Put("bolt", 6), _Noop, Append(2), _Noop, _Noop, Put("bolt", 7)]
outcome = runAll(changes)
print(outcome)
def scanSum(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([-1, 6, 9, 4, -2, -3, 9]))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 5
        return n
    return next_
tick = makeCounter(8)
