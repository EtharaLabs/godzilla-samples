        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
