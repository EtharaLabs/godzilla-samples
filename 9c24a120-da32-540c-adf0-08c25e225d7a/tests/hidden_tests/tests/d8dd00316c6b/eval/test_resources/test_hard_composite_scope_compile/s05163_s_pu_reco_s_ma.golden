from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
boxes = [Panel(2, 7, "wick"), Panel(9, 9, "nut"), Panel(8, 9, "hub"), Panel(4, 4, "sq")]
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def caption(b):
    match b:
        case Panel(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Panel(label=label, w=1):
            return f"{label} thin"
        case Panel(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, boxes)))
def stackOf(s):
    match s:
        case Shelf(top=Panel(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
parcels = [Parcel(100, "ray", 125, True), Parcel(101, "ray", 100, False), Parcel(102, "tom", 36, False), Parcel(103, "tom", 288, True)]
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by_desc(lambda o: o.amount, parcels))))
rushSum = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(rushSum)
def classify(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 185:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 185:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 4
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(4, []), score(1, [9]), score(1, [6, 2, 3])))
def extent(s):
    match s:
        case Sq(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(7), Disc(1), Wedge(5, 4), Wedge(1, 9)]))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((6, 6)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 5)))
