00000002ok00000049Seq.distinctBy : ('a -> 'b) -> (Seq 'a) -> Seq 'a0000000000000002ok0000000000000180def _pf_seq_distinct_by(f, xs):
    seen = set()
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            yield x
