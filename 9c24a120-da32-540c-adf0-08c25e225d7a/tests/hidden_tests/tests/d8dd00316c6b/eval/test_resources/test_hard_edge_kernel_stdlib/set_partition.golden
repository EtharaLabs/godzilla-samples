00000002ok00000060Set.partition : ('a -> bool) -> (Set 'a) -> (Set 'a, Set 'a)0000000000000002ok0000000000000198def _pf_set_partition(f, s):
    yes = set()
    no = set()
    for x in s:
        if f(x):
            yes.add(x)
        else:
            no.add(x)
    return (yes, no)
print(_pf_set_partition)
