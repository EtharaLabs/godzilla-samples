00000002ok00000033Async.sleep : float -> Async unit0000000000000002ok0000000000000413import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
def _pf_async_sleep(secs):
    return _pf_Async(asyncio.sleep, secs)
