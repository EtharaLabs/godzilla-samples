00000002ok00000040Task.start : (Async unit) ->{spawn} unit0000000000000002ok0000000000000534import asyncio
import contextvars
_pf_scope = contextvars.ContextVar("_pf_scope")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def _pf_task_start(c):
    _pf_scope.get().create_task(_pf_run(c))
    return None
print(_pf_task_start)
