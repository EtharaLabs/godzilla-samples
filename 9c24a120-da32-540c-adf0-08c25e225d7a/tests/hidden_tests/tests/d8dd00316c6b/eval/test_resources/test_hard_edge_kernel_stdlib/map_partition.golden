00000002ok00000075Map.partition : ('a -> 'b -> bool) -> (Map 'a 'b) -> (Map 'a 'b, Map 'a 'b)0000000000000002ok0000000000000236def _pf_map_partition(f, m):
    yes = dict()
    no = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            yes[kv[0]] = kv[1]
        else:
            no[kv[0]] = kv[1]
    return (yes, no)
