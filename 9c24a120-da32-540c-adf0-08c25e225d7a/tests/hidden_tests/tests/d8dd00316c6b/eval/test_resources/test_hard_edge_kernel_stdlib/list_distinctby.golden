00000002ok00000052List.distinctBy : ('a -> 'b) -> (List 'a) -> List 'a0000000000000002ok0000000000000206def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
print(_pf_distinct_by)
