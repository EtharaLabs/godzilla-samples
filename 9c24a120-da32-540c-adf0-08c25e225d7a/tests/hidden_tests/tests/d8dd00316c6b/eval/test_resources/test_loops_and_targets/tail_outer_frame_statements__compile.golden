from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_result_with_default(d, r):
    if isinstance(r, Ok):
        return r._0
    return d
def go(n, acc):
    while True:
        a, b = (n, acc)
        print(f"step {a}")
        t = dict()
        for x in [1, 2, 3]:
            t[x] = a
        tbl = t
        try:
            _pf_t0 = Ok(int(str(a)))
        except Exception as _pf_t1:
            _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
        r = _pf_t0
        v = _pf_result_with_default(0, r)
        if a == 0:
            return b + len(tbl)
        else:
            n, acc = (a - 1, b + v)
            continue
print(go(3, 0))
