from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class P:
    x: int
    y: int
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: int
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
def go(n, acc):
    while True:
        def helper(x):
            a, b = (x, x + 1)
            p = P(a, b)
            _pf_t0 = p
            q = P(_pf_t0.x, 9)
            m = dict([(a, b)])
            xs = [a, b, a * b]
            sl = _pf_take(2, xs)
            s = f"v={a} {b}"
            neg = -a
            c = 1 if a < b < 10 else 0
            f = lambda z: z + a
            t = _pf_fold(lambda acc2, e: acc2 + e, 0, xs)
            match Circle(a):
                case Circle(k) if k > 3:
                    _pf_t1 = k
                case Circle(k):
                    _pf_t1 = k + 1
                case Sq(k):
                    _pf_t1 = k
                case _:
                    raise RuntimeError("non-exhaustive match")
            r = _pf_t1
            match xs:
                case [h, *rest]:
                    _pf_t2 = h
                case []:
                    _pf_t2 = 0
                case _:
                    raise RuntimeError("non-exhaustive match")
            r2 = _pf_t2
            match p:
                case P(x=_x, y=y):
                    _pf_t3 = _x + y
            r3 = _pf_t3
            match (a, b):
                case (1, _) | (2, _):
                    _pf_t4 = 1
                case (u, v) as w:
                    _pf_t4 = u
            r4 = _pf_t4
            bl = not a == b and neg < 0 or c == 1
            return t + r + r2 + r3 + r4 + f(1) + q.y + len(s) + len(m) + len(sl)
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + helper(n))
            continue
print(go(10, 0))
