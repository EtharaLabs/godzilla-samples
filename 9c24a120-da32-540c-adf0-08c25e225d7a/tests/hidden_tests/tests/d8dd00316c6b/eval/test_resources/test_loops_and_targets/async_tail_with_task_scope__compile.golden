import asyncio
import contextvars
_pf_scope = contextvars.ContextVar("_pf_scope")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def _pf_task_scope(body):
    async def run():
        async def scoped():
            async with asyncio.TaskGroup() as tg:
                _pf_scope.set(tg)
                return await body
        return await asyncio.create_task(scoped())
    return _pf_Async(run)
def _pf_task_start(c):
    _pf_scope.get().create_task(_pf_run(c))
    return None
def worker(name):
    async def _pf_fn0():
        await asyncio.sleep(0.0)
        _ = print(f"worker {name}")
    return _pf_Async(_pf_fn0)
def finished(acc):
    async def _pf_fn1():
        return acc
    return _pf_Async(_pf_fn1)
def tick(n, acc):
    async def _pf_fn3(n, acc):
        while True:
            a, b = (n, acc)
            async def _pf_fn2():
                _ = _pf_task_start(worker("w"))
            await _pf_task_scope(_pf_Async(_pf_fn2))
            t = dict()
            for k in [1, 2]:
                t[k] = a
            tbl = t
            if a == 0:
                return await finished(b + len(tbl))
            else:
                n, acc = (a - 1, b + a)
                continue
    return _pf_Async(_pf_fn3, n, acc)
print(asyncio.run(_pf_run(tick(2, 0))))
