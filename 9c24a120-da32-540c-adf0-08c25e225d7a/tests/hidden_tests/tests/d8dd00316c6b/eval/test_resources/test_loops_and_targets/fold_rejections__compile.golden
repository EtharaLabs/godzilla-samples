start = (dict(), 0)
def _pf_fn0(acc, x):
    match acc:
        case (m, n):
            return (_pf_map_add(x, 1, m), n + 1)
r2 = _pf_fold(_pf_fn0, start, [1, 2])
def _pf_fn1(acc, x):
    match x:
        case acc:
            return _pf_map_add(acc, 1, dict())
r3 = _pf_fold(_pf_fn1, dict(), [1, 2])
def r4(u):
    return _pf_fold(lambda acc, m0: _pf_map_add(1, len(m0), acc), m0, [m0])
def step5(acc, x):
    _pf_t2 = _ap_Even_Odd(x)
    if isinstance(_pf_t2, _Even):
        return _pf_map_add(x, 0, acc)
    elif isinstance(_pf_t2, _Odd):
        return acc
    else:
        raise RuntimeError("non-exhaustive match")
r5 = _pf_fold(step5, dict(), [1, 2])
def _pf_fn2(acc, x):
    match (acc, x):
