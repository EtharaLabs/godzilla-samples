            return _pf_map_add(k, 1, m)
r6 = _pf_fold(_pf_fn2, dict(), [1, 2])
def step7(acc, x):
    match acc:
        case (m, n) if n > 5:
            return (m, n)
        case (m, n):
            return (_pf_map_add(x, 1, m), n)
r7 = _pf_fold(step7, (dict(), 0), [1])
def _pf_fn3(acc, x):
    match acc:
        case m:
            return _pf_map_add(x, 1, m)
r8 = _pf_fold(_pf_fn3, dict(), [1, 2])
def step9(acc, x):
    match acc:
        case (m, n):
            return (lambda p: p)((_pf_map_add(x, 1, m), n))
r9 = _pf_fold(step9, (dict(), []), [1])
