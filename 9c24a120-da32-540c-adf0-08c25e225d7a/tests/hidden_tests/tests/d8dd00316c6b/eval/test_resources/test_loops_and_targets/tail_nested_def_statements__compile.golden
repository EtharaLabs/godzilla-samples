from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def go(n, acc):
    while True:
        def helper(x):
            def inner(y):
                return y * 2
            print("in helper")
            t = dict()
            for k in [x, x + 1]:
                t[k] = x
            tbl = t
            tot = len(tbl)
            def _pf_fn0():
                yield x
                yield inner(x)
                yield from iter([tot])
            ys = _pf_fn0()
            def countdown(k, s):
                while True:
                    if k == 0:
                        return s
                    else:
                        k, s = (k - 1, s + k)
                        continue
            try:
                _pf_t0 = Ok(x / 2)
            except Exception as _pf_t1:
                _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
            w = _pf_t0
            if tot > 1:
                return countdown(x, inner(tot)) + sum(ys)
            else:
                return 0
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + helper(n))
            continue
