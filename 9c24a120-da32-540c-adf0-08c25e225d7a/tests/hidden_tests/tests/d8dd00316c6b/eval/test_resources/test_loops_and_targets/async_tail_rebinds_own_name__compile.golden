import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def tick(n):
    async def _pf_fn1():
        tick = lambda k: finished(k * 10)
        if n == 0:
            return await finished(0)
        else:
            return await tick(n - 1)
    return _pf_Async(_pf_fn1)
print(asyncio.run(_pf_run(tick(3))))
