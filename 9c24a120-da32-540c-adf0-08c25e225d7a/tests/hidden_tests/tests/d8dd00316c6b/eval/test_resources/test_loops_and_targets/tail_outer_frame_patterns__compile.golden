from dataclasses import dataclass
@dataclass(frozen=True, slots=True)
class Pt:
    x: int
    y: int
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: int
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
def go(n, acc):
    while True:
        t = dict()
        for (k, v) in [(n, acc), (0, 1)]:
            t[k] = v
        pairs = t
        match Pt(n, acc):
            case Pt(x=x, y=y) if x > y:
                _pf_t0 = x
            case Pt(x=x, y=y):
                _pf_t0 = y
        a = _pf_t0
        match (n, acc):
            case (0, _) | (_, 0):
                _pf_t1 = 1
            case (p, q) as both:
                _pf_t1 = p
        b = _pf_t1
        match [n, acc]:
            case [h, *rest]:
                _pf_t2 = h
            case _:
                _pf_t2 = 0
        c = _pf_t2
        match Sq(n):
            case Circle(r) as whole:
                _pf_t3 = r
            case Sq(s):
                _pf_t3 = s
            case _:
                raise RuntimeError("non-exhaustive match")
        d = _pf_t3
        if n <= 0:
            return acc + len(pairs)
        else:
            n, acc = (n - 1, acc + a + b + c + d)
            continue
print(go(4, 1))
