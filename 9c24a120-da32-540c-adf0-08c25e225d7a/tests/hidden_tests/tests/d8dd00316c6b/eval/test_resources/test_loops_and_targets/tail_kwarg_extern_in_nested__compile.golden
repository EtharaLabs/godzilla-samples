def go(n, acc):
    while True:
        def conv(s):
            return int(s, base=16) + int(s, base=16)
        partial = lambda _pf_k0: int("ff", base=_pf_k0)
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + conv("a") + partial(16))
            continue
print(go(2, 0))
