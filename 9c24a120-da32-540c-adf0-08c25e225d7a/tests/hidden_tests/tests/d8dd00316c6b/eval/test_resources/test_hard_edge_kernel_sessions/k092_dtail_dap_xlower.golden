def _ap_Even_Odd(k):
    if k % 2 == 0:
        return _Even()
    else:
        return _Odd()
def parity(k):
    _pf_t0 = _ap_Even_Odd(k)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
