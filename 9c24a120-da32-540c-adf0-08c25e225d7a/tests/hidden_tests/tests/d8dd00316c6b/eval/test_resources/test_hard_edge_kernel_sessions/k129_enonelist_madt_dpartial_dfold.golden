00000463@dataclass(frozen=True, slots=True, repr=False)
class Heads:
    def __repr__(self):
        return "Heads"
_Heads = Heads()
@dataclass(frozen=True, slots=True, repr=False)
class Tails:
    def __repr__(self):
        return "Tails"
_Tails = Tails()
def flip(c):
    match c:
        case Heads():
            return _Tails
        case Tails():
            return _Heads
        case _:
            raise RuntimeError("non-exhaustive match")
print(flip(_Heads))
