00000463@dataclass(frozen=True, slots=True, repr=False)
class Heads:
    def __repr__(self):
        return "Heads"
_Heads = Heads()
@dataclass(frozen=True, slots=True, repr=False)
class Tails:
    def __repr__(self):
        return "Tails"
