00000002ok00000016job : Async int
00000436class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_fn1():
    async def _pf_fn0():
        return 20
    x = await _pf_fn0()
    return x + 1
job = _pf_Async(_pf_fn1)
00000002ok00000020flip : Coin -> Coin
00000497from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Heads:
    def __repr__(self):
        return "Heads"
_Heads = Heads()
@dataclass(frozen=True, slots=True, repr=False)
class Tails:
    def __repr__(self):
        return "Tails"
_Tails = Tails()
def flip(c):
    match c:
        case Heads():
            return _Tails
        case Tails():
            return _Heads
        case _:
            raise RuntimeError("non-exhaustive match")
print(flip(_Heads))
