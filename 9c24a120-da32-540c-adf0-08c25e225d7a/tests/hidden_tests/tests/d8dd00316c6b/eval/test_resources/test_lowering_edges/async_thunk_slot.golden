import functools
import asyncio
import m
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
def _pf_async_sleep(secs):
    return _pf_Async(asyncio.sleep, secs)
async def _pf_run(a):
    return await a
def job(_):
    async def _pf_fn0():
        return 1
    return _pf_Async(_pf_fn0)
def _pf_fn2(_):
    async def _pf_fn3():
        return 2
    return _pf_Async(_pf_fn3)
a = m.run_later(lambda: _pf_run(_pf_fn2(None)))
b = m.run_later(lambda: _pf_run(job(None)))
c = _pf_Async(functools.partial(m.get, "u", timeout=5))
s = _pf_async_sleep
async def _pf_fn4():
    await s(0.0)
    body = await functools.partial(m.get, "v", timeout=5)()
    return body
d = _pf_Async(_pf_fn4)
