from dataclasses import dataclass
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class P:
    x: int
    y: int
p = P(1, 2)
k = 10
fs = [lambda b: (p.x + b if b < p.x < 100 else -b)]
g1 = lambda b: _pf_map(lambda c: c + k + b, [k, b])
g2 = lambda b: _pf_map(lambda a: a * b, [k])
g3 = lambda b: (k, not k == b, f"{k}-{b}")
g4 = lambda b: _pf_take(1, b)
g5 = lambda b: dict([("key", b)])
g6 = lambda b: _pf_str_join("+", [b, b])
print(g1(1))
print(g2(3))
print(g3(4))
print(g4([7, 8, 9]))
print(g5(2))
print(g6("z"))
