from dataclasses import dataclass
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
@dataclass(frozen=True, slots=True, repr=False)
class A:
    def __repr__(self):
        return "A"
_A: A = A()
@dataclass(frozen=True, slots=True, repr=False)
class B:
    _0: int
    def __repr__(self):
        return f"B({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pair:
    _0: int
    _1: int
    def __repr__(self):
        return f"Pair({self._0!r}, {self._1!r})"
T = A | B | Pair
def v(t: T) -> int:
    match t:
        case A():
            _pf_t0 = 1
        case B(n) if n > 0:
            _pf_t0 = n
        case B(_):
            _pf_t0 = 0
        case Pair(_, _):
            _pf_t0 = 2
        case _:
            raise RuntimeError("non-exhaustive match")
    r = _pf_t0
    return r + 1
def w(t: T) -> int:
    if isinstance(t, Pair) and (t._0 == 1 or t._0 == 2):
        y = t._1
        return y
    elif isinstance(t, Pair):
        return 0
    elif isinstance(t, B) and (t._0 == 5 or t._0 == 6):
        return 5
    else:
        return -1
def z(t: T) -> int:
    if isinstance(t, A):
        return 0
    elif isinstance(t, B):
        n = t._0
        return n
    elif isinstance(t, Pair):
        a = t._0
        b = t._1
        return a + b
    else:
        if isinstance(t, B):
            n = t._0
            if n > 3:
                return 99
        raise RuntimeError("non-exhaustive match")
def f(x: int):
    async def _pf_fn0():
        return x + 1
    return _pf_Async(_pf_fn0)
def g(x: int):
    return lambda y: x + y
print(v(B(3)))
print(w(Pair(2, 7)))
print(w(Pair(9, 7)))
print(w(B(6)))
print(z(B(4)))
