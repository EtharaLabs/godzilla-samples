from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Pair:
    _0: int
    _1: int
    def __repr__(self):
        return f"Pair({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class One:
    _0: int
    def __repr__(self):
        return f"One({self._0!r})"
T = Pair | One
@dataclass(frozen=True, slots=True, repr=False)
class Wrap:
    _0: "T"
    def __repr__(self):
        return f"Wrap({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Empty:
    def __repr__(self):
        return "Empty"
_Empty: Empty = Empty()
U = Wrap | Empty
def f(u: U) -> str:
    if isinstance(u, Wrap) and (isinstance(u._0, Pair) and u._0._0 == 1 and u._0._1 == 2 or isinstance(u._0, Pair) and u._0._0 == 3 and u._0._1 == 4):
        return "low"
    elif isinstance(u, Wrap):
        return "other"
    else:
        return "empty"
print(f(Wrap(Pair(3, 4))))
print(f(Wrap(One(1))))
print(f(_Empty))
