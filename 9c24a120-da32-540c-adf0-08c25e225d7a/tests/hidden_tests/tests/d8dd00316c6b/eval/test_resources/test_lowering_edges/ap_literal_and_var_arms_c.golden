from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_str_slice(start, end, s):
    return s[start:end]
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Prefix(p, s):
    if s.startswith(p):
        return Some(_pf_str_slice(len(p), len(s), s))
    else:
        return _None_
def _ap_Flag(b, x):
    return x == b
def classify(n):
    _pf_t0 = _ap_Even_Odd(n)
    if n == 0:
        return "zero"
    elif isinstance(_pf_t0, _Even):
        return "even"
    else:
        other = n
        return f"odd {other}"
def strip(s):
    _pf_t1 = _ap_Prefix("ab", s)
    _pf_t2 = _ap_Prefix("x", s)
    if s == "":
        return "empty"
    elif isinstance(_pf_t1, Some):
        rest = _pf_t1._0
        return rest
    elif isinstance(_pf_t2, Some):
        return "x-thing"
    else:
        return s
def flag(b):
    _pf_t3 = _ap_Flag(False, b)
    if b == True:
        return "yes"
    elif _pf_t3:
        return "no"
    else:
        return "?"
pre = "q"
def byvar(s):
    _pf_t4 = _ap_Prefix(pre, s)
    if isinstance(_pf_t4, Some):
        r = _pf_t4._0
        return r
    else:
        return "none"
print(classify(0))
print(classify(4))
print(classify(7))
print(strip(""))
print(strip("abc"))
print(strip("xy"))
print(strip("zz"))
print(flag(True))
print(flag(False))
print(byvar("qrs"))
