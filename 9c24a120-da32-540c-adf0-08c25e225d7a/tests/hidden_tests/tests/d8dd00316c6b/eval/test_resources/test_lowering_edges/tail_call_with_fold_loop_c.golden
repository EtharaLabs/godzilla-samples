def _pf_map_values(m):
    return list(m.values())
def rec_sum(n, acc, xs):
    while True:
        if n == 0:
            return acc
        else:
            d = dict()
            for x in xs:
                _pf_t0 = x * n
                d[x] = _pf_t0
            m = d
            n, acc, xs = (n - 1, acc + sum(_pf_map_values(m)), xs)
            continue
print(rec_sum(3, 0, [1, 2]))
