import m
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def handler(s):
    async def _pf_fn0():
        _ = print(s)
    return _pf_Async(_pf_fn0)
g2 = lambda b: m.serve(lambda *_pf_a: _pf_run(handler(*_pf_a))) + 1 + b
print("ok")
