from dataclasses import dataclass
import functools
import json
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_dec_decode_string(dec, s):
    try:
        return Ok(dec(json.loads(s)))
    except Exception as e:
        return Error(_Exception(type(e).__name__, str(e)))
def _pf_dec_field(name, dec):
    def go(v):
        if not isinstance(v, dict):
            raise ValueError("expected a JSON object")
        return dec(v[name])
    return go
def _pf_dec_int(v):
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    raise ValueError("expected an int, got " + type(v).__name__)
def _pf_dec_one_of(decs):
    def go(v):
        def _try(i):
            if i >= len(decs):
                raise ValueError("Decode.oneOf: no decoder matched")
            try:
                return decs[i](v)
            except Exception:
                return _try(i + 1)
        return _try(0)
    return go
@dataclass(frozen=True, slots=True)
class Cfg:
    key: str
    alt: str
cfg = Cfg("n", "m")
def M_parse(s):
    return _pf_dec_decode_string(_pf_dec_int, s)
parseInt = functools.partial(_pf_dec_decode_string, _pf_dec_int)
decs = [_pf_dec_field("a", _pf_dec_int), _pf_dec_field("b", _pf_dec_int)]
def either(s):
    return _pf_dec_decode_string(_pf_dec_one_of(decs), s)
def byCfg(s):
    try:
        _pf_t0 = json.loads(s)
        if not isinstance(_pf_t0, dict):
            raise ValueError("expected a JSON object")
        _pf_t1 = _pf_t0[cfg.key]
        if not (isinstance(_pf_t1, int) and not isinstance(_pf_t1, bool)):
            raise ValueError("expected an int, got " + type(_pf_t1).__name__)
        _pf_t2 = Ok(_pf_t1)
    except Exception as e:
        _pf_t2 = Error(_Exception(type(e).__name__, str(e)))
    return _pf_t2
print(M_parse("5"))
print(parseInt("6"))
print(either("{\"b\": 2}"))
print(byCfg("{\"n\": 7}"))
