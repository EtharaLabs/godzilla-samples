from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
xs = [4, 5]
if xs:
    x = xs[0]
    _pf_t0 = x * 10
else:
    _pf_t0 = 0
a = _pf_t0
match _pf_head(xs):
    case Some(4):
        _pf_t1 = "four"
    case _:
        _pf_t1 = "other"
b = _pf_t1
_pf_t3 = []
if _pf_t3:
    y = _pf_t3[0]
    _pf_t2 = y
else:
    _pf_t2 = -1
c = _pf_t2
print(a)
print(b)
