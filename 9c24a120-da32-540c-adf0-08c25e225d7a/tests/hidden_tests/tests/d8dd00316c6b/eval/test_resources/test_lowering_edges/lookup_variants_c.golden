from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
m = dict([("a", 1)])
def has(k):
    if k in m:
        return True
    else:
        return False
def first(xs):
    if xs:
        x = xs[0]
        return x
    else:
        return 0
def lit(xs):
    match _pf_head(xs):
        case Some(1):
            return "one"
        case _:
            return "other"
_pf_t1 = [5, 6]
if 0 <= 1 < len(_pf_t1):
    y = _pf_t1[1]
    _pf_t0 = y
else:
    _pf_t0 = 0
v = _pf_t0
print(has("a"))
print(has("b"))
print(first([9, 8]))
print(first([]))
print(lit([1]))
print(lit([2]))
print(v)
