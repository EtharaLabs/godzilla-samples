from dataclasses import dataclass
import json
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_is_empty(xs):
    return len(xs) == 0
def _pf_list_contains(x, xs):
    return x in xs
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_contains(k, m):
    return k in m
def _pf_min_by(f, xs):
    return Some(min(xs, key=f)) if xs else _None_
def _pf_res_iter(f, r):
    if isinstance(r, Ok):
        f(r._0)
    return None
def _pf_set_contains(x, s):
    return x in s
def _pf_str_ends_with(suf, s):
    return s.endswith(suf)
def _pf_str_starts_with(pre, s):
    return s.startswith(pre)
def _pf_dec_decode_string(dec, s):
    try:
        return Ok(dec(json.loads(s)))
    except Exception as e:
        return Error(_Exception(type(e).__name__, str(e)))
def _pf_dec_fail(msg):
    def go(v):
        raise ValueError(msg)
    return go
def _pf_dec_nullable(dec):
    def go(v):
        return None_() if v is None else Some(dec(v))
    return go
def _pf_dec_string(v):
    if isinstance(v, str):
        return v
    raise ValueError("expected a string, got " + type(v).__name__)
preds = [_pf_is_empty, _pf_is_empty]
cont = _pf_list_contains
sc = _pf_set_contains
mc = _pf_map_contains
sw = _pf_str_starts_with
ew = _pf_str_ends_with
mb = _pf_min_by
ri = _pf_res_iter
db = _pf_distinct_by
dn = _pf_dec_nullable
df = _pf_dec_fail
