def _pf_map_values(m):
    return list(m.values())
def collect(n, acc, pairs):
    while True:
        if n == 0:
            return acc
        else:
            d = dict()
            for (k, v) in pairs:
                _pf_t0 = v * n
                d[k] = _pf_t0
            m = d
            n, acc, pairs = (n - 1, acc + sum(_pf_map_values(m)), pairs)
            continue
print(collect(3, 0, [("a", 1), ("b", 2)]))
