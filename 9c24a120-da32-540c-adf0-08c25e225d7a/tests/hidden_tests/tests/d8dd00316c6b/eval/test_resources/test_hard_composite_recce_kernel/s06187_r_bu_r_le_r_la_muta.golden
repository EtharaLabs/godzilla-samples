00002246def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fst(p):
    return p[0]
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 4], lambda k: Grid_yield_(a * b + k))
cells = Grid_combine(Grid_for_([(1, 3), (5, 5)], _pf_fn0), Grid_delay(lambda _: Grid_yield_(5)))
print(cells)
def fem(n):
    if n == 0:
        return 1
    else:
        return n - male(fem(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - fem(male(n - 1))
print((_pf_map(fem, _pf_range(0, 9)), _pf_map(male, _pf_range(0, 5))))
inputs2 = [20, 7, -5, 18, -4, 24, 2]
factor = 2
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(inputs2))))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(inputs2), inputs2))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(inputs2)))
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(8), scalers))
calls = 0
def record(x):
    global calls
    calls = calls + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([27, 46, 35, 16, 3, 42, 35, -5]))
doubled = _pf_map(record, [27, 46, 35, 16])
print(f"{doubled} after {calls} calls")
