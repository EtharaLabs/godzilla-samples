def render(t):
    match t:
        case Store(0):
            return "store-0"
        case Store(n0):
            return f"store({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
