inputs2 = [26, 29, 24, 17, 8, 11, 12, 5]
factor = 2
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn0, _pf_zip(inputs2, _pf_map(lambda x: x * x, inputs2)))))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(inputs2)))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(inputs2), inputs2))
