def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def area(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, boxes)))
def stackOf(s):
    match s:
        case Rack(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(lambda acc, x: add(x, acc), _Leaf, [41, 9, 24, 36, 10, 51])
def sumT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumT(l) + v + sumT(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumT(root))
def containsOf(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsOf(k, root), [41, 52, 24]))
def toListT(t):
    match t:
        case Leaf():
            return []
        case Node(l, v, rt):
            return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
        case _:
            raise RuntimeError("non-exhaustive match")
print(toListT(root))
def depthOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, _, rt):
            return 1 + max(depthOf(l), depthOf(rt))
        case _:
            raise RuntimeError("non-exhaustive match")
print(depthOf(root))
