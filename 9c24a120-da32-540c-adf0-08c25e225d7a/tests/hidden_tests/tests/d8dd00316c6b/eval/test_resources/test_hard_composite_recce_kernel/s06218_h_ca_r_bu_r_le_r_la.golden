def inWord(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    return inSpace(rest, n)
                else:
                    cs, n = (rest, n)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
def inSpace(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    cs, n = (rest, n)
                    continue
                else:
                    return inWord(rest, n + 1)
            case _:
                raise RuntimeError("non-exhaustive match")
print(inSpace(list("kit pam ivy"), 0))
