00002633import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def Logged_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Logged_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def compute(x):
    return Logged_bind(tell(f"start {x}"), lambda _: Logged_bind((x * 3, ["scaled"]), lambda y: (lambda z: Logged_bind(tell(f"z={z}"), lambda _: Logged_return_(z)))(y + 7)))
print(_pf_map(compute, [7, 6]))
seriesA = [0, -8, -7, 23, -7, 0, 21]
gain = 3
scalers = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(2), scalers))
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn0, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), seriesA))
ticks = 0
def record(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([30, 32, 38, 18, 10, 53, -8, 54]))
doubled = _pf_map(record, [30, 32, 38, 18])
print(f"{doubled} after {ticks} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), ticks))
def inWord(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    return inSpace(rest, n)
                else:
                    cs, n = (rest, n)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
def inSpace(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    cs, n = (rest, n)
                    continue
                else:
                    return inWord(rest, n + 1)
            case _:
                raise RuntimeError("non-exhaustive match")
print(inSpace(list("hal ada bo tom eli"), 0))
