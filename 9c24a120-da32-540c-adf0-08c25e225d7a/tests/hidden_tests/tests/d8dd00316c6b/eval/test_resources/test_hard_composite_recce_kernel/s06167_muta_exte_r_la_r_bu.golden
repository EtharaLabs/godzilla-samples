print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(seriesA), seriesA))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(seriesA))))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def compute(x):
    return Writer_bind(note2(f"start {x}"), lambda _: Writer_bind((x * 3, ["scaled"]), lambda y: (lambda z: Writer_bind(note2(f"z={z}"), lambda _: Writer_return_(z)))(y + 3)))
print(_pf_map(compute, [9, 0]))
