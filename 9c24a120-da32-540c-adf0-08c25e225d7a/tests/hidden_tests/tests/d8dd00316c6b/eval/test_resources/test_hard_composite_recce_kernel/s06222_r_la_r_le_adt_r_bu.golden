def render(t):
    match t:
        case Turn(n0) if n0 > 2:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Push(s0):
            return f"push({s0})"
        case Jump():
            return f"jump"
        case Skip(2):
            return "skip-2"
        case Skip(n0):
            return f"skip({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
