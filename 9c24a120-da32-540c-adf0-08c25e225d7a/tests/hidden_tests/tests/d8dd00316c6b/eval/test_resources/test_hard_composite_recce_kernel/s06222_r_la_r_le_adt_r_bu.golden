def ping(n, acc):
    if n <= 0:
        return acc
    else:
        return pong(n - 1, acc + 1)
def pong(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
