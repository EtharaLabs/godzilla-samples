def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
