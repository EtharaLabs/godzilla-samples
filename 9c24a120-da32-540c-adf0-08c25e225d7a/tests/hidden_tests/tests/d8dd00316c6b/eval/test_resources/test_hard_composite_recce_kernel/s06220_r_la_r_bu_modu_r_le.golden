00002043import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
inputs2 = [27, -9, 17, 5, 27]
factor = 3
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn0, _pf_zip(inputs2, _pf_map(lambda x: x * x, inputs2)))))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(inputs2), inputs2))
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(2), scalers))
tweak2 = lambda _pf_x: (lambda z: z - 4)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, inputs2))
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(tell(f"start {x}"), lambda _: Writer_bind((x * 4, ["scaled"]), lambda y: (lambda z: Writer_bind(tell(f"z={z}"), lambda _: Writer_return_(z)))(y + 6)))
print(_pf_map(trace2, [3, 0]))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
obs = [10, 29, -1, -4, 2, -12, -10]
print(Geo_mean(obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 15), obs))
print(_pf_filter(functools.partial(Geo_between, 5, 13), obs))
def fem(n):
    if n == 0:
        return 1
    else:
        return n - mal(fem(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - fem(mal(n - 1))
def _pf_range(lo, hi):
    return list(range(lo, hi))
print((_pf_map(fem, _pf_range(0, 7)), _pf_map(mal, _pf_range(0, 6))))
