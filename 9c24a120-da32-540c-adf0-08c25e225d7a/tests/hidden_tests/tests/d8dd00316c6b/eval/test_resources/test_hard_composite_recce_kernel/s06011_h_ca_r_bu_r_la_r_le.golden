def fem(n):
    if n == 0:
        return 1
    else:
        return n - male(fem(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - fem(male(n - 1))
def _pf_range(lo, hi):
    return list(range(lo, hi))
