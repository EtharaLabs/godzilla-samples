def render(t):
    match t:
        case Pop(s0):
            return f"pop({s0})"
        case Load(n0, n1) if n0 > 3:
            return f"load!({n0},{n1})"
        case Load(n0, n1):
            return f"load({n0},{n1})"
        case Push(n0):
            return f"push({n0})"
        case Skip(3, _):
            return "skip-3"
        case Skip(n0, s1):
            return f"skip({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Pop(_):
            return 7
        case Push(x0):
            return x0 * 5
        case Load(x0, x1):
            return x0 + x1
        case _:
            return 1
