def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(note2(f"start {x}"), lambda _: Writer_bind((x * 3, ["scaled"]), lambda y: (lambda z: Writer_bind(note2(f"z={z}"), lambda _: Writer_return_(z)))(y + 3)))
