00003319from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
