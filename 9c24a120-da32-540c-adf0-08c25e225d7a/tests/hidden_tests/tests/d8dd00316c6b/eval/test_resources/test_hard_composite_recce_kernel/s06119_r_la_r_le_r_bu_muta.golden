00002569from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
nums2 = [-8, 27, -3, -7, 23, -9]
factor = 5
makers2 = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(1), makers2))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(nums2), nums2))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), nums2))
def fem(n):
    if n == 0:
        return 1
    else:
        return n - mal(fem(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - fem(mal(n - 1))
print((_pf_map(fem, _pf_range(0, 6)), _pf_map(mal, _pf_range(0, 7))))
def Perhaps_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Perhaps_return_(x):
    return Some(x)
def ratio2(a, b):
    return Perhaps_bind(_pf_str_to_int(a), lambda x: Perhaps_bind(_pf_str_to_int(b), lambda y: Perhaps_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Perhaps_return_(shown))(q * 2))))
print((ratio2("64", "6"), ratio2("4", "0"), ratio2("x", "1")))
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 4
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
