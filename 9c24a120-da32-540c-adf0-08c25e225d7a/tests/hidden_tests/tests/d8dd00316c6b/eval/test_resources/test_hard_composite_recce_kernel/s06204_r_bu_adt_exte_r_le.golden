def explain(t):
    match t:
        case Mark(n0) if 0 <= n0 < 19:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Pop(n0, s1) if 0 <= n0 < 18:
            return f"pop!({n0},{s1})"
        case Pop(n0, s1):
            return f"pop({n0},{s1})"
        case Skip(s0, n1):
            return f"skip({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Mark(x0):
            return x0 * 3
        case _:
            return 0
