print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(inputs2), inputs2))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(inputs2))))
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 3
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([38, 22, -5, -10, 0, 52, 7]))
