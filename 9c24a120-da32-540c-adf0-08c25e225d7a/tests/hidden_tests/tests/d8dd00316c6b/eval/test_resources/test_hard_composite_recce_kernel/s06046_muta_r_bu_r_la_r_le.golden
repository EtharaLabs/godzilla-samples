def stepA(n, acc):
    if n <= 0:
        return acc
    else:
        return stepB(n - 1, acc + 1)
def stepB(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return stepA(n - 3, acc - 1)
print(_pf_map(lambda n: stepA(n, 1), [20, 9, 16, 2]))
