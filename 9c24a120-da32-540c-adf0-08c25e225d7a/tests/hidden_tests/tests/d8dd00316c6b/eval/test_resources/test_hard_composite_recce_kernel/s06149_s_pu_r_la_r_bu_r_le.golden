print(_pf_map(tweak2, inputs2))
def Logged_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Logged_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def trace2(x):
    return Logged_bind(note2(f"start {x}"), lambda _: Logged_bind((x * 3, ["scaled"]), lambda y: (lambda z: Logged_bind(note2(f"z={z}"), lambda _: Logged_return_(z)))(y + 5)))
print(_pf_map(trace2, [0, 3]))
def ping(n, acc):
    if n <= 0:
        return acc
    else:
        return stepB(n - 1, acc + 1)
def stepB(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
print(_pf_map(lambda n: ping(n, 1), [11, 11, 7, 5]))
