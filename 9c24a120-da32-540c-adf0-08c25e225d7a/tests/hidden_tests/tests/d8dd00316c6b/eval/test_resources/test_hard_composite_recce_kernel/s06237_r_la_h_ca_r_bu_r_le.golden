00002091import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fst(p):
    return p[0]
inputs2 = [-8, 3, 2, 9, 2, 22, 28, 15]
gain = 2
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), inputs2))
tweak2 = lambda _pf_x: (lambda z: z - 6)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, inputs2))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(inputs2))))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
forEach(shout, [1, 3, 5])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 7) + chatty(False, 7))
def quiet(x):
    return x + 9
print(mapTwice(quiet, [7]))
def Logged_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Logged_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def trace2(x):
    return Logged_bind(tell(f"start {x}"), lambda _: Logged_bind((x * 4, ["scaled"]), lambda y: (lambda z: Logged_bind(tell(f"z={z}"), lambda _: Logged_return_(z)))(y + 5)))
print(_pf_map(trace2, [7, 4]))
def fem(n):
    if n == 0:
        return 1
    else:
        return n - mal(fem(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - fem(mal(n - 1))
def _pf_range(lo, hi):
    return list(range(lo, hi))
print((_pf_map(fem, _pf_range(0, 11)), _pf_map(mal, _pf_range(0, 4))))
