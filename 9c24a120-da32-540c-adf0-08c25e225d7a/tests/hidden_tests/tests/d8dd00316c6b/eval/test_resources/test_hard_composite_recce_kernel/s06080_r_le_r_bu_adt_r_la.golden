def describe(t):
    match t:
        case Load(n0) if n0 % 2 == 0:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Skip():
            return f"skip"
        case Rest(s0, s1):
            return f"rest({s0},{s1})"
        case Store(n0) if n0 % 2 == 0:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
