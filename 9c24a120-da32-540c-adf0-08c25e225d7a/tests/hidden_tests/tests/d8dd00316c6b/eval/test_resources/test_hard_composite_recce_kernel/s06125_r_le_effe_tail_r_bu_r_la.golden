factor = 4
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), nums2))
tweak2 = lambda _pf_x: (lambda z: z - 1)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, nums2))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fst(p):
    return p[0]
def _pf_fn2(_pf_arg0):
    i, x = _pf_arg0
