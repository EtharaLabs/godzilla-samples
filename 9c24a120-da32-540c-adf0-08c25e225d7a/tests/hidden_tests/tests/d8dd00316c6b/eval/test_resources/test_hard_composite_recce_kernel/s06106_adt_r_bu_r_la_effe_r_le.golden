00003272from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: str
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
_Push = Push()
def show(t):
    match t:
        case Drop(s0):
            return f"drop({s0})"
        case Mark(s0):
            return f"mark({s0})"
        case Push():
            return f"push"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Mark(_):
            return 9
        case Drop(_):
            return 8
        case _:
            return 1
