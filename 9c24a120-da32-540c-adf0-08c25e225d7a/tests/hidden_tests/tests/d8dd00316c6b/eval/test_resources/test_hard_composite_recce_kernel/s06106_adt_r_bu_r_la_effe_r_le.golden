def isEven2(n):
    if n == 0:
        return True
    else:
        return oddP(n - 1)
def oddP(n):
    if n == 0:
        return False
    else:
        return isEven2(n - 1)
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
