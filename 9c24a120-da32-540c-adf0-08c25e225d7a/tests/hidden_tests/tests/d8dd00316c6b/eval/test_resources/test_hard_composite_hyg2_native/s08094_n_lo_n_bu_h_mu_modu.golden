import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_str_concat(a, b):
    return a + b
def _pf_fn0():
    for (name, k) in [("a", 2), ("b", 7)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(4), list(handlers)))
acc = []
for k in [3, 7, 5]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(4), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 9
    return _pf_map(lambda g: g(n), fs)
print(offsets(9, [8, 9, 4]))
str_: str = "fay"
print((str(67), str_, _pf_str_concat(str_, str(1))))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([5, 9, 3, 7]), _pf_sort([3, 1, 2])))
list_: list[int] = [0, 0, 9]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def set_(n: int) -> int:
    return n * 5
print((set_(3), len(set([5, 5, 0, 1]))))
def inspect(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([10, 34, 12, 37, 27]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "lu", "stop"])
print((logged, counts))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
obs: list[int] = [-9, 16, 19, 15, 30, 10, -7]
print(Stats_scaleAll(5, obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 8), obs))
print(_pf_filter(functools.partial(Stats_between, 3, 15), obs))
print(Stats_norm1(obs))
