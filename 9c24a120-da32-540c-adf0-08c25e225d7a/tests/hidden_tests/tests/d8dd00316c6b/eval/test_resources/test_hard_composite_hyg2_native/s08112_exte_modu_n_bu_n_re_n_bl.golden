import functools
import math
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
print(_pf_map(math.isqrt, [258, 371, 319, 79]))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [5, 5, 6, 5]))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_between(lo, hi, x):
    return lo <= x <= hi
obs: list[int] = [26, -4, 17, -14, -2, 10]
print(_pf_map(functools.partial(Text_clamp, 0, 10), obs))
print(Text_norm1(obs))
print(_pf_filter(functools.partial(Text_between, 5, 14), obs))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(11, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def build(start: int) -> tuple[int, list[int], int]:
    acc = start
    def g0(y: int) -> int:
        return acc * y
    acc = acc + 6
    g1 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 5
    return (g0(2), g1([1, 2]), acc)
print(build(1))
def bump2(n: int) -> int:
    return n + 32
def useHelper(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 5
    tmp = useHelper(bump2)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [5]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + useHelper(1)
    else:
        return 0
beta: int = _pf_fn1()
def _pf_fn2():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
third: int = _pf_fn2()
print((alpha, beta, third, useHelper(0)))
