from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Bst"
    _1: int
    _2: "Bst"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Bst = Leaf | Node
def build(start: int) -> tuple[int, list[int], list[int], int]:
    base = start
    g0 = lambda y: base + y
    base = base * 4
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 6
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 8
    return (g0(2), g1([1, 2]), g2([1, 2]), base)
print(build(7))
def add(x: int, t: Bst) -> Bst:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(add(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, add(x, rt))
        return t
root: Bst = _pf_fold(lambda acc, x: add(x, acc), _Leaf, [42, 56, 13, 11, 10, 37, 46, 7])
def containsT(x: int, t: Bst) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
print(_pf_map(lambda k: containsT(k, root), [42, 8, 13]))
def minT(t: Bst) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minT(root))
def sumT(t: Bst) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumT(l) + v + sumT(rt)
print(sumT(root))
def _pf_fn0():
    for (name, k) in [("a", 7), ("b", 3)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(5), list(handlers)))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(offsets(6, [2, 2, 6]))
