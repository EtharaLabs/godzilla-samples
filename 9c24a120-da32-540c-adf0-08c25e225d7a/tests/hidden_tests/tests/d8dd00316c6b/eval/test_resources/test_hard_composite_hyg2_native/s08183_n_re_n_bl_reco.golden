from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
def build(start: int) -> tuple[list[int], int, int, int]:
    level = start
    g0 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 3
    def g1(y: int) -> int:
        return level * y
    level = level + 6
    def g2(y: int) -> int:
        return level * y
    level = level * 4
    return (g0([1, 2]), g1(5), g2(4), level)
print(build(6))
