    return n + 24
def useHelper(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 9
    tmp = useHelper(bump2)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third: int = _pf_fn2()
print((first, second, third, useHelper(0)))
parcels: list[Parcel] = [Parcel(100, "dee", 234, False), Parcel(101, "hal", 285, True), Parcel(102, "pam", 35, True), Parcel(103, "hal", 288, False), Parcel(104, "pam", 162, False)]
urgentTotal: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(urgentTotal)
def _pf_fn3(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn3, _pf_group_by(lambda o: o.owner, parcels))
print(byOwner)
def bucket(o: Parcel) -> str:
    if isinstance(o, Parcel) and o.urgent is True:
        amount = o.amount
        if amount > 55:
            return "rush-big"
    if isinstance(o, Parcel) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 55:
            return "big"
        else:
            return "normal"
print(_pf_map(bucket, parcels))
print(_pf_count_by(bucket, parcels))
def tag(_pf_arg0: Parcel) -> str:
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, parcels)))
