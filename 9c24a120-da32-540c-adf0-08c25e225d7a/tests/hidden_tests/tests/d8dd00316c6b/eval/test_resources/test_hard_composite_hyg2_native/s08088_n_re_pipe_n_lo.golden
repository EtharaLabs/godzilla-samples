import functools
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def layer(start: int) -> tuple[int, int, int, int, int]:
    acc = start
    def g0(y: int) -> int:
        return acc * y
    acc = g0(acc)
    g1 = lambda y: acc + y
    acc = g1(acc)
    def g2(y: int) -> int:
        return acc * y
    acc = acc + 7
    g3 = lambda y: acc + y
    acc = acc * 4
    return (g0(5), g1(5), g2(3), g3(2), acc)
