tally: int = _pf_sum_by(weight, batch)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: weight(t) > 1, batch)))
def stack2(start: int) -> tuple[int, int, int]:
    acc = start
    g0 = lambda y: acc + y
    acc = g0(acc)
    def g1(y: int) -> int:
        return acc * y
    acc = acc + 5
    return (g0(4), g1(2), acc)
print(stack2(8))
