third: int = _pf_fn2()
print((alpha, second, third, useHelper(0)))
def render(t: Cmd) -> str:
    if isinstance(t, Mark):
        n0 = t._0
        return f"mark({n0})"
    elif isinstance(t, Load):
        s0 = t._0
        n1 = t._1
        return f"load({s0},{n1})"
    elif isinstance(t, Emit):
        s0 = t._0
        return f"emit({s0})"
    elif isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    else:
        return f"skip"
def weight(t: Cmd) -> int:
    if isinstance(t, Emit):
        return 3
    elif isinstance(t, Load):
        x1 = t._1
        return x1
    elif isinstance(t, Skip):
        return 3
    else:
        return 0
batch: list[Cmd] = [Store(10), Store(5), _Skip, Store(2)]
