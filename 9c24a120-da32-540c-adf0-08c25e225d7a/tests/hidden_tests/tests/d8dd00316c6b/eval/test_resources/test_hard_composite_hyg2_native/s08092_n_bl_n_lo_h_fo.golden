from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Op = Put | Push | Skip
def lift(n: int) -> int:
    return n + 74
def callHelper(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 1
    tmp = callHelper(lift)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + callHelper(1)
    else:
        return 0
beta: int = _pf_fn1()
def _pf_fn2():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, beta, gamma, callHelper(0)))
def _pf_fn3():
    for (name, k) in [("a", 6), ("b", 5)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn3()
print(_pf_map(lambda h: h(4), list(handlers)))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 7
    return _pf_map(lambda g: g(n), fs)
print(shifted(4, [7, 4, 1]))
def step(acc: tuple[dict[str, int], list[int]], op: Op) -> tuple[dict[str, int], list[int]]:
    m = acc[0]
    xs = acc[1]
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return (_pf_map_add(k, v, m), xs)
    elif isinstance(op, Push):
        n = op._0
        return (m, _pf_concat(xs, [n]))
    else:
        return acc
def replay(script: list[Op]) -> tuple[dict[str, int], list[int]]:
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
changes: list[Op] = [Push(5), Push(7), Push(-2), _Skip]
state: tuple[dict[str, int], list[int]] = replay(changes)
mm, items = state
print((_pf_map_to_list(mm), items))
sumSq: int = _pf_fold(lambda step, x: step + x * x, 0, [5, 5, 1, 2])
print(sumSq)
