from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: str
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
_Load: Load = Load()
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    def __repr__(self):
        return "Pop"
_Pop: Pop = Pop()
Action = Store | Turn | Load | Pop
def build(start: int) -> tuple[list[int], list[int], int, int]:
    acc = start
    g0 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 8
    g1 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 1
    def g2(y: int) -> int:
        return acc * y
    acc = acc * 4
    return (g0([1, 2]), g1([1, 2]), g2(3), acc)
print(build(3))
def bump2(n: int) -> int:
    return n + 94
def useHelper(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 6
    tmp = useHelper(bump2)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + useHelper(1)
    else:
        return 0
beta: int = _pf_fn1()
def _pf_fn2():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
third: int = _pf_fn2()
print((first, beta, third, useHelper(0)))
def render(t: Action) -> str:
    if isinstance(t, Store):
        n0 = t._0
        if n0 > 2:
            return f"store!({n0})"
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    elif isinstance(t, Turn):
        s0 = t._0
        return f"turn({s0})"
    elif isinstance(t, Load):
        return f"load"
    else:
        return f"pop"
def cost(t: Action) -> int:
    if isinstance(t, Store):
        x0 = t._0
        return x0
    elif isinstance(t, Pop):
        return 9
    elif isinstance(t, Turn):
        return 9
    else:
        return 2
prog: list[Action] = [Turn("lu"), _Pop, _Pop, Store(11), Store(9), _Load]
print(_pf_str_join(" ", _pf_map(render, prog)))
tally: int = _pf_sum_by(cost, prog)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: cost(t) > 2, prog)))
