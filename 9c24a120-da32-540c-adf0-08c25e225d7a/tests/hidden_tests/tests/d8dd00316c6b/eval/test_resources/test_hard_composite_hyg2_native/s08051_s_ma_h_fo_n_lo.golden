    for (name, k) in [("a", 7), ("b", 1)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(5), list(callbacks2)))
steps = _pf_fold(lambda acc, k: _pf_concat(acc, [lambda y: y * k]), [], [8, 6, 7])
print(_pf_map(lambda h: h(5), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
