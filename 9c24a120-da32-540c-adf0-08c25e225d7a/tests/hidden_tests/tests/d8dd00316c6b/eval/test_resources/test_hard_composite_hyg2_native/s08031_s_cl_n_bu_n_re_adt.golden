from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_concat(a, b):
    return a + b
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __eq__(self, other):
        return type(other) is Skip and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
    def __eq__(self, other):
        return type(other) is Emit and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Emit: Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
    def __eq__(self, other):
        return type(other) is Push and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
Move = Skip | Emit | Push
def scanSum(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([1, -7, 0, -7, -4, 8, 0]))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 1
        return n
    return next_
tick = ticker(7)
print((tick(None), tick(None), tick(None)))
str_: str = "dee"
print((str(15), str_, _pf_str_concat(str_, str(1))))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
len_: int = 6
print((len([1, 2, 3]) + len_, len("abc")))
def build(start: int) -> tuple[int, int, list[int], int, int]:
    base = start
    def g0(y: int) -> int:
        return base * y
    base = g0(base)
    g1 = lambda y: base + y
    base = base + 17
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 9
    def g3(y: int) -> int:
        return base * y
    base = base + 7
    return (g0(4), g1(2), g2([1, 2]), g3(5), base)
print(build(7))
def explain(t: Move) -> str:
    if isinstance(t, Skip):
        n0 = t._0
        return f"skip({n0})"
    elif isinstance(t, Emit):
        return f"emit"
    else:
        n0 = t._0
        return f"push({n0})"
def score(t: Move) -> int:
    if isinstance(t, Emit):
        return 4
    elif isinstance(t, Push):
        x0 = t._0
        return x0
    else:
        return 1
stream: list[Move] = [_Emit, Skip(8), Push(10), Push(-3), Push(5)]
print(_pf_map(explain, stream))
tally: int = _pf_sum_by(score, stream)
print(f"tally={tally}")
print(_pf_sort(stream))
