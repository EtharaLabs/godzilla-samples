import functools
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def build(start: int) -> tuple[list[int], list[int], int]:
    level = start
    g0 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 4
    g1 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 3
    return (g0([1, 2]), g1([1, 2]), level)
print(build(1))
def lift(n: int) -> int:
    return n + 52
def callHelper(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 0
    tmp = callHelper(lift)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [4]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + callHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, second, gamma, callHelper(0)))
def margin(price: int, qty: int) -> int:
    return price * qty - 9 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn3(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall: int = sum(_pf_map(_pf_fn3, [("bolt", 23, 4), ("cog", 17, 1), ("pin", 22, 2)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(14)([1, 2, 3]))
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 1
        return n
    return next_
tick = makeCounter(8)
print((tick(None), tick(None), tick(None)))
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([20, 8, 9, 16, 6]))
