from dataclasses import dataclass
from typing import Any
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Tree"
    _1: int
    _2: "Tree"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Tree = Leaf | Node
len_: int = 2
print((len([1, 2, 3]) + len_, len("abc")))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([9, 8, 1, 2]), _pf_sort([3, 1, 2])))
def add(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(add(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, add(x, rt))
        return t
root: Tree = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [15, 42, 27, 10, 26])
def sumOf(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumOf(l) + v + sumOf(rt)
print(sumOf(root))
def containsOf(x: int, t: Tree) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
print(_pf_map(lambda k: containsOf(k, root), [15, 27, 44]))
def layer(start: int) -> tuple[int, int, int, int]:
    acc = start
    def g0(y: int) -> int:
        return acc * y
    acc = acc + 7
    g1 = lambda y: acc + y
    acc = acc * 3
    def g2(y: int) -> int:
        return acc * y
    acc = acc * 3
    return (g0(4), g1(5), g2(4), acc)
print(layer(1))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 8
    return _pf_map(lambda g: g(n), fs)
print(shifted(3, [6, 7, 7]))
def _pf_fn0():
    for (name, k) in [("a", 6), ("b", 7)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(2), list(handlers)))
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts: list[int] = [21, 7, -1, -13]
print(_pf_filter(functools.partial(Text_between, 1, 17), pts))
print(Text_norm1(pts))
print(Text_scaleAll(3, pts))
print(Text_mean(pts))
