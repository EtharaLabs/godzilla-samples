from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
_Load: Load = Load()
Msg = Drop | Skip | Load
def render(t: Msg) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Skip):
        s0 = t._0
        return f"skip({s0})"
    else:
        return f"load"
def weight(t: Msg) -> int:
    if isinstance(t, Drop):
        x0 = t._0
        return x0 * 5
    else:
        return 1
queue: list[Msg] = [_Load, _Load, _Load, Drop(-1), _Load]
print(_pf_map(render, queue))
tally: int = _pf_sum_by(weight, queue)
print(f"tally={tally}")
print(_pf_max_by(weight, queue))
def build(start: int) -> tuple[list[int], int, list[int], list[int], int]:
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    def g1(y: int) -> int:
        return x * y
    x = x + 8
    g2 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 1
    g3 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    return (g0([1, 2]), g1(3), g2([1, 2]), g3([1, 2]), x)
print(build(2))
