import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def nudge(n: int) -> int:
    return n + 33
def useHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 9
    tmp = useHelper(nudge)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [4]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, second, gamma, useHelper(0)))
dict_: dict[str, int] = dict([("k", 8)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
list_: list[int] = [2, 0, 3]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(10, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
segments: list[float] = [397.0, 385.1, 279.7]
times: list[float] = [79.8, 58.1, 68.0]
dist: float = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
speed: float = dist / dur
print(_pf_fmt_fixed(1, speed))
mass: float = 86.0
accel: float = 1.5
push: float = mass * accel
limit: float = 235.0
print("over" if push > limit else "under")
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
edge: float = math.sqrt(4.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def stack2(start: int) -> tuple[int, int, int]:
    base = start
    g0 = lambda y: base + y
    base = base * 5
    def g1(y: int) -> int:
        return base * y
    base = base * 3
    return (g0(3), g1(5), base)
print(stack2(9))
