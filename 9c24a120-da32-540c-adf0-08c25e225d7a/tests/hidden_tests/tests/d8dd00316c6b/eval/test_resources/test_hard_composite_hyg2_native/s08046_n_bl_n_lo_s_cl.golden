import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def lift(n: int) -> int:
    return n + 58
def callHelper(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 5
    tmp = callHelper(lift)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [8]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + callHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
gamma: int = _pf_fn2()
print((first, second, gamma, callHelper(0)))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(shifted(3, [9, 7, 4]))
acc = []
for k in [5, 9, 1]:
    _pf_t1 = lambda y: y * k
    acc.append(_pf_t1)
chain = acc
print(_pf_map(lambda h: h(4), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def stamp(xs) -> tuple[list[str], int]:
    i = 0
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["pam", "max", "gus"]))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([17, 7, 10, 7, 13]))
