def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
calls: int = 0
def track(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 4
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([46, 12, -20, 37]))
doubled: list[int] = _pf_map(track, [46, 12, -20, 37])
print(f"{doubled} after {calls} calls")
def lift(n: int) -> int:
    return n + 75
def callHelper(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 6
    tmp = callHelper(lift)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [5]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + callHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third: int = _pf_fn2()
print((first, second, third, callHelper(0)))
def set_(n: int) -> int:
    return n * 4
print((set_(3), len(set([2, 5, 3, 2]))))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
list_: list[int] = [7, 4, 4]
print((list(map(lambda x: x + 1, iter(list_))), list_))
