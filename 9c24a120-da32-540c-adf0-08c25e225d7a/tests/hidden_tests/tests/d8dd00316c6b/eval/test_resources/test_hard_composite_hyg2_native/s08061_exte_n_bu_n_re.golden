import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [8, 6, 2, 11]))
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("10111") + int("53", base=8))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(5, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([5, 6, 3, 8]), _pf_sort([3, 1, 2])))
def stack2(start: int) -> tuple[int, int, int, int]:
    x = start
    g0 = lambda y: x + y
    x = x * 2
    def g1(y: int) -> int:
        return x * y
    x = x + 6
    g2 = lambda y: x + y
    x = x * 3
    return (g0(2), g1(3), g2(5), x)
print(stack2(2))
