    return n + 48
def useHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 4
    tmp = useHelper(nudge)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [7]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
