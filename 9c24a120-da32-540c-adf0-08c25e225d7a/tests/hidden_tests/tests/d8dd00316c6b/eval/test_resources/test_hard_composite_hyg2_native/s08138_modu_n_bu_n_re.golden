import functools
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums: list[int] = [16, -5, 4, -13, 11, 2]
print(_pf_map(functools.partial(Calc_clamp, 0, 6), nums))
print(Calc_scaleAll(5, nums))
print(Calc_mean(nums))
dict_: dict[str, int] = dict([("k", 5)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(15, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
def stack2(start: int) -> tuple[list[int], int, int]:
    level = start
    g0 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 6
    def g1(y: int) -> int:
        return level * y
    level = g1(level)
    return (g0([1, 2]), g1(5), level)
print(stack2(7))
