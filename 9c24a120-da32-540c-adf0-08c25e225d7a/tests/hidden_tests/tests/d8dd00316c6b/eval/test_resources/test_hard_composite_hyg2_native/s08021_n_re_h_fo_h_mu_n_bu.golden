from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Push | Noop
def build(start: int) -> tuple[list[int], list[int], int]:
    acc = start
    g0 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 1
    g1 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 3
    return (g0([1, 2]), g1([1, 2]), acc)
print(build(4))
def fold1(m: dict[str, int], op: Op) -> dict[str, int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
    elif isinstance(op, Push):
        n = op._0
        return _pf_map_add("pushed", n, m)
    else:
        return m
def execute(script: list[Op]) -> dict[str, int]:
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
script: list[Op] = [_Noop, Put("nut", 5), Push(8), Put("cog", 8), _Noop, Push(2)]
final: dict[str, int] = execute(script)
print(_pf_map_to_list(final))
acc: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [9, 2, 9, 6])
print(acc)
def inspect(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(inspect([26, 13, 19]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "dee", "stop"])
print((events, counts))
list_: list[int] = [3, 5, 7]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(17, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
def set_(n: int) -> int:
    return n * 5
print((set_(3), len(set([0, 3, 1, 0]))))
