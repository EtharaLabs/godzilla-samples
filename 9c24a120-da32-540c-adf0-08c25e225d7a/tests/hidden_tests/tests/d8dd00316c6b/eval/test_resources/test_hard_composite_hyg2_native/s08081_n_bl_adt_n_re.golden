def stack2(start: int) -> tuple[int, int, int, int]:
    level = start
    def g0(y: int) -> int:
        return level * y
    level = g0(level)
    def g1(y: int) -> int:
        return level * y
    level = g1(level)
    def g2(y: int) -> int:
        return level * y
    level = level + 18
    return (g0(4), g1(1), g2(5), level)
