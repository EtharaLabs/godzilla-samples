def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 3
    return _pf_map(lambda g: g(n), fs)
print(offsets(6, [9, 7, 6]))
def _pf_fn0():
    for (name, k) in [("a", 1), ("b", 7)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(4), list(handlers)))
def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(6, 12, 1))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [9, 25, 5, 9, 9]))
def collatz(n: int, acc: int) -> int:
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [58, 32, 17]))
def bump2(n: int) -> int:
    return n + 17
def useHelper(x: int) -> int:
    return bump2(x)
def _pf_fn1():
    bump2 = 2
    tmp = useHelper(bump2)
    return tmp * 2
first: int = _pf_fn1()
def _pf_fn2():
    _pf_t0 = [7]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + useHelper(1)
    else:
        return 0
second: int = _pf_fn2()
def _pf_fn3():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third: int = _pf_fn3()
print((first, second, third, useHelper(0)))
