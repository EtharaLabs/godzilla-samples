import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def build(start: int) -> tuple[list[int], int, list[int], int]:
    level = start
    g0 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 9
    def g1(y: int) -> int:
        return level * y
    level = g1(level)
    g2 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 4
    return (g0([1, 2]), g1(3), g2([1, 2]), level)
print(build(7))
def _pf_fn0():
    for (name, k) in [("a", 6), ("b", 8)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(2), list(handlers)))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 3
    return _pf_map(lambda g: g(n), fs)
print(offsets(5, [8, 3, 5]))
acc = []
for k in [1, 8, 2]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(3), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def bump2(n: int) -> int:
    return n + 84
def callHelper(x: int) -> int:
    return bump2(x)
def _pf_fn1():
    bump2 = 8
    tmp = callHelper(bump2)
    return tmp * 2
first: int = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [4]
    if _pf_t1:
        bump2 = _pf_t1[0]
        return bump2 + callHelper(1)
    else:
        return 0
beta: int = _pf_fn2()
def _pf_fn3():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
gamma: int = _pf_fn3()
print((first, beta, gamma, callHelper(0)))
def net(price: int, qty: int) -> int:
    return price * qty - 4 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn4(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand: int = sum(_pf_map(_pf_fn4, [("hub", 47, 6), ("wick", 18, 6), ("gear", 21, 2)]))
print(grand)
