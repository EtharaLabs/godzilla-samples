def combine(xs: list[Ok | Error]) -> Ok | Error:
    def _pf_fn2(acc, r):
        def _pf_fn3():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
