def readPair(line: str) -> Ok | Error:
    def _pf_fn0():
        _pf_t1 = _pf_str_split("=", line)
        if len(_pf_t1) == 2:
            _k = _pf_t1[0]
            _v = _pf_t1[1]
            _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
        else:
