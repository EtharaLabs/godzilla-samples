        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t3 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t3, Ok):
                n = _pf_t3._0
                _pf_t2 = Error("negative") if n < 0 else Ok(n)
                if isinstance(_pf_t2, Ok):
                    checked = _pf_t2._0
