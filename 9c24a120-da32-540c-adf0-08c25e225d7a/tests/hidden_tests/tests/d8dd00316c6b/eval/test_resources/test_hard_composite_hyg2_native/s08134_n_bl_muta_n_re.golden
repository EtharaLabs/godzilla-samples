import functools
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def bump2(n: int) -> int:
    return n + 70
def callHelper(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 4
    tmp = callHelper(bump2)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + callHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, second, gamma, callHelper(0)))
calls: int = 0
def record(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 4
def profile(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([19, 18, 43, -4, 15, -5, -16, 42]))
doubled: list[int] = _pf_map(record, [19, 18, 43, -4])
print(f"{doubled} after {calls} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), calls))
def build(start: int) -> tuple[list[int], int, int]:
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 9
    def g1(y: int) -> int:
        return x * y
    x = x + 10
    return (g0([1, 2]), g1(4), x)
print(build(5))
