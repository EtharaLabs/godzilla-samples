from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([16, 17, 16, 9, 20]))
journal: list[str] = []
def traced(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [3, 4]))
print((out, journal))
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 4
        return n
    return next_
tick = makeCounter(9)
print((tick(None), tick(None), tick(None)))
def nudge(n: int) -> int:
    return n + 97
def useHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 1
    tmp = useHelper(nudge)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [7]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, second, gamma, useHelper(0)))
legs: list[float] = [101.7, 262.6, 134.5, 465.8]
splits: list[float] = [36.2, 16.3, 71.8, 6.7]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed: float = dist / dur
print(_pf_fmt_fixed(3, speed))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
def _pf_fn3(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn3, _pf_zip(legs, splits))
print(best)
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
