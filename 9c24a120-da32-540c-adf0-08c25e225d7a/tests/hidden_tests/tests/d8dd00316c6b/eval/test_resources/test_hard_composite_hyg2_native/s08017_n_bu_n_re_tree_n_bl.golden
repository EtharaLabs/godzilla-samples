def build(start: int) -> tuple[int, int, int, list[int], int]:
    base = start
    g0 = lambda y: base + y
    base = base + 10
    g1 = lambda y: base + y
    base = g1(base)
    g2 = lambda y: base + y
    base = base + 18
    g3 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 7
    return (g0(5), g1(5), g2(2), g3([1, 2]), base)
print(build(2))
def insert(x: int, t: Bst) -> Bst:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
tree: Bst = _pf_fold(lambda acc, x: insert(x, acc), _Leaf, [21, 51, 9, 18, 32, 15])
def containsOf(x: int, t: Bst) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
