from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Op = Put | Append | Skip
acc = []
for k in [5, 9, 9]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(3), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 5
    return _pf_map(lambda g: g(n), fs)
print(shifted(4, [5, 7, 4]))
def runAll(script: list[Op]) -> tuple[int, int]:
    def step(acc: tuple[int, int], op: Op) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Append):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(step, (0, 0), script)
changes: list[Op] = [Put("gear", 3), _Skip, Append(9), Append(5), Append(5), Append(0)]
final: tuple[int, int] = runAll(changes)
print(final)
sumSq: int = _pf_fold(lambda step, x: step + x * x, 0, [6, 2, 8, 7])
print(sumSq)
def stamp(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["oz", "tom", "quin"]))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 5
        return n
    return next_
tick = ticker(6)
print((tick(None), tick(None), tick(None)))
def build(start: int) -> tuple[int, list[int], list[int], int]:
    base = start
    def g0(y: int) -> int:
        return base * y
    base = base * 2
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 2
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 9
    return (g0(2), g1([1, 2]), g2([1, 2]), base)
print(build(7))
