import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def margin(price: int, qty: int) -> int:
    return price * qty - 8 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("cap", 32, 4), ("hub", 8, 1), ("gear", 46, 2), ("wick", 43, 4)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(17)([1, 2, 3]))
def stack2(start: int) -> tuple[list[int], int, list[int], int]:
    level = start
    g0 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 8
    g1 = lambda y: level + y
    level = level * 3
    g2 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 5
    return (g0([1, 2]), g1(1), g2([1, 2]), level)
print(stack2(3))
acc = []
for k in [3, 2, 5]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(1), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def _pf_fn1():
    for (name, k) in [("a", 6), ("b", 8)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn1()
print(_pf_map(lambda h: h(1), list(handlers)))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [4, 8, 11, 12]))
def row(n: int) -> list[int]:
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
