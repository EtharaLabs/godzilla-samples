import functools
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
dict_: dict[str, int] = dict([("k", 6)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
def set_(n: int) -> int:
    return n * 3
print((set_(3), len(set([3, 3, 1, 2]))))
list_: list[int] = [1, 2, 9]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def discount(price: int, qty: int) -> int:
    return price * qty - 3 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("gear", 37, 6), ("gear", 17, 6), ("cog", 37, 4), ("pin", 30, 1)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(7)([1, 2, 3]))
def stack2(start: int) -> tuple[int, int, int]:
    acc = start
    g0 = lambda y: acc + y
    acc = g0(acc)
    def g1(y: int) -> int:
        return acc * y
    acc = acc + 2
    return (g0(1), g1(5), acc)
print(stack2(6))
