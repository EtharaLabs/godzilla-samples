from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_concat(a, b):
    return a + b
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Tree"
    _1: int
    _2: "Tree"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Tree = Leaf | Node
dict_: dict[str, int] = dict([("k", 2)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(13, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
str_: str = "dee"
print((str(15), str_, _pf_str_concat(str_, str(1))))
def set_(n: int) -> int:
    return n * 4
print((set_(3), len(set([0, 1, 3, 4]))))
def insert(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
tree: Tree = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [16, 6, 59, 10, 8, 32])
def toListOf(t: Tree) -> list[int]:
    if isinstance(t, Leaf):
        return []
    else:
        l = t._0
        v = t._1
        rt = t._2
        return _pf_concat(toListOf(l), _pf_concat([v], toListOf(rt)))
print(toListOf(tree))
def minT(t: Tree) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minT(tree))
def depthOf(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        rt = t._2
        return 1 + max(depthOf(l), depthOf(rt))
print(depthOf(tree))
def sumT(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumT(l) + v + sumT(rt)
print(sumT(tree))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums: list[int] = [-10, 25, 3, -9, 22]
print(Geo_mean(nums))
print(_pf_map(functools.partial(Geo_clamp, 0, 9), nums))
print(Geo_scaleAll(4, nums))
