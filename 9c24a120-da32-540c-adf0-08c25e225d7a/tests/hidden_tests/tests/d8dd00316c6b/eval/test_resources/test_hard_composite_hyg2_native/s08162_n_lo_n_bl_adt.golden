from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    _1: str
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
Token = Mark | Halt | Push
acc = []
for k in [4, 3, 7]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(1), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def _pf_fn0():
    for (name, k) in [("a", 4), ("b", 2)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(5), list(handlers)))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 4
    return _pf_map(lambda g: g(n), fs)
print(shifted(9, [1, 5, 5]))
def nudge(n: int) -> int:
    return n + 72
def callHelper(x: int) -> int:
    return nudge(x)
def _pf_fn1():
    nudge = 5
    tmp = callHelper(nudge)
    return tmp * 2
first: int = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [1]
    if _pf_t1:
        nudge = _pf_t1[0]
        return nudge + callHelper(1)
    else:
        return 0
second: int = _pf_fn2()
def _pf_fn3():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third: int = _pf_fn3()
print((first, second, third, callHelper(0)))
def describe(t: Token) -> str:
    if isinstance(t, Mark):
        s0 = t._0
        return f"mark({s0})"
    elif isinstance(t, Halt):
        s0 = t._0
        return f"halt({s0})"
    elif isinstance(t, Push) and t._0 == 3:
        return "push-3"
    else:
        n0 = t._0
        s1 = t._1
        return f"push({n0},{s1})"
def rank(t: Token) -> int:
    if isinstance(t, Mark):
        return 9
    else:
        return 3
queue: list[Token] = [Halt("quin"), Halt("ivy"), Halt("ada"), Mark("gus"), Push(10, "sue"), Mark("jo"), Push(4, "kit")]
_pf_iter(lambda t: print(describe(t)), queue)
grandSum: int = _pf_sum_by(rank, queue)
print(f"grandSum={grandSum}")
print((_pf_head(queue), _pf_last(queue)))
