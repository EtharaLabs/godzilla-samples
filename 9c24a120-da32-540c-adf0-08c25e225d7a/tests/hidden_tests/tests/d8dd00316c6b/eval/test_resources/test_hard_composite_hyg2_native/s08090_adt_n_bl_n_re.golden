from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
_Push: Push = Push()
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    _1: int
    def __repr__(self):
        return f"Halt({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    _1: int
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
Action = Drop | Push | Halt | Mark
def show(t: Action) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Push):
        return f"push"
    elif isinstance(t, Halt):
        n0 = t._0
        n1 = t._1
        return f"halt({n0},{n1})"
    elif isinstance(t, Mark) and t._0 == 1:
        return "mark-1"
    else:
        n0 = t._0
        n1 = t._1
        return f"mark({n0},{n1})"
def rank(t: Action) -> int:
    if isinstance(t, Mark):
        x0 = t._0
        x1 = t._1
        return x0 + x1 * 3
    elif isinstance(t, Halt):
        x0 = t._0
        x1 = t._1
        return x0 + x1
    else:
        return 0
stream: list[Action] = [Mark(-1, -3), Drop(5), Halt(7, 1), Halt(8, -2), _Push, Drop(0)]
print(_pf_map(show, stream))
grandSum: int = _pf_sum_by(rank, stream)
print(f"grandSum={grandSum}")
print((_pf_head(stream), _pf_last(stream)))
def bump2(n: int) -> int:
    return n + 56
def useHelper(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 3
    tmp = useHelper(bump2)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, second, gamma, useHelper(0)))
def build(start: int) -> tuple[int, list[int], int, int]:
    acc = start
    def g0(y: int) -> int:
        return acc * y
    acc = acc + 6
    g1 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 8
    g2 = lambda y: acc + y
    acc = acc * 2
    return (g0(3), g1([1, 2]), g2(4), acc)
print(build(8))
