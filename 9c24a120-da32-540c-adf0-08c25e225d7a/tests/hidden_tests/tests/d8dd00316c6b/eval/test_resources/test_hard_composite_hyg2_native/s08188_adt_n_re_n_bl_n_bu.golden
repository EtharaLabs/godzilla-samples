def layer(start: int) -> tuple[int, int, int, int, int]:
    x = start
    def g0(y: int) -> int:
        return x * y
    x = x + 8
    g1 = lambda y: x + y
    x = g1(x)
    g2 = lambda y: x + y
    x = x + 5
    g3 = lambda y: x + y
    x = x * 5
    return (g0(5), g1(3), g2(1), g3(3), x)
