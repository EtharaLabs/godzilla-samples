import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(offsets(2, [3, 3, 9]))
def _pf_fn0():
    for (name, k) in [("a", 3), ("b", 8)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(2), list(callbacks2)))
acc = []
for k in [4, 2, 5]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(3), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def nudge(n: int) -> int:
    return n + 50
def useHelper(x: int) -> int:
    return nudge(x)
def _pf_fn1():
    nudge = 6
    tmp = useHelper(nudge)
    return tmp * 2
first: int = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [4]
    if _pf_t1:
        nudge = _pf_t1[0]
        return nudge + useHelper(1)
    else:
        return 0
beta: int = _pf_fn2()
def _pf_fn3():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
gamma: int = _pf_fn3()
print((first, beta, gamma, useHelper(0)))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-1, -8, -8, -9]))
def numbered(xs) -> tuple[list[str], int]:
    i = 3
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["cy", "ned", "hal"]))
