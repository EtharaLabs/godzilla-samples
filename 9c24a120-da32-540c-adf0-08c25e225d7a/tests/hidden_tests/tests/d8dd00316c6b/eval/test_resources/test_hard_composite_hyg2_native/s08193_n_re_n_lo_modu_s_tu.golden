def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_square(x):
    return x * x
nums: list[int] = [-10, -4, -10, 17, 23, -6, 28]
print(_pf_map(functools.partial(Calc_clamp, 0, 5), nums))
print(Calc_mean(nums))
print(_pf_map(Calc_square, nums))
tallies: list[tuple[str, int]] = [("cog", 6), ("pin", 5), ("tap", 8), ("gear", 13), ("rod", 11)]
