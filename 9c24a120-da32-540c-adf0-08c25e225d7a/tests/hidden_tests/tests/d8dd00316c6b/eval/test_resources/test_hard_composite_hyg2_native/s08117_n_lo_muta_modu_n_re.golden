import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
acc = []
for k in [2, 4, 5]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(4), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def _pf_fn0():
    for (name, k) in [("a", 2), ("b", 2)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(4), list(callbacks2)))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 8
    return _pf_map(lambda g: g(n), fs)
print(shifted(7, [0, 4, 8]))
calls: int = 0
def note(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 3
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([40, -7, -12, 5]))
doubled: list[int] = _pf_map(note, [40, -7, -12, 5])
print(f"{doubled} after {calls} calls")
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums: list[int] = [-5, 9, 9, 30, 16, 11, -4]
print(_pf_filter(functools.partial(Text_between, -4, 17), nums))
print(Text_scaleAll(5, nums))
print(_pf_map(functools.partial(Text_clamp, 0, 20), nums))
print(Text_mean(nums))
def stack2(start: int) -> tuple[int, list[int], int, int]:
    base = start
    g0 = lambda y: base + y
    base = base * 4
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 8
    def g2(y: int) -> int:
        return base * y
    base = base + 5
    return (g0(2), g1([1, 2]), g2(3), base)
print(stack2(2))
