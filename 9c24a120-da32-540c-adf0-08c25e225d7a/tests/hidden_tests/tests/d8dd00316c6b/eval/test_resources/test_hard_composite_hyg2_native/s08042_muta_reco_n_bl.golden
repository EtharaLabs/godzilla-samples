from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
hits: int = 0
def record(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 4
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([2, 6, 7, 53, 52, -11]))
doubled: list[int] = _pf_map(record, [2, 6, 7, 53])
print(f"{doubled} after {hits} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), hits))
book: list[Order] = [Order(100, "sue", 24, True), Order(101, "tom", 35, False), Order(102, "sue", 34, True), Order(103, "sue", 135, True), Order(104, "sue", 139, False), Order(105, "ray", 228, True)]
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn0, (0, 0), book)
print(f"{cnt} records, {sumAmt} total")
def surcharge(pct: int, o: Order) -> Order:
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Order(_pf_t0.id, _pf_t0.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 12), book)))
cheap, dear = _pf_partition(lambda o: o.amount < 114, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def bump2(n: int) -> int:
    return n + 54
def useHelper(x: int) -> int:
    return bump2(x)
def _pf_fn1():
    bump2 = 7
    tmp = useHelper(bump2)
    return tmp * 2
alpha: int = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [7]
    if _pf_t1:
        bump2 = _pf_t1[0]
        return bump2 + useHelper(1)
    else:
        return 0
beta: int = _pf_fn2()
def _pf_fn3():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn3()
print((alpha, beta, gamma, useHelper(0)))
