    return n + 78
def useHelper(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 8
    tmp = useHelper(lift)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t1 = [3]
    if _pf_t1:
        lift = _pf_t1[0]
        return lift + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, second, gamma, useHelper(0)))
