def build(start: int) -> tuple[list[int], int, int, int, int]:
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 4
    def g1(y: int) -> int:
        return x * y
    x = g1(x)
    def g2(y: int) -> int:
        return x * y
    x = x * 2
    g3 = lambda y: x + y
    x = x + 4
    return (g0([1, 2]), g1(4), g2(1), g3(3), x)
