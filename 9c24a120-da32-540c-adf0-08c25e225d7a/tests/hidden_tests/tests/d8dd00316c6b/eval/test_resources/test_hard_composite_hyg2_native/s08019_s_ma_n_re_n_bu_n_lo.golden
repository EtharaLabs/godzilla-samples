from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([8, 9]), dig([2, 9]), dig([])))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((1, 3)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 9)))
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 5
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(6, []), weigh(1, [3]), weigh(1, [8, 2, 3])))
limit2: int = 42
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(6)), clip(Some(-3)), clip(_None_), limit2))
def stack2(start: int) -> tuple[int, list[int], list[int], int, int]:
    base = start
    g0 = lambda y: base + y
    base = base + 8
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 3
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 5
    g3 = lambda y: base + y
    base = g3(base)
    return (g0(1), g1([1, 2]), g2([1, 2]), g3(5), base)
print(stack2(4))
len_: int = 6
print((len([1, 2, 3]) + len_, len("abc")))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(17, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
list_: list[int] = [6, 1, 4]
print((list(map(lambda x: x + 1, iter(list_))), list_))
acc = []
for k in [2, 4, 6]:
    _pf_t1 = lambda y: y * k
    acc.append(_pf_t1)
steps = acc
print(_pf_map(lambda h: h(3), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(shifted(4, [9, 2, 2]))
