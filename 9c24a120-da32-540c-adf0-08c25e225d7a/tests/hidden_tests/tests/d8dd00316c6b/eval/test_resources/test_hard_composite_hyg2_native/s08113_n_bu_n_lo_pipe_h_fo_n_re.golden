from dataclasses import dataclass
import functools
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_concat(a, b):
    return a + b
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Push | Noop
dict_: dict[str, int] = dict([("k", 5)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
str_: str = "ada"
print((str(45), str_, _pf_str_concat(str_, str(1))))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
len_: int = 3
print((len([1, 2, 3]) + len_, len("abc")))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 8
    return _pf_map(lambda g: g(n), fs)
print(offsets(2, [8, 9, 4]))
def _pf_fn0():
    for (name, k) in [("a", 7), ("b", 4)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(3), list(callbacks2)))
readings: list[int] = [-10, 41, 27, 50, 20, -10, 45, 45]
def shift(k: int, x: int) -> int:
    return x + k
def _pf_fn2(_pf_x):
    def _pf_fn3(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn3, _pf_indexed(_pf_x))
outcome: int = _pf_fold(lambda acc, x: acc * 2 - x, 0, _pf_rev(_pf_fn2(_pf_map(functools.partial(shift, 9), (lambda _pf_x: _pf_map(sum, _pf_chunk(3, _pf_x)))(_pf_sort(readings))))))
print(outcome)
print(len(readings))
def replay(script: list[Op]) -> dict[str, int]:
    def apply(m: dict[str, int], op: Op) -> dict[str, int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        elif isinstance(op, Push):
            n = op._0
            return _pf_map_add("pushed", n, m)
        else:
            return m
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
ops: list[Op] = [_Noop, Push(6), Put("bolt", 6), Put("cog", 9), Put("cog", 8)]
outcome2: dict[str, int] = replay(ops)
print(_pf_map_to_list(outcome2))
def build(start: int) -> tuple[int, list[int], int]:
    level = start
    def g0(y: int) -> int:
        return level * y
    level = level + 10
    g1 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 4
    return (g0(5), g1([1, 2]), level)
print(build(9))
