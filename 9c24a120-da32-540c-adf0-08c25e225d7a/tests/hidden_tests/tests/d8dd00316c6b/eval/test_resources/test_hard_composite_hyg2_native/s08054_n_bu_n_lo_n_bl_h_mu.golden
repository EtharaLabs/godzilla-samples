import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
len_: int = 6
print((len([1, 2, 3]) + len_, len("abc")))
acc = []
for k in [2, 2, 1]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(1), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 2
    return _pf_map(lambda g: g(n), fs)
print(offsets(8, [1, 2, 4]))
def _pf_fn0():
    for (name, k) in [("a", 9), ("b", 4)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(5), list(handlers)))
def lift(n: int) -> int:
    return n + 16
def useHelper(x: int) -> int:
    return lift(x)
def _pf_fn1():
    lift = 4
    tmp = useHelper(lift)
    return tmp * 2
alpha: int = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [3]
    if _pf_t1:
        lift = _pf_t1[0]
        return lift + useHelper(1)
    else:
        return 0
beta: int = _pf_fn2()
def _pf_fn3():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn3()
print((alpha, beta, gamma, useHelper(0)))
def scan(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(scan([28, 0, 7]))
events: list[str] = []
def logEvent(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(logEvent, ["start", "jo", "stop"])
print((events, counts))
