from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
def _pf_fn0():
    for (name, k) in [("a", 2), ("b", 7)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(2), list(handlers)))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 4
    return _pf_map(lambda g: g(n), fs)
print(shifted(9, [2, 5, 7]))
acc = []
for k in [7, 1, 2]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(3), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
nums: list[int] = [26, 18, 30, 1]
print(_pf_map(functools.partial(Text_clamp, 0, 8), nums))
print(Text_scaleAll(5, nums))
print(Text_norm1(nums))
dict_: dict[str, int] = dict([("k", 6)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(10, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
str_: str = "oz"
print((str(1), str_, _pf_str_concat(str_, str(1))))
parcels: list[Order] = [Order(100, "ned", 141, False), Order(101, "quin", 212, True), Order(102, "ned", 34, False), Order(103, "pam", 19, True)]
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(rushSum)
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn1, (0, 0), parcels)
print(f"{nrec} records, {amt} total")
def tag(o: Order) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, parcels)))
def classify(o: Order) -> str:
    if isinstance(o, Order) and o.urgent is True:
        amount = o.amount
        if amount > 150:
            return "rush-big"
    if isinstance(o, Order) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 150:
            return "big"
        else:
            return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def stack2(start: int) -> tuple[int, int, int]:
    acc = start
    g0 = lambda y: acc + y
    acc = acc + 17
    def g1(y: int) -> int:
        return acc * y
    acc = g1(acc)
    return (g0(2), g1(4), acc)
print(stack2(9))
