        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
beta: int = _pf_fn1()
def _pf_fn2():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, beta, gamma, useHelper(0)))
def insert(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
root: Tree = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [45, 34, 36, 19, 12])
def sumOf(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumOf(l) + v + sumOf(rt)
print(sumOf(root))
def toListT(t: Tree) -> list[int]:
    if isinstance(t, Leaf):
        return []
    else:
        l = t._0
        v = t._1
        rt = t._2
        return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
print(toListT(root))
def minT(t: Tree) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minT(root))
