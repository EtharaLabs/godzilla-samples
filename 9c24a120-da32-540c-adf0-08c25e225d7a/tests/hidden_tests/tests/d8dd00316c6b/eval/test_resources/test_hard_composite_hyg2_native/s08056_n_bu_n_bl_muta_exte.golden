from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
len_: int = 9
print((len([1, 2, 3]) + len_, len("abc")))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(13, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
def nudge(n: int) -> int:
    return n + 71
def useHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 0
    tmp = useHelper(nudge)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [2]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
gamma: int = _pf_fn2()
print((first, second, gamma, useHelper(0)))
hits: int = 0
def track(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 4
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([51, 60, 8, -10, 38, -14, -13, 60]))
doubled: list[int] = _pf_map(track, [51, 60, 8, -10])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
def row(n: int) -> list[int]:
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
def safe(s: str) -> str:
    try:
        _pf_t1 = Ok(int(s))
    except Exception as _pf_t2:
        _pf_t1 = Error(_Exception(type(_pf_t2).__name__, str(_pf_t2)))
    if isinstance(_pf_t1, Ok):
        n = _pf_t1._0
        return f"ok {n}"
    else:
        e = _pf_t1._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x0", "42"]))
