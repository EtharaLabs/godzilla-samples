def inspect(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([29, 20, 24, 40, 26, 31]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "oz", "stop"])
print((logged, counts))
