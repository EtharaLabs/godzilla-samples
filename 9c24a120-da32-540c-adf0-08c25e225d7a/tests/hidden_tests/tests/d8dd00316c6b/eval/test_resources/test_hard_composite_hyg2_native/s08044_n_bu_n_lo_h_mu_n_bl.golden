import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_concat(a, b):
    return a + b
def set_(n: int) -> int:
    return n * 4
print((set_(3), len(set([4, 5, 5, 3]))))
str_: str = "ivy"
print((str(26), str_, _pf_str_concat(str_, str(1))))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 3
    return _pf_map(lambda g: g(n), fs)
print(shifted(5, [0, 5, 3]))
