from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    _1: str
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
Cmd = Mark | Turn | Jump | Push | Emit
str_: str = "oz"
print((str(59), str_, _pf_str_concat(str_, str(1))))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def set_(n: int) -> int:
    return n * 3
print((set_(3), len(set([4, 5, 4, 2]))))
def render(t: Cmd) -> str:
    if isinstance(t, Mark):
        s0 = t._0
        return f"mark({s0})"
    elif isinstance(t, Turn) and t._0 == 3:
        return "turn-3"
    elif isinstance(t, Turn):
        n0 = t._0
        return f"turn({n0})"
    elif isinstance(t, Jump):
        s0 = t._0
        return f"jump({s0})"
    elif isinstance(t, Push):
        s0 = t._0
        return f"push({s0})"
    else:
        n0 = t._0
        s1 = t._1
        return f"emit({n0},{s1})"
def weight(t: Cmd) -> int:
    if isinstance(t, Emit):
        x0 = t._0
        return x0
    elif isinstance(t, Jump):
        return 8
    elif isinstance(t, Push):
        return 3
    else:
        return 2
queue: list[Cmd] = [Turn(-2), Jump("pam"), Turn(6), Push("oz")]
print(_pf_str_join(" ", _pf_map(render, queue)))
total: int = _pf_sum_by(weight, queue)
print(f"total={total}")
print(len(_pf_filter(lambda t: weight(t) > 5, queue)))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 4
    return _pf_map(lambda g: g(n), fs)
print(offsets(7, [2, 8, 7]))
acc = []
for k in [5, 4, 8]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(5), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
