import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def nudge(n: int) -> int:
    return n + 91
def callHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 5
    tmp = callHelper(nudge)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [9]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + callHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
gamma: int = _pf_fn2()
print((first, second, gamma, callHelper(0)))
laps: list[float] = [444.8, 74.0, 426.1]
splits: list[float] = [76.9, 50.9, 10.3]
total: float = _pf_fold(lambda a, b: a + b, 0.0, laps)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate: float = total / elapsed
print(_pf_fmt_fixed(3, rate))
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
mass: float = 42.0
accel: float = 5.5
push: float = mass * accel
limit: float = 298.0
print("over" if push > limit else "under")
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
edge: float = math.sqrt(36.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 4
        return n
    return next_
clock = makeCounter(8)
print((clock(None), clock(None), clock(None)))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([19, 12, 16, 16, 0, 6]))
