from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Change = Put | Push | Noop
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(8, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
len_: int = 7
print((len([1, 2, 3]) + len_, len("abc")))
dict_: dict[str, int] = dict([("k", 3)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def replay(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    def apply(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Push):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script: list[Change] = [_Noop, _Noop, Push(6), Put("nut", 5)]
final: tuple[dict[str, int], list[int]] = replay(script)
mm, items = final
print((_pf_map_to_list(mm), items))
sumSq: int = _pf_fold(lambda apply, x: apply + x * x, 0, [8, 6, 2, 2])
print(sumSq)
def stack2(start: int) -> tuple[list[int], list[int], int]:
    acc = start
    g0 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 4
    g1 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 2
    return (g0([1, 2]), g1([1, 2]), acc)
print(stack2(2))
