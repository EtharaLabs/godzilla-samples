from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Form = Square | Disc | Wedge
acc = []
for k in [6, 7, 1]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(4), chain))
