from dataclasses import dataclass
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: str
    _1: str
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
_Load: Load = Load()
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    _1: int
    def __repr__(self):
        return f"Skip({self._0!r}, {self._1!r})"
Signal = Emit | Drop | Push | Load | Skip
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(15, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
dict_: dict[str, int] = dict([("k", 5)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
list_: list[int] = [8, 6, 7]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def bump2(n: int) -> int:
    return n + 60
def callHelper(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 4
    tmp = callHelper(bump2)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [8]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + callHelper(1)
    else:
        return 0
beta: int = _pf_fn1()
def _pf_fn2():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
gamma: int = _pf_fn2()
print((first, beta, gamma, callHelper(0)))
def render(t: Signal) -> str:
    if isinstance(t, Emit):
        n0 = t._0
        if n0 > 6:
            return f"emit!({n0})"
    if isinstance(t, Emit):
        n0 = t._0
        return f"emit({n0})"
    elif isinstance(t, Drop):
        s0 = t._0
        s1 = t._1
        return f"drop({s0},{s1})"
    elif isinstance(t, Push):
        n0 = t._0
        return f"push({n0})"
    elif isinstance(t, Load):
        return f"load"
    else:
        n0 = t._0
        n1 = t._1
        return f"skip({n0},{n1})"
def cost(t: Signal) -> int:
    if isinstance(t, Emit):
        x0 = t._0
        return x0
    elif isinstance(t, Push):
        x0 = t._0
        return x0 * 2
    elif isinstance(t, Load):
        return 5
    elif isinstance(t, Drop):
        return 9
    else:
        return 1
prog: list[Signal] = [Emit(10), Push(6), Emit(-3), Push(3), Skip(8, 1)]
print(_pf_map(render, prog))
tally: int = _pf_sum_by(cost, prog)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: cost(t) > 3, prog)))
