def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def lift(n: int) -> int:
    return n + 30
def useHelper(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 8
    tmp = useHelper(lift)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [8]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + useHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third: int = _pf_fn2()
print((first, second, third, useHelper(0)))
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([21, 26, 39, 24, 29]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "dee", "stop"])
print((logged, counts))
def build(start: int) -> tuple[int, int, int, int]:
    level = start
    g0 = lambda y: level + y
    level = level * 5
    g1 = lambda y: level + y
    level = level * 4
    def g2(y: int) -> int:
        return level * y
    level = level + 12
    return (g0(4), g1(2), g2(1), level)
print(build(9))
