from dataclasses import dataclass
from typing import Any
import functools
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Expr"
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
Expr = Num | Add | Mul | Neg | Var
ticks: int = 0
def track(x: int) -> int:
    global ticks
    ticks = ticks + 1
    return x * 3
def profile(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([39, -6, 17, 29]))
doubled: list[int] = _pf_map(track, [39, -6, 17, 29])
print(f"{doubled} after {ticks} calls")
env: dict[str, int] = dict([("x", 7), ("y", 0)])
def evaluate(e: Expr) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evaluate(a) + evaluate(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evaluate(a) * evaluate(b)
    elif isinstance(e, Neg):
        a = e._0
        return -evaluate(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, env)
def show(e: Expr) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({show(a)} + {show(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{show(a)} * {show(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{show(a)}"
    else:
        v = e._0
        return v
exprs: list[Expr] = [Neg(Neg(Neg(Num(-2)))), Mul(Mul(Add(Num(8), Var("y")), Add(Num(8), Num(9))), Add(Num(0), Num(9))), Num(5)]
_pf_iter(print, _pf_map(show, exprs))
print(_pf_map(evaluate, exprs))
len_: int = 6
print((len([1, 2, 3]) + len_, len("abc")))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([3, 7, 4, 6]), _pf_sort([3, 1, 2])))
def layer(start: int) -> tuple[list[int], list[int], int]:
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 2
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 5
    return (g0([1, 2]), g1([1, 2]), x)
print(layer(7))
