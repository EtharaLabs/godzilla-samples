from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_concat(a, b):
    return a + b
def settle(n: int) -> int:
    _pf_t0 = n % 3
    if _pf_t0 == 0:
        _n = n // 3
        return _n + 6
    else:
        k = _pf_t0
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [6, 28, 8, 16]))
def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((3, 5)), 0), pick(Some((1, 5)), 0), pick(_None_, 6)))
cap: int = 13
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((clip(Some(5)), clip(Some(-3)), clip(_None_), cap))
dict_: dict[str, int] = dict([("k", 2)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
str_: str = "bo"
print((str(75), str_, _pf_str_concat(str_, str(1))))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(18, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
def layer(start: int) -> tuple[int, int, list[int], int]:
    base = start
    g0 = lambda y: base + y
    base = base * 5
    g1 = lambda y: base + y
    base = base * 5
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 5
    return (g0(1), g1(5), g2([1, 2]), base)
print(layer(6))
