from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 5
    return _pf_map(lambda g: g(n), fs)
print(shifted(8, [1, 5, 7]))
def _pf_fn0():
    for (name, k) in [("a", 9), ("b", 6)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(1), list(handlers)))
acc = []
for k in [1, 1, 8]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(5), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def sum_(a: int, b: int) -> int:
    return a - b
print((sum_(5, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
list_: list[int] = [8, 3, 1]
print((list(map(lambda x: x + 1, iter(list_))), list_))
dict_: dict[str, int] = dict([("k", 7)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
legs: list[float] = [244.2, 468.0, 155.4, 349.9, 208.4]
durations: list[float] = [73.2, 41.0, 67.2, 74.5, 57.0]
total: float = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate: float = total / dur
print(_pf_fmt_fixed(3, rate))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
side: float = math.sqrt(9.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn1, _pf_zip(legs, durations))
print(best)
