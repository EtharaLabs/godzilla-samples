import functools
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
hits: int = 0
def note(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 3
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([-5, 32, 40, 6, 42, 26]))
doubled: list[int] = _pf_map(note, [-5, 32, 40, 6])
print(f"{doubled} after {hits} calls")
def stack2(start: int) -> tuple[list[int], list[int], list[int], int]:
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    g2 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 1
    return (g0([1, 2]), g1([1, 2]), g2([1, 2]), x)
print(stack2(6))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([6, 0, 7, 3]), _pf_sort([3, 1, 2])))
list_: list[int] = [9, 8, 0]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def nudge(n: int) -> int:
    return n + 23
def useHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 3
    tmp = useHelper(nudge)
    return tmp * 2
alpha: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [3]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
beta: int = _pf_fn1()
def _pf_fn2():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
gamma: int = _pf_fn2()
print((alpha, beta, gamma, useHelper(0)))
