from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
def stack2(start: int) -> tuple[list[int], int, int]:
    acc = start
    g0 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 2
    def g1(y: int) -> int:
        return acc * y
    acc = acc + 18
    return (g0([1, 2]), g1(3), acc)
print(stack2(1))
tickets: list[Parcel] = [Parcel(100, "ned", 229, False), Parcel(101, "oz", 293, False), Parcel(102, "oz", 271, True), Parcel(103, "jo", 177, False), Parcel(104, "jo", 40, False), Parcel(105, "ned", 150, True)]
def priority(o: Parcel) -> str:
    if isinstance(o, Parcel) and o.urgent is True:
        amount = o.amount
        if amount > 166:
            return "rush-big"
    if isinstance(o, Parcel) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 166:
            return "big"
        else:
            return "normal"
print(_pf_map(priority, tickets))
print(_pf_count_by(priority, tickets))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn0, (0, 0), tickets)
print(f"{cnt} records, {sumAmt} total")
def tag(o: Parcel) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, tickets)))
def bump2(n: int) -> int:
    return n + 70
def useHelper(x: int) -> int:
    return bump2(x)
def _pf_fn1():
    bump2 = 6
    tmp = useHelper(bump2)
    return tmp * 2
alpha: int = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [5]
    if _pf_t1:
        bump2 = _pf_t1[0]
        return bump2 + useHelper(1)
    else:
        return 0
second: int = _pf_fn2()
def _pf_fn3():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
third: int = _pf_fn3()
print((alpha, second, third, useHelper(0)))
