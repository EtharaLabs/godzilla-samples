    for (name, k) in [("a", 1), ("b", 4)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(5), list(handlers)))
def layer(start: int) -> tuple[int, list[int], list[int], int, int]:
    base = start
    def g0(y: int) -> int:
        return base * y
    base = base + 17
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 1
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 4
    g3 = lambda y: base + y
    base = g3(base)
    return (g0(2), g1([1, 2]), g2([1, 2]), g3(1), base)
print(layer(2))
vars: dict[str, int] = dict([("x", 8), ("y", 2)])
def evalE(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    elif isinstance(e, Neg):
        a = e._0
        return -evalE(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, vars)
def pretty(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({pretty(a)} + {pretty(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{pretty(a)} * {pretty(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{pretty(a)}"
    else:
        v = e._0
        return v
exprs: list[Ast] = [Var("y"), Neg(Num(-2)), Mul(Num(5), Add(Num(1), Add(Num(7), Num(9))))]
_pf_iter(print, _pf_map(pretty, exprs))
