import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def inspect(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(inspect([19, 10, 7, 33, 8, 2]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "fay", "stop"])
print((logged, counts))
def Calc_square(x):
    return x * x
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
nums: list[int] = [24, 20, 29, 5, -5]
print(_pf_map(Calc_square, nums))
print(Calc_scaleAll(5, nums))
print(_pf_filter(functools.partial(Calc_between, 3, 16), nums))
def set_(n: int) -> int:
    return n * 2
print((set_(3), len(set([1, 4, 2, 0]))))
dict_: dict[str, int] = dict([("k", 6)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
