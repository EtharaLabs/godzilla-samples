    return n + 28
def callHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 8
    tmp = callHelper(nudge)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [4]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + callHelper(1)
    else:
        return 0
second: int = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third: int = _pf_fn2()
print((first, second, third, callHelper(0)))
