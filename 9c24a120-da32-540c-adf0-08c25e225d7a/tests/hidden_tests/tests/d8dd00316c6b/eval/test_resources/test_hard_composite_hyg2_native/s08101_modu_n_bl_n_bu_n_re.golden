import functools
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_rev(s):
    return "".join(reversed(s))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_square(x):
    return x * x
obs: list[int] = [30, 1, -8, 24, 17, 29, 17]
print(Calc_mean(obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 20), obs))
print(Calc_norm1(obs))
print(_pf_map(Calc_square, obs))
def nudge(n: int) -> int:
    return n + 55
def useHelper(x: int) -> int:
    return nudge(x)
def _pf_fn0():
    nudge = 0
    tmp = useHelper(nudge)
    return tmp * 2
first: int = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [8]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
beta: int = _pf_fn1()
def _pf_fn2():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
gamma: int = _pf_fn2()
print((first, beta, gamma, useHelper(0)))
dict_: dict[str, int] = dict([("k", 2)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def layer(start: int) -> tuple[int, list[int], int]:
    x = start
    g0 = lambda y: x + y
    x = g0(x)
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 9
    return (g0(3), g1([1, 2]), x)
print(layer(4))
