from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
legs: list[float] = [366.0, 284.7, 276.1, 139.4, 167.6]
splits: list[float] = [84.3, 85.0, 27.8, 11.3, 60.9]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate: float = total / elapsed
print(_pf_fmt_fixed(2, rate))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(legs, splits))
print(best)
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
def layer(start: int) -> tuple[int, list[int], list[int], int]:
    acc = start
    def g0(y: int) -> int:
        return acc * y
    acc = acc * 4
    g1 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 3
    g2 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 1
    return (g0(2), g1([1, 2]), g2([1, 2]), acc)
print(layer(5))
str_: str = "eli"
print((str(3), str_, _pf_str_concat(str_, str(1))))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([7, 7, 6, 3]), _pf_sort([3, 1, 2])))
dict_: dict[str, int] = dict([("k", 5)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
len_: int = 4
print((len([1, 2, 3]) + len_, len("abc")))
def Stats_square(x):
    return x * x
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums: list[int] = [5, 1, -5, 3]
print(_pf_map(Stats_square, nums))
print(_pf_filter(functools.partial(Stats_between, -4, 11), nums))
print(Stats_norm1(nums))
print(Stats_mean(nums))
