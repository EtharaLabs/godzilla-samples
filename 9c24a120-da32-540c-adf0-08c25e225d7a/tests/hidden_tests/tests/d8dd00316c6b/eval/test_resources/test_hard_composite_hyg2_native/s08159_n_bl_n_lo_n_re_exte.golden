def layer(start: int) -> tuple[int, list[int], int]:
    base = start
    g0 = lambda y: base + y
    base = g0(base)
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 3
    return (g0(1), g1([1, 2]), base)
print(layer(9))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
def safe(s: str) -> str:
    try:
        _pf_t2 = Ok(int(s))
    except Exception as _pf_t3:
        _pf_t2 = Error(_Exception(type(_pf_t3).__name__, str(_pf_t3)))
    if isinstance(_pf_t2, Ok):
        n = _pf_t2._0
        return f"ok {n}"
    else:
        e = _pf_t2._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x3", "12"]))
