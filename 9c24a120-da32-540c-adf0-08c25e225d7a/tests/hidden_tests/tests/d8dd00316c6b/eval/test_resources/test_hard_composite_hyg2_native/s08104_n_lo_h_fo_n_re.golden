from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Change = Put | Append | Skip
def _pf_fn0():
    for (name, k) in [("a", 5), ("b", 5)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(1), list(callbacks2)))
acc = []
for k in [4, 1, 1]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(3), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(offsets(2, [9, 4, 9]))
def runAll(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    def step(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Append):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script: list[Change] = [Append(9), Put("bolt", 9), _Skip, Put("bolt", 6), Append(0), Put("gear", 5), Put("nut", 4)]
state: tuple[dict[str, int], list[int]] = runAll(script)
mm, items = state
print((_pf_map_to_list(mm), items))
sumSq: int = _pf_fold(lambda step, x: step + x * x, 0, [2, 7, 5, 6])
print(sumSq)
def build(start: int) -> tuple[int, list[int], list[int], int]:
    x = start
    def g0(y: int) -> int:
        return x * y
    x = x * 4
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 1
    g2 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 2
    return (g0(4), g1([1, 2]), g2([1, 2]), x)
print(build(8))
