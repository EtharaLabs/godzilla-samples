from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_rev(s):
    return "".join(reversed(s))
reversed_: list[int] = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
len_: int = 6
print((len([1, 2, 3]) + len_, len("abc")))
def build(start: int) -> tuple[int, int, int, int, int]:
    x = start
    def g0(y: int) -> int:
        return x * y
    x = g0(x)
    def g1(y: int) -> int:
        return x * y
    x = g1(x)
    def g2(y: int) -> int:
        return x * y
    x = x * 4
    def g3(y: int) -> int:
        return x * y
    x = g3(x)
    return (g0(5), g1(2), g2(1), g3(2), x)
print(build(2))
data: list[int] = [42, 1, 38, 17, 5, 18, 32, 41, -4, 8]
def keep(n: int) -> bool:
    return n > 15 and n % 3 != 0
stage = lambda _pf_x: _pf_filter(lambda x: x % 5 == 1, (lambda _pf_x: (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))((lambda _pf_x: (lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(_pf_filter(keep, _pf_x)))(_pf_x)))(_pf_x))
result: Some | None_ = _pf_head(stage(data))
print(result)
print(len(data))
