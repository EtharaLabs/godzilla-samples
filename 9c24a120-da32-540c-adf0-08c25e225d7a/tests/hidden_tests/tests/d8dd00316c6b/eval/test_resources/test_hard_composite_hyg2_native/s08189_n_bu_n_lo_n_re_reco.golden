from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
list_: list[int] = [7, 1, 5]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([5, 6, 3, 4]), _pf_sort([3, 1, 2])))
acc = []
for k in [2, 9, 9]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(2), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 5
    return _pf_map(lambda g: g(n), fs)
print(shifted(2, [8, 1, 5]))
def stack2(start: int) -> tuple[int, list[int], int]:
    level = start
    def g0(y: int) -> int:
        return level * y
    level = level * 4
    g1 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 9
    return (g0(5), g1([1, 2]), level)
print(stack2(3))
orders: list[Parcel] = [Parcel(100, "sue", 156, True), Parcel(101, "sue", 18, False), Parcel(102, "bo", 127, True), Parcel(103, "bo", 31, True), Parcel(104, "sue", 83, True)]
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, orders))
print(byOwner)
def bucket(o: Parcel) -> str:
    if isinstance(o, Parcel) and o.urgent is True:
        amount = o.amount
        if amount > 104:
            return "rush-big"
    if isinstance(o, Parcel) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 104:
            return "big"
        else:
            return "normal"
print(_pf_map(bucket, orders))
print(_pf_count_by(bucket, orders))
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, orders))
print(rushSum)
