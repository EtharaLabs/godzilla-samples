import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def build(start: int) -> tuple[int, int, int, int, int]:
    acc = start
    def g0(y: int) -> int:
        return acc * y
    acc = g0(acc)
    def g1(y: int) -> int:
        return acc * y
    acc = acc + 5
    def g2(y: int) -> int:
        return acc * y
    acc = acc + 1
    g3 = lambda y: acc + y
    acc = g3(acc)
    return (g0(4), g1(1), g2(3), g3(3), acc)
print(build(4))
def _pf_fn0():
    for (name, k) in [("a", 6), ("b", 1)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(1), list(handlers)))
def offsets(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 5
    return _pf_map(lambda g: g(n), fs)
print(offsets(6, [4, 4, 6]))
acc = []
for k in [1, 8, 1]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(3), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def audit(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(audit([4, 7, 20]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "gus", "stop"])
print((events, counts))
