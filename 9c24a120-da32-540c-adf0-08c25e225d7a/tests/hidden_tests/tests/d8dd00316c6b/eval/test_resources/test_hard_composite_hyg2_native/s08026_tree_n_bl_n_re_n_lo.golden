Ast = Num | Add | Mul | Neg | Var
vars: dict[str, int] = dict([("x", 4), ("y", 1)])
def evalE(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    elif isinstance(e, Neg):
        a = e._0
        return -evalE(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, vars)
def render(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{render(a)}"
    else:
        v = e._0
        return v
