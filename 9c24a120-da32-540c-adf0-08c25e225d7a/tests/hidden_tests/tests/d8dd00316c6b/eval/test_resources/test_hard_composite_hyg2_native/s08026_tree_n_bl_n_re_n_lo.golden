def stack2(start: int) -> tuple[int, list[int], int]:
    x = start
    g0 = lambda y: x + y
    x = g0(x)
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 2
    return (g0(5), g1([1, 2]), x)
