from dataclasses import dataclass
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
