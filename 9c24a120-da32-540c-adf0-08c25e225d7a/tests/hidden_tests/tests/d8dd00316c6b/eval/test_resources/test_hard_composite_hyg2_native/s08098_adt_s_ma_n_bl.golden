Fig = Sq | Ci | Tri
def explain(t: Signal) -> str:
    if isinstance(t, Turn):
        n0 = t._0
        if n0 > 5:
            return f"turn!({n0})"
    if isinstance(t, Turn):
        n0 = t._0
        return f"turn({n0})"
    elif isinstance(t, Mark):
        return f"mark"
    else:
        n0 = t._0
        return f"pop({n0})"
