import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fn0():
    for (name, k) in [("a", 4), ("b", 7)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(1), list(callbacks2)))
acc = []
for k in [8, 5, 7]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(5), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def shifted(n: int, xs: list[int]) -> list[int]:
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 5
    return _pf_map(lambda g: g(n), fs)
print(shifted(5, [2, 8, 2]))
laps: list[float] = [68.5, 233.9, 66.3]
durations: list[float] = [32.0, 49.6, 84.3]
total: float = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate: float = total / elapsed
print(_pf_fmt_fixed(3, rate))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
list_: list[int] = [8, 8, 6]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def set_(n: int) -> int:
    return n * 5
print((set_(3), len(set([4, 2, 1, 0]))))
def build(start: int) -> tuple[list[int], int, int, int]:
    acc = start
    g0 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 1
    def g1(y: int) -> int:
        return acc * y
    acc = acc + 12
    g2 = lambda y: acc + y
    acc = g2(acc)
    return (g0([1, 2]), g1(1), g2(1), acc)
print(build(1))
