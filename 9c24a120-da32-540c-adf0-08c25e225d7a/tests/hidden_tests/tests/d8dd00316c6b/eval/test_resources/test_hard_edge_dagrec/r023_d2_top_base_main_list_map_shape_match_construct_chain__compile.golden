# ==== base.py ====
from dataclasses import dataclass
from functools import total_ordering
@dataclass(frozen=True, slots=True, order=True)
class Pos:
    x: int
    y: int
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: int
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Box:
    _0: object
    def __repr__(self):
        return f"Box({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
origin = Pos(0, 0)

# ==== place.py ====
from dataclasses import dataclass
import base
@dataclass(frozen=True, slots=True, order=True)
class Placed:
    at: object
    shape: object
def mk(x):
    return Placed(base.Pos(x, 0), base.Circle(x))
def shift(p):
    _pf_t0 = p
    return Placed(base.Pos(p.at.x + 1, p.at.y), _pf_t0.shape)

# ==== main.py ====
import base
import place
def _pf_map(f, xs):
    return list(map(f, xs))
v = place.mk(4)
print(_pf_map(lambda t: t.at.x, [v, v]))
match v.shape:
    case base.Circle(k):
        _pf_t0 = k
    case base.Box(p):
        _pf_t0 = p.x + p.y
    case _:
        raise RuntimeError("non-exhaustive match")
r = _pf_t0
print(r)
c = place.Placed(base.Pos(7, 8), base.Box(base.Pos(1, 1)))
print(c == c)

