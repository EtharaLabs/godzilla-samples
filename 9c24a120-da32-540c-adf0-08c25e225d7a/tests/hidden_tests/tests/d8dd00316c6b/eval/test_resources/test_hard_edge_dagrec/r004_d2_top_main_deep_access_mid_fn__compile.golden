# ==== base.py ====
from dataclasses import dataclass
from functools import total_ordering
@dataclass(frozen=True, slots=True, order=True)
class Pos:
    x: int
    y: int
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: int
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Box:
    _0: object
    def __repr__(self):
        return f"Box({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
origin = Pos(0, 0)

# ==== place.py ====
from dataclasses import dataclass
import base
@dataclass(frozen=True, slots=True, order=True)
class Placed:
    at: object
    shape: object
def mk(x):
    return Placed(base.Pos(x, 0), base.Circle(x))
def shift(p):
    _pf_t0 = p
    return Placed(base.Pos(p.at.x + 1, p.at.y), _pf_t0.shape)

# ==== main.py ====
import place
v = place.mk(4)
print(v.at.x)
print(v.at.y)
print(place.shift(v).at.x)

