from dataclasses import dataclass
import base
@dataclass(frozen=True, slots=True, order=True)
class Placed:
    at: object
    shape: object
def mk(x):
    return Placed(base.Pos(x, 0), base.Circle(x))
def shift(p):
    _pf_t0 = p
    return Placed(base.Pos(p.at.x + 1, p.at.y), _pf_t0.shape)

# ==== item.py ====
from dataclasses import dataclass
import place
@dataclass(frozen=True, slots=True, order=True)
class Item:
    name: str
    placed: object
def item(n, x):
    return Item(n, place.mk(x))

