# ==== base.py ====
from dataclasses import dataclass
from functools import total_ordering
@dataclass(frozen=True, slots=True, order=True)
class Pos:
    x: int
    y: int
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: int
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Box:
    _0: object
    def __repr__(self):
        return f"Box({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
origin = Pos(0, 0)

# ==== place.py ====
from dataclasses import dataclass
import base
@dataclass(frozen=True, slots=True, order=True)
class Placed:
    at: object
    shape: object
def mk(x):
    return Placed(base.Pos(x, 0), base.Circle(x))
def shift(p):
    _pf_t0 = p
    return Placed(base.Pos(p.at.x + 1, p.at.y), _pf_t0.shape)

# ==== item.py ====
from dataclasses import dataclass
import place
@dataclass(frozen=True, slots=True, order=True)
class Item:
    name: str
    placed: object
def item(n, x):
    return Item(n, place.mk(x))

# ==== scene.py ====
from dataclasses import dataclass
import item
@dataclass(frozen=True, slots=True, order=True)
class Scene:
    items: list
    focus: object
scene = Scene([item.item("a", 1), item.item("b", 2)], item.item("f", 3))

# ==== main.py ====
import scene
v = scene.scene
print(v.focus.placed.at.x)
print(v.focus.placed.at.y)

