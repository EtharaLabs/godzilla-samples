from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(tell(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(tell(f"z={z}"), lambda _: Writer_return_(z)))(y + 7)))
print(_pf_map(trace2, [1, 1]))
def grow(n):
    return n * 2
def _pf_fn0():
    _pf_t0 = [1, 2]
    if _pf_t0:
        grow = _pf_t0[0]
        return grow + 1
    else:
        return 0
chosen = _pf_fn0()
print((chosen, grow(6)))
def wrap(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([3, 3, 0]))
def inc(x):
    return x + 1
def step2(x):
    return x * 2
def pipeline2(x):
    return (lambda _pf_x: (lambda _pf_x: step2(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(pipeline2, [0, 8, 0]))
marks = [Score("pam", 15, 0.44), Score("lu", 35, 0.23), Score("ray", 72, 0.71)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {} {} {} pts={}".format(_pf_fmt_pad_left(5, " ", str(pts * 5)), _pf_str_upper(_pf_str_slice(0, 2, who)), _pf_fmt_percent(1, ratio), "pass" if pts >= 62 else "fail", pts)
_pf_iter(print, _pf_map(line3, marks))
total = _pf_sum_by(lambda s: s.pts, marks)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, marks)), "{", "}"))
