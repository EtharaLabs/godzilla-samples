from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
panels = [Box(4, 7, "rod"), Box(6, 2, "wick"), Box(2, 2, "rod"), Box(4, 4, "sq")]
def caption(b):
    match b:
        case Box(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Box(label=label, w=1):
            return f"{label} thin"
        case Box(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, panels)))
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), panels)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 1, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, panels)))
def stackOf(s):
    match s:
        case Shelf(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def apply(acc, op):
    match acc:
        case (m, xs):
            match op:
                case Put(k, v):
                    return (_pf_map_add(k, v, m), xs)
                case Push(n):
                    return (m, _pf_concat(xs, [n]))
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def runAll(script):
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
changes = [Put("bolt", 7), Push(1), Push(0), _Skip, _Skip]
final = runAll(changes)
mm, items = final
print((_pf_map_to_list(mm), items))
acc = _pf_fold(lambda apply, x: apply + x * x, 0, [5, 6, 3, 7])
print(acc)
scores = [Result2("ned", 57, 0.62), Result2("quin", 31, 0.04), Result2("eli", 22, 0.01), Result2("fay", 71, 0.04)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{},{},{{{}}}".format(_pf_fmt_pad_right(6, ".", who), _pf_str_upper(_pf_str_slice(0, 2, who)), pts)
_pf_iter(print, _pf_map(fmtRow, scores))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, scores))))
