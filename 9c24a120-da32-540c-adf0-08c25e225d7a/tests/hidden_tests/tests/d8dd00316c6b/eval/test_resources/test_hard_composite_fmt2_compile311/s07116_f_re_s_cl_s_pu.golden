from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
scores = [Mark("fay", 92, 0.87), Mark("tom", 37, 0.3), Mark("gus", 66, 0.91), Mark("eli", 17, 0.09)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{}: pts={}: {{{}}}: {}".format(_pf_fmt_pad_right(6, ".", who), pts, pts, _pf_str_upper(_pf_str_slice(0, 2, who)))
_pf_iter(print, _pf_map(fmtRow, scores))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, scores))))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 3
        return n
    return next_
clock = makeCounter(8)
print((clock(None), clock(None), clock(None)))
def stamp(xs):
    i = 1
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["max", "bo", "ivy"]))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([8, -1, 4, -2, 0, -2, -9]))
tiles = [Tile(4, 9, "rod"), Tile(2, 1, "wick"), Tile(4, 5, "tap"), Tile(5, 2, "cog"), Tile(4, 4, "sq")]
def caption(b):
    match b:
        case Tile(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Tile(label=label, w=1):
            return f"{label} thin"
        case Tile(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, tiles)))
def stretch(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Tile(w + 3, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, tiles)))
def relabel(prefix, b):
    label = b.label
    _pf_t3 = b
    return Tile(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "x-"), tiles)))
