from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
journal = []
def traced(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [3, 2]))
print((out, journal))
def scanSum(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([9, -5, 6, -1]))
tallies = [("nut", 5), ("wick", 8), ("pin", 8)]
def _pf_fn0(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes = _pf_fold(_pf_fn0, (1000, -1000), tallies)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(tallies, tallies):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
byName = acc
print(_pf_map_to_list(byName))
def audit2(rows):
    def _pf_fn1():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t1 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t1, Ok):
            total = _pf_t1._0
            return Ok(total)
        else:
            return _pf_t1
    return _pf_fn1()
print((audit2(tallies), audit2([("ok", 1)])))
widths = [("lu", (1, 10)), ("eli", (1, 6)), ("pam", (2, 8))]
def _pf_fn2():
    for (name, (lo, hi)) in widths:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
widthsOut = _pf_fn2()
print(list(widthsOut))
def _pf_fn3(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn3, _pf_indexed(tallies))
board = [Score("gus", 27, 0.1), Score("cy", 52, 0.78), Score("max", 18, 0.47), Score("oz", 46, 0.16), Score("ada", 83, 0.78)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{},{{{}}},pts={},{}".format(f"<{pts}>", pts, pts, _pf_str_upper(_pf_str_slice(0, 2, who)))
_pf_iter(print, _pf_map(line3, board))
total = _pf_sum_by(lambda s: s.pts, board)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, board)), "{", "}"))
