from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([3, 12, 32]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "dee", "stop"])
print((events, counts))
def execute(script):
    def fold1(acc, op):
        match acc:
            case (m, xs):
                match op:
                    case Put(k, v):
                        return (_pf_map_add(k, v, m), xs)
                    case Push(n):
                        return (m, _pf_concat(xs, [n]))
                    case Skip():
                        return acc
                    case _:
                        raise RuntimeError("non-exhaustive match")
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops = [Put("bolt", 5), Put("cog", 5), Put("gear", 7), Put("gear", 4), Put("nut", 7)]
state = execute(ops)
mm, items = state
print((_pf_map_to_list(mm), items))
sumSq = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [1, 1, 2, 4])
print(sumSq)
marks = [Mark("oz", 66, 0.17), Mark("kit", 40, 0.44), Mark("cy", 41, 0.61), Mark("max", 48, 0.92), Mark("hal", 5, 0.48)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {{{}}} {} {}".format(_pf_fmt_pad_left(5, " ", str(pts * 4)), pts, _pf_str_join("/", [who, str(pts)]), f"<{pts}>")
_pf_iter(print, _pf_map(fmtRow, marks))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, marks))))
