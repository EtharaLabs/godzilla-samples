from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([9, 6, 16, 8]))
def scanSum(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([-6, -6, -7, 0, 7, -6]))
board = [Mark("ned", 42, 0.94), Mark("ada", 63, 0.18), Mark("sue", 40, 0.79), Mark("jo", 13, 0.39)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {} {} {{{}}}".format(f"<{pts}>", _pf_fmt_pad_right(6, ".", who), _pf_str_upper(_pf_str_slice(0, 2, who)), pts)
_pf_iter(print, _pf_map(fmtRow, board))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, board))))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([37, 20, 20, 2]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "hal", "stop"])
print((logged, counts))
def ping(n, acc):
    if n <= 0:
        return acc
    else:
        return stepB(n - 1, acc + 1)
def stepB(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
print(_pf_map(lambda n: ping(n, 1), [8, 15, 8, 1]))
