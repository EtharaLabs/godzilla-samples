from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
def grow(n):
    return n * 2
def _pf_fn0():
    _pf_t0 = [2, 2]
    if _pf_t0:
        grow = _pf_t0[0]
        return grow + 1
    else:
        return 0
chosen = _pf_fn0()
print((chosen, grow(4)))
def wrap(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([9, 8, 8]))
adders = _pf_map(lambda k: lambda x: x * 10 + k, [9, 9, 9])
print(_pf_map(lambda g: g(4), adders))
def swapSum(pairs):
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn1(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn1, pairs))
print(swapSum([(7, 2), (4, 3)]))
def step(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Push(n):
                    return (puts, total + n)
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def runAll(script):
    return _pf_fold(step, (0, 0), script)
script = [Push(6), Push(-2), Put("nut", 6), Push(6), Push(9), _Skip]
final = runAll(script)
print(final)
sumSq = _pf_fold(lambda step, x: step + x * x, 0, [4, 6, 8, 1])
print(sumSq)
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([11, 15, 4, 17, 15]))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([4, 8, 2, 5]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 2
        return n
    return next_
tick = ticker(2)
print((tick(None), tick(None), tick(None)))
