def Maybe_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Maybe_return_(x):
    return Some(x)
def safeDiv(a, b):
    return Maybe_bind(_pf_str_to_int(a), lambda x: Maybe_bind(_pf_str_to_int(b), lambda y: Maybe_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Maybe_return_(shown))(q * 3))))
print((safeDiv("29", "4"), safeDiv("4", "0"), safeDiv("x", "1")))
boxes = [Tile(1, 5, "gear"), Tile(7, 7, "cog"), Tile(8, 7, "cap"), Tile(3, 7, "bolt"), Tile(4, 4, "sq")]
