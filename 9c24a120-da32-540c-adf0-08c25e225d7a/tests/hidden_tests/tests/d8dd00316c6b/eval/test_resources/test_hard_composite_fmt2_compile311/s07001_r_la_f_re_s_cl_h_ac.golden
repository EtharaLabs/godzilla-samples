print(_pf_map(lambda g: g(3), scalers))
tweak2 = lambda _pf_x: (lambda z: z - 2)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, inputs2))
marks = [Mark("cy", 87, 0.92), Mark("dee", 10, 0.58), Mark("hal", 92, 0.29), Mark("quin", 62, 0.43), Mark("ned", 96, 0.56)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {} {} {}".format(f"<{pts}>", "pass" if pts >= 65 else "fail", _pf_str_upper(_pf_str_slice(0, 2, who)), _pf_fmt_pad_left(5, " ", str(pts * 4)))
