from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
board = [Mark("sue", 32, 0.8), Mark("ray", 96, 0.28), Mark("dee", 65, 0.86), Mark("oz", 47, 0.15), Mark("cy", 70, 0.83)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} | {} | {{{}}}".format(_pf_str_join("/", [who, str(pts)]), "pass" if pts >= 32 else "fail", pts)
_pf_iter(print, _pf_map(line3, board))
print("{} rows; names={}".format(len(board), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", board))))
boxes = [Tile(4, 2, "tap"), Tile(6, 7, "wick"), Tile(3, 1, "hub"), Tile(4, 4, "sq")]
def relabel(prefix, b):
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), boxes)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def stackOf(s):
    match s:
        case Rack(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def fem(n):
    if n == 0:
        return 1
    else:
        return n - mal(fem(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - fem(mal(n - 1))
print((_pf_map(fem, _pf_range(0, 12)), _pf_map(mal, _pf_range(0, 10))))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 1
        return n
    return next_
tick = makeCounter(8)
print((tick(None), tick(None), tick(None)))
def numbered(xs):
    i = 0
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["quin", "ray", "ada"]))
