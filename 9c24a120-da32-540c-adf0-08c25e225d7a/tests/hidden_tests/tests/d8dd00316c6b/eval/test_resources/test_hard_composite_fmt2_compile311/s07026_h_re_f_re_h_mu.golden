from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: object
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Member(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 3:
            _pf_t1 = t
            return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [Active(Member("kit", 29)), _Gone, Active(Member("ivy", 24)), _Gone])
print(slots)
people = [Member("kit", 9), Member("bo", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
scores = [Mark("kit", 41, 0.5), Mark("dee", 54, 0.75), Mark("pam", 63, 0.05)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{},{},{{{}}}".format(_pf_str_upper(_pf_str_slice(0, 2, who)), _pf_fmt_pad_right(6, ".", who), pts)
_pf_iter(print, _pf_map(line3, scores))
total = _pf_sum_by(lambda s: s.pts, scores)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores)), "{", "}"))
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(4, 0)
print(audit([14, 8, 4, 6, 17, 15]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "dee", "stop"])
print((events, counts))
