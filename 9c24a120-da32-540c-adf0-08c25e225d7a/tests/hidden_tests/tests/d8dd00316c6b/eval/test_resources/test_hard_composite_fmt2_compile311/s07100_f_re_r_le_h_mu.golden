from dataclasses import dataclass
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
board = [Result2("kit", 1, 0.45), Result2("hal", 59, 0.55), Result2("eli", 35, 0.86), Result2("ray", 14, 0.91), Result2("ada", 18, 0.98)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{{{}}}: {}: pts={}".format(pts, f"<{pts}>", pts)
_pf_iter(print, _pf_map(fmtRow, board))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, board))))
def fem(n):
    if n == 0:
        return 1
    else:
        return n - male(fem(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - fem(male(n - 1))
print((_pf_map(fem, _pf_range(0, 6)), _pf_map(male, _pf_range(0, 6))))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([13, 11, 0, 1]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "fay", "stop"])
print((events, counts))
