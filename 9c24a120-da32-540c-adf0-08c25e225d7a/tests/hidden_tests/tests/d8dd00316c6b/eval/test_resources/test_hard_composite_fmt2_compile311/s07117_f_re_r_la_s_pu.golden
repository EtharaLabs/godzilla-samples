from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
scores = [Mark("pam", 46, 0.6), Mark("bo", 0, 0.26), Mark("cy", 34, 0.93), Mark("fay", 57, 0.68)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{{{}}}: {}: {}".format(pts, _pf_str_join("/", [who, str(pts)]), _pf_fmt_pad_right(6, ".", who))
_pf_iter(print, _pf_map(fmtRow, scores))
print("{} rows; names={}".format(len(scores), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", scores))))
seriesA = [16, 29, 24, -3, 10]
gain = 2
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(seriesA))))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
panels = [Tile(9, 1, "cog"), Tile(4, 4, "cog"), Tile(1, 1, "wick"), Tile(4, 4, "sq")]
def grow(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Tile(w + 3, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, panels)))
def stackOf(s):
    match s:
        case Rack(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def relabel(prefix, b):
    label = b.label
    _pf_t3 = b
    return Tile(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "new "), panels)))
