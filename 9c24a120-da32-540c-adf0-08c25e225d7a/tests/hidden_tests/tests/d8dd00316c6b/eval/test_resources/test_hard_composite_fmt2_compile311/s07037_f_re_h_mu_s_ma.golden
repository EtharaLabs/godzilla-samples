from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
scores = [Mark("jo", 85, 0.49), Mark("hal", 31, 0.09), Mark("max", 88, 0.46), Mark("bo", 44, 0.81), Mark("pam", 97, 0.28)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} | {} | {} | {}".format("pass" if pts >= 67 else "fail", _pf_fmt_pad_right(6, ".", who), _pf_fmt_pad_left(5, " ", str(pts * 3)), _pf_fmt_percent(1, ratio))
_pf_iter(print, _pf_map(line3, scores))
print("best: {}".format(_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, scores)))))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(scan([21, 22, 20, 7]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "fay", "stop"])
print((events, counts))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 8
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(adjust, [18, 30, 0, 24]))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([2, 3]), dig([8, 9]), dig([])))
def extent(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Square(4), Disc(8), Wedge(2, 9), Wedge(1, 9)]))
