from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
marks = [Score("kit", 6, 0.41), Score("oz", 94, 0.13), Score("ray", 54, 0.78), Score("max", 96, 0.45), Score("tom", 28, 0.07)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {} {} {}".format(_pf_str_join("/", [who, str(pts)]), "pass" if pts >= 38 else "fail", _pf_str_upper(_pf_str_slice(0, 2, who)), _pf_fmt_pad_left(5, " ", str(pts * 2)))
_pf_iter(print, _pf_map(fmtRow, marks))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, marks))))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([13, 10, 0, 7, 4]))
trail = []
def traced(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [8, 3]))
print((out, trail))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 2
        return n
    return next_
tick = ticker(4)
print((tick(None), tick(None), tick(None)))
def fold1(acc, op):
    match acc:
        case (m, xs):
            match op:
                case Put(k, v):
                    return (_pf_map_add(k, v, m), xs)
                case Push(n):
                    return (m, _pf_concat(xs, [n]))
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def replay(script):
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
changes = [Push(2), Push(1), Push(5), _Skip]
outcome = replay(changes)
mm, items = outcome
print((_pf_map_to_list(mm), items))
sumSq = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [1, 3, 4, 7])
print(sumSq)
def female(n):
    if n == 0:
        return 1
    else:
        return n - mal(female(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - female(mal(n - 1))
print((_pf_map(female, _pf_range(0, 8)), _pf_map(mal, _pf_range(0, 6))))
