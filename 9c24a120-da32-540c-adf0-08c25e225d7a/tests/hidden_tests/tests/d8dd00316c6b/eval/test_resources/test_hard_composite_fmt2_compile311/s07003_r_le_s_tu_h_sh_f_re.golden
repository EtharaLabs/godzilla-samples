from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
def fem(n):
    if n == 0:
        return 1
    else:
        return n - mal(fem(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - fem(mal(n - 1))
print((_pf_map(fem, _pf_range(0, 8)), _pf_map(mal, _pf_range(0, 8))))
stock = [("cap", 6), ("wick", 16), ("gear", 9), ("bolt", -1), ("cog", 0)]
widths = [("quin", (5, 16)), ("bo", (2, 18)), ("max", (4, 10))]
def _pf_fn0():
    for (name, (lo, hi)) in widths:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
widthsOut = _pf_fn0()
print(list(widthsOut))
def audit2(rows):
    def _pf_fn1():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn1()
print((audit2(stock), audit2([("ok", 1)])))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes = _pf_fold(_pf_fn2, (1000, -1000), stock)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(stock, stock):
    _pf_t1 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t1
byName = acc
print(_pf_map_to_list(byName))
def _pf_fn3():
    for (name, qty) in stock:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn3()
print(_pf_str_join(",", list(labels)))
def lift(n):
    return n + 39
def useBump(x):
    return lift(x)
def _pf_fn4():
    lift = 1
    return useBump(lift)
sample = _pf_fn4()
print((sample, useBump(6)))
def step1(x):
    return x + 1
def dbl(x):
    return x * 2
def both(x):
    return (lambda _pf_x: (lambda _pf_x: dbl(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [2, 5, 4]))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [6, 9, 6])
print(_pf_map(lambda g: g(4), makers))
scores = [Result2("quin", 29, 0.39), Result2("gus", 0, 0.32), Result2("eli", 74, 0.09), Result2("dee", 22, 0.9)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{},{},{}".format(_pf_fmt_pad_left(5, " ", str(pts * 3)), _pf_fmt_percent(1, ratio), _pf_str_upper(_pf_str_slice(0, 2, who)))
_pf_iter(print, _pf_map(fmtRow, scores))
total = _pf_sum_by(lambda s: s.pts, scores)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores)), "{", "}"))
