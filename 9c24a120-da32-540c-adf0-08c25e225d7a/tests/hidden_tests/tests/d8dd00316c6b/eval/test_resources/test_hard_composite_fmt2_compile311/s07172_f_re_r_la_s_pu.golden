    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), seriesA))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
tweak2 = lambda _pf_x: (lambda z: z - 0)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, seriesA))
boxes = [Box(7, 9, "cog"), Box(5, 4, "cap"), Box(1, 2, "hub"), Box(9, 2, "bolt"), Box(4, 4, "sq")]
