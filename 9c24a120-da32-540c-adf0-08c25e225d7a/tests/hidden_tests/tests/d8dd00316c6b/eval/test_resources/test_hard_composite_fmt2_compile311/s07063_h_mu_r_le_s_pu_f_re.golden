print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
scores = [Mark("ned", 98, 0.29), Mark("hal", 2, 0.31), Mark("bo", 59, 0.11), Mark("max", 85, 0.99)]
def line3(_pf_arg0):
