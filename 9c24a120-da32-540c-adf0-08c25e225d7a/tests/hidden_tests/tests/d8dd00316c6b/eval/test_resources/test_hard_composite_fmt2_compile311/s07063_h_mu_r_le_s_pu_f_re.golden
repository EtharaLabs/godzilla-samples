def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([32, 14, 17, 29, 23, 2]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "max", "stop"])
print((events, counts))
def evalEx(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return evalEx(env, a) + evalEx(env, b)
            case Block(body, last):
                env, e = (_pf_fold(exec, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def exec(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, evalEx(env, e), env)
        case Show(e):
            return _pf_map_add("shown", evalEx(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(evalEx(dict(), Block([Set("a", Lit(7)), Set("b", Plus(Ref("a"), Lit(6))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
boxes = [Box(3, 2, "nut"), Box(1, 6, "hub"), Box(1, 5, "cap"), Box(3, 7, "wick"), Box(4, 4, "sq")]
