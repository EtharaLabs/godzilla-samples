from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True, repr=False)
class Lit:
    _0: int
    def __repr__(self):
        return f"Lit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ref:
    _0: str
    def __repr__(self):
        return f"Ref({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Plus:
    _0: object
    _1: object
    def __repr__(self):
        return f"Plus({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: object
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: object
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: object
    def __repr__(self):
        return f"Show({self._0!r})"
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
def value(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return value(env, a) + value(env, b)
            case Block(body, last):
                env, e = (_pf_fold(exec, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def exec(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, value(env, e), env)
        case Show(e):
            return _pf_map_add("shown", value(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(value(dict(), Block([Set("a", Lit(6)), Set("b", Plus(Ref("a"), Lit(1))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
panels = [Box(1, 2, "cap"), Box(4, 8, "gear"), Box(8, 9, "cap"), Box(4, 4, "sq")]
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, panels)))
def stackOf(s):
    match s:
        case Rack(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def surface(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, panels)))
def stretch(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Box(w + 2, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, panels)))
inputs2 = [0, 30, 26, 29, -1, -2, 30, 1]
gain = 3
scalers = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(9), scalers))
def _pf_fn2(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn2, _pf_indexed(inputs2))))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(inputs2)))
def _pf_fn3(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn3, _pf_zip(inputs2, _pf_map(lambda x: x * x, inputs2)))))
scores = [Result2("ned", 77, 0.59), Result2("ivy", 52, 0.27), Result2("ada", 32, 0.3), Result2("dee", 29, 0.46), Result2("tom", 100, 0.27)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{},{},{},{},{{{}}}".format(_pf_fmt_pad_left(5, " ", str(pts * 7)), _pf_fmt_pad_right(6, ".", who), _pf_fmt_percent(1, ratio), "pass" if pts >= 59 else "fail", pts)
