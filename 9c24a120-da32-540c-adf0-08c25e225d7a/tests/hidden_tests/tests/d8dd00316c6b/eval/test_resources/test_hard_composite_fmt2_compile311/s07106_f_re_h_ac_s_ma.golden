def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 10:
        return _Low()
    elif scaled < 32:
        return _Mid()
    else:
        return _High()
def describe(n):
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
