@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: object
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: object
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: object
    def __repr__(self):
        return f"Show({self._0!r})"
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([1, 6]), probe2([4, 9]), probe2([])))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 4
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(8, []), weigh(1, [3]), weigh(1, [9, 2, 3])))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((3, 8)), 0), pick(Some((1, 5)), 0), pick(_None_, 1)))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 2
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(settle, [23, 4, 2, 20]))
def promote(s):
    match s:
        case Active(p):
            _pf_t1 = p
            return Active(Person(_pf_t1.name, p.age + 1))
        case Idle(t) if t.size > 6:
            _pf_t2 = t
            return Idle(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [Active(Person("ned", 36)), Idle(Team("tap", 6)), Active(Person("ned", 49))])
print(slots)
members = [Person("hal", 5), Person("bo", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def value(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return value(env, a) + value(env, b)
            case Block(body, last):
                env, e = (_pf_fold(exec, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def exec(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, value(env, e), env)
        case Show(e):
            return _pf_map_add("shown", value(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(value(dict(), Block([Set("a", Lit(4)), Set("b", Plus(Ref("a"), Lit(5))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
