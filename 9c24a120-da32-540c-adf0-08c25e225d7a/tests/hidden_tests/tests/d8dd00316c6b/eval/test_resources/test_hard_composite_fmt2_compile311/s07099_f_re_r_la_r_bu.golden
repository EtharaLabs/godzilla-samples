from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Form:
    user: str
    age: int
marks = [Score("max", 0, 0.97), Score("fay", 52, 0.36), Score("gus", 36, 0.61), Score("eli", 93, 0.98)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{},{},{}".format(_pf_str_join("/", [who, str(pts)]), _pf_fmt_percent(1, ratio), "pass" if pts >= 48 else "fail")
_pf_iter(print, _pf_map(fmtRow, marks))
print("{} rows; names={}".format(len(marks), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", marks))))
nums2 = [28, 9, 21, 8, 16, 24]
gain = 5
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(nums2), nums2))
tweak2 = lambda _pf_x: (lambda z: z - 1)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, nums2))
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(8), makers2))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn0, _pf_zip(nums2, _pf_map(lambda x: x * x, nums2)))))
def Check_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Check_return_(x):
    return Ok(x)
def parseForm(user, age):
    return Check_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Check_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Check_bind(Ok(years) if years >= 17 else Error("too young"), lambda adult: Check_return_(Form(name, adult)))))
