from dataclasses import dataclass
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: object
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Member(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 4:
            _pf_t1 = t
            return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [Parked(Team("hub", 5)), _Gone, Parked(Team("wick", 5))])
print(slots)
people = [Member("pam", 1), Member("fay", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([19, 26, 40]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "bo", "stop"])
print((events, counts))
marks = [Score("kit", 88, 0.46), Score("fay", 47, 0.92), Score("bo", 29, 0.89), Score("ned", 59, 0.61)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {} {} {{{}}}".format(f"<{pts}>", _pf_fmt_pad_right(6, ".", who), _pf_fmt_percent(1, ratio), pts)
_pf_iter(print, _pf_map(line3, marks))
print("{} rows; names={}".format(len(marks), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", marks))))
