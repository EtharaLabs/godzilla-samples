        case _:
            return _None_
def grade(s):
    _pf_t1 = _ap_KeyVal(s)
    if isinstance(_pf_t1, Some):
        pair = _pf_t1._0
        if _pf_snd(pair) > 9:
            return f"{_pf_fst(pair)} big"
    if isinstance(_pf_t1, Some):
        pair = _pf_t1._0
