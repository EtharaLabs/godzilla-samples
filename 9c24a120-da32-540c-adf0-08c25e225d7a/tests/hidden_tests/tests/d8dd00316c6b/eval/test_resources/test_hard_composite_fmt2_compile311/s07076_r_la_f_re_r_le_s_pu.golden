def evalEx(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return evalEx(env, a) + evalEx(env, b)
            case Block(body, last):
                env, e = (_pf_fold(exec, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def exec(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, evalEx(env, e), env)
        case Show(e):
            return _pf_map_add("shown", evalEx(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(evalEx(dict(), Block([Set("a", Lit(5)), Set("b", Plus(Ref("a"), Lit(2))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
tiles = [Tile(3, 1, "cog"), Tile(2, 1, "gear"), Tile(7, 6, "pin"), Tile(3, 5, "hub"), Tile(4, 4, "sq")]
def heavier(s):
    match s:
        case Rack(top=Tile(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
