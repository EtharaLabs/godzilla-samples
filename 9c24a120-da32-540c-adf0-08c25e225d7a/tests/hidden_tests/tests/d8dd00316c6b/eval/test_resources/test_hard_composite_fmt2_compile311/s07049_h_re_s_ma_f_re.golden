def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(2, []), score(1, [6]), score(1, [6, 2, 3])))
def size(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Square(5), Disc(9), Wedge(2, 7), Wedge(1, 9)]))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 7
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
