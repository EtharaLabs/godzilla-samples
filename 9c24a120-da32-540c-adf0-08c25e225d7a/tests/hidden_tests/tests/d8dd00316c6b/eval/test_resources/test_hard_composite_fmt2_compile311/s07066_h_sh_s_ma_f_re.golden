def extent(s):
    match s:
        case Sq(n) | Ci(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(6), Ci(8), Tri(1, 8), Tri(1, 9)]))
limit2 = 20
def clip(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(4)), clip(Some(-3)), clip(_None_), limit2))
def settle(n):
