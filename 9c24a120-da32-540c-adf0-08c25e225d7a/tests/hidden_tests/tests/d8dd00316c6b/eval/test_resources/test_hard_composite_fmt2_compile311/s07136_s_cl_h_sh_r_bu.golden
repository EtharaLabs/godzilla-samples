import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([0, 7, 0, 6]))
def stamp(xs):
    i = 0
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["cy", "fay", "pam"]))
trail = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [6, 3]))
print((out, trail))
def lift(n):
    return n + 76
def applyLift(x):
    return lift(x)
def _pf_fn0():
    lift = 2
    return applyLift(lift)
sample = _pf_fn0()
print((sample, applyLift(5)))
def step1(x):
    return x + 1
def step2(x):
    return x * 2
def pipeline2(_pf_x):
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: step2(step1(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(pipeline2, [0, 3, 6]))
def adjust(x, flag):
    y = x * 2
    if flag:
        _y = x + 233
        _pf_t0 = _y - 1
    else:
        _pf_t0 = y
    z = _pf_t0
    return (y, z)
print((adjust(4, True), adjust(9, False)))
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(tell(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(tell(f"z={z}"), lambda _: Writer_return_(z)))(y + 4)))
print(_pf_map(trace2, [9, 6]))
