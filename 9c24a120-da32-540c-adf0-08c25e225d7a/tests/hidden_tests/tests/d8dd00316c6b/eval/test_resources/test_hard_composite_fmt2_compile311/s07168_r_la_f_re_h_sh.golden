print(len(_pf_filter(_pf_fn0, _pf_zip(nums2, _pf_map(lambda x: x * x, nums2)))))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(nums2), nums2))
shape2 = lambda _pf_x: (lambda z: z - 2)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, nums2))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), nums2))
board = [Result2("max", 22, 0.37), Result2("ned", 50, 0.32), Result2("quin", 63, 0.55)]
def line3(_pf_arg0):
