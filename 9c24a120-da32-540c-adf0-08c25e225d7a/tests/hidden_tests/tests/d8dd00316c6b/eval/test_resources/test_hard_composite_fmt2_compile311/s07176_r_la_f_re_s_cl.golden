from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
inputs2 = [17, -6, -5, 5, 1, 26, -6]
factor = 5
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(inputs2)))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(inputs2))))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), inputs2))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(inputs2), inputs2))
marks = [Score("quin", 17, 0.6), Score("jo", 39, 0.82), Score("hal", 3, 0.58)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{},{{{}}},{},{},{}".format(_pf_fmt_percent(1, ratio), pts, _pf_str_join("/", [who, str(pts)]), _pf_fmt_pad_left(5, " ", str(pts * 4)), f"<{pts}>")
_pf_iter(print, _pf_map(fmtRow, marks))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, marks))))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([5, 18, 2, 10, 15, 6]))
def numbered(xs):
    i = 2
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["cy", "sue", "lu"]))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 4
        return n
    return next_
clock = makeCounter(8)
print((clock(None), clock(None), clock(None)))
