def size(s):
    match s:
        case Square(n) | Ci(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Square(3), Ci(3), Tri(1, 2), Tri(1, 9)]))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((8, 5)), 0), pick(Some((1, 5)), 0), pick(_None_, 3)))
