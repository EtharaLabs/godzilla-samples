from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
boxes = [Tile(5, 3, "cap"), Tile(8, 6, "nut"), Tile(3, 3, "pin"), Tile(7, 5, "gear"), Tile(4, 6, "rod"), Tile(4, 4, "sq")]
def relabel(prefix, b):
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "new "), boxes)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def describe(b):
    match b:
        case Tile(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Tile(label=label, w=1):
            return f"{label} thin"
        case Tile(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, boxes)))
scores = [Score("ned", 13, 0.86), Score("eli", 5, 0.29), Score("max", 80, 0.2)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{}: {}: {}: {}".format("pass" if pts >= 44 else "fail", f"<{pts}>", _pf_fmt_pad_right(6, ".", who), _pf_str_join("/", [who, str(pts)]))
_pf_iter(print, _pf_map(line3, scores))
total = _pf_sum_by(lambda s: s.pts, scores)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores)), "{", "}"))
def female(n):
    if n == 0:
        return 1
    else:
        return n - male(female(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - female(male(n - 1))
print((_pf_map(female, _pf_range(0, 9)), _pf_map(male, _pf_range(0, 7))))
