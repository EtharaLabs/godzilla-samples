from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_snd(p):
    return p[1]
pairs = [("wick", 15), ("tap", 5), ("gear", 14)]
def _pf_fn0(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds = _pf_fold(_pf_fn0, (1000, -1000), pairs)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(pairs, pairs):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
byName = acc
print(_pf_map_to_list(byName))
def _pf_fn1():
    for (name, qty) in pairs:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn1()
print(_pf_str_join(",", list(labels)))
def audit2(rows):
    def _pf_fn2():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t1 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t1, Ok):
            total = _pf_t1._0
            return Ok(total)
        else:
            return _pf_t1
    return _pf_fn2()
print((audit2(pairs), audit2([("ok", 1)])))
def inWord(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    return inSpace(rest, n)
                else:
                    cs, n = (rest, n)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
def inSpace(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    cs, n = (rest, n)
                    continue
                else:
                    return inWord(rest, n + 1)
            case _:
                raise RuntimeError("non-exhaustive match")
print(inSpace(list("  gus fay tom kit bo "), 0))
trail = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [2, 5]))
print((out, trail))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 1
        return n
    return next_
tick = ticker(7)
print((tick(None), tick(None), tick(None)))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([19, 10, 6, 10]))
