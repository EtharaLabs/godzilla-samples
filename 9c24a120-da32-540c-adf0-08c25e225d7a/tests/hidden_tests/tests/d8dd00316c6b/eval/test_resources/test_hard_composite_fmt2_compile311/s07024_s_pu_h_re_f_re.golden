    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} pts={} {} {}".format(_pf_str_join("/", [who, str(pts)]), pts, _pf_fmt_percent(1, ratio), _pf_str_upper(_pf_str_slice(0, 2, who)))
