def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Square:
