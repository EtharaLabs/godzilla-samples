def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([20, 3, 17, 8]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 3
        return n
    return next_
