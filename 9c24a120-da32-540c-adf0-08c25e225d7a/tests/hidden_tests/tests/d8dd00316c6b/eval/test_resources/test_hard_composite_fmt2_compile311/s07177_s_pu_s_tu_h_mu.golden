from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
panels = [Tile(3, 7, "cap"), Tile(4, 6, "pin"), Tile(9, 2, "pin"), Tile(8, 9, "nut"), Tile(7, 1, "gear"), Tile(4, 4, "sq")]
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "new "), panels)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t3 = b
    return Tile(w + 3, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, panels)))
def area(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, panels)))
def caption(b):
    match b:
        case Tile(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Tile(label=label, w=1):
            return f"{label} thin"
        case Tile(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, panels)))
tallies = [("gear", 8), ("rod", 14), ("cap", 4)]
widths = [("pam", (3, 19)), ("max", (5, 6)), ("sue", (2, 16))]
def _pf_fn0():
    for (name, (lo, hi)) in widths:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
widthsOut = _pf_fn0()
print(list(widthsOut))
def _pf_fn1(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn1, _pf_indexed(tallies))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds = _pf_fold(_pf_fn2, (1000, -1000), tallies)
