from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
scores = [Result2("fay", 23, 0.35), Result2("cy", 8, 0.02), Result2("bo", 35, 0.95)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} | {} | {}".format(_pf_fmt_percent(1, ratio), f"<{pts}>", "pass" if pts >= 56 else "fail")
_pf_iter(print, _pf_map(fmtRow, scores))
print("{} rows; names={}".format(len(scores), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", scores))))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(4, 0)
print(inspect([0, 11, 23]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "max", "stop"])
print((events, counts))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(5, []), weigh(1, [4]), weigh(1, [2, 2, 3])))
def pick(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((8, 3)), 0), pick(Some((1, 5)), 0), pick(_None_, 7)))
limit2 = 36
def clip(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(8)), clip(Some(-3)), clip(_None_), limit2))
def extent(s):
    match s:
        case Sq(n) | Disc(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(3), Disc(6), Tri(6, 2), Tri(1, 9)]))
