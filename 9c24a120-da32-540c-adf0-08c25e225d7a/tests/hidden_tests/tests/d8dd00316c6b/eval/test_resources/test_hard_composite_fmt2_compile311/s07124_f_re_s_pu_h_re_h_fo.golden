def runAll(script):
    def step(acc, op):
        match acc:
            case (m, xs):
                match op:
                    case Put(k, v):
                        return (_pf_map_add(k, v, m), xs)
                    case Push(n):
                        return (m, _pf_concat(xs, [n]))
                    case Skip():
                        return acc
                    case _:
                        raise RuntimeError("non-exhaustive match")
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
