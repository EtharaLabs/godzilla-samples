from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
tiles = [Panel(8, 6, "nut"), Panel(7, 1, "bolt"), Panel(9, 8, "rod"), Panel(6, 1, "wick"), Panel(7, 4, "nut"), Panel(4, 4, "sq")]
def surface(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, tiles)))
def heavier(s):
    match s:
        case Rack(top=Panel(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def describe(b):
    match b:
        case Panel(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Panel(label=label, w=1):
            return f"{label} thin"
        case Panel(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
def replay(script):
    def step(acc, op):
        return acc
    def step(acc, op):
        match acc:
            case (puts, total):
                match op:
                    case Put(_, v):
                        return (puts + 1, total + v)
                    case Push(n):
                        return (puts, total + n)
                    case Noop():
                        return acc
                    case _:
                        raise RuntimeError("non-exhaustive match")
    return _pf_fold(step, (0, 0), script)
script = [_Noop, _Noop, Push(8), Put("bolt", 4), Push(4), Push(8), Push(7)]
final = replay(script)
print(final)
sumSq = _pf_fold(lambda step, x: step + x * x, 0, [2, 1, 7, 4])
print(sumSq)
scores = [Score("ada", 93, 0.47), Score("max", 9, 0.52), Score("jo", 43, 0.82), Score("dee", 84, 0.64)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "pts={}: {}: {}: {}".format(pts, _pf_str_upper(_pf_str_slice(0, 2, who)), f"<{pts}>", _pf_fmt_pad_right(6, ".", who))
_pf_iter(print, _pf_map(line3, scores))
total = _pf_sum_by(lambda s: s.pts, scores)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores)), "{", "}"))
