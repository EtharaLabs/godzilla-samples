nums2 = [16, -8, 18, -2, 10]
factor = 3
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), nums2))
