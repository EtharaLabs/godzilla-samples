print(_pf_map(lambda g: g(6), scalers))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn1, _pf_zip(nums2, _pf_map(lambda x: x * x, nums2)))))
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Member(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 3:
            _pf_t1 = t
            return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
