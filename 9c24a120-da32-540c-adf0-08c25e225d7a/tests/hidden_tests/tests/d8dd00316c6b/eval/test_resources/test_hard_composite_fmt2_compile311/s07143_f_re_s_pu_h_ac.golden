from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: object
    bottom: object
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
marks = [Score("hal", 38, 0.02), Score("ray", 80, 0.5), Score("max", 47, 0.98)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {} {} {} {}".format(_pf_fmt_pad_right(6, ".", who), f"<{pts}>", "pass" if pts >= 61 else "fail", _pf_str_join("/", [who, str(pts)]), _pf_fmt_percent(1, ratio))
_pf_iter(print, _pf_map(fmtRow, marks))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, marks))))
tiles = [Box(2, 7, "cap"), Box(4, 5, "rod"), Box(3, 9, "gear"), Box(3, 8, "rod"), Box(8, 5, "bolt"), Box(4, 4, "sq")]
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "old-"), tiles)))
def stackOf(s):
    match s:
        case Rack(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Rack(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def caption(b):
    match b:
        case Box(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Box(label=label, w=1):
            return f"{label} thin"
        case Box(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, tiles)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 2, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, tiles)))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 5:
        return _Low()
    elif scaled < 23:
        return _Mid()
    else:
        return _High()
def label(n):
    _pf_t4 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t4, _Low):
        return "low"
    if isinstance(_pf_t4, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t4, _Mid):
        return "mid"
    if isinstance(_pf_t4, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(label, [-4, 6, 21, 26, 12]))
