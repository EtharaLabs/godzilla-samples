from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
seriesA = [6, -9, -7, 12, -5]
gain = 2
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
tweak2 = lambda _pf_x: (lambda z: z - 8)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, seriesA))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(seriesA))))
board = [Score("ray", 21, 0.35), Score("max", 16, 0.06), Score("lu", 31, 0.89), Score("kit", 97, 0.66), Score("oz", 62, 0.06)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{}: {{{}}}: {}: {}: {}".format(_pf_str_upper(_pf_str_slice(0, 2, who)), pts, "pass" if pts >= 66 else "fail", f"<{pts}>", _pf_str_join("/", [who, str(pts)]))
_pf_iter(print, _pf_map(fmtRow, board))
print("best: {}".format(_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, board)))))
panels = [Tile(2, 7, "bolt"), Tile(3, 4, "cap"), Tile(1, 1, "gear"), Tile(9, 2, "cap"), Tile(1, 8, "tap"), Tile(4, 4, "sq")]
def describe(b):
    match b:
        case Tile(w=w, h=h, label=label) if w == h:
            return f"{label} square {w}"
        case Tile(label=label, w=1):
            return f"{label} thin"
        case Tile(label=label, w=w):
            return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
def _pf_fn1(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn2(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn1, _pf_filter(_pf_fn2, panels)))
def rename(prefix, b):
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), panels)))
