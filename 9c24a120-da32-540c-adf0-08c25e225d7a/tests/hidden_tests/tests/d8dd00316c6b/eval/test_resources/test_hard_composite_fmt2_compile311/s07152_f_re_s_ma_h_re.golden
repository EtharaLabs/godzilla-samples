from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
marks = [Mark("hal", 60, 0.03), Mark("ada", 83, 0.85), Mark("fay", 33, 0.78), Mark("tom", 55, 0.71)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} | {} | {{{}}} | {} | {}".format("pass" if pts >= 66 else "fail", _pf_fmt_pad_right(6, ".", who), pts, f"<{pts}>", _pf_fmt_percent(1, ratio))
_pf_iter(print, _pf_map(line3, marks))
total = _pf_sum_by(lambda s: s.pts, marks)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, marks)), "{", "}"))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([5, 3]), dig([9, 9]), dig([])))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((3, 9)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 1)))
limit2 = 12
def clip(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(7)), clip(Some(-3)), clip(_None_), limit2))
def size(s):
    match s:
        case Square(n) | Disc(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Square(9), Disc(5), Wedge(9, 7), Wedge(1, 9)]))
def promote(s):
    match s:
        case Active(p):
            _pf_t1 = p
            return Active(Pilot(_pf_t1.name, p.age + 1))
        case Idle(t) if t.size > 2:
            _pf_t2 = t
            return Idle(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [_Gone, _Gone, Idle(Team("tap", 1)), Active(Pilot("cy", 48)), _Gone])
print(slots)
