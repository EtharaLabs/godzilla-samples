from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
board = [Score("quin", 31, 0.03), Score("hal", 27, 0.81), Score("jo", 32, 0.16), Score("tom", 86, 0.71)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} | {} | {} | {}".format(_pf_fmt_percent(1, ratio), _pf_str_upper(_pf_str_slice(0, 2, who)), "pass" if pts >= 65 else "fail", f"<{pts}>")
_pf_iter(print, _pf_map(line3, board))
print("{} rows; names={}".format(len(board), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", board))))
def inc(x):
    return x + 1
def step2(x):
    return x * 2
def pipeline2(_pf_x):
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: step2(inc(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(pipeline2, [0, 3, 6]))
adders = _pf_map(lambda k: lambda x: x * 10 + k, [9, 6, 2])
print(_pf_map(lambda g: g(3), adders))
def bump2(n):
    return n + 14
def applyLift(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 3
    return applyLift(bump2)
probe = _pf_fn0()
print((probe, applyLift(3)))
stock = [("bolt", 13), ("rod", 17), ("nut", 15), ("wick", 6), ("pin", 12)]
def _pf_fn1(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn1, _pf_indexed(stock))
def _pf_fn2():
    for (name, qty) in stock:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn2()
print(_pf_str_join(",", list(labels)))
spans = [("ada", (1, 12)), ("oz", (5, 18)), ("tom", (5, 8))]
def _pf_fn3():
    for (name, (lo, hi)) in spans:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
spansOut = _pf_fn3()
print(list(spansOut))
def _pf_fn4(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
extremes = _pf_fold(_pf_fn4, (1000, -1000), stock)
print(extremes)
acc = dict()
for (k, v) in _pf_concat(stock, stock):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
index = acc
print(_pf_map_to_list(index))
