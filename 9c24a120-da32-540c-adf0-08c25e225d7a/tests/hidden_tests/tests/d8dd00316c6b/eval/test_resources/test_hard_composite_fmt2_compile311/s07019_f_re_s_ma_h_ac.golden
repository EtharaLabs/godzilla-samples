scores = [Result2("eli", 31, 0.63), Result2("lu", 53, 0.95), Result2("ned", 22, 0.17), Result2("jo", 38, 0.94), Result2("hal", 82, 0.68)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{{{}}},pts={},{},{},{}".format(pts, pts, _pf_fmt_pad_left(5, " ", str(pts * 6)), _pf_str_join("/", [who, str(pts)]), "pass" if pts >= 67 else "fail")
_pf_iter(print, _pf_map(line3, scores))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, scores))))
def extent(s):
    match s:
        case Sq(n) | Ci(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(2), Ci(5), Wedge(7, 3), Wedge(1, 9)]))
def adjust(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 9
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(adjust, [5, 1, 23, 21]))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(8, []), weigh(1, [8]), weigh(1, [6, 2, 3])))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 2:
        return _Low()
    elif scaled < 30:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    match _pf_str_split("=", s):
        case [k, v]:
            _pf_t0 = _pf_str_to_int(v)
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some((_pf_str_strip(k), n))
            else:
                return _None_
        case _:
            return _None_
def tier(n):
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    elif isinstance(_pf_t1, _Mid):
        return "mid"
    elif isinstance(_pf_t1, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def describe(s):
    _pf_t2 = _ap_KeyVal(s)
    if isinstance(_pf_t2, Some):
