from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
journal = []
def logged(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [5, 4]))
print((out, journal))
def makeCounter(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 3
        return n
    return next_
tick = makeCounter(3)
print((tick(None), tick(None), tick(None)))
def stamp(xs):
    i = 2
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["kit", "bo", "quin"]))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(inspect([32, 0, 5, 9, 13]))
logged2 = []
def push2(msg):
    global logged2
    logged2 = _pf_concat(logged2, [msg])
    return len(logged2)
counts = _pf_map(push2, ["start", "ned", "stop"])
print((logged2, counts))
scores = [Mark("hal", 65, 0.68), Mark("tom", 17, 0.77), Mark("oz", 30, 0.14)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{}: {}: {}: {}: {}".format(_pf_fmt_pad_right(6, ".", who), f"<{pts}>", _pf_str_join("/", [who, str(pts)]), _pf_str_upper(_pf_str_slice(0, 2, who)), _pf_fmt_pad_left(5, " ", str(pts * 2)))
_pf_iter(print, _pf_map(fmtRow, scores))
print("{}\n{}".format(_pf_str_upper("report"), _pf_str_join("\n", _pf_map(lambda s: s.who, scores))))
