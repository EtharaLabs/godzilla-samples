def step(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Append(n):
                    return (puts, total + n)
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def runAll(script):
    return _pf_fold(step, (0, 0), script)
script = [_Skip, _Skip, Put("nut", 4), _Skip, _Skip, _Skip, Put("bolt", 4)]
final = runAll(script)
