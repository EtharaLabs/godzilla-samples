from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: object
    bottom: object
    slot: int
board = [Mark("quin", 36, 0.7), Mark("oz", 12, 0.61), Mark("ada", 10, 0.82), Mark("cy", 29, 0.31)]
def fmtRow(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {{{}}} {} {} {}".format(_pf_str_upper(_pf_str_slice(0, 2, who)), pts, "pass" if pts >= 60 else "fail", _pf_fmt_percent(1, ratio), f"<{pts}>")
_pf_iter(print, _pf_map(fmtRow, board))
total = _pf_sum_by(lambda s: s.pts, board)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, board)), "{", "}"))
seriesA = [28, 29, 3, 7, 13]
factor = 4
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn0, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), seriesA))
def _pf_fn2(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn2, _pf_indexed(seriesA))))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(seriesA), seriesA))
boxes = [Box(4, 3, "wick"), Box(3, 7, "bolt"), Box(3, 9, "cog"), Box(7, 3, "wick"), Box(4, 4, "sq")]
def _pf_fn3(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn4(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn3, _pf_filter(_pf_fn4, boxes)))
def surface(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, boxes)))
def grow(b):
    w = b.w
    h = b.h
    _pf_t1 = b
    return Box(w + 1, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, boxes)))
def heavier(s):
    match s:
        case Shelf(top=Box(w=w), bottom=bottom, slot=slot) if w > bottom.w:
            return f"top {slot}"
        case Shelf(slot=slot):
            return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
