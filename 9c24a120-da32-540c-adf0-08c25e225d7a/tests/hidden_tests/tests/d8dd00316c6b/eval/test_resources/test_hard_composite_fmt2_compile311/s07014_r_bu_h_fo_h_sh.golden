from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(note2(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(note2(f"z={z}"), lambda _: Writer_return_(z)))(y + 3)))
print(_pf_map(trace2, [5, 6]))
def execute(script):
    def step(acc, op):
        return acc
    def step(acc, op):
        match acc:
            case (m, xs):
                match op:
                    case Put(k, v):
                        return (_pf_map_add(k, v, m), xs)
                    case Append(n):
                        return (m, _pf_concat(xs, [n]))
                    case Skip():
                        return acc
                    case _:
                        raise RuntimeError("non-exhaustive match")
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script = [Append(6), Append(5), Put("cog", 2), _Skip, Put("nut", 9), Append(9)]
final = execute(script)
mm, items = final
print((_pf_map_to_list(mm), items))
