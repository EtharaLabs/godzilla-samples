    return n + 96
def applyLift(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 4
    return applyLift(bump2)
sample = _pf_fn0()
print((sample, applyLift(1)))
def merge(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t2 = _pair
    else:
        _pf_t2 = 2
    r = _pf_t2
    return pair(r, 1)
