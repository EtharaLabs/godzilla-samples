print("{} rows; names={}".format(len(scores), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", scores))))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(scan([1, 30, 10, 7, 27, 16]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "lu", "stop"])
print((logged, counts))
def _ap_KeyVal(s):
    match _pf_str_split("=", s):
        case [k, v]:
