from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: object
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Pilot(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 3:
            _pf_t1 = t
            return Parked(Club(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [_Gone, Active(Pilot("tom", 48)), Parked(Club("pin", 2)), Parked(Club("cog", 6)), Active(Pilot("ray", 70))])
print(slots)
members = [Pilot("dee", 3), Pilot("ivy", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
scores = [Score("max", 83, 0.79), Score("hal", 3, 0.43), Score("gus", 72, 1.0)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} {} {}".format(f"<{pts}>", _pf_str_upper(_pf_str_slice(0, 2, who)), "pass" if pts >= 65 else "fail")
_pf_iter(print, _pf_map(line3, scores))
print("{} rows; names={}".format(len(scores), _pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", scores))))
def fold1(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Push(n):
                    return (puts, total + n)
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def execute(script):
    return _pf_fold(fold1, (0, 0), script)
script = [Put("nut", 5), Put("gear", 1), _Skip, Put("bolt", 1), Push(1), Push(0), _Skip]
outcome = execute(script)
print(outcome)
