    return n + 55
def useBump(x):
    return lift(x)
def _pf_fn0():
    lift = 4
    return useBump(lift)
probe = _pf_fn0()
print((probe, useBump(5)))
def adjust(x, flag):
    y = x * 2
    if flag:
        _y = x + 561
        _pf_t0 = _y - 1
    else:
        _pf_t0 = y
    z = _pf_t0
    return (y, z)
print((adjust(1, True), adjust(4, False)))
def outer(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([8, 9, 2]))
