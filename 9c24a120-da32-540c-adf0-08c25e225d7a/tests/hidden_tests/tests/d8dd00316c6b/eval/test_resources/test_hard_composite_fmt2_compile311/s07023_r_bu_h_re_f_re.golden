from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Person:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def Logged_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Logged_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def trace2(x):
    return Logged_bind(tell(f"start {x}"), lambda _: Logged_bind((x * 2, ["scaled"]), lambda y: (lambda z: Logged_bind(tell(f"z={z}"), lambda _: Logged_return_(z)))(y + 2)))
print(_pf_map(trace2, [2, 9]))
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Person(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 3:
            _pf_t1 = t
            return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [_Gone, _Gone, _Gone])
print(roster)
people = [Person("lu", 3), Person("cy", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
scores = [Mark("sue", 79, 0.3), Mark("hal", 22, 0.87), Mark("cy", 19, 0.01)]
def line3(_pf_arg0):
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return "{} pts={} {} {{{}}}".format(_pf_str_join("/", [who, str(pts)]), pts, _pf_fmt_pad_right(6, ".", who), pts)
_pf_iter(print, _pf_map(line3, scores))
total = _pf_sum_by(lambda s: s.pts, scores)
print("total={} avg {} {}done{}".format(total, _pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores)), "{", "}"))
