def allKnown(keys, table):
    def _pf_fn3():
        for (k, expected) in keys:
            _pf_t1 = _pf_map_try_find(k, table)
            if isinstance(_pf_t1, Some):
                v = _pf_t1._0
                return Some(None) if v == expected else _None_
            else:
                return _pf_t1
        return Some(len(keys))
    return _pf_fn3()
print((allKnown(_pf_take(2, tallies), dict(tallies)), allKnown([("zz", 0)], dict(tallies))))
scores = [Mark("ada", 73, 0.32), Mark("quin", 28, 0.68), Mark("kit", 99, 0.34), Mark("dee", 1, 0.38)]
