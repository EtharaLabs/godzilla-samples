from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
tallies = [("pin", 14), ("tap", 16), ("cog", 2), ("bolt", -2), ("wick", 13)]
def validate(rows):
    def _pf_fn0():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn0()
