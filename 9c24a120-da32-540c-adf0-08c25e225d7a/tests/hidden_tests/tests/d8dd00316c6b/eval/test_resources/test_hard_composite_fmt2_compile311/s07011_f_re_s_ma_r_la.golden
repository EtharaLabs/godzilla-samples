def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 2
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(6, []), score(1, [7]), score(1, [2, 2, 3])))
cap = 32
def bound(o):
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
