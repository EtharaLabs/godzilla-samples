import functools
import itertools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
def _pf_fn0():
    for x in _pf_range(1, 7):
        y = x * x
        yield y
series = _pf_fn0()
print(list(filter(lambda n: n % 4 == 0, series)))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
text = "tap ivy hub wick quin gear hal"
parts = _pf_str_split(" ", text)
def cell(_pf_arg0):
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(9, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(parts)))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, parts))))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), parts)))
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
print(_pf_str_slice(0, 9, text))
n2 = len(parts)
print(f"n2={n2} {{braces}} {len(text)}")
def fromBin(s):
    return int(s, base=2)
print(fromBin("1010110") + int("53", base=8))
print(_pf_map(math.isqrt, [172, 47, 321, 131]))
print(_pf_str_rev(str.upper("fay")))
laps = [103.2, 15.8, 315.3, 459.6]
splits = [6.0, 75.8, 7.8, 72.9]
total = _pf_fold(lambda a, b: a + b, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = total / elapsed
print(_pf_fmt_fixed(3, speed))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
mass = 24.0
accel = 1.5
push = mass * accel
limit = 314.0
print("over" if push > limit else "under")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
