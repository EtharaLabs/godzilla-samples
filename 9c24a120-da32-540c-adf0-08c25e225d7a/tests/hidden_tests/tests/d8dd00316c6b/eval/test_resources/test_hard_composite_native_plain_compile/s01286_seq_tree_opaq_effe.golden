from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
def _pf_fn0():
    for x in _pf_range(1, 12):
        y = x * x
        yield y
evens = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, evens))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
def insert(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(insert(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, insert(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
tree = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [57, 55, 34, 12, 13])
def minOf(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minOf(tree))
def sumOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumOf(l) + v + sumOf(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumOf(tree))
def depthOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, _, rt):
            return 1 + max(depthOf(l), depthOf(rt))
        case _:
            raise RuntimeError("non-exhaustive match")
print(depthOf(tree))
def containsT(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsT(k, tree), [57, 14, 19]))
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("u", 3)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("u-1"))
def discount(price, qty):
    return price * qty - 8 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn1, [("wick", 33, 6), ("nut", 39, 6)]))
print(overall)
