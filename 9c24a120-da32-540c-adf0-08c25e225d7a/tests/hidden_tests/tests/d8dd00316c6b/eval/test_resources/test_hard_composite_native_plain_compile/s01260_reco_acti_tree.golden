from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
parcels = [Order(100, "hal", 227, False, Site("Bern", 1)), Order(101, "hal", 232, False, Site("Riga", 3)), Order(102, "hal", 221, False, Site("Rome", 2)), Order(103, "max", 87, True, Site("Bern", 4)), Order(104, "sue", 145, False, Site("Rome", 1)), Order(105, "max", 262, True, Site("Kyiv", 4))]
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by(lambda o: o.amount, parcels))))
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, parcels))
print(byOwner)
def _pf_fn1(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Order(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
moved = _pf_map(_pf_fn1, parcels)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
def tag(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, parcels)))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 11:
        return Some(n - 11)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t4 = _ap_Above(n)
    _pf_t5 = _ap_Zero(n)
    _pf_t6 = _ap_Even_Odd(n)
    if isinstance(_pf_t4, Some):
        d = _pf_t4._0
        return f"above by {d}"
    elif _pf_t5:
        return "zero"
    elif isinstance(_pf_t6, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [40, 14, 14, 23, -4]))
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Num(4), Add(Num(9), Mul(Num(1), Add(Num(1), Num(4)))), Neg(Add(Num(0), Add(Num(1), Num(6))))]
_pf_iter(print, _pf_map(render, terms))
print(_pf_map(evalE, terms))
