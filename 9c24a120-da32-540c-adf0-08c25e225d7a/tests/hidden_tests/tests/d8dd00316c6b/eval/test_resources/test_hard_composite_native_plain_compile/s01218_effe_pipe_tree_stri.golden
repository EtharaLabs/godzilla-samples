result = _pf_reduce(lambda a, b: a + b, _pf_map(functools.partial(shift, 3), _pf_fn2((lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(readings))))
print(result)
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def show(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({show(a)} + {show(b)})"
        case Mul(a, b):
            return f"{show(a)} * {show(b)}"
        case Neg(a):
            return f"-{show(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
def shrink(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(shrink(a), shrink(b))
            case Mul(a, b):
                return Mul(shrink(a), shrink(b))
            case _:
                return e
