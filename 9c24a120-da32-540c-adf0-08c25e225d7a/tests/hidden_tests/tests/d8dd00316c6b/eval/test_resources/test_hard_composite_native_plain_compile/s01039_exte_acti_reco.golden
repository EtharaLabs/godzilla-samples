from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
def fromBin(s):
    return int(s, base=2)
print(fromBin("101010") + int("67", base=8))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
def _ap_Above(n):
    if n > 12:
        return Some(n - 12)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [20, -3, 28, -2, 18, -1]))
tickets = [Order(100, "eli", 297, True), Order(101, "bo", 73, True), Order(102, "gus", 39, False), Order(103, "bo", 123, False), Order(104, "eli", 182, True), Order(105, "bo", 237, False)]
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
def tag(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, tickets)))
def bucket(o):
    match o:
        case Order(urgent=True, amount=amount) if amount > 178:
            return "rush-big"
        case Order(urgent=True):
            return "rush"
        case Order(amount=amount):
            if amount > 178:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, tickets))
print(_pf_count_by(bucket, tickets))
def adjust(pct, o):
    extra = o.amount * pct // 100
    _pf_t3 = o
    return Order(_pf_t3.id, _pf_t3.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 9), tickets)))
print(_pf_max_by(lambda o: o.amount, tickets))
