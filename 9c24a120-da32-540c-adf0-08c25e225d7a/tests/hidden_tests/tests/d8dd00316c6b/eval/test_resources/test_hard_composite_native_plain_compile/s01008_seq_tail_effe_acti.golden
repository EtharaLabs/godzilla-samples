from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_fn0():
    for x in _pf_range(1, 12):
        y = x * x
        yield y
    yield 166
squares = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, squares))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 5)))))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(2269, 0))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(4, 11, 1))
def discount(price, qty):
    return price * qty - 8 * qty
def emit(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall = sum(_pf_map(_pf_fn1, [("gear", 47, 1), ("bolt", 18, 3), ("cog", 15, 6), ("hub", 19, 3)]))
print(overall)
def _ap_Above(n):
    if n > 28:
        return Some(n - 28)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [18, 40, -5, -3, 8, 12, -6, 7]))
