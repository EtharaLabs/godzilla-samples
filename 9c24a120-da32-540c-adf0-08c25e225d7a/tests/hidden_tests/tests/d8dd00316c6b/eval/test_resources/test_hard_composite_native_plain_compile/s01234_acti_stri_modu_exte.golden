from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def bucketOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(bucketOf, [4, 36, 40, 37, 24]))
text = "tom,ned,hub,tap,gus,bolt,hal"
words = _pf_str_split(",", text)
print((_pf_str_index_of("to", text), "to" in text))
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
count = len(words)
print(f"count={count} {{braces}} {len(text)}")
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", ",40,12,40,12"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_square(x):
    return x * x
obs = [30, 26, 22, 27, 7]
print(_pf_map(functools.partial(Stats_clamp, 0, 18), obs))
print(Stats_mean(obs))
print(Stats_scaleAll(5, obs))
print(_pf_map(Stats_square, obs))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [6, 3, 2, 7]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("110100") + int("32", base=8))
