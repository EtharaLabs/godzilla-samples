from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [58, 55, 47]))
def euclid(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(236, 313))
def _pf_fn0():
    for x in _pf_range(1, 12):
        y = x * x
        yield y
squares = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, squares))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
segments = [487.1, 17.3, 447.3]
splits = [38.3, 49.9, 77.2]
total = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = total / dur
print(_pf_fmt_fixed(3, rate))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
speeds = _pf_map2(lambda d, t: d / t, segments, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
side = math.sqrt(2.25)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums = [-2, -7, 8, 0, 29, 0, -14]
print(Stats_norm1(nums))
print(_pf_filter(functools.partial(Stats_between, -4, 24), nums))
print(Stats_mean(nums))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x7", "25"]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
print(_pf_str_rev(str.upper("hal")))
