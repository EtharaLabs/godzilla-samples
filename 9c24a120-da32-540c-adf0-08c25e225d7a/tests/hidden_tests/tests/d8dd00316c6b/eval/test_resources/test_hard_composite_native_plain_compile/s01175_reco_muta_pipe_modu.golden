from dataclasses import dataclass
import functools
import itertools
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
tickets = [Ticket(100, "dee", 111, False, Place("Lima", 2)), Ticket(101, "dee", 156, False, Place("Kyiv", 1)), Ticket(102, "pam", 250, False, Place("Bern", 3)), Ticket(103, "dee", 235, False, Place("Doha", 3)), Ticket(104, "dee", 278, True, Place("Baku", 2))]
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn0, (0, 0), tickets)
print(f"{nrec} records, {amt} total")
def _pf_fn1(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Ticket(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Place("Hub", 1))
    else:
        return o
rerouted = _pf_map(_pf_fn1, tickets)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
hits = 0
def note(x):
    global hits
    hits = hits + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([45, -11, 19, -2, 54, 37]))
doubled = _pf_map(note, [45, -11, 19, -2])
print(f"{doubled} after {hits} calls")
values = [-8, 19, 35, -3, 20, 33]
def offset(k, x):
    return x + k
def accept(n):
    return n > 3 and n % 5 != 0
outcome = len(_pf_sort(_pf_drop_while(lambda x: x < 5, _pf_take(6, (lambda _pf_x: _pf_map(sum, _pf_chunk(2, _pf_x)))(_pf_drop(3, _pf_map(lambda x: (-x if x < 0 else x * 4), values)))))))
print(outcome)
print(len(values))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_between(lo, hi, x):
    return lo <= x <= hi
nums = [7, 6, 29, -9, 11]
print(_pf_map(functools.partial(Text_clamp, 0, 20), nums))
print(Text_norm1(nums))
print(_pf_filter(functools.partial(Text_between, 1, 20), nums))
