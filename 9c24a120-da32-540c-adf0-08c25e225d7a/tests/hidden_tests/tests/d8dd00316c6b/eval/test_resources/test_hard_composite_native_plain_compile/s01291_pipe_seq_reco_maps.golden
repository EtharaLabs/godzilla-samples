from dataclasses import dataclass
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
