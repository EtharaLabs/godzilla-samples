from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: str
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
def show(t):
    match t:
        case Store(n0):
            return f"store({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Turn(n0, s1):
            return f"turn({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Store(x0):
            return x0
        case Rest(x0):
            return x0
        case _:
            return 0
queue = [Rest(-1), Store(11), Turn(12, "jo"), Rest(8), Store(10)]
print(_pf_str_join(" ", _pf_map(show, queue)))
grandSum = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print(_pf_max_by(score, queue))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums = [30, 11, -5, 3, -14, 19, 29]
print(Stats_scaleAll(3, nums))
print(_pf_filter(functools.partial(Stats_between, 3, 10), nums))
print(Stats_norm1(nums))
print(Stats_mean(nums))
