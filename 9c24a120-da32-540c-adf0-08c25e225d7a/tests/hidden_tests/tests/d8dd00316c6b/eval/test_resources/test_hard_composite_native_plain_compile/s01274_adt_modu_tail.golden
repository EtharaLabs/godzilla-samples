from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
_Halt = Halt()
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
_Jump = Jump()
def render(t):
    match t:
        case Push(n0):
            return f"push({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Store(1):
            return "store-1"
        case Store(n0):
            return f"store({n0})"
        case Halt() | Jump():
            return "halt/jump"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Jump():
            return 3
        case Halt():
            return 9
        case Push(x0):
            return x0
        case Store(x0):
            return x0 * 4
        case _:
            return 3
queue = [Mark(1), _Jump, _Jump, _Jump, Store(9)]
print(_pf_str_join(" ", _pf_map(render, queue)))
tally = _pf_sum_by(rank, queue)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: rank(t) > 3, queue)))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [15, -3, -12, 19, -9, 6, -8]
print(Geo_scaleAll(2, obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 10), obs))
print(Geo_norm1(obs))
print(Geo_mean(obs))
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(66425))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [25, 2, 23, 7, 15]))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(266, 174))
