from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [6, 39, 39, -2, 15, 12, -4]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("110100") + int("37", base=8))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(7))
print(_pf_str_rev(str.upper("jo")))
def safe(s):
    try:
        _pf_t1 = Ok(int(s))
    except Exception as _pf_t2:
        _pf_t1 = Error(_Exception(type(_pf_t2).__name__, str(_pf_t2)))
    if isinstance(_pf_t1, Ok):
        n = _pf_t1._0
        return f"ok {n}"
    else:
        e = _pf_t1._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x7", "44"]))
def discount(price, qty):
    return price * qty - 3 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("cap", 28, 1), ("wick", 29, 5)]))
print(grand)
def _pf_fn1():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
    yield 186
evens = _pf_fn1()
print(list(filter(lambda n: n % 2 == 0, evens)))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 709, fib)))
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_between(lo, hi, x):
    return lo <= x <= hi
obs = [17, -11, -1, -8, -11, -2, 4]
print(_pf_map(functools.partial(Stats_clamp, 0, 15), obs))
print(Stats_mean(obs))
print(_pf_filter(functools.partial(Stats_between, -1, 22), obs))
