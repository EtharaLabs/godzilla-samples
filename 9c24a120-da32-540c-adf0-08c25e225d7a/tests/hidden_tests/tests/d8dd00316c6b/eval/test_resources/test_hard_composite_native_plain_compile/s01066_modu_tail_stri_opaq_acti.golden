from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split(sep, s):
    return s.split(sep)
def Stats_square(x):
    return x * x
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
obs = [17, 28, 2, 7]
print(_pf_map(Stats_square, obs))
print(_pf_filter(functools.partial(Stats_between, -4, 21), obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 19), obs))
print(Stats_norm1(obs))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(402, 188))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [26, 11, 2, 21, 12]))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(2, 13, 1))
sentence = "ada,fay,dee,ray,quin,hub,bo"
words = _pf_str_split(",", sentence)
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
def row2(_pf_arg0):
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(10, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(words)))
print(_pf_map(lambda w: (w, len(w)), words))
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("u", 3)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
def _ap_Above(n):
    if n > 28:
        return Some(n - 28)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [-3, 6, 22, 30, 25, 34, 39]))
