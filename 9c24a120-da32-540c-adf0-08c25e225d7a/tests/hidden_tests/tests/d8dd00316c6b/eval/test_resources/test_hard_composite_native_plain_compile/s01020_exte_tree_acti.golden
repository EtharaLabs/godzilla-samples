from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [10, 4, 5, 2]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
print(_pf_str_rev(str.upper("lu")))
print(_pf_map(math.isqrt, [31, 71, 157, 315]))
env = dict([("x", 3), ("y", 8)])
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Neg(Neg(Var("x"))), Add(Num(0), Mul(Add(Num(1), Num(9)), Var("x")))]
_pf_iter(print, _pf_map(pretty, terms))
print(_pf_map(evaluate, terms))
def _ap_Above(n):
    if n > 8:
        return Some(n - 8)
    else:
        return _None_
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [15, 39, 28, 1, 30]))
