from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def net(price, qty):
    return price * qty - 2 * qty
def emit(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("gear", 28, 5), ("wick", 33, 3), ("gear", 42, 4), ("nut", 49, 3)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(10)([1, 2, 3]))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
obs = [-12, -9, 4, 28, 1, 21, 0]
print(Calc_norm1(obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 9), obs))
print(Calc_scaleAll(5, obs))
print(_pf_filter(functools.partial(Calc_between, -4, 13), obs))
def _pf_fn1():
    for x in _pf_range(1, 8):
        y = x * x
        yield y
squares = _pf_fn1()
print(list(filter(lambda n: n % 2 == 0, squares)))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 5)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 52, fib)))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
print(_pf_str_rev(str.upper("tom")))
book = [Parcel(100, "quin", 106, False, Site("Rome", 2)), Parcel(101, "lu", 140, False, Site("Bern", 2)), Parcel(102, "lu", 270, True, Site("Riga", 4)), Parcel(103, "jo", 134, True, Site("Bern", 1)), Parcel(104, "jo", 25, False, Site("Baku", 2))]
print(_pf_max_by(lambda o: o.amount, book))
rushSum = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(rushSum)
def _pf_fn3(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn3, (0, 0), book)
print(f"{cnt} records, {sumAmt} total")
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by_desc(lambda o: o.amount, book))))
def classify(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 99:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 99:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, book))
print(_pf_count_by(classify, book))
