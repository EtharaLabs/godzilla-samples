def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x6", "0"]))
book = [Invoice(100, "sue", 99, False, Place("Oslo", 4)), Invoice(101, "sue", 226, False, Place("Lima", 1)), Invoice(102, "sue", 242, False, Place("Oslo", 3)), Invoice(103, "kit", 49, True, Place("Baku", 3)), Invoice(104, "kit", 189, True, Place("Bern", 2))]
