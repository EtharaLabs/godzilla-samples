print(_pf_max_by(lambda o: o.amount, book))
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([18, 24, 40, -11, 54, 34]))
doubled = _pf_map(track, [18, 24, 40, -11])
print(f"{doubled} after {hits} calls")
def margin(price, qty):
    return price * qty - 8 * qty
def announce(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("cap", 25, 1), ("gear", 27, 1), ("nut", 22, 6)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(19)([1, 2, 3]))
