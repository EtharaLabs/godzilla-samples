from dataclasses import dataclass
import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def show(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({show(a)} + {show(b)})"
        case Mul(a, b):
            return f"{show(a)} * {show(b)}"
        case Neg(a):
            return f"-{show(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
def simplify(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(simplify(a), simplify(b))
            case Mul(a, b):
                return Mul(simplify(a), simplify(b))
            case _:
                return e
exprs = [Add(Mul(Mul(Num(3), Num(-2)), Neg(Num(1))), Neg(Neg(Num(7)))), Mul(Mul(Add(Num(-1), Num(6)), Add(Num(8), Num(5))), Num(5))]
_pf_iter(print, _pf_map(show, _pf_map(simplify, exprs)))
print(_pf_map(evaluate, exprs))
laps = [483.5, 326.0, 293.3, 438.7, 470.0]
times = [83.8, 25.7, 71.3, 22.9, 55.4]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = dist / dur
print(_pf_fmt_fixed(2, pace))
speeds = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
mass = 7.0
accel = 5.5
push = mass * accel
limit = 228.0
print("over" if push > limit else "under")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
edge = math.sqrt(9.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
hits = 0
def note(x):
    global hits
    hits = hits + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([43, -5, 52, 42, 12, -15]))
doubled = _pf_map(note, [43, -5, 52, 42])
print(f"{doubled} after {hits} calls")
