def show(t):
    match t:
        case Mark(n0) if n0 % 2 == 0:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Rest(0, _):
            return "rest-0"
        case Rest(n0, n1):
            return f"rest({n0},{n1})"
        case Push(s0, n1):
            return f"push({s0},{n1})"
        case Drop(2, _):
            return "drop-2"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Mark(x0):
            return x0 * 4
        case Drop(x0, x1):
            return x0 + x1 * 2
        case _:
            return 0
