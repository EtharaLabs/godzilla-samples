from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_map_values(m):
    return list(m.values())
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_fn0():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
    yield 144
evens = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, evens))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 7)))))
visits = ["eli", "eli", "cy", "fay", "cy", "eli", "fay"]
m = dict()
for w in visits:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
hist = m
def _pf_fn1(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn1, _pf_map_to_list(hist)))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, hist))))
extra = dict([("zed", 5), ("eli", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, hist))))
def discount(price, qty):
    return price * qty - 4 * qty
def emit(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn2(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall = sum(_pf_map(_pf_fn2, [("cog", 25, 4), ("bolt", 19, 1)]))
print(overall)
def _ap_Above(n):
    if n > 26:
        return Some(n - 26)
    else:
        return _None_
def bucketOf(n):
    _pf_t1 = _ap_Above(n)
    if isinstance(_pf_t1, Some):
        d = _pf_t1._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [34, 32, 6, 1, 21, 4]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
def fromBin(s):
    return int(s, base=2)
print(fromBin("110000") + int("130", base=8))
print(_pf_str_rev(str.upper("jo")))
samples = [18, 32, 6, -3, 15, 46, 2, 0, -6, 13]
answer = _pf_list_find(lambda x: x % 2 == 1, _pf_map(lambda x: x * x - 3, _pf_drop_while(lambda x: x < -2, _pf_sort_by(lambda x: x % 3, _pf_filter(lambda x: x % 2 == 0, samples)))))
print(answer)
print(len(samples))
