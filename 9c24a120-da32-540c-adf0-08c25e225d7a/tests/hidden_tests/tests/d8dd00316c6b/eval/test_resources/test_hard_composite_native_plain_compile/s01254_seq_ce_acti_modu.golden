from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def _pf_fn0():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
    yield 189
series = _pf_fn0()
print(list(_pf_seq_take(3, map(lambda n: n + 1, series))))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1121, fib)))
def readPair(line):
    def _pf_fn2():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t1, Some):
            v = _pf_t1._0
            _pf_t0 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some(n * 2)
            else:
                return _pf_t0
        else:
            return _pf_t1
    return _pf_fn2()
entries = ["sue = 9", "lu = 0", "eli", "oz=0=1", "dee = 9", "hal = 0"]
parsed = _pf_map(readPair, entries)
_pf_iter(print, parsed)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), parsed)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), parsed))))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 8:
        return Some(n - 8)
    else:
        return _None_
def kindOf(n):
    _pf_t2 = _ap_Above(n)
    _pf_t3 = _ap_Even_Odd(n)
    if isinstance(_pf_t2, Some):
        d = _pf_t2._0
        return f"above by {d}"
    elif isinstance(_pf_t3, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [1, 3, 21, 15, 33, 0, 2]))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
nums = [27, -15, -10, -12, 18]
print(_pf_filter(functools.partial(Calc_between, 2, 25), nums))
print(Calc_norm1(nums))
print(_pf_map(functools.partial(Calc_clamp, 0, 10), nums))
