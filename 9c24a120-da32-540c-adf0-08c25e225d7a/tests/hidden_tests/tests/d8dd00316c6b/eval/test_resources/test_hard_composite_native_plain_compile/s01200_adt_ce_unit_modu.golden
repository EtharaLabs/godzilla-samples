def describe(t):
    match t:
        case Halt(n0):
            return f"halt({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Pop():
            return f"pop"
        case Store(s0):
            return f"store({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
