def _ap_Above(n):
    if n > 7:
        return Some(n - 7)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def classify(n):
    _pf_t2 = _ap_Above(n)
    if isinstance(_pf_t2, Some):
        d = _pf_t2._0
