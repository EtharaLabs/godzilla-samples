from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([60, -1, 58, 18, -17]))
doubled = _pf_map(track, [60, -1, 58, 18])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
def margin(price, qty):
    return price * qty - 5 * qty
def report(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("nut", 50, 4), ("rod", 14, 6), ("cog", 43, 6)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(10)([1, 2, 3]))
tickets = [Parcel(100, "gus", 156, True, Place("Riga", 1)), Parcel(101, "ray", 178, False, Place("Lima", 2)), Parcel(102, "ray", 110, False, Place("Lima", 2)), Parcel(103, "ray", 211, False, Place("Lima", 4))]
cheap, dear = _pf_partition(lambda o: o.amount < 60, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def label(_pf_arg0):
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(label, tickets)))
def surcharge(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Parcel(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 17), tickets)))
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by_desc(lambda o: o.amount, tickets))))
segments = [350.9, 286.9, 155.9, 25.1]
times = [80.2, 79.0, 37.3, 76.7]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = dist / elapsed
print(_pf_fmt_fixed(3, pace))
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn1, _pf_zip(segments, times))
print(best)
