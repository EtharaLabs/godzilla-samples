def render(t):
    match t:
        case Store(n0) if n0 > 3:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case Pop(n0, s1):
            return f"pop({n0},{s1})"
        case Push(s0):
            return f"push({s0})"
        case Halt(s0, n1):
            return f"halt({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Store(x0):
            return x0
        case Pop(x0, _):
            return x0 * 4
        case Halt(_, x1):
            return x1
        case _:
            return 3
