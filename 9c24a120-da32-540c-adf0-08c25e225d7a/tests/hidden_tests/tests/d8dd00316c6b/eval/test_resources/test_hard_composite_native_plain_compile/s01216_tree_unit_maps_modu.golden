from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_intersect(a, b):
    return a.intersection(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Neg(Mul(Num(1), Neg(Num(1)))), Num(5)]
_pf_iter(print, _pf_map(pretty, exprs))
print(_pf_map(evaluate, exprs))
legs = [63.6, 342.6, 434.0, 333.6, 249.6]
durations = [26.4, 31.2, 76.8, 39.1, 75.5]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace = dist / dur
print(_pf_fmt_fixed(2, pace))
speeds = _pf_map2(lambda d, t: d / t, legs, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
log = ["eli", "cy", "dee", "ada", "dee", "bo", "cy", "cy", "fay"]
m = dict()
for w in log:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
freq = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(freq)))
sa = set([1, 4, 5, 9, 12, 17])
sb = set([1, 2, 9, 14, 15, 18])
print(_pf_sort(list(_pf_set_intersect(sa, sb))))
print((len(sa), 17 in sb, _pf_set_is_subset(set([1]), sa)))
print(len(_pf_map_filter(lambda k, v: v > 1, freq)))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
obs = [-2, 24, 28, -11, -4, -9]
print(Calc_scaleAll(4, obs))
print(_pf_filter(functools.partial(Calc_between, -5, 20), obs))
print(Calc_norm1(obs))
