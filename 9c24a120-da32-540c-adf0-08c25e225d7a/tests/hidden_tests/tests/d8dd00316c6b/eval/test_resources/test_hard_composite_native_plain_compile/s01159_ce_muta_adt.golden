_Pop = Pop()
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
def parseEntry(line):
    def _pf_fn0():
        match _pf_str_split("=", line):
            case [_k, _v]:
                _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
            case _:
                _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t1 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t1, Ok):
                n = _pf_t1._0
                return Ok((k, n))
            else:
                return _pf_t1
        else:
            return _pf_t0
    return _pf_fn0()
inputs = ["ned = 4", "bo = 7", "hal", "eli=89", "cy=5=1", "lu = 6"]
results = _pf_map(parseEntry, inputs)
_pf_iter(print, results)
errs = len(_pf_filter(_pf_result_is_error, results))
print(f"{errs} errors")
def combine(xs):
    def _pf_fn2(acc, r):
        def _pf_fn3():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
                    return r
            else:
                return acc
        return _pf_fn3()
    return _pf_fold(_pf_fn2, Ok(0), xs)
print(_pf_result_map_error(_pf_str_upper, combine(results)))
ticks = 0
def note(x):
    global ticks
    ticks = ticks + 1
    return x * 4
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
