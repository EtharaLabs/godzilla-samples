def explain(t):
    match t:
        case Jump(n0):
            return f"jump({n0})"
        case Pop():
            return f"pop"
        case Turn(n0) if n0 > 4:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Pop():
            return 2
        case _:
            return 1
batch = [_Pop, _Pop, Turn(-1), _Pop, _Pop]
print(_pf_map(explain, batch))
tally = _pf_sum_by(weight, batch)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: weight(t) > 4, batch)))
