from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
calls = 0
def track(x):
    global calls
    calls = calls + 1
    return x * 2
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([41, 33, 45, 29, 36, 27, -13]))
doubled = _pf_map(track, [41, 33, 45, 29])
print(f"{doubled} after {calls} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), calls))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [28, -4, 30, 1, 15, 39]))
def safe(s):
    try:
        _pf_t1 = Ok(int(s))
    except Exception as _pf_t2:
        _pf_t1 = Error(_Exception(type(_pf_t2).__name__, str(_pf_t2)))
    if isinstance(_pf_t1, Ok):
        n = _pf_t1._0
        return f"ok {n}"
    else:
        e = _pf_t1._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x2", "-7"]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
print(_pf_str_rev(str.upper("oz")))
print(_pf_map(math.isqrt, [125, 124, 36, 45]))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_square(x):
    return x * x
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs = [-4, -11, 25, -15, -1, 9]
print(_pf_filter(functools.partial(Geo_between, -1, 21), obs))
print(_pf_map(Geo_square, obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 15), obs))
def rawOf(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("sku", 2)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("acc-1"))
