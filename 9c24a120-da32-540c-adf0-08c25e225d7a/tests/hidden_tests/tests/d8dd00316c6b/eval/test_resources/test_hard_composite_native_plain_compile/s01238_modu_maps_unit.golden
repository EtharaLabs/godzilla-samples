from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_map_values(m):
    return list(m.values())
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_between(lo, hi, x):
    return lo <= x <= hi
pts = [3, -3, 12, 3, 11]
print(_pf_map(functools.partial(Text_clamp, 0, 15), pts))
print(_pf_map(Text_square, pts))
print(Text_norm1(pts))
print(_pf_filter(functools.partial(Text_between, 1, 17), pts))
visits = ["eli", "bo", "eli", "fay", "ada", "ada", "eli", "eli"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in visits:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
extra = dict([("zed", 5), ("eli", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, counts))))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, counts))))
legs = [336.9, 400.8, 88.6, 54.7]
splits = [49.2, 26.3, 11.0, 6.3]
total = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = total / elapsed
print(_pf_fmt_fixed(3, pace))
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn1, _pf_zip(legs, splits))
print(best)
side = math.sqrt(2.25)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
