import functools
import math
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
nums = [0, -8, -6, 6, 28, 24]
print(Calc_mean(nums))
print(_pf_filter(functools.partial(Calc_between, 4, 23), nums))
print(_pf_map(functools.partial(Calc_clamp, 0, 9), nums))
print(_pf_str_rev(str.upper("gus")))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1001111") + int("47", base=8))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [12, 9, 10, 2]))
events = ["eli", "ada", "cy", "fay", "ada", "eli", "fay", "bo", "bo"]
m = dict()
for w in events:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
hist = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(hist)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, hist))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(hist))))
values = [-8, 33, 41, 13, 12, 32, 34]
def keep(n):
    return n > 10 and n % 2 != 0
digest = _pf_sum_by(lambda x: x * x, _pf_sort_desc(_pf_filter(lambda x: x % 4 == 1, _pf_rev(_pf_collect(lambda x: [x, x + 1], _pf_take(4, _pf_distinct(values)))))))
print(digest)
print(len(values))
def net(price, qty):
    return price * qty - 6 * qty
def report(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn1, [("bolt", 36, 4), ("gear", 7, 2), ("tap", 14, 4), ("gear", 29, 3)]))
