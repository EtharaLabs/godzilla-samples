from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
_Halt = Halt()
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 4
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([60, 37, 49, 0, 9, 20]))
doubled = _pf_map(record, [60, 37, 49, 0])
print(f"{doubled} after {hits} calls")
def margin(price, qty):
    return price * qty - 3 * qty
def announce(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("cog", 7, 2), ("nut", 32, 1), ("rod", 19, 1), ("hub", 42, 1)]))
print(overall)
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("u", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
def render(t):
    match t:
        case Jump(s0):
            return f"jump({s0})"
        case Emit(n0) if n0 % 2 == 0:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Halt():
            return f"halt"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Emit(x0):
            return x0
        case Halt():
            return 6
        case _:
            return 0
prog = [Emit(7), Emit(1), Emit(1), Jump("pam"), _Halt, Jump("gus"), Emit(6)]
print(_pf_str_join(" ", _pf_map(render, prog)))
tally = _pf_sum_by(weight, prog)
print(f"tally={tally}")
print((_pf_head(prog), _pf_last(prog)))
