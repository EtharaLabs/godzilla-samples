from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_set_union(a, b):
    return a.union(b)
ticks = 0
def note(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([1, 20, 17, 2, 43, 60, 19, -20]))
doubled = _pf_map(note, [1, 20, 17, 2])
print(f"{doubled} after {ticks} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), ticks))
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(80493))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(436, 137))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(2, 8, 1))
def _ap_Above(n):
    if n > 21:
        return Some(n - 21)
    else:
        return _None_
def classify(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [33, -3, 15, 11, 18]))
log = ["bo", "eli", "bo", "bo", "bo", "dee", "fay", "cy", "dee"]
m = dict()
for w in log:
    _pf_t1 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t1
hist = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(hist)))
print(len(_pf_map_filter(lambda k, v: v > 1, hist)))
sa = set([5, 10, 12, 13, 16, 18])
sb = set([3, 8, 10, 11, 13, 16])
print(_pf_sort(list(_pf_set_union(sa, sb))))
print((len(sa), 2 in sb, _pf_set_is_subset(set([5]), sa)))
print((_pf_map_try_find("cy", hist), "cy" in hist))
