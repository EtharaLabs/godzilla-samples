from dataclasses import dataclass
from functools import total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: str
    def __repr__(self):
        return f"Drop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: str
    def __repr__(self):
        return f"Rest({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    def __repr__(self):
        return f"Pop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
def show(t):
    match t:
        case Drop(s0):
            return f"drop({s0})"
        case Rest(s0):
            return f"rest({s0})"
        case Pop(s0):
            return f"pop({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Rest(_):
            return 5
        case _:
            return 1
prog = [Pop("fay"), Rest("ivy"), Pop("jo"), Pop("hal"), Pop("lu")]
print(_pf_str_join("; ", _pf_map(show, prog)))
tally = _pf_sum_by(weight, prog)
print(f"tally={tally}")
print(_pf_sort(prog))
readings = [1, 41, 42, -8, 0, 35]
def addK(k, x):
    return x + k
def keep(n):
    return n > 9 and n % 4 != 0
answer = len(_pf_sort_by(lambda x: -x, _pf_rev(_pf_collect(lambda x: [x, x + 1], _pf_distinct_by(lambda x: x % 3, _pf_choose(lambda x: (Some(x // 4) if x % 4 == 0 else _None_), _pf_sort(readings)))))))
print(answer)
def _ap_Above(n):
    if n > 13:
        return Some(n - 13)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(kindOf, [33, -1, -5, 35, 8]))
