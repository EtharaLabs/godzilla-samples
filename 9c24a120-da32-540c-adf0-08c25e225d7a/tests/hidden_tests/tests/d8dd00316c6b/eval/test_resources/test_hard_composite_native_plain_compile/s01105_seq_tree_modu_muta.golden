from dataclasses import dataclass
import functools
import itertools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def _pf_fn0():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
evens = _pf_fn0()
print(list(_pf_seq_take(3, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Mul(Add(Num(1), Neg(Num(1))), Add(Neg(Num(5)), Num(3))), Neg(Neg(Neg(Num(-1)))), Neg(Add(Neg(Num(-2)), Mul(Num(7), Num(-1))))]
_pf_iter(print, _pf_map(pretty, terms))
print(_pf_map(evalE, terms))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_square(x):
    return x * x
pts = [17, 10, 22, 28]
print(Geo_mean(pts))
print(_pf_filter(functools.partial(Geo_between, -4, 11), pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 11), pts))
print(_pf_map(Geo_square, pts))
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([53, 34, 25, -19]))
doubled = _pf_map(record, [53, 34, 25, -19])
print(f"{doubled} after {hits} calls")
