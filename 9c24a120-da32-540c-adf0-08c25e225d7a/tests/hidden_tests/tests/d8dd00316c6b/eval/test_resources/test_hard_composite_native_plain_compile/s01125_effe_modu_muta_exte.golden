from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
def discount(price, qty):
    return price * qty - 6 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("nut", 45, 5), ("gear", 45, 1), ("rod", 50, 3)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(9)([1, 2, 3]))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
nums = [9, 9, 1, 7, 30, 2, 14]
print(Geo_mean(nums))
print(_pf_map(functools.partial(Geo_clamp, 0, 12), nums))
print(Geo_scaleAll(3, nums))
print(Geo_norm1(nums))
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-11, 12, -10, 7]))
doubled = _pf_map(note, [-11, 12, -10, 7])
print(f"{doubled} after {calls} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), calls))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x4", "36"]))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [4, 8, 8, 2]))
print(_pf_str_rev(str.upper("hal")))
