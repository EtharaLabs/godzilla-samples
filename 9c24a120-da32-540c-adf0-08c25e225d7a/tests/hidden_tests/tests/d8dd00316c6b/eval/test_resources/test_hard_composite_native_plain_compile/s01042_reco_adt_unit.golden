elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate = total2 / elapsed
print(_pf_fmt_fixed(1, rate))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total2, elapsed) * 1000.0))
km = total2 / 1000.0
print(_pf_fmt_fixed(1, km))
def _pf_fn3(_pf_arg0):
    d, t = _pf_arg0
    return d / t
