from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
book = [Ticket(100, "jo", 258, True, Site("Riga", 2)), Ticket(101, "jo", 206, False, Site("Kyiv", 3)), Ticket(102, "jo", 209, False, Site("Oslo", 4)), Ticket(103, "jo", 80, True, Site("Baku", 4)), Ticket(104, "jo", 180, True, Site("Rome", 4))]
def adjust(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 2), book)))
print(_pf_max_by(lambda o: o.amount, book))
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t3 = o
        return Ticket(_pf_t3.id, _pf_t3.owner, _pf_t3.amount, _pf_t3.urgent, Site("Hub", 1))
    else:
        return o
moved = _pf_map(_pf_fn0, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
cheap, dear = _pf_partition(lambda o: o.amount < 83, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def classify(o):
    match o:
        case Ticket(urgent=True, amount=amount) if amount > 183:
            return "rush-big"
        case Ticket(urgent=True):
            return "rush"
        case Ticket(amount=amount):
            if amount > 183:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, book))
print(_pf_count_by(classify, book))
def _pf_fn1():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
series = _pf_fn1()
print(list(filter(lambda n: n % 4 == 0, series)))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1744, fib)))
def rawOf(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("acc", 4)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("u-1"))
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([28, 8, 7, -19, 51]))
doubled = _pf_map(record, [28, 8, 7, -19])
print(f"{doubled} after {hits} calls")
