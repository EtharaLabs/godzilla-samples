def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 29:
        return Some(n - 29)
    else:
        return _None_
def bucketOf(n):
    _pf_t2 = _ap_Above(n)
    _pf_t3 = _ap_Even_Odd(n)
    if isinstance(_pf_t2, Some):
        d = _pf_t2._0
        return f"above by {d}"
    elif isinstance(_pf_t3, _Even):
        return "even"
    else:
