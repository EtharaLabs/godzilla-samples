def show(t):
    match t:
        case Mark(n0):
            return f"mark({n0})"
        case Halt(n0, n1) if n0 % 2 == 0:
            return f"halt!({n0},{n1})"
        case Halt(n0, n1):
            return f"halt({n0},{n1})"
        case Skip(n0):
            return f"skip({n0})"
        case Push(s0, n1):
            return f"push({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Mark(x0):
            return x0
        case Push(_, x1):
            return x1
        case Skip(x0):
            return x0
        case _:
            return 1
