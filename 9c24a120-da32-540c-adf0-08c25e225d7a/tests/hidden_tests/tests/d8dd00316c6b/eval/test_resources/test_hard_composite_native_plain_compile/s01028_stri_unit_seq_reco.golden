from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
sentence = "ivy nut pin cog"
words = _pf_str_split(" ", sentence)
print(_pf_str_replace("u", "U", sentence))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
print(_pf_str_slice(1, 4, sentence))
print((_pf_str_index_of("pi", sentence), "pi" in sentence))
print(_pf_map(lambda w: (w, len(w)), words))
laps = [11.5, 458.5, 355.9, 52.3, 156.5]
splits = [32.9, 22.2, 23.5, 6.8, 9.6]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = total / dur
print(_pf_fmt_fixed(1, speed))
edge = math.sqrt(16.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
mass = 55.0
accel = 2.5
push = mass * accel
limit = 323.0
print("over" if push > limit else "under")
def _pf_fn0():
    for x in _pf_range(1, 7):
        y = x * x
        yield y
series = _pf_fn0()
print(list(filter(lambda n: n % 2 == 0, series)))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 612, fib)))
tickets = [Parcel(100, "kit", 86, False), Parcel(101, "ada", 51, True), Parcel(102, "kit", 133, True), Parcel(103, "eli", 82, False), Parcel(104, "eli", 11, True)]
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by_desc(lambda o: o.amount, tickets))))
print(_pf_max_by(lambda o: o.amount, tickets))
rushSum = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(rushSum)
