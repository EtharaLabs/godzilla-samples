from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_result_map_error(f, r):
    if isinstance(r, Error):
        return Error(f(r._0))
    return r
def _pf_result_to_option(r):
    if isinstance(r, Ok):
        return Some(r._0)
    return _None_
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
def _pf_id(x):
    return x
def _pf_snd(p):
