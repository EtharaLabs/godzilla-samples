print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
tickets = [Booking(100, "hal", 249, False, Place("Lima", 2)), Booking(101, "hal", 55, True, Place("Riga", 2)), Booking(102, "jo", 146, True, Place("Oslo", 2)), Booking(103, "jo", 213, True, Place("Riga", 1)), Booking(104, "bo", 122, True, Place("Doha", 4))]
