def explain(t):
    match t:
        case Push(n0):
            return f"push({n0})"
        case Store(n0) if 0 <= n0 < 5:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case Skip(3, _):
            return "skip-3"
        case Skip(n0, s1):
            return f"skip({n0},{s1})"
        case Rest(n0):
            return f"rest({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Store(x0):
            return x0
        case Push(x0):
            return x0
        case Skip(x0, _):
            return x0
        case _:
            return 0
