print(_pf_filter(functools.partial(Stats_between, -3, 12), pts))
print(_pf_map(functools.partial(Stats_clamp, 0, 10), pts))
print(_pf_map(Stats_square, pts))
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("acc", 4)
