freq = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(freq)))
print(len(_pf_map_filter(lambda k, v: v > 1, freq)))
print((_pf_map_try_find("ada", freq), "ada" in freq))
sa = set([2, 3, 5, 10, 16, 18])
sb = set([1, 2, 5, 10, 11, 13])
print(_pf_sort(list(_pf_set_intersect(sa, sb))))
print((len(sa), 15 in sb, _pf_set_is_subset(set([2]), sa)))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_square(x):
    return x * x
pts = [-13, -6, 17, 28, -9]
