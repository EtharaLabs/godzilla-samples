            raise ValueError("expected a string, got " + type(_pf_t5).__name__)
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t6 = _pf_t4["points"]
        if not (isinstance(_pf_t6, int) and not isinstance(_pf_t6, bool)):
            raise ValueError("expected an int, got " + type(_pf_t6).__name__)
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t7 = _pf_t4["active"]
        if not isinstance(_pf_t7, bool):
