ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
