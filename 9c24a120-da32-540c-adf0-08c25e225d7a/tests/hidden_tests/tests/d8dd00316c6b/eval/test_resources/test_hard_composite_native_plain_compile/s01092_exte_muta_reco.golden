from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
print(_pf_str_rev(str.upper("ned")))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1000111") + int("10", base=8))
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 3
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([19, -1, -6, 25, -13, -5, 32]))
doubled = _pf_map(note, [19, -1, -6, 25])
print(f"{doubled} after {calls} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), calls))
book = [Parcel(100, "pam", 233, True, Addr("Rome", 2)), Parcel(101, "gus", 174, False, Addr("Lima", 2)), Parcel(102, "gus", 23, True, Addr("Riga", 1)), Parcel(103, "gus", 174, False, Addr("Bern", 1)), Parcel(104, "pam", 190, False, Addr("Kyiv", 4)), Parcel(105, "gus", 14, False, Addr("Doha", 1))]
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, book))
print(byOwner)
def surcharge(o):
    if o.urgent:
        _pf_t0 = o
        return Parcel(_pf_t0.id, _pf_t0.owner, o.amount + 1, _pf_t0.urgent, _pf_t0.dest)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(surcharge, book)))
def classify(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 172:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 172:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, book))
print(_pf_count_by(classify, book))
