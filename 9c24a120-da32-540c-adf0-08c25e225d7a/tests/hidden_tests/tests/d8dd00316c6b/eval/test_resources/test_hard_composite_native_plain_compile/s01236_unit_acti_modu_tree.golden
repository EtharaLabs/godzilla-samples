from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
segments = [352.7, 196.9, 338.3, 442.3, 306.3]
times = [77.3, 63.8, 41.2, 85.7, 12.2]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = total / dur
print(_pf_fmt_fixed(3, rate))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(segments, times))
print(best)
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
speeds = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
mass = 28.0
accel = 7.5
push = mass * accel
limit = 272.0
print("over" if push > limit else "under")
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [-2, -3, 31, 40, 8, -6]))
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_square(x):
    return x * x
pts = [-1, 0, 28, 23, -14, 29]
print(_pf_map(functools.partial(Stats_clamp, 0, 16), pts))
print(Stats_norm1(pts))
print(_pf_map(Stats_square, pts))
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Num(-1), Add(Mul(Add(Num(3), Num(8)), Mul(Num(-2), Num(9))), Num(2)), Mul(Num(8), Num(5))]
_pf_iter(print, _pf_map(pretty, exprs))
print(_pf_map(evalE, exprs))
