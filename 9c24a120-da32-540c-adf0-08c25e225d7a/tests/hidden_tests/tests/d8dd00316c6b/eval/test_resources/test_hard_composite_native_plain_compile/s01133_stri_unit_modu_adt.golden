def render(t):
    match t:
        case Rest(n0) if n0 % 2 == 0:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Turn(2):
            return "turn-2"
        case Turn(n0):
            return f"turn({n0})"
        case Store(n0) if n0 > 0:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case Mark(n0) if n0 % 2 == 0:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Skip():
            return f"skip"
        case _:
            raise RuntimeError("non-exhaustive match")
