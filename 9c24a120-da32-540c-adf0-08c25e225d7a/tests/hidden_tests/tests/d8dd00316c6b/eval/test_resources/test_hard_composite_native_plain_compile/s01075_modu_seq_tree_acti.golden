from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts = [-5, 25, -12, 25, 29, 24]
print(Geo_norm1(pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 7), pts))
print(_pf_filter(functools.partial(Geo_between, 5, 25), pts))
print(Geo_mean(pts))
def _pf_fn0():
    for x in _pf_range(1, 8):
        y = x * x
        yield y
    yield 162
series = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, series))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(lambda acc, x: add(x, acc), _Leaf, [4, 33, 45, 1, 21])
def minOf(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minOf(root))
def sumOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumOf(l) + v + sumOf(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumOf(root))
def containsT(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsT(k, root), [4, 22, 47]))
def _ap_Above(n):
    if n > 11:
        return Some(n - 11)
    else:
        return _None_
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [17, 8, 27, 14, 10, 13]))
