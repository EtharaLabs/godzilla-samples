from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
values = [21, -6, 26, 1, 3, 23, 0, 20]
def _pf_fn7(_pf_x):
    def _pf_fn11(_pf_x):
        def _pf_fn13(_pf_x):
            def _pf_fn14(_pf_arg0):
                i, x = _pf_arg0
                return i * x
            return _pf_map(_pf_fn14, _pf_indexed(_pf_x))
        return _pf_fn13((lambda _pf_x: _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), _pf_filter(lambda x: x > 6, _pf_x)))(_pf_x))
    return _pf_sort(_pf_fn11(_pf_x))
process = _pf_fn7
outcome = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(process(values))
print(outcome)
sentence = "eli,gear,jo,nut,sue"
words = _pf_str_split(",", sentence)
print(_pf_str_replace("i", "I", sentence))
print(_pf_str_slice(2, 9, sentence))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
print(_pf_map(lambda w: (w, len(w)), words))
legs = [433.8, 378.8, 449.6]
splits = [44.7, 82.2, 49.1]
total = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = total / elapsed
print(_pf_fmt_fixed(2, rate))
side = math.sqrt(2.25)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
mass = 37.0
accel = 4.5
push = mass * accel
limit = 271.0
