from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
tickets = [Parcel(100, "dee", 212, True, Addr("Baku", 4)), Parcel(101, "jo", 145, False, Addr("Lima", 3)), Parcel(102, "lu", 13, False, Addr("Baku", 4)), Parcel(103, "jo", 188, False, Addr("Lima", 4)), Parcel(104, "lu", 130, False, Addr("Oslo", 4))]
cheap, dear = _pf_partition(lambda o: o.amount < 75, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
print(_pf_max_by(lambda o: o.amount, tickets))
def label(_pf_arg0):
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(label, tickets)))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(1218, 0))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(461, 55))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(2, 7, 1))
legs = [54.5, 187.3, 308.4]
times = [64.4, 63.8, 73.0]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = total / elapsed
print(_pf_fmt_fixed(2, pace))
mass = 56.0
accel = 6.5
push = mass * accel
limit = 208.0
print("over" if push > limit else "under")
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1010110") + int("67", base=8))
raw = "tap;dee;hub;bo;lu;pam"
tokens = _pf_str_split(";", raw)
