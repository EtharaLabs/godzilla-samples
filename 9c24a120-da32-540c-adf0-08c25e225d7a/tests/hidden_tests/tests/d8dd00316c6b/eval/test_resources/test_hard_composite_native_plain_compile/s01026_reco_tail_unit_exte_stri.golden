    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(9, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(tokens)))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), tokens))
print(_pf_option_with_default("?", longest))
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", "40,x,,40,"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
