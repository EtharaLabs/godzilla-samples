                n = _pf_t0._0
                return Some(n * 4)
            else:
                return _pf_t0
        else:
            return _pf_t1
    return _pf_fn0()
entries = ["lu=x", "cy=8=1", "quin", "eli=42", "jo=78", "tom = 2"]
parsed = _pf_map(parseEntry, entries)
_pf_iter(print, parsed)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), parsed)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), parsed))))
raw = "pin;eli;wick;kit"
parts = _pf_str_split(";", raw)
def row2(_pf_arg0):
