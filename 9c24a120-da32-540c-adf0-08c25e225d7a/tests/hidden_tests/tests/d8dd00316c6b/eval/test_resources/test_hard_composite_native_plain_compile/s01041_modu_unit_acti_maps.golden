from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_square(x):
    return x * x
nums = [-15, -15, -4, 23, 27, -9]
print(Stats_scaleAll(2, nums))
print(Stats_norm1(nums))
print(Stats_mean(nums))
print(_pf_map(Stats_square, nums))
legs = [331.6, 287.0, 381.0, 410.4, 37.7]
times = [28.7, 25.0, 34.0, 41.8, 46.3]
total = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = total / elapsed
print(_pf_fmt_fixed(3, pace))
mass = 78.0
accel = 9.5
push = mass * accel
limit = 338.0
print("over" if push > limit else "under")
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(legs, times))
print(best)
edge = math.sqrt(4.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [26, 37, 1, 12, 6, 18, 4]))
visits = ["fay", "fay", "ada", "bo", "eli", "cy", "dee"]
m = dict()
for w in visits:
    _pf_t1 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t1
freq = m
def _pf_fn1(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn1, _pf_map_to_list(freq)))
print((_pf_map_try_find("dee", freq), "dee" in freq))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, freq))))
