from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
def _ap_Above(n):
    if n > 24:
        return Some(n - 24)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def classify(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [25, 12, -4, -5, 16]))
segments = [272.3, 254.1, 136.5, 19.6]
durations = [72.1, 28.6, 32.1, 78.3]
total = _pf_fold(lambda a, b: a + b, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed = total / elapsed
print(_pf_fmt_fixed(1, speed))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
sentence = "rod bolt cap bo"
words = _pf_str_split(" ", sentence)
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", "12,7,40,-3,40"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
count = len(words)
print(f"count={count} {{braces}} {len(sentence)}")
print(_pf_str_replace("e", "E", sentence))
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-10, 59, 38, 22]))
doubled = _pf_map(track, [-10, 59, 38, 22])
print(f"{doubled} after {ticks} calls")
