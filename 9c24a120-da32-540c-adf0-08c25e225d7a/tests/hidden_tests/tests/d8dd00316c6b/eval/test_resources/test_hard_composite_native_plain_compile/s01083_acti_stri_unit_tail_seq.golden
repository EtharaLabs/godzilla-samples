from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def bucketOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(bucketOf, [17, 17, -1, 4, 34]))
sentence = "eli bolt pin hal cy dee"
tokens = _pf_str_split(" ", sentence)
print(_pf_map(lambda w: (w, len(w)), tokens))
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", ",x,12,,7"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
def cell(_pf_arg0):
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(8, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(tokens)))
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
legs = [174.8, 41.3, 307.1, 266.2, 199.7]
splits = [25.8, 15.5, 86.9, 11.2, 30.8]
total = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = total / elapsed
print(_pf_fmt_fixed(3, pace))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(legs, splits))
print(best)
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(592, 0))
def euclid(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(56, 412))
def _pf_fn1():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
    yield 128
squares = _pf_fn1()
print(list(_pf_seq_take(4, map(lambda n: n + 1, squares))))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1043, fib)))
