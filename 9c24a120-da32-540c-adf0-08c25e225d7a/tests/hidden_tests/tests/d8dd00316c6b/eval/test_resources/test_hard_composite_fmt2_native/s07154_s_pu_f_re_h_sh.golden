from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Panel"
    bottom: "Panel"
    slot: int
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
boxes: list[Panel] = [Panel(4, 8, "cap"), Panel(4, 7, "cog"), Panel(3, 3, "bolt"), Panel(3, 6, "wick"), Panel(4, 4, "sq")]
def rename(prefix: str, b: Panel) -> Panel:
    label = b.label
    _pf_t1 = b
    return Panel(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "old-"), boxes)))
def stackOf(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def surface(_pf_arg0: Panel) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, boxes)))
board: list[Score] = [Score("bo", 19, 0.65), Score("tom", 22, 0.71), Score("oz", 94, 0.09)]
def line3(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_str_upper(_pf_str_slice(0, 2, who))} | pts={pts} | {"pass" if pts >= 33 else "fail"} | {_pf_fmt_pad_right(6, ".", who)}"
_pf_iter(print, _pf_map(line3, board))
print(f"best: {_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, board)))}")
def outer(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([9, 0, 9]))
def bump2(n: int) -> int:
    return n + 96
def applyLift(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 4
    return applyLift(bump2)
sample: int = _pf_fn0()
print((sample, applyLift(1)))
def merge(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t2 = _pair
    else:
        _pf_t2 = 2
    r = _pf_t2
    return pair(r, 1)
print((merge(Some(4)), merge(_None_)))
