def size(s: Form) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
