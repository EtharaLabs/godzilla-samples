from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Signup:
    user: str
    age: int
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
def Check_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Check_return_(x):
    return Ok(x)
def parseForm(user: str, age: str) -> Ok | Error:
    return Check_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Check_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Check_bind(Ok(years) if years >= 18 else Error("too young"), lambda adult: Check_return_(Signup(name, adult)))))
print(parseForm("jo", "58"))
print((parseForm("a", "30"), parseForm("bob", "x")))
scores: list[Score] = [Score("eli", 90, 0.03), Score("oz", 20, 0.31), Score("kit", 67, 0.75), Score("hal", 55, 0.96), Score("max", 38, 0.94)]
def line3(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"pts={pts} | {{{pts}}} | {_pf_str_upper(_pf_str_slice(0, 2, who))}"
_pf_iter(print, _pf_map(line3, scores))
print(f"best: {_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, scores)))}")
def audit(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(audit([18, 33, 6, 1, 10]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "tom", "stop"])
print((events, counts))
