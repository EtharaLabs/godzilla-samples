from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Append | Noop
@dataclass(frozen=True, slots=True)
class Form:
    user: str
    age: int
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def replay(script: list[Op]) -> dict[str, int]:
    def step(m: dict[str, int], op: Op) -> dict[str, int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        elif isinstance(op, Append):
            n = op._0
            return _pf_map_add("pushed", n, m)
        else:
            return m
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Append(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
ops: list[Op] = [Append(5), Put("cog", 3), Put("gear", 4), Append(4), Put("bolt", 6), Append(8), Put("nut", 8)]
final: dict[str, int] = replay(ops)
print(_pf_map_to_list(final))
def Check_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Check_return_(x):
    return Ok(x)
def parseForm(user: str, age: str) -> Ok | Error:
    return Check_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Check_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Check_bind(Ok(years) if years >= 19 else Error("too young"), lambda adult: Check_return_(Form(name, adult)))))
print(parseForm("fay", "42"))
print((parseForm("a", "30"), parseForm("bob", "x")))
scores: list[Mark] = [Mark("oz", 15, 0.83), Mark("kit", 83, 0.84), Mark("eli", 12, 0.4), Mark("dee", 90, 0.21), Mark("gus", 15, 0.35)]
def line3(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{{{pts}}} | {_pf_fmt_pad_right(6, ".", who)} | pts={pts}"
_pf_iter(print, _pf_map(line3, scores))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, scores))}")
def _ap_KeyVal(s):
    _pf_t1 = _pf_str_split("=", s)
    if len(_pf_t1) == 2:
        k = _pf_t1[0]
        v = _pf_t1[1]
        _pf_t2 = _pf_str_to_int(v)
        if isinstance(_pf_t2, Some):
            n = _pf_t2._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def describe(s: str) -> str:
    _pf_t3 = _ap_KeyVal(s)
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        if _pf_snd(pair) > 9:
            return f"{_pf_fst(pair)} big"
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        return f"{_pf_fst(pair)}={_pf_snd(pair)}"
    return "?"
_pf_iter(print, _pf_map(describe, ["lu=x", "eli=30", "tom", "oz=x"]))
