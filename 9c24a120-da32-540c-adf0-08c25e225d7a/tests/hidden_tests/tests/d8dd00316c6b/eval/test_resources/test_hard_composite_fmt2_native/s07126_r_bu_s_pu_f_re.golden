from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
def Maybe_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Maybe_return_(x):
    return Some(x)
def ratio2(a: str, b: str) -> Some | None_:
    return Maybe_bind(_pf_str_to_int(a), lambda x: Maybe_bind(_pf_str_to_int(b), lambda y: Maybe_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Maybe_return_(shown))(q * 1))))
print((ratio2("89", "2"), ratio2("4", "0"), ratio2("x", "1")))
tiles: list[Tile] = [Tile(6, 6, "bolt"), Tile(2, 6, "wick"), Tile(1, 2, "cog"), Tile(6, 8, "wick"), Tile(8, 8, "tap"), Tile(4, 4, "sq")]
def caption(b: Tile) -> str:
    if isinstance(b, Tile):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Tile) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, tiles)))
def rename(prefix: str, b: Tile) -> Tile:
    label = b.label
    _pf_t1 = b
    return Tile(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), tiles)))
def stretch(b: Tile) -> Tile:
    w = b.w
    h = b.h
    _pf_t3 = b
    return Tile(w + 2, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, tiles)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, tiles)))
marks: list[Result2] = [Result2("ada", 39, 0.22), Result2("sue", 88, 0.34), Result2("fay", 40, 0.39)]
def fmtRow(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{f"<{pts}>"}: {_pf_fmt_percent(1, ratio)}: {_pf_str_join("/", [who, str(pts)])}: {_pf_fmt_pad_left(5, " ", str(pts * 6))}"
_pf_iter(print, _pf_map(fmtRow, marks))
print(f"{len(marks)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", marks))}")
