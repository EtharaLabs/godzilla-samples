from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Append | Noop
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([32, 6, 32, 37]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "ivy", "stop"])
print((logged, counts))
scores: list[Score] = [Score("ivy", 12, 0.8), Score("cy", 37, 0.9), Score("quin", 19, 0.17)]
def fmtRow(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{"pass" if pts >= 60 else "fail"},{_pf_fmt_percent(1, ratio)},{_pf_str_upper(_pf_str_slice(0, 2, who))},{{{pts}}},{f"<{pts}>"}"
_pf_iter(print, _pf_map(fmtRow, scores))
print(f"{len(scores)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", scores))}")
def execute(script: list[Op]) -> tuple[int, int]:
    def step(acc: tuple[int, int], op: Op) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Append):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(step, (0, 0), script)
script: list[Op] = [Put("cog", 8), Append(1), _Noop, Append(2), Append(2), Append(7)]
outcome: tuple[int, int] = execute(script)
print(outcome)
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [9, 3, 8, 8])
print(acc)
