print(_pf_map(_pf_fn1, _pf_filter(_pf_fn2, panels)))
def describe(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, panels)))
def relabel(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t3 = b
    return Box(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
