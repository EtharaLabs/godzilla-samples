def fmtRow(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_pad_right(6, ".", who)} | {_pf_str_upper(_pf_str_slice(0, 2, who))} | {{{pts}}} | {f"<{pts}>"}"
