members: list[Pilot] = [Pilot("hal", 7), Pilot("max", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def Writer_bind(m, f):
    v = m[0]
    log = m[1]
    _pf_t2 = f(v)
    w = _pf_t2[0]
    log2 = _pf_t2[1]
    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def trace2(x: int) -> tuple[int, list[str]]:
    return Writer_bind(tell(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(tell(f"z={z}"), lambda _: Writer_return_(z)))(y + 3)))
print(_pf_map(trace2, [7, 8]))
