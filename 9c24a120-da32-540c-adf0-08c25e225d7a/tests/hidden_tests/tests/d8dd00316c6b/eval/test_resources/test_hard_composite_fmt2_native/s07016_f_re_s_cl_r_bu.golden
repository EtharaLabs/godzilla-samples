from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
board: list[Result2] = [Result2("ada", 68, 0.93), Result2("tom", 55, 0.73), Result2("jo", 90, 0.01)]
def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{{{pts}}}: {_pf_fmt_pad_right(6, ".", who)}: {"pass" if pts >= 64 else "fail"}: {_pf_str_join("/", [who, str(pts)])}: {f"<{pts}>"}"
_pf_iter(print, _pf_map(line3, board))
print(f"best: {_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, board)))}")
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 5
        return n
    return next_
tick = ticker(4)
print((tick(None), tick(None), tick(None)))
def stamp(xs) -> tuple[list[str], int]:
    i = 0
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(stamp(["tom", "hal", "sue"]))
def Perhaps_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Perhaps_return_(x):
    return Some(x)
def safeDiv(a: str, b: str) -> Some | None_:
    return Perhaps_bind(_pf_str_to_int(a), lambda x: Perhaps_bind(_pf_str_to_int(b), lambda y: Perhaps_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Perhaps_return_(shown))(q * 4))))
print((safeDiv("48", "4"), safeDiv("4", "0"), safeDiv("x", "1")))
