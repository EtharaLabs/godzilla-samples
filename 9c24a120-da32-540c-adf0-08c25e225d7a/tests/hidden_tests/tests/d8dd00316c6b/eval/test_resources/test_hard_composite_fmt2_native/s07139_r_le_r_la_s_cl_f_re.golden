from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
def ping(n: int, acc: int) -> int:
    if n <= 0:
        return acc
    else:
        return stepB(n - 1, acc + 1)
def stepB(n: int, acc: int) -> int:
    if n <= 0:
        return acc
    else:
        return pang(n - 2, acc * 2)
def pang(n: int, acc: int) -> int:
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
print(_pf_map(lambda n: ping(n, 1), [8, 7, 13, 9]))
inputs2: list[int] = [14, -7, 8, 25, 17]
gain: int = 2
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(8), makers2))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(inputs2), inputs2))
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), inputs2))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 1
        return n
    return next_
tick = ticker(0)
print((tick(None), tick(None), tick(None)))
def numbered(xs) -> tuple[list[str], int]:
    i = 0
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["cy", "fay", "oz"]))
scores: list[Score] = [Score("fay", 72, 0.22), Score("kit", 66, 0.47), Score("cy", 1, 0.74), Score("lu", 75, 0.14)]
def line3(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"pts={pts}: {f"<{pts}>"}: {{{pts}}}: {_pf_fmt_pad_right(6, ".", who)}"
_pf_iter(print, _pf_map(line3, scores))
print(f"best: {_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, scores)))}")
