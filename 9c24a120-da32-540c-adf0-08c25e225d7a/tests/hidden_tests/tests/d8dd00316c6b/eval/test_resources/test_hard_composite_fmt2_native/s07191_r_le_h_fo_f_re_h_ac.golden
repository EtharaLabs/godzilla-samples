def fmtRow(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"pts={pts}: {_pf_str_join("/", [who, str(pts)])}: {_pf_fmt_pad_left(5, " ", str(pts * 9))}: {{{pts}}}"
_pf_iter(print, _pf_map(fmtRow, marks))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, marks))}")
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 0:
        return _Low()
    elif scaled < 29:
        return _Mid()
    else:
        return _High()
def label(n: int) -> str:
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
        return "mid"
    if isinstance(_pf_t0, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(label, [15, 22, 10, 20, 28]))
