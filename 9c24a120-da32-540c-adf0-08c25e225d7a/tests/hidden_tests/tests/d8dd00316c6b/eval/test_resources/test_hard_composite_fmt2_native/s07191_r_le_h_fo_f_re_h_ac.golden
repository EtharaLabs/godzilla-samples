def value(env: dict[str, int], e: Ex) -> int:
    while True:
        if isinstance(e, Lit):
            n = e._0
            return n
        elif isinstance(e, Ref):
            v = e._0
            return _pf_map_find_or(v, 0, env)
        elif isinstance(e, Plus):
            a = e._0
            b = e._1
            return value(env, a) + value(env, b)
        else:
            body = e._0
            last = e._1
            env, e = (_pf_fold(runSt, env, body), last)
            continue
def runSt(env: dict[str, int], s: St) -> dict[str, int]:
    if isinstance(s, Set):
        v = s._0
        e = s._1
        return _pf_map_add(v, value(env, e), env)
    else:
        e = s._0
        return _pf_map_add("shown", value(env, e), env)
print(value(dict(), Block([Set("a", Lit(1)), Set("b", Plus(Ref("a"), Lit(6))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
def replay(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    def apply(acc, op):
        return acc
    def apply(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Append):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script: list[Change] = [Put("cog", 5), Put("cog", 4), Put("gear", 7), Append(9), Put("cog", 8), Put("bolt", 1)]
state: tuple[dict[str, int], list[int]] = replay(script)
mm, items = state
print((_pf_map_to_list(mm), items))
sumSq: int = _pf_fold(lambda apply, x: apply + x * x, 0, [6, 1, 8, 1])
print(sumSq)
