from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Lit:
    _0: int
    def __repr__(self):
        return f"Lit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ref:
    _0: str
    def __repr__(self):
        return f"Ref({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Plus:
    _0: "Val"
    _1: "Val"
    def __repr__(self):
        return f"Plus({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: "Val"
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
Val = Lit | Ref | Plus | Block
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: "Val"
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: "Val"
    def __repr__(self):
        return f"Show({self._0!r})"
St = Set | Show
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([32, 14, 17, 29, 23, 2]))
events: list[str] = []
def logEvent(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(logEvent, ["start", "max", "stop"])
print((events, counts))
def evalEx(env: dict[str, int], e: Val) -> int:
    while True:
        if isinstance(e, Lit):
            n = e._0
            return n
        elif isinstance(e, Ref):
            v = e._0
            return _pf_map_find_or(v, 0, env)
        elif isinstance(e, Plus):
            a = e._0
            b = e._1
            return evalEx(env, a) + evalEx(env, b)
        else:
            body = e._0
            last = e._1
            env, e = (_pf_fold(exec, env, body), last)
            continue
def exec(env: dict[str, int], s: St) -> dict[str, int]:
    if isinstance(s, Set):
        v = s._0
        e = s._1
        return _pf_map_add(v, evalEx(env, e), env)
    else:
        e = s._0
        return _pf_map_add("shown", evalEx(env, e), env)
print(evalEx(dict(), Block([Set("a", Lit(7)), Set("b", Plus(Ref("a"), Lit(6))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
boxes: list[Box] = [Box(3, 2, "nut"), Box(1, 6, "hub"), Box(1, 5, "cap"), Box(3, 7, "wick"), Box(4, 4, "sq")]
def area(_pf_arg0: Box) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, boxes)))
def describe(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, boxes)))
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), boxes)))
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
scores: list[Mark] = [Mark("ned", 98, 0.29), Mark("hal", 2, 0.31), Mark("bo", 59, 0.11), Mark("max", 85, 0.99)]
def line3(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_pad_right(6, ".", who)} {{{pts}}} {_pf_fmt_percent(1, ratio)}"
_pf_iter(print, _pf_map(line3, scores))
total: int = _pf_sum_by(lambda s: s.pts, scores)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores))} {"{"}done{"}"}")
