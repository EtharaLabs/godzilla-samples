print(_pf_map(shape2, nums2))
trail: list[str] = []
def logged(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [8, 2]))
print((out, trail))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([3, 5, 5, 7, -2, 0]))
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 6:
                _pf_t1 = t
                return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Seat] = _pf_map(promote, [Active(Person("eli", 30)), Active(Person("ned", 42)), _Gone])
