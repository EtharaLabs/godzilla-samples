from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Fig = Sq | Ci | Wedge
scores: list[Mark] = [Mark("sue", 22, 0.87), Mark("max", 56, 0.46), Mark("tom", 28, 0.67), Mark("pam", 30, 0.67), Mark("hal", 30, 0.56)]
def fmtRow(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_percent(1, ratio)} | {"pass" if pts >= 60 else "fail"} | {{{pts}}}"
_pf_iter(print, _pf_map(fmtRow, scores))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, scores))}")
journal: list[str] = []
def traced(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [8, 2]))
print((out, journal))
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 2
        return n
    return next_
clock = makeCounter(0)
print((clock(None), clock(None), clock(None)))
limit2: int = 41
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(6)), clip(Some(-3)), clip(_None_), limit2))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((3, 2)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 6)))
def extent(s: Fig) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(7), Ci(8), Wedge(5, 4), Wedge(1, 9)]))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 5
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(2, []), score(1, [9]), score(1, [5, 2, 3])))
