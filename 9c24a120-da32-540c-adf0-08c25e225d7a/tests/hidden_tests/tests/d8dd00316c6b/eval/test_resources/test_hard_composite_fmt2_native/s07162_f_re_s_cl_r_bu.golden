from dataclasses import dataclass
import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
marks: list[Score] = [Score("gus", 0, 0.75), Score("ada", 43, 0.34), Score("kit", 62, 0.62), Score("ray", 48, 0.29)]
def line3(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{"pass" if pts >= 38 else "fail"}: {f"<{pts}>"}: pts={pts}: {_pf_fmt_pad_left(5, " ", str(pts * 3))}: {_pf_str_upper(_pf_str_slice(0, 2, who))}"
_pf_iter(print, _pf_map(line3, marks))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, marks))}")
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 5
        return n
    return next_
clock = makeCounter(5)
print((clock(None), clock(None), clock(None)))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([3, 5, 6, -5]))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([7, 14, 11, 16, 19, 18]))
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 2], lambda k: Grid_yield_(a * b + k))
cells: list[int] = Grid_combine(Grid_for_([(5, 1), (1, 1)], _pf_fn0), Grid_delay(lambda _: Grid_yield_(1)))
print(cells)
