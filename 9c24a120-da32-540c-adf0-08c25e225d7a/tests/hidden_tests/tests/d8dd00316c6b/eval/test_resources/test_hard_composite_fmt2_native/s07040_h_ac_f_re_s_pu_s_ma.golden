def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((clip(Some(8)), clip(Some(-3)), clip(_None_), cap))
def extent(s: Fig) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(5), Disc(5), Wedge(6, 3), Wedge(1, 9)]))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((2, 0)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 7)))
