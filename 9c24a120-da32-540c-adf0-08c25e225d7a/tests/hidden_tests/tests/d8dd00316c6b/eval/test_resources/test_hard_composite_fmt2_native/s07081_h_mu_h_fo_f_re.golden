from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Instr = Put | Push | Skip
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([3, 12, 32]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "dee", "stop"])
print((events, counts))
def execute(script: list[Instr]) -> tuple[dict[str, int], list[int]]:
    def fold1(acc: tuple[dict[str, int], list[int]], op: Instr) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Push):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops: list[Instr] = [Put("bolt", 5), Put("cog", 5), Put("gear", 7), Put("gear", 4), Put("nut", 7)]
state: tuple[dict[str, int], list[int]] = execute(ops)
mm, items = state
print((_pf_map_to_list(mm), items))
sumSq: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [1, 1, 2, 4])
print(sumSq)
marks: list[Mark] = [Mark("oz", 66, 0.17), Mark("kit", 40, 0.44), Mark("cy", 41, 0.61), Mark("max", 48, 0.92), Mark("hal", 5, 0.48)]
def fmtRow(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_pad_left(5, " ", str(pts * 4))} {{{pts}}} {_pf_str_join("/", [who, str(pts)])} {f"<{pts}>"}"
_pf_iter(print, _pf_map(fmtRow, marks))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, marks))}")
