@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
Shape2 = Sq | Disc | Tri
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((6, 8)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 2)))
def extent(s: Shape2) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(3), Disc(9), Tri(3, 7), Tri(1, 9)]))
def dig(xs: list[int]) -> int:
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([8, 0]), dig([0, 9]), dig([])))
marks: list[Score] = [Score("sue", 43, 0.49), Score("lu", 5, 0.12), Score("ned", 6, 0.23), Score("ivy", 98, 0.39), Score("gus", 85, 0.93)]
