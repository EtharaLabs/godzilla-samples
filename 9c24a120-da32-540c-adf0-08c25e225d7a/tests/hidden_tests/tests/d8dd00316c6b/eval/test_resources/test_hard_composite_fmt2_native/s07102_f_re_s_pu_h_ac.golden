from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Panel"
    bottom: "Panel"
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
board: list[Result2] = [Result2("bo", 28, 0.66), Result2("ada", 96, 0.13), Result2("dee", 10, 0.53), Result2("hal", 48, 0.59)]
def fmtRow(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{{{pts}}},{f"<{pts}>"},{_pf_str_join("/", [who, str(pts)])},{_pf_fmt_percent(1, ratio)}"
_pf_iter(print, _pf_map(fmtRow, board))
print(f"{len(board)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", board))}")
panels: list[Panel] = [Panel(5, 6, "wick"), Panel(1, 4, "pin"), Panel(6, 1, "nut"), Panel(4, 4, "sq")]
def caption(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, panels)))
def rename(prefix: str, b: Panel) -> Panel:
    label = b.label
    _pf_t1 = b
    return Panel(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "new "), panels)))
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), panels, _pf_rev(panels)))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 3:
        return _Low()
    elif scaled < 39:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    _pf_t2 = _pf_str_split("=", s)
    if len(_pf_t2) == 2:
        k = _pf_t2[0]
        v = _pf_t2[1]
        _pf_t3 = _pf_str_to_int(v)
        if isinstance(_pf_t3, Some):
            n = _pf_t3._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def tier(n: int) -> str:
    _pf_t4 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t4, _Low):
        return "low"
    elif isinstance(_pf_t4, _Mid):
        return "mid"
    elif isinstance(_pf_t4, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def describe(s: str) -> str:
    _pf_t5 = _ap_KeyVal(s)
    if isinstance(_pf_t5, Some):
        pair = _pf_t5._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t5, Some):
        pair = _pf_t5._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(describe, ["ada=x", "cy", "fay", "gus"]))
