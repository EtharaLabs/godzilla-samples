from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
seriesA: list[int] = [16, 1, 6, 10, -6, 21]
factor: int = 2
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(seriesA))))
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(1), scalers))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(seriesA), seriesA))
marks: list[Result2] = [Result2("dee", 31, 0.61), Result2("tom", 15, 0.62), Result2("lu", 46, 0.39), Result2("bo", 33, 0.2)]
def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_pad_right(6, ".", who)} {_pf_fmt_percent(1, ratio)} pts={pts} {_pf_fmt_pad_left(5, " ", str(pts * 6))}"
_pf_iter(print, _pf_map(line3, marks))
total: int = _pf_sum_by(lambda s: s.pts, marks)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, marks))} {"{"}done{"}"}")
def female(n: int) -> int:
    if n == 0:
        return 1
    else:
        return n - mal(female(n - 1))
def mal(n: int) -> int:
    if n == 0:
        return 0
    else:
        return n - female(mal(n - 1))
print((_pf_map(female, _pf_range(0, 11)), _pf_map(mal, _pf_range(0, 6))))
