def extent(s: Fig) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Ci):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Sq(2), Ci(5), Wedge(7, 3), Wedge(1, 9)]))
def adjust(n: int) -> int:
    _pf_t0 = n % 3
    if _pf_t0 == 0:
        _n = n // 3
        return _n + 9
    else:
        k = _pf_t0
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(adjust, [5, 1, 23, 21]))
def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 5
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((weigh(8, []), weigh(1, [8]), weigh(1, [6, 2, 3])))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 2:
        return _Low()
    elif scaled < 30:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    _pf_t1 = _pf_str_split("=", s)
    if len(_pf_t1) == 2:
        k = _pf_t1[0]
        v = _pf_t1[1]
        _pf_t2 = _pf_str_to_int(v)
        if isinstance(_pf_t2, Some):
            n = _pf_t2._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def tier(n: int) -> str:
    _pf_t3 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t3, _Low):
        return "low"
    elif isinstance(_pf_t3, _Mid):
        return "mid"
    elif isinstance(_pf_t3, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def describe(s: str) -> str:
    _pf_t4 = _ap_KeyVal(s)
    if isinstance(_pf_t4, Some):
        pair = _pf_t4._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t4, Some):
        pair = _pf_t4._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
