def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{{{pts}}},pts={pts},{_pf_fmt_pad_left(5, " ", str(pts * 6))},{_pf_str_join("/", [who, str(pts)])},{"pass" if pts >= 67 else "fail"}"
_pf_iter(print, _pf_map(line3, scores))
