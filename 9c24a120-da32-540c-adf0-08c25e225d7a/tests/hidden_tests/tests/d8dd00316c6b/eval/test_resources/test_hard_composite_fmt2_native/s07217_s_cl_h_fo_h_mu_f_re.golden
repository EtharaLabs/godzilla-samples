from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Change = Put | Push | Noop
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def makeCounter(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 5
        return n
    return next_
clock = makeCounter(2)
print((clock(None), clock(None), clock(None)))
trail: list[str] = []
def traced(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out: list[int] = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [4, 6]))
print((out, trail))
def fold1(xs: list[int], op: Change) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Push):
            n = op._0
            if n > 0:
                return _pf_concat(xs, [n * 10])
        return xs
def replay(script: list[Change]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 0:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
script: list[Change] = [Push(1), _Noop, Push(4), _Noop, Push(0)]
state: list[int] = replay(script)
print(state)
def scan(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(scan([35, 4, 31, 9, 10, 26]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "ray", "stop"])
print((logged, counts))
scores: list[Mark] = [Mark("gus", 21, 0.66), Mark("max", 50, 0.11), Mark("ned", 96, 0.72)]
def line3(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{f"<{pts}>"},{_pf_str_join("/", [who, str(pts)])},pts={pts},{_pf_fmt_pad_right(6, ".", who)},{_pf_str_upper(_pf_str_slice(0, 2, who))}"
_pf_iter(print, _pf_map(line3, scores))
print(f"{len(scores)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", scores))}")
