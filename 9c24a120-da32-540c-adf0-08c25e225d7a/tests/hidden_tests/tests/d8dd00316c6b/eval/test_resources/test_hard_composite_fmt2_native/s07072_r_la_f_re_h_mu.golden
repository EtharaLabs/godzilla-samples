from dataclasses import dataclass
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
nums2: list[int] = [-5, -8, 18, -5, 2, 10, 16, 5]
factor: int = 4
tweak2 = lambda _pf_x: (lambda z: z - 6)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, nums2))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(5), scalers))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(nums2), nums2))
marks: list[Mark] = [Mark("pam", 3, 0.24), Mark("jo", 40, 0.65), Mark("eli", 28, 0.64), Mark("ned", 42, 0.91), Mark("bo", 62, 0.92)]
def line3(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{"pass" if pts >= 57 else "fail"} | {_pf_fmt_percent(1, ratio)} | {{{pts}}}"
_pf_iter(print, _pf_map(line3, marks))
print(f"{len(marks)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", marks))}")
def audit(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(audit([32, 36, 14]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "quin", "stop"])
print((events, counts))
