@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: "Val"
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
Val = Lit | Ref | Plus | Block
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: "Val"
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: "Val"
    def __repr__(self):
