from dataclasses import dataclass
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def audit(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(audit([2, 30, 5, 5, 20, 39]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "gus", "stop"])
print((logged, counts))
marks: list[Mark] = [Mark("gus", 70, 0.67), Mark("lu", 85, 0.99), Mark("pam", 31, 0.49), Mark("oz", 23, 0.87)]
def line3(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_percent(1, ratio)}: {_pf_str_join("/", [who, str(pts)])}: {"pass" if pts >= 41 else "fail"}: {_pf_fmt_pad_left(5, " ", str(pts * 6))}: {{{pts}}}"
_pf_iter(print, _pf_map(line3, marks))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, marks))}")
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 3], lambda k: Grid_yield_(a * b + k))
combos: list[int] = Grid_combine(Grid_for_([(5, 4), (4, 4)], _pf_fn0), Grid_delay(lambda _: Grid_yield_(2)))
print(combos)
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 0:
        return _Low()
    elif scaled < 36:
        return _Mid()
    else:
        return _High()
def label(n: int) -> str:
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
        return "mid"
    if isinstance(_pf_t0, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(label, [-2, 13, 28, -3, 5]))
