from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
Form = Square | Disc | Tri
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Push | Noop
scores: list[Mark] = [Mark("jo", 61, 0.27), Mark("ivy", 88, 0.5), Mark("max", 89, 0.28), Mark("ada", 49, 0.65)]
def fmtRow(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_percent(1, ratio)},{_pf_str_join("/", [who, str(pts)])},{_pf_str_upper(_pf_str_slice(0, 2, who))},{_pf_fmt_pad_left(5, " ", str(pts * 5))}"
_pf_iter(print, _pf_map(fmtRow, scores))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, scores))}")
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 5
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(6, []), score(1, [9]), score(1, [6, 2, 3])))
def extent(s: Form) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Square(6), Disc(4), Tri(8, 9), Tri(1, 9)]))
def choose2(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((5, 1)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 9)))
cap: int = 39
def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _cap = o._0
        if _cap > 0:
            return _cap
    if isinstance(o, Some):
        return 0
    else:
        return cap
print((bound(Some(3)), bound(Some(-3)), bound(_None_), cap))
def apply(acc: tuple[dict[str, int], list[int]], op: Op) -> tuple[dict[str, int], list[int]]:
    m = acc[0]
    xs = acc[1]
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return (_pf_map_add(k, v, m), xs)
    elif isinstance(op, Push):
        n = op._0
        return (m, _pf_concat(xs, [n]))
    else:
        return acc
def execute(script: list[Op]) -> tuple[dict[str, int], list[int]]:
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops: list[Op] = [Put("nut", 3), _Noop, Push(0), Push(4)]
final: tuple[dict[str, int], list[int]] = execute(ops)
mm, items = final
print((_pf_map_to_list(mm), items))
acc: int = _pf_fold(lambda apply, x: apply + x * x, 0, [4, 8, 5, 2])
print(acc)
