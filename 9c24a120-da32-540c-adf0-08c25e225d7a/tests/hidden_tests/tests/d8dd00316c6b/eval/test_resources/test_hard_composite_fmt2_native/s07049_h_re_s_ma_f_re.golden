people: list[Pilot] = [Pilot("sue", 6), Pilot("jo", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 3
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(2, []), score(1, [6]), score(1, [6, 2, 3])))
def size(s: Shape2) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(size, [Square(5), Disc(9), Wedge(2, 7), Wedge(1, 9)]))
def settle(n: int) -> int:
    _pf_t2 = n % 3
    if _pf_t2 == 0:
        _n = n // 3
        return _n + 7
    else:
        k = _pf_t2
        _n2 = n * k
        _k = _n2 - 1
        return _k
print(_pf_map(settle, [11, 14, 25, 27]))
limit2: int = 42
def clip(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((clip(Some(6)), clip(Some(-3)), clip(_None_), limit2))
board: list[Result2] = [Result2("dee", 11, 0.51), Result2("jo", 80, 0.03), Result2("gus", 42, 0.96), Result2("sue", 57, 0.99), Result2("ned", 77, 0.49)]
def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{{{pts}}} {_pf_fmt_percent(1, ratio)} {_pf_fmt_pad_right(6, ".", who)} {"pass" if pts >= 60 else "fail"} pts={pts}"
_pf_iter(print, _pf_map(line3, board))
total: int = _pf_sum_by(lambda s: s.pts, board)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, board))} {"{"}done{"}"}")
