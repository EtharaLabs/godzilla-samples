from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Pilot"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: "Team"
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Seat = Active | Parked | Gone
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Shape2 = Square | Disc | Wedge
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Pilot(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 4:
                _pf_t1 = t
                return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Seat] = _pf_map(promote, [Active(Pilot("ivy", 35)), Active(Pilot("tom", 66)), Active(Pilot("kit", 58)), Parked(Team("hub", 9)), Parked(Team("rod", 9))])
