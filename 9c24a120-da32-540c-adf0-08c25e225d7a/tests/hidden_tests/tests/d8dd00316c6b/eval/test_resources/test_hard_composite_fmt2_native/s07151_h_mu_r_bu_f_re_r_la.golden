from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
def inspect(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(inspect([9, 9, 18, 22]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "fay", "stop"])
print((logged, counts))
def Maybe_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Maybe_return_(x):
    return Some(x)
def ratio2(a: str, b: str) -> Some | None_:
    return Maybe_bind(_pf_str_to_int(a), lambda x: Maybe_bind(_pf_str_to_int(b), lambda y: Maybe_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Maybe_return_(shown))(q * 1))))
print((ratio2("64", "6"), ratio2("4", "0"), ratio2("x", "1")))
board: list[Result2] = [Result2("quin", 50, 0.83), Result2("kit", 1, 0.14), Result2("cy", 90, 0.41), Result2("ada", 52, 0.9), Result2("ned", 26, 0.19)]
