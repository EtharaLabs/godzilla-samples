def reading(cs: list[str], n: int) -> int:
    while True:
        if len(cs) == 0:
            return n
        else:
            c = cs[0]
            rest = cs[1:len(cs)]
            if c == " ":
                return skipping(rest, n)
            else:
                cs, n = (rest, n)
                continue
def skipping(cs: list[str], n: int) -> int:
    while True:
        if len(cs) == 0:
            return n
        else:
            c = cs[0]
            rest = cs[1:len(cs)]
            if c == " ":
                cs, n = (rest, n)
                continue
            else:
                return reading(rest, n + 1)
