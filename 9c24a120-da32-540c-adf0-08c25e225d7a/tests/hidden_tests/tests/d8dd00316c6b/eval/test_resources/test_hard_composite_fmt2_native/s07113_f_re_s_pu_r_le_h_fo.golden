from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Tile"
    bottom: "Tile"
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Instr = Put | Push | Noop
board: list[Score] = [Score("lu", 29, 0.55), Score("kit", 76, 0.54), Score("ray", 72, 0.71)]
def fmtRow(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{"pass" if pts >= 54 else "fail"} | {_pf_fmt_percent(1, ratio)} | pts={pts} | {_pf_str_join("/", [who, str(pts)])}"
_pf_iter(print, _pf_map(fmtRow, board))
print(f"best: {_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, board)))}")
boxes: list[Tile] = [Tile(5, 3, "cog"), Tile(1, 5, "hub"), Tile(9, 3, "gear"), Tile(4, 9, "hub"), Tile(4, 4, "sq")]
def stackOf(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Tile):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def grow(b: Tile) -> Tile:
    w = b.w
    h = b.h
    _pf_t1 = b
    return Tile(w + 2, h * 2, _pf_t1.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, boxes)))
def relabel(prefix: str, b: Tile) -> Tile:
    label = b.label
    _pf_t3 = b
    return Tile(_pf_t3.w, _pf_t3.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "x-"), boxes)))
def describe(b: Tile) -> str:
    if isinstance(b, Tile):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Tile) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, boxes)))
def inWord(cs: list[str], n: int) -> int:
    while True:
        if len(cs) == 0:
            return n
        else:
            c = cs[0]
            rest = cs[1:len(cs)]
            if c == " ":
                return skipping(rest, n)
            else:
                cs, n = (rest, n)
                continue
def skipping(cs: list[str], n: int) -> int:
    while True:
        if len(cs) == 0:
            return n
        else:
            c = cs[0]
            rest = cs[1:len(cs)]
            if c == " ":
                cs, n = (rest, n)
                continue
            else:
                return inWord(rest, n + 1)
print(skipping(list("  eli hal quin "), 0))
def step(m: dict[str, int], op: Instr) -> dict[str, int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
    elif isinstance(op, Push):
        n = op._0
        return _pf_map_add("pushed", n, m)
    else:
        return m
def replay(script: list[Instr]) -> dict[str, int]:
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t4 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t4
            case Push(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
ops: list[Instr] = [Push(5), _Noop, _Noop, Push(3), _Noop]
outcome: dict[str, int] = replay(ops)
print(_pf_map_to_list(outcome))
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [4, 9, 3, 8])
print(acc)
