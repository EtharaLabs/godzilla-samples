from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Instr = Put | Append | Noop
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
def step(acc: tuple[dict[str, int], list[int]], op: Instr) -> tuple[dict[str, int], list[int]]:
    m = acc[0]
    xs = acc[1]
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return (_pf_map_add(k, v, m), xs)
    elif isinstance(op, Append):
        n = op._0
        return (m, _pf_concat(xs, [n]))
    else:
        return acc
def runAll(script: list[Instr]) -> tuple[dict[str, int], list[int]]:
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script: list[Instr] = [_Noop, Append(2), Put("nut", 3), Put("gear", 5), Put("gear", 3), Put("bolt", 7), Append(2)]
final: tuple[dict[str, int], list[int]] = runAll(script)
mm, items = final
print((_pf_map_to_list(mm), items))
def female(n: int) -> int:
    if n == 0:
        return 1
    else:
        return n - mal(female(n - 1))
def mal(n: int) -> int:
    if n == 0:
        return 0
    else:
        return n - female(mal(n - 1))
print((_pf_map(female, _pf_range(0, 11)), _pf_map(mal, _pf_range(0, 9))))
def inc(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def both(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: step2(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [7, 4, 4]))
def merge(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 3
    r = _pf_t0
    return pair(r, 3)
print((merge(Some(8)), merge(_None_)))
def wrap(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([7, 1, 9]))
scores: list[Score] = [Score("ada", 88, 0.66), Score("sue", 65, 0.11), Score("lu", 72, 0.54)]
def fmtRow(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{{{pts}}},{_pf_fmt_pad_left(5, " ", str(pts * 6))},{_pf_str_join("/", [who, str(pts)])}"
_pf_iter(print, _pf_map(fmtRow, scores))
total: int = _pf_sum_by(lambda s: s.pts, scores)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores))} {"{"}done{"}"}")
