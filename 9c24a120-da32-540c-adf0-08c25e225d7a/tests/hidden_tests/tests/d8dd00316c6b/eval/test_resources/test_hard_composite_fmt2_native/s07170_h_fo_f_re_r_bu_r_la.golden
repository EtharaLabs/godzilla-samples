def line3(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_percent(1, ratio)},{"pass" if pts >= 45 else "fail"},pts={pts},{f"<{pts}>"}"
_pf_iter(print, _pf_map(line3, scores))
print(f"{_pf_str_upper("report")}\n{_pf_str_join("\n", _pf_map(lambda s: s.who, scores))}")
def Check_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Check_return_(x):
    return Ok(x)
def readForm(user: str, age: str) -> Ok | Error:
    return Check_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Check_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Check_bind(Ok(years) if years >= 20 else Error("too young"), lambda adult: Check_return_(Form(name, adult)))))
print(readForm("ray", "37"))
print((readForm("a", "30"), readForm("bob", "x")))
