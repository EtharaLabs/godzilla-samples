def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_str_join("/", [who, str(pts)])} pts={pts} {_pf_fmt_percent(1, ratio)} {_pf_str_upper(_pf_str_slice(0, 2, who))}"
_pf_iter(print, _pf_map(line3, marks))
