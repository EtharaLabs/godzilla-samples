    label = b.label
    _pf_t1 = b
    return Panel(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "new "), tiles)))
def promote(s: Status) -> Status:
    if isinstance(s, Active):
        p = s._0
        _pf_t2 = p
        return Active(Pilot(_pf_t2.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 2:
                _pf_t3 = t
                return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
