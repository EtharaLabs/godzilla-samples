    ratio: float
tiles: list[Panel] = [Panel(4, 4, "pin"), Panel(4, 4, "wick"), Panel(8, 2, "gear"), Panel(4, 4, "cap"), Panel(4, 4, "sq")]
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
