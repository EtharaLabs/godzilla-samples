def weigh(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 3
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
