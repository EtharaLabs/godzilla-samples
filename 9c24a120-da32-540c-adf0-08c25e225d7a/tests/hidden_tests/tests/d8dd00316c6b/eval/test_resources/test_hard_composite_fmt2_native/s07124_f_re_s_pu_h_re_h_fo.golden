def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, boxes)))
def stackOf(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Tile):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
def promote(s: Slot) -> Slot:
    if isinstance(s, Active):
        p = s._0
        _pf_t4 = p
        return Active(Pilot(_pf_t4.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 6:
                _pf_t5 = t
                return Parked(Club(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Slot] = _pf_map(promote, [Parked(Club("rod", 1)), Parked(Club("wick", 1)), Parked(Club("wick", 9)), _Gone])
print(roster)
members: list[Pilot] = [Pilot("gus", 1), Pilot("max", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def runAll(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    def step(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Push):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops: list[Change] = [Put("bolt", 9), _Skip, _Skip, _Skip, Put("gear", 6), Put("nut", 8), _Skip]
outcome: tuple[dict[str, int], list[int]] = runAll(ops)
mm, items = outcome
print((_pf_map_to_list(mm), items))
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [5, 2, 9, 9])
