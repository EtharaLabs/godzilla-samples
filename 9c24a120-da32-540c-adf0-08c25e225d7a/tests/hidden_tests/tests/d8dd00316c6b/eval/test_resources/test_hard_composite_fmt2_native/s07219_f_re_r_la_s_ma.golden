from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Score:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: int
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Disc:
    _0: int
    def __repr__(self):
        return f"Disc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
Fig = Square | Disc | Wedge
scores: list[Score] = [Score("bo", 76, 0.99), Score("pam", 96, 0.72), Score("cy", 9, 0.73), Score("quin", 37, 0.96), Score("tom", 93, 0.59)]
def line3(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_percent(1, ratio)}: pts={pts}: {_pf_str_upper(_pf_str_slice(0, 2, who))}: {_pf_fmt_pad_left(5, " ", str(pts * 3))}"
_pf_iter(print, _pf_map(line3, scores))
print(f"{len(scores)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", scores))}")
seriesA: list[int] = [6, 9, 14, 30, 29, 15, 27, 9]
gain: int = 5
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn0, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(6), makers2))
def extent(s: Fig) -> int:
    if isinstance(s, Square):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Wedge):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
print(_pf_map(extent, [Square(8), Disc(9), Wedge(1, 6), Wedge(1, 9)]))
limit2: int = 25
def bound(o: Some | None_) -> int:
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(1)), bound(Some(-3)), bound(_None_), limit2))
def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((0, 2)), 0), pick(Some((1, 5)), 0), pick(_None_, 4)))
def score(x: int, items: list[int]) -> int:
    if len(items) == 0:
        return x
    elif len(items) == 1:
        _x = items[0]
        return _x * 2
    else:
        _x2 = items[0]
        rest = items[1:len(items)]
        return _x2 + len(rest)
print((score(3, []), score(1, [8]), score(1, [3, 2, 3])))
