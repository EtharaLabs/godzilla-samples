from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Push | Noop
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Box"
    bottom: "Box"
    slot: int
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
def execute(script: list[Op]) -> dict[str, int]:
    def fold1(m: dict[str, int], op: Op) -> dict[str, int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        elif isinstance(op, Push):
            n = op._0
            return _pf_map_add("pushed", n, m)
        else:
            return m
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
changes: list[Op] = [Push(2), Put("cog", 6), _Noop, Push(4), Push(8), _Noop]
final: dict[str, int] = execute(changes)
print(_pf_map_to_list(final))
sumSq: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [4, 5, 1, 1])
print(sumSq)
tiles: list[Box] = [Box(2, 2, "cog"), Box(1, 7, "cog"), Box(5, 7, "wick"), Box(4, 4, "sq")]
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def rename(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t2 = b
    return Box(_pf_t2.w, _pf_t2.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "old-"), tiles)))
def describe(b: Box) -> str:
    if isinstance(b, Box):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Box) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([3, 3, 10]))
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 2
        return n
    return next_
clock = ticker(3)
print((clock(None), clock(None), clock(None)))
board: list[Mark] = [Mark("bo", 23, 0.55), Mark("fay", 32, 0.24), Mark("oz", 41, 0.2), Mark("gus", 90, 0.24)]
def line3(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"pts={pts}: {_pf_fmt_pad_left(5, " ", str(pts * 2))}: {_pf_fmt_pad_right(6, ".", who)}: {"pass" if pts >= 67 else "fail"}"
_pf_iter(print, _pf_map(line3, board))
print(f"best: {_pf_option_with_default("none", _pf_option_map(lambda s: s.who, _pf_max_by(lambda s: s.pts, board)))}")
