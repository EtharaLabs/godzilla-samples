from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Mark:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True)
class Panel:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Panel"
    bottom: "Panel"
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Push | Noop
scores: list[Mark] = [Mark("fay", 75, 0.15), Mark("max", 91, 0.91), Mark("kit", 29, 0.45)]
def fmtRow(_pf_arg0: Mark) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{{{pts}}},{_pf_fmt_pad_left(5, " ", str(pts * 3))},{_pf_fmt_percent(1, ratio)},{f"<{pts}>"}"
_pf_iter(print, _pf_map(fmtRow, scores))
total: int = _pf_sum_by(lambda s: s.pts, scores)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores))} {"{"}done{"}"}")
tiles: list[Panel] = [Panel(6, 7, "pin"), Panel(1, 8, "rod"), Panel(8, 3, "cog"), Panel(2, 6, "pin"), Panel(4, 4, "sq")]
def rename(prefix: str, b: Panel) -> Panel:
    label = b.label
    _pf_t1 = b
    return Panel(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(rename, "x-"), tiles)))
def area(_pf_arg0: Panel) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, tiles)))
def stackOf(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Panel):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: stackOf(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def describe(b: Panel) -> str:
    if isinstance(b, Panel):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Panel) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(describe, tiles)))
def step(xs: list[int], op: Op) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Push):
            n = op._0
            if n > 3:
                return _pf_concat(xs, [n * 10])
        return xs
def runAll(script: list[Op]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 3:
                _pf_t2 = n * 10
                xs.append(_pf_t2)
            case _:
                pass
    return xs
changes: list[Op] = [_Noop, Push(6), _Noop, _Noop]
final: list[int] = runAll(changes)
print(final)
