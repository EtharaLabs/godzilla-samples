from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Append | Noop
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: "Box"
    bottom: "Box"
    slot: int
board: list[Result2] = [Result2("ada", 46, 0.36), Result2("gus", 75, 0.49), Result2("dee", 76, 0.61), Result2("quin", 8, 0.15)]
def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_pad_left(5, " ", str(pts * 4))} pts={pts} {_pf_str_join("/", [who, str(pts)])} {{{pts}}} {_pf_fmt_percent(1, ratio)}"
_pf_iter(print, _pf_map(line3, board))
print(f"{len(board)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", board))}")
def stepA(n: int, acc: int) -> int:
    if n <= 0:
        return acc
    else:
        return stepB(n - 1, acc + 1)
def stepB(n: int, acc: int) -> int:
    if n <= 0:
        return acc
    else:
        return pang(n - 2, acc * 2)
def pang(n: int, acc: int) -> int:
    if n <= 0:
        return acc
    else:
        return stepA(n - 3, acc - 1)
print(_pf_map(lambda n: stepA(n, 1), [3, 1, 17, 19]))
def fold1(acc: tuple[int, int], op: Op) -> tuple[int, int]:
    puts = acc[0]
    total = acc[1]
    if isinstance(op, Put):
        v = op._1
        return (puts + 1, total + v)
    elif isinstance(op, Append):
        n = op._0
        return (puts, total + n)
    else:
        return acc
def replay(script: list[Op]) -> tuple[int, int]:
    return _pf_fold(fold1, (0, 0), script)
script: list[Op] = [Append(0), Put("bolt", 4), Append(9), _Noop, _Noop]
final: tuple[int, int] = replay(script)
print(final)
boxes: list[Box] = [Box(7, 3, "nut"), Box(7, 3, "cap"), Box(6, 4, "bolt"), Box(3, 6, "rod"), Box(4, 4, "sq")]
def relabel(prefix: str, b: Box) -> Box:
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "x-"), boxes)))
def grow(b: Box) -> Box:
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 1, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(grow, boxes)))
def area(_pf_arg0: Box) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(area, boxes)))
def heavier(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), boxes, _pf_rev(boxes)))
