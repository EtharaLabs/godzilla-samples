def audit2(rows) -> Ok | Error:
    def _pf_fn1():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t2 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t2, Ok):
            total = _pf_t2._0
            return Ok(total)
        else:
            return _pf_t2
    return _pf_fn1()
