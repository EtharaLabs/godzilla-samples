from dataclasses import dataclass
from typing import Any
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Member"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: "Club"
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Seat = Active | Parked | Gone
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Member(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 2:
                _pf_t1 = t
                return Parked(Club(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Seat] = _pf_map(promote, [_Gone, Active(Member("lu", 47)), Active(Member("pam", 54))])
print(roster)
people: list[Member] = [Member("lu", 5), Member("pam", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
scores: list[Result2] = [Result2("oz", 33, 0.14), Result2("ray", 88, 0.56), Result2("eli", 39, 0.89), Result2("lu", 54, 0.19)]
def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{f"<{pts}>"},{_pf_fmt_pad_left(5, " ", str(pts * 8))},{{{pts}}},{"pass" if pts >= 39 else "fail"},{_pf_str_upper(_pf_str_slice(0, 2, who))}"
_pf_iter(print, _pf_map(line3, scores))
total: int = _pf_sum_by(lambda s: s.pts, scores)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores))} {"{"}done{"}"}")
seriesA: list[int] = [16, 24, 12, 27, 15, 6, 21]
gain: int = 4
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), seriesA))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(seriesA))))
def _pf_fn2(_pf_arg0):
