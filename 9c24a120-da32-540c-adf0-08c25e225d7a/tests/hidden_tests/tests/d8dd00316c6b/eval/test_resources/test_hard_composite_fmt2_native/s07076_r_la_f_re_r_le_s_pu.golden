from dataclasses import dataclass
from typing import Any
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Lit:
    _0: int
    def __repr__(self):
        return f"Lit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ref:
    _0: str
    def __repr__(self):
        return f"Ref({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Plus:
    _0: "Val"
    _1: "Val"
    def __repr__(self):
        return f"Plus({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: "Val"
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
Val = Lit | Ref | Plus | Block
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: "Val"
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: "Val"
    def __repr__(self):
        return f"Show({self._0!r})"
St = Set | Show
@dataclass(frozen=True, slots=True)
class Tile:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Rack:
    top: "Tile"
    bottom: "Tile"
    slot: int
inputs2: list[int] = [-8, 22, 20, -9, 18]
factor: int = 4
makers2 = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(1), makers2))
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), inputs2))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(inputs2))))
shape2 = lambda _pf_x: (lambda z: z - 8)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, inputs2))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(inputs2)))
scores: list[Result2] = [Result2("eli", 8, 0.62), Result2("oz", 100, 0.75), Result2("ned", 7, 0.77), Result2("ada", 52, 0.24), Result2("max", 46, 0.78)]
def fmtRow(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_percent(1, ratio)} | {_pf_fmt_pad_left(5, " ", str(pts * 7))} | {_pf_str_join("/", [who, str(pts)])}"
_pf_iter(print, _pf_map(fmtRow, scores))
total: int = _pf_sum_by(lambda s: s.pts, scores)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, scores))} {"{"}done{"}"}")
def evalEx(env: dict[str, int], e: Val) -> int:
    while True:
        if isinstance(e, Lit):
            n = e._0
            return n
        elif isinstance(e, Ref):
            v = e._0
            return _pf_map_find_or(v, 0, env)
        elif isinstance(e, Plus):
            a = e._0
            b = e._1
            return evalEx(env, a) + evalEx(env, b)
        else:
            body = e._0
            last = e._1
            env, e = (_pf_fold(exec, env, body), last)
            continue
def exec(env: dict[str, int], s: St) -> dict[str, int]:
    if isinstance(s, Set):
        v = s._0
        e = s._1
        return _pf_map_add(v, evalEx(env, e), env)
    else:
        e = s._0
        return _pf_map_add("shown", evalEx(env, e), env)
print(evalEx(dict(), Block([Set("a", Lit(5)), Set("b", Plus(Ref("a"), Lit(2))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
tiles: list[Tile] = [Tile(3, 1, "cog"), Tile(2, 1, "gear"), Tile(7, 6, "pin"), Tile(3, 5, "hub"), Tile(4, 4, "sq")]
def heavier(s: Rack) -> str:
    if isinstance(s, Rack) and isinstance(s.top, Tile):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Rack(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def _pf_fn2(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn3(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn2, _pf_filter(_pf_fn3, tiles)))
def caption(b: Tile) -> str:
    if isinstance(b, Tile):
        w = b.w
        h = b.h
        label = b.label
        if w == h:
            return f"{label} square {w}"
    if isinstance(b, Tile) and b.w == 1:
        label = b.label
        return f"{label} thin"
    else:
        label = b.label
        w = b.w
        return f"{label} wide {w}"
print(_pf_str_join("; ", _pf_map(caption, tiles)))
