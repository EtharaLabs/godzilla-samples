def pick(o: Some | None_, fallback: int) -> int:
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((pick(Some((1, 8)), 0), pick(Some((1, 5)), 0), pick(_None_, 2)))
def size(s: Fig) -> int:
    if isinstance(s, Sq):
        n = s._0
        return n
    elif isinstance(s, Disc):
        n = s._0
        return n
    else:
        if isinstance(s, Tri):
            n = s._0
            m = s._1
            if n > m:
                return n
        m = s._0
        n = s._1
        return n
