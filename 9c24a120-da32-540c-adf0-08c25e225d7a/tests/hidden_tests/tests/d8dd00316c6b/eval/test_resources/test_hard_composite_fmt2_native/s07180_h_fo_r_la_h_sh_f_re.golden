def inc(x: int) -> int:
    return x + 1
def dbl(x: int) -> int:
    return x * 2
def both(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: dbl(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [7, 1, 6]))
