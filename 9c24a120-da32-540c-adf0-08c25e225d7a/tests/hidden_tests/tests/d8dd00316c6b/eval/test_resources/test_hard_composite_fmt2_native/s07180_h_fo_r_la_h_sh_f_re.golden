def wrap(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([7, 8, 9]))
scores: list[Score] = [Score("lu", 90, 0.04), Score("cy", 50, 0.4), Score("bo", 90, 0.72)]
def line3(_pf_arg0: Score) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
