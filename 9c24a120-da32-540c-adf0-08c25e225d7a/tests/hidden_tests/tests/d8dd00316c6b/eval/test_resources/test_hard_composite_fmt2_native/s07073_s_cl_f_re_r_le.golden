from dataclasses import dataclass
from typing import Any
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Lit:
    _0: int
    def __repr__(self):
        return f"Lit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ref:
    _0: str
    def __repr__(self):
        return f"Ref({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Plus:
    _0: "Ex"
    _1: "Ex"
    def __repr__(self):
        return f"Plus({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: "Ex"
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
Ex = Lit | Ref | Plus | Block
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: "Ex"
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: "Ex"
    def __repr__(self):
        return f"Show({self._0!r})"
Cmd2 = Set | Show
def ticker(start: int):
    n = start
    def next_(u) -> int:
        nonlocal n
        n = n + 4
        return n
    return next_
clock = ticker(7)
print((clock(None), clock(None), clock(None)))
def census(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([2, 5, 11, 11]))
marks: list[Result2] = [Result2("lu", 11, 0.38), Result2("ray", 64, 0.17), Result2("hal", 69, 0.45)]
def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_pad_right(6, ".", who)}: {{{pts}}}: {_pf_fmt_pad_left(5, " ", str(pts * 4))}"
_pf_iter(print, _pf_map(line3, marks))
total: int = _pf_sum_by(lambda s: s.pts, marks)
print(f"total={total} avg {_pf_fmt_fixed(1, _pf_fold(lambda a, s: a + s.ratio, 0.0, marks))} {"{"}done{"}"}")
def evalEx(env: dict[str, int], e: Ex) -> int:
    while True:
        if isinstance(e, Lit):
            n = e._0
            return n
        elif isinstance(e, Ref):
            v = e._0
            return _pf_map_find_or(v, 0, env)
        elif isinstance(e, Plus):
            a = e._0
            b = e._1
            return evalEx(env, a) + evalEx(env, b)
        else:
            body = e._0
            last = e._1
            env, e = (_pf_fold(runSt, env, body), last)
            continue
def runSt(env: dict[str, int], s: Cmd2) -> dict[str, int]:
    if isinstance(s, Set):
        v = s._0
        e = s._1
        return _pf_map_add(v, evalEx(env, e), env)
    else:
        e = s._0
        return _pf_map_add("shown", evalEx(env, e), env)
print(evalEx(dict(), Block([Set("a", Lit(1)), Set("b", Plus(Ref("a"), Lit(8))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
