from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Delta = Put | Append | Skip
marks: list[Result2] = [Result2("sue", 13, 0.71), Result2("hal", 21, 0.38), Result2("ray", 34, 0.06), Result2("pam", 30, 0.12), Result2("tom", 41, 0.38)]
def fmtRow(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_fmt_pad_right(6, ".", who)} | {_pf_str_upper(_pf_str_slice(0, 2, who))} | {_pf_fmt_pad_left(5, " ", str(pts * 3))}"
_pf_iter(print, _pf_map(fmtRow, marks))
print(f"{len(marks)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", marks))}")
def tally(xs: list[int]) -> tuple[int, int]:
    evens = 0
    odds = 0
    def visit(x: int):
        def bump(isEven: bool):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([18, 13, 9]))
def running(xs: list[int]) -> tuple[int, int]:
    peak = 0
    def step(acc: int, x: int) -> int:
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-2, 1, -4, 3]))
def numbered(xs) -> tuple[list[str], int]:
    i = 0
    def tag(x) -> str:
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["ada", "ivy", "ned"]))
def runAll(script: list[Delta]) -> tuple[int, int]:
    def step(acc, op):
        return acc
    def step(acc: tuple[int, int], op: Delta) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Append):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(step, (0, 0), script)
script: list[Delta] = [Append(7), Append(3), _Skip, Append(7)]
final: tuple[int, int] = runAll(script)
print(final)
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [1, 5, 2, 7])
print(acc)
