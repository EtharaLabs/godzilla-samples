from dataclasses import dataclass
from typing import Any
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
@dataclass(frozen=True, slots=True)
class Shelf:
    top: "Box"
    bottom: "Box"
    slot: int
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Change = Put | Push | Skip
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
@dataclass(frozen=True, slots=True)
class Result2:
    who: str
    pts: int
    ratio: float
tiles: list[Box] = [Box(1, 8, "cap"), Box(2, 1, "gear"), Box(6, 6, "nut"), Box(5, 4, "wick"), Box(4, 4, "sq")]
def _pf_fn0(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn1(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn0, _pf_filter(_pf_fn1, tiles)))
def surface(_pf_arg0: Box) -> int:
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, tiles)))
def heavier(s: Shelf) -> str:
    if isinstance(s, Shelf) and isinstance(s.top, Box):
        w = s.top.w
        bottom = s.bottom
        slot = s.slot
        if w > bottom.w:
            return f"top {slot}"
    slot = s.slot
    return f"bottom {slot}"
print(_pf_map2(lambda a, b: heavier(Shelf(a, b, a.w + b.h)), tiles, _pf_rev(tiles)))
def fold1(xs: list[int], op: Change) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Push):
            n = op._0
            if n > 3:
                return _pf_concat(xs, [n * 10])
        return xs
def replay(script: list[Change]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 3:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Change] = [_Skip, _Skip, _Skip, _Skip]
state: list[int] = replay(changes)
print(state)
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 10:
        return _Low()
    elif scaled < 35:
        return _Mid()
    else:
        return _High()
def grade(n: int) -> str:
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    if isinstance(_pf_t1, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t1, _Mid):
        return "mid"
    if isinstance(_pf_t1, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(grade, [19, 30, 13, 8, -4]))
board: list[Result2] = [Result2("pam", 50, 0.27), Result2("jo", 40, 0.94), Result2("quin", 18, 0.09), Result2("fay", 43, 0.05)]
def line3(_pf_arg0: Result2) -> str:
    who = _pf_arg0.who
    pts = _pf_arg0.pts
    ratio = _pf_arg0.ratio
    return f"{_pf_str_upper(_pf_str_slice(0, 2, who))}: {"pass" if pts >= 44 else "fail"}: {f"<{pts}>"}"
_pf_iter(print, _pf_map(line3, board))
print(f"{len(board)} rows; names={_pf_str_join(", ", _pf_map(lambda s: f"[{s.who}]", board))}")
