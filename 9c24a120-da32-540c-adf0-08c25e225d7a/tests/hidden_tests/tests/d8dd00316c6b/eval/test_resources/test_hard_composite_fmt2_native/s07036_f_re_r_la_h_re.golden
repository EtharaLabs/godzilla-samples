print(_pf_map(tweak2, inputs2))
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 4:
                _pf_t1 = t
                return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Seat] = _pf_map(promote, [Idle(Crew("hub", 9)), _Gone, _Gone, Active(Person("kit", 65)), Active(Person("bo", 44))])
print(roster)
