let evens = seq {
    for x in ((List.range 1) 6):
        let y = (x * x)
        yield y
    yield 117
}
(((evens |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 5))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 5)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 1288)))) |> Seq.toList) |> print)
let mut calls = 0
let record x =
    (calls <- (calls + 1))
    (x * 3)
let stats xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (stats [32, 1, 34, 31, 32, 55, 12, 40]))
let doubled = ([32, 1, 34, 31] |> (List.map record))
(print f"{doubled} after {calls} calls")
let data = [24, 20, 23, 3, 44, 2, (- 3), 12, 34, 43]
let isBig n = ((n > 3) and ((n % 2) != 0))
let digest = (((((((data |> (List.map (max 4))) |> (List.filter isBig)) |> ((List.windowed 3) >> (List.map (fun w -> ((Option.withDefault 0) (List.max w)))))) |> (List.filter (fun x -> ((x % 3) == 0)))) |> (List.collect (fun x -> [x, (x + 1)]))) |> List.sort) |> (List.find (fun x -> ((x % 2) == 1))))
(print digest)
