type Heap = Leaf | Node Heap int Heap
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let tree = (((List.fold (fun acc x -> ((insert x) acc))) Leaf) [40, 8, 52, 42, 50, 29, 47])
let minT t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minT l)
(print (minT tree))
let depthT t =
    match t:
        case Leaf: 0
        case (Node l _ rt): (1 + ((max (depthT l)) (depthT rt)))
(print (depthT tree))
let containsT x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsT x) l) else ((containsT x) rt))
(print ((List.map (fun k -> ((containsT k) tree))) [40, 48, 44]))
let toListOf t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListOf l)) ((List.concat [v]) (toListOf rt)))
(print (toListOf tree))
let text = "lu,bolt,tom,max"
let parts = ((String.split ",") text)
(print (((String.slice 3) 8) text))
(print (((parts |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
let longest = ((parts |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
(print (((String.replace "i") "I") text))
let countDown n acc = (if (n == 0) then acc else ((countDown (n - 1)) (acc + (n * n))))
(print ((countDown 576) 0))
let powAcc b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((powAcc b) (k - 1)) (acc * b))
        case k: (((powAcc (b * b)) (k // 2)) acc)
(print (((powAcc 4) 20) 1))
let decodeLine line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 5) }
let lines = ["cy=6=1", "ada=-2", "dee=x", "pam=0=1"]
let parsed = ((List.map decodeLine) lines)
((List.iter print) parsed)
(print ((parsed |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((parsed |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
