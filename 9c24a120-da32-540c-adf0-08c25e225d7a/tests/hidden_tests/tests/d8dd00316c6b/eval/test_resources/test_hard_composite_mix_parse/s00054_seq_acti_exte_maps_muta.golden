let series = seq {
    for x in ((List.range 1) 6):
        let y = (x * x)
        yield y
}
(((series |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 2))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 5)) |> Seq.toList) |> print)
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let bucketOf n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([(- 3), 31, 20, 5, 39, 27, 23, 16] |> (List.map bucketOf)) |> (List.iter print))
extern pure shout: string -> string = str.upper
(print (("jo" |> shout) |> String.rev))
extern fromHex: string -> int = int(base=16)
(print ((["ff", "7"] |> (List.map fromHex)) |> List.sum))
extern parseIn: string -> int -> int = int(base=...)
let fromBin s = ((parseIn s) 2)
(print ((fromBin "1001011") + ((parseIn "72") 8)))
extern pure isqrt: int -> int = math.isqrt
(print ((List.map isqrt) [2, 342, 251, 221]))
let log = ["eli", "fay", "eli", "cy", "dee", "cy"]
let freq = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) log)
(print ((freq |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print (((freq |> (Map.map (fun k v -> (v * 10)))) |> Map.values) |> List.sort))
let sa = (Set.ofList [1, 2, 11, 15, 16, 17])
let sb = (Set.ofList [1, 2, 3, 9, 10, 12])
(print ((((Set.difference sa) sb) |> Set.toList) |> List.sort))
(print ((Set.len sa), ((Set.contains 7) sb), ((Set.isSubset (Set.ofList [1])) sa)))
let extra = (Map.ofList [("zed", 5), ("eli", 0)])
(print ((((Map.union extra) freq) |> Map.toList) |> List.sort))
let mut ticks = 0
let record x =
    (ticks <- (ticks + 1))
    (x * 2)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [7, 8, 31, 30, 42, 1]))
let doubled = ([7, 8, 31, 30] |> (List.map record))
(print f"{doubled} after {ticks} calls")
