module Calc =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let between lo hi x = (lo <= x <= hi)
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let pts = [(- 7), 22, 22, (- 5), 26]
(print (pts |> (List.map ((Calc.clamp 0) 16))))
(print ((List.filter ((Calc.between (- 1)) 21)) pts))
(print (Calc.norm1 pts))
(print (Calc.mean pts))
type Player = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Player { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"ray\", \"points\": 66, \"active\": true}, {\"name\": \"max\", \"points\": 82, \"active\": false}, {\"name\": \"tom\", \"points\": 77, \"active\": true}, {\"name\": \"ada\", \"points\": 69, \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let pure discount price qty = ((price * qty) - (7 * qty))
let emit label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let grand = (([("nut", 47, 1), ("cog", 7, 4), ("gear", 49, 6)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print grand)
let pure scaled k = (List.map (discount k))
(print ((scaled 15) [1, 2, 3]))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [6, 4, 2, 7]))
extern readBase: string -> int -> int = int(base=...)
let fromBin s = ((readBase s) 2)
(print ((fromBin "10000") + ((readBase "15") 8)))
extern pure comb: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (comb n)))
(print (row 4))
opaque type Sku = string
opaque type Email = string
let unwrap x =
    match x:
        case (Sku s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let keys = ((makeIds "sku") 2)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (Sku "u-1"))))
