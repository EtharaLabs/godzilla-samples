exit: 0
--- stdout ---
opaque type UserId = string
opaque type Handle = string
let rawOf x =
    match x:
        case (UserId s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let keys = ((mint "acc") 3)
(print ((keys |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head keys) == (Some (UserId "acc-1"))))
let (|Above|_|) n = (if (n > 14) then (Some (n - 14)) else None)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([27, 13, 35, 4, 9, 2, 21] |> (List.map bucketOf)) |> (List.iter print))
let decodeLine line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 2) }
let lines = ["quin = 5", "tom", "pam=6=1", "jo = 2", "sue=x", "hal=x"]
let parsed = ((List.map decodeLine) lines)
((List.iter print) parsed)
(print ((parsed |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((parsed |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
let text = "lu,bo,eli,cap,hal,ray,kit"
let words = ((String.split ",") text)
let nums = (((String.split ",") "x,7,x,,-3") |> (List.map String.toInt))
(print nums)
(print ((nums |> (List.choose id)) |> List.sum))
(print (((words |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print ((words |> (List.map String.upper)) |> (String.join "|")))
let longest = ((words |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
(print ((words |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
