measure m
measure s
measure kg
measure N = kg m/s^2
let legs = [125.6<m>, 81.0<m>, 450.2<m>, 116.4<m>, 373.6<m>]
let splits = [59.6<s>, 84.3<s>, 26.3<s>, 16.8<s>, 67.2<s>]
let total = (legs |> ((List.fold (fun acc d -> (acc + (d * 1.0)))) 0.0<m>))
let elapsed = (((List.fold (+)) 0.0<s>) splits)
let speed = (total / elapsed)
(print ((Format.fixed 3) speed))
let best = (((List.zip legs) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let side = (sqrt 2.25<m^2>)
let cube = ((side * side) * side)
(print f"{side} {(cbrt cube)}")
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf total) elapsed) * 1000.0)))
opaque type UserId = string
opaque type Email = string
let rawOf x =
    match x:
        case (UserId s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let keys = ((mint "acc") 2)
(print ((keys |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head keys) == (Some (UserId "u-1"))))
let raw = "hal,bolt,bo,jo,ada,tom,dee"
let words = ((String.split ",") raw)
let cell (i, w) = ((String.concat (((Format.padRight 10) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((words |> List.indexed) |> (List.map cell)) |> (List.iter print))
(print (((words |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print (((String.tryIndexOf "to") raw), ((String.contains "to") raw)))
type Player = { name: string, points: int, active: bool }
let decoder = ((((Decode.map3 (fun n p a -> Player { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"max\", \"points\": 89, \"active\": true}, {\"name\": \"dee\", \"points\": 27, \"active\": false}]"
match ((Decode.decodeString (Decode.list decoder)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
