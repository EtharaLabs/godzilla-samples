extern readBase: string -> int -> int = int(base=...)
let fromBin s = ((readBase s) 2)
(print ((fromBin "10011") + ((readBase "141") 8)))
extern pure choose: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (choose n)))
(print (row 7))
extern pure loud: string -> string = str.upper
(print (("oz" |> loud) |> String.rev))
extern parseHex: string -> int = int(base=16)
(print ((["ff", "1a"] |> (List.map parseHex)) |> List.sum))
let pure discount price qty = ((price * qty) - (9 * qty))
let report label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let overall = (([("wick", 12, 1), ("hub", 34, 2), ("gear", 23, 6), ("gear", 19, 5)] |> (List.map (fun (n, pr, q) -> (((report n) pr) q)))) |> List.sum)
(print overall)
type Token = Pop string | Mark string string | Jump int | Rest int int | Turn string string
let render t =
    match t:
        case (Pop s0): f"pop({s0})"
        case (Mark s0 s1): f"mark({s0},{s1})"
        case (Jump 1): "jump-1"
        case (Jump n0): f"jump({n0})"
        case (Rest 2 _): "rest-2"
        case (Rest n0 n1): f"rest({n0},{n1})"
        case (Turn s0 s1): f"turn({s0},{s1})"
let cost t =
    match t:
        case (Jump x0): x0
        case _: 0
let batch = [((Mark "kit") "fay"), (Jump 1), ((Mark "lu") "ivy"), ((Mark "dee") "ned"), ((Mark "hal") "ned"), (Jump 5), ((Rest 7) 11)]
((List.iter (fun t -> (print (render t)))) batch)
let tally = (batch |> (List.sumBy cost))
(print f"tally={tally}")
(print ((List.maxBy cost) batch))
measure m
measure s
measure kg
let laps = [180.7<m>, 270.0<m>, 265.7<m>, 378.1<m>]
let times = [85.8<s>, 52.9<s>, 66.3<s>, 66.7<s>]
let dist = (((List.fold (+)) 0.0<m>) laps)
let dur = (((List.fold (+)) 0.0<s>) times)
let rate = (dist / dur)
(print ((Format.fixed 2) rate))
let edge = (sqrt 25.0<m^2>)
let cube = ((edge * edge) * edge)
(print f"{edge} {(cbrt cube)}")
let best = (((List.zip laps) times) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let speeds = (((List.map2 (fun d t -> (d / t))) laps) times)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf dist) dur) * 1000.0)))
