type Reading = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"ivy\", \"points\": 56, \"active\": false}, {\"name\": \"ned\", \"points\": 43, \"active\": false}, {\"name\": \"dee\", \"points\": 13, \"active\": true}, {\"name\": \"gus\", \"points\": 71, \"active\": true}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
measure m
measure s
measure kg
measure N = kg m/s^2
let laps = [461.9<m>, 349.6<m>, 126.2<m>]
let splits = [76.2<s>, 68.9<s>, 70.6<s>]
let dist = (laps |> ((List.fold (fun acc d -> (acc + (d * 1.0)))) 0.0<m>))
let elapsed = (((List.fold (+)) 0.0<s>) splits)
let rate = (dist / elapsed)
(print ((Format.fixed 1) rate))
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf dist) elapsed) * 1000.0)))
let side = (sqrt 4.0<m^2>)
let cube = ((side * side) * side)
(print f"{side} {(cbrt cube)}")
let best = (((List.zip laps) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let mass = 59.0<kg>
let accel = 3.5<m/s^2>
let push = (mass * accel)
let limit = 120.0<N>
(print (if (push > limit) then "over" else "under"))
module Geo =
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let clamp lo hi x = ((max lo) ((min hi) x))
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
let pts = [3, 20, (- 4), 7, (- 9), 12, 13]
(print (Geo.mean pts))
(print ((Geo.scaleAll 5) pts))
(print (pts |> (List.map ((Geo.clamp 0) 5))))
(print (Geo.norm1 pts))
