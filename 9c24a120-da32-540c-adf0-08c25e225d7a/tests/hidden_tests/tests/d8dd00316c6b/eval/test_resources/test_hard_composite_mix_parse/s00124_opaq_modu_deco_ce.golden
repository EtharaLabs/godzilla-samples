opaque type UserId = string
opaque type Email = string
let unwrap x =
    match x:
        case (UserId s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let ids = ((makeIds "sku") 3)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (UserId "acc-1"))))
module Text =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let between lo hi x = (lo <= x <= hi)
let nums = [(- 14), 11, 0, (- 7)]
(print (nums |> (List.map ((Text.clamp 0) 20))))
(print (Text.mean nums))
(print ((List.filter ((Text.between (- 1)) 25)) nums))
type Reading = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"ivy\", \"points\": 60, \"active\": true}, {\"name\": \"oz\", \"points\": 21, \"active\": true}, {\"name\": \"ray\", \"points\": 46, \"active\": true}, {\"name\": \"pam\", \"points\": 64, \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let lines = ["hal=39", "sue=7=1", "gus = 3", "cy=5=1", "ivy=43", "dee=1=1"]
let parsed = ((List.map parseEntry) lines)
((List.iter print) parsed)
let errs = ((parsed |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
