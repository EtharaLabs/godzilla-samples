let euclid a b = (if (b == 0) then a else ((euclid b) (a % b)))
(print ((euclid 349) 65))
let collatz n acc = (if (n == 1) then acc elif ((n % 2) == 0) then ((collatz (n // 2)) (acc + 1)) else ((collatz ((3 * n) + 1)) (acc + 1)))
(print ((List.map (fun n -> ((collatz n) 0))) [33, 22, 36]))
let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let entries = ["kit", "ned=x", "tom=9", "dee=25"]
let results = ((List.map parseEntry) entries)
((List.iter print) results)
let goodOnes = (results |> (List.choose Result.toOption))
(print (((List.map snd) goodOnes) |> List.sum))
let sumAll xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((sumAll results) |> (Result.mapError String.upper)))
let pure discount price qty = ((price * qty) - (4 * qty))
let emit label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let overall = (([("hub", 18, 1), ("bolt", 26, 5), ("rod", 38, 1), ("pin", 36, 2)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print overall)
let data = [36, 29, (- 8), 9, (- 8), 47, 8, 0, 18]
let isBig n = ((n > 4) and ((n % 5) != 0))
let outcome = (((((((data |> (List.distinctBy (fun x -> (x % 3)))) |> (List.map ((+) 3))) |> ((List.windowed 2) >> (List.map (fun w -> ((Option.withDefault 0) (List.max w)))))) |> (List.takeWhile (fun x -> (x < 38)))) |> (List.map (max 9))) |> (List.collect (fun x -> [x, (x + 1)]))) |> (List.sumBy (fun x -> (x * x))))
(print outcome)
