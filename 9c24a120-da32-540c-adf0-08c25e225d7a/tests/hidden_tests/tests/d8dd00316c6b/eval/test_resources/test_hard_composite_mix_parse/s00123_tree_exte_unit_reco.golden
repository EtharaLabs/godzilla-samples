exit: 0
--- stdout ---
type Expr = Num int | Add Expr Expr | Mul Expr Expr | Neg Expr
let evalE e =
    match e:
        case (Num n): n
        case (Add a b): ((evalE a) + (evalE b))
        case ((Mul (Num 0) _) | (Mul _ (Num 0))): 0
        case (Mul a b): ((evalE a) * (evalE b))
        case (Neg a): (- (evalE a))
let pretty e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(pretty a)} + {(pretty b)})"
        case (Mul a b): f"{(pretty a)} * {(pretty b)}"
        case (Neg a): f"-{(pretty a)}"
let exprs = [(Num 0), (Neg (Num 9)), ((Mul (Num 7)) ((Mul (Neg (Num 9))) (Num 9)))]
((exprs |> (List.map pretty)) |> (List.iter print))
(print ((List.map evalE) exprs))
extern parseIn: string -> int -> int = int(base=...)
let fromBin s = ((parseIn s) 2)
(print ((fromBin "11001") + ((parseIn "37") 8)))
extern pure isqrt: int -> int = math.isqrt
(print ((List.map isqrt) [133, 121, 371, 220]))
measure m
measure s
measure kg
measure N = kg m/s^2
let segments = [355.9<m>, 393.4<m>, 78.3<m>]
let splits = [54.7<s>, 44.9<s>, 65.9<s>]
let total = (((List.fold (fun acc d -> (acc + d))) 0.0<m>) segments)
let dur = (((List.fold (+)) 0.0<s>) splits)
let pace = (total / dur)
(print ((Format.fixed 1) pace))
let mass = 79.0<kg>
let accel = 5.5<m/s^2>
let push = (mass * accel)
let limit = 152.0<N>
(print (if (push > limit) then "over" else "under"))
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf total) dur) * 1000.0)))
let km = (total / 1000.0)
(print ((Format.fixed 1) km))
let side = (sqrt 16.0<m^2>)
let cube = ((side * side) * side)
(print f"{side} {(cbrt cube)}")
type Parcel = { id: int, owner: string, amount: int, urgent: bool }
let tickets = [Parcel { id = 100, owner = "ada", amount = 179, urgent = true }, Parcel { urgent = true, id = 101, owner = "ada", amount = 16 }, Parcel { id = 102, owner = "cy", amount = 237, urgent = false }, Parcel { urgent = false, id = 103, amount = 36, owner = "kit" }]
let surcharge o = (if o.urgent then { o with amount = (o.amount + 7) } else o)
(print ((tickets |> (List.map surcharge)) |> (List.map (fun o -> o.amount))))
(print ((List.maxBy (fun o -> o.amount)) tickets))
(print (((tickets |> (List.sortByDescending (fun o -> o.amount))) |> (List.take 3)) |> (List.map (fun o -> o.id))))
