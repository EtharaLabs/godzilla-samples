let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let inputs = ["cy=93", "hal=7=1", "jo=x", "ivy=42", "sue=x", "eli"]
let results = ((List.map parseEntry) inputs)
((List.iter print) results)
let goodOnes = (results |> (List.choose Result.toOption))
(print (((List.map snd) goodOnes) |> List.sum))
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine results) |> (Result.mapError String.upper)))
type Order = { id: int, owner: string, amount: int, urgent: bool }
let book = [Order { id = 100, owner = "pam", amount = 218, urgent = true }, Order { amount = 213, id = 101, owner = "bo", urgent = false }, Order { amount = 89, owner = "bo", urgent = true, id = 102 }, Order { owner = "bo", urgent = false, id = 103, amount = 83 }, Order { id = 104, owner = "pam", amount = 267, urgent = false }]
let urgentTotal = ((book |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
let label (Order { id, owner }) = f"#{id} {(String.upper owner)}"
(print ((book |> (List.map label)) |> (String.join ", ")))
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 107))) book)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
type Entry = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Entry { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"fay\", \"points\": 54, \"active\": false}, {\"name\": \"sue\", \"points\": 2, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
