exit: 0
--- stdout ---
measure m
measure s
measure kg
let laps = [147.0<m>, 370.1<m>, 218.8<m>]
let times = [15.6<s>, 88.9<s>, 36.7<s>]
let dist = (laps |> ((List.fold (fun acc d -> (acc + (d * 1.0)))) 0.0<m>))
let dur = (((List.fold (+)) 0.0<s>) times)
let pace = (dist / dur)
(print ((Format.fixed 1) pace))
let km = (dist / 1000.0)
(print ((Format.fixed 1) km))
let edge = (sqrt 25.0<m^2>)
let cube = ((edge * edge) * edge)
(print f"{edge} {(cbrt cube)}")
type Action = Halt string | Drop int | Jump string | Load string
let describe t =
    match t:
        case (Halt s0): f"halt({s0})"
        case (Drop n0): f"drop({n0})"
        case (Jump s0): f"jump({s0})"
        case (Load s0): f"load({s0})"
let rank t =
    match t:
        case (Load _): 5
        case _: 0
let batch = [(Load "quin"), (Jump "gus"), (Drop 12), (Halt "bo"), (Jump "dee")]
(print ((batch |> (List.map describe)) |> (String.join "; ")))
let grandSum = (batch |> (List.sumBy rank))
(print f"grandSum={grandSum}")
(print (List.sort batch))
let parseEntry line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 3) }
let inputs = ["ned=7=1", "oz", "ray", "eli = 9"]
let results = ((List.map parseEntry) inputs)
((List.iter print) results)
(print ((results |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((results |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
