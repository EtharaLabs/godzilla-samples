let samples = [(- 8), 46, 0, 10, 40, 23]
let shift k x = (x + k)
let result = (((List.map String.fromInt) >> (String.join "-")) ((List.filter (fun x -> (x > (- 1)))) ((List.take 7) ((List.filter (fun x -> ((x % 5) == 4))) samples))))
(print result)
(print <| (List.len samples))
let pure margin price qty = ((price * qty) - (3 * qty))
let emit label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let grand = (([("rod", 27, 1), ("bolt", 14, 5), ("cog", 20, 1)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print grand)
let pure scaled k = (List.map (margin k))
(print ((scaled 9) [1, 2, 3]))
opaque type AccountNo = string
opaque type Handle = string
let unwrap x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((mint "sku") 4)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "u-1"))))
type Invoice = { id: int, owner: string, amount: int, urgent: bool }
let tickets = [Invoice { id = 100, owner = "eli", amount = 232, urgent = true }, Invoice { id = 101, owner = "lu", amount = 265, urgent = true }, Invoice { id = 102, owner = "eli", amount = 18, urgent = true }, Invoice { owner = "eli", amount = 161, urgent = true, id = 103 }, Invoice { id = 104, owner = "eli", amount = 180, urgent = false }, Invoice { urgent = true, id = 105, amount = 197, owner = "eli" }]
let priority o =
    match o:
        case Invoice { urgent = true, amount } if (amount > 194): "rush-big"
        case Invoice { urgent = true }: "rush"
        case Invoice { amount }: (if (amount > 194) then "big" else "normal")
(print ((List.map priority) tickets))
(print ((List.countBy priority) tickets))
let urgentTotal = ((tickets |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
let perOwner = ((tickets |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print perOwner)
(print (((tickets |> (List.sortByDescending (fun o -> o.amount))) |> (List.take 2)) |> (List.map (fun o -> o.id))))
let (|Above|_|) n = (if (n > 19) then (Some (n - 19)) else None)
let (|Zero|_|) n = (n == 0)
let kindOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case m if (m < 0): "negative"
        case _: "small"
(([39, 17, 2, 32, 19, (- 6), 38, 24] |> (List.map kindOf)) |> (List.iter print))
