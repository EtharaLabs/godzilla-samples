exit: 0
--- stdout ---
opaque type UserId = string
opaque type Email = string
let rawOf x =
    match x:
        case (UserId s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let keys = ((mint "sku") 3)
(print ((keys |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head keys) == (Some (UserId "acc-1"))))
type Reading = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"bo\", \"points\": 97, \"active\": false}, {\"name\": \"lu\", \"points\": 4, \"active\": true}, {\"name\": \"fay\", \"points\": 37, \"active\": false}, {\"name\": \"ada\", \"points\": 86, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let decodeLine line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let inputs = ["eli=33", "ray=4=1", "tom = 0", "max=x", "dee", "ada=50"]
let parsed = ((List.map decodeLine) inputs)
((List.iter print) parsed)
let errs = ((parsed |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let firstGood = ((((parsed |> (List.map Result.toOption)) |> (List.choose id)) |> List.head) |> (Option.map fst))
match firstGood:
    case (Some name): (print f"first: {name}")
    case None: (print "none parsed")
let sumAll xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((sumAll parsed) |> (Result.mapError String.upper)))
let text = "ivy oz fay lu ray cap"
let words = ((String.split " ") text)
(print ((words |> (List.map String.upper)) |> (String.join "|")))
(print ((List.map (fun w -> (w, (String.len w)))) words))
(print (((String.replace "o") "O") text))
