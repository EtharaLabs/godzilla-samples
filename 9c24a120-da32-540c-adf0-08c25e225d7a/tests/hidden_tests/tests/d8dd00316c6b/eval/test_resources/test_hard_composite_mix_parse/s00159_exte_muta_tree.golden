exit: 0
--- stdout ---
extern pure isqrt: int -> int = math.isqrt
(print ((List.map isqrt) [43, 145, 20, 136]))
extern fromHex: string -> int = int(base=16)
(print ((["ff", "c0"] |> (List.map fromHex)) |> List.sum))
let mut hits = 0
let record x =
    (hits <- (hits + 1))
    (x * 2)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [56, 54, 3, 17, 22, 42]))
let doubled = ([56, 54, 3, 17] |> (List.map record))
(print f"{doubled} after {hits} calls")
let recordTwice = (record >> record)
(print ((recordTwice 3), hits))
type Bst = Leaf | Node Bst int Bst
let add x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((add x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((add x) rt))
        case (Node _ _ _): t
let root = (((List.fold (fun acc x -> ((add x) acc))) Leaf) [19, 2, 23, 52, 57, 26, 48])
let minOf t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minOf l)
(print (minOf root))
let depthOf t =
    match t:
        case Leaf: 0
        case (Node l _ rt): (1 + ((max (depthOf l)) (depthOf rt)))
(print (depthOf root))
let sumT t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumT l) + v) + (sumT rt))
(print (sumT root))
