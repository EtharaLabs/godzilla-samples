let squares = seq {
    for x in ((List.range 1) 12):
        let y = (x * x)
        yield y
    yield 117
}
(((squares |> (Seq.filter (fun n -> ((n % 3) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 7))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 2)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 353)))) |> Seq.toList) |> print)
type Reading = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"sue\", \"points\": 87, \"active\": false}, {\"name\": \"pam\", \"points\": 96, \"active\": true}, {\"name\": \"quin\", \"points\": 95, \"active\": false}]"
match ((Decode.decodeString (Decode.list playerDecoder)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let mut ticks = 0
let note x =
    (ticks <- (ticks + 1))
    (x * 4)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [14, 6, 48, 5]))
let doubled = ([14, 6, 48, 5] |> (List.map note))
(print f"{doubled} after {ticks} calls")
let noteTwice = (note >> note)
(print ((noteTwice 3), ticks))
opaque type AccountNo = string
opaque type Handle = string
let unwrap x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((mint "sku") 4)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "u-1"))))
