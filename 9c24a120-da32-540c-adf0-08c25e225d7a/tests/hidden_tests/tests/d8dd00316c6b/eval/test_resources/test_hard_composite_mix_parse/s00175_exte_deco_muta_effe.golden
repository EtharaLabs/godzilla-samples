exit: 0
--- stdout ---
extern fromHex: string -> int = int(base=16)
(print ((["ff", "c0"] |> (List.map fromHex)) |> List.sum))
extern readBase: string -> int -> int = int(base=...)
let fromBin s = ((readBase s) 2)
(print ((fromBin "10000") + ((readBase "115") 8)))
type Player = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Player { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"ray\", \"points\": 40, \"active\": true}, {\"name\": \"ned\", \"points\": 20, \"active\": true}, {\"name\": \"lu\", \"points\": 81, \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let mut ticks = 0
let track x =
    (ticks <- (ticks + 1))
    (x * 3)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [56, 4, 21, 6, 56, (- 11), 41, 43]))
let doubled = ([56, 4, 21, 6] |> (List.map track))
(print f"{doubled} after {ticks} calls")
let pure margin price qty = ((price * qty) - (6 * qty))
let announce label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let overall = (([("pin", 42, 5), ("cap", 38, 6), ("rod", 46, 3), ("hub", 6, 2)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print overall)
