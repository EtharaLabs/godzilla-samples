let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let kindOf n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([23, 40, 25, 4, 31, 27] |> (List.map kindOf)) |> (List.iter print))
type Order = { id: int, owner: string, amount: int, urgent: bool }
let book = [Order { id = 100, owner = "lu", amount = 79, urgent = true }, Order { id = 101, owner = "lu", amount = 177, urgent = true }, Order { id = 102, owner = "cy", amount = 269, urgent = true }, Order { id = 103, urgent = true, owner = "lu", amount = 269 }, Order { id = 104, owner = "cy", amount = 111, urgent = false }, Order { id = 105, owner = "lu", amount = 51, urgent = false }]
(print ((List.maxBy (fun o -> o.amount)) book))
let perOwner = ((book |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print perOwner)
let tag o =
    let Order { id, amount } = o
    f"#{id}:{(((Format.padLeft 5) " ") (String.fromInt amount))}"
(print ((book |> (List.map tag)) |> (String.join ", ")))
module Calc =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let square x = (x * x)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let pts = [(- 12), 20, 22, 0]
(print (pts |> (List.map ((Calc.clamp 0) 20))))
(print ((List.map Calc.square) pts))
(print (Calc.mean pts))
let pure net price qty = ((price * qty) - (7 * qty))
let emit label price qty =
    (print f"{label}: {((net price) qty)}")
    ((net price) qty)
let grand = (([("cog", 13, 3), ("cog", 15, 4), ("bolt", 13, 3)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print grand)
let pure scaled k = (List.map (net k))
(print ((scaled 17) [1, 2, 3]))
