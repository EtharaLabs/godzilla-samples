let squares = seq {
    for x in ((List.range 1) 12):
        let y = (x * x)
        yield y
}
(print (((Seq.fold (+)) 0) squares))
(((((Seq.initInfinite (fun i -> (i * 7))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 6)) |> Seq.toList) |> print)
module Geo =
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let between lo hi x = (lo <= x <= hi)
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let square x = (x * x)
let pts = [24, 10, (- 13), 19, 2, 1, (- 14)]
(print ((Geo.scaleAll 5) pts))
(print ((List.filter ((Geo.between 2) 14)) pts))
(print (Geo.norm1 pts))
(print ((List.map Geo.square) pts))
let pure margin price qty = ((price * qty) - (6 * qty))
let announce label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let grand = (([("cog", 13, 4), ("rod", 17, 2), ("cap", 25, 1), ("cog", 10, 6)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print grand)
extern parseNum: string -> int = int
let safe s =
    match (try (parseNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x8", "-3"] |> (List.map safe)) |> (List.iter print))
extern parseHex: string -> int = int(base=16)
(print ((["ff", "7"] |> (List.map parseHex)) |> List.sum))
