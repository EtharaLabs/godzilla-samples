module Stats =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let scaleAll k xs = ((List.map ((*) k)) xs)
let nums = [12, 20, 18, (- 13), 12]
(print (nums |> (List.map ((Stats.clamp 0) 14))))
(print (Stats.mean nums))
(print ((Stats.scaleAll 5) nums))
let text = "dee,hal,oz,ivy,ned"
let tokens = ((String.split ",") text)
(print (((tokens |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print ((tokens |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
(print ((tokens |> (List.map String.upper)) |> (String.join "|")))
let n2 = (List.len tokens)
(print f"n2={n2} {{braces}} {(String.len text)}")
(print (((String.replace "i") "I") text))
let decodeLine line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let lines = ["lu=x", "eli=33", "hal=4=1", "ray=27"]
let parsed = ((List.map decodeLine) lines)
((List.iter print) parsed)
let goodOnes = (parsed |> (List.choose Result.toOption))
(print (((List.map snd) goodOnes) |> List.sum))
let firstGood = ((((parsed |> (List.map Result.toOption)) |> (List.choose id)) |> List.head) |> (Option.map fst))
match firstGood:
    case (Some name): (print f"first: {name}")
    case None: (print "none parsed")
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 10) then (Some (n - 10)) else None)
let (|Zero|_|) n = (n == 0)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([(- 1), 16, (- 4), 11, 31, 38, 3] |> (List.map classify)) |> (List.iter print))
