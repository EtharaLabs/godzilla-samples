let raw = "quin;cap;eli;lu;tom;tap"
let tokens = ((String.split ";") raw)
let count = (List.len tokens)
(print f"count={count} {{braces}} {(String.len raw)}")
let longest = ((tokens |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
(print (((tokens |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print (((String.tryIndexOf "ca") raw), ((String.contains "ca") raw)))
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [20, 5, 24, 21, 21]))
let countDown n acc = (if (n == 0) then acc else ((countDown (n - 1)) (acc + (n * n))))
(print ((countDown 2833) 0))
type Instr = Halt int | Load string | Rest string string | Turn int
let show t =
    match t:
        case (Halt n0) if (0 <= n0 < 15): f"halt!({n0})"
        case (Halt n0): f"halt({n0})"
        case (Load s0): f"load({s0})"
        case (Rest s0 s1): f"rest({s0},{s1})"
        case (Turn n0) if (n0 > 6): f"turn!({n0})"
        case (Turn n0): f"turn({n0})"
let score t =
    match t:
        case (Rest _ _): 9
        case (Turn x0): (x0 * 4)
        case _: 3
let prog = [(Halt 1), (Halt 9), (Load "tom"), (Turn 0), ((Rest "gus") "pam")]
(print ((String.join " ") ((List.map show) prog)))
let tally = (prog |> (List.sumBy score))
(print f"tally={tally}")
(print ((List.head prog), (List.last prog)))
let (|Above|_|) n = (if (n > 10) then (Some (n - 10)) else None)
let (|Zero|_|) n = (n == 0)
let kindOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case m if (m < 0): "negative"
        case _: "small"
(([0, 31, 13, 37, 28, 9, 0] |> (List.map kindOf)) |> (List.iter print))
