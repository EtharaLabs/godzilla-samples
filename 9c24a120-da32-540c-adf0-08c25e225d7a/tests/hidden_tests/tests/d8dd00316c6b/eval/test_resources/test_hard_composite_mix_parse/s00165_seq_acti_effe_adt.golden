let series = seq {
    for x in ((List.range 1) 11):
        let y = (x * x)
        yield y
}
(print (((Seq.fold (+)) 0) series))
(((((Seq.initInfinite (fun i -> (i * 2))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 4)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 1604)))) |> Seq.toList) |> print)
let (|Above|_|) n = (if (n > 28) then (Some (n - 28)) else None)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([29, 19, 35, (- 5), 12, 40, 36] |> (List.map bucketOf)) |> (List.iter print))
let pure margin price qty = ((price * qty) - (7 * qty))
let announce label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let grand = (([("bolt", 14, 3), ("cap", 48, 5), ("wick", 32, 4)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print grand)
type Action = Rest int | Turn string int | Drop int int
let render t =
    match t:
        case (Rest n0) if ((n0 % 2) == 0): f"rest!({n0})"
        case (Rest n0): f"rest({n0})"
        case (Turn s0 n1): f"turn({s0},{n1})"
        case (Drop n0 n1): f"drop({n0},{n1})"
let cost t =
    match t:
        case (Turn _ x1): x1
        case (Rest x0): (x0 * 3)
        case _: 2
let queue = [((Drop 9) 12), ((Drop 3) (- 1)), (Rest 2), (Rest 8), ((Turn "ned") 4)]
((List.iter (fun t -> (print (render t)))) queue)
let total = (queue |> (List.sumBy cost))
(print f"total={total}")
(print (List.sort queue))
