type Entry = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Entry { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"dee\", \"points\": 6, \"active\": true}, {\"name\": \"quin\", \"points\": 86, \"active\": true}, {\"name\": \"tom\", \"points\": 36, \"active\": false}]"
match ((Decode.decodeString (Decode.list dec)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
type Token = Jump int | Pop int | Store | Push string
let explain t =
    match t:
        case (Jump n0) if (n0 > 0): f"jump!({n0})"
        case (Jump n0): f"jump({n0})"
        case (Pop n0) if (0 <= n0 < 20): f"pop!({n0})"
        case (Pop n0): f"pop({n0})"
        case Store: f"store"
        case (Push s0): f"push({s0})"
let score t =
    match t:
        case (Jump x0): x0
        case _: 0
let batch = [Store, (Jump 7), (Jump 12), (Jump 12), (Push "pam"), (Push "ray")]
((List.iter (fun t -> (print (explain t)))) batch)
let total = (batch |> (List.sumBy score))
(print f"total={total}")
(print ((List.head batch), (List.last batch)))
type Order = { id: int, owner: string, amount: int, urgent: bool }
let tickets = [Order { id = 100, owner = "pam", amount = 271, urgent = true }, Order { id = 101, owner = "gus", amount = 33, urgent = true }, Order { id = 102, owner = "pam", amount = 225, urgent = true }, Order { id = 103, owner = "gus", amount = 173, urgent = true }, Order { amount = 55, id = 104, owner = "gus", urgent = false }, Order { id = 105, owner = "pam", amount = 140, urgent = false }]
let bucket o =
    match o:
        case Order { urgent = true, amount } if (amount > 193): "rush-big"
        case Order { urgent = true }: "rush"
        case Order { amount }: (if (amount > 193) then "big" else "normal")
(print ((List.map bucket) tickets))
(print ((List.countBy bucket) tickets))
(print (((tickets |> (List.sortByDescending (fun o -> o.amount))) |> (List.take 4)) |> (List.map (fun o -> o.id))))
let (cnt, amt) = (((List.fold (fun (n, s) o -> ((n + 1), (s + o.amount)))) (0, 0)) tickets)
(print f"{cnt} records, {amt} total")
