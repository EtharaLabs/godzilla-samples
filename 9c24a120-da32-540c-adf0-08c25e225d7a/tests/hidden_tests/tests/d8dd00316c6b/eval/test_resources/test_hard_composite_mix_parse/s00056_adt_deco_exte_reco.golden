type Msg = Skip int | Drop int string | Jump int
let explain t =
    match t:
        case (Skip n0) if ((n0 % 2) == 0): f"skip!({n0})"
        case (Skip n0): f"skip({n0})"
        case (Drop 1 _): "drop-1"
        case (Drop n0 s1): f"drop({n0},{s1})"
        case (Jump n0) if (0 <= n0 < 3): f"jump!({n0})"
        case (Jump n0): f"jump({n0})"
let score t =
    match t:
        case (Skip x0): (x0 * 5)
        case _: 3
let stream = [(Skip 4), (Jump 3), (Skip (- 1)), (Jump 12), ((Drop 3) "ray"), ((Drop 6) "gus")]
(print ((stream |> (List.map explain)) |> (String.join "; ")))
let grandSum = (stream |> (List.sumBy score))
(print f"grandSum={grandSum}")
(print ((List.head stream), (List.last stream)))
type Reading = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"max\", \"points\": 0, \"active\": true}, {\"name\": \"quin\", \"points\": 90, \"active\": false}, {\"name\": \"dee\", \"points\": 6, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
extern fromHex: string -> int = int(base=16)
(print ((["ff", "7"] |> (List.map fromHex)) |> List.sum))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [5, 7, 8, 3]))
type Invoice = { id: int, owner: string, amount: int, urgent: bool }
let orders = [Invoice { id = 100, owner = "hal", amount = 240, urgent = false }, Invoice { id = 101, owner = "ned", amount = 42, urgent = false }, Invoice { urgent = false, id = 102, owner = "pam", amount = 141 }, Invoice { owner = "pam", amount = 151, id = 103, urgent = false }, Invoice { id = 104, owner = "pam", amount = 268, urgent = true }, Invoice { id = 105, owner = "hal", amount = 194, urgent = false }]
let byOwner = ((orders |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
let adjust pct o =
    let extra = ((o.amount * pct) // 100)
    { o with amount = (o.amount + extra), urgent = false }
(print ((orders |> (List.map (adjust 11))) |> (List.map (fun o -> o.amount))))
let rushSum = ((orders |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print rushSum)
