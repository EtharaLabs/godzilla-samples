let text = "gear pam cog pin hub"
let parts = ((String.split " ") text)
let cell (i, w) = ((String.concat (((Format.padRight 7) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((parts |> List.indexed) |> (List.map cell)) |> (List.iter print))
(print (((String.slice 1) 5) text))
(print (((String.replace "i") "I") text))
(print ((parts |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
module Geo =
    let between lo hi x = (lo <= x <= hi)
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let square x = (x * x)
let pts = [(- 3), (- 8), (- 15), 8, (- 4)]
(print ((List.filter ((Geo.between (- 4)) 19)) pts))
(print (Geo.norm1 pts))
(print ((List.map Geo.square) pts))
let pure discount price qty = ((price * qty) - (7 * qty))
let report label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let grand = (([("pin", 29, 5), ("tap", 15, 3)] |> (List.map (fun (n, pr, q) -> (((report n) pr) q)))) |> List.sum)
(print grand)
let pure scaled k = (List.map (discount k))
(print ((scaled 18) [1, 2, 3]))
type Reading = { name: string, points: int, active: bool }
let decoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"hal\", \"points\": 48, \"active\": true}, {\"name\": \"pam\", \"points\": 23, \"active\": false}, {\"name\": \"oz\", \"points\": 92, \"active\": false}, {\"name\": \"dee\", \"points\": 64, \"active\": false}]"
match ((Decode.decodeString (Decode.list decoder)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let (|Above|_|) n = (if (n > 21) then (Some (n - 21)) else None)
let kindOf n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([28, 22, 19, (- 3), 13, 31, 6] |> (List.map kindOf)) |> (List.iter print))
