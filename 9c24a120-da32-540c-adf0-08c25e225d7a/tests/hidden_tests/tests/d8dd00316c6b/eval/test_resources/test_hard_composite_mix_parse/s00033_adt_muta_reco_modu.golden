exit: 0
--- stdout ---
type Move = Mark string | Turn int | Skip | Halt | Load string
let show t =
    match t:
        case (Mark s0): f"mark({s0})"
        case (Turn n0) if ((n0 % 2) == 0): f"turn!({n0})"
        case (Turn n0): f"turn({n0})"
        case Skip: f"skip"
        case Halt: f"halt"
        case (Load s0): f"load({s0})"
let cost t =
    match t:
        case (Turn x0): (x0 * 4)
        case (Load _): 7
        case _: 2
let batch = [(Mark "oz"), Halt, Skip, (Mark "quin"), Halt, Skip, Skip]
((batch |> (List.map show)) |> print)
let tally = (batch |> (List.sumBy cost))
(print f"tally={tally}")
(print ((batch |> (List.filter (fun t -> ((cost t) > 2)))) |> List.len))
let mut calls = 0
let track x =
    (calls <- (calls + 1))
    (x * 2)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [(- 6), 47, (- 13), 42, (- 17)]))
let doubled = ([(- 6), 47, (- 13), 42] |> (List.map track))
(print f"{doubled} after {calls} calls")
type Booking = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Booking { id = 100, owner = "fay", amount = 216, urgent = true }, Booking { id = 101, owner = "fay", amount = 282, urgent = false }, Booking { id = 102, owner = "tom", amount = 188, urgent = false }, Booking { id = 103, owner = "tom", amount = 300, urgent = false }, Booking { amount = 226, owner = "quin", urgent = true, id = 104 }, Booking { id = 105, owner = "fay", amount = 281, urgent = false }]
(print ((List.maxBy (fun o -> o.amount)) parcels))
let surcharge o = (if o.urgent then { o with amount = (o.amount + 4) } else o)
(print ((parcels |> (List.map surcharge)) |> (List.map (fun o -> o.amount))))
let byOwner = ((parcels |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
module Text =
    let square x = (x * x)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let between lo hi x = (lo <= x <= hi)
let pts = [22, 30, 26, (- 6), (- 9), (- 7)]
(print ((List.map Text.square) pts))
(print (Text.mean pts))
(print ((List.filter ((Text.between 5) 11)) pts))
