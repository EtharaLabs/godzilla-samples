let ipow b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((ipow b) (k - 1)) (acc * b))
        case k: (((ipow (b * b)) (k // 2)) acc)
(print (((ipow 3) 18) 1))
let sumDigits n =
    match n:
        case 0: 0
        case _: ((n % 10) + (sumDigits (n // 10)))
(print (sumDigits 19715))
let gcdLoop a b = (if (b == 0) then a else ((gcdLoop b) (a % b)))
(print ((gcdLoop 167) 111))
let squares = seq {
    for x in ((List.range 1) 8):
        let y = (x * x)
        yield y
}
(print (((Seq.fold (+)) 0) squares))
(((((Seq.initInfinite (fun i -> (i * 3))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 3)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 873)))) |> Seq.toList) |> print)
type Player = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Player { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"pam\", \"points\": 33, \"active\": false}, {\"name\": \"lu\", \"points\": 69, \"active\": false}, {\"name\": \"quin\", \"points\": 16, \"active\": false}, {\"name\": \"ned\", \"points\": 15, \"active\": false}]"
match ((Decode.decodeString (Decode.list dec)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
type Order = { id: int, owner: string, amount: int, urgent: bool }
let book = [Order { id = 100, owner = "kit", amount = 18, urgent = true }, Order { amount = 205, id = 101, urgent = true, owner = "ivy" }, Order { id = 102, owner = "kit", amount = 243, urgent = true }, Order { id = 103, owner = "ivy", amount = 210, urgent = true }, Order { amount = 123, owner = "ray", urgent = true, id = 104 }, Order { amount = 155, urgent = true, id = 105, owner = "kit" }]
(print (((book |> (List.sortBy (fun o -> o.amount))) |> (List.take 3)) |> (List.map (fun o -> o.id))))
(print ((List.maxBy (fun o -> o.amount)) book))
let data = [(- 5), 23, (- 10), 3, 44, 25, 9, 27]
let addK k x = (x + k)
let keep n = ((n > 12) and ((n % 3) != 0))
let digest = (List.max (List.sortDescending (List.distinct ((List.pairwise >> (List.map (fun (a, b) -> (b - a)))) (List.sort (List.rev ((List.takeWhile (fun x -> (x < 44))) data)))))))
(print digest)
