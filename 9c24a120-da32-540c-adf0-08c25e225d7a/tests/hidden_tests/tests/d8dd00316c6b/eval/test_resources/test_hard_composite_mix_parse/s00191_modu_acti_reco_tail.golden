module Stats =
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let clamp lo hi x = ((max lo) ((min hi) x))
    let square x = (x * x)
let obs = [6, (- 10), 20, 0, 16, 30]
(print ((Stats.scaleAll 5) obs))
(print (Stats.mean obs))
(print (obs |> (List.map ((Stats.clamp 0) 11))))
(print ((List.map Stats.square) obs))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let classify n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([27, 23, (- 5), 1, (- 3), (- 4)] |> (List.map classify)) |> (List.iter print))
type Site = { city: string, zone: int }
type Parcel = { id: int, owner: string, amount: int, urgent: bool, dest: Site }
let tickets = [Parcel { id = 100, owner = "ray", amount = 290, urgent = true, dest = Site { city = "Riga", zone = 2 } }, Parcel { id = 101, owner = "max", amount = 171, urgent = true, dest = Site { city = "Doha", zone = 4 } }, Parcel { owner = "ray", dest = Site { city = "Kyiv", zone = 4 }, amount = 298, urgent = true, id = 102 }, Parcel { id = 103, owner = "max", amount = 61, urgent = false, dest = Site { city = "Baku", zone = 1 } }]
let (cnt, sumAmt) = (((List.fold (fun (n, s) o -> ((n + 1), (s + o.amount)))) (0, 0)) tickets)
(print f"{cnt} records, {sumAmt} total")
let classify2 o =
    match o:
        case Parcel { urgent = true, amount } if (amount > 99): "rush-big"
        case Parcel { urgent = true }: "rush"
        case Parcel { amount }: (if (amount > 99) then "big" else "normal")
(print ((List.map classify2) tickets))
(print ((List.countBy classify2) tickets))
let rerouted = (tickets |> (List.map (fun o -> (if (o.dest.zone > 2) then { o with dest.city = "Hub", dest.zone = 1 } else o))))
(print ((List.map (fun o -> f"{o.dest.city}/{o.dest.zone}")) rerouted))
(print ((List.maxBy (fun o -> o.amount)) tickets))
let sumDigits n =
    match n:
        case 0: 0
        case _: ((n % 10) + (sumDigits (n // 10)))
(print (sumDigits 6724))
let countDown n acc = (if (n == 0) then acc else ((countDown (n - 1)) (acc + (n * n))))
(print ((countDown 2561) 0))
