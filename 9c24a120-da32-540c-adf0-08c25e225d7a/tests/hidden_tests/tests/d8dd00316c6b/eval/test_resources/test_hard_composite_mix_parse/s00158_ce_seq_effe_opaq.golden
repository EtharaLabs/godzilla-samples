let decodeLine line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let entries = ["cy", "pam=x", "dee=9=1", "hal=5=1", "oz"]
let results = ((List.map decodeLine) entries)
((List.iter print) results)
let errs = ((results |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine results) |> (Result.mapError String.upper)))
let squares = seq {
    for x in ((List.range 1) 9):
        let y = (x * x)
        yield y
    yield 195
}
(((squares |> (Seq.filter (fun n -> ((n % 4) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 3))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 3)) |> Seq.toList) |> print)
let pure discount price qty = ((price * qty) - (3 * qty))
let announce label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let overall = (([("hub", 18, 4), ("hub", 24, 1)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print overall)
opaque type AccountNo = string
opaque type Email = string
let unwrap x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((mint "acc") 3)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "acc-1"))))
