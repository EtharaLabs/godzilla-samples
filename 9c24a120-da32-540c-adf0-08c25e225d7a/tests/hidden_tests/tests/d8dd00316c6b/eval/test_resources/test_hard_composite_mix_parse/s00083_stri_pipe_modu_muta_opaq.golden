module Stats =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let between lo hi x = (lo <= x <= hi)
    let square x = (x * x)
let nums = [(- 5), 19, (- 2), 18, (- 9), 20]
(print (Stats.norm1 nums))
(print ((Stats.scaleAll 3) nums))
(print ((List.filter ((Stats.between (- 4)) 12)) nums))
(print ((List.map Stats.square) nums))
let mut hits = 0
let record x =
    (hits <- (hits + 1))
    (x * 2)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [44, 48, 22, (- 10), 28]))
let doubled = ([44, 48, 22, (- 10)] |> (List.map record))
(print f"{doubled} after {hits} calls")
let recordTwice = (record >> record)
