type Addr = { city: string, zone: int }
type Parcel = { id: int, owner: string, amount: int, urgent: bool, dest: Addr }
let tickets = [Parcel { id = 100, owner = "lu", amount = 45, urgent = true, dest = Addr { city = "Bern", zone = 1 } }, Parcel { id = 101, owner = "lu", amount = 246, urgent = false, dest = Addr { city = "Lima", zone = 4 } }, Parcel { owner = "lu", urgent = true, amount = 39, dest = Addr { city = "Doha", zone = 3 }, id = 102 }, Parcel { urgent = true, amount = 155, id = 103, dest = Addr { city = "Oslo", zone = 3 }, owner = "max" }, Parcel { owner = "max", amount = 180, id = 104, dest = Addr { city = "Doha", zone = 4 }, urgent = true }, Parcel { id = 105, owner = "lu", amount = 269, urgent = false, dest = Addr { city = "Rome", zone = 3 } }]
let urgentTotal = ((tickets |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
(print ((List.maxBy (fun o -> o.amount)) tickets))
let (cnt, amt) = (((List.fold (fun (n, s) o -> ((n + 1), (s + o.amount)))) (0, 0)) tickets)
(print f"{cnt} records, {amt} total")
let collatz n acc = (if (n == 1) then acc elif ((n % 2) == 0) then ((collatz (n // 2)) (acc + 1)) else ((collatz ((3 * n) + 1)) (acc + 1)))
(print ((List.map (fun n -> ((collatz n) 0))) [44, 26, 52]))
let accumulate n acc = (if (n == 0) then acc else ((accumulate (n - 1)) (acc + (n * n))))
(print ((accumulate 1324) 0))
let readings = [33, (- 1), 36, 18, (- 3), 40, (- 2), 5, (- 4)]
let shift k x = (x + k)
let outcome = (((List.fold (fun acc x -> ((acc * 2) - x))) 0) ((List.take 7) (List.sort ((List.filter (fun x -> (x > 8))) ((List.takeWhile (fun x -> (x < 53))) readings)))))
(print outcome)
(print <| (List.len readings))
module Text =
    let between lo hi x = (lo <= x <= hi)
    let square x = (x * x)
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let clamp lo hi x = ((max lo) ((min hi) x))
let obs = [0, (- 8), (- 8), 21, (- 14)]
(print ((List.filter ((Text.between (- 1)) 10)) obs))
(print ((List.map Text.square) obs))
(print ((Text.scaleAll 4) obs))
(print (obs |> (List.map ((Text.clamp 0) 20))))
let (|Above|_|) n = (if (n > 16) then (Some (n - 16)) else None)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([18, 34, 36, 32, 15] |> (List.map classify)) |> (List.iter print))
let pure net price qty = ((price * qty) - (7 * qty))
let announce label price qty =
    (print f"{label}: {((net price) qty)}")
    ((net price) qty)
let grand = (([("pin", 13, 1), ("rod", 5, 4)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print grand)
