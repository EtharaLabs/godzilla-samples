let laps = [86.1<m>, 93.4<m>, 346.2<m>]
let durations = [18.1<s>, 57.9<s>, 79.4<s>]
let dist = (((List.fold (+)) 0.0<m>) laps)
let dur = (((List.fold (+)) 0.0<s>) durations)
let pace = (dist / dur)
(print ((Format.fixed 2) pace))
let speeds = (((List.map2 (fun d t -> (d / t))) laps) durations)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let km = (dist / 1000.0)
(print ((Format.fixed 1) km))
