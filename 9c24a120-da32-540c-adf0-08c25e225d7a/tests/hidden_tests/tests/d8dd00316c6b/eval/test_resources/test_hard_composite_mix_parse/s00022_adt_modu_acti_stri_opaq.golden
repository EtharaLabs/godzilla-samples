exit: 0
--- stdout ---
type Signal = Store int | Rest int string | Skip int int
let describe t =
    match t:
        case (Store n0) if (0 <= n0 < 14): f"store!({n0})"
        case (Store n0): f"store({n0})"
        case (Rest n0 s1): f"rest({n0},{s1})"
        case (Skip 1 _): "skip-1"
        case (Skip n0 n1): f"skip({n0},{n1})"
let rank t =
    match t:
        case (Rest x0 _): (x0 * 2)
        case (Skip x0 x1): (x0 + x1)
        case _: 2
let queue = [((Rest (- 1)) "hal"), ((Rest (- 1)) "oz"), ((Skip 2) 5), ((Skip 1) 9), (Store 4), (Store (- 2)), ((Rest 12) "fay")]
(print ((queue |> (List.map describe)) |> (String.join "; ")))
let total = (queue |> (List.sumBy rank))
(print f"total={total}")
(print ((queue |> (List.filter (fun t -> ((rank t) > 6)))) |> List.len))
module Calc =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let between lo hi x = (lo <= x <= hi)
    let square x = (x * x)
let obs = [(- 1), (- 13), 10, 25, 7, (- 7), (- 7)]
(print (Calc.norm1 obs))
(print ((List.filter ((Calc.between 4) 16)) obs))
(print ((List.map Calc.square) obs))
let (|Above|_|) n = (if (n > 14) then (Some (n - 14)) else None)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([31, 19, 31, 7, 1] |> (List.map bucketOf)) |> (List.iter print))
let sentence = "cap;tom;wick;kit;rod"
let words = ((String.split ";") sentence)
(print ((words |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
(print ((words |> (List.map String.upper)) |> (String.join "|")))
let longest = ((words |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
opaque type AccountNo = string
opaque type Label = string
let rawOf x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((mint "acc") 2)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "u-1"))))
