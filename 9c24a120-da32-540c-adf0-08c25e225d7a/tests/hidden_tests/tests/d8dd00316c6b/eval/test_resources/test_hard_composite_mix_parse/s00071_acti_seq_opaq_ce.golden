--- stdout ---
let (|Above|_|) n = (if (n > 30) then (Some (n - 30)) else None)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([6, 39, (- 6), 35, 6, 17, 32, 35] |> (List.map bucketOf)) |> (List.iter print))
let squares = seq {
    for x in ((List.range 1) 11):
        let y = (x * x)
        yield y
}
(((squares |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 5))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 5)) |> Seq.toList) |> print)
opaque type Sku = string
opaque type Email = string
let rawOf x =
    match x:
        case (Sku s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let ids = ((makeIds "acc") 2)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (Sku "u-1"))))
let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let lines = ["fay=x", "gus", "tom=x", "pam=x", "jo=6=1"]
let results = ((List.map parseEntry) lines)
((List.iter print) results)
let errs = ((results |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let sumAll xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((sumAll results) |> (Result.mapError String.upper)))
