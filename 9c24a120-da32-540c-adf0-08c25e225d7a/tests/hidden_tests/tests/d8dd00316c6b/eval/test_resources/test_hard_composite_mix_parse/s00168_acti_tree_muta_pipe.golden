exit: 0
--- stdout ---
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 27) then (Some (n - 27)) else None)
let (|Zero|_|) n = (n == 0)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([19, 13, 24, 12, 1, 26] |> (List.map classify)) |> (List.iter print))
type Bst = Leaf | Node Bst int Bst
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let root = ([58, 42, 41, 33, 11, 2, 14, 7, 51] |> ((List.fold (flip insert)) Leaf))
let toListT t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListT l)) ((List.concat [v]) (toListT rt)))
(print (toListT root))
let minT t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minT l)
(print (minT root))
let containsT x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsT x) l) else ((containsT x) rt))
(print ((List.map (fun k -> ((containsT k) root))) [58, 52, 50]))
let mut ticks = 0
let track x =
    (ticks <- (ticks + 1))
    (x * 4)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [50, 19, 57, 6, 46]))
let doubled = ([50, 19, 57, 6] |> (List.map track))
(print f"{doubled} after {ticks} calls")
let samples = [(- 1), (- 6), 13, 43, 14, 30, 30, 4]
let isBig n = ((n > 10) and ((n % 5) != 0))
let outcome = (((List.fold (fun acc x -> ((acc * 2) - x))) 0) ((List.sortBy (fun x -> (x % 5))) ((List.takeWhile (fun x -> (x < 22))) ((List.take 8) (((List.chunkBySize 2) >> (List.map List.sum)) samples)))))
(print outcome)
