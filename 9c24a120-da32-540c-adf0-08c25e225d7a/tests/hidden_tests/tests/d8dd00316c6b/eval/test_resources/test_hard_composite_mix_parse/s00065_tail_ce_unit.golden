let powAcc b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((powAcc b) (k - 1)) (acc * b))
        case k: (((powAcc (b * b)) (k // 2)) acc)
(print (((powAcc 2) 12) 1))
let accumulate n acc = (if (n == 0) then acc else ((accumulate (n - 1)) (acc + (n * n))))
(print ((accumulate 836) 0))
let euclid a b = (if (b == 0) then a else ((euclid b) (a % b)))
(print ((euclid 145) 355))
let decodeLine line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let inputs = ["ivy=x", "pam=6=1", "tom", "jo=x", "gus = 9", "quin=1=1"]
let parsed = ((List.map decodeLine) inputs)
((List.iter print) parsed)
let goodOnes = (parsed |> (List.choose Result.toOption))
(print (((List.map snd) goodOnes) |> List.sum))
let firstGood = ((((parsed |> (List.map Result.toOption)) |> (List.choose id)) |> List.head) |> (Option.map fst))
match firstGood:
    case (Some name): (print f"first: {name}")
    case None: (print "none parsed")
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
measure m
measure s
measure kg
let segments = [80.0<m>, 278.4<m>, 52.8<m>, 153.5<m>, 116.2<m>]
let splits = [85.7<s>, 68.6<s>, 44.2<s>, 63.8<s>, 45.2<s>]
let dist = (((List.fold (fun acc d -> (acc + d))) 0.0<m>) segments)
let dur = (((List.fold (+)) 0.0<s>) splits)
let speed = (dist / dur)
(print ((Format.fixed 2) speed))
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf dist) dur) * 1000.0)))
let speeds = (((List.map2 (fun d t -> (d / t))) segments) splits)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let edge = (sqrt 2.25<m^2>)
let cube = ((edge * edge) * edge)
(print f"{edge} {(cbrt cube)}")
