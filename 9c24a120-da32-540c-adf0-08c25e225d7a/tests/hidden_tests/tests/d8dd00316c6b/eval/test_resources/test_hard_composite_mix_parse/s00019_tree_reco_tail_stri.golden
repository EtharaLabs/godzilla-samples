type Expr = Num int | Add Expr Expr | Mul Expr Expr | Neg Expr | Var string
let env = (Map.ofList [("x", 4), ("y", (- 3))])
let calc e =
    match e:
        case (Num n): n
        case (Add a b): ((calc a) + (calc b))
        case (Mul a b): ((calc a) * (calc b))
        case (Neg a): (- (calc a))
        case (Var v): (((Map.findOr v) 0) env)
let show e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(show a)} + {(show b)})"
        case (Mul a b): f"{(show a)} * {(show b)}"
        case (Neg a): f"-{(show a)}"
        case (Var v): v
let exprs = [(Var "y"), ((Add (Num 1)) ((Add ((Add (Num 5)) (Num 1))) ((Add (Num 1)) (Num 4)))), ((Mul ((Add (Num 1)) ((Add (Num 6)) (Num 9)))) (Num 9))]
((exprs |> (List.map show)) |> (List.iter print))
(print ((List.map calc) exprs))
type Parcel = { id: int, owner: string, amount: int, urgent: bool }
let book = [Parcel { id = 100, owner = "gus", amount = 198, urgent = true }, Parcel { id = 101, owner = "gus", urgent = false, amount = 132 }, Parcel { id = 102, owner = "cy", amount = 217, urgent = true }, Parcel { id = 103, owner = "bo", amount = 10, urgent = true }]
let (cnt, sumAmt) = (((List.fold (fun (n, s) o -> ((n + 1), (s + o.amount)))) (0, 0)) book)
(print f"{cnt} records, {sumAmt} total")
let bucket o =
    match o:
        case Parcel { urgent = true, amount } if (amount > 129): "rush-big"
        case Parcel { urgent = true }: "rush"
        case Parcel { amount }: (if (amount > 129) then "big" else "normal")
(print ((List.map bucket) book))
(print ((List.countBy bucket) book))
(print ((List.maxBy (fun o -> o.amount)) book))
let collatz n acc = (if (n == 1) then acc elif ((n % 2) == 0) then ((collatz (n // 2)) (acc + 1)) else ((collatz ((3 * n) + 1)) (acc + 1)))
(print ((List.map (fun n -> ((collatz n) 0))) [45, 55, 15]))
let powAcc b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((powAcc b) (k - 1)) (acc * b))
        case k: (((powAcc (b * b)) (k // 2)) acc)
(print (((powAcc 4) 6) 1))
let text = "hal jo oz nut max bolt"
let tokens = ((String.split " ") text)
(print ((tokens |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
(print (((String.tryIndexOf "bo") text), ((String.contains "bo") text)))
(print ((List.map (fun w -> (w, (String.len w)))) tokens))
(print ((tokens |> (List.map String.upper)) |> (String.join "|")))
(print (((tokens |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
let longest = ((tokens |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
