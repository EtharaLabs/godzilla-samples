exit: 0
--- stdout ---
let mut calls = 0
let record x =
    (calls <- (calls + 1))
    (x * 4)
let stats xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (stats [56, 9, 0, 41, (- 16), 33, 18]))
let doubled = ([56, 9, 0, 41] |> (List.map record))
(print f"{doubled} after {calls} calls")
let recordTwice = (record >> record)
(print ((recordTwice 3), calls))
extern parseHex: string -> int = int(base=16)
(print ((["ff", "c0"] |> (List.map parseHex)) |> List.sum))
extern parseNum: string -> int = int
let safe s =
    match (try (parseNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x1", "-50"] |> (List.map safe)) |> (List.iter print))
extern pure shout: string -> string = str.upper
(print (("lu" |> shout) |> String.rev))
extern pure choose: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (choose n)))
(print (row 6))
module Geo =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let between lo hi x = (lo <= x <= hi)
    let square x = (x * x)
    let clamp lo hi x = ((max lo) ((min hi) x))
let nums = [(- 11), 25, 12, (- 13), (- 5), 26, 1]
(print (Geo.norm1 nums))
(print ((List.filter ((Geo.between (- 5)) 21)) nums))
(print ((List.map Geo.square) nums))
(print (nums |> (List.map ((Geo.clamp 0) 20))))
