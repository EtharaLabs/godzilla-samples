let series = seq {
    for x in ((List.range 1) 12):
        let y = (x * x)
        yield y
    yield 162
}
(print (((Seq.fold (+)) 0) series))
(((((Seq.initInfinite (fun i -> (i * 3))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 5)) |> Seq.toList) |> print)
let mut calls = 0
let track x =
    (calls <- (calls + 1))
    (x * 2)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [27, (- 2), 49, (- 12), 3]))
let doubled = ([27, (- 2), 49, (- 12)] |> (List.map track))
(print f"{doubled} after {calls} calls")
type Heap = Leaf | Node Heap int Heap
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let tree = ([37, 55, 6, 22, 35, 29, 31] |> ((List.fold (flip insert)) Leaf))
let toListT t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListT l)) ((List.concat [v]) (toListT rt)))
(print (toListT tree))
let minOf t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minOf l)
(print (minOf tree))
let containsT x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsT x) l) else ((containsT x) rt))
(print ((List.map (fun k -> ((containsT k) tree))) [37, 32, 20]))
