exit: 0
--- stdout ---
module Text =
    let between lo hi x = (lo <= x <= hi)
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let clamp lo hi x = ((max lo) ((min hi) x))
let obs = [(- 7), 14, (- 9), (- 15), (- 12), (- 8)]
(print ((List.filter ((Text.between (- 4)) 25)) obs))
(print ((Text.scaleAll 3) obs))
(print (obs |> (List.map ((Text.clamp 0) 15))))
let pure margin price qty = ((price * qty) - (2 * qty))
let emit label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let grand = (([("tap", 10, 2), ("bolt", 15, 3)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print grand)
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [11, 6, 11, 10]))
extern pure isqrt: int -> int = math.isqrt
(print ((List.map isqrt) [194, 364, 305, 125]))
extern toNum: string -> int = int
let safe s =
    match (try (toNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x1", "-24"] |> (List.map safe)) |> (List.iter print))
extern parseIn: string -> int -> int = int(base=...)
let fromBin s = ((parseIn s) 2)
(print ((fromBin "1100010") + ((parseIn "113") 8)))
type Move = Store string | Turn int | Rest | Emit int | Mark int int
let describe t =
    match t:
        case (Store s0): f"store({s0})"
        case (Turn n0): f"turn({n0})"
        case Rest: f"rest"
        case (Emit n0): f"emit({n0})"
        case (Mark n0 n1) if (n0 > 1): f"mark!({n0},{n1})"
        case (Mark n0 n1): f"mark({n0},{n1})"
let cost t =
    match t:
        case (Store _): 2
        case (Turn x0): (x0 * 2)
        case Rest: 2
        case (Emit x0): (x0 * 5)
        case _: 0
let stream = [(Store "oz"), Rest, (Store "oz"), (Emit (- 1)), ((Mark 0) 2)]
((List.iter (fun t -> (print (describe t)))) stream)
let total = (stream |> (List.sumBy cost))
(print f"total={total}")
(print ((List.maxBy cost) stream))
