exit: 0
--- stdout ---
measure m
measure s
measure kg
let segments = [283.2<m>, 333.8<m>, 293.7<m>, 78.2<m>]
let durations = [62.2<s>, 81.6<s>, 72.5<s>, 32.2<s>]
let total = (((List.fold (+)) 0.0<m>) segments)
let dur = (((List.fold (+)) 0.0<s>) durations)
let pace = (total / dur)
(print ((Format.fixed 2) pace))
let km = (total / 1000.0)
(print ((Format.fixed 1) km))
let speeds = (((List.map2 (fun d t -> (d / t))) segments) durations)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf total) dur) * 1000.0)))
let readPair line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 3) }
let entries = ["ray=95", "sue=x", "pam", "hal = 9", "lu=2=1"]
let parsed = ((List.map readPair) entries)
((List.iter print) parsed)
(print ((parsed |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((parsed |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
let ipow b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((ipow b) (k - 1)) (acc * b))
        case k: (((ipow (b * b)) (k // 2)) acc)
(print (((ipow 6) 12) 1))
let gcdLoop a b = (if (b == 0) then a else ((gcdLoop b) (a % b)))
(print ((gcdLoop 379) 306))
let sumDigits n =
    match n:
        case 0: 0
        case _: ((n % 10) + (sumDigits (n // 10)))
(print (sumDigits 99362))
opaque type AccountNo = string
opaque type Label = string
let unwrap x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let keys = ((mint "u") 3)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (AccountNo "u-1"))))
