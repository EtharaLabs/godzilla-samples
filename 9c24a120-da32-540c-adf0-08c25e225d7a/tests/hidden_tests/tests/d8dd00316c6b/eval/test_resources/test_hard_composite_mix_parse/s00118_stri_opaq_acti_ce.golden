let text = "ivy tap cog ned"
let words = ((String.split " ") text)
let n2 = (List.len words)
(print f"n2={n2} {{braces}} {(String.len text)}")
(print ((words |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
let longest = ((words |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
(print (((String.tryIndexOf "iv") text), ((String.contains "iv") text)))
let cell (i, w) = ((String.concat (((Format.padRight 9) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((words |> List.indexed) |> (List.map cell)) |> (List.iter print))
opaque type Sku = string
opaque type Email = string
let rawOf x =
    match x:
        case (Sku s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let ids = ((mint "sku") 4)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (Sku "acc-1"))))
let (|Above|_|) n = (if (n > 14) then (Some (n - 14)) else None)
let (|Zero|_|) n = (n == 0)
let kindOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case m if (m < 0): "negative"
        case _: "small"
(([18, 5, 7, 35, 1] |> (List.map kindOf)) |> (List.iter print))
let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let inputs = ["pam=76", "cy=-1", "kit=x", "eli=x"]
let parsed = ((List.map parseEntry) inputs)
((List.iter print) parsed)
let errs = ((parsed |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
