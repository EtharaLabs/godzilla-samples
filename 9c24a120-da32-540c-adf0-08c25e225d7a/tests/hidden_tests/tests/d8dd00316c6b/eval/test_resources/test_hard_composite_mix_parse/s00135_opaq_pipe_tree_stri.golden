opaque type Sku = string
opaque type Handle = string
let unwrap x =
    match x:
        case (Sku s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let ids = ((mint "acc") 4)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (Sku "u-1"))))
let samples = [(- 9), 24, 40, 19, 8, 33, 22, 37]
let addK k x = (x + k)
let digest = (List.len ((List.map (addK 9)) (((List.chunkBySize 5) >> (List.map List.sum)) (List.sort ((List.collect (fun x -> [x, (x + 1)])) ((List.filter (fun x -> (x > 8))) ((List.pairwise >> (List.map (fun (a, b) -> (b - a)))) samples)))))))
(print digest)
type Term = Num int | Add Term Term | Mul Term Term | Neg Term | Var string
let env = (Map.ofList [("x", 1), ("y", 4)])
let calc e =
    match e:
        case (Num n): n
        case (Add a b): ((calc a) + (calc b))
        case ((Mul (Num 0) _) | (Mul _ (Num 0))): 0
        case (Mul a b): ((calc a) * (calc b))
        case (Neg a): (- (calc a))
        case (Var v): (((Map.findOr v) 0) env)
let pretty e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(pretty a)} + {(pretty b)})"
        case (Mul a b): f"{(pretty a)} * {(pretty b)}"
        case (Neg a): f"-{(pretty a)}"
        case (Var v): v
let terms = [(Var "y"), (Var "y"), (Neg ((Mul (Num 7)) (Num 2)))]
((terms |> (List.map pretty)) |> (List.iter print))
(print ((List.map calc) terms))
let sentence = "gear;ned;oz;max;cap"
let tokens = ((String.split ";") sentence)
(print ((tokens |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
(print (((String.tryIndexOf "ne") sentence), ((String.contains "ne") sentence)))
(print (((tokens |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print ((tokens |> (List.map String.upper)) |> (String.join "|")))
let nums = (((String.split ",") ",7,7,x,-3") |> (List.map String.toInt))
(print nums)
(print ((nums |> (List.choose id)) |> List.sum))
let longest = ((tokens |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
