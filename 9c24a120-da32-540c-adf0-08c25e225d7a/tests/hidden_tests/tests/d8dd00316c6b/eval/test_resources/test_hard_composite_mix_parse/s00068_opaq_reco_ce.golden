--- stdout ---
opaque type UserId = string
opaque type Label = string
let unwrap x =
    match x:
        case (UserId s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let keys = ((mint "acc") 4)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (UserId "u-1"))))
type Parcel = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Parcel { id = 100, owner = "ivy", amount = 146, urgent = false }, Parcel { id = 101, owner = "ada", amount = 70, urgent = false }, Parcel { amount = 176, owner = "eli", id = 102, urgent = true }, Parcel { id = 103, owner = "eli", amount = 112, urgent = true }]
let tag o =
    let Parcel { id, amount } = o
    f"#{id}:{(((Format.padLeft 5) " ") (String.fromInt amount))}"
(print ((parcels |> (List.map tag)) |> (String.join ", ")))
(print (((parcels |> (List.sortByDescending (fun o -> o.amount))) |> (List.take 3)) |> (List.map (fun o -> o.id))))
let byOwner = ((parcels |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
let adjust o = (if o.urgent then { o with amount = (o.amount + 14) } else o)
(print ((parcels |> (List.map adjust)) |> (List.map (fun o -> o.amount))))
let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let entries = ["tom=9=1", "kit=6=1", "quin", "max = 0", "gus=33", "dee = 7"]
let parsed = ((List.map parseEntry) entries)
((List.iter print) parsed)
let goodOnes = (parsed |> (List.choose Result.toOption))
(print (((List.map snd) goodOnes) |> List.sum))
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
