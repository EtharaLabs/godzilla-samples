let raw = "cog,ada,pam,bolt,tom"
let parts = ((String.split ",") raw)
(print (((String.slice 1) 9) raw))
(print (((String.replace "a") "A") raw))
let n2 = (List.len parts)
(print f"n2={n2} {{braces}} {(String.len raw)}")
let row2 (i, w) = ((String.concat (((Format.padRight 8) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((parts |> List.indexed) |> (List.map row2)) |> (List.iter print))
(print (((parts |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print ((parts |> (List.map String.upper)) |> (String.join "|")))
let decodeLine line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let lines = ["hal=49", "max", "jo = 5", "ned=0=1"]
let results = ((List.map decodeLine) lines)
((List.iter print) results)
let errs = ((results |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let sumAll xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((sumAll results) |> (Result.mapError String.upper)))
type Site = { city: string, zone: int }
type Parcel = { id: int, owner: string, amount: int, urgent: bool, dest: Site }
let orders = [Parcel { id = 100, owner = "lu", amount = 261, urgent = true, dest = Site { city = "Oslo", zone = 1 } }, Parcel { id = 101, amount = 149, urgent = true, dest = Site { city = "Lima", zone = 2 }, owner = "hal" }, Parcel { id = 102, owner = "lu", amount = 214, urgent = false, dest = Site { city = "Bern", zone = 3 } }, Parcel { id = 103, owner = "sue", amount = 148, urgent = false, dest = Site { city = "Rome", zone = 4 } }]
let surcharge pct o =
    let extra = ((o.amount * pct) // 100)
    { o with amount = (o.amount + extra), urgent = false }
(print ((orders |> (List.map (surcharge 4))) |> (List.map (fun o -> o.amount))))
let (cnt, sumAmt) = (((List.fold (fun (n, s) o -> ((n + 1), (s + o.amount)))) (0, 0)) orders)
(print f"{cnt} records, {sumAmt} total")
let rerouted = (orders |> (List.map (fun o -> (if (o.dest.zone > 2) then { o with dest.city = "Hub", dest.zone = 1 } else o))))
(print ((List.map (fun o -> f"{o.dest.city}/{o.dest.zone}")) rerouted))
let rushSum = ((orders |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print rushSum)
