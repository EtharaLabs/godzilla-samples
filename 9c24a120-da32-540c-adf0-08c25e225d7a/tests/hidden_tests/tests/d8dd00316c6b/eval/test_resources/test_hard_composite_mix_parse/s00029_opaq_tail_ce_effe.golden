opaque type Sku = string
opaque type Email = string
let rawOf x =
    match x:
        case (Sku s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let ids = ((makeIds "u") 4)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (Sku "acc-1"))))
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [14, 25, 8, 4, 9]))
let accumulate n acc = (if (n == 0) then acc else ((accumulate (n - 1)) (acc + (n * n))))
(print ((accumulate 1152) 0))
let readPair line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 3) }
let inputs = ["dee=8=1", "ray", "max=85", "pam=7=1", "oz=x"]
let parsed = ((List.map readPair) inputs)
((List.iter print) parsed)
(print ((parsed |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((parsed |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
let pure net price qty = ((price * qty) - (9 * qty))
let report label price qty =
    (print f"{label}: {((net price) qty)}")
    ((net price) qty)
let grand = (([("hub", 42, 5), ("hub", 43, 2)] |> (List.map (fun (n, pr, q) -> (((report n) pr) q)))) |> List.sum)
(print grand)
let pure scaled k = (List.map (net k))
(print ((scaled 10) [1, 2, 3]))
