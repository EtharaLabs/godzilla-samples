let (|Above|_|) n = (if (n > 13) then (Some (n - 13)) else None)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([(- 5), 11, 16, 22, 33] |> (List.map classify)) |> (List.iter print))
type Order = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Order { id = 100, owner = "max", amount = 76, urgent = true }, Order { id = 101, owner = "max", amount = 31, urgent = true }, Order { id = 102, owner = "eli", amount = 15, urgent = true }, Order { id = 103, owner = "ned", amount = 269, urgent = true }, Order { id = 104, owner = "max", amount = 36, urgent = false }]
(print ((List.maxBy (fun o -> o.amount)) parcels))
let tag (Order { id, owner }) = f"#{id} {(String.upper owner)}"
(print ((parcels |> (List.map tag)) |> (String.join ", ")))
let priority o =
    match o:
        case Order { urgent = true, amount } if (amount > 191): "rush-big"
        case Order { urgent = true }: "rush"
        case Order { amount }: (if (amount > 191) then "big" else "normal")
(print ((List.map priority) parcels))
(print ((List.countBy priority) parcels))
type Instr = Rest int | Emit | Push
let describe t =
    match t:
        case (Rest n0) if (n0 > 4): f"rest!({n0})"
        case (Rest n0): f"rest({n0})"
        case (Emit | Push): "emit/push"
let cost t =
    match t:
        case Emit: 7
        case _: 3
let stream = [(Rest 0), (Rest (- 3)), (Rest 7), Emit]
(print ((stream |> (List.map describe)) |> (String.join "; ")))
let total = (stream |> (List.sumBy cost))
(print f"total={total}")
(print ((List.maxBy cost) stream))
