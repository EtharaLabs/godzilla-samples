exit: 0
--- stdout ---
opaque type AccountNo = string
opaque type Handle = string
let unwrap x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((mint "acc") 2)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "acc-1"))))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 19) then (Some (n - 19)) else None)
let (|Zero|_|) n = (n == 0)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([2, 12, 2, 36, 17] |> (List.map bucketOf)) |> (List.iter print))
type Msg = Skip int | Emit int | Drop int string | Load int string | Pop int
let describe t =
    match t:
        case (Skip n0): f"skip({n0})"
        case (Emit n0) if (0 <= n0 < 14): f"emit!({n0})"
        case (Emit n0): f"emit({n0})"
        case (Drop n0 s1) if (0 <= n0 < 11): f"drop!({n0},{s1})"
        case (Drop n0 s1): f"drop({n0},{s1})"
        case (Load 3 _): "load-3"
        case (Load n0 s1): f"load({n0},{s1})"
        case (Pop 1): "pop-1"
        case (Pop n0): f"pop({n0})"
let score t =
    match t:
        case (Drop x0 _): (x0 * 4)
        case (Skip x0): (x0 * 5)
        case (Emit x0): x0
        case _: 3
let prog = [(Skip 7), ((Load 8) "kit"), ((Drop 5) "hal"), ((Load (- 1)) "quin"), (Skip 7), (Skip 7), (Pop (- 3))]
((prog |> (List.map describe)) |> print)
let total = (prog |> (List.sumBy score))
(print f"total={total}")
(print (List.sort prog))
--- stderr ---
