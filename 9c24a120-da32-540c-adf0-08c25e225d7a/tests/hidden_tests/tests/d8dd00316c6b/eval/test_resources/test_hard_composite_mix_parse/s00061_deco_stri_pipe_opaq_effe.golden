type Reading = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"ned\", \"points\": 8, \"active\": true}, {\"name\": \"eli\", \"points\": 5, \"active\": true}, {\"name\": \"ivy\", \"points\": 9, \"active\": true}, {\"name\": \"ivy\", \"points\": 72, \"active\": true}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let raw = "max,hub,quin,tap,jo"
let words = ((String.split ",") raw)
let fieldsN = (((String.split ",") "-3,-3,7,12,x") |> (List.map String.toInt))
(print fieldsN)
(print ((fieldsN |> (List.choose id)) |> List.sum))
(print (((String.slice 0) 5) raw))
let longest = ((words |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
(print (((String.tryIndexOf "jo") raw), ((String.contains "jo") raw)))
let row2 (i, w) = ((String.concat (((Format.padRight 6) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((words |> List.indexed) |> (List.map row2)) |> (List.iter print))
let data = [29, 4, 43, 10, (- 2), 0, (- 10), 41, 30, 40]
let shift k x = (x + k)
let answer = (((((data |> ((List.windowed 3) >> (List.map (fun w -> ((Option.withDefault 0) (List.max w)))))) |> List.rev) |> (List.map (fun x -> ((x // 5) + (x % 5))))) |> List.sort) |> ((List.fold (fun acc x -> ((acc * 2) - x))) 0))
(print answer)
opaque type AccountNo = string
opaque type Email = string
let unwrap x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let keys = ((mint "u") 4)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (AccountNo "u-1"))))
let pure margin price qty = ((price * qty) - (5 * qty))
let announce label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let overall = (([("cap", 27, 6), ("nut", 6, 2)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print overall)
