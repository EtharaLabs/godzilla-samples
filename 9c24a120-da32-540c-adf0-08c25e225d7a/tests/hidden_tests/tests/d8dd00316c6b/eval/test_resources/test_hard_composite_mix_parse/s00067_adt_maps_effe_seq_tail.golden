type Move = Mark int | Load | Rest int string | Turn int int
let explain t =
    match t:
        case (Mark n0): f"mark({n0})"
        case Load: f"load"
        case (Rest n0 s1) if ((n0 % 2) == 0): f"rest!({n0},{s1})"
        case (Rest n0 s1): f"rest({n0},{s1})"
        case (Turn n0 n1): f"turn({n0},{n1})"
let weight t =
    match t:
        case (Rest x0 _): (x0 * 2)
        case Load: 7
        case _: 2
let batch = [((Turn 9) 5), ((Rest 7) "ada"), (Mark 8), ((Turn (- 2)) 5), (Mark (- 1))]
(print ((String.join " ") ((List.map explain) batch)))
let tally = (batch |> (List.sumBy weight))
(print f"tally={tally}")
(print (List.sort batch))
let log = ["bo", "fay", "eli", "ada", "bo", "fay"]
let bump m w =
    match ((Map.tryFind w) m):
        case (Some n): (((Map.add w) (n + 1)) m)
        case None: (((Map.add w) 1) m)
let hist = (((List.fold bump) Map.empty) log)
(print ((hist |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print (((hist |> Map.keys) |> List.sort) |> (String.join ",")))
(print ((hist |> (Map.filter (fun k v -> (v > 1)))) |> Map.len))
let pure net price qty = ((price * qty) - (4 * qty))
let emit label price qty =
    (print f"{label}: {((net price) qty)}")
    ((net price) qty)
let overall = (([("cap", 33, 2), ("bolt", 16, 4)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print overall)
let evens = seq {
    for x in ((List.range 1) 7):
        let y = (x * x)
        yield y
    yield 193
}
(((evens |> (Seq.filter (fun n -> ((n % 3) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 3))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 6)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 648)))) |> Seq.toList) |> print)
let steps n acc = (if (n == 1) then acc elif ((n % 2) == 0) then ((steps (n // 2)) (acc + 1)) else ((steps ((3 * n) + 1)) (acc + 1)))
(print ((List.map (fun n -> ((steps n) 0))) [28, 18, 6]))
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [6, 25, 27, 13, 30]))
