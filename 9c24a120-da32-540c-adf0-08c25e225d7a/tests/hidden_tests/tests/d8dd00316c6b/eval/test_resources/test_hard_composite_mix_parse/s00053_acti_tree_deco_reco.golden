exit: 0
--- stdout ---
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let kindOf n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([26, 34, 17, 20, 29] |> (List.map kindOf)) |> (List.iter print))
type Expr = Num int | Add Expr Expr | Mul Expr Expr | Neg Expr | Var string
let env = (Map.ofList [("x", 8), ("y", (- 4))])
let evaluate e =
    match e:
        case (Num n): n
        case (Add a b): ((evaluate a) + (evaluate b))
        case (Mul a b): ((evaluate a) * (evaluate b))
        case (Neg a): (- (evaluate a))
        case (Var v): (((Map.findOr v) 0) env)
let pretty e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(pretty a)} + {(pretty b)})"
        case (Mul a b): f"{(pretty a)} * {(pretty b)}"
        case (Neg a): f"-{(pretty a)}"
        case (Var v): v
let exprs = [(Neg ((Mul ((Add (Num 0)) (Num 2))) ((Mul (Var "y")) (Var "y")))), (Num 0), ((Add ((Mul (Num (- 2))) (Neg (Num (- 1))))) ((Add (Num 1)) (Neg (Num 6))))]
((exprs |> (List.map pretty)) |> (List.iter print))
(print ((List.map evaluate) exprs))
type Reading = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"jo\", \"points\": 40, \"active\": true}, {\"name\": \"ray\", \"points\": 49, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
type Ticket = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Ticket { urgent = false, amount = 233, owner = "bo", id = 100 }, Ticket { id = 101, owner = "bo", amount = 109, urgent = false }, Ticket { id = 102, owner = "gus", amount = 74, urgent = true }, Ticket { amount = 118, urgent = true, owner = "bo", id = 103 }, Ticket { id = 104, owner = "bo", amount = 122, urgent = true }, Ticket { id = 105, owner = "sue", urgent = false, amount = 38 }]
let classify o =
    match o:
        case Ticket { urgent = true, amount } if (amount > 125): "rush-big"
        case Ticket { urgent = true }: "rush"
        case Ticket { amount }: (if (amount > 125) then "big" else "normal")
(print ((List.map classify) parcels))
(print ((List.countBy classify) parcels))
(print (((parcels |> (List.sortByDescending (fun o -> o.amount))) |> (List.take 4)) |> (List.map (fun o -> o.id))))
let rushSum = ((parcels |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print rushSum)
let byOwner = ((parcels |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
