module Calc =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let square x = (x * x)
    let between lo hi x = (lo <= x <= hi)
let nums = [20, 30, (- 12), 1, 27, (- 11)]
(print (Calc.norm1 nums))
(print ((Calc.scaleAll 3) nums))
(print ((List.map Calc.square) nums))
(print ((List.filter ((Calc.between 1) 22)) nums))
type Instr = Skip int | Mark int | Pop int int | Jump | Emit int int
let describe t =
    match t:
        case (Skip 1): "skip-1"
        case (Skip n0): f"skip({n0})"
        case (Mark n0) if (0 <= n0 < 8): f"mark!({n0})"
        case (Mark n0): f"mark({n0})"
        case (Pop n0 n1) if ((n0 % 2) == 0): f"pop!({n0},{n1})"
        case (Pop n0 n1): f"pop({n0},{n1})"
        case Jump: f"jump"
        case (Emit 2 _): "emit-2"
        case (Emit n0 n1): f"emit({n0},{n1})"
let weight t =
    match t:
        case (Pop x0 x1): (x0 + (x1 * 3))
        case (Skip x0): (x0 * 4)
        case Jump: 6
        case _: 2
let stream = [((Emit 6) 5), Jump, ((Pop 5) 12), (Skip 6), (Mark 10)]
((List.iter (fun t -> (print (describe t)))) stream)
let total = (stream |> (List.sumBy weight))
(print f"total={total}")
(print ((List.maxBy weight) stream))
extern pure isqrt: int -> int = math.isqrt
(print ((List.map isqrt) [149, 348, 313, 105]))
extern pure choose: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (choose n)))
(print (row 5))
extern pure loud: string -> string = str.upper
(print (("ada" |> loud) |> String.rev))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 28) then (Some (n - 28)) else None)
let (|Zero|_|) n = (n == 0)
let kindOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([12, 20, 10, 35, 21, 1] |> (List.map kindOf)) |> (List.iter print))
