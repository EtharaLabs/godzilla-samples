type Token = Turn string | Drop string | Emit | Rest
let show t =
    match t:
        case (Turn s0): f"turn({s0})"
        case (Drop s0): f"drop({s0})"
        case (Emit | Rest): "emit/rest"
let score t =
    match t:
        case Emit: 9
        case _: 1
let stream = [(Drop "pam"), (Turn "pam"), (Turn "pam"), Emit, (Drop "kit"), (Drop "tom"), (Turn "kit")]
(print ((stream |> (List.map show)) |> (String.join "; ")))
let total2 = (stream |> (List.sumBy score))
(print f"total2={total2}")
(print ((stream |> (List.filter (fun t -> ((score t) > 0)))) |> List.len))
let text = "dee gear cy rod"
let tokens = ((String.split " ") text)
(print (((String.replace "a") "A") text))
let row2 (i, w) = ((String.concat (((Format.padRight 6) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((tokens |> List.indexed) |> (List.map row2)) |> (List.iter print))
(print ((tokens |> (List.map String.upper)) |> (String.join "|")))
type Booking = { id: int, owner: string, amount: int, urgent: bool }
let orders = [Booking { urgent = true, id = 100, owner = "max", amount = 91 }, Booking { owner = "max", amount = 5, id = 101, urgent = false }, Booking { id = 102, owner = "bo", urgent = true, amount = 10 }, Booking { id = 103, owner = "pam", amount = 276, urgent = false }]
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 122))) orders)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
(print (((orders |> (List.sortBy (fun o -> o.amount))) |> (List.take 4)) |> (List.map (fun o -> o.id))))
(print ((List.maxBy (fun o -> o.amount)) orders))
let urgentTotal = ((orders |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
let pure discount price qty = ((price * qty) - (4 * qty))
let report label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let overall = (([("pin", 8, 5), ("wick", 50, 2), ("tap", 34, 2)] |> (List.map (fun (n, pr, q) -> (((report n) pr) q)))) |> List.sum)
(print overall)
let pure scaled k = (List.map (discount k))
(print ((scaled 7) [1, 2, 3]))
