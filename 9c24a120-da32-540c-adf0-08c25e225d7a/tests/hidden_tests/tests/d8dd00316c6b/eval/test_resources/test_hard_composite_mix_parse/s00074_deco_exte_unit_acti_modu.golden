type Reading = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"sue\", \"points\": 85, \"active\": true}, {\"name\": \"oz\", \"points\": 11, \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [3, 6, 3, 10]))
extern parseHex: string -> int = int(base=16)
(print ((["ff", "7"] |> (List.map parseHex)) |> List.sum))
extern readBase: string -> int -> int = int(base=...)
let fromBin s = ((readBase s) 2)
(print ((fromBin "1001011") + ((readBase "22") 8)))
extern pure choose: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (choose n)))
(print (row 6))
measure m
measure s
measure kg
let laps = [413.9<m>, 283.8<m>, 156.4<m>]
let durations = [48.2<s>, 48.8<s>, 80.8<s>]
let total = (((List.fold (fun acc d -> (acc + d))) 0.0<m>) laps)
let elapsed = (((List.fold (+)) 0.0<s>) durations)
let rate = (total / elapsed)
(print ((Format.fixed 2) rate))
let speeds = (((List.map2 (fun d t -> (d / t))) laps) durations)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let km = (total / 1000.0)
(print ((Format.fixed 1) km))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 29) then (Some (n - 29)) else None)
let (|Zero|_|) n = (n == 0)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([16, 32, 24, 3, 25, 2] |> (List.map bucketOf)) |> (List.iter print))
module Geo =
    let square x = (x * x)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let scaleAll k xs = ((List.map ((*) k)) xs)
let obs = [24, 20, 30, 19, 11, 19]
(print ((List.map Geo.square) obs))
(print (Geo.mean obs))
(print ((Geo.scaleAll 3) obs))
