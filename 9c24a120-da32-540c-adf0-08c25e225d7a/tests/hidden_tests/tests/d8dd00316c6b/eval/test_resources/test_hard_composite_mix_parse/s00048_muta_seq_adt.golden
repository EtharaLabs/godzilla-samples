let mut hits = 0
let record x =
    (hits <- (hits + 1))
    (x * 2)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [16, 60, 60, 37, 21, 22, 10, (- 15)]))
let doubled = ([16, 60, 60, 37] |> (List.map record))
(print f"{doubled} after {hits} calls")
let squares = seq {
    for x in ((List.range 1) 11):
        let y = (x * x)
        yield y
    yield 169
}
(print (((Seq.fold (+)) 0) squares))
(((((Seq.initInfinite (fun i -> (i * 3))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 6)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 1306)))) |> Seq.toList) |> print)
type Signal = Turn int | Load int | Mark int int
let explain t =
    match t:
        case (Turn n0) if (n0 > 4): f"turn!({n0})"
        case (Turn n0): f"turn({n0})"
        case (Load n0) if (0 <= n0 < 10): f"load!({n0})"
        case (Load n0): f"load({n0})"
        case (Mark 1 _): "mark-1"
        case (Mark n0 n1): f"mark({n0},{n1})"
let rank t =
    match t:
        case (Mark x0 x1): (x0 + x1)
        case _: 1
let batch = [(Turn 1), ((Mark 8) 9), ((Mark 0) 3), (Turn 5)]
((List.iter (fun t -> (print (explain t)))) batch)
let tally = (batch |> (List.sumBy rank))
(print f"tally={tally}")
(print ((List.maxBy rank) batch))
