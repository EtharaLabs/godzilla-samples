type Token = Emit string | Mark | Halt int string | Store int int
let render t =
    match t:
        case (Emit s0): f"emit({s0})"
        case Mark: f"mark"
        case (Halt n0 s1): f"halt({n0},{s1})"
        case (Store n0 n1): f"store({n0},{n1})"
let score t =
    match t:
        case Mark: 6
        case (Emit _): 5
        case _: 1
