exit: 0
--- stdout ---
let readPair line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 5) }
let inputs = ["lu", "bo = 3", "dee=x", "quin=x"]
let parsed = ((List.map readPair) inputs)
((List.iter print) parsed)
(print ((parsed |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((parsed |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
extern toNum: string -> int = int
let safe s =
    match (try (toNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x0", "17"] |> (List.map safe)) |> (List.iter print))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [4, 11, 10, 2]))
let pure margin price qty = ((price * qty) - (8 * qty))
let announce label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let overall = (([("cog", 49, 6), ("pin", 34, 4), ("pin", 46, 5), ("rod", 28, 1)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print overall)
type Action = Drop int | Store int | Jump | Load int
let render t =
    match t:
        case (Drop n0): f"drop({n0})"
        case (Store n0) if ((n0 % 2) == 0): f"store!({n0})"
        case (Store n0): f"store({n0})"
        case Jump: f"jump"
        case (Load n0) if (n0 > 6): f"load!({n0})"
        case (Load n0): f"load({n0})"
let cost t =
    match t:
        case (Load x0): x0
        case Jump: 7
        case (Store x0): x0
        case _: 1
let prog = [(Load 2), (Load (- 2)), Jump, (Store 1)]
((prog |> (List.map render)) |> print)
let grandSum = (prog |> (List.sumBy cost))
(print f"grandSum={grandSum}")
(print ((prog |> (List.filter (fun t -> ((cost t) > 0)))) |> List.len))
