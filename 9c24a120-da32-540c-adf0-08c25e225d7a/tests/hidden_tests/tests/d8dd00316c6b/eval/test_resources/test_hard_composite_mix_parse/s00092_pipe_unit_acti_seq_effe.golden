measure m
measure s
measure kg
measure N = kg m/s^2
let legs = [107.4<m>, 426.8<m>, 10.7<m>, 395.1<m>, 54.4<m>]
let times = [77.5<s>, 50.8<s>, 73.0<s>, 24.2<s>, 16.3<s>]
