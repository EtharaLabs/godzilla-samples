let (|Above|_|) n = (if (n > 7) then (Some (n - 7)) else None)
let (|Zero|_|) n = (n == 0)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case m if (m < 0): "negative"
        case _: "small"
(([35, (- 6), 21, 5, 21, 8] |> (List.map classify)) |> (List.iter print))
