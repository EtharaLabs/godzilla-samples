let pure margin price qty = ((price * qty) - (8 * qty))
let emit label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let grand = (([("nut", 50, 5), ("cog", 8, 1), ("cog", 10, 4), ("tap", 48, 1)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print grand)
