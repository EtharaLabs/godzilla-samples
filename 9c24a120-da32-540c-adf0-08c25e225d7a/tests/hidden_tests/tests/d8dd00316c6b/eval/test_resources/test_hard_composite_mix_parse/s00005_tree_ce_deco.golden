exit: 0
--- stdout ---
type Term = Num int | Add Term Term | Mul Term Term | Neg Term | Var string
let env = (Map.ofList [("x", 1), ("y", 8)])
let evalE e =
    match e:
        case (Num n): n
        case (Add a b): ((evalE a) + (evalE b))
        case ((Mul (Num 0) _) | (Mul _ (Num 0))): 0
        case (Mul a b): ((evalE a) * (evalE b))
        case (Neg a): (- (evalE a))
        case (Var v): (((Map.findOr v) 0) env)
let render e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(render a)} + {(render b)})"
        case (Mul a b): f"{(render a)} * {(render b)}"
        case (Neg a): f"-{(render a)}"
        case (Var v): v
let simplify e =
    match e:
        case ((Add (Num 0) x) | (Add x (Num 0))): (simplify x)
        case ((Mul (Num 1) x) | (Mul x (Num 1))): (simplify x)
        case (Neg (Neg x)): (simplify x)
        case (Add a b): ((Add (simplify a)) (simplify b))
        case (Mul a b): ((Mul (simplify a)) (simplify b))
        case _: e
let exprs = [((Add (Num 1)) ((Add ((Add (Var "x")) (Num 1))) ((Add (Var "y")) (Var "y")))), ((Mul (Neg ((Add (Num 1)) (Num 6)))) (Num 3))]
(((exprs |> (List.map simplify)) |> (List.map render)) |> (List.iter print))
(print ((List.map evalE) exprs))
let readPair line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let inputs = ["bo", "hal=x", "max=7", "ivy=9=1", "cy = 6"]
let parsed = ((List.map readPair) inputs)
((List.iter print) parsed)
let goodOnes = (parsed |> (List.choose Result.toOption))
(print (((List.map snd) goodOnes) |> List.sum))
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
type Reading = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"sue\", \"points\": 70, \"active\": true}, {\"name\": \"kit\", \"points\": 19, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
