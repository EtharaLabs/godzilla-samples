let series = seq {
    for x in ((List.range 1) 8):
        let y = (x * x)
        yield y
}
(((series |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 3))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 6)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 1724)))) |> Seq.toList) |> print)
type Heap = Leaf | Node Heap int Heap
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let tree = (((List.fold (fun acc x -> ((insert x) acc))) Leaf) [57, 29, 6, 37, 13, 39])
let minT t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minT l)
(print (minT tree))
let containsT x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsT x) l) else ((containsT x) rt))
(print ((List.map (fun k -> ((containsT k) tree))) [57, 40, 59]))
let sumT t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumT l) + v) + (sumT rt))
(print (sumT tree))
let pure margin price qty = ((price * qty) - (6 * qty))
let announce label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let grand = (([("bolt", 46, 6), ("wick", 40, 4)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print grand)
let pure scaled k = (List.map (margin k))
(print ((scaled 5) [1, 2, 3]))
