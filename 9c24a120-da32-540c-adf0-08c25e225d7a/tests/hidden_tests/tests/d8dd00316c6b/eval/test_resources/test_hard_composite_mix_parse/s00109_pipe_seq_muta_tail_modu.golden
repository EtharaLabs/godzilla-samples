let readings = [49, (- 8), (- 2), (- 8), 35, (- 5), (- 2), 21, (- 7)]
let process = ((((List.chunkBySize 5) >> (List.map List.sum)) >> (List.indexed >> (List.map (fun (i, x) -> (i * x))))) >> (List.filter (fun x -> ((x % 3) == 2))))
let result = ((readings |> process) |> List.len)
(print result)
let series = seq {
    for x in ((List.range 1) 9):
        let y = (x * x)
        yield y
    yield 166
}
(((series |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 3))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 6)) |> Seq.toList) |> print)
let mut calls = 0
let note x =
    (calls <- (calls + 1))
    (x * 2)
let stats xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (stats [(- 13), (- 6), 22, 17]))
let doubled = ([(- 13), (- 6), 22, 17] |> (List.map note))
(print f"{doubled} after {calls} calls")
let countDown n acc = (if (n == 0) then acc else ((countDown (n - 1)) (acc + (n * n))))
(print ((countDown 2021) 0))
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [30, 10, 21, 3, 16]))
let digitSum n =
    match n:
        case 0: 0
        case _: ((n % 10) + (digitSum (n // 10)))
(print (digitSum 51462))
module Calc =
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let between lo hi x = (lo <= x <= hi)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let clamp lo hi x = ((max lo) ((min hi) x))
let obs = [(- 5), 5, 20, 10, (- 13), (- 4)]
(print ((Calc.scaleAll 4) obs))
(print ((List.filter ((Calc.between 2) 25)) obs))
(print (Calc.mean obs))
(print (obs |> (List.map ((Calc.clamp 0) 19))))
