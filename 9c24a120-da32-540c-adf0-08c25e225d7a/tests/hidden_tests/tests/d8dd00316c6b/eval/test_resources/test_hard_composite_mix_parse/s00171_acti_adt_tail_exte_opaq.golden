exit: 0
--- stdout ---
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let kindOf n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([29, 37, (- 6), 3, 14] |> (List.map kindOf)) |> (List.iter print))
type Action = Mark int | Drop int string | Load int | Jump
let show t =
    match t:
        case (Mark n0): f"mark({n0})"
        case (Drop n0 s1): f"drop({n0},{s1})"
        case (Load n0) if ((n0 % 2) == 0): f"load!({n0})"
        case (Load n0): f"load({n0})"
        case Jump: f"jump"
let cost t =
    match t:
        case (Mark x0): x0
        case Jump: 6
        case _: 2
let stream = [((Drop 7) "ada"), (Load 8), ((Drop 10) "sue"), (Load 8), (Load 1)]
((List.iter (fun t -> (print (show t)))) stream)
let total = (stream |> (List.sumBy cost))
(print f"total={total}")
(print ((List.head stream), (List.last stream)))
let gcdLoop a b = (if (b == 0) then a else ((gcdLoop b) (a % b)))
(print ((gcdLoop 357) 457))
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [7, 5, 11, 15, 7]))
let ipow b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((ipow b) (k - 1)) (acc * b))
        case k: (((ipow (b * b)) (k // 2)) acc)
(print (((ipow 2) 7) 1))
extern fromHex: string -> int = int(base=16)
(print ((["ff", "100"] |> (List.map fromHex)) |> List.sum))
extern pure comb: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (comb n)))
(print (row 3))
opaque type Sku = string
opaque type Handle = string
let unwrap x =
    match x:
        case (Sku s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let keys = ((mint "sku") 2)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (Sku "acc-1"))))
