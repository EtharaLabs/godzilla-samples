let text = "pam tom nut ray gus"
let tokens = ((String.split " ") text)
(print ((tokens |> (List.map String.upper)) |> (String.join "|")))
(print ((tokens |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
(print (((tokens |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
type Reading = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"dee\", \"points\": 96, \"active\": false}, {\"name\": \"ada\", \"points\": 51, \"active\": false}, {\"name\": \"lu\", \"points\": 21, \"active\": false}]"
match ((Decode.decodeString (Decode.list playerDecoder)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let data = [18, 36, 20, 50, 32, 16]
let stage = ((((List.map (fun x -> ((x * x) - 5))) >> List.rev) >> (List.collect (fun x -> [x, (x + 1)]))) >> (List.choose (fun x -> (if ((x % 4) == 0) then (Some (x // 4)) else None))))
let result = ((data |> stage) |> List.len)
(print result)
let events = ["dee", "bo", "eli", "eli", "cy", "cy", "fay", "ada"]
let counts = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) events)
(print ((counts |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
let extra = (Map.ofList [("zed", 5), ("dee", 0)])
(print ((((Map.union extra) counts) |> Map.toList) |> List.sort))
let sa = (Set.ofList [2, 7, 8, 10, 12, 13])
let sb = (Set.ofList [1, 4, 5, 8, 16, 17])
(print ((((Set.intersect sa) sb) |> Set.toList) |> List.sort))
(print ((Set.len sa), ((Set.contains 19) sb), ((Set.isSubset (Set.ofList [2])) sa)))
(print (((Map.fold (fun acc k v -> (acc + v))) 0) counts))
(print ((counts |> (Map.filter (fun k v -> (v > 1)))) |> Map.len))
let readPair line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let lines = ["ada=6=1", "pam=73", "max=25", "hal=x", "tom=x"]
let parsed = ((List.map readPair) lines)
((List.iter print) parsed)
let errs = ((parsed |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
