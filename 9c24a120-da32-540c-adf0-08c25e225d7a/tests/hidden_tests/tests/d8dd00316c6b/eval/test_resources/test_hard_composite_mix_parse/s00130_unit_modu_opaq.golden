exit: 0
--- stdout ---
measure m
measure s
measure kg
measure N = kg m/s^2
let legs = [252.0<m>, 34.6<m>, 313.7<m>, 468.6<m>, 410.5<m>]
let times = [42.2<s>, 70.6<s>, 48.1<s>, 66.3<s>, 62.3<s>]
let dist = (((List.fold (fun acc d -> (acc + d))) 0.0<m>) legs)
let dur = (((List.fold (+)) 0.0<s>) times)
let pace = (dist / dur)
(print ((Format.fixed 2) pace))
let km = (dist / 1000.0)
(print ((Format.fixed 1) km))
let mass = 60.0<kg>
let accel = 6.5<m/s^2>
let push = (mass * accel)
let limit = 284.0<N>
(print (if (push > limit) then "over" else "under"))
let best = (((List.zip legs) times) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let speeds = (((List.map2 (fun d t -> (d / t))) legs) times)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
module Geo =
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let clamp lo hi x = ((max lo) ((min hi) x))
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let nums = [(- 9), (- 1), (- 2), 25, 19]
(print ((Geo.scaleAll 5) nums))
(print (nums |> (List.map ((Geo.clamp 0) 12))))
(print (Geo.mean nums))
opaque type AccountNo = string
opaque type Label = string
let unwrap x =
    match x:
        case (AccountNo s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let keys = ((makeIds "acc") 2)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (AccountNo "acc-1"))))
