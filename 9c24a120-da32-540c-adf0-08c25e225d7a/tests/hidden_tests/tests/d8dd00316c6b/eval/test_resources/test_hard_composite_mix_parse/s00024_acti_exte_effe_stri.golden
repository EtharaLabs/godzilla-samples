let (|Above|_|) n = (if (n > 14) then (Some (n - 14)) else None)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([24, 35, 36, (- 6), 32, (- 5), 19] |> (List.map classify)) |> (List.iter print))
extern parseNum: string -> int = int
let safe s =
    match (try (parseNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x5", "37"] |> (List.map safe)) |> (List.iter print))
extern pure intRoot: int -> int = math.isqrt
(print ((List.map intRoot) [27, 337, 10, 133]))
let pure net price qty = ((price * qty) - (2 * qty))
let emit label price qty =
    (print f"{label}: {((net price) qty)}")
    ((net price) qty)
let overall = (([("gear", 37, 4), ("wick", 17, 1)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print overall)
