exit: 0
--- stdout ---
let pure discount price qty = ((price * qty) - (6 * qty))
let report label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let overall = (([("tap", 33, 5), ("hub", 15, 3), ("cog", 36, 4), ("wick", 18, 6)] |> (List.map (fun (n, pr, q) -> (((report n) pr) q)))) |> List.sum)
(print overall)
type Reading = { name: string, points: int, active: bool }
let decoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"fay\", \"points\": 22, \"active\": false}, {\"name\": \"gus\", \"points\": 96, \"active\": true}]"
match ((Decode.decodeString (Decode.list decoder)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
module Calc =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let between lo hi x = (lo <= x <= hi)
let nums = [5, (- 15), 6, 30, 13]
(print (nums |> (List.map ((Calc.clamp 0) 18))))
(print ((Calc.scaleAll 3) nums))
(print ((List.filter ((Calc.between 3) 11)) nums))
type Msg = Drop int | Push string int | Mark
let describe t =
    match t:
        case (Drop n0) if ((n0 % 2) == 0): f"drop!({n0})"
        case (Drop n0): f"drop({n0})"
        case (Push s0 n1): f"push({s0},{n1})"
        case Mark: f"mark"
let cost t =
    match t:
        case (Push _ x1): x1
        case (Drop x0): x0
        case _: 1
let batch = [Mark, (Drop 5), Mark, (Drop 5), Mark]
((batch |> (List.map describe)) |> print)
let tally = (batch |> (List.sumBy cost))
(print f"tally={tally}")
(print ((List.maxBy cost) batch))
