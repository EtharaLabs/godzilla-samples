let readings = [(- 3), 37, 13, 28, 25, (- 9), (- 7), 24, (- 6)]
let offset k x = (x + k)
let accept n = ((n > 7) and ((n % 5) != 0))
let outcome = ((List.reduce (fun a b -> (a + b))) ((List.indexed >> (List.map (fun (i, x) -> (i * x)))) ((List.drop 1) ((List.take 4) (List.rev readings)))))
(print outcome)
(print <| (List.len readings))
type Order = { id: int, owner: string, amount: int, urgent: bool }
let book = [Order { owner = "fay", urgent = false, amount = 135, id = 100 }, Order { id = 101, owner = "dee", amount = 190, urgent = false }, Order { amount = 92, id = 102, urgent = true, owner = "dee" }, Order { id = 103, owner = "fay", amount = 128, urgent = false }, Order { amount = 25, urgent = false, owner = "dee", id = 104 }]
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 113))) book)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
(print (((book |> (List.sortBy (fun o -> o.amount))) |> (List.take 4)) |> (List.map (fun o -> o.id))))
let tag (Order { id, owner }) = f"#{id} {(String.upper owner)}"
(print ((book |> (List.map tag)) |> (String.join ", ")))
extern pure shout: string -> string = str.upper
(print (("oz" |> shout) |> String.rev))
extern readBase: string -> int -> int = int(base=...)
let fromBin s = ((readBase s) 2)
(print ((fromBin "111110") + ((readBase "27") 8)))
type Reading = { name: string, points: int, active: bool }
let playerDecoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"cy\", \"points\": 76, \"active\": false}, {\"name\": \"ned\", \"points\": 6, \"active\": true}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list playerDecoder)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
