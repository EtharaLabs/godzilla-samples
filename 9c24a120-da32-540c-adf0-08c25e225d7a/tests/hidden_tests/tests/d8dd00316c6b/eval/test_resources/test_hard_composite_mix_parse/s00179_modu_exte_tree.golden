--- stdout ---
module Calc =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let clamp lo hi x = ((max lo) ((min hi) x))
    let between lo hi x = (lo <= x <= hi)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let pts = [28, (- 3), (- 11), 3, 14, (- 6), 0]
(print (Calc.norm1 pts))
(print (pts |> (List.map ((Calc.clamp 0) 7))))
(print ((List.filter ((Calc.between 1) 17)) pts))
(print (Calc.mean pts))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [9, 7, 12, 7]))
extern toNum: string -> int = int
let safe s =
    match (try (toNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x6", "30"] |> (List.map safe)) |> (List.iter print))
extern pure shout: string -> string = str.upper
(print (("ivy" |> shout) |> String.rev))
extern parseIn: string -> int -> int = int(base=...)
let fromBin s = ((parseIn s) 2)
(print ((fromBin "1100010") + ((parseIn "50") 8)))
type Term = Num int | Add Term Term | Mul Term Term | Neg Term
let evaluate e =
    match e:
        case (Num n): n
        case (Add a b): ((evaluate a) + (evaluate b))
        case ((Mul (Num 0) _) | (Mul _ (Num 0))): 0
        case (Mul a b): ((evaluate a) * (evaluate b))
        case (Neg a): (- (evaluate a))
let render e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(render a)} + {(render b)})"
        case (Mul a b): f"{(render a)} * {(render b)}"
        case (Neg a): f"-{(render a)}"
let exprs = [(Num 6), ((Mul ((Add ((Add (Num 0)) (Num 5))) (Neg (Num 1)))) (Neg ((Mul (Num (- 1))) (Num 8))))]
((exprs |> (List.map render)) |> (List.iter print))
(print ((List.map evaluate) exprs))
