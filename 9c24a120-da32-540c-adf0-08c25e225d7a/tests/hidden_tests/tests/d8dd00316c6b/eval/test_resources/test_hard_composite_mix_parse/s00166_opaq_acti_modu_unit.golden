exit: 0
--- stdout ---
opaque type Sku = string
opaque type Handle = string
let rawOf x =
    match x:
        case (Sku s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let ids = ((mint "acc") 4)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (Sku "u-1"))))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 19) then (Some (n - 19)) else None)
let (|Zero|_|) n = (n == 0)
let kindOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([30, 39, 15, 8, 18] |> (List.map kindOf)) |> (List.iter print))
module Geo =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let between lo hi x = (lo <= x <= hi)
    let scaleAll k xs = ((List.map ((*) k)) xs)
let nums = [(- 15), 14, 7, 2, 1, 19, 20]
(print (Geo.norm1 nums))
(print ((List.filter ((Geo.between 4) 14)) nums))
(print ((Geo.scaleAll 4) nums))
measure m
measure s
measure kg
measure N = kg m/s^2
let segments = [71.6<m>, 372.0<m>, 444.0<m>]
let splits = [35.5<s>, 17.8<s>, 85.4<s>]
let total = (((List.fold (+)) 0.0<m>) segments)
let elapsed = (((List.fold (+)) 0.0<s>) splits)
let pace = (total / elapsed)
(print ((Format.fixed 2) pace))
let mass = 80.0<kg>
let accel = 1.5<m/s^2>
let push = (mass * accel)
let limit = 68.0<N>
(print (if (push > limit) then "over" else "under"))
let best = (((List.zip segments) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
