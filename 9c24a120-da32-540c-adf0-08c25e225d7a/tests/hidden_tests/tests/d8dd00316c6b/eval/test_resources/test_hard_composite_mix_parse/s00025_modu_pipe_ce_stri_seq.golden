(print fieldsN)
(print ((fieldsN |> (List.choose id)) |> List.sum))
(print (((String.slice 3) 4) raw))
(print (((String.tryIndexOf "hu") raw), ((String.contains "hu") raw)))
let squares = seq {
    for x in ((List.range 1) 8):
        let y = (x * x)
        yield y
}
(((squares |> (Seq.filter (fun n -> ((n % 4) == 0)))) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 4))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 5)) |> Seq.toList) |> print)
