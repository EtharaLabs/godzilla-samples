exit: 0
--- stdout ---
extern parseIn: string -> int -> int = int(base=...)
let fromBin s = ((parseIn s) 2)
(print ((fromBin "1000101") + ((parseIn "110") 8)))
extern parseNum: string -> int = int
let safe s =
    match (try (parseNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x5", "31"] |> (List.map safe)) |> (List.iter print))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 25) then (Some (n - 25)) else None)
let kindOf n =
    match n:
        case (Above d): f"above by {d}"
        case Even: "even"
        case _: "odd"
(([14, 16, (- 5), 4, 33, 17, 5] |> (List.map kindOf)) |> (List.iter print))
let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let inputs = ["cy=63", "lu", "jo = 2", "sue = 0", "ray=x"]
let parsed = ((List.map parseEntry) inputs)
((List.iter print) parsed)
let errs = ((parsed |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let sumAll xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((sumAll parsed) |> (Result.mapError String.upper)))
let values = [10, 43, 11, 21, 47, 28, 23, 7, 29]
let keep n = ((n > 8) and ((n % 3) != 0))
let pipeline = (((List.indexed >> (List.map (fun (i, x) -> (i * x)))) >> (List.map (max 5))) >> (List.map ((-) 55)))
let outcome = ((values |> pipeline) |> (List.exists (fun x -> (x > 28))))
(print outcome)
let series = seq {
    for x in ((List.range 1) 11):
        let y = (x * x)
        yield y
}
(print (((Seq.fold (+)) 0) series))
(((((Seq.initInfinite (fun i -> (i * 2))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 5)) |> Seq.toList) |> print)
