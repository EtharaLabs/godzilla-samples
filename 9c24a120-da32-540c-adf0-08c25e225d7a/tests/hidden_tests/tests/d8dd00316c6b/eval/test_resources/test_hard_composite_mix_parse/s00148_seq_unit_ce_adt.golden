let legs = [294.6<m>, 264.9<m>, 112.2<m>]
let splits = [12.0<s>, 43.6<s>, 41.7<s>]
let dist = (legs |> ((List.fold (fun acc d -> (acc + (d * 1.0)))) 0.0<m>))
let dur = (((List.fold (+)) 0.0<s>) splits)
let speed = (dist / dur)
(print ((Format.fixed 2) speed))
let speeds = (((List.map2 (fun d t -> (d / t))) legs) splits)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let best = (((List.zip legs) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
