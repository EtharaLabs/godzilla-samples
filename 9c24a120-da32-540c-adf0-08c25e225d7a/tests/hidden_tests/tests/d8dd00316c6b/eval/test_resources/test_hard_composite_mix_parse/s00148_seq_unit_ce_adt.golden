let parseEntry line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 4) }
let entries = ["oz", "ray=x", "lu=4=1", "pam"]
let results = ((List.map parseEntry) entries)
((List.iter print) results)
(print ((results |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((results |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
type Cmd = Rest string | Mark string | Emit int int | Jump int
let render t =
    match t:
        case (Rest s0): f"rest({s0})"
        case (Mark s0): f"mark({s0})"
        case (Emit n0 n1): f"emit({n0},{n1})"
        case (Jump n0): f"jump({n0})"
let score t =
    match t:
        case (Jump x0): x0
        case (Rest _): 8
        case (Emit x0 x1): (x0 + x1)
        case _: 3
let stream = [(Rest "hal"), (Mark "ned"), (Jump (- 2)), ((Emit 9) (- 2)), ((Emit 3) 6)]
((List.iter (fun t -> (print (render t)))) stream)
let total = (stream |> (List.sumBy score))
(print f"total={total}")
(print ((List.head stream), (List.last stream)))
