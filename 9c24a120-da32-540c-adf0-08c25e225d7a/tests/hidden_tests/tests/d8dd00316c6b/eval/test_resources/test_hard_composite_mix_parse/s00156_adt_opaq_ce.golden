exit: 0
--- stdout ---
type Move = Skip int | Halt int | Turn | Push int
let describe t =
    match t:
        case (Skip n0): f"skip({n0})"
        case (Halt n0) if (0 <= n0 < 3): f"halt!({n0})"
        case (Halt n0): f"halt({n0})"
        case Turn: f"turn"
        case (Push 1): "push-1"
        case (Push n0): f"push({n0})"
let cost t =
    match t:
        case (Halt x0): x0
        case _: 2
let prog = [Turn, (Skip 0), (Halt (- 3)), (Skip 10)]
(print ((String.join " ") ((List.map describe) prog)))
let tally = (prog |> (List.sumBy cost))
(print f"tally={tally}")
(print ((prog |> (List.filter (fun t -> ((cost t) > 2)))) |> List.len))
opaque type UserId = string
opaque type Label = string
let unwrap x =
    match x:
        case (UserId s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let ids = ((makeIds "u") 2)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (UserId "acc-1"))))
let decodeLine line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 3) }
let entries = ["eli", "cy = 9", "oz=67", "bo", "ivy=2=1"]
let results = ((List.map decodeLine) entries)
((List.iter print) results)
(print ((results |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((results |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
