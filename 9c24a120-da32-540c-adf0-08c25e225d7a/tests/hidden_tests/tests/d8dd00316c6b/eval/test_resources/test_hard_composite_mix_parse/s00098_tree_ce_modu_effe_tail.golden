type Ast = Num int | Add Ast Ast | Mul Ast Ast | Neg Ast | Var string
let vars = (Map.ofList [("x", 6), ("y", 4)])
let evalE e =
    match e:
        case (Num n): n
        case (Add a b): ((evalE a) + (evalE b))
        case ((Mul (Num 0) _) | (Mul _ (Num 0))): 0
        case (Mul a b): ((evalE a) * (evalE b))
        case (Neg a): (- (evalE a))
        case (Var v): (((Map.findOr v) 0) vars)
let show e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(show a)} + {(show b)})"
        case (Mul a b): f"{(show a)} * {(show b)}"
        case (Neg a): f"-{(show a)}"
        case (Var v): v
let terms = [((Mul (Neg ((Add (Num 4)) (Var "x")))) (Num 4)), (Neg (Neg (Var "y"))), (Neg ((Add (Num 0)) ((Add (Num 0)) (Num 5))))]
((terms |> (List.map show)) |> (List.iter print))
(print ((List.map evalE) terms))
let parseEntry line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 2) }
let inputs = ["kit = 8", "quin=90", "ivy=41", "bo=2=1", "eli=5=1"]
let results = ((List.map parseEntry) inputs)
((List.iter print) results)
(print ((results |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((results |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
module Stats =
    let square x = (x * x)
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let nums = [(- 3), 13, (- 4), 26, 6, (- 8)]
(print ((List.map Stats.square) nums))
(print ((Stats.scaleAll 3) nums))
(print (Stats.mean nums))
let pure margin price qty = ((price * qty) - (3 * qty))
let report label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let overall = (([("rod", 28, 4), ("gear", 49, 1)] |> (List.map (fun (n, pr, q) -> (((report n) pr) q)))) |> List.sum)
(print overall)
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [14, 0, 28, 9, 4]))
let collatz n acc = (if (n == 1) then acc elif ((n % 2) == 0) then ((collatz (n // 2)) (acc + 1)) else ((collatz ((3 * n) + 1)) (acc + 1)))
(print ((List.map (fun n -> ((collatz n) 0))) [11, 57, 20]))
