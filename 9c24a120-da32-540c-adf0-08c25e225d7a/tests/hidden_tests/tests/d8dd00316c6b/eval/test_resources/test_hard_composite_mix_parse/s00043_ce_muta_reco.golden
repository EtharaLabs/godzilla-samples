let readPair line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let inputs = ["bo=x", "kit=8=1", "ivy=x", "jo = 2"]
let results = ((List.map readPair) inputs)
((List.iter print) results)
let goodOnes = (results |> (List.choose Result.toOption))
(print (((List.map snd) goodOnes) |> List.sum))
let sumAll xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((sumAll results) |> (Result.mapError String.upper)))
let mut ticks = 0
let note x =
    (ticks <- (ticks + 1))
    (x * 2)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [(- 1), 56, 55, 46, 42, 31, 9]))
let doubled = ([(- 1), 56, 55, 46] |> (List.map note))
(print f"{doubled} after {ticks} calls")
type Place = { city: string, zone: int }
type Invoice = { id: int, owner: string, amount: int, urgent: bool, dest: Place }
let book = [Invoice { id = 100, owner = "ivy", amount = 271, urgent = true, dest = Place { city = "Oslo", zone = 4 } }, Invoice { id = 101, owner = "max", amount = 94, urgent = true, dest = Place { city = "Rome", zone = 3 } }, Invoice { id = 102, owner = "gus", amount = 117, urgent = true, dest = Place { city = "Bern", zone = 4 } }, Invoice { urgent = false, id = 103, dest = Place { city = "Rome", zone = 3 }, owner = "gus", amount = 243 }, Invoice { id = 104, owner = "gus", amount = 161, urgent = true, dest = Place { city = "Bern", zone = 4 } }, Invoice { id = 105, owner = "gus", amount = 132, urgent = true, dest = Place { city = "Rome", zone = 3 } }]
let (cnt, amt) = (((List.fold (fun (n, s) o -> ((n + 1), (s + o.amount)))) (0, 0)) book)
(print f"{cnt} records, {amt} total")
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 140))) book)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
(print (((book |> (List.sortBy (fun o -> o.amount))) |> (List.take 3)) |> (List.map (fun o -> o.id))))
(print ((List.maxBy (fun o -> o.amount)) book))
