exit: 0
--- stdout ---
let readPair line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) let! checked = (if (n < 0) then (Error "negative") else (Ok n)) return (k, checked) }
let inputs = ["pam=x", "dee=46", "sue = 0", "kit=x"]
let parsed = ((List.map readPair) inputs)
((List.iter print) parsed)
let errs = ((parsed |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let firstGood = ((((parsed |> (List.map Result.toOption)) |> (List.choose id)) |> List.head) |> (Option.map fst))
match firstGood:
    case (Some name): (print f"first: {name}")
    case None: (print "none parsed")
let combine xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((combine parsed) |> (Result.mapError String.upper)))
opaque type AccountNo = string
opaque type Handle = string
let rawOf x =
    match x:
        case (AccountNo s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let keys = ((mint "sku") 3)
(print ((keys |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head keys) == (Some (AccountNo "acc-1"))))
let euclid a b = (if (b == 0) then a else ((euclid b) (a % b)))
(print ((euclid 495) 496))
let ipow b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((ipow b) (k - 1)) (acc * b))
        case k: (((ipow (b * b)) (k // 2)) acc)
(print (((ipow 4) 15) 1))
let countDown n acc = (if (n == 0) then acc else ((countDown (n - 1)) (acc + (n * n))))
(print ((countDown 662) 0))
