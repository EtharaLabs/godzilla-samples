exit: 0
--- stdout ---
extern toNum: string -> int = int
let safe s =
    match (try (toNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x2", "-13"] |> (List.map safe)) |> (List.iter print))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [2, 7, 8, 6]))
type Action = Skip int | Mark int | Rest int | Push int
let explain t =
    match t:
        case (Skip 3): "skip-3"
        case (Skip n0): f"skip({n0})"
        case (Mark n0) if (0 <= n0 < 17): f"mark!({n0})"
        case (Mark n0): f"mark({n0})"
        case (Rest n0): f"rest({n0})"
        case (Push n0): f"push({n0})"
let cost t =
    match t:
        case (Skip x0): (x0 * 4)
        case (Rest x0): (x0 * 3)
        case (Push x0): (x0 * 5)
        case _: 0
let queue = [(Skip 7), (Rest 2), (Push (- 3)), (Rest 5)]
(print ((queue |> (List.map explain)) |> (String.join "; ")))
let grandSum = (queue |> (List.sumBy cost))
(print f"grandSum={grandSum}")
(print ((List.head queue), (List.last queue)))
let mut calls = 0
let note x =
    (calls <- (calls + 1))
    (x * 2)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [38, (- 18), 49, 42, (- 8)]))
let doubled = ([38, (- 18), 49, 42] |> (List.map note))
(print f"{doubled} after {calls} calls")
let noteTwice = (note >> note)
(print ((noteTwice 3), calls))
