module Calc =
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let clamp lo hi x = ((max lo) ((min hi) x))
let pts = [7, 18, 3, 9, 23]
(print (Calc.mean pts))
(print (Calc.norm1 pts))
(print (pts |> (List.map ((Calc.clamp 0) 8))))
type Parcel = { id: int, owner: string, amount: int, urgent: bool }
let orders = [Parcel { id = 100, owner = "ned", amount = 17, urgent = false }, Parcel { id = 101, owner = "cy", amount = 269, urgent = true }, Parcel { id = 102, owner = "ned", amount = 143, urgent = false }, Parcel { id = 103, owner = "cy", amount = 138, urgent = false }]
(print (((orders |> (List.sortByDescending (fun o -> o.amount))) |> (List.take 2)) |> (List.map (fun o -> o.id))))
let line (Parcel { id, owner }) = f"#{id} {(String.upper owner)}"
(print ((orders |> (List.map line)) |> (String.join ", ")))
let perOwner = ((orders |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print perOwner)
let urgentTotal = ((orders |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
