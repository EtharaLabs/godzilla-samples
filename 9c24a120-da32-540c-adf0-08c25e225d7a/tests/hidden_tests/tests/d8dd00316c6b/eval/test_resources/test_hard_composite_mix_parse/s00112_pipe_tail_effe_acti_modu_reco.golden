let pure margin price qty = ((price * qty) - (2 * qty))
let report label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let overall = (([("hub", 8, 1), ("wick", 21, 3), ("wick", 32, 6)] |> (List.map (fun (n, pr, q) -> (((report n) pr) q)))) |> List.sum)
