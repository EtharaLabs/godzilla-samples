let raw = "tap;nut;eli;gear"
let parts = ((String.split ";") raw)
(print (((parts |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print ((List.map (fun w -> (w, (String.len w)))) parts))
(print ((parts |> (List.map String.upper)) |> (String.join "|")))
let cell (i, w) = ((String.concat (((Format.padRight 7) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((parts |> List.indexed) |> (List.map cell)) |> (List.iter print))
let count = (List.len parts)
