let log = ["eli", "dee", "eli", "ada", "fay", "bo", "ada"]
let bump m w =
    match ((Map.tryFind w) m):
        case (Some n): (((Map.add w) (n + 1)) m)
        case None: (((Map.add w) 1) m)
let freq = (((List.fold bump) Map.empty) log)
(print ((freq |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print (((freq |> Map.keys) |> List.sort) |> (String.join ",")))
(print (((Map.fold (fun acc k v -> (acc + v))) 0) freq))
(print (((Map.tryFind "cy") freq), ((Map.contains "cy") freq)))
extern pure loud: string -> string = str.upper
(print (("max" |> loud) |> String.rev))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [2, 10, 4, 8]))
extern pure choose: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (choose n)))
(print (row 3))
measure m
measure s
measure kg
measure N = kg m/s^2
let laps = [152.4<m>, 19.6<m>, 103.5<m>, 120.9<m>]
let splits = [51.4<s>, 44.1<s>, 80.8<s>, 65.0<s>]
let dist = (laps |> ((List.fold (fun acc d -> (acc + (d * 1.0)))) 0.0<m>))
let elapsed = (((List.fold (+)) 0.0<s>) splits)
let speed = (dist / elapsed)
(print ((Format.fixed 2) speed))
let best = (((List.zip laps) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let speeds = (((List.map2 (fun d t -> (d / t))) laps) splits)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
type Instr = Push int | Pop int | Skip int string
let explain t =
    match t:
        case (Push n0) if (0 <= n0 < 3): f"push!({n0})"
        case (Push n0): f"push({n0})"
        case (Pop n0) if (n0 > 4): f"pop!({n0})"
        case (Pop n0): f"pop({n0})"
        case (Skip n0 s1) if (n0 > 2): f"skip!({n0},{s1})"
        case (Skip n0 s1): f"skip({n0},{s1})"
let cost t =
    match t:
        case (Pop x0): (x0 * 4)
        case (Skip x0 _): x0
        case _: 2
let stream = [(Push (- 2)), ((Skip 1) "gus"), (Push 3), (Pop 6), (Push (- 2)), (Push 5), (Push 12)]
(print ((String.join " ") ((List.map explain) stream)))
let grandSum = (stream |> (List.sumBy cost))
(print f"grandSum={grandSum}")
(print ((List.maxBy cost) stream))
