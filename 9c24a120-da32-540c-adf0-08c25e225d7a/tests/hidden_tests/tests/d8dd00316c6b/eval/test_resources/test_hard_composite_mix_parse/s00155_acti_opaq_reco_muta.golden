let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let kindOf n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([40, 14, 35, 7, 25, 12, 13] |> (List.map kindOf)) |> (List.iter print))
opaque type AccountNo = string
opaque type Label = string
let rawOf x =
    match x:
        case (AccountNo s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((makeIds "sku") 4)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "u-1"))))
type Parcel = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Parcel { id = 100, owner = "fay", amount = 5, urgent = false }, Parcel { id = 101, owner = "fay", amount = 65, urgent = false }, Parcel { id = 102, owner = "hal", amount = 57, urgent = true }, Parcel { id = 103, owner = "hal", amount = 121, urgent = true }, Parcel { id = 104, owner = "quin", amount = 240, urgent = true }]
(print (((parcels |> (List.sortByDescending (fun o -> o.amount))) |> (List.take 2)) |> (List.map (fun o -> o.id))))
let byOwner = ((parcels |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
let tag (Parcel { id, owner }) = f"#{id} {(String.upper owner)}"
(print ((parcels |> (List.map tag)) |> (String.join ", ")))
let mut ticks = 0
let track x =
    (ticks <- (ticks + 1))
    (x * 2)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [17, 52, (- 2), (- 14), 40, 53]))
let doubled = ([17, 52, (- 2), (- 14)] |> (List.map track))
(print f"{doubled} after {ticks} calls")
