let text = "ada;wick;dee;max;tom;nut"
let words = ((String.split ";") text)
(print ((words |> (List.map String.upper)) |> (String.join "|")))
(print ((words |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
let longest = ((words |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
(print ((List.map (fun w -> (w, (String.len w)))) words))
let fieldsN = (((String.split ",") "12,,12,-3,x") |> (List.map String.toInt))
(print fieldsN)
(print ((fieldsN |> (List.choose id)) |> List.sum))
(print (((String.tryIndexOf "ma") text), ((String.contains "ma") text)))
let parseEntry line = result { let! (k, v) = (match ((String.split "=") line): case [k, v]: (Ok ((String.strip k), (String.strip v))) case _: (Error f"malformed: {line}")) let! n = ((Option.toResult f"not a number: {v}") (String.toInt v)) return (k, n) }
let entries = ["jo", "eli", "bo=x", "ada=x"]
let results = ((List.map parseEntry) entries)
((List.iter print) results)
let errs = ((results |> (List.filter Result.isError)) |> List.len)
(print f"{errs} errors")
let sumAll xs = (((List.fold (fun acc r -> result { let! total = acc let! (_, n) = r return (total + n) })) (Ok 0)) xs)
(print ((sumAll results) |> (Result.mapError String.upper)))
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [19, 13, 13, 12, 28]))
let powAcc b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((powAcc b) (k - 1)) (acc * b))
        case k: (((powAcc (b * b)) (k // 2)) acc)
(print (((powAcc 4) 8) 1))
let steps n acc = (if (n == 1) then acc elif ((n % 2) == 0) then ((steps (n // 2)) (acc + 1)) else ((steps ((3 * n) + 1)) (acc + 1)))
(print ((List.map (fun n -> ((steps n) 0))) [49, 6, 39]))
