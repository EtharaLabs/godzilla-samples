let legs = [349.0<m>, 413.2<m>, 310.6<m>, 125.4<m>, 374.4<m>]
let splits = [75.5<s>, 75.1<s>, 87.2<s>, 83.7<s>, 30.3<s>]
let dist = (((List.fold (+)) 0.0<m>) legs)
let elapsed = (((List.fold (+)) 0.0<s>) splits)
let pace = (dist / elapsed)
(print ((Format.fixed 2) pace))
let best = (((List.zip legs) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let km = (dist / 1000.0)
(print ((Format.fixed 1) km))
type Entry = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Entry { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"fay\", \"points\": 48, \"active\": true}, {\"name\": \"ray\", \"points\": 39, \"active\": true}, {\"name\": \"ned\", \"points\": 30, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let pure margin price qty = ((price * qty) - (4 * qty))
let emit label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let overall = (([("cap", 34, 1), ("nut", 19, 6)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print overall)
let pure scaled k = (List.map (margin k))
(print ((scaled 18) [1, 2, 3]))
