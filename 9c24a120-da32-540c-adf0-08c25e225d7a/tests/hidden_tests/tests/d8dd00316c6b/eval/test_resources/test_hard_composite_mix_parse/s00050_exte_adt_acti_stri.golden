exit: 0
--- stdout ---
extern parseHex: string -> int = int(base=16)
(print ((["ff", "7"] |> (List.map parseHex)) |> List.sum))
extern pure shout: string -> string = str.upper
(print (("eli" |> shout) |> String.rev))
extern readBase: string -> int -> int = int(base=...)
let fromBin s = ((readBase s) 2)
(print ((fromBin "10010") + ((readBase "120") 8)))
extern parseNum: string -> int = int
let safe s =
    match (try (parseNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x7", "-27"] |> (List.map safe)) |> (List.iter print))
type Signal = Mark int | Pop int | Load string int | Jump
let show t =
    match t:
        case (Mark n0) if (n0 > 9): f"mark!({n0})"
        case (Mark n0): f"mark({n0})"
        case (Pop n0) if (n0 > 4): f"pop!({n0})"
        case (Pop n0): f"pop({n0})"
        case (Load s0 n1): f"load({s0},{n1})"
        case Jump: f"jump"
let cost t =
    match t:
        case (Pop x0): x0
        case (Mark x0): (x0 * 4)
        case Jump: 1
        case _: 2
let prog = [(Pop 12), ((Load "max") 11), (Mark 4), (Pop 1), Jump]
((prog |> (List.map show)) |> print)
let total = (prog |> (List.sumBy cost))
(print f"total={total}")
(print ((List.maxBy cost) prog))
let (|Above|_|) n = (if (n > 6) then (Some (n - 6)) else None)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([0, (- 6), 1, (- 4), 3] |> (List.map classify)) |> (List.iter print))
let text = "wick,gus,cap,cy,bolt"
let tokens = ((String.split ",") text)
(print ((tokens |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
(print (((tokens |> (List.map String.rev)) |> List.rev) |> (String.join " ")))
(print (((String.tryIndexOf "cy") text), ((String.contains "cy") text)))
let fieldsN = (((String.split ",") "12,12,7,-3,40") |> (List.map String.toInt))
(print fieldsN)
(print ((fieldsN |> (List.choose id)) |> List.sum))
(print ((tokens |> (List.map String.upper)) |> (String.join "|")))
(print ((List.map (fun w -> (w, (String.len w)))) tokens))
