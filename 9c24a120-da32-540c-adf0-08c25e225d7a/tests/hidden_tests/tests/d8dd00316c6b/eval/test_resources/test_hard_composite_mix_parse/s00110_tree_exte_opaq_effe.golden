type Heap = Leaf | Node Heap int Heap
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let root = (((List.fold (fun acc x -> ((insert x) acc))) Leaf) [16, 19, 53, 40, 43, 44, 21, 7, 18])
let toListT t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListT l)) ((List.concat [v]) (toListT rt)))
(print (toListT root))
let sumT t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumT l) + v) + (sumT rt))
(print (sumT root))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [7, 9, 5, 10]))
extern toNum: string -> int = int
let safe s =
    match (try (toNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x4", "-31"] |> (List.map safe)) |> (List.iter print))
extern pure shout: string -> string = str.upper
(print (("sue" |> shout) |> String.rev))
opaque type Sku = string
opaque type Label = string
let rawOf x =
    match x:
        case (Sku s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let ids = ((makeIds "sku") 4)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (Sku "u-1"))))
let pure discount price qty = ((price * qty) - (9 * qty))
let emit label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let overall = (([("cog", 39, 6), ("hub", 18, 5), ("pin", 36, 2), ("gear", 10, 2)] |> (List.map (fun (n, pr, q) -> (((emit n) pr) q)))) |> List.sum)
(print overall)
