let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let classify n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([5, 9, 18, 40, 37, 39, 28] |> (List.map classify)) |> (List.iter print))
let readings = [42, 25, (- 2), 18, 48, 24, 30, 42]
let isBig n = ((n > 11) and ((n % 4) != 0))
let process = (((List.drop 3) >> (List.indexed >> (List.map (fun (i, x) -> (i * x))))) >> (List.take 8))
let outcome = ((readings |> process) |> (List.sumBy (fun x -> (x * x))))
(print outcome)
let parseEntry line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 5) }
let lines = ["bo=8=1", "jo=69", "gus = 7", "dee", "oz = 5", "quin=7=1"]
