exit: 0
--- stdout ---
type Instr = Skip string | Emit int string | Jump int | Store string int | Rest string
let render t =
    match t:
        case (Skip s0): f"skip({s0})"
        case (Emit n0 s1) if ((n0 % 2) == 0): f"emit!({n0},{s1})"
        case (Emit n0 s1): f"emit({n0},{s1})"
        case (Jump 2): "jump-2"
        case (Jump n0): f"jump({n0})"
        case (Store s0 n1): f"store({s0},{n1})"
        case (Rest s0): f"rest({s0})"
let cost t =
    match t:
        case (Emit x0 _): x0
        case (Rest _): 2
        case _: 1
let queue = [((Emit 5) "ned"), (Skip "cy"), ((Store "dee") 7), (Rest "lu"), (Rest "quin")]
(print ((String.join " ") ((List.map render) queue)))
let tally = (queue |> (List.sumBy cost))
(print f"tally={tally}")
(print ((queue |> (List.filter (fun t -> ((cost t) > 4)))) |> List.len))
module Calc =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let clamp lo hi x = ((max lo) ((min hi) x))
let obs = [10, (- 6), 24, 16, 19]
(print (Calc.norm1 obs))
(print ((Calc.scaleAll 4) obs))
(print (Calc.mean obs))
(print (obs |> (List.map ((Calc.clamp 0) 13))))
type Player = { name: string, points: int, active: bool }
let decoder = ((((Decode.map3 (fun n p a -> Player { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"pam\", \"points\": 90, \"active\": true}, {\"name\": \"jo\", \"points\": 52, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list decoder)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
