--- stdout ---
opaque type AccountNo = string
opaque type Label = string
let unwrap x =
    match x:
        case (AccountNo s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((makeIds "acc") 3)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "acc-1"))))
let decodeLine line = option { let! v = (((String.split "=") line) |> (List.get 1)) let! n = (String.toInt (String.strip v)) return (n * 5) }
let lines = ["hal = 9", "gus = 1", "max=49", "kit=9=1", "lu = 0"]
let results = ((List.map decodeLine) lines)
((List.iter print) results)
(print ((results |> (List.map (Option.withDefault 0))) |> List.sum))
(print (((results |> (List.map (Option.map (fun n -> (n + 1))))) |> (List.filter Option.isSome)) |> List.len))
module Text =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let square x = (x * x)
let obs = [(- 6), 23, (- 8), 27, 24, 21]
(print (obs |> (List.map ((Text.clamp 0) 12))))
(print (Text.norm1 obs))
(print ((List.map Text.square) obs))
let series = seq {
    for x in ((List.range 1) 11):
        let y = (x * x)
        yield y
}
((((series |> (Seq.map (fun n -> (n + 1)))) |> (Seq.take 5)) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 6))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 6)) |> Seq.toList) |> print)
let fib = ((Seq.unfold (fun (a, b) -> (Some (a, (b, (a + b)))))) (0, 1))
(((fib |> (Seq.takeWhile (fun n -> (n < 1460)))) |> Seq.toList) |> print)
