let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 13) then (Some (n - 13)) else None)
let (|Zero|_|) n = (n == 0)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([40, 4, 27, 39, (- 5)] |> (List.map bucketOf)) |> (List.iter print))
measure m
measure s
measure kg
measure N = kg m/s^2
let segments = [295.9<m>, 226.0<m>, 312.5<m>, 294.7<m>, 456.6<m>]
let splits = [14.3<s>, 20.8<s>, 8.4<s>, 65.0<s>, 82.4<s>]
let total = (((List.fold (+)) 0.0<m>) segments)
let dur = (((List.fold (+)) 0.0<s>) splits)
let pace = (total / dur)
(print ((Format.fixed 1) pace))
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf total) dur) * 1000.0)))
let best = (((List.zip segments) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let side = (sqrt 49.0<m^2>)
let cube = ((side * side) * side)
(print f"{side} {(cbrt cube)}")
let speeds = (((List.map2 (fun d t -> (d / t))) segments) splits)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
extern pure loud: string -> string = str.upper
(print (("gus" |> loud) |> String.rev))
extern parseIn: string -> int -> int = int(base=...)
let fromBin s = ((parseIn s) 2)
(print ((fromBin "11000") + ((parseIn "31") 8)))
extern parseHex: string -> int = int(base=16)
(print ((["ff", "100"] |> (List.map parseHex)) |> List.sum))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [8, 9, 12, 5]))
