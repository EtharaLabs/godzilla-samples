exit: 0
--- stdout ---
extern pure loud: string -> string = str.upper
(print (("ada" |> loud) |> String.rev))
extern pure intRoot: int -> int = math.isqrt
(print ((List.map intRoot) [49, 171, 141, 398]))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [5, 4, 12, 6]))
extern toNum: string -> int = int
let safe s =
    match (try (toNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x4", "-2"] |> (List.map safe)) |> (List.iter print))
type Ast = Num int | Add Ast Ast | Mul Ast Ast | Neg Ast
let evaluate e =
    match e:
        case (Num n): n
        case (Add a b): ((evaluate a) + (evaluate b))
        case (Mul a b): ((evaluate a) * (evaluate b))
        case (Neg a): (- (evaluate a))
let pretty e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(pretty a)} + {(pretty b)})"
        case (Mul a b): f"{(pretty a)} * {(pretty b)}"
        case (Neg a): f"-{(pretty a)}"
let shrink e =
    match e:
        case ((Add (Num 0) x) | (Add x (Num 0))): (shrink x)
        case ((Mul (Num 1) x) | (Mul x (Num 1))): (shrink x)
        case (Neg (Neg x)): (shrink x)
        case (Add a b): ((Add (shrink a)) (shrink b))
        case (Mul a b): ((Mul (shrink a)) (shrink b))
        case _: e
let exprs = [(Num 7), ((Mul ((Add (Num 1)) ((Mul (Num (- 1))) (Num 4)))) (Neg (Neg (Num 2))))]
(((exprs |> (List.map shrink)) |> (List.map pretty)) |> (List.iter print))
(print ((List.map evaluate) exprs))
type Entry = { name: string, points: int, active: bool }
let decoder = ((((Decode.map3 (fun n p a -> Entry { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"ivy\", \"points\": 90, \"active\": true}, {\"name\": \"gus\", \"points\": 46, \"active\": true}, {\"name\": \"bo\", \"points\": 27, \"active\": true}, {\"name\": \"jo\", \"points\": 32, \"active\": true}]"
match ((Decode.decodeString (Decode.list decoder)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
