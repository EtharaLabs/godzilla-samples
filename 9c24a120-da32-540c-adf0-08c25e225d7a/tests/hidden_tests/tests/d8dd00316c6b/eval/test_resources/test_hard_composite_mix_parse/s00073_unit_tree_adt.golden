exit: 0
--- stdout ---
measure m
measure s
measure kg
let segments = [277.0<m>, 184.0<m>, 147.1<m>, 366.4<m>, 94.7<m>]
let durations = [77.3<s>, 88.6<s>, 40.7<s>, 59.9<s>, 31.2<s>]
let dist = (((List.fold (+)) 0.0<m>) segments)
let dur = (((List.fold (+)) 0.0<s>) durations)
let pace = (dist / dur)
(print ((Format.fixed 2) pace))
let km = (dist / 1000.0)
(print ((Format.fixed 1) km))
let best = (((List.zip segments) durations) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let speeds = (((List.map2 (fun d t -> (d / t))) segments) durations)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
type Heap = Leaf | Node Heap int Heap
let add x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((add x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((add x) rt))
        case (Node _ _ _): t
let tree = ([10, 35, 24, 41, 31, 28, 47, 45] |> ((List.fold (flip add)) Leaf))
let containsOf x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsOf x) l) else ((containsOf x) rt))
(print ((List.map (fun k -> ((containsOf k) tree))) [10, 46, 21]))
let toListOf t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListOf l)) ((List.concat [v]) (toListOf rt)))
(print (toListOf tree))
let minOf t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minOf l)
(print (minOf tree))
type Instr = Store string | Mark string | Rest string int
let explain t =
    match t:
        case (Store s0): f"store({s0})"
        case (Mark s0): f"mark({s0})"
        case (Rest s0 n1): f"rest({s0},{n1})"
let weight t =
    match t:
        case (Mark _): 1
        case (Rest _ x1): x1
        case _: 2
let prog = [(Store "quin"), ((Rest "max") 12), ((Rest "dee") (- 3)), (Store "fay"), (Mark "ada"), (Mark "lu"), ((Rest "cy") (- 1))]
((prog |> (List.map explain)) |> print)
let total = (prog |> (List.sumBy weight))
(print f"total={total}")
(print ((List.maxBy weight) prog))
