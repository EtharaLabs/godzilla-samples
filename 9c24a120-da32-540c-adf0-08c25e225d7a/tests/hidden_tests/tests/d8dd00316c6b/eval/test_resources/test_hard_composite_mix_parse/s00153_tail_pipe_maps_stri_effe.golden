let shift k x = (x + k)
let pipeline = ((((((List.distinctBy (fun x -> (x % 5))) >> (List.collect (fun x -> [x, (x + 1)]))) >> (List.choose (fun x -> (if ((x % 2) == 0) then (Some (x // 2)) else None)))) >> (List.filter (fun x -> ((x % 3) == 1)))) >> (List.dropWhile (fun x -> (x < 3)))) >> (List.map (shift 1)))
let result = ((readings |> pipeline) |> (List.find (fun x -> ((x % 3) == 1))))
(print result)
