let visits = ["bo", "ada", "bo", "cy", "cy", "cy", "eli"]
let bump m w =
    match ((Map.tryFind w) m):
        case (Some n): (((Map.add w) (n + 1)) m)
        case None: (((Map.add w) 1) m)
let counts = (((List.fold bump) Map.empty) visits)
(print ((counts |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print (((Map.tryFind "dee") counts), ((Map.contains "dee") counts)))
(print (((Map.fold (fun acc k v -> (acc + v))) 0) counts))
module Stats =
    let between lo hi x = (lo <= x <= hi)
    let clamp lo hi x = ((max lo) ((min hi) x))
    let square x = (x * x)
let pts = [(- 6), 10, 4, 17, 26, 21]
(print ((List.filter ((Stats.between (- 3)) 21)) pts))
(print (pts |> (List.map ((Stats.clamp 0) 19))))
(print ((List.map Stats.square) pts))
