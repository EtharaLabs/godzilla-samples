let readings = [50, (- 4), 27, 40, 40, 33, 39, 25]
let addK k x = (x + k)
let keep n = ((n > 3) and ((n % 2) != 0))
let digest = ((((((readings |> List.distinct) |> (List.dropWhile (fun x -> (x < 3)))) |> (List.drop 1)) |> (List.pairwise >> (List.map (fun (a, b) -> (b - a))))) |> (List.collect (fun x -> [x, (x + 1)]))) |> (List.exists (fun x -> (x > 39))))
(print digest)
let raw = "gear,cap,cog,bo,rod,tom"
let parts = ((String.split ",") raw)
(print (((String.slice 1) 8) raw))
let nums = (((String.split ",") "5a,,x,7,-3") |> (List.map String.toInt))
