type Reading = { name: string, points: int, active: bool }
let decoder = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"cy\", \"points\": 11, \"active\": true}, {\"name\": \"tom\", \"points\": 4, \"active\": true}, {\"name\": \"ray\", \"points\": 12, \"active\": false}, {\"name\": \"gus\", \"points\": 47, \"active\": true}]"
match ((Decode.decodeString (Decode.list decoder)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let text = "pam,max,ivy,gus,eli"
let tokens = ((String.split ",") text)
(print ((tokens |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
let nums = (((String.split ",") "5a,7,5a,12,5a") |> (List.map String.toInt))
(print nums)
(print ((nums |> (List.choose id)) |> List.sum))
(print (((String.tryIndexOf "el") text), ((String.contains "el") text)))
let longest = ((tokens |> (List.sortBy (fun w -> (- (String.len w))))) |> List.head)
(print ((Option.withDefault "?") longest))
measure m
measure s
measure kg
measure N = kg m/s^2
let segments = [173.3<m>, 361.1<m>, 377.0<m>, 145.5<m>, 201.6<m>]
let splits = [55.0<s>, 36.5<s>, 54.4<s>, 21.7<s>, 30.3<s>]
let total = (((List.fold (fun acc d -> (acc + d))) 0.0<m>) segments)
let dur = (((List.fold (+)) 0.0<s>) splits)
let rate = (total / dur)
(print ((Format.fixed 1) rate))
let best = (((List.zip segments) splits) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let km = (total / 1000.0)
(print ((Format.fixed 1) km))
let mass = 79.0<kg>
let accel = 7.5<m/s^2>
let push = (mass * accel)
let limit = 180.0<N>
(print (if (push > limit) then "over" else "under"))
let speeds = (((List.map2 (fun d t -> (d / t))) segments) splits)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
