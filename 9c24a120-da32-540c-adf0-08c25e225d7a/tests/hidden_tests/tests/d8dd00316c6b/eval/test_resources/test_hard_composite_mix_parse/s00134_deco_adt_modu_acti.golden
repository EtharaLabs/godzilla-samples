--- stdout ---
type Entry = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Entry { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let payload = "[{\"name\": \"oz\", \"points\": 32, \"active\": true}, {\"name\": \"lu\", \"points\": 74, \"active\": false}, {\"name\": \"ned\", \"points\": 56, \"active\": true}, {\"name\": \"dee\", \"points\": 12, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) payload):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
type Msg = Mark string | Jump int | Rest | Emit int int
let explain t =
    match t:
        case (Mark s0): f"mark({s0})"
        case (Jump n0): f"jump({n0})"
        case Rest: f"rest"
        case (Emit n0 n1): f"emit({n0},{n1})"
let weight t =
    match t:
        case (Jump x0): x0
        case (Mark _): 7
        case (Emit x0 x1): (x0 + x1)
        case _: 2
let prog = [(Jump 10), (Mark "ada"), (Mark "max"), ((Emit 5) 12), Rest, (Mark "gus"), ((Emit 9) 8)]
(print ((prog |> (List.map explain)) |> (String.join "; ")))
let grandSum = (prog |> (List.sumBy weight))
(print f"grandSum={grandSum}")
(print ((List.maxBy weight) prog))
module Calc =
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let square x = (x * x)
    let clamp lo hi x = ((max lo) ((min hi) x))
let nums = [11, (- 1), 2, 5, 21, 21, (- 11)]
(print ((Calc.scaleAll 2) nums))
(print (Calc.norm1 nums))
(print ((List.map Calc.square) nums))
(print (nums |> (List.map ((Calc.clamp 0) 8))))
let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let (|Above|_|) n = (if (n > 16) then (Some (n - 16)) else None)
let (|Zero|_|) n = (n == 0)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case Even: "even"
        case _: "odd"
(([10, (- 4), (- 5), 37, 37, 16, 12, 24] |> (List.map classify)) |> (List.iter print))
