let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let classify n =
    match n:
        case Even: "even"
        case Odd: "odd"
(([15, 34, 40, (- 4), 17, 13] |> (List.map classify)) |> (List.iter print))
let events = ["eli", "ada", "fay", "ada", "bo", "fay", "cy", "bo"]
let bump m w =
    match ((Map.tryFind w) m):
        case (Some n): (((Map.add w) (n + 1)) m)
        case None: (((Map.add w) 1) m)
let counts = (((List.fold bump) Map.empty) events)
(print ((counts |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print (((Map.fold (fun acc k v -> (acc + v))) 0) counts))
let extra = (Map.ofList [("zed", 5), ("eli", 0)])
(print ((((Map.union extra) counts) |> Map.toList) |> List.sort))
(print (((counts |> (Map.map (fun k v -> (v * 10)))) |> Map.values) |> List.sort))
type Heap = Leaf | Node Heap int Heap
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let tree = (((List.fold (fun acc x -> ((insert x) acc))) Leaf) [9, 4, 16, 52, 26, 12])
let containsT x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsT x) l) else ((containsT x) rt))
(print ((List.map (fun k -> ((containsT k) tree))) [9, 13, 48]))
let sumT t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumT l) + v) + (sumT rt))
(print (sumT tree))
let depthOf t =
    match t:
        case Leaf: 0
        case (Node l _ rt): (1 + ((max (depthOf l)) (depthOf rt)))
(print (depthOf tree))
let minOf t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minOf l)
(print (minOf tree))
