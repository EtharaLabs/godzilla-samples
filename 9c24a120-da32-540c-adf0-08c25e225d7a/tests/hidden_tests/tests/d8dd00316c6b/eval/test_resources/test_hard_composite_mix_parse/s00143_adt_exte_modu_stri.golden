type Move = Mark int | Store string int | Push int string
let describe t =
    match t:
        case (Mark n0): f"mark({n0})"
        case (Store s0 n1): f"store({s0},{n1})"
        case (Push n0 s1): f"push({n0},{s1})"
let score t =
    match t:
        case (Store _ x1): x1
        case _: 2
let prog = [(Mark 1), ((Store "max") 0), (Mark 8), (Mark 8), ((Push 10) "lu")]
((List.iter (fun t -> (print (describe t)))) prog)
let tally = (prog |> (List.sumBy score))
(print f"tally={tally}")
(print ((prog |> (List.filter (fun t -> ((score t) > 1)))) |> List.len))
extern parseNum: string -> int = int
let safe s =
    match (try (parseNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x6", "36"] |> (List.map safe)) |> (List.iter print))
extern pure intRoot: int -> int = math.isqrt
(print ((List.map intRoot) [57, 164, 56, 287]))
module Text =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let square x = (x * x)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let nums = [25, (- 4), 8, 9, 4, (- 6), 26]
(print (nums |> (List.map ((Text.clamp 0) 16))))
(print (Text.norm1 nums))
(print ((List.map Text.square) nums))
(print (Text.mean nums))
let sentence = "rod hal tap tom nut kit ned"
let words = ((String.split " ") sentence)
(print ((words |> (List.map (fun w -> ((((String.slice 0) 1) w) |> String.upper)))) |> (String.join "")))
let cell (i, w) = ((String.concat (((Format.padRight 7) ".") w)) (((Format.padLeft 4) " ") (String.fromInt (i + 1))))
(((words |> List.indexed) |> (List.map cell)) |> (List.iter print))
let nums2 = (((String.split ",") "x,5a,,5a,40") |> (List.map String.toInt))
(print nums2)
(print ((nums2 |> (List.choose id)) |> List.sum))
(print (((String.tryIndexOf "nu") sentence), ((String.contains "nu") sentence)))
