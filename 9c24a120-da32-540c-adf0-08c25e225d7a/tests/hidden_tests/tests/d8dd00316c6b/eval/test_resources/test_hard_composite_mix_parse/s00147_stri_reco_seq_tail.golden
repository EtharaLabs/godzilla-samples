type Ticket = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Ticket { id = 100, owner = "eli", amount = 109, urgent = true }, Ticket { id = 101, owner = "ada", amount = 275, urgent = false }, Ticket { id = 102, owner = "dee", amount = 110, urgent = false }, Ticket { id = 103, owner = "dee", amount = 160, urgent = true }, Ticket { id = 104, owner = "eli", amount = 29, urgent = true }]
let urgentTotal = ((parcels |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
let bump2 o = (if o.urgent then { o with amount = (o.amount + 16) } else o)
(print ((parcels |> (List.map bump2)) |> (List.map (fun o -> o.amount))))
let series = seq {
    for x in ((List.range 1) 8):
        let y = (x * x)
        yield y
}
((((series |> (Seq.map (fun n -> (n + 1)))) |> (Seq.take 4)) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 5))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 2)) |> Seq.toList) |> print)
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
(print ((List.filter isEven) [21, 17, 12, 7, 14]))
let powAcc b e acc =
    match e:
        case 0: acc
        case k if ((k % 2) == 1): (((powAcc b) (k - 1)) (acc * b))
        case k: (((powAcc (b * b)) (k // 2)) acc)
(print (((powAcc 7) 3) 1))
let gcdLoop a b = (if (b == 0) then a else ((gcdLoop b) (a % b)))
(print ((gcdLoop 245) 43))
