exit: 0
--- stdout ---
extern pure comb: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (comb n)))
(print (row 4))
extern pure shout: string -> string = str.upper
(print (("ivy" |> shout) |> String.rev))
extern parseHex: string -> int = int(base=16)
(print ((["ff", "c0"] |> (List.map parseHex)) |> List.sum))
extern parseIn: string -> int -> int = int(base=...)
let fromBin s = ((parseIn s) 2)
(print ((fromBin "1011010") + ((parseIn "26") 8)))
type Ticket = { id: int, owner: string, amount: int, urgent: bool }
let book = [Ticket { id = 100, owner = "gus", amount = 45, urgent = false }, Ticket { id = 101, owner = "jo", amount = 67, urgent = false }, Ticket { id = 102, owner = "max", amount = 276, urgent = false }, Ticket { id = 103, owner = "max", amount = 154, urgent = true }, Ticket { id = 104, owner = "max", amount = 217, urgent = false }]
let line (Ticket { id, owner }) = f"#{id} {(String.upper owner)}"
(print ((book |> (List.map line)) |> (String.join ", ")))
let adjust o = (if o.urgent then { o with amount = (o.amount + 14) } else o)
(print ((book |> (List.map adjust)) |> (List.map (fun o -> o.amount))))
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 152))) book)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
let byOwner = ((book |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
module Calc =
    let between lo hi x = (lo <= x <= hi)
    let clamp lo hi x = ((max lo) ((min hi) x))
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
let nums = [7, (- 15), 23, 30, 28, 18]
(print ((List.filter ((Calc.between (- 4)) 21)) nums))
(print (nums |> (List.map ((Calc.clamp 0) 20))))
(print (Calc.mean nums))
(print (Calc.norm1 nums))
