module Text =
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
    let clamp lo hi x = ((max lo) ((min hi) x))
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let pts = [4, 26, 17, 26, 23, 1, (- 9)]
(print (Text.norm1 pts))
(print (pts |> (List.map ((Text.clamp 0) 12))))
(print (Text.mean pts))
let log = ["eli", "fay", "eli", "dee", "ada", "fay", "fay", "bo", "ada", "dee"]
let counts = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) log)
(print ((counts |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
let extra = (Map.ofList [("zed", 5), ("eli", 0)])
(print ((((Map.union extra) counts) |> Map.toList) |> List.sort))
let sa = (Set.ofList [3, 9, 14, 15, 16, 17])
let sb = (Set.ofList [1, 10, 11, 13, 14, 16])
(print ((((Set.difference sa) sb) |> Set.toList) |> List.sort))
(print ((Set.len sa), ((Set.contains 14) sb), ((Set.isSubset (Set.ofList [3])) sa)))
type Booking = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Booking { urgent = true, amount = 11, id = 100, owner = "ned" }, Booking { id = 101, owner = "ned", amount = 49, urgent = true }, Booking { id = 102, owner = "ivy", urgent = true, amount = 66 }, Booking { id = 103, owner = "ned", amount = 58, urgent = false }, Booking { id = 104, owner = "ned", amount = 77, urgent = false }]
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 90))) parcels)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
let label o =
    let Booking { id, amount } = o
    f"#{id}:{(((Format.padLeft 5) " ") (String.fromInt amount))}"
(print ((parcels |> (List.map label)) |> (String.join ", ")))
let (cnt, sumAmt) = (((List.fold (fun (n, s) o -> ((n + 1), (s + o.amount)))) (0, 0)) parcels)
(print f"{cnt} records, {sumAmt} total")
opaque type AccountNo = string
opaque type Handle = string
let rawOf x =
    match x:
        case (AccountNo s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let keys = ((makeIds "sku") 4)
(print ((keys |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head keys) == (Some (AccountNo "acc-1"))))
