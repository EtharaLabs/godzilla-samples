type Bst = Leaf | Node Bst int Bst
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let root = (((List.fold (fun acc x -> ((insert x) acc))) Leaf) [15, 13, 7, 37, 21])
let containsT x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsT x) l) else ((containsT x) rt))
(print ((List.map (fun k -> ((containsT k) root))) [15, 22, 56]))
let minOf t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minOf l)
(print (minOf root))
let toListOf t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListOf l)) ((List.concat [v]) (toListOf rt)))
(print (toListOf root))
let sumT t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumT l) + v) + (sumT rt))
(print (sumT root))
let (|Above|_|) n = (if (n > 15) then (Some (n - 15)) else None)
let (|Zero|_|) n = (n == 0)
let bucketOf n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case m if (m < 0): "negative"
        case _: "small"
(([7, 10, 0, 13, 11, 30] |> (List.map bucketOf)) |> (List.iter print))
let visits = ["bo", "cy", "eli", "bo", "fay", "dee", "fay", "fay", "fay"]
let hist = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) visits)
(print ((hist |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print ((hist |> (Map.filter (fun k v -> (v > 1)))) |> Map.len))
(print (((Map.fold (fun acc k v -> (acc + v))) 0) hist))
