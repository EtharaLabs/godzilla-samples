--- stdout ---
opaque type UserId = string
opaque type Label = string
let unwrap x =
    match x:
        case (UserId s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let keys = ((mint "sku") 4)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (UserId "acc-1"))))
type Tree = Leaf | Node Tree int Tree
let add x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((add x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((add x) rt))
        case (Node _ _ _): t
let root = ([58, 14, 59, 28, 27, 21, 50] |> ((List.fold (flip add)) Leaf))
let sumOf t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumOf l) + v) + (sumOf rt))
(print (sumOf root))
let toListOf t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListOf l)) ((List.concat [v]) (toListOf rt)))
(print (toListOf root))
let minOf t =
    match t:
        case Leaf: None
        case (Node Leaf v _): (Some v)
        case (Node l _ _): (minOf l)
(print (minOf root))
let containsT x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsT x) l) else ((containsT x) rt))
(print ((List.map (fun k -> ((containsT k) root))) [58, 51, 48]))
let (|Above|_|) n = (if (n > 26) then (Some (n - 26)) else None)
let (|Zero|_|) n = (n == 0)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case Zero: "zero"
        case m if (m < 0): "negative"
        case _: "small"
(([19, 15, 27, 20, 31] |> (List.map classify)) |> (List.iter print))
