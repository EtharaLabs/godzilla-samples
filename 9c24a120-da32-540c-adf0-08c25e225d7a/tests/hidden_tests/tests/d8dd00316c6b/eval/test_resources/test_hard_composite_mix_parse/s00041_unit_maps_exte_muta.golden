measure m
measure s
measure kg
let laps = [499.5<m>, 249.1<m>, 278.7<m>, 170.1<m>, 69.7<m>]
let durations = [52.7<s>, 6.8<s>, 68.7<s>, 33.1<s>, 15.9<s>]
let total = (((List.fold (fun acc d -> (acc + d))) 0.0<m>) laps)
let elapsed = (((List.fold (+)) 0.0<s>) durations)
let pace = (total / elapsed)
(print ((Format.fixed 2) pace))
let best = (((List.zip laps) durations) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let km = (total / 1000.0)
(print ((Format.fixed 1) km))
let events = ["eli", "eli", "fay", "bo", "fay", "ada", "ada"]
let counts = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) events)
(print ((counts |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print ((counts |> (Map.filter (fun k v -> (v > 1)))) |> Map.len))
(print (((counts |> (Map.map (fun k v -> (v * 10)))) |> Map.values) |> List.sort))
extern fromHex: string -> int = int(base=16)
(print ((["ff", "7"] |> (List.map fromHex)) |> List.sum))
extern pure loud: string -> string = str.upper
(print (("tom" |> loud) |> String.rev))
extern pure intRoot: int -> int = math.isqrt
(print ((List.map intRoot) [86, 293, 366, 228]))
extern toNum: string -> int = int
let safe s =
    match (try (toNum s)):
        case (Ok n): f"ok {n}"
        case (Error e): f"bad ({e.errorKind})"
((["12", "x2", "27"] |> (List.map safe)) |> (List.iter print))
let mut hits = 0
let note x =
    (hits <- (hits + 1))
    (x * 3)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [55, (- 9), 38, (- 6), (- 10)]))
let doubled = ([55, (- 9), 38, (- 6)] |> (List.map note))
(print f"{doubled} after {hits} calls")
