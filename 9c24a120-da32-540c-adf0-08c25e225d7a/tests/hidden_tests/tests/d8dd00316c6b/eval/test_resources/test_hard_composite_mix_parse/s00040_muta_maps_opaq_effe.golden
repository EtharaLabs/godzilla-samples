let mut hits = 0
let track x =
    (hits <- (hits + 1))
    (x * 4)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [11, 5, (- 5), 4, 43, (- 6), (- 5), 17]))
let doubled = ([11, 5, (- 5), 4] |> (List.map track))
(print f"{doubled} after {hits} calls")
let events = ["bo", "ada", "ada", "bo", "cy", "cy", "cy", "bo", "ada"]
let freq = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) events)
(print ((freq |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
let extra = (Map.ofList [("zed", 5), ("bo", 0)])
(print ((((Map.union extra) freq) |> Map.toList) |> List.sort))
(print (((Map.tryFind "fay") freq), ((Map.contains "fay") freq)))
opaque type AccountNo = string
opaque type Email = string
let rawOf x =
    match x:
        case (AccountNo s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (AccountNo f"{prefix}-{i}"))))
let ids = ((makeIds "u") 4)
(print ((ids |> (List.map rawOf)) |> (String.join " ")))
(print ((List.head ids) == (Some (AccountNo "acc-1"))))
let pure discount price qty = ((price * qty) - (7 * qty))
let announce label price qty =
    (print f"{label}: {((discount price) qty)}")
    ((discount price) qty)
let grand = (([("hub", 8, 3), ("hub", 9, 2), ("cog", 9, 4)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print grand)
let pure scaled k = (List.map (discount k))
(print ((scaled 18) [1, 2, 3]))
