let samples = [40, 45, 14, 42, 25, 11, 50, 37, 42]
let addK k x = (x + k)
let keep n = ((n > 14) and ((n % 2) != 0))
let process = ((((((List.filter (fun x -> ((x % 3) == 2))) >> (List.pairwise >> (List.map (fun (a, b) -> (b - a))))) >> (List.drop 2)) >> (List.sortBy (fun x -> (- x)))) >> (List.map (fun x -> (if (x < 0) then (- x) else (x * 2))))) >> (List.indexed >> (List.map (fun (i, x) -> (i * x)))))
let result = ((samples |> process) |> List.head)
(print result)
(print <| (List.len samples))
let visits = ["bo", "cy", "cy", "cy", "ada", "fay", "ada"]
let hist = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) visits)
(print ((hist |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print ((hist |> (Map.filter (fun k v -> (v > 1)))) |> Map.len))
(print (((hist |> (Map.map (fun k v -> (v * 10)))) |> Map.values) |> List.sort))
