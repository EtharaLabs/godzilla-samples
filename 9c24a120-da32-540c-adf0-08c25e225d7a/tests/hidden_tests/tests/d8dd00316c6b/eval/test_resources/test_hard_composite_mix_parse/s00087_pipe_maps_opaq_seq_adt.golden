(print ((((Map.union extra) hist) |> Map.toList) |> List.sort))
opaque type Sku = string
opaque type Label = string
let unwrap x =
    match x:
        case (Sku s): s
let makeIds prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (Sku f"{prefix}-{i}"))))
let keys = ((makeIds "sku") 4)
(print ((keys |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head keys) == (Some (Sku "acc-1"))))
let series = seq {
    for x in ((List.range 1) 12):
        let y = (x * x)
        yield y
    yield 185
}
((((series |> (Seq.map (fun n -> (n + 1)))) |> (Seq.take 2)) |> Seq.toList) |> print)
(((((Seq.initInfinite (fun i -> (i * 6))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 3)) |> Seq.toList) |> print)
type Action = Halt int | Rest | Jump int | Mark | Push int
let show t =
    match t:
        case (Halt n0): f"halt({n0})"
        case (Jump n0): f"jump({n0})"
        case (Push n0): f"push({n0})"
        case (Rest | Mark): "rest/mark"
let weight t =
    match t:
        case (Halt x0): x0
        case _: 0
let queue = [Rest, Rest, Rest, Rest, (Jump 10), Mark, (Push 7)]
(print ((queue |> (List.map show)) |> (String.join "; ")))
let total = (queue |> (List.sumBy weight))
(print f"total={total}")
(print (List.sort queue))
