exit: 0
--- stdout ---
measure m
measure s
measure kg
measure N = kg m/s^2
let laps = [366.4<m>, 442.7<m>, 201.5<m>, 404.2<m>]
let durations = [82.6<s>, 89.3<s>, 70.6<s>, 75.7<s>]
let dist = (((List.fold (+)) 0.0<m>) laps)
let dur = (((List.fold (+)) 0.0<s>) durations)
let speed = (dist / dur)
(print ((Format.fixed 3) speed))
let edge = (sqrt 36.0<m^2>)
let cube = ((edge * edge) * edge)
(print f"{edge} {(cbrt cube)}")
let km = (dist / 1000.0)
(print ((Format.fixed 1) km))
let mass = 20.0<kg>
let accel = 1.5<m/s^2>
let push = (mass * accel)
let limit = 362.0<N>
(print (if (push > limit) then "over" else "under"))
let mut ticks = 0
let note x =
    (ticks <- (ticks + 1))
    (x * 3)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [60, 54, 27, 44, 17, (- 2), (- 3)]))
let doubled = ([60, 54, 27, 44] |> (List.map note))
(print f"{doubled} after {ticks} calls")
type Parcel = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Parcel { id = 100, owner = "dee", amount = 259, urgent = true }, Parcel { amount = 95, urgent = true, id = 101, owner = "dee" }, Parcel { id = 102, owner = "dee", amount = 86, urgent = false }, Parcel { id = 103, owner = "ned", urgent = false, amount = 29 }, Parcel { id = 104, owner = "eli", amount = 74, urgent = false }]
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 130))) parcels)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
let classify o =
    match o:
        case Parcel { urgent = true, amount } if (amount > 152): "rush-big"
        case Parcel { urgent = true }: "rush"
        case Parcel { amount }: (if (amount > 152) then "big" else "normal")
(print ((List.map classify) parcels))
(print ((List.countBy classify) parcels))
let adjust o = (if o.urgent then { o with amount = (o.amount + 6) } else o)
(print ((parcels |> (List.map adjust)) |> (List.map (fun o -> o.amount))))
