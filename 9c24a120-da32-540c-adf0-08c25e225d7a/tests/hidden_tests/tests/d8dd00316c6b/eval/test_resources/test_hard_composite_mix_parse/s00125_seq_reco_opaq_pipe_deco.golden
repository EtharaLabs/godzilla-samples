type Ticket = { id: int, owner: string, amount: int, urgent: bool }
let tickets = [Ticket { id = 100, owner = "cy", amount = 86, urgent = true }, Ticket { id = 101, owner = "cy", amount = 12, urgent = true }, Ticket { owner = "gus", id = 102, urgent = true, amount = 45 }, Ticket { id = 103, owner = "gus", amount = 29, urgent = false }]
(print (((tickets |> (List.sortBy (fun o -> o.amount))) |> (List.take 2)) |> (List.map (fun o -> o.id))))
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 150))) tickets)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
let byOwner = ((tickets |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
let urgentTotal = ((tickets |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
opaque type UserId = string
opaque type Handle = string
let unwrap x =
    match x:
        case (UserId s): s
let mint prefix n = (((List.range 1) (n + 1)) |> (List.map (fun i -> (UserId f"{prefix}-{i}"))))
let ids = ((mint "u") 2)
(print ((ids |> (List.map unwrap)) |> (String.join " ")))
(print ((List.head ids) == (Some (UserId "acc-1"))))
let values = [19, (- 9), 21, 26, 3, 42, 42]
let answer = (List.sum ((List.filter (fun x -> (x > 7))) (List.sort ((List.choose (fun x -> (if ((x % 3) == 0) then (Some (x // 3)) else None))) (List.rev values)))))
(print answer)
(print <| (List.len values))
type Player = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Player { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"hal\", \"points\": 76, \"active\": true}, {\"name\": \"cy\", \"points\": 35, \"active\": true}, {\"name\": \"oz\", \"points\": 73, \"active\": false}, {\"name\": \"sue\", \"points\": 3, \"active\": true}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
