--- stdout ---
measure m
measure s
measure kg
measure N = kg m/s^2
let segments = [481.9<m>, 34.3<m>, 15.8<m>, 284.0<m>]
let splits = [87.3<s>, 81.5<s>, 85.5<s>, 51.7<s>]
let total = (segments |> ((List.fold (fun acc d -> (acc + (d * 1.0)))) 0.0<m>))
let dur = (((List.fold (+)) 0.0<s>) splits)
let rate = (total / dur)
(print ((Format.fixed 2) rate))
let speeds = (((List.map2 (fun d t -> (d / t))) segments) splits)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let side = (sqrt 9.0<m^2>)
let cube = ((side * side) * side)
(print f"{side} {(cbrt cube)}")
type Reading = { name: string, points: int, active: bool }
let dec = ((((Decode.map3 (fun n p a -> Reading { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let jsonText = "[{\"name\": \"tom\", \"points\": 92, \"active\": true}, {\"name\": \"gus\", \"points\": 52, \"active\": false}, {\"name\": \"kit\", \"points\": 70, \"active\": false}, {\"name\": \"quin\", \"points\": 4, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list dec)) jsonText):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
let pure margin price qty = ((price * qty) - (9 * qty))
let announce label price qty =
    (print f"{label}: {((margin price) qty)}")
    ((margin price) qty)
let grand = (([("bolt", 26, 2), ("gear", 39, 3), ("cap", 28, 3)] |> (List.map (fun (n, pr, q) -> (((announce n) pr) q)))) |> List.sum)
(print grand)
extern fromHex: string -> int = int(base=16)
(print ((["ff", "100"] |> (List.map fromHex)) |> List.sum))
extern pure gcd: int -> int -> int = math.gcd
let lcm a b = ((a * b) // ((gcd a) b))
(print (((List.fold lcm) 1) [10, 3, 9, 3]))
