module Geo =
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let square x = (x * x)
    let clamp lo hi x = ((max lo) ((min hi) x))
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
let pts = [(- 6), 28, 3, 29, (- 7)]
(print ((Geo.scaleAll 4) pts))
(print ((List.map Geo.square) pts))
(print (pts |> (List.map ((Geo.clamp 0) 12))))
(print (Geo.mean pts))
let log = ["dee", "cy", "bo", "cy", "ada", "fay", "fay", "eli"]
let bump m w =
    match ((Map.tryFind w) m):
        case (Some n): (((Map.add w) (n + 1)) m)
        case None: (((Map.add w) 1) m)
let freq = (((List.fold bump) Map.empty) log)
(print ((freq |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print (((freq |> Map.keys) |> List.sort) |> (String.join ",")))
(print ((freq |> (Map.filter (fun k v -> (v > 1)))) |> Map.len))
let sa = (Set.ofList [4, 5, 6, 11, 16, 19])
let sb = (Set.ofList [4, 7, 11, 12, 17, 19])
(print ((((Set.union sa) sb) |> Set.toList) |> List.sort))
(print ((Set.len sa), ((Set.contains 10) sb), ((Set.isSubset (Set.ofList [4])) sa)))
let mut ticks = 0
let track x =
    (ticks <- (ticks + 1))
    (x * 2)
let profile xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (profile [60, 47, 33, 23, 25, 2, 33]))
let doubled = ([60, 47, 33, 23] |> (List.map track))
(print f"{doubled} after {ticks} calls")
