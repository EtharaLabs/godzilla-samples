let samples = [43, 4, 22, 9, 13, 8, 46, (- 7), 32, 36]
let shift k x = (x + k)
let isBig n = ((n > 16) and ((n % 4) != 0))
let pipeline = ((((((List.choose (fun x -> (if ((x % 4) == 0) then (Some (x // 4)) else None))) >> (List.sortBy (fun x -> (x % 4)))) >> (List.map (shift 6))) >> (List.map (fun x -> ((x * x) - 2)))) >> (List.take 3)) >> (List.indexed >> (List.map (fun (i, x) -> (i * x)))))
let digest = ((samples |> pipeline) |> (List.exists (fun x -> (x > 25))))
(print digest)
type Instr = Halt int | Mark int | Store string string
let explain t =
    match t:
        case (Halt n0) if ((n0 % 2) == 0): f"halt!({n0})"
        case (Halt n0): f"halt({n0})"
        case (Mark n0): f"mark({n0})"
        case (Store s0 s1): f"store({s0},{s1})"
let score t =
    match t:
        case (Mark x0): (x0 * 3)
        case (Store _ _): 5
        case _: 2
let queue = [(Halt 9), (Mark 11), (Mark 1), (Halt (- 3))]
((queue |> (List.map explain)) |> print)
let tally = (queue |> (List.sumBy score))
(print f"tally={tally}")
(print ((queue |> (List.filter (fun t -> ((score t) > 3)))) |> List.len))
let events = ["cy", "bo", "dee", "cy", "cy", "bo", "cy", "eli"]
let hist = (((List.fold (fun m w -> (((Map.add w) ((((Map.findOr w) 0) m) + 1)) m))) Map.empty) events)
(print ((hist |> Map.toList) |> (List.sortBy (fun (k, v) -> ((- v), k)))))
(print (((Map.fold (fun acc k v -> (acc + v))) 0) hist))
(print ((hist |> (Map.filter (fun k v -> (v > 1)))) |> Map.len))
(print (((hist |> Map.keys) |> List.sort) |> (String.join ",")))
(print (((hist |> (Map.map (fun k v -> (v * 10)))) |> Map.values) |> List.sort))
type Invoice = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Invoice { id = 100, owner = "hal", amount = 232, urgent = true }, Invoice { id = 101, owner = "hal", amount = 220, urgent = false }, Invoice { id = 102, owner = "hal", amount = 112, urgent = false }, Invoice { owner = "fay", amount = 123, id = 103, urgent = true }, Invoice { urgent = false, id = 104, owner = "tom", amount = 60 }, Invoice { id = 105, amount = 115, owner = "tom", urgent = true }]
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 99))) parcels)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
let byOwner = ((parcels |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
let rushSum = ((parcels |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print rushSum)
let adjust o = (if o.urgent then { o with amount = (o.amount + 12) } else o)
(print ((parcels |> (List.map adjust)) |> (List.map (fun o -> o.amount))))
