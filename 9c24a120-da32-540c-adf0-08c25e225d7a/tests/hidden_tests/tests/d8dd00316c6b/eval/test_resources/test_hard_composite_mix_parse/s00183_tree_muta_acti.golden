type Heap = Leaf | Node Heap int Heap
let insert x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((insert x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((insert x) rt))
        case (Node _ _ _): t
let tree = (((List.fold (fun acc x -> ((insert x) acc))) Leaf) [59, 6, 2, 56, 27])
let containsOf x t =
    match t:
        case Leaf: false
        case (Node l v rt): (if (x == v) then true elif (x < v) then ((containsOf x) l) else ((containsOf x) rt))
(print ((List.map (fun k -> ((containsOf k) tree))) [59, 28, 27]))
let sumOf t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumOf l) + v) + (sumOf rt))
(print (sumOf tree))
let toListOf t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListOf l)) ((List.concat [v]) (toListOf rt)))
(print (toListOf tree))
let mut hits = 0
let track x =
    (hits <- (hits + 1))
    (x * 2)
let stats xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (stats [58, 16, 20, 26, (- 19), 46]))
let doubled = ([58, 16, 20, 26] |> (List.map track))
(print f"{doubled} after {hits} calls")
let trackTwice = (track >> track)
(print ((trackTwice 3), hits))
let (|Above|_|) n = (if (n > 6) then (Some (n - 6)) else None)
let classify n =
    match n:
        case (Above d): f"above by {d}"
        case m if (m < 0): "negative"
        case _: "small"
(([9, 24, 0, 9, 23, 33, 29] |> (List.map classify)) |> (List.iter print))
