exit: 0
--- stdout ---
let evens = seq {
    for x in ((List.range 1) 10):
        let y = (x * x)
        yield y
    yield 161
}
(print (((Seq.fold (+)) 0) evens))
(((((Seq.initInfinite (fun i -> (i * 4))) |> (Seq.filter (fun n -> ((n % 2) == 0)))) |> (Seq.take 2)) |> Seq.toList) |> print)
type Ast = Num int | Add Ast Ast | Mul Ast Ast | Neg Ast
let evalE e =
    match e:
        case (Num n): n
        case (Add a b): ((evalE a) + (evalE b))
        case (Mul a b): ((evalE a) * (evalE b))
        case (Neg a): (- (evalE a))
let render e =
    match e:
        case (Num n) if (n < 0): f"({n})"
        case (Num n): f"{n}"
        case (Add a b): f"({(render a)} + {(render b)})"
        case (Mul a b): f"{(render a)} * {(render b)}"
        case (Neg a): f"-{(render a)}"
let exprs = [(Num 6), ((Mul (Neg ((Mul (Num 9)) (Num 4)))) (Num 8))]
((exprs |> (List.map render)) |> (List.iter print))
(print ((List.map evalE) exprs))
type Instr = Skip string | Push | Halt | Drop int
let describe t =
    match t:
        case (Skip s0): f"skip({s0})"
        case (Drop n0) if (0 <= n0 < 8): f"drop!({n0})"
        case (Drop n0): f"drop({n0})"
        case (Push | Halt): "push/halt"
let cost t =
    match t:
        case (Drop x0): (x0 * 4)
        case _: 1
let prog = [(Skip "gus"), (Drop (- 3)), Push, (Drop 10), (Skip "max"), Push, (Skip "jo")]
((List.iter (fun t -> (print (describe t)))) prog)
let grandSum = (prog |> (List.sumBy cost))
(print f"grandSum={grandSum}")
(print (List.sort prog))
