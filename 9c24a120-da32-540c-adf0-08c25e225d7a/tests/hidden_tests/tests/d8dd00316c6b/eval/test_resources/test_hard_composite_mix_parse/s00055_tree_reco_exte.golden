type Heap = Leaf | Node Heap int Heap
let add x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((add x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((add x) rt))
        case (Node _ _ _): t
let tree = ([1, 35, 11, 25, 58, 42, 22, 37] |> ((List.fold (flip add)) Leaf))
let depthT t =
    match t:
        case Leaf: 0
        case (Node l _ rt): (1 + ((max (depthT l)) (depthT rt)))
(print (depthT tree))
let toListT t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListT l)) ((List.concat [v]) (toListT rt)))
(print (toListT tree))
type Site = { city: string, zone: int }
type Ticket = { id: int, owner: string, amount: int, urgent: bool, dest: Site }
let parcels = [Ticket { id = 100, owner = "bo", amount = 278, urgent = false, dest = Site { city = "Bern", zone = 4 } }, Ticket { id = 101, owner = "cy", amount = 161, urgent = true, dest = Site { city = "Lima", zone = 3 } }, Ticket { urgent = false, owner = "max", id = 102, dest = Site { city = "Riga", zone = 2 }, amount = 274 }, Ticket { amount = 118, id = 103, dest = Site { city = "Kyiv", zone = 1 }, urgent = false, owner = "cy" }, Ticket { id = 104, owner = "cy", amount = 53, urgent = false, dest = Site { city = "Baku", zone = 1 } }]
let line o =
    let Ticket { id, amount } = o
    f"#{id}:{(((Format.padLeft 5) " ") (String.fromInt amount))}"
(print ((parcels |> (List.map line)) |> (String.join ", ")))
let rushSum = ((parcels |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print rushSum)
let surcharge pct o =
    let extra = ((o.amount * pct) // 100)
    { o with amount = (o.amount + extra), urgent = false }
(print ((parcels |> (List.map (surcharge 18))) |> (List.map (fun o -> o.amount))))
let classify o =
    match o:
        case Ticket { urgent = true, amount } if (amount > 174): "rush-big"
        case Ticket { urgent = true }: "rush"
        case Ticket { amount }: (if (amount > 174) then "big" else "normal")
(print ((List.map classify) parcels))
(print ((List.countBy classify) parcels))
extern pure choose: int -> int -> int = math.comb
let row n = (((List.range 0) (n + 1)) |> (List.map (choose n)))
(print (row 3))
extern readBase: string -> int -> int = int(base=...)
let fromBin s = ((readBase s) 2)
(print ((fromBin "100111") + ((readBase "100") 8)))
extern parseHex: string -> int = int(base=16)
(print ((["ff", "100"] |> (List.map parseHex)) |> List.sum))
