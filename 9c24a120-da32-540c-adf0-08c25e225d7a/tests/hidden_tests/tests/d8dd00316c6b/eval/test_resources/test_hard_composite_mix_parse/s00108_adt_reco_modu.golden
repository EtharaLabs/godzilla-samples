exit: 0
--- stdout ---
type Signal = Push string | Emit string | Store string | Halt | Drop string
let render t =
    match t:
        case (Push s0): f"push({s0})"
        case (Emit s0): f"emit({s0})"
        case (Store s0): f"store({s0})"
        case Halt: f"halt"
        case (Drop s0): f"drop({s0})"
let weight t =
    match t:
        case Halt: 1
        case (Emit _): 5
        case (Drop _): 7
        case _: 2
let stream = [(Emit "quin"), Halt, (Emit "jo"), (Emit "quin")]
(print ((String.join " ") ((List.map render) stream)))
let tally = (stream |> (List.sumBy weight))
(print f"tally={tally}")
(print ((List.head stream), (List.last stream)))
type Parcel = { id: int, owner: string, amount: int, urgent: bool }
let parcels = [Parcel { id = 100, amount = 295, owner = "fay", urgent = false }, Parcel { id = 101, amount = 264, owner = "quin", urgent = true }, Parcel { id = 102, owner = "quin", amount = 44, urgent = true }, Parcel { id = 103, owner = "quin", amount = 239, urgent = true }, Parcel { urgent = true, id = 104, amount = 11, owner = "ned" }, Parcel { id = 105, owner = "ned", amount = 82, urgent = false }]
let byOwner = ((parcels |> (List.groupBy (fun o -> o.owner))) |> (List.map (fun (k, os) -> (k, (List.len os), ((List.sumBy (fun o -> o.amount)) os)))))
(print byOwner)
let label (Parcel { id, owner }) = f"#{id} {(String.upper owner)}"
(print ((parcels |> (List.map label)) |> (String.join ", ")))
let (cheap, dear) = ((List.partition (fun o -> (o.amount < 62))) parcels)
(print f"{(List.len cheap)} cheap, {(List.len dear)} dear")
let urgentTotal = ((parcels |> (List.filter (fun o -> o.urgent))) |> (List.sumBy (fun o -> o.amount)))
(print urgentTotal)
(print ((List.maxBy (fun o -> o.amount)) parcels))
module Calc =
    let clamp lo hi x = ((max lo) ((min hi) x))
    let scaleAll k xs = ((List.map ((*) k)) xs)
    let mean xs = (if (List.isEmpty xs) then 0 else ((List.sum xs) // (List.len xs)))
    let norm1 xs = ((xs |> (List.map abs)) |> List.sum)
let pts = [24, (- 3), 14, (- 5), 3, 17, 11]
(print (pts |> (List.map ((Calc.clamp 0) 7))))
(print ((Calc.scaleAll 5) pts))
(print (Calc.mean pts))
(print (Calc.norm1 pts))
