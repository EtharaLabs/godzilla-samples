exit: 0
--- stdout ---
measure m
measure s
measure kg
measure N = kg m/s^2
let laps = [423.3<m>, 474.0<m>, 87.8<m>, 282.4<m>]
let durations = [31.9<s>, 43.3<s>, 82.8<s>, 61.8<s>]
let total = (laps |> ((List.fold (fun acc d -> (acc + (d * 1.0)))) 0.0<m>))
let dur = (((List.fold (+)) 0.0<s>) durations)
let rate = (total / dur)
(print ((Format.fixed 2) rate))
let best = (((List.zip laps) durations) |> (List.maxBy (fun (d, t) -> (d / t))))
(print best)
let paceOf d t = (t / d)
(print ((Format.fixed 3) (((paceOf total) dur) * 1000.0)))
let speeds = (((List.map2 (fun d t -> (d / t))) laps) durations)
(((speeds |> (List.map (Format.fixed 2))) |> (String.join " ")) |> print)
let mass = 46.0<kg>
let accel = 9.5<m/s^2>
let push = (mass * accel)
let limit = 308.0<N>
(print (if (push > limit) then "over" else "under"))
type Token = Push int | Pop int | Rest int | Halt | Load
let render t =
    match t:
        case (Push 2): "push-2"
        case (Push n0): f"push({n0})"
        case (Pop n0) if (n0 > 9): f"pop!({n0})"
        case (Pop n0): f"pop({n0})"
        case (Rest n0) if (0 <= n0 < 7): f"rest!({n0})"
        case (Rest n0): f"rest({n0})"
        case (Halt | Load): "halt/load"
let rank t =
    match t:
        case Load: 5
        case _: 3
let queue = [(Pop 4), (Pop 0), Halt, Load, (Push 11)]
(print ((String.join " ") ((List.map render) queue)))
let total2 = (queue |> (List.sumBy rank))
(print f"total2={total2}")
(print ((queue |> (List.filter (fun t -> ((rank t) > 3)))) |> List.len))
let mut hits = 0
let track x =
    (hits <- (hits + 1))
    (x * 4)
let stats xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (stats [(- 8), 44, 48, 40, 40, (- 9), 36]))
let doubled = ([(- 8), 44, 48, 40] |> (List.map track))
(print f"{doubled} after {hits} calls")
