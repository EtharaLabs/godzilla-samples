type Heap = Leaf | Node Heap int Heap
let add x t =
    match t:
        case Leaf: (((Node Leaf) x) Leaf)
        case (Node l v rt) if (x < v): (((Node ((add x) l)) v) rt)
        case (Node l v rt) if (x > v): (((Node l) v) ((add x) rt))
        case (Node _ _ _): t
let root = (((List.fold (fun acc x -> ((add x) acc))) Leaf) [8, 32, 45, 1, 47, 49, 59, 35])
let depthT t =
    match t:
        case Leaf: 0
        case (Node l _ rt): (1 + ((max (depthT l)) (depthT rt)))
(print (depthT root))
let toListOf t =
    match t:
        case Leaf: []
        case (Node l v rt): ((List.concat (toListOf l)) ((List.concat [v]) (toListOf rt)))
(print (toListOf root))
let sumT t =
    match t:
        case Leaf: 0
        case (Node l v rt): (((sumT l) + v) + (sumT rt))
(print (sumT root))
let mut calls = 0
let track x =
    (calls <- (calls + 1))
    (x * 2)
let summarize xs =
    let mut lo = 1000
    let mut hi = (- 1000)
    let mut total = 0
    let visit x =
        (lo <- ((min lo) x))
        (hi <- ((max hi) x))
        (total <- (total + x))
    ((List.iter visit) xs)
    f"lo={lo} hi={hi} total={total}"
(print (summarize [15, 58, 55, 39, 30, 24, 50]))
let doubled = ([15, 58, 55, 39] |> (List.map track))
(print f"{doubled} after {calls} calls")
type Player = { name: string, points: int, active: bool }
let decoder = ((((Decode.map3 (fun n p a -> Player { name = n, points = p, active = a })) ((Decode.field "name") Decode.string)) ((Decode.field "points") Decode.int)) ((Decode.field "active") Decode.bool))
let rawJson = "[{\"name\": \"hal\", \"points\": 78, \"active\": false}, {\"name\": \"ivy\", \"points\": 24, \"active\": false}, {\"name\": \"pam\", \"points\": 42, \"active\": false}, {\"name\": \"bad\", \"points\": \"lots\", \"active\": true}]"
match ((Decode.decodeString (Decode.list decoder)) rawJson):
    case (Ok ps):
        let live = (ps |> (List.filter (fun p -> p.active)))
        (print f"{(List.len live)} active, {((List.sumBy (fun p -> p.points)) live)} points")
    case (Error e): (print f"decode failed: {e.errorKind}")
