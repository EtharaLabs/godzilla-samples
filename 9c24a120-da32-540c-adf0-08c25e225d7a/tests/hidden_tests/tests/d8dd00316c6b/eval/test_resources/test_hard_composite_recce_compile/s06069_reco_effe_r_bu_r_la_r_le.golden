from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
tickets = [Invoice(100, "cy", 290, False, Place("Rome", 1)), Invoice(101, "ray", 64, False, Place("Oslo", 3)), Invoice(102, "tom", 142, False, Place("Oslo", 2)), Invoice(103, "ray", 294, False, Place("Oslo", 3)), Invoice(104, "cy", 275, True, Place("Kyiv", 4))]
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, tickets))))
def adjust(o):
    if o.urgent:
        _pf_t0 = o
        return Invoice(_pf_t0.id, _pf_t0.owner, o.amount + 1, _pf_t0.urgent, _pf_t0.dest)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(adjust, tickets)))
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
perOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, tickets))
print(perOwner)
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn1, (0, 0), tickets)
print(f"{nrec} records, {amt} total")
def discount(price, qty):
    return price * qty - 7 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn2(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn2, [("pin", 34, 5), ("wick", 6, 2), ("gear", 11, 6)]))
print(overall)
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def compute(x):
    return Writer_bind(tell(f"start {x}"), lambda _: Writer_bind((x * 4, ["scaled"]), lambda y: (lambda z: Writer_bind(tell(f"z={z}"), lambda _: Writer_return_(z)))(y + 7)))
print(_pf_map(compute, [4, 8]))
seriesA = [12, 22, 8, 16, -2, 11, 2, 13]
factor = 3
def _pf_fn3(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn3, _pf_indexed(seriesA))))
shape2 = lambda _pf_x: (lambda z: z - 6)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, seriesA))
def _pf_fn4(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn4, (0, 0), seriesA))
def _pf_fn5(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn5, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(5), scalers))
def fem(n):
    if n == 0:
        return 1
    else:
        return n - mal(fem(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - fem(mal(n - 1))
print((_pf_map(fem, _pf_range(0, 9)), _pf_map(mal, _pf_range(0, 8))))
