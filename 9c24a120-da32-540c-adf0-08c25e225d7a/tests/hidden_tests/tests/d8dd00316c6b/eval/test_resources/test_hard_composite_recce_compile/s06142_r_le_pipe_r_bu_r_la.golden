from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_str_join(sep, xs):
    return sep.join(xs)
def stepA(n, acc):
    if n <= 0:
        return acc
    else:
        return pong(n - 1, acc + 1)
def pong(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return stepA(n - 3, acc - 1)
print(_pf_map(lambda n: stepA(n, 1), [16, 11, 8, 19]))
values = [50, 12, 19, -9, 35, 13, 36, -6, 14, 1, 38]
def addK(k, x):
    return x + k
def isBig(n):
    return n > 12 and n % 2 != 0
process = lambda _pf_x: _pf_map(lambda x: x // 2 + x % 2, (lambda _pf_x: (lambda _pf_x: _pf_map(sum, _pf_chunk(3, _pf_x)))((lambda _pf_x: _pf_collect(lambda x: [x, x + 1], (lambda _pf_x: _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), (lambda _pf_x: _pf_map(functools.partial(addK, 2), _pf_drop(2, _pf_x)))(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
outcome = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(process(values))
print(outcome)
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(note2(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(note2(f"z={z}"), lambda _: Writer_return_(z)))(y + 2)))
print(_pf_map(trace2, [9, 3]))
seriesA = [10, 23, 26, -9, -4]
gain = 2
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(7), makers2))
