def describe(t):
    match t:
        case Mark(n0):
            return f"mark({n0})"
        case Push(1):
            return "push-1"
        case Push(n0):
            return f"push({n0})"
        case Store():
            return f"store"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Mark(x0):
            return x0
        case Store():
            return 2
        case _:
            return 3
