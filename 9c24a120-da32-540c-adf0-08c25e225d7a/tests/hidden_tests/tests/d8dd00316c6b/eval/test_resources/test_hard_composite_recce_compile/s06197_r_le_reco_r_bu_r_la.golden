from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
@dataclass(frozen=True, slots=True)
class Form:
    user: str
    age: int
def reading(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    return inSpace(rest, n)
                else:
                    cs, n = (rest, n)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
def inSpace(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    cs, n = (rest, n)
                    continue
                else:
                    return reading(rest, n + 1)
            case _:
                raise RuntimeError("non-exhaustive match")
print(inSpace(list("eli bo ivy kit dee"), 0))
book = [Order(100, "max", 17, True, Addr("Kyiv", 2)), Order(101, "sue", 109, True, Addr("Doha", 2)), Order(102, "sue", 192, False, Addr("Kyiv", 1)), Order(103, "sue", 163, True, Addr("Oslo", 3)), Order(104, "ivy", 32, True, Addr("Rome", 2))]
cheap, dear = _pf_partition(lambda o: o.amount < 60, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by_desc(lambda o: o.amount, book))))
def tag(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, book)))
def Check_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Check_return_(x):
    return Ok(x)
def parseForm(user, age):
    return Check_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Check_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Check_bind(Ok(years) if years >= 16 else Error("too young"), lambda adult: Check_return_(Form(name, adult)))))
print(parseForm("quin", "42"))
print((parseForm("a", "30"), parseForm("bob", "x")))
inputs2 = [11, 20, 26, -4, 26, -8, -2, 3]
gain = 2
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn0, _pf_zip(inputs2, _pf_map(lambda x: x * x, inputs2)))))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(inputs2), inputs2))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), inputs2))
scalers = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(2), scalers))
