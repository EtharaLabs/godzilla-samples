import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 4], lambda k: Grid_yield_(a * b + k))
cells = Grid_combine(Grid_for_([(1, 3), (5, 1)], _pf_fn0), Grid_delay(lambda _: Grid_yield_(4)))
print(cells)
nums2 = [5, 22, 15, 29, 2, -8]
gain = 2
tweak2 = lambda _pf_x: (lambda z: z - 2)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, nums2))
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(9), makers2))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(nums2), nums2))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
def stepA(n, acc):
    if n <= 0:
        return acc
    else:
        return pong(n - 1, acc + 1)
def pong(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return stepA(n - 3, acc - 1)
print(_pf_map(lambda n: stepA(n, 1), [1, 14, 9, 15]))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_square(x):
    return x * x
nums = [-15, 22, 9, 12, -14]
print(Calc_scaleAll(3, nums))
print(_pf_map(functools.partial(Calc_clamp, 0, 8), nums))
print(Calc_norm1(nums))
print(_pf_map(Calc_square, nums))
