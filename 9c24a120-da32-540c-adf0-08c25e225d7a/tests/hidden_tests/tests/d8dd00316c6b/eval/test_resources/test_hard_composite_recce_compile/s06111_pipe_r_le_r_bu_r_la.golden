from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Signup:
    user: str
    age: int
values = [45, 3, 1, 18, 24, 9, 34, 0]
def accept(n):
    return n > 12 and n % 3 != 0
result = _pf_max(_pf_rev(_pf_take_while(lambda x: x < 44, _pf_filter(accept, _pf_map(functools.partial(max, 5), _pf_choose(lambda x: (Some(x // 3) if x % 3 == 0 else _None_), values))))))
print(result)
def evenP(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return evenP(n - 1)
print(_pf_partition(evenP, [23, 0, 29, 8, 6]))
def Valid_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Valid_return_(x):
    return Ok(x)
def readForm(user, age):
    return Valid_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Valid_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Valid_bind(Ok(years) if years >= 18 else Error("too young"), lambda adult: Valid_return_(Signup(name, adult)))))
print(readForm("kit", "57"))
print((readForm("a", "30"), readForm("bob", "x")))
nums2 = [10, 27, 4, 6, 6, 1, -3]
factor = 2
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(nums2), nums2))
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), nums2))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(nums2))))
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
