from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums = [-3, -10, 5, 7, 28]
print(_pf_filter(functools.partial(Stats_between, -3, 18), nums))
print(_pf_map(functools.partial(Stats_clamp, 0, 14), nums))
print(Stats_mean(nums))
def female(n):
    if n == 0:
        return 1
    else:
        return n - male(female(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - female(male(n - 1))
print((_pf_map(female, _pf_range(0, 8)), _pf_map(male, _pf_range(0, 9))))
seriesA = [23, 28, -7, 13, 5]
factor = 4
tweak2 = lambda _pf_x: (lambda z: z - 7)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, seriesA))
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), seriesA))
makers2 = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(6), makers2))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(seriesA), seriesA))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn1, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
segments = [148.1, 179.7, 109.1, 447.3]
durations = [5.2, 41.3, 22.9, 54.1]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed = dist / dur
print(_pf_fmt_fixed(3, speed))
speeds = _pf_map2(lambda d, t: d / t, segments, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn2(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn2, _pf_zip(segments, durations))
print(best)
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn3(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 3], lambda k: Grid_yield_(a * b + k))
combos = Grid_combine(Grid_for_([(4, 5), (3, 2)], _pf_fn3), Grid_delay(lambda _: Grid_yield_(7)))
print(combos)
