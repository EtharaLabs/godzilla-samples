_Push = Push()
def evenP(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return evenP(n - 1)
print(_pf_partition(evenP, [36, 24, 6, 1, 23]))
nums2 = [-6, 11, 19, 6, 2]
gain = 4
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), nums2))
scalers = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(5), scalers))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
def Check_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Check_return_(x):
    return Ok(x)
def readForm(user, age):
    return Check_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Check_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Check_bind(Ok(years) if years >= 18 else Error("too young"), lambda adult: Check_return_(Form(name, adult)))))
print(readForm("oz", "57"))
print((readForm("a", "30"), readForm("bob", "x")))
def show(t):
    match t:
        case Load(2):
            return "load-2"
        case Load(n0):
            return f"load({n0})"
        case Turn(n0) if n0 % 2 == 0:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Rest(n0) if n0 % 2 == 0:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Mark(s0):
            return f"mark({s0})"
        case Push():
            return f"push"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Turn(x0):
            return x0 * 2
        case Rest(x0):
            return x0
        case Load(x0):
            return x0
        case _:
            return 2
stream = [Mark("hal"), Load(9), _Push, Rest(9)]
print(_pf_str_join("; ", _pf_map(show, stream)))
grandSum = _pf_sum_by(cost, stream)
print(f"grandSum={grandSum}")
print(len(_pf_filter(lambda t: cost(t) > 2, stream)))
