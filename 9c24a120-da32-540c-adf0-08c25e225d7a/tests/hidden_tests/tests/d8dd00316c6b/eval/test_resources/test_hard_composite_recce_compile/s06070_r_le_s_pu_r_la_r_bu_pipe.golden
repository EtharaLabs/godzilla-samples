from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_fst(p):
    return p[0]
