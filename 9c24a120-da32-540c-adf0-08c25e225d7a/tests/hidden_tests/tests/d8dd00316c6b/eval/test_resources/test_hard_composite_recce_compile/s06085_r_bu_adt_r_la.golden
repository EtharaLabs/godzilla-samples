def explain(t):
    match t:
        case Halt(n0) if n0 % 2 == 0:
            return f"halt!({n0})"
        case Halt(n0):
            return f"halt({n0})"
        case Push():
            return f"push"
        case Turn(n0) if 0 <= n0 < 12:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Emit(s0):
            return f"emit({s0})"
        case Jump(s0):
            return f"jump({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Halt(x0):
            return x0
        case Push():
            return 3
        case _:
            return 0
