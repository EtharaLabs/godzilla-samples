def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_to_result(err, o):
