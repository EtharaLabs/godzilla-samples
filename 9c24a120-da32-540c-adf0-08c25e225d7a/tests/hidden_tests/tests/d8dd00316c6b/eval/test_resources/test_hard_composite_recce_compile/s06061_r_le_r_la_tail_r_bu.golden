print(_pf_map(tweak2, inputs2))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(inputs2), inputs2))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(2, 13, 1))
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(63616))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [29, 7, 37]))
def Perhaps_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Perhaps_return_(x):
    return Some(x)
def safeDiv(a, b):
    return Perhaps_bind(_pf_str_to_int(a), lambda x: Perhaps_bind(_pf_str_to_int(b), lambda y: Perhaps_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Perhaps_return_(shown))(q * 4))))
print((safeDiv("95", "2"), safeDiv("4", "0"), safeDiv("x", "1")))
