import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fst(p):
    return p[0]
def isEven2(n):
    if n == 0:
        return True
    else:
        return oddP(n - 1)
def oddP(n):
    if n == 0:
        return False
    else:
        return isEven2(n - 1)
print(_pf_partition(isEven2, [11, 25, 38, 22, 1]))
inputs2 = [24, 0, 16, -3, 22, 11, -9, 2]
factor = 4
shape2 = lambda _pf_x: (lambda z: z - 1)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, inputs2))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(inputs2))))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), inputs2))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(inputs2), inputs2))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn2, _pf_zip(inputs2, _pf_map(lambda x: x * x, inputs2)))))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
obs = [-9, 17, -15, -15, -15, -15, 12]
print(_pf_filter(functools.partial(Geo_between, -3, 10), obs))
print(Geo_mean(obs))
print(Geo_scaleAll(4, obs))
def Many_yield_(x):
    return [x]
def Many_combine(a, b):
    return _pf_concat(a, b)
def Many_delay(f):
    return f(None)
Many_zero = []
def Many_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn3(_pf_arg0):
    a, b = _pf_arg0
    return Many_for_([1, 3], lambda k: Many_yield_(a * b + k))
cells = Many_combine(Many_for_([(4, 4), (2, 5)], _pf_fn3), Many_delay(lambda _: Many_yield_(5)))
print(cells)
