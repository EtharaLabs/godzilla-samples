from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
parcels = [Booking(100, "max", 93, True), Booking(101, "tom", 52, False), Booking(102, "max", 71, False), Booking(103, "quin", 248, True)]
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by(lambda o: o.amount, parcels))))
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(urgentTotal)
cheap, dear = _pf_partition(lambda o: o.amount < 81, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def classify(o):
    match o:
        case Booking(urgent=True, amount=amount) if amount > 191:
            return "rush-big"
        case Booking(urgent=True):
            return "rush"
        case Booking(amount=amount):
            if amount > 191:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn0, (0, 0), parcels)
print(f"{cnt} records, {sumAmt} total")
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def compute(x):
    return Writer_bind(tell(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(tell(f"z={z}"), lambda _: Writer_return_(z)))(y + 5)))
print(_pf_map(compute, [1, 2]))
seriesA = [20, 20, 26, 21, 3, 28, -2, 3]
gain = 2
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), seriesA))
scalers = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(2), scalers))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
def female(n):
    if n == 0:
        return 1
    else:
        return n - male(female(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - female(male(n - 1))
print((_pf_map(female, _pf_range(0, 8)), _pf_map(male, _pf_range(0, 8))))
