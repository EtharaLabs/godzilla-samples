from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def compute(x):
    return Writer_bind(note2(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(note2(f"z={z}"), lambda _: Writer_return_(z)))(y + 9)))
print(_pf_map(compute, [8, 7]))
def female(n):
    if n == 0:
        return 1
    else:
        return n - mal(female(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - female(mal(n - 1))
print((_pf_map(female, _pf_range(0, 12)), _pf_map(mal, _pf_range(0, 10))))
nums2 = [-5, 11, 14, 25, -5, -5]
gain = 5
tweak2 = lambda _pf_x: (lambda z: z - 5)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, nums2))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(nums2), nums2))
scalers = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(5), scalers))
tickets = [Order(100, "ada", 167, True), Order(101, "ray", 227, True), Order(102, "gus", 190, False), Order(103, "gus", 137, False)]
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn0, (0, 0), tickets)
print(f"{cnt} records, {amt} total")
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by(lambda o: o.amount, tickets))))
def label(_pf_arg0):
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(label, tickets)))
def surcharge(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Order(_pf_t0.id, _pf_t0.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 5), tickets)))
cheap, dear = _pf_partition(lambda o: o.amount < 163, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
values = [38, -5, 29, 15, 23, 28, 25, 22]
def shift(k, x):
    return x + k
def _pf_fn2(_pf_x):
    def _pf_fn3(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn3, _pf_indexed(_pf_x))
outcome = _pf_exists(lambda x: x > 20, _pf_fn2(_pf_sort_by(lambda x: x % 2, _pf_sort((lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))(_pf_take(2, _pf_take_while(lambda x: x < 38, values)))))))
print(outcome)
print(len(values))
