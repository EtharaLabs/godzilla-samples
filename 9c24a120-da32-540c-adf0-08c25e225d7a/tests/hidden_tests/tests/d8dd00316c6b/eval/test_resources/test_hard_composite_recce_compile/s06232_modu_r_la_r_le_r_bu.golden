import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fst(p):
    return p[0]
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_square(x):
    return x * x
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
obs = [-9, 14, -9, -10, 23, 2, -15]
print(Calc_scaleAll(3, obs))
print(_pf_map(Calc_square, obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 11), obs))
print(_pf_filter(functools.partial(Calc_between, -3, 18), obs))
inputs2 = [18, 27, -2, 16, -3, -6]
gain = 4
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(4), makers2))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(inputs2))))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(inputs2), inputs2))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), inputs2))
def female(n):
    if n == 0:
        return 1
    else:
        return n - male(female(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - female(male(n - 1))
print((_pf_map(female, _pf_range(0, 8)), _pf_map(male, _pf_range(0, 8))))
def Many_yield_(x):
    return [x]
def Many_combine(a, b):
    return _pf_concat(a, b)
def Many_delay(f):
    return f(None)
Many_zero = []
def Many_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Many_for_([1, 4], lambda k: Many_yield_(a * b + k))
combos = Many_combine(Many_for_([(1, 4), (1, 3)], _pf_fn2), Many_delay(lambda _: Many_yield_(7)))
print(combos)
