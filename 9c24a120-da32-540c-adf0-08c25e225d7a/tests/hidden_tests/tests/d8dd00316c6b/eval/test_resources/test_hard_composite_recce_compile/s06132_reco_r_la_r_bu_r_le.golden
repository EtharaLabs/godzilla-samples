def priority(o):
    match o:
        case Ticket(urgent=True, amount=amount) if amount > 72:
            return "rush-big"
        case Ticket(urgent=True):
            return "rush"
        case Ticket(amount=amount):
            if amount > 72:
                return "big"
            else:
