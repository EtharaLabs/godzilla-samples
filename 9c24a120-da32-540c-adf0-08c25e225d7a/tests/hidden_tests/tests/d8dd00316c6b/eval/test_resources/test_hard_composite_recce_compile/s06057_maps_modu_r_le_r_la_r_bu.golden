from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_set_intersect(a, b):
    return a.intersection(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_fst(p):
    return p[0]
