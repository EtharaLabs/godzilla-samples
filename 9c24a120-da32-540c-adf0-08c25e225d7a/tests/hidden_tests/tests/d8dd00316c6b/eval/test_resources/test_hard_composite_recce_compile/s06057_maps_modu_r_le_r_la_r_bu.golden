def Stats_square(x):
    return x * x
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
