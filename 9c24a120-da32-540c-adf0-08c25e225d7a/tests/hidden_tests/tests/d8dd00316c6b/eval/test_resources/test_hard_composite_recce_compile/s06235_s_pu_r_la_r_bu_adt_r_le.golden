print(_pf_fold(_pf_fn1, (0, 0), seriesA))
def Maybe_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Maybe_return_(x):
    return Some(x)
def safeDiv(a, b):
    return Maybe_bind(_pf_str_to_int(a), lambda x: Maybe_bind(_pf_str_to_int(b), lambda y: Maybe_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Maybe_return_(shown))(q * 2))))
print((safeDiv("60", "4"), safeDiv("4", "0"), safeDiv("x", "1")))
def render(t):
    match t:
        case Jump(s0):
            return f"jump({s0})"
        case Pop():
            return f"pop"
        case Drop(3, _):
            return "drop-3"
        case Drop(n0, s1):
            return f"drop({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Drop(x0, _):
            return x0 * 2
        case Pop():
            return 2
        case _:
            return 3
prog = [Jump("fay"), _Pop, Drop(-2, "bo"), _Pop]
print(_pf_str_join(" ", _pf_map(render, prog)))
grandSum = _pf_sum_by(rank, prog)
print(f"grandSum={grandSum}")
print((_pf_head(prog), _pf_last(prog)))
def isEven2(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return isEven2(n - 1)
