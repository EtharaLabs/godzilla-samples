from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Box:
    w: int
    h: int
    label: str
nums2 = [4, -4, 23, -3, 18, 25, 16]
factor = 4
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(nums2), nums2))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(nums2))))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
makers2 = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(8), makers2))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn1, _pf_zip(nums2, _pf_map(lambda x: x * x, nums2)))))
def fem(n):
    if n == 0:
        return 1
    else:
        return n - mal(fem(n - 1))
def mal(n):
    if n == 0:
        return 0
    else:
        return n - fem(mal(n - 1))
print((_pf_map(fem, _pf_range(0, 11)), _pf_map(mal, _pf_range(0, 6))))
panels = [Box(3, 9, "cog"), Box(8, 6, "nut"), Box(9, 4, "wick"), Box(4, 4, "sq")]
def relabel(prefix, b):
    label = b.label
    _pf_t1 = b
    return Box(_pf_t1.w, _pf_t1.h, _pf_str_concat(prefix, label))
print(_pf_head(_pf_map(functools.partial(relabel, "old-"), panels)))
def stretch(b):
    w = b.w
    h = b.h
    _pf_t3 = b
    return Box(w + 3, h * 2, _pf_t3.label)
print(_pf_map(lambda b: b.h, _pf_map(stretch, panels)))
def _pf_fn2(_pf_arg0):
    label = _pf_arg0.label
    return label
def _pf_fn3(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w > h
print(_pf_map(_pf_fn2, _pf_filter(_pf_fn3, panels)))
def surface(_pf_arg0):
    w = _pf_arg0.w
    h = _pf_arg0.h
    return w * h
print(sum(_pf_map(surface, panels)))
def Perhaps_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Perhaps_return_(x):
    return Some(x)
def ratio2(a, b):
    return Perhaps_bind(_pf_str_to_int(a), lambda x: Perhaps_bind(_pf_str_to_int(b), lambda y: Perhaps_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Perhaps_return_(shown))(q * 4))))
print((ratio2("11", "3"), ratio2("4", "0"), ratio2("x", "1")))
