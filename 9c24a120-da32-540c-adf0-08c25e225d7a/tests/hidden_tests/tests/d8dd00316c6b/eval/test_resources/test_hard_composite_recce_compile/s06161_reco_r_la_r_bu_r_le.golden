from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
parcels = [Invoice(100, "gus", 242, False, Place("Lima", 1)), Invoice(101, "sue", 123, True, Place("Doha", 4)), Invoice(102, "gus", 50, False, Place("Doha", 1)), Invoice(103, "kit", 21, True, Place("Baku", 1)), Invoice(104, "sue", 42, False, Place("Oslo", 3)), Invoice(105, "gus", 217, True, Place("Baku", 1))]
def line(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(line, parcels)))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn0, (0, 0), parcels)
print(f"{nrec} records, {amt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 106, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def bucket(o):
    match o:
        case Invoice(urgent=True, amount=amount) if amount > 113:
            return "rush-big"
        case Invoice(urgent=True):
            return "rush"
        case Invoice(amount=amount):
            if amount > 113:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, parcels))
print(_pf_count_by(bucket, parcels))
def bump2(o):
    if o.urgent:
        _pf_t1 = o
        return Invoice(_pf_t1.id, _pf_t1.owner, o.amount + 15, _pf_t1.urgent, _pf_t1.dest)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(bump2, parcels)))
seriesA = [15, 21, -9, 15, 12]
gain = 5
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
scalers = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(8), scalers))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(seriesA))))
tweak2 = lambda _pf_x: (lambda z: z - 5)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, seriesA))
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(note2(f"start {x}"), lambda _: Writer_bind((x * 2, ["scaled"]), lambda y: (lambda z: Writer_bind(note2(f"z={z}"), lambda _: Writer_return_(z)))(y + 8)))
print(_pf_map(trace2, [5, 1]))
def ping(n, acc):
    if n <= 0:
        return acc
    else:
        return pong(n - 1, acc + 1)
def pong(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
print(_pf_map(lambda n: ping(n, 1), [20, 5, 6, 18]))
