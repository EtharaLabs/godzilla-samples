print(_pf_map(lambda g: g(3), scalers))
tweak2 = lambda _pf_x: (lambda z: z - 6)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, seriesA))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn1, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
def ping(n, acc):
    if n <= 0:
        return acc
    else:
        return stepB(n - 1, acc + 1)
def stepB(n, acc):
    if n <= 0:
        return acc
    else:
        return pang(n - 2, acc * 2)
def pang(n, acc):
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
print(_pf_map(lambda n: ping(n, 1), [10, 19, 8, 10]))
readings = [35, 29, 33, 31, -4, 24, 38]
def offset(k, x):
    return x + k
def isBig(n):
    return n > 16 and n % 2 != 0
def _pf_fn3(_pf_x):
    def _pf_fn4(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn4, _pf_indexed(_pf_x))
outcome = len(_pf_sort_by(lambda x: x % 5, (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))(_pf_filter(lambda x: x % 4 == 2, _pf_fn3(readings)))))
