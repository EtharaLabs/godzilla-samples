import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def isEven2(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return isEven2(n - 1)
print(_pf_partition(isEven2, [19, 6, 9, 14, 33]))
inputs2 = [15, 26, 10, 13, 26, 30]
gain = 4
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(inputs2)))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(inputs2), inputs2))
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(4), makers2))
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
obs = [27, -15, 0, 9]
print(_pf_map(Text_square, obs))
print(Text_norm1(obs))
print(_pf_filter(functools.partial(Text_between, 1, 14), obs))
print(Text_scaleAll(5, obs))
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 2], lambda k: Grid_yield_(a * b + k))
cells = Grid_combine(Grid_for_([(2, 1), (5, 1)], _pf_fn0), Grid_delay(lambda _: Grid_yield_(1)))
print(cells)
