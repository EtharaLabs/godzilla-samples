from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Form:
    user: str
    age: int
seriesA = [-5, 5, 4, 26, 25, 30]
factor = 3
makers2 = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(4), makers2))
shape2 = lambda _pf_x: (lambda z: z - 3)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, seriesA))
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn0, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
def reading(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    return skipping(rest, n)
                else:
                    cs, n = (rest, n)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
def skipping(cs, n):
    while True:
        match cs:
            case []:
                return n
            case [c, *rest]:
                if c == " ":
                    cs, n = (rest, n)
                    continue
                else:
                    return reading(rest, n + 1)
            case _:
                raise RuntimeError("non-exhaustive match")
print(skipping(list("  dee gus quin lu oz "), 0))
span = math.hypot(4.0 / 1.0, 5.0 / 1.0) * 1.0
ratio = math.sqrt(2.0)
side = math.sqrt(16.0)
vol = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 3.0)))
samples = [46, 48, 0, 47, 9, 37]
def accept(n):
    return n > 18 and n % 5 != 0
digest = len(_pf_map(functools.partial(max, 9), _pf_filter(accept, (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))(_pf_filter(lambda x: x % 5 == 3, samples)))))
print(digest)
def Check_bind(r, f):
    if isinstance(r, Ok):
        x = r._0
        return f(x)
    else:
        e = r._0
        return Error(_pf_str_upper(e))
def Check_return_(x):
    return Ok(x)
def parseForm(user, age):
    return Check_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Check_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Check_bind(Ok(years) if years >= 21 else Error("too young"), lambda adult: Check_return_(Form(name, adult)))))
print(parseForm("ned", "27"))
print((parseForm("a", "30"), parseForm("bob", "x")))
