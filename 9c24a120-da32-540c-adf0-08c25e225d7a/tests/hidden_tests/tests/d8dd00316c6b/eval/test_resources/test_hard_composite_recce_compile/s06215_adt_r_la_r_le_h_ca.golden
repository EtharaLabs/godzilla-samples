from dataclasses import dataclass
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: str
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
def show(t):
    match t:
        case Rest(s0):
            return f"rest({s0})"
        case Pop(s0):
            return f"pop({s0})"
        case Load(n0):
            return f"load({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Load(x0):
            return x0
        case Turn(x0):
            return x0 * 3
        case Pop(_):
            return 8
        case _:
            return 0
stream = [Pop("jo"), Load(10), Pop("gus"), Turn(9), Pop("jo"), Load(3), Rest("max")]
_pf_iter(lambda t: print(show(t)), stream)
total = _pf_sum_by(rank, stream)
print(f"total={total}")
print(len(_pf_filter(lambda t: rank(t) > 1, stream)))
seriesA = [3, 5, -2, 13, -2]
gain = 4
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(seriesA))))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
def female(n):
    if n == 0:
        return 1
    else:
        return n - male(female(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - female(male(n - 1))
print((_pf_map(female, _pf_range(0, 12)), _pf_map(male, _pf_range(0, 8))))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [7, 5, 5])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 4) + maybeLog(False, 2))
def quiet(x):
    return x + 9
print(mapTwice(quiet, [4]))
