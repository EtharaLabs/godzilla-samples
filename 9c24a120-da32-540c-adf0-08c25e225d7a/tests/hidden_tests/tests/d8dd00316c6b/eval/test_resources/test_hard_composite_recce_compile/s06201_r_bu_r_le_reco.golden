from dataclasses import dataclass
import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 4], lambda k: Grid_yield_(a * b + k))
combos = Grid_combine(Grid_for_([(2, 3), (1, 3)], _pf_fn0), Grid_delay(lambda _: Grid_yield_(4)))
print(combos)
def ping(n, acc):
    if n <= 0:
        return acc
    else:
        return stepB(n - 1, acc + 1)
def stepB(n, acc):
    if n <= 0:
        return acc
    else:
        return pang(n - 2, acc * 2)
def pang(n, acc):
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
print(_pf_map(lambda n: ping(n, 1), [19, 5, 14, 10]))
book = [Booking(100, "quin", 241, True, Addr("Oslo", 3)), Booking(101, "quin", 246, True, Addr("Bern", 2)), Booking(102, "quin", 98, True, Addr("Kyiv", 3)), Booking(103, "fay", 56, False, Addr("Riga", 2)), Booking(104, "quin", 153, True, Addr("Baku", 2))]
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn1, (0, 0), book)
print(f"{nrec} records, {amt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 186, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def _pf_fn2(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn2, _pf_group_by(lambda o: o.owner, book))
print(byOwner)
def _pf_fn3(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Booking(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Addr("Hub", 1))
    else:
        return o
moved = _pf_map(_pf_fn3, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
def tag(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, book)))
