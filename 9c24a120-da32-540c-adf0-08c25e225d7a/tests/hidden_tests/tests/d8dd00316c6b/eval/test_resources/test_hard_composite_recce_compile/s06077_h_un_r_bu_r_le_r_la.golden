import math
import math as mth
def _pf_concat(xs, ys):
    return xs + ys
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fst(p):
    return p[0]
span = math.hypot(8.0 / 1.0, 7.0 / 1.0) * 1.0
factor = math.sqrt(5.0)
side = math.sqrt(64.0)
vol = math.cbrt(27.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(span / 1.0))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 6.0)))
def Logged_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Logged_return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])
def compute(x):
    return Logged_bind(tell(f"start {x}"), lambda _: Logged_bind((x * 2, ["scaled"]), lambda y: (lambda z: Logged_bind(tell(f"z={z}"), lambda _: Logged_return_(z)))(y + 9)))
print(_pf_map(compute, [7, 8]))
def ping(n, acc):
    if n <= 0:
        return acc
    else:
        return pong(n - 1, acc + 1)
def pong(n, acc):
    if n <= 0:
        return acc
    else:
        return stepC(n - 2, acc * 2)
def stepC(n, acc):
    if n <= 0:
        return acc
    else:
        return ping(n - 3, acc - 1)
print(_pf_map(lambda n: ping(n, 1), [15, 12, 6, 2]))
nums2 = [-7, -1, 28, 6, 23, -7, 22]
gain = 4
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(nums2), nums2))
tweak2 = lambda _pf_x: (lambda z: z - 8)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, nums2))
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(nums2))))
