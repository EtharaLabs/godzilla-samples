def fem(n):
    if n == 0:
        return 1
    else:
        return n - male(fem(n - 1))
def male(n):
    if n == 0:
        return 0
    else:
        return n - fem(male(n - 1))
print((_pf_map(fem, _pf_range(0, 7)), _pf_map(male, _pf_range(0, 10))))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(419, 229))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(308, 0))
