import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fst(p):
    return p[0]
def Writer_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Writer_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def trace2(x):
    return Writer_bind(note2(f"start {x}"), lambda _: Writer_bind((x * 4, ["scaled"]), lambda y: (lambda z: Writer_bind(note2(f"z={z}"), lambda _: Writer_return_(z)))(y + 4)))
print(_pf_map(trace2, [7, 2]))
def evenP(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return evenP(n - 1)
print(_pf_partition(evenP, [14, 17, 30, 0, 33]))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(8186))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(4, 13, 1))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(384, 201))
nums2 = [10, 0, 23, 4, 16, 4, 16]
factor = 4
def _pf_fn0(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn0, _pf_indexed(nums2))))
makers2 = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(2), makers2))
shape2 = lambda _pf_x: (lambda z: z - 0)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, nums2))
def _pf_fn1(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn1, (0, 0), nums2))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn2, _pf_zip(nums2, _pf_map(lambda x: x * x, nums2)))))
