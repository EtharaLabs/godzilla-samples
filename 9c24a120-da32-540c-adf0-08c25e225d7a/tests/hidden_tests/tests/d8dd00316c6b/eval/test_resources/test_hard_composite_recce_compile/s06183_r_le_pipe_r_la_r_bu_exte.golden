from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_str_rev(s):
    return "".join(reversed(s))
def isEven2(n):
    if n == 0:
        return True
    else:
        return oddP(n - 1)
def oddP(n):
    if n == 0:
        return False
    else:
        return isEven2(n - 1)
print(_pf_partition(isEven2, [25, 18, 12, 34, 25]))
samples = [-2, 50, 42, 9, 33, 46, 23]
def offset(k, x):
    return x + k
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
result = _pf_list_find(lambda x: x % 3 == 1, _pf_map(functools.partial(offset, 7), _pf_drop(2, _pf_fn1(samples))))
print(result)
print(len(samples))
nums2 = [16, 18, 3, 20, -5]
factor = 5
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(nums2), nums2))
def _pf_fn3(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn3, (0, 0), nums2))
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(3), scalers))
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn4(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 2], lambda k: Grid_yield_(a * b + k))
cells = Grid_combine(Grid_for_([(4, 2), (5, 2)], _pf_fn4), Grid_delay(lambda _: Grid_yield_(9)))
print(cells)
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
print(_pf_str_rev(str.upper("ray")))
print(_pf_map(math.isqrt, [231, 369, 75, 200]))
