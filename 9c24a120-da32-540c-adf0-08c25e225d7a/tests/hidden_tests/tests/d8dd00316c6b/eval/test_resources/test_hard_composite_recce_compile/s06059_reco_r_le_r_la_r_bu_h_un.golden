from dataclasses import dataclass
import functools
import math
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fst(p):
    return p[0]
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
orders = [Ticket(100, "pam", 247, True), Ticket(101, "fay", 154, False), Ticket(102, "fay", 271, False), Ticket(103, "pam", 137, False), Ticket(104, "oz", 64, False), Ticket(105, "pam", 47, True)]
cheap, dear = _pf_partition(lambda o: o.amount < 179, orders)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def adjust(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 12), orders)))
def evenP(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return evenP(n - 1)
print(_pf_partition(evenP, [0, 29, 21, 10, 40]))
nums2 = [-9, 16, -5, 10, 23, 23, 7]
gain = 5
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn0, _pf_zip(nums2, _pf_map(lambda x: x * x, nums2)))))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(nums2), nums2))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(nums2))))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
def Grid_yield_(x):
    return [x]
def Grid_combine(a, b):
    return _pf_concat(a, b)
def Grid_delay(f):
    return f(None)
Grid_zero = []
def Grid_for_(xs, f):
    return _pf_collect(f, xs)
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Grid_for_([1, 4], lambda k: Grid_yield_(a * b + k))
combos = Grid_combine(Grid_for_([(3, 3), (2, 1)], _pf_fn2), Grid_delay(lambda _: Grid_yield_(6)))
print(combos)
span = math.hypot(2.0 / 1.0, 2.0 / 1.0) * 1.0
factor = math.sqrt(10.0)
side = math.sqrt(4.0)
vol = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 3.0)))
