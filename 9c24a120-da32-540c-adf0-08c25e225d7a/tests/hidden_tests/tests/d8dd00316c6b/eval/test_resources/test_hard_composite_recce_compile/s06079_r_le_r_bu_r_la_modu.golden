        return Error(_pf_str_upper(e))
def Valid_return_(x):
    return Ok(x)
def readForm(user, age):
    return Valid_bind(Ok(user) if len(user) > 1 else Error("short name"), lambda name: Valid_bind(_pf_option_to_result("bad age", _pf_str_to_int(age)), lambda years: Valid_bind(Ok(years) if years >= 17 else Error("too young"), lambda adult: Valid_return_(Form(name, adult)))))
