def value(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return value(env, a) + value(env, b)
            case Block(body, last):
                env, e = (_pf_fold(runSt, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def runSt(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, value(env, e), env)
        case Show(e):
            return _pf_map_add("shown", value(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(value(dict(), Block([Set("a", Lit(9)), Set("b", Plus(Ref("a"), Lit(7))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
