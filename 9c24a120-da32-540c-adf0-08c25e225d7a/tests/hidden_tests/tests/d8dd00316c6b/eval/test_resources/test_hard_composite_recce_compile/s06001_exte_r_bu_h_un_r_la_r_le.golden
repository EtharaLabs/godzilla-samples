from dataclasses import dataclass
import functools
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(3))
def fromBin(s):
    return int(s, base=2)
print(fromBin("10000") + int("17", base=8))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [6, 10, 11, 2]))
def Perhaps_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Perhaps_return_(x):
    return Some(x)
def ratio2(a, b):
    return Perhaps_bind(_pf_str_to_int(a), lambda x: Perhaps_bind(_pf_str_to_int(b), lambda y: Perhaps_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Perhaps_return_(shown))(q * 3))))
print((ratio2("79", "9"), ratio2("4", "0"), ratio2("x", "1")))
reach = math.hypot(8.0 / 1.0, 4.0 / 1.0) * 1.0
factor = math.sqrt(2.0)
side = math.sqrt(64.0)
vol = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(reach / 1.0))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 9.0)))
seriesA = [17, -3, 4, 7, 15, -1, 19, 25]
gain = 4
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * gain
print(len(_pf_filter(_pf_fn0, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % gain, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(seriesA))))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(seriesA), seriesA))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(seriesA)))
def _pf_fn2(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn2, (0, 0), seriesA))
def isEven2(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return isEven2(n - 1)
