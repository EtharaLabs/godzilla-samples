print(_pf_fmt_fixed(2, velocity(reach, 6.0)))
def stepA(n, acc):
    if n <= 0:
        return acc
    else:
        return pong(n - 1, acc + 1)
def pong(n, acc):
    if n <= 0:
        return acc
    else:
        return pang(n - 2, acc * 2)
def pang(n, acc):
    if n <= 0:
        return acc
    else:
        return stepA(n - 3, acc - 1)
print(_pf_map(lambda n: stepA(n, 1), [15, 2, 13, 19]))
