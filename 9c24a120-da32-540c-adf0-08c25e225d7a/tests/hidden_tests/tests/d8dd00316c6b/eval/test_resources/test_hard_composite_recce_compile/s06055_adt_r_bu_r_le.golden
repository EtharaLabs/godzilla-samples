def show(t):
    match t:
        case Skip(n0) if n0 % 2 == 0:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Push(n0, n1) if 0 <= n0 < 14:
            return f"push!({n0},{n1})"
        case Push(n0, n1):
            return f"push({n0},{n1})"
        case Jump(s0, s1):
            return f"jump({s0},{s1})"
        case Turn(s0):
            return f"turn({s0})"
        case Rest(2, _):
            return "rest-2"
        case Rest(n0, s1):
            return f"rest({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Push(x0, x1):
            return x0 + x1 * 4
        case _:
            return 2
stream = [Push(8, 7), Skip(9), Jump("bo", "kit"), Skip(7), Turn("oz"), Jump("quin", "kit"), Skip(-3)]
print(_pf_str_join(" ", _pf_map(show, stream)))
total = _pf_sum_by(weight, stream)
print(f"total={total}")
print(_pf_max_by(weight, stream))
def Logged_bind(m, f):
    match m:
        case (v, log):
            match f(v):
                case (w, log2):
                    return (w, _pf_concat(log, log2))
def Logged_return_(x):
    return (x, [])
def note2(msg):
    return (None, [msg])
def compute(x):
    return Logged_bind(note2(f"start {x}"), lambda _: Logged_bind((x * 2, ["scaled"]), lambda y: (lambda z: Logged_bind(note2(f"z={z}"), lambda _: Logged_return_(z)))(y + 1)))
print(_pf_map(compute, [6, 5]))
def value(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return value(env, a) + value(env, b)
            case Block(body, last):
                env, e = (_pf_fold(exec, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def exec(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, value(env, e), env)
        case Show(e):
            return _pf_map_add("shown", value(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(value(dict(), Block([Set("a", Lit(7)), Set("b", Plus(Ref("a"), Lit(1))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
