from dataclasses import dataclass
import functools
import math
import math as mth
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: str
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: str
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Lit:
    _0: int
    def __repr__(self):
        return f"Lit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ref:
    _0: str
    def __repr__(self):
        return f"Ref({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Plus:
    _0: object
    _1: object
    def __repr__(self):
        return f"Plus({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: object
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: object
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: object
    def __repr__(self):
        return f"Show({self._0!r})"
def explain(t):
    match t:
        case Push(s0):
            return f"push({s0})"
        case Rest(s0):
            return f"rest({s0})"
        case Emit(s0):
            return f"emit({s0})"
        case Jump(1):
            return "jump-1"
        case Jump(n0):
            return f"jump({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Emit(_):
            return 8
        case Rest(_):
            return 7
        case Push(_):
            return 8
        case _:
            return 1
queue = [Emit("hal"), Emit("ivy"), Emit("sue"), Rest("lu"), Emit("dee"), Push("ned"), Emit("gus")]
_pf_iter(lambda t: print(explain(t)), queue)
total = _pf_sum_by(rank, queue)
print(f"total={total}")
print(len(_pf_filter(lambda t: rank(t) > 0, queue)))
reach = math.hypot(4.0 / 1.0, 3.0 / 1.0) * 1.0
ratio = math.sqrt(2.0)
side = math.sqrt(16.0)
vol = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(reach / 1.0))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 7.0)))
def evalEx(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return evalEx(env, a) + evalEx(env, b)
            case Block(body, last):
                env, e = (_pf_fold(runSt, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def runSt(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, evalEx(env, e), env)
        case Show(e):
            return _pf_map_add("shown", evalEx(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(evalEx(dict(), Block([Set("a", Lit(8)), Set("b", Plus(Ref("a"), Lit(7))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
