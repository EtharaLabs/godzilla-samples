from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def Perhaps_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Perhaps_return_(x):
    return Some(x)
def safeDiv(a, b):
    return Perhaps_bind(_pf_str_to_int(a), lambda x: Perhaps_bind(_pf_str_to_int(b), lambda y: Perhaps_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Perhaps_return_(shown))(q * 3))))
print((safeDiv("51", "6"), safeDiv("4", "0"), safeDiv("x", "1")))
def evenP(n):
    if n == 0:
        return True
    else:
        return isOdd2(n - 1)
def isOdd2(n):
    if n == 0:
        return False
    else:
        return evenP(n - 1)
print(_pf_partition(evenP, [31, 19, 14, 19, 9]))
nums2 = [19, -8, -6, 19, 2, 10]
factor = 3
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn0, _pf_zip(nums2, _pf_map(lambda x: x * x, nums2)))))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(nums2))))
makers2 = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(4), makers2))
def _pf_fn2(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn2, (0, 0), nums2))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_square(x):
    return x * x
def Text_between(lo, hi, x):
    return lo <= x <= hi
nums = [18, 13, 14, 8]
print(Text_norm1(nums))
print(_pf_map(functools.partial(Text_clamp, 0, 14), nums))
print(_pf_map(Text_square, nums))
print(_pf_filter(functools.partial(Text_between, -3, 17), nums))
