def evenP(n):
    if n == 0:
        return True
    else:
        return oddP(n - 1)
def oddP(n):
    if n == 0:
        return False
    else:
        return evenP(n - 1)
print(_pf_partition(evenP, [23, 7, 6, 11, 6]))
