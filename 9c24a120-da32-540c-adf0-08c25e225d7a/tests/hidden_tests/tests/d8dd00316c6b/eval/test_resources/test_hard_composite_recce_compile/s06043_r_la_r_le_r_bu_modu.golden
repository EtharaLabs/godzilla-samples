from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True, repr=False)
class Lit:
    _0: int
    def __repr__(self):
        return f"Lit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ref:
    _0: str
    def __repr__(self):
        return f"Ref({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Plus:
    _0: object
    _1: object
    def __repr__(self):
        return f"Plus({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Block:
    _0: list
    _1: object
    def __repr__(self):
        return f"Block({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Set:
    _0: str
    _1: object
    def __repr__(self):
        return f"Set({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Show:
    _0: object
    def __repr__(self):
        return f"Show({self._0!r})"
nums2 = [15, -9, 23, 1, 27, 25, 6, 29]
gain = 5
def _pf_fn0(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn0, (0, 0), nums2))
print(_pf_map2(lambda a, b: a * gain - b, _pf_rev(nums2), nums2))
shape2 = lambda _pf_x: (lambda z: z - 3)((lambda _pf_x: (lambda y: y * gain)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, nums2))
print(_pf_map(lambda y: y * gain, (lambda ys: _pf_take(len(ys) // 2, ys))(nums2)))
makers2 = _pf_map(lambda s: lambda x: x * s + gain, [1, 2, 3])
print(_pf_map(lambda g: g(2), makers2))
def evalEx(env, e):
    while True:
        match e:
            case Lit(n):
                return n
            case Ref(v):
                return _pf_map_find_or(v, 0, env)
            case Plus(a, b):
                return evalEx(env, a) + evalEx(env, b)
            case Block(body, last):
                env, e = (_pf_fold(exec, env, body), last)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
def exec(env, s):
    match s:
        case Set(v, e):
            return _pf_map_add(v, evalEx(env, e), env)
        case Show(e):
            return _pf_map_add("shown", evalEx(env, e), env)
        case _:
            raise RuntimeError("non-exhaustive match")
print(evalEx(dict(), Block([Set("a", Lit(5)), Set("b", Plus(Ref("a"), Lit(5))), Show(Ref("b"))], Plus(Ref("a"), Ref("shown")))))
def Maybe_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Maybe_return_(x):
    return Some(x)
def ratio2(a, b):
    return Maybe_bind(_pf_str_to_int(a), lambda x: Maybe_bind(_pf_str_to_int(b), lambda y: Maybe_bind(_None_ if y == 0 else Some(x // y), lambda q: (lambda shown: Maybe_return_(shown))(q * 1))))
print((ratio2("33", "3"), ratio2("4", "0"), ratio2("x", "1")))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [-6, 25, 10, 25, -14, 24]
print(Calc_scaleAll(2, obs))
print(_pf_filter(functools.partial(Calc_between, -3, 23), obs))
print(Calc_norm1(obs))
print(Calc_mean(obs))
