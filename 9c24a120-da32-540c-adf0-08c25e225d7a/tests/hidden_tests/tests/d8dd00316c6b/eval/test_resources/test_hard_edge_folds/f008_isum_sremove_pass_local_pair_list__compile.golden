import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_remove(x, s):
    return s.difference([x])
init_a = 100
init_c = 42
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b, c = _pf_arg0
        k, v = _pf_arg1
        return (a + k * 2, _pf_set_remove(k, b), c)
    return _pf_fold(step, (init_a, set(), init_c), [(1, 10), (2, 20), (1, 30), (4, 40)])
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
