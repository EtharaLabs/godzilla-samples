import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_remove(x, s):
    return s.difference([x])
pairs = [(5, 50), (6, 60), (5, 70)]
def _pf_fn0(_pf_arg0, _pf_arg1):
    a, b = _pf_arg0
    k, v = _pf_arg1
    return (_pf_set_remove(k, a), _pf_map_add(k, v, b) if k % 2 == 0 else b)
result = _pf_fold(_pf_fn0, (set(), dict()), iter(pairs))
r_a, r_b = result
print(list(r_a))
print(_pf_map_to_list(r_b))
