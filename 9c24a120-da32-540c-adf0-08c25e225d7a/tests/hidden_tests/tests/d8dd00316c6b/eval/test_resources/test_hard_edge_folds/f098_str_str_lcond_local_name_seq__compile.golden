import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_str_concat(a, b):
    return a + b
init_a = ">"
init_c = [0]
def compute(u):
    def step(_pf_arg0, x):
        a, b, c = _pf_arg0
        return (_pf_str_concat(a, str(x)), _pf_str_concat(b, str(x)), _pf_concat(c, [x * 3]) if x > 2 else c)
    return _pf_fold(step, (init_a, "", init_c), range(1, 6))
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(r_b)
