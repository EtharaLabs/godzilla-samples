import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_str_concat(a, b):
    return a + b
init_b = [1, 1]
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_str_concat(a, str(x)), _pf_concat(b, b), c)
def compute(u):
    return _pf_fold(step, ("", init_b, 0), [3, 1, 4, 1, 5])
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(len(r_b))
print(r_c)
