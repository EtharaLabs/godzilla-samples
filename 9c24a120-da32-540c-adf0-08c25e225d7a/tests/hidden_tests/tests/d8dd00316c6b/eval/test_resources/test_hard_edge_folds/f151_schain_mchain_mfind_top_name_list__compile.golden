from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_set_remove(x + 1, _pf_set_add(x, a)), _pf_map_add(x + 100, x * 3, _pf_map_add(x, x * 3, b)), _pf_map_add(x, _pf_option_with_default(0, _pf_map_try_find(x, c)) + 1, c))
result = _pf_fold(step, (set(), dict(), dict()), _pf_range(1, 6))
r_a, r_b, r_c = result
print(list(r_a))
print(_pf_map_to_list(r_b))
print(_pf_map_to_list(r_c))
