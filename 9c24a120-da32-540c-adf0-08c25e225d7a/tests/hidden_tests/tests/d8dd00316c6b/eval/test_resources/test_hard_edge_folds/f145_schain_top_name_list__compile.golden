def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
def step(a, x):
    return _pf_set_remove(x + 1, _pf_set_add(x, a))
def compute(u):
    a = set()
    for x in _pf_range(1, 6):
        _pf_t0 = x + 1
        a.add(x)
        a.discard(_pf_t0)
    return a
result = compute(None)
print(list(result))
