import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_a = dict([(0, 0), (9, 9)])
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_map_add(x, x * 3, a), b + x * 2)
def compute(u):
    return _pf_fold(step, (init_a, 0), range(1, 6))
result = compute(None)
r_a, r_b = result
print(_pf_map_to_list(r_a))
print(r_b)
