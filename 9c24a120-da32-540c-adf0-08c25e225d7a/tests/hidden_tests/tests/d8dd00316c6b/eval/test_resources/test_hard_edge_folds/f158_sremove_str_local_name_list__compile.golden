import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_set_remove(x, s):
    return s.difference([x])
def _pf_str_concat(a, b):
    return a + b
def compute(u):
    def step(_pf_arg0, x):
        a, b = _pf_arg0
        return (_pf_set_remove(x, a), _pf_str_concat(b, str(x)))
    return _pf_fold(step, (set(), ""), _pf_range(1, 6))
result = compute(None)
r_a, r_b = result
print(list(r_a))
print(r_b)
