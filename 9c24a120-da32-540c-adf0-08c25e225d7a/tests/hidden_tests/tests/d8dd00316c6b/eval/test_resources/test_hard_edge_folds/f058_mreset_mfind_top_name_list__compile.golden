from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
nums = [2, 7, 1, 8, 2, 8]
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_map_add(x, x * 3, dict()) if x > 3 else _pf_map_add(x, 0, a), _pf_map_add(x, _pf_option_with_default(0, _pf_map_try_find(x, b)) + 1, b))
result = _pf_fold(step, (dict(), dict()), nums)
r_a, r_b = result
print(_pf_map_to_list(r_a))
print(_pf_map_to_list(r_b))
