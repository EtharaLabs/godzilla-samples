import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_c = dict([(2, 0)])
nums = [2, 7, 1, 8, 2, 8]
def compute(u):
    def step(_pf_arg0, x):
        a, b, c = _pf_arg0
        return (_pf_map_add(x, x * 3, dict()) if x > 3 else _pf_map_add(x, 0, a), _pf_map_add(x, x * 3, b), _pf_map_add(x, x * 3, c) if x % 2 == 0 else c)
    return _pf_fold(step, (dict(), dict(), init_c), nums)
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(_pf_map_to_list(r_b))
print(_pf_map_to_list(r_c))
