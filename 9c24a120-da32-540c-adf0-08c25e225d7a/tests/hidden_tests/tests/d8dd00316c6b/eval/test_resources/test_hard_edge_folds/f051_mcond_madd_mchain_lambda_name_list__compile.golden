import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_b = dict([(0, 0), (9, 9)])
def _pf_fn0(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_map_add(x, x * 3, a) if x % 2 == 0 else a, _pf_map_add(x, x * 3, b), _pf_map_add(x + 100, x * 3, _pf_map_add(x, x * 3, c)))
result = _pf_fold(_pf_fn0, (dict(), init_b, dict()), [3, 1, 4, 1, 5])
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(_pf_map_to_list(r_b))
print(_pf_map_to_list(r_c))
