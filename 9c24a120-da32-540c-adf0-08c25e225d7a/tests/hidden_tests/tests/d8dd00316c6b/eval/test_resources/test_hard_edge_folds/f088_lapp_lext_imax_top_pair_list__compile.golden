import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
init_c = 7
def step(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_concat(a, [k]), _pf_concat(b, [k, v]), k if k > c else c)
def compute(u):
    return _pf_fold(step, ([], [], init_c), _pf_zip([1, 2, 3, 5], [7, 8, 9, 6]))
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(r_b)
print(r_c)
