        k, v = _pf_arg1
        return (_pf_concat(a, [k, v]), _pf_concat(b, [len(b) + k]), _pf_concat(c, [k]))
    return _pf_fold(step, (init_a, [], []), iter(_pf_zip([1, 2, 3, 5], [7, 8, 9, 6])))
