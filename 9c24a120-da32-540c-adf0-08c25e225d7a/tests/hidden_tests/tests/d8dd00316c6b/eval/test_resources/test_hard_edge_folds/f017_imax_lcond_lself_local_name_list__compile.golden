import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
nums = [2, 7, 1, 8, 2, 8]
def compute(u):
    def step(_pf_arg0, x):
        a, b, c = _pf_arg0
        return (x if x > a else a, _pf_concat(b, [x * 3]) if x > 2 else b, _pf_concat(c, c))
    return _pf_fold(step, (0, [], [1]), nums)
result = compute(None)
