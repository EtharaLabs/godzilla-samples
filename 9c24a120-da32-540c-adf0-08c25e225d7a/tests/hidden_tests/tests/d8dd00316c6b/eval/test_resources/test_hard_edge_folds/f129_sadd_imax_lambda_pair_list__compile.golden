import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_set_add(x, s):
    return s.union([x])
def _pf_fn0(_pf_arg0, _pf_arg1):
    a, b = _pf_arg0
    k, v = _pf_arg1
    return (_pf_set_add(k, a), k if k > b else b)
result = _pf_fold(_pf_fn0, (set(), 0), _pf_zip([1, 2, 3, 5], [7, 8, 9, 6]))
r_a, r_b = result
print(list(r_a))
print(r_b)
