import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_a = [0]
init_b = [1, 1]
init_c = dict([(2, 0)])
nums = [2, 7, 1, 8, 2, 8]
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_concat(a, [x]), _pf_concat(b, b), _pf_map_add(x, x * 3, c) if x % 2 == 0 else c)
def compute(u):
    return _pf_fold(step, (init_a, init_b, init_c), nums)
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(len(r_b))
print(_pf_map_to_list(r_c))
