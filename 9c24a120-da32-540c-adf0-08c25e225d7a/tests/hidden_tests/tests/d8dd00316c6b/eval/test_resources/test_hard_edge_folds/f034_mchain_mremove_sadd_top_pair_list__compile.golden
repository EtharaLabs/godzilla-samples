import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
pairs = [(5, 50), (6, 60), (5, 70)]
def step(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_map_add(k + 100, v, _pf_map_add(k, v, a)), _pf_map_remove(k, b), _pf_set_add(k, c))
def compute(u):
    return _pf_fold(step, (dict(), dict(), set()), pairs)
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(_pf_map_to_list(r_b))
print(list(r_c))
