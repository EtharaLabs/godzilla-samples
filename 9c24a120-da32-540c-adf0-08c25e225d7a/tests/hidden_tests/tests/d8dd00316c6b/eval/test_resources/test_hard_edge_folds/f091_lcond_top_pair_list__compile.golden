def _pf_concat(xs, ys):
    return xs + ys
pairs = [(5, 50), (6, 60), (5, 70)]
def step(a, _pf_arg1):
    k, v = _pf_arg1
    if k > 2:
        return _pf_concat(a, [v])
    else:
        return a
def compute(u):
    a = []
    for (k, v) in pairs:
        if k > 2:
            a.append(v)
    return a
