def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def step(a, _pf_arg1):
    k, v = _pf_arg1
    return _pf_map_add(k, v, a)
