import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
init_b = set([7])
nums = [2, 7, 1, 8, 2, 8]
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_map_add(x, x * 3, a) if x % 2 == 0 else a, _pf_set_remove(x + 1, _pf_set_add(x, b)))
def compute(u):
    return _pf_fold(step, (dict(), init_b), nums)
result = compute(None)
r_a, r_b = result
print(_pf_map_to_list(r_a))
print(list(r_b))
