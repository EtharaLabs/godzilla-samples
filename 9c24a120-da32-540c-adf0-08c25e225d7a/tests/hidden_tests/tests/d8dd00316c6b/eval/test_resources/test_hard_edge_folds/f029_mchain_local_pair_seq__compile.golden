def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def compute(u):
    def step(a, _pf_arg1):
        k, v = _pf_arg1
        return _pf_map_add(k + 100, v, _pf_map_add(k, v, a))
    a = dict()
    for (k, v) in iter([(1, 10), (2, 20), (1, 30), (4, 40)]):
        _pf_t0 = k + 100
        a[k] = v
        a[_pf_t0] = v
    return a
result = compute(None)
print(_pf_map_to_list(result))
