import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
def _pf_str_concat(a, b):
    return a + b
init_b = ">"
pairs = [(5, 50), (6, 60), (5, 70)]
def step(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_map_remove(k, a), _pf_str_concat(b, str(k)), _pf_set_add(k, c))
def compute(u):
    return _pf_fold(step, (dict(), init_b, set()), pairs)
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(r_b)
print(list(r_c))
