import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
init_b = dict([(2, 0)])
def compute(u):
    def step(_pf_arg0, x):
        a, b = _pf_arg0
        return (_pf_map_remove(x, a), _pf_map_add(x, x * 3, b) if x % 2 == 0 else b)
    return _pf_fold(step, (dict(), init_b), [3, 1, 4, 1, 5])
result = compute(None)
r_a, r_b = result
print(_pf_map_to_list(r_a))
print(_pf_map_to_list(r_b))
