from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
nums = [2, 7, 1, 8, 2, 8]
def compute(u):
    def _pf_fn0(_pf_arg0, x):
        a, b, c = _pf_arg0
        return (x if x > a else a, _pf_map_add(x, _pf_option_with_default(0, _pf_map_try_find(x, b)) + 1, b), _pf_concat(c, c))
    return _pf_fold(_pf_fn0, (0, dict(), [1]), nums)
result = compute(None)
