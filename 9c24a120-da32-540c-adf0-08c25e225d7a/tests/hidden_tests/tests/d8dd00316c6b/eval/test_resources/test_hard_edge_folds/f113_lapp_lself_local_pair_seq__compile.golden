import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
init_b = [1, 1]
pairs = [(5, 50), (6, 60), (5, 70)]
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b = _pf_arg0
        k, v = _pf_arg1
        return (_pf_concat(a, [k]), _pf_concat(b, b))
    return _pf_fold(step, ([], init_b), iter(pairs))
result = compute(None)
r_a, r_b = result
print(r_a)
print(len(r_b))
