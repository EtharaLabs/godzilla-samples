import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_set_remove(x, s):
    return s.difference([x])
init_b = [0]
def compute(u):
    def step(_pf_arg0, x):
        a, b = _pf_arg0
        return (_pf_set_remove(x, a), _pf_concat(b, [x]))
    return _pf_fold(step, (set(), init_b), _pf_range(1, 6))
result = compute(None)
r_a, r_b = result
print(list(r_a))
print(r_b)
