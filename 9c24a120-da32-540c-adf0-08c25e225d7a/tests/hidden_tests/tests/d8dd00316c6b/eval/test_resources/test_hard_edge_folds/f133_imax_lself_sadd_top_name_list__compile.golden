import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_add(x, s):
    return s.union([x])
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (x if x > a else a, _pf_concat(b, b), _pf_set_add(x, c))
def compute(u):
    return _pf_fold(step, (0, [1], set()), [3, 1, 4, 1, 5])
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(len(r_b))
print(list(r_c))
