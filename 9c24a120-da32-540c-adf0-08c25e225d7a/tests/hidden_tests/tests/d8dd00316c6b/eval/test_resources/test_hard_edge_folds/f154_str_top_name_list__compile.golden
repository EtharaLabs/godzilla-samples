import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_str_concat(a, b):
    return a + b
def step(a, x):
    return _pf_str_concat(a, str(x))
def compute(u):
    return _pf_fold(step, "", _pf_range(1, 6))
result = compute(None)
print(result)
