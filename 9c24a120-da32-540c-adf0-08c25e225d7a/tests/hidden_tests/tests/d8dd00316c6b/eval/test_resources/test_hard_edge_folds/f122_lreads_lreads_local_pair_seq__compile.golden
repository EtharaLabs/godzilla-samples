import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
pairs = [(5, 50), (6, 60), (5, 70)]
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b = _pf_arg0
        k, v = _pf_arg1
        return (_pf_concat(a, [len(a) + k]), _pf_concat(b, [len(b) + k]))
    return _pf_fold(step, ([], []), iter(pairs))
