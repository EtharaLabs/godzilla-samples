import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_remove(x, s):
    return s.difference([x])
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_concat(a, [x, x * 3]), _pf_set_remove(x, b))
result = _pf_fold(step, ([], set()), [3, 1, 4, 1, 5])
r_a, r_b = result
print(r_a)
print(list(r_b))
