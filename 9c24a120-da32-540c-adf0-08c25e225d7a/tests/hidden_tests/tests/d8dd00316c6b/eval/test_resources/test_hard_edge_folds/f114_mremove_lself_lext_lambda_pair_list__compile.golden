import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
init_a = dict([(1, 1), (3, 3), (5, 5)])
init_b = [1, 1]
def _pf_fn0(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_map_remove(k, a), _pf_concat(b, b), _pf_concat(c, [k, v]))
result = _pf_fold(_pf_fn0, (init_a, init_b, []), [(1, 10), (2, 20), (1, 30), (4, 40)])
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(len(r_b))
print(r_c)
