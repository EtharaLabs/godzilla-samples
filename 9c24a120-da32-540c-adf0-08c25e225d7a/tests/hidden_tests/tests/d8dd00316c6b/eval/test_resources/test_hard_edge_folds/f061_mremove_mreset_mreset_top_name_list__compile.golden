import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
init_b = dict([(8, 8)])
nums = [2, 7, 1, 8, 2, 8]
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_map_remove(x, a), _pf_map_add(x, x * 3, dict()) if x > 3 else _pf_map_add(x, 0, b), _pf_map_add(x, x * 3, dict()) if x > 3 else _pf_map_add(x, 0, c))
def compute(u):
    return _pf_fold(step, (dict(), init_b, dict()), nums)
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(_pf_map_to_list(r_b))
print(_pf_map_to_list(r_c))
