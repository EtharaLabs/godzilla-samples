import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_map_add(x, x * 3, a) if x % 2 == 0 else a, _pf_concat(b, [len(b) + x]), _pf_concat(c, c))
def compute(u):
    return _pf_fold(step, (dict(), [], [1]), _pf_range(1, 6))
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(r_b)
print(len(r_c))
