import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
pairs = [(5, 50), (6, 60), (5, 70)]
def step(_pf_arg0, _pf_arg1):
    a, b = _pf_arg0
    k, v = _pf_arg1
    return (k if k > a else a, _pf_concat(b, [len(b) + k]))
def compute(u):
    return _pf_fold(step, (0, []), pairs)
result = compute(None)
r_a, r_b = result
print(r_a)
print(r_b)
