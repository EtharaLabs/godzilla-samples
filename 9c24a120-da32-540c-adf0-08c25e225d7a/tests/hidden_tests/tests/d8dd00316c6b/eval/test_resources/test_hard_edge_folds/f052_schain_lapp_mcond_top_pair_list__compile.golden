import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
init_c = dict([(2, 0)])
pairs = [(5, 50), (6, 60), (5, 70)]
def step(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_set_remove(k + 1, _pf_set_add(k, a)), _pf_concat(b, [k]), _pf_map_add(k, v, c) if k % 2 == 0 else c)
def compute(u):
    return _pf_fold(step, (set(), [], init_c), pairs)
result = compute(None)
r_a, r_b, r_c = result
print(list(r_a))
print(r_b)
print(_pf_map_to_list(r_c))
