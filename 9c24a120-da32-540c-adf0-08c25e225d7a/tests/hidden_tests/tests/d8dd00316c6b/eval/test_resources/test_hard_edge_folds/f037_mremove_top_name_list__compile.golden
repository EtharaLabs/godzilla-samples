def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
nums = [2, 7, 1, 8, 2, 8]
def step(a, x):
    return _pf_map_remove(x, a)
a = dict()
for x in nums:
    a.pop(x, None)
result = a
print(_pf_map_to_list(result))
