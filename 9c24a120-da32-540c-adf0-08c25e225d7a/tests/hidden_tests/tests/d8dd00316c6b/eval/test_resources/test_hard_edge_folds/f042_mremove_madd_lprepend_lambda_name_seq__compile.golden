import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
def _pf_fn0(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_map_remove(x, a), _pf_map_add(x, x * 3, b), _pf_concat([x], c))
result = _pf_fold(_pf_fn0, (dict(), dict(), []), iter([3, 1, 4, 1, 5]))
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(_pf_map_to_list(r_b))
print(r_c)
