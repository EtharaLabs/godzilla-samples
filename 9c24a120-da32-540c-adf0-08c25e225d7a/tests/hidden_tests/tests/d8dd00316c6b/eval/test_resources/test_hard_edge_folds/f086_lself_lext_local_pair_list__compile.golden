import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
init_b = [0]
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b = _pf_arg0
        k, v = _pf_arg1
        return (_pf_concat(a, a), _pf_concat(b, [k, v]))
    return _pf_fold(step, ([1], init_b), [(1, 10), (2, 20), (1, 30), (4, 40)])
result = compute(None)
r_a, r_b = result
print(len(r_a))
print(r_b)
