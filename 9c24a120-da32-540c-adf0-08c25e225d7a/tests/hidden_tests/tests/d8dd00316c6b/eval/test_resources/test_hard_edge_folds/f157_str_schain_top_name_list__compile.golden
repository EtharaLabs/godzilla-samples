import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
def _pf_str_concat(a, b):
    return a + b
init_a = ">"
nums = [2, 7, 1, 8, 2, 8]
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_str_concat(a, str(x)), _pf_set_remove(x + 1, _pf_set_add(x, b)))
def compute(u):
    return _pf_fold(step, (init_a, set()), nums)
result = compute(None)
r_a, r_b = result
print(r_a)
print(list(r_b))
