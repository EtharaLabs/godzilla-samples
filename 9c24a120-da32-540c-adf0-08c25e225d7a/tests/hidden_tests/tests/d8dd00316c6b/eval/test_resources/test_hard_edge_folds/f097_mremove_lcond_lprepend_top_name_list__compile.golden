import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
init_a = dict([(1, 1), (3, 3), (5, 5)])
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (_pf_map_remove(x, a), _pf_concat(b, [x * 3]) if x > 2 else b, _pf_concat([x], c))
def compute(u):
    return _pf_fold(step, (init_a, [], []), [3, 1, 4, 1, 5])
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(r_b)
print(r_c)
