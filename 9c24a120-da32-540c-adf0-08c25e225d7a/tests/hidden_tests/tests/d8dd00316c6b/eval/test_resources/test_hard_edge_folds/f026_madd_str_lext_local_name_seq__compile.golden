import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_concat(a, b):
    return a + b
init_a = dict([(0, 0), (9, 9)])
init_b = ">"
def compute(u):
    def step(_pf_arg0, x):
        a, b, c = _pf_arg0
        return (_pf_map_add(x, x * 3, a), _pf_str_concat(b, str(x)), _pf_concat(c, [x, x * 3]))
    return _pf_fold(step, (init_a, init_b, []), range(1, 6))
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(r_b)
print(r_c)
