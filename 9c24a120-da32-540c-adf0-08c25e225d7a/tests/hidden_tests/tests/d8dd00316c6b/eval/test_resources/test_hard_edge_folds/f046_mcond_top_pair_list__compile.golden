def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_a = dict([(2, 0)])
pairs = [(5, 50), (6, 60), (5, 70)]
def step(a, _pf_arg1):
    k, v = _pf_arg1
    if k % 2 == 0:
        return _pf_map_add(k, v, a)
    else:
        return a
def compute(u):
    a = dict(init_a)
    for (k, v) in pairs:
        if k % 2 == 0:
            a[k] = v
    return a
result = compute(None)
print(_pf_map_to_list(result))
