import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
init_b = [0]
def step(_pf_arg0, _pf_arg1):
    a, b = _pf_arg0
    k, v = _pf_arg1
    return (_pf_concat(a, [v]) if k > 2 else a, _pf_concat(b, [v]) if k > 2 else b)
result = _pf_fold(step, ([], init_b), [(1, 10), (2, 20), (1, 30), (4, 40)])
r_a, r_b = result
print(r_a)
print(r_b)
