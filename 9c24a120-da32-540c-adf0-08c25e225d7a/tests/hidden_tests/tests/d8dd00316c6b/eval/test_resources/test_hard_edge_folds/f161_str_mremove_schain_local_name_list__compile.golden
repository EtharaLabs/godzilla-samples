import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
def _pf_str_concat(a, b):
    return a + b
init_a = ">"
def compute(u):
    def step(_pf_arg0, x):
        a, b, c = _pf_arg0
        return (_pf_str_concat(a, str(x)), _pf_map_remove(x, b), _pf_set_remove(x + 1, _pf_set_add(x, c)))
    return _pf_fold(step, (init_a, dict(), set()), _pf_range(1, 6))
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(_pf_map_to_list(r_b))
print(list(r_c))
