import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_c = dict([(8, 8)])
pairs = [(5, 50), (6, 60), (5, 70)]
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b, c = _pf_arg0
        k, v = _pf_arg1
        return (a, _pf_concat(b, b), _pf_map_add(k, v, dict()) if k > 3 else _pf_map_add(k, 0, c))
    return _pf_fold(step, (0, [1], init_c), pairs)
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(len(r_b))
print(_pf_map_to_list(r_c))
