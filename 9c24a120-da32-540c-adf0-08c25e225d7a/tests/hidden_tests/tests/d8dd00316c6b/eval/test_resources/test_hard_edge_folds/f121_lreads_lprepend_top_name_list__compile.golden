import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
nums = [2, 7, 1, 8, 2, 8]
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_concat(a, [len(a) + x]), _pf_concat([x], b))
result = _pf_fold(step, ([], []), nums)
r_a, r_b = result
print(r_a)
print(r_b)
