import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_remove(x, s):
    return s.difference([x])
init_a = 7
init_b = set([1, 2, 3, 4])
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b = _pf_arg0
        k, v = _pf_arg1
        return (k if k > a else a, _pf_set_remove(k, b))
    return _pf_fold(step, (init_a, init_b), [(1, 10), (2, 20), (1, 30), (4, 40)])
result = compute(None)
r_a, r_b = result
print(r_a)
print(list(r_b))
