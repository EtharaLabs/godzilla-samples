import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def compute(u):
    def step(_pf_arg0, x):
        a, b = _pf_arg0
        return (_pf_concat(a, [x * 3]) if x > 2 else a, _pf_concat(b, [x]))
    return _pf_fold(step, ([], []), _pf_range(1, 6))
result = compute(None)
r_a, r_b = result
print(r_a)
print(r_b)
