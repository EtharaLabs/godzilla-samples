import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_set_remove(x + 1, _pf_set_add(x, a)), b + x * 2)
result = _pf_fold(step, (set(), 0), [3, 1, 4, 1, 5])
r_a, r_b = result
print(list(r_a))
print(r_b)
