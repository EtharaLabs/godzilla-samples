import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_remove(x, s):
    return s.difference([x])
def step(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_set_remove(k, a), _pf_map_add(k + 100, v, _pf_map_add(k, v, b)), _pf_map_add(k + 100, v, _pf_map_add(k, v, c)))
def compute(u):
    return _pf_fold(step, (set(), dict(), dict()), _pf_zip([1, 2, 3, 5], [7, 8, 9, 6]))
result = compute(None)
r_a, r_b, r_c = result
print(list(r_a))
print(_pf_map_to_list(r_b))
print(_pf_map_to_list(r_c))
