import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_a = dict([(2, 0)])
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b = _pf_arg0
        k, v = _pf_arg1
        return (_pf_map_add(k, v, a) if k % 2 == 0 else a, _pf_concat(b, [k]))
    return _pf_fold(step, (init_a, []), iter([(1, 10), (2, 20), (1, 30), (4, 40)]))
result = compute(None)
r_a, r_b = result
print(_pf_map_to_list(r_a))
print(r_b)
