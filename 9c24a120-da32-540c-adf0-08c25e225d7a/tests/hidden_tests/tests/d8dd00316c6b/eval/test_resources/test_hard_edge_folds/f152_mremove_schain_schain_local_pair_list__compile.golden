        a, b, c = _pf_arg0
        k, v = _pf_arg1
        return (_pf_map_remove(k, a), _pf_set_remove(k + 1, _pf_set_add(k, b)), _pf_set_remove(k + 1, _pf_set_add(k, c)))
    return _pf_fold(step, (dict(), init_b, set()), _pf_zip([1, 2, 3, 5], [7, 8, 9, 6]))
result = compute(None)
r_a, r_b, r_c = result
