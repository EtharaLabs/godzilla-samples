import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_remove(x, s):
    return s.difference([x])
def step(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_map_add(k, v, a), _pf_set_remove(k + 1, _pf_set_add(k, b)), _pf_set_add(k, c))
def compute(u):
    return _pf_fold(step, (dict(), set(), set()), [(1, 10), (2, 20), (1, 30), (4, 40)])
result = compute(None)
r_a, r_b, r_c = result
print(_pf_map_to_list(r_a))
print(list(r_b))
print(list(r_c))
