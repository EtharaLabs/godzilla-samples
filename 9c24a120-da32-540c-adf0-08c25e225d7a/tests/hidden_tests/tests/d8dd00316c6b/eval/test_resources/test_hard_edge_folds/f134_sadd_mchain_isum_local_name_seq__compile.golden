import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
def compute(u):
    def step(_pf_arg0, x):
        a, b, c = _pf_arg0
        return (_pf_set_add(x, a), _pf_map_add(x + 100, x * 3, _pf_map_add(x, x * 3, b)), c + x * 2)
    return _pf_fold(step, (set(), dict(), 0), iter([3, 1, 4, 1, 5]))
result = compute(None)
r_a, r_b, r_c = result
print(list(r_a))
print(_pf_map_to_list(r_b))
print(r_c)
