import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
nums = [2, 7, 1, 8, 2, 8]
def step(_pf_arg0, x):
    a, b = _pf_arg0
    return (_pf_map_add(x + 100, x * 3, _pf_map_add(x, x * 3, a)), _pf_concat(b, [x, x * 3]))
def compute(u):
    return _pf_fold(step, (dict(), []), nums)
result = compute(None)
r_a, r_b = result
print(_pf_map_to_list(r_a))
print(r_b)
