import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_a = [0]
init_b = [1, 1]
def step(_pf_arg0, _pf_arg1):
    a, b, c = _pf_arg0
    k, v = _pf_arg1
    return (_pf_concat(a, [k, v]), _pf_concat(b, b), _pf_map_add(k, v, dict()) if k > 3 else _pf_map_add(k, 0, c))
result = _pf_fold(step, (init_a, init_b, dict()), [(1, 10), (2, 20), (1, 30), (4, 40)])
r_a, r_b, r_c = result
print(r_a)
print(len(r_b))
print(_pf_map_to_list(r_c))
