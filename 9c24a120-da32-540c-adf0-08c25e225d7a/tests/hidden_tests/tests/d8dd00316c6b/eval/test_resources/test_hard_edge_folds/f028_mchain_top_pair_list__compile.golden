def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
init_a = dict([(0, 0)])
def step(a, _pf_arg1):
    k, v = _pf_arg1
    return _pf_map_add(k + 100, v, _pf_map_add(k, v, a))
a = dict(init_a)
for (k, v) in [(1, 10), (2, 20), (1, 30), (4, 40)]:
    _pf_t0 = k + 100
    a[k] = v
    a[_pf_t0] = v
result = a
print(_pf_map_to_list(result))
