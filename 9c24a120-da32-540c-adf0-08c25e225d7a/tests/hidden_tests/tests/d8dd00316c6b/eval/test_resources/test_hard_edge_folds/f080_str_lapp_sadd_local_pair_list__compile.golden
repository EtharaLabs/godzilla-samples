import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_add(x, s):
    return s.union([x])
def _pf_str_concat(a, b):
    return a + b
init_a = ">"
init_b = [0]
pairs = [(5, 50), (6, 60), (5, 70)]
def compute(u):
    def step(_pf_arg0, _pf_arg1):
