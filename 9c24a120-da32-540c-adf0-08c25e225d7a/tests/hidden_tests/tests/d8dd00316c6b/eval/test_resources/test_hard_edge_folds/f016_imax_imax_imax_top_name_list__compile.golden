import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_range(lo, hi):
    return list(range(lo, hi))
init_c = 7
def step(_pf_arg0, x):
    a, b, c = _pf_arg0
    return (x if x > a else a, x if x > b else b, x if x > c else c)
def compute(u):
    return _pf_fold(step, (0, 0, init_c), _pf_range(1, 6))
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(r_b)
print(r_c)
