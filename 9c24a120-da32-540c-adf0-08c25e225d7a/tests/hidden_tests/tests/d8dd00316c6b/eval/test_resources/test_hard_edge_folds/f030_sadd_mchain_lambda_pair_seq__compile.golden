import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
init_b = dict([(0, 0)])
def _pf_fn0(_pf_arg0, _pf_arg1):
    a, b = _pf_arg0
    k, v = _pf_arg1
    return (_pf_set_add(k, a), _pf_map_add(k + 100, v, _pf_map_add(k, v, b)))
result = _pf_fold(_pf_fn0, (set(), init_b), iter([(1, 10), (2, 20), (1, 30), (4, 40)]))
r_a, r_b = result
print(list(r_a))
print(_pf_map_to_list(r_b))
