import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_remove(x, s):
    return s.difference([x])
init_c = dict([(2, 0)])
def compute(u):
    def step(_pf_arg0, _pf_arg1):
        a, b, c = _pf_arg0
        k, v = _pf_arg1
        return (a + k * 2, _pf_set_remove(k, b), _pf_map_add(k, v, c) if k % 2 == 0 else c)
    return _pf_fold(step, (0, set(), init_c), [(1, 10), (2, 20), (1, 30), (4, 40)])
result = compute(None)
r_a, r_b, r_c = result
print(r_a)
print(list(r_b))
print(_pf_map_to_list(r_c))
