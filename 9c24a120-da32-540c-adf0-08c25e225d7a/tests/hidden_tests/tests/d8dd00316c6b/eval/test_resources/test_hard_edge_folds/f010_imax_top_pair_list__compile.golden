import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def step(a, _pf_arg1):
    k, v = _pf_arg1
    if k > a:
        return k
    else:
        return a
def compute(u):
    return _pf_fold(step, 0, _pf_zip([1, 2, 3, 5], [7, 8, 9, 6]))
result = compute(None)
print(result)
