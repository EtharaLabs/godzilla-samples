# ==== geometry.py ====
from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __eq__(self, other):
        return type(other) is Circle and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
    def __eq__(self, other):
        return type(other) is Rect and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
Shape = Circle | Rect
def area(s: Shape) -> float:
    if isinstance(s, Circle):
        r = s._0
        return 3.0 * r * r
    else:
        w = s._0
        h = s._1
        return w * h
def biggest(shapes: list[Shape]) -> float:
    return _pf_fold(lambda acc, s: max(acc, area(s)), 0.0, shapes)

# ==== store.py ====
from dataclasses import dataclass
from typing import Any
from _pyfun_rt import Some, None_, _None_
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
@dataclass(frozen=True, slots=True, order=True)
class Item:
    name: str
    shape: Any
def find(name: str, items: list[Item]) -> Some | None_:
    return _pf_list_find(lambda i: i.name == name, items)

# ==== main.py ====
import geometry
import store
from _pyfun_rt import Some, None_, _None_
def _pf_map(f, xs):
    return list(map(f, xs))
items = [store.Item("disc", geometry.Circle(1.0)), store.Item("tile", geometry.Rect(2.0, 3.0))]
def report(name: str) -> str:
    _pf_t0 = store.find(name, items)
    if isinstance(_pf_t0, Some):
        item = _pf_t0._0
        return f"{item.name}: {geometry.area(item.shape)}"
    else:
        return f"{name}: missing"
print(report("disc"))
print(report("tile"))
print(report("cone"))
print(geometry.biggest(_pf_map(lambda i: i.shape, items)))

