from dataclasses import dataclass
from _pyfun_rt import Some, None_, _None_
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
@dataclass(frozen=True, slots=True, order=True)
class Item:
    name: str
    shape: object
def find(name, items):
    return _pf_list_find(lambda i: i.name == name, items)
