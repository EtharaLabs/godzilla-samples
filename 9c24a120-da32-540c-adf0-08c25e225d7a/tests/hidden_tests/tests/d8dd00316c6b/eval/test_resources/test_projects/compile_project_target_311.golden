# ==== util.py ====
def quote(s):
    return f"<{s}>"

# ==== main.py ====
import util
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
xs = ["a", "b"]
print("joined: {}".format(_pf_str_join(", ", _pf_map(util.quote, xs))))

