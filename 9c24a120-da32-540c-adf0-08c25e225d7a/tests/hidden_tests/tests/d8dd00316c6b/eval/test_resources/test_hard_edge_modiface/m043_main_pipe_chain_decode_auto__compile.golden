# ==== shapes.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
@dataclass(frozen=True, slots=True, order=True)
class Placed:
    shape: object
    x: float
    y: float
@dataclass(frozen=True, slots=True, order=True)
class Tag:
    label: str
    n: int
@dataclass(frozen=True, slots=True, repr=False)
class _Big:
    def __repr__(self):
        return "_Big"
@dataclass(frozen=True, slots=True, repr=False)
class _Small:
    def __repr__(self):
        return "_Small"
shout = str.upper
def _ap_Big_Small(s):
    match s:
        case Circle(r):
            if r > 2.0:
                return _Big()
            else:
                return _Small()
        case Rect(w, h):
            if w * h > 4.0:
                return _Big()
            else:
                return _Small()
        case _:
            raise RuntimeError("non-exhaustive match")
def area(s):
    match s:
        case Circle(r):
            return 3.0 * r * r
        case Rect(w, h):
            return w * h
        case _:
            raise RuntimeError("non-exhaustive match")
origin = Placed(Circle(1.0), 0.0, 0.0)
def code(s):
    return s
def unCode(c):
    match c:
        case s:
            return s
Units_width = 3.0
def Units_double(x):
    return x * 2
def tick(n):
    print(f"tick {n}")
    return n + 1

# ==== scene.py ====
from dataclasses import dataclass
import shapes
@dataclass(frozen=True, slots=True, order=True)
class Scene:
    name: str
    item: object
@dataclass(frozen=True, slots=True, order=True)
class Holder:
    tag: object
    shapes: list
@dataclass(frozen=True, slots=True, order=True)
class Item:
    name: str
    n: int
scene = Scene("demo", shapes.Placed(shapes.Circle(2.0), 1.0, 2.0))
holder = Holder(shapes.Tag("t", 2), [shapes.Rect(1.0, 2.0), shapes.Circle(3.0)])
def describe(p):
    match p.shape:
        case shapes.Circle(r):
            return f"circle {r}"
        case shapes.Rect(w, h):
            return f"rect {w}x{h}"
        case _:
            raise RuntimeError("non-exhaustive match")
_pf_t0 = scene.item
moved = shapes.Placed(_pf_t0.shape, 5.0, _pf_t0.y)

# ==== main.py ====
import json
import scene
import shapes
from _pyfun_rt import Ok, Error
from _pyfun_rt import Some, None_, _None_
from _pyfun_rt import _Exception
def _pf_dec_decode_string(dec, s):
    try:
        return Ok(dec(json.loads(s)))
    except Exception as e:
        return Error(_Exception(type(e).__name__, str(e)))
def _pf_dec_auto(d):
    return lambda v: _pf_dec_auto_value(d, v)
def _pf_dec_auto_value(d, v):
    k = d[0]
    if k == "ref":
        return _pf_dec_auto_value(_pf_codecs[d[1]], v)
    if k == "int":
        if isinstance(v, bool) or not isinstance(v, int):
            raise ValueError("expected an int, got " + type(v).__name__)
        return v
    if k == "float":
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            raise ValueError("expected a float, got " + type(v).__name__)
        return float(v)
    if k == "bool":
        if not isinstance(v, bool):
            raise ValueError("expected a bool, got " + type(v).__name__)
        return v
    if k == "str":
        if not isinstance(v, str):
            raise ValueError("expected a string, got " + type(v).__name__)
        return v
    if k == "unit":
        if not v is None:
            raise ValueError("expected null, got " + type(v).__name__)
        return None
    if k == "option":
        if v is None:
            return _None_
        return Some(_pf_dec_auto_value(d[1], v))
    if k == "list" or k == "set":
        if not isinstance(v, list):
            raise ValueError("expected a list, got " + type(v).__name__)
        out = []
        for x in v:
            out.append(_pf_dec_auto_value(d[1], x))
        return out if k == "list" else set(out)
    if k == "tuple":
        if not isinstance(v, list) or len(v) != len(d[1]):
            raise ValueError("expected a list of " + str(len(d[1])) + " items")
        return tuple(map(_pf_dec_auto_value, d[1], v))
    if k == "map":
        out = {}
        if d[1][0] == "str":
            if not isinstance(v, dict):
                raise ValueError("expected an object, got " + type(v).__name__)
            for key in v:
                out[key] = _pf_dec_auto_value(d[2], v[key])
            return out
        if not isinstance(v, list):
            raise ValueError("expected a list of pairs, got " + type(v).__name__)
        for pair in v:
            out[_pf_dec_auto_value(d[1], pair[0])] = _pf_dec_auto_value(d[2], pair[1])
        return out
    if k == "record":
        if not isinstance(v, dict):
            raise ValueError("expected an object, got " + type(v).__name__)
        args = []
        for field in d[2]:
            args.append(_pf_dec_auto_value(field[1], v[field[0]]))
        return d[1](*args)
    if k == "adt":
        if not isinstance(v, dict):
            raise ValueError("expected an object, got " + type(v).__name__)
        tag = v["type"]
        if not tag in d[1]:
            raise ValueError("unknown case " + str(tag))
        ctor, descs = d[1][tag]
        fields = v.get("fields", [])
        if len(fields) != len(descs):
            raise ValueError("case " + tag + (" takes " + (str(len(descs)) + " fields")))
        if not descs:
            return ctor
        return ctor(*map(_pf_dec_auto_value, descs, fields))
    raise ValueError("unknown codec " + str(k))
_pf_codecs = {"Tag": ("record", shapes.Tag, [("label", ("str",)), ("n", ("int",))])}
print(scene.describe(scene.scene.item))
def s1dec(s):
    _pf_t0 = _pf_dec_decode_string(_pf_dec_auto(("ref", "Tag")), s)
    if isinstance(_pf_t0, Ok):
        t = _pf_t0._0
        return shapes.unCode(shapes.code(t.label))
    else:
        return "bad"
s1probe = scene.holder.tag == shapes.Tag("t", 2)
print(s1probe)

