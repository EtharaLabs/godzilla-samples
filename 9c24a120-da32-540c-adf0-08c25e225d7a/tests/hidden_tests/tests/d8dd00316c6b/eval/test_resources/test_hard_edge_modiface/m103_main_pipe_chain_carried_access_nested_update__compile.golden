# ==== shapes.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
@dataclass(frozen=True, slots=True, order=True)
class Placed:
    shape: object
    x: float
    y: float
@dataclass(frozen=True, slots=True, order=True)
class Tag:
    label: str
    n: int
@dataclass(frozen=True, slots=True, repr=False)
class _Big:
    def __repr__(self):
        return "_Big"
@dataclass(frozen=True, slots=True, repr=False)
class _Small:
    def __repr__(self):
        return "_Small"
shout = str.upper
def _ap_Big_Small(s):
    match s:
        case Circle(r):
            if r > 2.0:
                return _Big()
            else:
                return _Small()
        case Rect(w, h):
            if w * h > 4.0:
                return _Big()
            else:
                return _Small()
        case _:
            raise RuntimeError("non-exhaustive match")
def area(s):
    match s:
        case Circle(r):
            return 3.0 * r * r
        case Rect(w, h):
            return w * h
        case _:
            raise RuntimeError("non-exhaustive match")
origin = Placed(Circle(1.0), 0.0, 0.0)
def code(s):
    return s
def unCode(c):
    match c:
        case s:
            return s
Units_width = 3.0
def Units_double(x):
    return x * 2
def tick(n):
    print(f"tick {n}")
    return n + 1

# ==== scene.py ====
from dataclasses import dataclass
import shapes
@dataclass(frozen=True, slots=True, order=True)
class Scene:
    name: str
    item: object
@dataclass(frozen=True, slots=True, order=True)
class Holder:
    tag: object
    shapes: list
@dataclass(frozen=True, slots=True, order=True)
class Item:
    name: str
    n: int
scene = Scene("demo", shapes.Placed(shapes.Circle(2.0), 1.0, 2.0))
holder = Holder(shapes.Tag("t", 2), [shapes.Rect(1.0, 2.0), shapes.Circle(3.0)])
def describe(p):
    match p.shape:
        case shapes.Circle(r):
            return f"circle {r}"
        case shapes.Rect(w, h):
            return f"rect {w}x{h}"
        case _:
            raise RuntimeError("non-exhaustive match")
_pf_t0 = scene.item
moved = shapes.Placed(_pf_t0.shape, 5.0, _pf_t0.y)

