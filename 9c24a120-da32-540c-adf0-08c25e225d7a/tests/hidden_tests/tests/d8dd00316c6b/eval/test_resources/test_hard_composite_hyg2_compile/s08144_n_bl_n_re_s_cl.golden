import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def lift(n):
    return n + 60
def useHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 8
    tmp = useHelper(lift)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [8]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + useHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
gamma = _pf_fn2()
print((first, second, gamma, useHelper(0)))
def stack2(start):
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    def g1(y):
        return x * y
    x = x + 11
    g2 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 6
    return (g0([1, 2]), g1(5), g2([1, 2]), x)
print(stack2(1))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 1
        return n
    return next_
tick = ticker(9)
print((tick(None), tick(None), tick(None)))
def scanSum(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([-9, 4, -1, -3, 0, -5, 3]))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([2, 13, 4, 13, 5]))
