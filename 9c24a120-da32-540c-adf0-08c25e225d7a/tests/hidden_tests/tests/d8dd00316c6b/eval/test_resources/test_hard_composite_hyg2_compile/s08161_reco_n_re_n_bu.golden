from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
book = [Parcel(100, "ray", 108, True, Site("Lima", 1)), Parcel(101, "hal", 11, True, Site("Bern", 2)), Parcel(102, "ray", 257, True, Site("Baku", 2)), Parcel(103, "hal", 245, False, Site("Oslo", 1)), Parcel(104, "hal", 164, True, Site("Bern", 1))]
def bucket(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 196:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 196:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, book))
print(_pf_count_by(bucket, book))
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Parcel(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
rerouted = _pf_map(_pf_fn0, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
def line(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(line, book)))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn1, (0, 0), book)
print(f"{cnt} records, {sumAmt} total")
def surcharge(pct, o):
    extra = o.amount * pct // 100
    _pf_t4 = o
    return Parcel(_pf_t4.id, _pf_t4.owner, o.amount + extra, False, _pf_t4.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 8), book)))
def build(start):
    x = start
    def g0(y):
        return x * y
    x = x * 2
    g1 = lambda y: x + y
    x = x * 2
    def g2(y):
        return x * y
    x = g2(x)
    g3 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 6
    return (g0(3), g1(1), g2(4), g3([1, 2]), x)
print(build(5))
reversed_ = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
list_ = [3, 1, 4]
print((list(map(lambda x: x + 1, iter(list_))), list_))
len_ = 5
print((len([1, 2, 3]) + len_, len("abc")))
def set_(n):
    return n * 3
print((set_(3), len(set([5, 3, 4, 3]))))
