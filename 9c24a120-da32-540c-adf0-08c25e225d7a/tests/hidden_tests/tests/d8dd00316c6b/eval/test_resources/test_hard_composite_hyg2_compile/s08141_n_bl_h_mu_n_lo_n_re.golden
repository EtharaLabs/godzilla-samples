import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def lift(n):
    return n + 33
def useHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 6
    tmp = useHelper(lift)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [4]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + useHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
third = _pf_fn2()
print((alpha, second, third, useHelper(0)))
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(audit([6, 11, 8, 34, 36]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "ray", "stop"])
print((events, counts))
acc = []
for k in [2, 7, 4]:
    _pf_t1 = lambda y: y * k
    acc.append(_pf_t1)
chain = acc
print(_pf_map(lambda h: h(3), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(offsets(7, [9, 4, 7]))
def stack2(start):
    level = start
    def g0(y):
        return level * y
    level = level * 5
    g1 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 4
    def g2(y):
        return level * y
    level = g2(level)
    return (g0(4), g1([1, 2]), g2(4), level)
print(stack2(1))
