from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: str
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
def build(start):
    level = start
    def g0(y):
        return level * y
    level = g0(level)
    g1 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 2
    return (g0(3), g1([1, 2]), level)
print(build(8))
list_ = [3, 3, 8]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([3, 1, 3, 9]), _pf_sort([3, 1, 2])))
def sum_(a, b):
    return a - b
print((sum_(13, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
len_ = 6
print((len([1, 2, 3]) + len_, len("abc")))
def _pf_fn0():
    for (name, k) in [("a", 4), ("b", 2)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(2), list(handlers)))
acc = []
for k in [9, 1, 4]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(5), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def explain(t):
    match t:
        case Rest(s0):
            return f"rest({s0})"
        case Mark(n0) if n0 % 2 == 0:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Skip(1):
            return "skip-1"
        case Skip(n0):
            return f"skip({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Rest(_):
            return 8
        case _:
            return 0
queue = [Skip(5), Skip(-3), Rest("hal"), Rest("ned"), Rest("tom"), Mark(-3), Rest("pam")]
print(_pf_str_join("; ", _pf_map(explain, queue)))
tally = _pf_sum_by(weight, queue)
print(f"tally={tally}")
print((_pf_head(queue), _pf_last(queue)))
