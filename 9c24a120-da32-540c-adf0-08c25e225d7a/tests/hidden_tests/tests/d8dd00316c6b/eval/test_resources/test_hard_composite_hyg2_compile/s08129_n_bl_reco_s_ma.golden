from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
def lift(n):
    return n + 73
def useHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 4
    tmp = useHelper(lift)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + useHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third = _pf_fn2()
print((first, second, third, useHelper(0)))
book = [Ticket(100, "tom", 68, False), Ticket(101, "eli", 26, False), Ticket(102, "tom", 121, False), Ticket(103, "eli", 68, True), Ticket(104, "hal", 120, False), Ticket(105, "hal", 131, True)]
def _pf_fn3(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn3, _pf_group_by(lambda o: o.owner, book))
print(byOwner)
cheap, dear = _pf_partition(lambda o: o.amount < 100, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def bump2(pct, o):
    extra = o.amount * pct // 100
    _pf_t1 = o
    return Ticket(_pf_t1.id, _pf_t1.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(bump2, 6), book)))
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t2 = _pf_last(xs)
        if isinstance(_pf_t2, Some):
            _x = _pf_t2._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t2, Some):
            y = _pf_t2._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([1, 8]), probe2([3, 9]), probe2([])))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((6, 2)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 2)))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 8
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(settle, [8, 30, 29, 1]))
