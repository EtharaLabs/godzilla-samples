from dataclasses import dataclass
from functools import total_ordering
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_concat(a, b):
    return a + b
def _pf_str_rev(s):
    return "".join(reversed(s))
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Emit = Emit()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
def scanSum(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(scanSum([1, -7, 0, -7, -4, 8, 0]))
def ticker(start):
    n = start
    def next_(u):
        nonlocal n
        n = n + 1
        return n
    return next_
tick = ticker(7)
print((tick(None), tick(None), tick(None)))
str_ = "dee"
print((str(15), str_, _pf_str_concat(str_, str(1))))
reversed_ = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
len_ = 6
print((len([1, 2, 3]) + len_, len("abc")))
def build(start):
    base = start
    def g0(y):
        return base * y
    base = g0(base)
    g1 = lambda y: base + y
    base = base + 17
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 9
    def g3(y):
        return base * y
    base = base + 7
    return (g0(4), g1(2), g2([1, 2]), g3(5), base)
print(build(7))
def explain(t):
    match t:
        case Skip(n0):
            return f"skip({n0})"
        case Emit():
            return f"emit"
        case Push(n0):
            return f"push({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Emit():
            return 4
        case Push(x0):
            return x0
        case _:
            return 1
stream = [_Emit, Skip(8), Push(10), Push(-3), Push(5)]
print(_pf_map(explain, stream))
tally = _pf_sum_by(score, stream)
print(f"tally={tally}")
print(_pf_sort(stream))
