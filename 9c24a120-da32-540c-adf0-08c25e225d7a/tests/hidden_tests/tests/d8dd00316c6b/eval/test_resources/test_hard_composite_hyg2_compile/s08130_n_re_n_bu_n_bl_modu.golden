import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_str_concat(a, b):
    return a + b
def build(start):
    base = start
    g0 = lambda y: base + y
    base = g0(base)
    def g1(y):
        return base * y
    base = base + 4
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 5
    g3 = lambda y: base + y
    base = base * 2
    return (g0(2), g1(4), g2([1, 2]), g3(5), base)
print(build(2))
str_ = "sue"
print((str(88), str_, _pf_str_concat(str_, str(1))))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([1, 6, 9, 4]), _pf_sort([3, 1, 2])))
len_ = 8
print((len([1, 2, 3]) + len_, len("abc")))
def lift(n):
    return n + 81
def useHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 6
    tmp = useHelper(lift)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + useHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third = _pf_fn2()
print((first, second, third, useHelper(0)))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
obs = [-13, 21, -5, -10, -14, 16]
print(Geo_mean(obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 19), obs))
print(Geo_scaleAll(4, obs))
print(_pf_filter(functools.partial(Geo_between, 4, 25), obs))
