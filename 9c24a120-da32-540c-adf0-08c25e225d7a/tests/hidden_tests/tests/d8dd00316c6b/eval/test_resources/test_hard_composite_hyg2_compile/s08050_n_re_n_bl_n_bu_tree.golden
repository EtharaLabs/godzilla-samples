def build(start):
    base = start
    def g0(y):
        return base * y
    base = g0(base)
    def g1(y):
        return base * y
    base = base + 13
    def g2(y):
        return base * y
    base = base + 3
    def g3(y):
        return base * y
    base = g3(base)
    return (g0(4), g1(1), g2(2), g3(4), base)
