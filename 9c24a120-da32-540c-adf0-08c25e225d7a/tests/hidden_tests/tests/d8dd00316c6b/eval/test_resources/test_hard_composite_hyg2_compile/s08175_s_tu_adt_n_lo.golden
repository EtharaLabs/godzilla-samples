def describe(t):
    match t:
        case Drop(n0):
            return f"drop({n0})"
        case Push(s0, n1):
            return f"push({s0},{n1})"
        case Emit(s0):
            return f"emit({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Push(_, x1):
            return x1
        case Drop(x0):
            return x0
        case _:
            return 1
