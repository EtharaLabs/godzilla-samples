import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def net(price, qty):
    return price * qty - 5 * qty
def emit(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("pin", 44, 2), ("cog", 12, 4), ("hub", 33, 3)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(6)([1, 2, 3]))
def build(start):
    level = start
    g0 = lambda y: level + y
    level = g0(level)
    def g1(y):
        return level * y
    level = g1(level)
    g2 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 8
    g3 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 2
    return (g0(3), g1(5), g2([1, 2]), g3([1, 2]), level)
print(build(5))
str_ = "gus"
print((str(95), str_, _pf_str_concat(str_, str(1))))
len_ = 8
print((len([1, 2, 3]) + len_, len("abc")))
def set_(n):
    return n * 2
print((set_(3), len(set([0, 4, 5, 2]))))
stock = [("wick", 7), ("hub", 20), ("bolt", 11), ("pin", 0)]
spans = [("jo", (5, 17)), ("cy", (5, 11)), ("oz", (0, 11))]
def _pf_fn1():
    for (name, (lo, hi)) in spans:
        for (i, x) in _pf_indexed(_pf_range(lo, lo + 2)):
            yield f"{name}{i}:{hi - x}"
spansOut = _pf_fn1()
print(list(spansOut))
def _pf_fn2(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds = _pf_fold(_pf_fn2, (1000, -1000), stock)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(stock, stock):
    _pf_t0 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t0
byName = acc
print(_pf_map_to_list(byName))
def _pf_fn3(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn3, _pf_indexed(stock))
def _pf_fn4():
    for (name, qty) in stock:
        doubled = qty * 2
        yield f"{name}={doubled}"
lines2 = _pf_fn4()
