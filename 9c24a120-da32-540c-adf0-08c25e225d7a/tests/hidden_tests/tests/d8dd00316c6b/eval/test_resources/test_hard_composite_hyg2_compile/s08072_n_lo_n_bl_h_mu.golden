import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
acc = []
for k in [5, 1, 2]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(1), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(offsets(9, [5, 8, 6]))
def lift(n):
    return n + 30
def useHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 6
    tmp = useHelper(lift)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t1 = [2]
    if _pf_t1:
        lift = _pf_t1[0]
        return lift + useHelper(1)
    else:
        return 0
beta = _pf_fn1()
def _pf_fn2():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
third = _pf_fn2()
print((alpha, beta, third, useHelper(0)))
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(4, 0)
print(audit([33, 23, 28]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "ray", "stop"])
print((logged, counts))
