from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 3
    return _pf_map(lambda g: g(n), fs)
print(offsets(4, [0, 5, 4]))
def _pf_fn0():
    for (name, k) in [("a", 8), ("b", 3)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(2), list(callbacks2)))
acc = []
for k in [6, 8, 2]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(3), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def bump2(n):
    return n + 82
def callHelper(x):
    return bump2(x)
def _pf_fn1():
    bump2 = 3
    tmp = callHelper(bump2)
    return tmp * 2
alpha = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [8]
    if _pf_t1:
        bump2 = _pf_t1[0]
        return bump2 + callHelper(1)
    else:
        return 0
second = _pf_fn2()
def _pf_fn3():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma = _pf_fn3()
print((alpha, second, gamma, callHelper(0)))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(4, []), weigh(1, [9]), weigh(1, [9, 2, 3])))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((7, 7)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 6)))
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t2 = _pf_last(xs)
        if isinstance(_pf_t2, Some):
            _x = _pf_t2._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t2, Some):
            y = _pf_t2._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([4, 3]), probe2([5, 9]), probe2([])))
