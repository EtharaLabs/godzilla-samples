import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_fst(p):
    return p[0]
def _pf_fn0():
    for (name, k) in [("a", 7), ("b", 4)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(2), list(callbacks2)))
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 7
    return _pf_map(lambda g: g(n), fs)
print(shifted(6, [9, 8, 8]))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([8, 6, 0, 1]), _pf_sort([3, 1, 2])))
reversed_ = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def stack2(start):
    level = start
    g0 = lambda y: level + y
    level = level + 20
    g1 = lambda y: level + y
    level = level + 17
    g2 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 8
    return (g0(4), g1(4), g2([1, 2]), level)
print(stack2(3))
seriesA = [-3, 15, 28, 13, 22]
factor = 5
scalers = _pf_map(lambda s: lambda x: x * s + factor, [1, 2, 3])
print(_pf_map(lambda g: g(3), scalers))
tweak2 = lambda _pf_x: (lambda z: z - 4)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(tweak2, seriesA))
def _pf_fn1(_pf_arg0):
    i, x = _pf_arg0
    return (x % factor, -i)
print(_pf_map(_pf_fst, _pf_sort_by(_pf_fn1, _pf_indexed(seriesA))))
def _pf_fn2(_pf_arg0, x):
    s, n = _pf_arg0
    if x > 0:
        return (s + x, n + 1)
    else:
        return (s, n)
print(_pf_fold(_pf_fn2, (0, 0), seriesA))
def _pf_fn3(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn3, _pf_zip(seriesA, _pf_map(lambda x: x * x, seriesA)))))
