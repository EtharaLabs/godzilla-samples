import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def Calc_square(x):
    return x * x
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
pts = [8, -3, 21, 20, -2, -9, -3]
print(_pf_map(Calc_square, pts))
print(Calc_norm1(pts))
print(Calc_scaleAll(4, pts))
def bump2(n):
    return n + 15
def useHelper(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 0
    tmp = useHelper(bump2)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [5]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + useHelper(1)
    else:
        return 0
beta = _pf_fn1()
def _pf_fn2():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
third = _pf_fn2()
print((first, beta, third, useHelper(0)))
acc = []
for k in [8, 6, 8]:
    _pf_t1 = lambda y: y * k
    acc.append(_pf_t1)
chain = acc
print(_pf_map(lambda h: h(5), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def _pf_fn3():
    for (name, k) in [("a", 2), ("b", 6)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn3()
print(_pf_map(lambda h: h(2), list(handlers)))
def build(start):
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 6
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 4
    return (g0([1, 2]), g1([1, 2]), x)
print(build(4))
