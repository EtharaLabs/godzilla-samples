import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_square(x):
    return x * x
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums = [13, -4, -12, 18, -13]
print(_pf_map(functools.partial(Stats_clamp, 0, 5), nums))
print(_pf_map(Stats_square, nums))
print(Stats_norm1(nums))
print(Stats_mean(nums))
def nudge(n):
    return n + 68
def callHelper(x):
    return nudge(x)
def _pf_fn0():
    nudge = 6
    tmp = callHelper(nudge)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [2]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + callHelper(1)
    else:
        return 0
beta = _pf_fn1()
def _pf_fn2():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
gamma = _pf_fn2()
print((first, beta, gamma, callHelper(0)))
legs = [79.2, 131.8, 472.0]
splits = [59.2, 33.0, 20.8]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = dist / elapsed
print(_pf_fmt_fixed(1, rate))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
edge = math.sqrt(25.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
speeds = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def sum_(a, b):
    return a - b
print((sum_(17, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
list_ = [6, 9, 9]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([0, 0, 1, 5]), _pf_sort([3, 1, 2])))
dict_ = dict([("k", 7)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
