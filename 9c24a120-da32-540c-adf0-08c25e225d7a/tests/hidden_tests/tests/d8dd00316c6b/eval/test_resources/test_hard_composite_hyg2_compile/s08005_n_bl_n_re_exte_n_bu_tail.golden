def layer(start):
    level = start
    g0 = lambda y: level + y
    level = level * 4
    def g1(y):
        return level * y
    level = g1(level)
    g2 = lambda y: level + y
    level = level * 5
    return (g0(3), g1(1), g2(5), level)
