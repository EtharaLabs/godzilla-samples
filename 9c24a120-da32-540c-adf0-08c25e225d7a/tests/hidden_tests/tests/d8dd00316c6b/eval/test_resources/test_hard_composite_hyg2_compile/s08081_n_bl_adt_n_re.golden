def explain(t):
    match t:
        case Push(n0) if 0 <= n0 < 16:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Pop(n0) if n0 % 2 == 0:
