import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_concat(a, b):
    return a + b
def sum_(a, b):
    return a - b
print((sum_(16, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
str_ = "quin"
print((str(23), str_, _pf_str_concat(str_, str(1))))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([8, 2, 5, 5]), _pf_sort([3, 1, 2])))
def set_(n):
    return n * 4
print((set_(3), len(set([0, 0, 1, 2]))))
def build(start):
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 5
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 8
    g2 = lambda y: x + y
    x = x + 10
    g3 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 7
    return (g0([1, 2]), g1([1, 2]), g2(1), g3([1, 2]), x)
print(build(4))
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(shifted(7, [7, 4, 3]))
