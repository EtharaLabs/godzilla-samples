import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_concat(a, b):
    return a + b
def bump2(n):
    return n + 42
def callHelper(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 8
    tmp = callHelper(bump2)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
gamma = _pf_fn2()
print((first, second, gamma, callHelper(0)))
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(929, 0))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [24, 1, 24, 22, 26]))
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(51261))
def Text_square(x):
    return x * x
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [20, 12, -11, 5, -5, 5]
print(_pf_map(Text_square, obs))
print(_pf_map(functools.partial(Text_clamp, 0, 20), obs))
print(Text_norm1(obs))
print(Text_mean(obs))
