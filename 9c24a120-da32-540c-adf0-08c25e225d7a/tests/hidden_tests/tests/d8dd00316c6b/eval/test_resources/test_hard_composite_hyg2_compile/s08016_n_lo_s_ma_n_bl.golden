from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Wedge:
    _0: int
    _1: int
    def __repr__(self):
        return f"Wedge({self._0!r}, {self._1!r})"
def _pf_fn0():
    for (name, k) in [("a", 6), ("b", 3)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(4), list(handlers)))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 4
    return _pf_map(lambda g: g(n), fs)
print(offsets(9, [9, 1, 5]))
acc = []
for k in [8, 8, 2]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(3), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
limit2 = 12
def bound(o):
    if isinstance(o, Some):
        _limit2 = o._0
        if _limit2 > 0:
            return _limit2
    if isinstance(o, Some):
        return 0
    else:
        return limit2
print((bound(Some(2)), bound(Some(-3)), bound(_None_), limit2))
def dig(xs):
    if xs:
        x = xs[0]
        _pf_t1 = _pf_last(xs)
        if isinstance(_pf_t1, Some):
            _x = _pf_t1._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t1, Some):
            y = _pf_t1._0
            return x + y
        else:
            return x
    else:
        return -1
print((dig([2, 9]), dig([6, 9]), dig([])))
def weigh(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((weigh(9, []), weigh(1, [8]), weigh(1, [3, 2, 3])))
def extent(s):
    match s:
        case Sq(n) | Ci(n):
            return n
        case Wedge(n, m) if n > m:
            return n
        case Wedge(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(extent, [Sq(5), Ci(2), Wedge(2, 6), Wedge(1, 9)]))
def bump2(n):
    return n + 70
def useHelper(x):
    return bump2(x)
def _pf_fn1():
    bump2 = 5
    tmp = useHelper(bump2)
    return tmp * 2
alpha = _pf_fn1()
def _pf_fn2():
    _pf_t2 = [2]
