        bump2 = _pf_t2[0]
        return bump2 + useHelper(1)
    else:
        return 0
second = _pf_fn2()
def _pf_fn3():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma = _pf_fn3()
print((alpha, second, gamma, useHelper(0)))
