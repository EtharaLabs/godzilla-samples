from dataclasses import dataclass
import functools
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([39, -6, 17, 29]))
doubled = _pf_map(track, [39, -6, 17, 29])
print(f"{doubled} after {ticks} calls")
env = dict([("x", 7), ("y", 0)])
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def show(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({show(a)} + {show(b)})"
        case Mul(a, b):
            return f"{show(a)} * {show(b)}"
        case Neg(a):
            return f"-{show(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Neg(Neg(Neg(Num(-2)))), Mul(Mul(Add(Num(8), Var("y")), Add(Num(8), Num(9))), Add(Num(0), Num(9))), Num(5)]
_pf_iter(print, _pf_map(show, exprs))
print(_pf_map(evaluate, exprs))
len_ = 6
print((len([1, 2, 3]) + len_, len("abc")))
reversed_ = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([3, 7, 4, 6]), _pf_sort([3, 1, 2])))
def layer(start):
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 2
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 5
    return (g0([1, 2]), g1([1, 2]), x)
print(layer(7))
