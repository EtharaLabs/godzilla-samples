    nudge = 0
    tmp = callHelper(nudge)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t1 = [4]
    if _pf_t1:
        nudge = _pf_t1[0]
        return nudge + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma = _pf_fn2()
print((alpha, second, gamma, callHelper(0)))
