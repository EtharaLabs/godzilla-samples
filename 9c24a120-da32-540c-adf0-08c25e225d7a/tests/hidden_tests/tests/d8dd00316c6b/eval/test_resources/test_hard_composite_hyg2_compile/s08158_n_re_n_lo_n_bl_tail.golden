import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def layer(start):
    x = start
    def g0(y):
        return x * y
    x = x * 3
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    return (g0(4), g1([1, 2]), x)
print(layer(4))
def _pf_fn0():
    for (name, k) in [("a", 6), ("b", 5)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(5), list(handlers)))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(offsets(9, [1, 2, 6]))
acc = []
for k in [2, 1, 3]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(4), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def nudge(n):
    return n + 37
def useHelper(x):
    return nudge(x)
def _pf_fn1():
    nudge = 6
    tmp = useHelper(nudge)
    return tmp * 2
first = _pf_fn1()
def _pf_fn2():
    _pf_t1 = [7]
    if _pf_t1:
        nudge = _pf_t1[0]
        return nudge + useHelper(1)
    else:
        return 0
beta = _pf_fn2()
def _pf_fn3():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
gamma = _pf_fn3()
print((first, beta, gamma, useHelper(0)))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(476, 47))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(7, 17, 1))
