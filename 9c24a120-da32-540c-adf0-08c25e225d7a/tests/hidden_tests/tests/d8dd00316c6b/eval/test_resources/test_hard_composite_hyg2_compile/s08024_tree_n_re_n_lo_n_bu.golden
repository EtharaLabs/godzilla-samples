    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
vars = dict([("x", 2), ("y", -1)])
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case Var(v):
            return _pf_map_find_or(v, 0, vars)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Add(Neg(Neg(Num(7))), Add(Num(-1), Add(Var("y"), Num(7)))), Mul(Num(4), Neg(Mul(Num(3), Num(-1)))), Num(5)]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evalE, exprs))
def build(start):
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 4
    def g1(y):
        return x * y
    x = g1(x)
    def g2(y):
        return x * y
    x = x * 2
    g3 = lambda y: x + y
    x = x + 4
    return (g0([1, 2]), g1(4), g2(1), g3(3), x)
print(build(5))
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
