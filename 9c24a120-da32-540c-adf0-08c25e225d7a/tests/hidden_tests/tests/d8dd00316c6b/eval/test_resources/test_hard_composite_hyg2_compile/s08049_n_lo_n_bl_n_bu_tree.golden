def insert(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(insert(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, insert(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [54, 19, 29, 28, 2])
def minT(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minT(root))
def sumOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumOf(l) + v + sumOf(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
