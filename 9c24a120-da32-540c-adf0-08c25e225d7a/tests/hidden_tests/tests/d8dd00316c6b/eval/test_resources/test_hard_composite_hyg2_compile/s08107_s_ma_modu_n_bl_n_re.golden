from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 5
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(4, []), score(1, [8]), score(1, [3, 2, 3])))
def choose2(o, fallback):
    if isinstance(o, Some):
        _fallback, n = o._0
        if _fallback > n:
            return _fallback
    if isinstance(o, Some):
        a, _fallback2 = o._0
        return a + _fallback2
    else:
        return fallback
print((choose2(Some((5, 8)), 0), choose2(Some((1, 5)), 0), choose2(_None_, 1)))
def probe2(xs):
    if xs:
        x = xs[0]
        _pf_t0 = _pf_last(xs)
        if isinstance(_pf_t0, Some):
            _x = _pf_t0._0
            if _x > 5:
                return _x * 10
        if isinstance(_pf_t0, Some):
            y = _pf_t0._0
            return x + y
        else:
            return x
    else:
        return -1
print((probe2([6, 9]), probe2([8, 9]), probe2([])))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
obs = [27, 5, 5, 1, 25]
print(Calc_scaleAll(5, obs))
print(Calc_norm1(obs))
print(_pf_filter(functools.partial(Calc_between, -1, 17), obs))
def bump2(n):
    return n + 25
def callHelper(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 7
    tmp = callHelper(bump2)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t1 = [5]
    if _pf_t1:
        bump2 = _pf_t1[0]
        return bump2 + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma = _pf_fn2()
print((alpha, second, gamma, callHelper(0)))
def build(start):
    level = start
    g0 = lambda y: level + y
    level = level + 4
    def g1(y):
        return level * y
    level = level * 5
    def g2(y):
        return level * y
    level = g2(level)
    return (g0(2), g1(1), g2(2), level)
print(build(2))
