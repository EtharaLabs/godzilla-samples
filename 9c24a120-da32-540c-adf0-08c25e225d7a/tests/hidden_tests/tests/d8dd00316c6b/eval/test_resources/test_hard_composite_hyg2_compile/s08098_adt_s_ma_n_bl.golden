from dataclasses import dataclass
from functools import total_ordering
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    def __repr__(self):
        return "Mark"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Mark = Mark()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Sq:
    _0: int
    def __repr__(self):
        return f"Sq({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Ci:
    _0: int
    def __repr__(self):
        return f"Ci({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tri:
    _0: int
    _1: int
    def __repr__(self):
        return f"Tri({self._0!r}, {self._1!r})"
def explain(t):
    match t:
        case Turn(n0) if n0 > 5:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Mark():
            return f"mark"
        case Pop(n0):
            return f"pop({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Pop(x0):
            return x0 * 4
        case _:
            return 3
stream = [_Mark, _Mark, _Mark, Turn(1), _Mark, _Mark]
_pf_iter(lambda t: print(explain(t)), stream)
total = _pf_sum_by(cost, stream)
print(f"total={total}")
print(_pf_sort(stream))
def settle(n):
    match n % 3:
        case 0:
            _n = n // 3
            return _n + 7
        case k:
            _n2 = n * k
            _k = _n2 - 1
            return _k
print(_pf_map(settle, [24, 10, 11, 24]))
def size(s):
    match s:
        case Sq(n) | Ci(n):
            return n
        case Tri(n, m) if n > m:
            return n
        case Tri(m, n):
            return n
        case _:
            raise RuntimeError("non-exhaustive match")
print(_pf_map(size, [Sq(2), Ci(6), Tri(4, 8), Tri(1, 9)]))
def score(x, items):
    match items:
        case []:
            return x
        case [_x]:
            return _x * 3
        case [_x2, *rest]:
            return _x2 + len(rest)
        case _:
            raise RuntimeError("non-exhaustive match")
print((score(3, []), score(1, [2]), score(1, [1, 2, 3])))
