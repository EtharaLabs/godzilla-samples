import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def nudge(n):
    return n + 63
def useHelper(x):
    return nudge(x)
def _pf_fn0():
    nudge = 7
    tmp = useHelper(nudge)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [3]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + useHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
gamma = _pf_fn2()
print((alpha, second, gamma, useHelper(0)))
laps = [391.9, 25.5, 342.6, 459.3, 53.5]
times = [50.7, 23.6, 89.6, 71.3, 61.7]
dist = _pf_fold(lambda a, b: a + b, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = dist / dur
print(_pf_fmt_fixed(1, rate))
speeds = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def layer(start):
    base = start
    def g0(y):
        return base * y
    base = base * 4
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 1
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 9
    g3 = lambda y: base + y
    base = base + 16
    return (g0(3), g1([1, 2]), g2([1, 2]), g3(3), base)
print(layer(8))
