from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
def build(start):
    base = start
    g0 = lambda y: base + y
    base = base * 4
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 6
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 8
    return (g0(2), g1([1, 2]), g2([1, 2]), base)
print(build(7))
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(lambda acc, x: add(x, acc), _Leaf, [42, 56, 13, 11, 10, 37, 46, 7])
def containsT(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsT(k, root), [42, 8, 13]))
def minT(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minT(root))
def sumT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumT(l) + v + sumT(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumT(root))
def _pf_fn0():
    for (name, k) in [("a", 7), ("b", 3)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(5), list(handlers)))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(offsets(6, [2, 2, 6]))
