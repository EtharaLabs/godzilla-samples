from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
_Load = Load()
def render(t):
    match t:
        case Drop(n0):
            return f"drop({n0})"
        case Skip(s0):
            return f"skip({s0})"
        case Load():
            return f"load"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Drop(x0):
            return x0 * 5
        case _:
            return 1
queue = [_Load, _Load, _Load, Drop(-1), _Load]
print(_pf_map(render, queue))
tally = _pf_sum_by(weight, queue)
print(f"tally={tally}")
print(_pf_max_by(weight, queue))
def build(start):
    x = start
    g0 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    def g1(y):
        return x * y
    x = x + 8
    g2 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 1
    g3 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 3
    return (g0([1, 2]), g1(3), g2([1, 2]), g3([1, 2]), x)
print(build(2))
