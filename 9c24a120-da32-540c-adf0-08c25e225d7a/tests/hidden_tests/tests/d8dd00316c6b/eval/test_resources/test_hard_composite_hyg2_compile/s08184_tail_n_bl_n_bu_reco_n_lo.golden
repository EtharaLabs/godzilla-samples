from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [9, 12, 27, 12, 26]))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [20, 34, 52]))
def bump2(n):
    return n + 67
def callHelper(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 6
    tmp = callHelper(bump2)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [3]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third = _pf_fn2()
print((first, second, third, callHelper(0)))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([8, 0, 8, 7]), _pf_sort([3, 1, 2])))
def set_(n):
    return n * 2
print((set_(3), len(set([4, 0, 5, 1]))))
orders = [Booking(100, "hal", 134, True), Booking(101, "hal", 261, False), Booking(102, "ivy", 51, True), Booking(103, "eli", 269, False), Booking(104, "ivy", 182, False), Booking(105, "ivy", 172, True)]
def surcharge(pct, o):
    extra = o.amount * pct // 100
    _pf_t1 = o
    return Booking(_pf_t1.id, _pf_t1.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 9), orders)))
def _pf_fn3(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn3, (0, 0), orders)
print(f"{cnt} records, {sumAmt} total")
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by(lambda o: o.amount, orders))))
cheap, dear = _pf_partition(lambda o: o.amount < 154, orders)
print(f"{len(cheap)} cheap, {len(dear)} dear")
