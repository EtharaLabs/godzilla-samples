import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
hits = 0
def note(x):
    global hits
    hits = hits + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([33, 57, 38, 27]))
doubled = _pf_map(note, [33, 57, 38, 27])
print(f"{doubled} after {hits} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), hits))
def lift(n):
    return n + 66
def callHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 3
    tmp = callHelper(lift)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [3]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third = _pf_fn2()
print((first, second, third, callHelper(0)))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 8
    return _pf_map(lambda g: g(n), fs)
print(offsets(8, [2, 8, 4]))
def _pf_fn3():
    for (name, k) in [("a", 2), ("b", 5)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn3()
print(_pf_map(lambda h: h(1), list(handlers)))
acc = []
for k in [5, 9, 6]:
    _pf_t1 = lambda y: y * k
    acc.append(_pf_t1)
chain = acc
print(_pf_map(lambda h: h(1), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
