import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
inputs2 = [-2, 19, 23, 8, 26]
factor = 4
print(_pf_map2(lambda a, b: a * factor - b, _pf_rev(inputs2), inputs2))
shape2 = lambda _pf_x: (lambda z: z - 6)((lambda _pf_x: (lambda y: y * factor)((lambda x: x + 1)(_pf_x)))(_pf_x))
print(_pf_map(shape2, inputs2))
def _pf_fn0(_pf_arg0):
    a, b = _pf_arg0
    return b > a * factor
print(len(_pf_filter(_pf_fn0, _pf_zip(inputs2, _pf_map(lambda x: x * x, inputs2)))))
print(_pf_map(lambda y: y * factor, (lambda ys: _pf_take(len(ys) // 2, ys))(inputs2)))
def _pf_fn1():
    for (name, k) in [("a", 2), ("b", 9)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn1()
print(_pf_map(lambda h: h(1), list(handlers)))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 3
    return _pf_map(lambda g: g(n), fs)
print(offsets(3, [1, 9, 3]))
def stack2(start):
    acc = start
    g0 = lambda y: acc + y
    acc = acc * 4
    g1 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 3
    g2 = lambda y: acc + y
    acc = acc + 12
    def g3(y):
        return acc * y
    acc = g3(acc)
    return (g0(4), g1([1, 2]), g2(2), g3(5), acc)
print(stack2(9))
