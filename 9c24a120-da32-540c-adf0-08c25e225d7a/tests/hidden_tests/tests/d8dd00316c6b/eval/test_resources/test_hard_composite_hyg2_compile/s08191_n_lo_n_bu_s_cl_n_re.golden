import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_rev(s):
    return "".join(reversed(s))
acc = []
for k in [2, 3, 2]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(2), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def _pf_fn0():
    for (name, k) in [("a", 4), ("b", 4)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(4), list(handlers)))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 2
    return _pf_map(lambda g: g(n), fs)
print(offsets(6, [2, 1, 6]))
reversed_ = _pf_rev([1, 2, 3])
print((reversed_, _pf_str_rev("abc")))
str_ = "tom"
print((str(27), str_, _pf_str_concat(str_, str(1))))
dict_ = dict([("k", 6)])
print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
def tally(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(tally([17, 5, 11]))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-6, 9, 9, -3, -8, 1, 6]))
def numbered(xs):
    i = 1
    def tag(x):
        nonlocal i
        i = i + 1
        return f"{i}:{x}"
    tagged = _pf_map(tag, xs)
    return (tagged, i)
print(numbered(["sue", "max", "dee"]))
def build(start):
    acc = start
    g0 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 6
    g1 = lambda y: acc + y
    acc = acc * 4
    return (g0([1, 2]), g1(5), acc)
print(build(9))
