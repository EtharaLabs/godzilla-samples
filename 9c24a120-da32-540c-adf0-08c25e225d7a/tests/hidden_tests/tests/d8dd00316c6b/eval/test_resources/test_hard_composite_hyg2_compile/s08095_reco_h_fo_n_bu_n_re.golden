from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
book = [Booking(100, "gus", 194, True, Site("Rome", 1)), Booking(101, "hal", 74, True, Site("Oslo", 3)), Booking(102, "sue", 220, False, Site("Doha", 3)), Booking(103, "sue", 74, False, Site("Lima", 1))]
def surcharge(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Booking(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 5), book)))
def tag(_pf_arg0):
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, book)))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn0, (0, 0), book)
print(f"{nrec} records, {amt} total")
print(_pf_max_by(lambda o: o.amount, book))
cheap, dear = _pf_partition(lambda o: o.amount < 118, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def execute(script):
    def fold1(acc, op):
        return acc
    def fold1(m, op):
        match op:
            case Put(k, v):
                return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
            case Push(n):
                return _pf_map_add("pushed", n, m)
            case Noop():
                return m
            case _:
                raise RuntimeError("non-exhaustive match")
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t1 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t1
            case Push(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
script = [_Noop, _Noop, Put("gear", 2), Put("nut", 6), _Noop]
final = execute(script)
print(_pf_map_to_list(final))
sumSq = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [3, 4, 7, 1])
print(sumSq)
