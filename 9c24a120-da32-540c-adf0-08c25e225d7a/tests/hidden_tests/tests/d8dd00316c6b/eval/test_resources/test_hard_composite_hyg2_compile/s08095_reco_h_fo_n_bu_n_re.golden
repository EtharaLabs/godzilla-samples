print((_pf_map_find_or("k", 0, dict_), len(_pf_map_add("z", 1, dict()))))
list_ = [4, 2, 4]
print((list(map(lambda x: x + 1, iter(list_))), list_))
def build(start):
    level = start
    g0 = lambda y: level + y
    level = level * 3
    g1 = lambda y: level + y
    level = level + 1
    return (g0(4), g1(1), level)
print(build(9))
