import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def bump2(n):
    return n + 10
def callHelper(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 7
    tmp = callHelper(bump2)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [1]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + callHelper(1)
    else:
        return 0
beta = _pf_fn1()
def _pf_fn2():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
gamma = _pf_fn2()
print((alpha, beta, gamma, callHelper(0)))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([20, 13, 11, 10, 2]))
trail = []
def traced(tag, f, x):
    global trail
    y = f(x)
    trail = _pf_concat(trail, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(traced, "inc", lambda x: x + 1), _pf_map(functools.partial(traced, "sq", lambda x: x * x), [1, 9]))
print((out, trail))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([-2, 1, -7, 1]))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 3
    return _pf_map(lambda g: g(n), fs)
print(offsets(8, [1, 6, 5]))
def _pf_fn3():
    for (name, k) in [("a", 5), ("b", 4)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn3()
print(_pf_map(lambda h: h(2), list(callbacks2)))
acc = []
for k in [1, 9, 8]:
    _pf_t1 = lambda y: y * k
    acc.append(_pf_t1)
steps = acc
print(_pf_map(lambda h: h(4), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
