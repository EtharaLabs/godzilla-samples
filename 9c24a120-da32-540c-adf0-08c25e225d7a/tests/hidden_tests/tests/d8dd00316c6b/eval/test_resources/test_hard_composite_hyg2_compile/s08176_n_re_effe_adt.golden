def stack2(start):
    x = start
    def g0(y):
        return x * y
    x = g0(x)
    g1 = lambda y: x + y
    x = g1(x)
    g2 = lambda y: x + y
    x = g2(x)
    g3 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 2
    return (g0(1), g1(2), g2(1), g3([1, 2]), x)
print(stack2(7))
def margin(price, qty):
    return price * qty - 3 * qty
def report(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("hub", 28, 4), ("wick", 49, 4)]))
print(overall)
def explain(t):
    match t:
        case Load(n0):
            return f"load({n0})"
        case Skip(2):
            return "skip-2"
        case Skip(n0):
            return f"skip({n0})"
        case Rest(s0):
            return f"rest({s0})"
        case Emit():
            return f"emit"
        case Turn(n0) if n0 % 2 == 0:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
