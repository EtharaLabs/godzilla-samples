import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def stack2(start):
    base = start
    g0 = lambda y: base + y
    base = base + 3
    def g1(y):
        return base * y
    base = base * 5
    g2 = lambda y: base + y
    base = base * 5
    return (g0(1), g1(1), g2(5), base)
print(stack2(8))
def census(xs):
    evens = 0
    odds = 0
    def visit(x):
        def bump(isEven):
            nonlocal evens, odds
            if isEven:
                evens = evens + x
                return None
            else:
                odds = odds + 1
                return None
        return bump(x % 2 == 0)
    _pf_iter(visit, xs)
    return (evens, odds)
print(census([20, 17, 15, 13, 4]))
def running(xs):
    peak = 0
    def step(acc, x):
        nonlocal peak
        next_ = acc + x
        peak = max(peak, next_)
        return next_
    final = _pf_fold(step, 0, xs)
    return (final, peak)
print(running([3, -5, -2, 2, 5, 8]))
journal = []
def logged(tag, f, x):
    global journal
    y = f(x)
    journal = _pf_concat(journal, [f"{tag}({x})={y}"])
    return y
out = _pf_map(functools.partial(logged, "inc", lambda x: x + 1), _pf_map(functools.partial(logged, "sq", lambda x: x * x), [2, 4]))
print((out, journal))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 5
    return _pf_map(lambda g: g(n), fs)
print(offsets(3, [5, 2, 6]))
acc = []
for k in [6, 8, 7]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(4), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def _pf_fn0():
    for (name, k) in [("a", 8), ("b", 8)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(3), list(handlers)))
