from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
values = [29, 1, -10, 11, 22, 35, 41, 16]
def shift(k, x):
    return x + k
digest = _pf_head(_pf_filter(lambda x: x % 3 == 0, _pf_take(3, _pf_distinct_by(lambda x: x % 2, _pf_choose(lambda x: (Some(x // 4) if x % 4 == 0 else _None_), values)))))
print(digest)
print(len(values))
def build(start):
    acc = start
    def g0(y):
        return acc * y
    acc = acc * 2
    def g1(y):
        return acc * y
    acc = acc * 3
    return (g0(3), g1(1), acc)
print(build(1))
