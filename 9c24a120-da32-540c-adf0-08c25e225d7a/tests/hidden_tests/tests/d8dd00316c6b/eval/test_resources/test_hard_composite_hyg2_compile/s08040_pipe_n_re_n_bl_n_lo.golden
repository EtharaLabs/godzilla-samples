        bump2 = _pf_t0[0]
        return bump2 + callHelper(1)
    else:
        return 0
beta = _pf_fn1()
def _pf_fn2():
    if alpha > beta:
        _alpha = beta
        return _alpha + 1
    else:
        return alpha
third = _pf_fn2()
print((alpha, beta, third, callHelper(0)))
def offsets(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 7
    return _pf_map(lambda g: g(n), fs)
print(offsets(4, [6, 0, 3]))
