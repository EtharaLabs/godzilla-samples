from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_concat(a, b):
    return a + b
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
acc = []
for k in [9, 9, 3]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(5), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def _pf_fn0():
    for (name, k) in [("a", 6), ("b", 1)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(3), list(callbacks2)))
def apply(xs, op):
    match op:
        case Put(k, v):
            return _pf_concat(xs, [v])
        case Push(n) if n > 0:
            return _pf_concat(xs, [n * 10])
        case _:
            return xs
def execute(script):
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 0:
                _pf_t1 = n * 10
                xs.append(_pf_t1)
            case _:
                pass
    return xs
ops = [Push(-2), _Skip, _Skip, _Skip]
final = execute(ops)
print(final)
def layer(start):
    level = start
    def g0(y):
        return level * y
    level = g0(level)
    g1 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 4
    g2 = lambda y: level + y
    level = g2(level)
    g3 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 1
    return (g0(5), g1([1, 2]), g2(5), g3([1, 2]), level)
print(layer(1))
len_ = 4
print((len([1, 2, 3]) + len_, len("abc")))
str_ = "max"
print((str(59), str_, _pf_str_concat(str_, str(1))))
