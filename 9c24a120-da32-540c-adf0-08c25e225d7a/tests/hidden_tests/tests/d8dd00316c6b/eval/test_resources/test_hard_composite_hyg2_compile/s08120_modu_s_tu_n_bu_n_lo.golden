from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_snd(p):
    return p[1]
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_square(x):
    return x * x
def Calc_between(lo, hi, x):
    return lo <= x <= hi
obs = [15, -10, 13, -15]
print(_pf_map(functools.partial(Calc_clamp, 0, 11), obs))
print(Calc_scaleAll(3, obs))
print(_pf_map(Calc_square, obs))
print(_pf_filter(functools.partial(Calc_between, 0, 16), obs))
tallies = [("rod", 15), ("wick", -1), ("gear", 11)]
def audit2(rows):
    def _pf_fn0():
        for (name, qty) in rows:
            return Ok(None) if qty >= 0 else Error(f"negative {name}")
        _pf_t0 = Ok(_pf_sum_by(_pf_snd, rows))
        if isinstance(_pf_t0, Ok):
            total = _pf_t0._0
            return Ok(total)
        else:
            return _pf_t0
    return _pf_fn0()
print((audit2(tallies), audit2([("ok", 1)])))
def _pf_fn1(_pf_arg0, _pf_arg1):
    lo, hi = _pf_arg0
    _, q = _pf_arg1
    return (min(lo, q), max(hi, q))
bounds = _pf_fold(_pf_fn1, (1000, -1000), tallies)
print(bounds)
acc = dict()
for (k, v) in _pf_concat(tallies, tallies):
    _pf_t1 = v + _pf_map_find_or(k, 0, acc)
    acc[k] = _pf_t1
index = acc
print(_pf_map_to_list(index))
def _pf_fn2():
    for (name, qty) in tallies:
        doubled = qty * 2
        yield f"{name}={doubled}"
labels = _pf_fn2()
print(_pf_str_join(",", list(labels)))
def _pf_fn3(_pf_arg0):
    i, _pf_arg0_1 = _pf_arg0
    name, qty = _pf_arg0_1
    return print(f"{i + 1}. {name} x{qty}")
_pf_iter(_pf_fn3, _pf_indexed(tallies))
len_ = 6
print((len([1, 2, 3]) + len_, len("abc")))
def sum_(a, b):
    return a - b
print((sum_(10, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
acc = []
for k in [7, 3, 5]:
    _pf_t2 = lambda y: y * k
    acc.append(_pf_t2)
chain = acc
print(_pf_map(lambda h: h(5), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 8
    return _pf_map(lambda g: g(n), fs)
print(shifted(9, [7, 0, 1]))
def _pf_fn4():
    for (name, k) in [("a", 7), ("b", 9)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn4()
print(_pf_map(lambda h: h(5), list(callbacks2)))
