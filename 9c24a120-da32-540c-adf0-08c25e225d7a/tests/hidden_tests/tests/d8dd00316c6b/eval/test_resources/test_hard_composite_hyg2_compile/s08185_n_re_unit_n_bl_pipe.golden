import functools
import math
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def stack2(start):
    level = start
    g0 = lambda y: level + y
    level = level * 2
    g1 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 7
    def g2(y):
        return level * y
    level = g2(level)
    g3 = lambda y: level + y
    level = g3(level)
    return (g0(3), g1([1, 2]), g2(2), g3(2), level)
