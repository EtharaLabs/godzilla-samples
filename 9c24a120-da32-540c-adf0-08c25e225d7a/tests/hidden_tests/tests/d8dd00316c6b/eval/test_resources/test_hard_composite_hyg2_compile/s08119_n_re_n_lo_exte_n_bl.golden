    bump2 = 2
    tmp = useHelper(bump2)
    return tmp * 2
first = _pf_fn1()
def _pf_fn2():
    _pf_t3 = [8]
    if _pf_t3:
        bump2 = _pf_t3[0]
        return bump2 + useHelper(1)
    else:
        return 0
second = _pf_fn2()
def _pf_fn3():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
gamma = _pf_fn3()
