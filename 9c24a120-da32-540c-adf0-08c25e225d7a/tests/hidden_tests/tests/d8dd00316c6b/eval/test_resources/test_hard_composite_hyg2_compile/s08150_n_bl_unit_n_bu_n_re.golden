import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_concat(a, b):
    return a + b
def bump2(n):
    return n + 67
def useHelper(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 5
    tmp = useHelper(bump2)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [6]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + useHelper(1)
    else:
        return 0
beta = _pf_fn1()
def _pf_fn2():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
third = _pf_fn2()
print((first, beta, third, useHelper(0)))
segments = [93.8, 284.0, 114.4]
times = [43.8, 63.3, 67.1]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = dist / elapsed
print(_pf_fmt_fixed(2, rate))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
side = math.sqrt(2.25)
