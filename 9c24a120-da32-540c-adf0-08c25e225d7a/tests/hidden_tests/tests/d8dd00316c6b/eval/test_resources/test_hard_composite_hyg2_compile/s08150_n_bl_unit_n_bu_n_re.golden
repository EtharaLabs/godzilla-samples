def sum_(a, b):
    return a - b
print((sum_(8, 3), sum([1, 2, 3]), _pf_sum_by(lambda x: x * 2, [1, 2])))
def stack2(start):
    x = start
    g0 = lambda y: x + y
    x = g0(x)
    g1 = functools.partial(_pf_map, lambda y: y - x)
    x = x + 6
    def g2(y):
        return x * y
    x = g2(x)
    return (g0(1), g1([1, 2]), g2(4), x)
