import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fn0():
    for (name, k) in [("a", 4), ("b", 3)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(1), list(callbacks2)))
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(shifted(2, [1, 4, 2]))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(4, 0)
print(inspect([12, 32, 24]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "hal", "stop"])
print((logged, counts))
def stack2(start):
    base = start
    g0 = lambda y: base + y
    base = base + 5
    def g1(y):
        return base * y
    base = base * 5
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 1
    return (g0(4), g1(4), g2([1, 2]), base)
print(stack2(7))
