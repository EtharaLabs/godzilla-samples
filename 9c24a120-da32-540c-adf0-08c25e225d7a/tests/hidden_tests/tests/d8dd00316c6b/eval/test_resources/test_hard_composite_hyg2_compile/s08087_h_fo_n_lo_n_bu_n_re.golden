from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_concat(a, b):
    return a + b
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
def apply(acc, op):
    match acc:
        case (m, xs):
            match op:
                case Put(k, v):
                    return (_pf_map_add(k, v, m), xs)
                case Push(n):
                    return (m, _pf_concat(xs, [n]))
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def execute(script):
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
changes = [_Skip, Put("cog", 7), Put("gear", 4), _Skip, Push(7), _Skip]
outcome = execute(changes)
mm, items = outcome
print((_pf_map_to_list(mm), items))
sumSq = _pf_fold(lambda apply, x: apply + x * x, 0, [4, 6, 8, 7])
print(sumSq)
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 9
    return _pf_map(lambda g: g(n), fs)
print(shifted(2, [7, 2, 8]))
acc = []
for k in [6, 6, 1]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
steps = acc
print(_pf_map(lambda h: h(3), steps))
print(_pf_fold(lambda v, h: h(v), 1, steps))
def _pf_fn0():
    for (name, k) in [("a", 1), ("b", 7)]:
        yield lambda y: f"{name}:{k * y}"
callbacks2 = _pf_fn0()
print(_pf_map(lambda h: h(1), list(callbacks2)))
def sorted_(xs):
    return _pf_rev(_pf_sort(xs))
print((sorted_([5, 7, 2, 4]), _pf_sort([3, 1, 2])))
str_ = "jo"
print((str(54), str_, _pf_str_concat(str_, str(1))))
def stack2(start):
    x = start
    def g0(y):
        return x * y
    x = x + 16
    def g1(y):
        return x * y
    x = x * 3
    return (g0(2), g1(1), x)
print(stack2(6))
