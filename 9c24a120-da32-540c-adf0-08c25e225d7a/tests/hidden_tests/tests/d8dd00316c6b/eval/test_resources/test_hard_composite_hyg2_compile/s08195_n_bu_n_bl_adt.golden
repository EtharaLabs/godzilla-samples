first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [8]
    if _pf_t0:
        bump2 = _pf_t0[0]
        return bump2 + callHelper(1)
    else:
        return 0
beta = _pf_fn1()
def _pf_fn2():
    if first > beta:
        _first = beta
        return _first + 1
    else:
        return first
gamma = _pf_fn2()
print((first, beta, gamma, callHelper(0)))
def render(t):
    match t:
        case Emit(n0) if n0 > 6:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Drop(s0, s1):
            return f"drop({s0},{s1})"
        case Push(n0):
            return f"push({n0})"
        case Load():
            return f"load"
        case Skip(n0, n1):
            return f"skip({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Emit(x0):
            return x0
        case Push(x0):
            return x0 * 2
        case Load():
            return 5
        case Drop(_, _):
            return 9
        case _:
            return 1
prog = [Emit(10), Push(6), Emit(-3), Push(3), Skip(8, 1)]
print(_pf_map(render, prog))
tally = _pf_sum_by(cost, prog)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: cost(t) > 3, prog)))
