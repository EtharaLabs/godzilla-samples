def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
