def render(t):
    match t:
        case Mark(n0):
            return f"mark({n0})"
        case Load(s0, n1):
            return f"load({s0},{n1})"
        case Emit(s0):
            return f"emit({s0})"
        case Store(n0):
            return f"store({n0})"
        case Skip():
            return f"skip"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Emit(_):
            return 3
        case Load(_, x1):
            return x1
        case Skip():
            return 3
        case _:
            return 0
batch = [Store(10), Store(5), _Skip, Store(2)]
print(_pf_str_join("; ", _pf_map(render, batch)))
tally = _pf_sum_by(weight, batch)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: weight(t) > 1, batch)))
def stack2(start):
    acc = start
    g0 = lambda y: acc + y
    acc = g0(acc)
    def g1(y):
        return acc * y
    acc = acc + 5
    return (g0(4), g1(2), acc)
print(stack2(8))
