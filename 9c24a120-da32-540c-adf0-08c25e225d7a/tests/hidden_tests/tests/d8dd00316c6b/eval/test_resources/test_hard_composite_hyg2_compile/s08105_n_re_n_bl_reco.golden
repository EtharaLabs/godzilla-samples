from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
def layer(start):
    acc = start
    def g0(y):
        return acc * y
    acc = acc + 20
    def g1(y):
        return acc * y
    acc = acc + 7
    def g2(y):
        return acc * y
    acc = g2(acc)
    g3 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 5
    return (g0(2), g1(5), g2(4), g3([1, 2]), acc)
print(layer(4))
def nudge(n):
    return n + 34
def callHelper(x):
    return nudge(x)
def _pf_fn0():
    nudge = 2
    tmp = callHelper(nudge)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [6]
    if _pf_t0:
        nudge = _pf_t0[0]
        return nudge + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
third = _pf_fn2()
print((alpha, second, third, callHelper(0)))
parcels = [Parcel(100, "lu", 17, False), Parcel(101, "lu", 144, True), Parcel(102, "sue", 203, False), Parcel(103, "lu", 293, True), Parcel(104, "tom", 278, False)]
def bucket(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 99:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 99:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, parcels))
print(_pf_count_by(bucket, parcels))
def _pf_fn3(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn3, (0, 0), parcels)
print(f"{nrec} records, {amt} total")
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by_desc(lambda o: o.amount, parcels))))
cheap, dear = _pf_partition(lambda o: o.amount < 170, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
