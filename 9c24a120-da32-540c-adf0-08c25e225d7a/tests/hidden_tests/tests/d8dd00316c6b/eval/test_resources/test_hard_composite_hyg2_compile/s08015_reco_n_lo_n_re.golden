from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
tickets = [Invoice(100, "ada", 257, False, Addr("Lima", 4)), Invoice(101, "hal", 132, True, Addr("Kyiv", 4)), Invoice(102, "max", 173, False, Addr("Doha", 4)), Invoice(103, "ada", 189, True, Addr("Bern", 4)), Invoice(104, "hal", 127, False, Addr("Rome", 3)), Invoice(105, "hal", 132, False, Addr("Rome", 2))]
rushSum = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(rushSum)
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Invoice(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Addr("Hub", 1))
    else:
        return o
rerouted = _pf_map(_pf_fn0, tickets)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by_desc(lambda o: o.amount, tickets))))
def bucket(o):
    match o:
        case Invoice(urgent=True, amount=amount) if amount > 198:
            return "rush-big"
        case Invoice(urgent=True):
            return "rush"
        case Invoice(amount=amount):
            if amount > 198:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, tickets))
print(_pf_count_by(bucket, tickets))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, sumAmt = _pf_fold(_pf_fn1, (0, 0), tickets)
print(f"{nrec} records, {sumAmt} total")
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 8
    return _pf_map(lambda g: g(n), fs)
print(shifted(4, [0, 7, 7]))
acc = []
for k in [7, 6, 6]:
    _pf_t3 = lambda y: y * k
    acc.append(_pf_t3)
chain = acc
print(_pf_map(lambda h: h(1), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def build(start):
    base = start
    g0 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 7
    def g1(y):
        return base * y
    base = base * 5
    def g2(y):
        return base * y
    base = g2(base)
    return (g0([1, 2]), g1(4), g2(2), base)
print(build(4))
