from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
legs = [42.3, 39.0, 474.2, 72.6]
times = [23.2, 65.3, 42.5, 32.8]
dist = _pf_fold(lambda a, b: a + b, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
speed = dist / dur
print(_pf_fmt_fixed(1, speed))
mass = 66.0
accel = 5.5
push = mass * accel
limit = 178.0
print("over" if push > limit else "under")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
speeds = _pf_map2(lambda d, t: d / t, legs, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(legs, times))
print(best)
def shifted(n, xs):
    fs = _pf_map(lambda x: lambda y: x + y + n, xs)
    n = n * 6
    return _pf_map(lambda g: g(n), fs)
print(shifted(9, [8, 2, 2]))
def _pf_fn1():
    for (name, k) in [("a", 3), ("b", 2)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn1()
print(_pf_map(lambda h: h(5), list(handlers)))
def stack2(start):
    acc = start
    g0 = functools.partial(_pf_map, lambda y: y - acc)
    acc = acc + 2
    g1 = lambda y: acc + y
    acc = g1(acc)
    g2 = lambda y: acc + y
    acc = g2(acc)
    def g3(y):
        return acc * y
    acc = g3(acc)
    return (g0([1, 2]), g1(5), g2(5), g3(3), acc)
print(stack2(6))
