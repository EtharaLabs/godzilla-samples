from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
def lift(n):
    return n + 69
def callHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 1
    tmp = callHelper(lift)
    return tmp * 2
alpha = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [2]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if alpha > second:
        _alpha = second
        return _alpha + 1
    else:
        return alpha
third = _pf_fn2()
print((alpha, second, third, callHelper(0)))
book = [Booking(100, "quin", 297, True), Booking(101, "hal", 17, True), Booking(102, "quin", 101, False), Booking(103, "quin", 52, False)]
def bucket(o):
    match o:
        case Booking(urgent=True, amount=amount) if amount > 121:
            return "rush-big"
        case Booking(urgent=True):
            return "rush"
        case Booking(amount=amount):
            if amount > 121:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, book))
print(_pf_count_by(bucket, book))
def _pf_fn3(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn3, _pf_group_by(lambda o: o.owner, book))
print(byOwner)
cheap, dear = _pf_partition(lambda o: o.amount < 104, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
print(_pf_max_by(lambda o: o.amount, book))
def build(start):
    base = start
    def g0(y):
        return base * y
    base = base + 16
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 9
    g2 = lambda y: base + y
    base = base * 5
    def g3(y):
        return base * y
    base = base * 3
    return (g0(3), g1([1, 2]), g2(2), g3(3), base)
print(build(8))
