from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
acc = []
for k in [8, 6, 5]:
    _pf_t0 = lambda y: y * k
    acc.append(_pf_t0)
chain = acc
print(_pf_map(lambda h: h(3), chain))
print(_pf_fold(lambda v, h: h(v), 1, chain))
def _pf_fn0():
    for (name, k) in [("a", 1), ("b", 4)]:
        yield lambda y: f"{name}:{k * y}"
handlers = _pf_fn0()
print(_pf_map(lambda h: h(5), list(handlers)))
def layer(start):
    base = start
    def g0(y):
        return base * y
    base = base + 17
    g1 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 1
    g2 = functools.partial(_pf_map, lambda y: y - base)
    base = base + 4
    g3 = lambda y: base + y
    base = g3(base)
    return (g0(2), g1([1, 2]), g2([1, 2]), g3(1), base)
print(layer(2))
vars = dict([("x", 8), ("y", 2)])
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case Var(v):
            return _pf_map_find_or(v, 0, vars)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Var("y"), Neg(Num(-2)), Mul(Num(5), Add(Num(1), Add(Num(7), Num(9))))]
_pf_iter(print, _pf_map(pretty, exprs))
print(_pf_map(evalE, exprs))
