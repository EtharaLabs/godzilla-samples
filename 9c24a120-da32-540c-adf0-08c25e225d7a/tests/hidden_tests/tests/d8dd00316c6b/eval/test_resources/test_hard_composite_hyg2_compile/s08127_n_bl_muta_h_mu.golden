def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def lift(n):
    return n + 14
def callHelper(x):
    return lift(x)
def _pf_fn0():
    lift = 2
    tmp = callHelper(lift)
    return tmp * 2
first = _pf_fn0()
def _pf_fn1():
    _pf_t0 = [7]
    if _pf_t0:
        lift = _pf_t0[0]
        return lift + callHelper(1)
    else:
        return 0
second = _pf_fn1()
def _pf_fn2():
    if first > second:
        _first = second
        return _first + 1
    else:
        return first
third = _pf_fn2()
print((first, second, third, callHelper(0)))
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 4
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([-6, 8, 26, 55, -13, 26, 12]))
doubled = _pf_map(track, [-6, 8, 26, 55])
print(f"{doubled} after {hits} calls")
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(audit([38, 1, 1, 32, 6]))
logged = []
def push2(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(push2, ["start", "jo", "stop"])
print((logged, counts))
