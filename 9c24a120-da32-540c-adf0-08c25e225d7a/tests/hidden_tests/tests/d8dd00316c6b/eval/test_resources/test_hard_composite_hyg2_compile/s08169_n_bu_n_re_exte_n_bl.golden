def build(start):
    level = start
    g0 = functools.partial(_pf_map, lambda y: y - level)
    level = level + 4
    def g1(y):
        return level * y
    level = g1(level)
    def g2(y):
        return level * y
    level = level + 12
    return (g0([1, 2]), g1(3), g2(3), level)
