exit: 0
--- stdout ---
type Placed = { letter: string, row: int }
type Cell = { letter: string, blank: bool }
type Board = { top: Cell }
let p = Placed { letter = "a", row = 1 }
let c = Cell { letter = "b", blank = false }
let b = Board { top = c }
let pl = p.letter
let cl = c.letter
let nested = b.top.letter
let moved = { p with letter = "z" }
let viaMatch =
    match c:
        case Cell { letter }: letter
