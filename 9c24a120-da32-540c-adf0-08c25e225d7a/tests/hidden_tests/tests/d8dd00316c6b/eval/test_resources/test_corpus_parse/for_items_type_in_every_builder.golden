let squares = seq {
    for x in [1, 2, 3]:
        let y = (x * x)
        yield y
    yield 100
}
let pairs = seq { for (a, b) in [(1, 2)]: yield (a + b) }
let lazy = seq { for x in (Seq.ofList [1]): yield x }
let check x = (if (x > 0) then (Ok x) else (Error "neg"))
let all xs = result { for x in xs: let! _ = (check x) return true }
let main = async { for n in [1, 2]: do! (Async.sleep 0.001) return () }
module B =
    let yield_ x = [x]
    let for_ xs f = ((List.collect f) xs)
    let combine a b = ((List.concat a) b)
    let delay f = (f ())
let built = B { for x in [1, 2]: yield x }
