exit: 0
--- stdout ---
module Maybe =
    let bind m f =
        match m:
            case (Some x): (f x)
            case None: None
    let return_ x = (Some x)
let safe a b = Maybe { let! x = a let! y = b return (x + y) }
let unwrap m =
    match m:
        case (Some n): n
        case None: 0
let r1 = (unwrap ((safe (Some 3)) (Some 4)))
let r2 = (unwrap ((safe (Some 3)) None))
