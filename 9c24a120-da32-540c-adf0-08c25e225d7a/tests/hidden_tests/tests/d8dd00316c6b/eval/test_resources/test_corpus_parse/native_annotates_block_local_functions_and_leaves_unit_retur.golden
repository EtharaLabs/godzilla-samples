exit: 0
--- stdout ---
type Shape = Circle float | Square float
let total shapes =
    let area s =
        match s:
            case (Circle r): ((3.0 * r) * r)
            case (Square w): (w * w)
    let add acc s = (acc + (area s))
    (((List.fold add) 0.0) shapes)
let report n = (print (n + 0.0))
(report (total [(Circle 1.0), (Square 2.0)]))
