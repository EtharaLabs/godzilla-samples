exit: 0
--- stdout ---
extern import asyncio
extern runAsync: (Async a) -> a = asyncio.run
let finished count = async { return count }
let countdown n acc = async { return! (if (n == 0) then (finished acc) else ((countdown (n - 1)) (acc + n))) }
let tally xs =
    let mut total = 0
    let add x = (total <- (total + x))
    ((List.iter add) xs)
    total
(print (runAsync ((countdown 4) 0)))
(print (tally [1, 2, 3]))
