type Placed = { row: int, letter: string }
type Cell = { row: int, letter: string, blank: bool }
let board = (Map.ofList [(1, Placed { row = 1, letter = "A" })])
let at k =
    match ((Map.tryFind k) board):
        case (Some p): p.letter
        case None: ""
