exit: 0
--- stdout ---
let step a b =
    let why = "x"
    let x =
        match a:
            case (Ok v): v
            case (Error why): (String.len why)
    let y =
        match b:
            case (Ok v): v
            case (Error why): (String.len why)
    (((String.len why) + x) + y)
let r = ((step (Ok 1)) (Error "no"))
