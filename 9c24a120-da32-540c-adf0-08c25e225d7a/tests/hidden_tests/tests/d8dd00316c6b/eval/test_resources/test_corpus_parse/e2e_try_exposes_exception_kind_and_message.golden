--- stdout ---
extern parseInt: string -> int = int
let kindOf s =
    match (try (parseInt s)):
        case (Ok n): "ok"
        case (Error e): e.errorKind
let k = (kindOf "nope")
let matched =
    match (try (parseInt "x")):
        case (Error Exception { errorKind = "ValueError" }): "caught-value-error"
        case _: "other"
