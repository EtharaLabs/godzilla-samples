--- stdout ---
type Placed = { row: int, col: int, letter: string }
type Cell = { row: int, col: int, letter: string, blank: bool }
let describe c =
    let l = c.letter
    let flag = c.blank
    f"{l}/{flag}"
let out = (describe Cell { row = 1, col = 2, letter = "A", blank = false })
