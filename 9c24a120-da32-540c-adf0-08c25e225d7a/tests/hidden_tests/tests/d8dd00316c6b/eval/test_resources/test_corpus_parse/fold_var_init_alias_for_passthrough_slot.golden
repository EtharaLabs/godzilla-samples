let step acc x =
    match acc:
        case (m, keep): ((((Map.add x) x) m), keep)
let seed = Map.empty
let seed2 = Map.empty
let r = (((List.fold step) (seed, seed2)) [1, 2])
let out =
    match r:
        case (m, keep): ((Map.len m), (Map.len keep), (Map.len seed2))
