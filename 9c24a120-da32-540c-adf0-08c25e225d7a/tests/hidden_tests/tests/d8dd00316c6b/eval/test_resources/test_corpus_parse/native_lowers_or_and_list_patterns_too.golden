exit: 0
--- stdout ---
let f xs =
    match xs:
        case ([] | [_]): "short"
        case [a, b]: f"pair {a}{b}"
        case [a, *mid, z]: f"{a}..{z} with {(List.len mid)} inside"
let g n =
    match n:
        case (1 | 2 | 3): "small"
        case _: "big"
(print (f []))
(print (f [7]))
(print (f [1, 2]))
(print (f [1, 2, 3, 4]))
(print (g 2))
(print (g 9))
--- stderr ---
