type Leg = { depMin: int, dest: string }
let dedupLegs legs =
    let step acc leg =
        match acc:
            case (seen, out):
                let k = f"{leg.depMin}|{leg.dest}"
                (match ((Map.tryFind k) seen): case (Some _): (seen, out) case None: ((((Map.add k) true) seen), ((List.concat out) [leg])))
    (match (((List.fold step) (Map.empty, [])) legs): case (_, out): out)
let out = ((List.map (fun l -> l.depMin)) (dedupLegs [Leg { depMin = 1, dest = "a" }, Leg { depMin = 1, dest = "a" }, Leg { depMin = 2, dest = "b" }]))
