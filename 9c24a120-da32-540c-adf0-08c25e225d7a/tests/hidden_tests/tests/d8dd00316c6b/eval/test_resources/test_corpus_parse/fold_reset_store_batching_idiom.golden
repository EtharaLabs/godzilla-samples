let step acc x =
    match acc:
        case (cur, groups): (if (x == 0) then ([], ((List.concat groups) [cur])) else (((List.concat cur) [x]), groups))
let out =
    match (((List.fold step) ([], [])) [1, 2, 0, 3, 0]):
        case (cur, groups): (cur, groups)
