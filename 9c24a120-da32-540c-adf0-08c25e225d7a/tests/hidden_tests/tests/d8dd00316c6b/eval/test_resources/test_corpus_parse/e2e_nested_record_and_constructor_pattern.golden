type Box = { item: Option int, tag: bool }
let f b =
    match b:
        case Box { item = (Some n), tag = true }: n
        case Box { item = (Some n) }: (n + 100)
        case _: 0
let a = (f Box { item = (Some 5), tag = true })
let b = (f Box { item = (Some 5), tag = false })
let c = (f Box { item = None, tag = true })
