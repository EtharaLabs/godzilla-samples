type Cmd = Put int int | Push int | Skip
let step acc c =
    match acc:
        case (m, xs):
            match c:
                case (Put k v): ((((Map.add k) v) m), xs)
                case (Push n): (m, ((List.concat xs) [n]))
                case Skip: acc
let run cmds = (((List.fold step) (Map.empty, [])) cmds)
let out =
    match (run [((Put 1) 10), (Push 2), Skip, ((Put 3) 30), (Push 4)]):
        case (m, xs): ((Map.toList m), xs)
