exit: 0
--- stdout ---
type Point = { x: int, y: int }
let classify p =
    match p:
        case Point { x = 0, y = 0 }: 1
        case Point { x = 0 }: 2
        case Point { x, y }: (x + y)
let a = (classify Point { x = 0, y = 0 })
let b = (classify Point { x = 0, y = 9 })
let c = (classify Point { x = 3, y = 4 })
