type Point = { x: int, y: int }
let f y p q =
    let a =
        match p:
            case Point { x = 0, y }: y
            case Point { x }: (x + y)
    let b =
        match q:
            case ((0, y) | (y, 0)): y
            case (_, _): y
    (a + b)
let r = (((f 1000) Point { x = 0, y = 2 }) (0, 3))
let s = (((f 1000) Point { x = 4, y = 2 }) (7, 8))
