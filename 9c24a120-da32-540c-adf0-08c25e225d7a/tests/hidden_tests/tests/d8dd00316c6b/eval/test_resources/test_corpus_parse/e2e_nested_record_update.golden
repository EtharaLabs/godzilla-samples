exit: 0
--- stdout ---
type Inner = { a: int, b: int }
type Outer = { inner: Inner, tag: string }
let o = Outer { inner = Inner { a = 1, b = 2 }, tag = "x" }
let o2 = { o with inner.a = 99 }
let both = { o with inner.a = 10, tag = "y" }
let na = o2.inner.a
let nb = o2.inner.b
let nt = o2.tag
let ba = both.inner.a
let bt = both.tag
