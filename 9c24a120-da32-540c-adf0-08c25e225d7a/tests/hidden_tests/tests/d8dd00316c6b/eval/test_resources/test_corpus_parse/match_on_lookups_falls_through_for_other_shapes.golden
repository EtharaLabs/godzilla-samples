exit: 0
--- stdout ---
let a k m =
    match ((Map.tryFind k) m):
        case (Some 0): "zero"
        case (Some _): "other"
        case None: "none"
let b k m =
    match ((Map.tryFind k) m):
        case (Some v) if (v > 0): v
        case _: 0
let c f =
    match (f 1):
        case (Some v): v
        case None: 0
