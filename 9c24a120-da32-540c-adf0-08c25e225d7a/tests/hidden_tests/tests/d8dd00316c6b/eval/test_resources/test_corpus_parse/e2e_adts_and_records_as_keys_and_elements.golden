type Color = Red | Green | Blue
type Point = { x: int, y: int }
let cs = (Set.ofList [Red, Green, Red, Blue])
let ncolors = (Set.len cs)
let hasGreen = ((Set.contains Green) cs)
let m = (((Map.add (Some 1)) "one") Map.empty)
let v = ((Option.withDefault "?") ((Map.tryFind (Some 1)) m))
let pts = (Set.ofList [Point { x = 1, y = 2 }, Point { x = 1, y = 2 }, Point { x = 3, y = 4 }])
let npts = (Set.len pts)
