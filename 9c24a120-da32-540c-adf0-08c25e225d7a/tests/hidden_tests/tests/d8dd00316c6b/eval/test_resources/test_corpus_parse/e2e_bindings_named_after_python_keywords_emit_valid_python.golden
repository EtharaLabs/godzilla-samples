type P = { lambda: int }
let f class = (class + 1)
let g o =
    match o:
        case (Some def): def
        case None: 0
let h = ((List.map (fun global -> (global + 1))) [1])
let k n =
    let pass = (n + 1)
    (pass * 2)
let p = P { lambda = 7 }
(print (f 1))
(print (g (Some 3)))
(print h)
(print (k 3))
(print p.lambda)
