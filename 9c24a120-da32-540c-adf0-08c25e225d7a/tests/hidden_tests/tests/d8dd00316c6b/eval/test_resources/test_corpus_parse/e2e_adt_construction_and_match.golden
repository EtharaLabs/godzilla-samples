type Color = Red | Green | Blue
let unwrap o =
    match o:
        case (Some v): v
        case None: 0
let r1 = (unwrap (Some 5))
let r2 = (unwrap None)
let rank c =
    match c:
        case Red: 1
        case Green: 2
        case Blue: 3
let r3 = (rank Green)
