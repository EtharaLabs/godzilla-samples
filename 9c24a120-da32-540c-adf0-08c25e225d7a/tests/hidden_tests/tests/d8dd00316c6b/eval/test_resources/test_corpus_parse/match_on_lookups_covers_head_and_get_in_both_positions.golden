let hd xs =
    match (List.head xs):
        case (Some h): h
        case None: 0
let g i xs = (1 + (match ((List.get (i + 1)) xs): case (Some (a, b)): (a + b) case None: 0))
let w m =
    match ((Map.tryFind 1) m):
        case (Some _): 1
        case None: 0
