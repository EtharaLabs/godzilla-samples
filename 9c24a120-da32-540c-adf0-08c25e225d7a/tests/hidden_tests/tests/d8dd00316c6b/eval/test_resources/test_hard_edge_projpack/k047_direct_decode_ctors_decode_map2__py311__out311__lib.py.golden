from dataclasses import dataclass
from functools import total_ordering
def _pf_dec_field(name, dec):
    def go(v):
        if not isinstance(v, dict):
            raise ValueError("expected a JSON object")
        return dec(v[name])
    return go
def _pf_dec_int(v):
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    raise ValueError("expected an int, got " + type(v).__name__)
def _pf_dec_map(f, dec):
    def go(v):
        return f(dec(v))
    return go
def _pf_dec_map2(f, da, db):
    def go(v):
        return f(da(v), db(v))
    return go
def _pf_dec_one_of(decs):
    def go(v):
        def _try(i):
            if i >= len(decs):
                raise ValueError("Decode.oneOf: no decoder matched")
            try:
                return decs[i](v)
            except Exception:
                return _try(i + 1)
        return _try(0)
    return go
def _pf_dec_string(v):
    if isinstance(v, str):
        return v
    raise ValueError("expected a string, got " + type(v).__name__)
def _pf_dec_succeed(x):
    def go(v):
        return x
    return go
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Low:
    def __repr__(self):
        return "Low"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0,)
_Low = Low()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class High:
    _0: int
    def __repr__(self):
        return f"High({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@dataclass(frozen=True, slots=True, order=True)
class User:
    name: str
    age: int
level = _pf_dec_one_of([_pf_dec_map(lambda n: High(n), _pf_dec_int), _pf_dec_succeed(_Low)])
user = _pf_dec_map2(lambda n, a: User(n, a), _pf_dec_field("name", _pf_dec_string), _pf_dec_field("age", _pf_dec_int))
