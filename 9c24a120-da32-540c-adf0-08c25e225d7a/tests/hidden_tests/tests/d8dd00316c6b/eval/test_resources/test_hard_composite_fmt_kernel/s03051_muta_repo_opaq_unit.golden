00002729from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
ticks = 0
def note(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([-17, -2, -20, -15, 23, -5, 34]))
doubled = _pf_map(note, [-17, -2, -20, -15])
print(f"{doubled} after {ticks} calls")
lines = [Line("tap", 14, 8.81), Line("cog", 28, 27.59), Line("wick", 7, 20.02)]
def fmtLine(x):
    return f"{_pf_fmt_pad_right(8, "-", x.name)}|{_pf_fmt_pad_left(4, " ", str(x.qty))}|{_pf_fmt_fixed(2, x.price)}|{"restock" if x.qty > 4 else "ok"}"
_pf_iter(print, _pf_map(fmtLine, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("acc", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
laps = [102.2, 77.4, 104.6, 205.9]
durations = [51.7, 6.1, 55.9, 65.8]
dist = _pf_fold(lambda a, b: a + b, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate = dist / dur
print(_pf_fmt_fixed(1, rate))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
edge = math.sqrt(4.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
speeds = _pf_map2(lambda d, t: d / t, laps, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
