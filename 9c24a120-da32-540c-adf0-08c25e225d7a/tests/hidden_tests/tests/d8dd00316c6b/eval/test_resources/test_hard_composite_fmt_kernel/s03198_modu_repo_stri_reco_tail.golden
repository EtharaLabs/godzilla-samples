00005005from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs = [21, 24, 1, -14, -14]
print(Calc_mean(obs))
print(_pf_filter(functools.partial(Calc_between, 3, 22), obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 12), obs))
entries = [Entry("pin", 11, 34.07), Entry("rod", 10, 38.18), Entry("cap", 6, 36.5)]
def showRow(x):
    return f"{_pf_fmt_pad_right(7, " ", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {_pf_fmt_currency("$", 2, x.price * 7.0)}"
_pf_iter(print, _pf_map(showRow, entries))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 11, entries))
print(f"low: {_pf_str_join("", low)} ({_pf_fmt_percent(1, 0.5 * 1.0)})")
sentence = "tap max ivy eli cap ada pam"
words = _pf_str_split(" ", sentence)
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
print((_pf_str_index_of("ta", sentence), "ta" in sentence))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), words)))
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", "12,5a,x,40,7"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
parcels = [Order(100, "kit", 147, False, Addr("Riga", 3)), Order(101, "kit", 215, False, Addr("Bern", 2)), Order(102, "cy", 154, True, Addr("Baku", 2)), Order(103, "cy", 127, True, Addr("Oslo", 3)), Order(104, "kit", 70, True, Addr("Riga", 1)), Order(105, "cy", 285, False, Addr("Doha", 4))]
cheap, dear = _pf_partition(lambda o: o.amount < 83, parcels)
