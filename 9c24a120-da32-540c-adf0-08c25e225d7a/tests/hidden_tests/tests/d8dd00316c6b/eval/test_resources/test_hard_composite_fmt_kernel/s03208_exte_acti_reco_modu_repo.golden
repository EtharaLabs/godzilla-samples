00003947from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
print(_pf_map(math.isqrt, [173, 170, 230, 342]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("111111") + int("133", base=8))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(4))
def _ap_Above(n):
    if n > 23:
        return Some(n - 23)
    else:
        return _None_
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [18, 27, 6, 22, 5, 40, -6]))
tickets = [Order(100, "ivy", 52, False), Order(101, "kit", 292, False), Order(102, "kit", 40, False), Order(103, "ivy", 186, True)]
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
perOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, tickets))
print(perOwner)
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
cheap, dear = _pf_partition(lambda o: o.amount < 174, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def bucket(o):
    match o:
        case Order(urgent=True, amount=amount) if amount > 182:
            return "rush-big"
        case Order(urgent=True):
            return "rush"
        case Order(amount=amount):
            if amount > 182:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, tickets))
print(_pf_count_by(bucket, tickets))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_square(x):
    return x * x
obs = [23, -15, 24, -9, 23, 12]
print(Stats_scaleAll(5, obs))
print(_pf_filter(functools.partial(Stats_between, -1, 23), obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 10), obs))
print(_pf_map(Stats_square, obs))
lines = [Line("cog", 1, 27.04), Line("bolt", 22, 18.8), Line("tap", 17, 29.36), Line("gear", 27, 1.74)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(9, " ", x.name)}|{_pf_fmt_pad_left(4, " ", str(x.qty))}|{_pf_fmt_fixed(2, x.price)}|{"restock" if x.qty > 5 else "ok"}"
_pf_iter(print, _pf_map(renderRow, lines))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_str_upper(s):
    return s.upper()
print(f"{len(lines)} rows, {_pf_str_upper("total")}={_pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, lines))}")
