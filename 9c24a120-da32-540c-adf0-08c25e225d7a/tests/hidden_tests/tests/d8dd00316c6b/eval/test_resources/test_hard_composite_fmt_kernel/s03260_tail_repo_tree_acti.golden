env = dict([("x", 6), ("y", -2)])
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Mul(Var("y"), Neg(Num(-2))), Mul(Add(Num(1), Add(Num(1), Num(2))), Num(5)), Add(Num(2), Num(6))]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evalE, exprs))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 16:
        return Some(n - 16)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [13, 4, 6, 25, 23, 18]))
