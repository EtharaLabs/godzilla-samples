00003947from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
entries = [Line("cap", 22, 36.52), Line("bolt", 22, 35.95), Line("rod", 9, 14.15), Line("pin", 0, 27.82)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(10, ".", x.name)} {_pf_fmt_pad_left(4, " ", str(x.qty))} {_pf_fmt_fixed(1, x.price)} {"restock" if x.qty > 5 else "ok"} {_pf_fmt_currency("$", 2, x.price * 3.0)}"
_pf_iter(print, _pf_map(renderRow, entries))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 12, entries))
print(f"low: {_pf_str_join("", low)} ({_pf_fmt_percent(1, 0.5 * 1.0)})")
raw = "hub;ada;bo;eli;rod"
parts = _pf_str_split(";", raw)
print(_pf_str_slice(0, 5, raw))
print(_pf_map(lambda w: (w, len(w)), parts))
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
print(_pf_str_replace("o", "O", raw))
n2 = len(parts)
print(f"n2={n2} {{braces}} {len(raw)}")
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), parts)))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
pts = [-6, -7, 3, 3, 30, -15, 8]
print(Stats_mean(pts))
print(_pf_map(functools.partial(Stats_clamp, 0, 19), pts))
print(_pf_filter(functools.partial(Stats_between, -3, 24), pts))
print(Stats_scaleAll(5, pts))
tickets = [Booking(100, "ray", 202, True, Place("Bern", 4)), Booking(101, "eli", 113, True, Place("Lima", 4)), Booking(102, "eli", 141, False, Place("Doha", 1)), Booking(103, "ray", 95, True, Place("Doha", 1)), Booking(104, "ray", 94, False, Place("Lima", 4))]
def bucket(o):
    match o:
        case Booking(urgent=True, amount=amount) if amount > 86:
            return "rush-big"
        case Booking(urgent=True):
            return "rush"
        case Booking(amount=amount):
            if amount > 86:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, tickets))
print(_pf_count_by(bucket, tickets))
print(_pf_max_by(lambda o: o.amount, tickets))
cheap, dear = _pf_partition(lambda o: o.amount < 130, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
