def describe(t):
    match t:
        case Turn(n0) if n0 > 0:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Pop():
            return f"pop"
        case Mark(n0) if n0 % 2 == 0:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Load(n0) if n0 > 0:
            return f"load!({n0})"
        case Load(n0):
