def explain(t):
    match t:
        case Mark(n0) if n0 > 1:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Push(n0) if n0 > 1:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Halt(n0) if 0 <= n0 < 17:
            return f"halt!({n0})"
        case Halt(n0):
            return f"halt({n0})"
        case Jump(s0, n1):
            return f"jump({s0},{n1})"
        case Rest():
            return f"rest"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Halt(x0):
            return x0
        case _:
            return 3
