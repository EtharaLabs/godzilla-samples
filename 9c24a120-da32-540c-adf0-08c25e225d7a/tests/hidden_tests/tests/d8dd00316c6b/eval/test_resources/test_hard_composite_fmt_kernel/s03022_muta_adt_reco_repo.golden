def describe(t):
    match t:
        case Store(n0) if 0 <= n0 < 20:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case Emit():
            return f"emit"
        case Rest(n0) if n0 % 2 == 0:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
