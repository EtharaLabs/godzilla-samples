def render(t):
    match t:
        case Skip(2):
            return "skip-2"
        case Skip(n0):
            return f"skip({n0})"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
        case Jump(s0, n1):
            return f"jump({s0},{n1})"
        case Push() | Load():
            return "push/load"
        case _:
            raise RuntimeError("non-exhaustive match")
