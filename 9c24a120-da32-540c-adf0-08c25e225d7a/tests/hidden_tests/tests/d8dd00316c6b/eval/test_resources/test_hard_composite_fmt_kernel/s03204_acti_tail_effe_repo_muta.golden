00003135from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
def _ap_Above(n):
    if n > 29:
        return Some(n - 29)
    else:
        return _None_
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(kindOf, [34, 26, 11, 29, 21, 17, 34]))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(4, 12, 1))
def euclid(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(153, 268))
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(1753, 0))
def margin(price, qty):
    return price * qty - 3 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("gear", 27, 2), ("nut", 16, 5)]))
print(overall)
lines = [Stock("nut", 12, 32.44), Stock("cog", 22, 31.78), Stock("cap", 7, 10.21), Stock("wick", 0, 13.5)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(7, "-", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {"restock" if x.qty > 8 else "ok"}"
_pf_iter(print, _pf_map(renderRow, lines))
print(f"{len(lines)} rows, {_pf_str_upper("total")}={_pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, lines))}")
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([8, 44, 16, 50, 35, -2]))
doubled = _pf_map(track, [8, 44, 16, 50])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
