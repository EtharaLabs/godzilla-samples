00003717from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
raw = "cy;tap;quin;rod;lu;hal;hub"
words = _pf_str_split(";", raw)
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", "x,,7,,7"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
count = len(words)
print(f"count={count} {{braces}} {len(raw)}")
entries = [Stock("wick", 3, 23.93), Stock("cog", 17, 5.83), Stock("nut", 13, 33.83), Stock("tap", 29, 34.52)]
def showRow(x):
    return f"{_pf_fmt_pad_right(10, " ", x.name)} {_pf_fmt_pad_left(4, " ", str(x.qty))} {_pf_fmt_fixed(2, x.price)} {"restock" if x.qty > 7 else "ok"} {_pf_fmt_currency("$", 2, x.price * 4.0)}"
_pf_iter(print, _pf_map(showRow, entries))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 10, entries))
print(f"low: {_pf_str_join("", low)} ({_pf_fmt_percent(1, 0.5 * 1.0)})")
def _pf_fn0():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
    yield 190
evens = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, evens))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 495, fib)))
def margin(price, qty):
    return price * qty - 9 * qty
def announce(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn2(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand = sum(_pf_map(_pf_fn2, [("nut", 5, 2), ("pin", 18, 5), ("wick", 23, 4)]))
print(grand)
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
pts = [9, -8, -13, 30, 4]
print(Geo_norm1(pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 19), pts))
print(Geo_scaleAll(2, pts))
