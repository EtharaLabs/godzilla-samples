00002888from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
def _pf_fn0():
    for x in _pf_range(1, 8):
        y = x * x
        yield y
series = _pf_fn0()
print(list(_pf_seq_take(3, map(lambda n: n + 1, series))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
tickets = [Ticket(100, "tom", 97, True), Ticket(101, "ray", 236, True), Ticket(102, "ray", 69, False), Ticket(103, "fay", 187, False)]
print(_pf_max_by(lambda o: o.amount, tickets))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, sumAmt = _pf_fold(_pf_fn1, (0, 0), tickets)
print(f"{nrec} records, {sumAmt} total")
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
def surcharge(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 20), tickets)))
def label(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, tickets)))
rows = [Row("cap", 22, 22.94), Row("tap", 20, 36.51), Row("hub", 9, 24.95)]
def fmtLine(x):
    return f"{_pf_fmt_pad_right(9, " ", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {"restock" if x.qty > 11 else "ok"}"
_pf_iter(print, _pf_map(fmtLine, rows))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 5, rows))
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
print(f"low: {_pf_str_join("", low)} ({_pf_fmt_percent(1, 0.5 * 1.0)})")
