tickets = [Order(100, "hal", 201, False, Site("Oslo", 3)), Order(101, "ada", 80, False, Site("Lima", 2)), Order(102, "hal", 50, False, Site("Doha", 1)), Order(103, "bo", 190, True, Site("Lima", 3)), Order(104, "bo", 151, True, Site("Kyiv", 4))]
