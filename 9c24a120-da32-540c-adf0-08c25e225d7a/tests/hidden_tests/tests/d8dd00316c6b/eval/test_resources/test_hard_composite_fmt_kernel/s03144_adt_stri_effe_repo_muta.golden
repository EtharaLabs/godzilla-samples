print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), words)))
print(_pf_str_slice(1, 6, text))
print(_pf_str_replace("o", "O", text))
def discount(price, qty):
    return price * qty - 5 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("hub", 26, 5), ("rod", 22, 4), ("hub", 13, 4)]))
print(overall)
rows = [Entry("tap", 29, 2.06), Entry("cog", 5, 31.79), Entry("wick", 10, 19.59)]
def showRow(x):
    return f"{_pf_fmt_pad_right(10, " ", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {_pf_fmt_currency("$", 2, x.price * 9.0)}"
_pf_iter(print, _pf_map(showRow, rows))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, rows))}")
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-20, 3, 22, 17, -18, 17, 12, 3]))
doubled = _pf_map(record, [-20, 3, 22, 17])
print(f"{doubled} after {hits} calls")
