00004223from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    _1: int
    def __repr__(self):
        return f"Skip({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    _1: int
    def __repr__(self):
        return f"Jump({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
def describe(t):
    match t:
        case Load(n0):
            return f"load({n0})"
        case Push(1):
            return "push-1"
        case Push(n0):
            return f"push({n0})"
        case Skip(s0, n1):
            return f"skip({s0},{n1})"
        case Jump(0, _):
            return "jump-0"
        case Jump(n0, n1):
            return f"jump({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Skip(_, x1):
            return x1
        case Jump(x0, x1):
            return x0 + x1
        case _:
            return 0
batch = [Push(-2), Push(2), Push(-3), Push(1), Load(6), Skip("dee", 2)]
print(_pf_map(describe, batch))
grandSum = _pf_sum_by(cost, batch)
print(f"grandSum={grandSum}")
print((_pf_head(batch), _pf_last(batch)))
