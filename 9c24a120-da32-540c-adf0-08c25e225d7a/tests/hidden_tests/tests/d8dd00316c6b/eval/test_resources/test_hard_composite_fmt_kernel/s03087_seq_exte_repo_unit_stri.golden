00003303from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
def _pf_fn0():
    for x in _pf_range(1, 8):
        y = x * x
        yield y
    yield 107
evens = _pf_fn0()
print(list(_pf_seq_take(5, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [4, 4, 7, 11]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(4))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1100010") + int("117", base=8))
print(_pf_map(math.isqrt, [32, 263, 365, 302]))
lines = [Entry("gear", 13, 0.43), Entry("cap", 26, 30.45), Entry("rod", 2, 38.3), Entry("wick", 7, 2.43)]
def showRow(x):
    return f"{_pf_fmt_pad_right(7, "-", x.name)}|{_pf_fmt_pad_left(4, " ", str(x.qty))}|{_pf_fmt_fixed(1, x.price)}|{"restock" if x.qty > 10 else "ok"}"
_pf_iter(print, _pf_map(showRow, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
laps = [60.6, 311.0, 411.4]
splits = [58.2, 40.2, 59.5]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = dist / dur
print(_pf_fmt_fixed(2, pace))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
edge = math.sqrt(9.0)
