00002973from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    def __repr__(self):
        return "Store"
_Store = Store()
entries = [Entry("pin", 22, 27.16), Entry("wick", 19, 8.12), Entry("cap", 7, 21.84), Entry("hub", 18, 22.11)]
def showRow(x):
    return f"{_pf_fmt_pad_right(8, " ", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {"restock" if x.qty > 12 else "ok"}"
_pf_iter(print, _pf_map(showRow, entries))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 5, entries))
print(f"low: {_pf_str_join("", low)} ({_pf_fmt_percent(1, 0.5 * 1.0)})")
def render(t):
    match t:
        case Push(1):
            return "push-1"
        case Push(n0):
            return f"push({n0})"
        case Mark(s0):
            return f"mark({s0})"
        case Store():
            return f"store"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Mark(_):
            return 1
        case _:
            return 2
batch = [Mark("quin"), Mark("pam"), Mark("jo"), Mark("pam"), Push(2)]
print(_pf_str_join(" ", _pf_map(render, batch)))
grandSum = _pf_sum_by(weight, batch)
print(f"grandSum={grandSum}")
print((_pf_head(batch), _pf_last(batch)))
legs = [263.3, 263.5, 343.9, 266.2]
times = [6.2, 36.1, 34.0, 87.1]
total = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = total / dur
print(_pf_fmt_fixed(2, rate))
edge = math.sqrt(25.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
