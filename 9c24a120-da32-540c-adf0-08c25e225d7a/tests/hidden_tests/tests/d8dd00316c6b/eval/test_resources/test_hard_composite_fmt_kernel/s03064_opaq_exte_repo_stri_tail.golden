def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [50, 18, 33]))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(192, 189))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
