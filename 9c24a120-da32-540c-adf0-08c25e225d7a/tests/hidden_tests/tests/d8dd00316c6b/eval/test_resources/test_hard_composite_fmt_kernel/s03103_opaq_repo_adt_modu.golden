def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("acc", 4)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("acc-1"))
rows = [Stock("hub", 14, 14.98), Stock("gear", 5, 24.07), Stock("nut", 15, 20.38)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(6, " ", x.name)}|{_pf_fmt_pad_left(4, " ", str(x.qty))}|{_pf_fmt_fixed(1, x.price)}|{_pf_fmt_currency("$", 2, x.price * 5.0)}"
_pf_iter(print, _pf_map(renderRow, rows))
print(f"{len(rows)} rows, {_pf_str_upper("total")}={_pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, rows))}")
def describe(t):
    match t:
        case Mark(1):
            return "mark-1"
        case Mark(n0):
            return f"mark({n0})"
        case Turn(n0) if n0 % 2 == 0:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Emit(n0, n1):
            return f"emit({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Mark(x0):
            return x0 * 4
        case _:
            return 1
queue = [Mark(1), Emit(0, 0), Turn(-3), Mark(0), Mark(-3)]
print(_pf_map(describe, queue))
total = _pf_sum_by(rank, queue)
print(f"total={total}")
print((_pf_head(queue), _pf_last(queue)))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_square(x):
    return x * x
def Calc_between(lo, hi, x):
    return lo <= x <= hi
