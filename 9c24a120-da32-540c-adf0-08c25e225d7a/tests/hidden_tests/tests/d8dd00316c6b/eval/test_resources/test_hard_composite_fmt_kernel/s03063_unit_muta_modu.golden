00001601import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
segments = [170.8, 435.4, 315.1, 382.1, 287.7]
times = [42.3, 75.4, 15.9, 58.0, 38.5]
total = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = total / dur
print(_pf_fmt_fixed(3, pace))
edge = math.sqrt(25.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
mass = 88.0
accel = 5.5
push = mass * accel
limit = 239.0
print("over" if push > limit else "under")
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-9, 17, -19, 13, 57]))
doubled = _pf_map(track, [-9, 17, -19, 13])
print(f"{doubled} after {ticks} calls")
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
obs = [27, 3, 20, -4, 25, 2]
print(Stats_norm1(obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 20), obs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
print(_pf_filter(functools.partial(Stats_between, -1, 17), obs))
