00002872from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split(sep, s):
    return s.split(sep)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
calls = 0
def record(x):
    global calls
    calls = calls + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([38, 25, -2, 43]))
doubled = _pf_map(record, [38, 25, -2, 43])
print(f"{doubled} after {calls} calls")
lines = [Line("cap", 9, 34.03), Line("cog", 22, 1.25), Line("tap", 6, 21.21), Line("hub", 28, 39.79)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(10, "-", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {"restock" if x.qty > 4 else "ok"}: {_pf_fmt_currency("$", 2, x.price * 9.0)}"
_pf_iter(print, _pf_map(renderRow, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
raw = "ivy ray rod fay jo"
parts = _pf_str_split(" ", raw)
longest = _pf_head(_pf_sort_by(lambda w: -len(w), parts))
print(_pf_option_with_default("?", longest))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, parts))))
count = len(parts)
print(f"count={count} {{braces}} {len(raw)}")
def _pf_fn0():
    for x in _pf_range(1, 7):
        y = x * x
        yield y
squares = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, squares))
import itertools
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
