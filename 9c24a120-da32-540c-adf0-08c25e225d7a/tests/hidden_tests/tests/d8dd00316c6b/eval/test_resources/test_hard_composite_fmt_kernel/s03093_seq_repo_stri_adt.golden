def show(t):
    match t:
        case Load(2):
            return "load-2"
        case Load(n0):
            return f"load({n0})"
        case Store():
            return f"store"
        case Mark(n0, s1) if n0 % 2 == 0:
            return f"mark!({n0},{s1})"
        case Mark(n0, s1):
            return f"mark({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
