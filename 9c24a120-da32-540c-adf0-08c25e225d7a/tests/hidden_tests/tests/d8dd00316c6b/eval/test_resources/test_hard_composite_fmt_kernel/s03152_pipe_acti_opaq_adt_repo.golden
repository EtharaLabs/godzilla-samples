rows = [Entry("rod", 10, 31.78), Entry("cog", 23, 19.71), Entry("wick", 12, 21.19)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(8, ".", x.name)}|{_pf_fmt_pad_left(4, " ", str(x.qty))}|{_pf_fmt_fixed(2, x.price)}|{_pf_fmt_currency("$", 2, x.price * 8.0)}"
_pf_iter(print, _pf_map(renderRow, rows))
