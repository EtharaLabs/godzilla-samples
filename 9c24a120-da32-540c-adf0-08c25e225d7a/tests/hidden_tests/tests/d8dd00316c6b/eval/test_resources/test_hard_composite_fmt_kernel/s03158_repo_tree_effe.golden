def fmtLine(x):
    return f"{_pf_fmt_pad_right(8, "-", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(2, x.price)}: {"restock" if x.qty > 9 else "ok"}"
