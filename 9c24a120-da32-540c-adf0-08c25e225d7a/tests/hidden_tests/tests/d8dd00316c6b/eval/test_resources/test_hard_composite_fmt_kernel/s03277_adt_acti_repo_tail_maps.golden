def explain(t):
    match t:
        case Store(s0):
            return f"store({s0})"
        case Turn(n0, s1):
            return f"turn({n0},{s1})"
        case Push(3):
            return "push-3"
        case Push(n0):
            return f"push({n0})"
        case Mark(n0, n1) if 0 <= n0 < 18:
            return f"mark!({n0},{n1})"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Mark(x0, x1):
            return x0 + x1
        case _:
            return 0
