def line(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(line, book)))
def bump2(pct, o):
    extra = o.amount * pct // 100
    _pf_t2 = o
    return Booking(_pf_t2.id, _pf_t2.owner, o.amount + extra, False, _pf_t2.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(bump2, 18), book)))
