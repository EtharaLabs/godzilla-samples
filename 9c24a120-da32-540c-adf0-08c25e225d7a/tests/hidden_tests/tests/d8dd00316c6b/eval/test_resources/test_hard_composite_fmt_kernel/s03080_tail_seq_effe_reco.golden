def tag(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
def _pf_str_join(sep, xs):
    return sep.join(xs)
print(_pf_str_join(", ", _pf_map(tag, parcels)))
