parcels = [Ticket(100, "jo", 53, True, Place("Bern", 2)), Ticket(101, "jo", 274, True, Place("Riga", 1)), Ticket(102, "kit", 119, False, Place("Lima", 1)), Ticket(103, "jo", 19, False, Place("Oslo", 4)), Ticket(104, "kit", 123, False, Place("Baku", 1))]
def bucket(o):
    match o:
        case Ticket(urgent=True, amount=amount) if amount > 150:
            return "rush-big"
        case Ticket(urgent=True):
            return "rush"
        case Ticket(amount=amount):
            if amount > 150:
                return "big"
            else:
                return "normal"
