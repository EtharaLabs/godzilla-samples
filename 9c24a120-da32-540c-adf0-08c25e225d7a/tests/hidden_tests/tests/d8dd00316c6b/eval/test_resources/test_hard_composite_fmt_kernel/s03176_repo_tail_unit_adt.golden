def render(t):
    match t:
        case Load(n0):
            return f"load({n0})"
        case Drop(s0, n1):
            return f"drop({s0},{n1})"
        case Emit(0, _):
            return "emit-0"
        case Emit(n0, n1):
            return f"emit({n0},{n1})"
        case Jump():
            return f"jump"
        case Mark(s0):
            return f"mark({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
