00004334from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_result_is_error(r):
    return isinstance(r, Error)
def _pf_result_map_error(f, r):
    if isinstance(r, Error):
        return Error(f(r._0))
    return r
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 3
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([32, 38, 60, 18]))
doubled = _pf_map(track, [32, 38, 60, 18])
print(f"{doubled} after {hits} calls")
readings = [31, 6, 4, 34, 41, 22]
result = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(_pf_collect(lambda x: [x, x + 1], _pf_filter(lambda x: x > 7, _pf_distinct_by(lambda x: x % 4, readings))))
print(result)
print(len(readings))
def readPair(line):
    def _pf_fn0():
        match _pf_str_split("=", line):
            case [_k, _v]:
                _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
            case _:
                _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t1 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t1, Ok):
                n = _pf_t1._0
                return Ok((k, n))
            else:
                return _pf_t1
        else:
            return _pf_t0
    return _pf_fn0()
inputs = ["ray = 2", "dee=2", "bo=73", "hal=x"]
results = _pf_map(readPair, inputs)
_pf_iter(print, results)
errs = len(_pf_filter(_pf_result_is_error, results))
print(f"{errs} errors")
def sumAll(xs):
    def _pf_fn2(acc, r):
        def _pf_fn3():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
                    return r
            else:
                return acc
        return _pf_fn3()
    return _pf_fold(_pf_fn2, Ok(0), xs)
print(_pf_result_map_error(_pf_str_upper, sumAll(results)))
entries = [Entry("cap", 6, 7.04), Entry("rod", 23, 15.51), Entry("cog", 6, 31.35), Entry("gear", 16, 35.61)]
def fmtLine(x):
    return f"{_pf_fmt_pad_right(10, " ", x.name)} {_pf_fmt_pad_left(4, " ", str(x.qty))} {_pf_fmt_fixed(1, x.price)} {"restock" if x.qty > 8 else "ok"}"
