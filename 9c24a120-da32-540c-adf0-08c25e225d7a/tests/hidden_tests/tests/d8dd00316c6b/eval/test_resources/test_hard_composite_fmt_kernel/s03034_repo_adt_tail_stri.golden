def render(t):
    match t:
        case Mark(n0) if n0 % 2 == 0:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Emit(s0):
            return f"emit({s0})"
        case Push(n0) if 0 <= n0 < 3:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Jump():
            return f"jump"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
