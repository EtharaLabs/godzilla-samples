00003598from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def fromBin(s):
    return int(s, base=2)
print(fromBin("101110") + int("125", base=8))
print(_pf_map(math.isqrt, [339, 106, 58, 261]))
def euclid(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(240, 334))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [30, 33, 35]))
lines = [Row("cap", 28, 16.0), Row("wick", 5, 36.08), Row("bolt", 11, 21.44), Row("rod", 27, 9.03), Row("pin", 22, 1.58)]
def showRow(x):
    return f"{_pf_fmt_pad_right(6, " ", x.name)} {_pf_fmt_pad_left(4, " ", str(x.qty))} {_pf_fmt_fixed(1, x.price)} {_pf_fmt_currency("$", 2, x.price * 6.0)}"
_pf_iter(print, _pf_map(showRow, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 15:
        return Some(n - 15)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(bucketOf, [17, 34, 8, 6, 15, 19, 12]))
values = [17, 1, -10, 39, 49, 29, 36, 42, 42]
def offset(k, x):
    return x + k
pipeline = lambda _pf_x: _pf_take(3, (lambda _pf_x: _pf_filter(lambda x: x > -4, _pf_take_while(lambda x: x < 51, _pf_x)))(_pf_x))
answer = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(pipeline(values))
print(answer)
def margin(price, qty):
    return price * qty - 5 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("wick", 33, 5), ("rod", 25, 4), ("cog", 20, 6), ("rod", 5, 6)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(8)([1, 2, 3]))
