00003331from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
def _pf_fn0():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
evens = _pf_fn0()
print(list(_pf_seq_take(3, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1559, fib)))
lines = [Entry("hub", 27, 17.11), Entry("tap", 29, 32.9), Entry("pin", 11, 15.23)]
def fmtLine(x):
    return f"{_pf_fmt_pad_right(7, "-", x.name)}|{_pf_fmt_pad_left(4, " ", str(x.qty))}|{_pf_fmt_fixed(2, x.price)}|{"restock" if x.qty > 9 else "ok"}|{_pf_fmt_currency("$", 2, x.price * 8.0)}"
_pf_iter(print, _pf_map(fmtLine, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
parcels = [Order(100, "eli", 61, False), Order(101, "ivy", 236, False), Order(102, "eli", 64, False), Order(103, "ivy", 24, True), Order(104, "eli", 173, False), Order(105, "gus", 223, True)]
def _pf_fn2(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn2, (0, 0), parcels)
print(f"{nrec} records, {amt} total")
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by(lambda o: o.amount, parcels))))
cheap, dear = _pf_partition(lambda o: o.amount < 146, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def adjust(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Order(_pf_t0.id, _pf_t0.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 18), parcels)))
