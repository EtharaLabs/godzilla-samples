def describe(t):
    match t:
        case Turn(n0) if n0 > 1:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Halt():
            return f"halt"
        case Store(n0, n1) if n0 % 2 == 0:
            return f"store!({n0},{n1})"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case Skip(n0) if n0 % 2 == 0:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Halt():
            return 6
        case Store(x0, x1):
            return x0 + x1 * 5
        case Skip(x0):
            return x0
        case _:
            return 2
