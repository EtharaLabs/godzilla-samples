00003036from dataclasses import dataclass
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(1607, 0))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [12, 1, 2, 9, 12]))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(5, 12, 1))
raw = "pam oz ivy fay dee"
words = _pf_str_split(" ", raw)
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
print(_pf_str_slice(0, 4, raw))
lines = [Entry("cap", 11, 2.07), Entry("gear", 4, 5.12), Entry("rod", 21, 17.87), Entry("cog", 4, 14.29)]
def fmtLine(x):
    return f"{_pf_fmt_pad_right(8, ".", x.name)} {_pf_fmt_pad_left(4, " ", str(x.qty))} {_pf_fmt_fixed(2, x.price)} {"restock" if x.qty > 9 else "ok"}"
_pf_iter(print, _pf_map(fmtLine, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
