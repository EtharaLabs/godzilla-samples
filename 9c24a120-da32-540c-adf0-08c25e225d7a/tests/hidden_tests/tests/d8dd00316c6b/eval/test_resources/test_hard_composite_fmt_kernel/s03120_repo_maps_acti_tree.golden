def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
def simplify(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(simplify(a), simplify(b))
            case Mul(a, b):
                return Mul(simplify(a), simplify(b))
            case _:
                return e
