segments = [223.1, 24.7, 450.6, 472.6, 472.8]
times = [20.0, 7.4, 79.9, 8.4, 67.8]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = dist / elapsed
