00004213from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_set_difference(a, b):
    return a.difference(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
visits = ["ada", "dee", "bo", "ada", "ada", "ada", "ada", "bo", "dee"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in visits:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
freq = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(freq)))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, freq))))
sa = set([2, 4, 7, 15, 18, 19])
sb = set([2, 3, 7, 8, 13, 19])
print(_pf_sort(list(_pf_set_difference(sa, sb))))
print((len(sa), 6 in sb, _pf_set_is_subset(set([2]), sa)))
print((_pf_map_try_find("eli", freq), "eli" in freq))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(freq))))
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_square(x):
    return x * x
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs = [-3, 14, -2, -5, 21, 17, 28]
print(_pf_filter(functools.partial(Text_between, -5, 15), obs))
print(_pf_map(Text_square, obs))
print(Text_scaleAll(2, obs))
print(_pf_map(functools.partial(Text_clamp, 0, 14), obs))
entries = [Stock("rod", 18, 17.11), Stock("tap", 10, 14.86), Stock("wick", 1, 15.36), Stock("cap", 7, 2.63)]
def showRow(x):
    return f"{_pf_fmt_pad_right(10, " ", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(2, x.price)}"
_pf_iter(print, _pf_map(showRow, entries))
