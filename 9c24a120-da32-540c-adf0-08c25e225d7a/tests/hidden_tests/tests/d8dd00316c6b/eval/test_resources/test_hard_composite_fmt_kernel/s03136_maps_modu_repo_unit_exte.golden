print(f"{side} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(4))
