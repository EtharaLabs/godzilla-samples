00003910from dataclasses import dataclass
from functools import total_ordering
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Rest = Rest()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    def __repr__(self):
        return "Mark"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (3,)
_Mark = Mark()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    def __repr__(self):
        return f"Halt({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (4, self._0)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
def describe(t):
    match t:
        case Turn(2):
            return "turn-2"
        case Turn(n0):
            return f"turn({n0})"
        case Load(n0):
            return f"load({n0})"
        case Halt(s0):
            return f"halt({s0})"
        case Rest() | Mark():
            return "rest/mark"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Mark():
            return 8
        case Load(x0):
            return x0
        case _:
            return 0
queue = [Halt("kit"), _Rest, Turn(3), Load(2)]
print(_pf_map(describe, queue))
tally = _pf_sum_by(cost, queue)
print(f"tally={tally}")
print(_pf_sort(queue))
lines = [Line("rod", 17, 9.94), Line("bolt", 24, 12.75), Line("wick", 8, 3.82), Line("gear", 1, 38.74), Line("nut", 30, 23.15)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(9, ".", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {"restock" if x.qty > 4 else "ok"}"
_pf_iter(print, _pf_map(renderRow, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(55526))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(6, 13, 1))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [3, 51, 11]))
