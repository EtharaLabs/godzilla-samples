00002979from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([51, 51, 19, -18, -13]))
doubled = _pf_map(note, [51, 51, 19, -18])
print(f"{doubled} after {calls} calls")
print(_pf_map(math.isqrt, [334, 144, 274, 363]))
print(_pf_str_rev(str.upper("fay")))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [10, 9, 11, 10]))
lines = [Row("bolt", 26, 4.28), Row("gear", 30, 30.88), Row("rod", 8, 31.76), Row("cog", 30, 10.06)]
def showRow(x):
    return f"{_pf_fmt_pad_right(7, " ", x.name)}|{_pf_fmt_pad_left(4, " ", str(x.qty))}|{_pf_fmt_fixed(1, x.price)}"
_pf_iter(print, _pf_map(showRow, lines))
print(f"items: {_pf_str_join(", ", _pf_map(lambda x: x.name, lines))}")
text = "tap;oz;dee;rod;quin"
tokens = _pf_str_split(";", text)
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), tokens)))
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), tokens))
print(_pf_option_with_default("?", longest))
def row2(_pf_arg0):
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(6, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
def _pf_indexed(xs):
