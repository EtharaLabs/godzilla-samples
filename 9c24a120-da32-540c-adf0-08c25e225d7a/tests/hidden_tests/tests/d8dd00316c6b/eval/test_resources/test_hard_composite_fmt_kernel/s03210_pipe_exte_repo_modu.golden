00002578from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
data = [22, 25, 42, 35, 42, 26, 39, -4]
outcome = _pf_max(_pf_collect(lambda x: [x, x + 1], _pf_filter(lambda x: x % 4 == 1, (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(3, _pf_x)))(_pf_filter(lambda x: x > 9, _pf_rev(data))))))
print(outcome)
print(len(data))
print(_pf_map(math.isqrt, [308, 26, 385, 186]))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [12, 5, 5, 4]))
entries = [Row("tap", 18, 23.19), Row("gear", 25, 37.44), Row("hub", 11, 17.6), Row("bolt", 20, 3.6), Row("nut", 19, 26.05)]
def renderRow(x):
    return f"{_pf_fmt_pad_right(7, "-", x.name)}: {_pf_fmt_pad_left(4, " ", str(x.qty))}: {_pf_fmt_fixed(1, x.price)}: {"restock" if x.qty > 12 else "ok"}"
_pf_iter(print, _pf_map(renderRow, entries))
print(f"{len(entries)} rows, {_pf_str_upper("total")}={_pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, entries))}")
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_between(lo, hi, x):
    return lo <= x <= hi
nums = [-5, 1, -13, 15, 19, 12]
print(_pf_map(functools.partial(Text_clamp, 0, 17), nums))
print(Text_norm1(nums))
print(_pf_filter(functools.partial(Text_between, -4, 18), nums))
