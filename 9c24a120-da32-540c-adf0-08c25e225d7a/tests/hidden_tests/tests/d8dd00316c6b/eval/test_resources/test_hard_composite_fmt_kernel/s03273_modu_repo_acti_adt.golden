print(Calc_norm1(pts))
entries = [Stock("hub", 13, 11.62), Stock("nut", 4, 37.44), Stock("pin", 30, 12.46), Stock("gear", 28, 25.28), Stock("wick", 15, 18.21)]
def showRow(x):
    return f"{_pf_fmt_pad_right(8, ".", x.name)} {_pf_fmt_pad_left(4, " ", str(x.qty))} {_pf_fmt_fixed(1, x.price)} {_pf_fmt_currency("$", 2, x.price * 3.0)}"
_pf_iter(print, _pf_map(showRow, entries))
