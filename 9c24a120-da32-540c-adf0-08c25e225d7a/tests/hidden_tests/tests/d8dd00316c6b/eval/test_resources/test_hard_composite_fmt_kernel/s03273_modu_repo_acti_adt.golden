def explain(t):
    match t:
        case Rest(n0) if n0 % 2 == 0:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Load(s0):
            return f"load({s0})"
        case Turn(s0):
            return f"turn({s0})"
        case Pop():
            return f"pop"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
