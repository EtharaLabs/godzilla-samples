00003915from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: str
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    def __repr__(self):
        return "Pop"
_Pop = Pop()
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_square(x):
    return x * x
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [-7, 15, 7, -11]
