from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    def __repr__(self):
        return "Drop"
_Drop: Drop = Drop()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
Action = Skip | Push | Emit | Drop | Load
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip2:
    def __repr__(self):
        return "Skip2"
_Skip2: Skip2 = Skip2()
Delta = Put | Append | Skip2
def describe(t: Action) -> str:
    if isinstance(t, Skip):
        n0 = t._0
        if n0 % 2 == 0:
            return f"skip!({n0})"
    if isinstance(t, Skip):
        n0 = t._0
        return f"skip({n0})"
    else:
        if isinstance(t, Push):
            n0 = t._0
            if 0 <= n0 < 8:
                return f"push!({n0})"
        if isinstance(t, Push):
            n0 = t._0
            return f"push({n0})"
        else:
            if isinstance(t, Emit):
                n0 = t._0
                if n0 > 1:
                    return f"emit!({n0})"
            if isinstance(t, Emit):
                n0 = t._0
                return f"emit({n0})"
            elif isinstance(t, Drop):
                return f"drop"
            else:
                s0 = t._0
                return f"load({s0})"
def cost(t: Action) -> int:
    if isinstance(t, Emit):
        x0 = t._0
        return x0
    elif isinstance(t, Drop):
        return 1
    elif isinstance(t, Load):
        return 1
    elif isinstance(t, Push):
        x0 = t._0
        return x0
    else:
        return 2
queue: list[Action] = [Emit(8), Skip(9), Push(5), Emit(1), Load("gus")]
print(_pf_str_join("; ", _pf_map(describe, queue)))
tally: int = _pf_sum_by(cost, queue)
print(f"tally={tally}")
print((_pf_head(queue), _pf_last(queue)))
def replay(script: list[Delta]) -> tuple[dict[str, int], list[int]]:
    def fold1(acc: tuple[dict[str, int], list[int]], op: Delta) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Append):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Skip2():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script: list[Delta] = [Append(4), Append(5), Put("nut", 9), Put("cog", 7), Append(7), Put("nut", 8), _Skip2]
outcome: tuple[dict[str, int], list[int]] = replay(script)
mm, items = outcome
print((_pf_map_to_list(mm), items))
acc: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [4, 4, 5, 8])
print(acc)
def margin(price: int, qty: int) -> int:
    return price * qty - 5 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("bolt", 28, 4), ("wick", 8, 6), ("pin", 49, 1)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(8)([1, 2, 3]))
