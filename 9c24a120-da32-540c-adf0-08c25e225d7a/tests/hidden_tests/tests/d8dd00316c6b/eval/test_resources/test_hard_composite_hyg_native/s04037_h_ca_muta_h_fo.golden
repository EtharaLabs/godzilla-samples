from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Delta = Put | Append | Noop
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [0, 0, 7])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 5) + chatty(False, 8))
def quiet(x: int) -> int:
    return x + 9
print(mapTwice(quiet, [1]))
calls: int = 0
def note(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 4
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([13, -18, 20, 34, -7, -16, 5, 59]))
doubled: list[int] = _pf_map(note, [13, -18, 20, 34])
print(f"{doubled} after {calls} calls")
def step(acc: tuple[int, int], op: Delta) -> tuple[int, int]:
    puts = acc[0]
    total = acc[1]
    if isinstance(op, Put):
        v = op._1
        return (puts + 1, total + v)
    elif isinstance(op, Append):
        n = op._0
        return (puts, total + n)
    else:
        return acc
def runAll(script: list[Delta]) -> tuple[int, int]:
    return _pf_fold(step, (0, 0), script)
ops: list[Delta] = [Append(-1), _Noop, _Noop, Append(3), Put("cog", 7), Put("nut", 5), Put("cog", 9)]
outcome: tuple[int, int] = runAll(ops)
print(outcome)
