def step(m: dict[str, int], op: Delta) -> dict[str, int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
    elif isinstance(op, Append):
        n = op._0
        return _pf_map_add("pushed", n, m)
    else:
        return m
def execute(script: list[Delta]) -> dict[str, int]:
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Append(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
