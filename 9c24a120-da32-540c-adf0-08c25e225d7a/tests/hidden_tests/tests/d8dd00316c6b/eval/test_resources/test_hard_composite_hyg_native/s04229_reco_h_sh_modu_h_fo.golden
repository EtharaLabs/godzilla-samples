from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Change = Put | Append | Noop
book: list[Ticket] = [Ticket(100, "sue", 284, True, Site("Rome", 2)), Ticket(101, "max", 242, True, Site("Bern", 4)), Ticket(102, "sue", 27, False, Site("Riga", 1)), Ticket(103, "max", 33, True, Site("Bern", 3)), Ticket(104, "sue", 249, True, Site("Rome", 4)), Ticket(105, "max", 40, True, Site("Rome", 2))]
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Ticket(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
rerouted: list[Ticket] = _pf_map(_pf_fn0, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
print(_pf_max_by(lambda o: o.amount, book))
cheap, dear = _pf_partition(lambda o: o.amount < 154, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, sumAmt = _pf_fold(_pf_fn1, (0, 0), book)
print(f"{nrec} records, {sumAmt} total")
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by(lambda o: o.amount, book))))
def combine(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t3 = _pair
    else:
        _pf_t3 = 3
    r = _pf_t3
    return pair(r, 2)
print((combine(Some(3)), combine(_None_)))
def swapSum(pairs: list[tuple[int, int]]) -> list[int]:
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn2, pairs))
print(swapSum([(9, 7), (7, 3)]))
def step1(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def both(_pf_x: int) -> int:
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: step2(step1(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(both, [1, 9, 7]))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
obs: list[int] = [25, 19, 7, -4, -4, -2]
print(_pf_filter(functools.partial(Geo_between, -3, 20), obs))
print(Geo_mean(obs))
print(Geo_scaleAll(5, obs))
def step(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
    m = acc[0]
    xs = acc[1]
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return (_pf_map_add(k, v, m), xs)
    elif isinstance(op, Append):
        n = op._0
        return (m, _pf_concat(xs, [n]))
    else:
        return acc
def replay(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
changes: list[Change] = [_Noop, Put("nut", 1), Put("nut", 9), Put("nut", 3), Put("cog", 1)]
outcome: tuple[dict[str, int], list[int]] = replay(changes)
mm, items = outcome
print((_pf_map_to_list(mm), items))
