from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def margin(price: int, qty: int) -> int:
    return price * qty - 7 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("bolt", 17, 3), ("pin", 22, 4), ("wick", 46, 6)]))
print(grand)
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 6:
        return _Low()
    elif scaled < 36:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    _pf_t0 = _pf_str_split("=", s)
    if len(_pf_t0) == 2:
        k = _pf_t0[0]
        v = _pf_t0[1]
        _pf_t1 = _pf_str_to_int(v)
        if isinstance(_pf_t1, Some):
            n = _pf_t1._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def band(n: int) -> str:
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    elif isinstance(_pf_t2, _Mid):
        return "mid"
    elif isinstance(_pf_t2, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def grade(s: str) -> str:
    _pf_t3 = _ap_KeyVal(s)
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        return f"{_pf_fst(pair)}: {band(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(grade, ["ned", "max=4", "bo", "gus"]))
def inspect(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([39, 26, 13]))
events: list[str] = []
def logEvent(msg: str) -> int:
