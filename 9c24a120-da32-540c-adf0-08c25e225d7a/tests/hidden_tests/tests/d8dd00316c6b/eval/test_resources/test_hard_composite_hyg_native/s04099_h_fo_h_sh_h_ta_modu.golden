from dataclasses import dataclass
from typing import Any
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Instr = Put | Push | Noop
def apply(xs: list[int], op: Instr) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Push):
            n = op._0
            if n > 0:
                return _pf_concat(xs, [n * 10])
        return xs
def runAll(script: list[Instr]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 0:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
ops: list[Instr] = [_Noop, Push(1), Push(8), Put("gear", 7), Push(1), Put("cog", 8)]
outcome: list[int] = runAll(ops)
print(outcome)
acc: int = _pf_fold(lambda apply, x: apply + x * x, 0, [6, 8, 1, 1])
print(acc)
def combine(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t1 = _pair
    else:
        _pf_t1 = 2
    r = _pf_t1
    return pair(r, 6)
print((combine(Some(9)), combine(_None_)))
def swapSum(pairs: list[tuple[int, int]]) -> list[int]:
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn0(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn0, pairs))
print(swapSum([(6, 6), (3, 3)]))
def outer(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([8, 9, 8]))
def finished(acc):
    async def _pf_fn1():
        return acc
    return _pf_Async(_pf_fn1)
def spin(n: int, acc: int):
    async def _pf_fn2(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn2, n, acc)
print(asyncio.run(_pf_run(spin(2115, 0))))
def Geo_square(x):
    return x * x
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs: list[int] = [8, 6, -9, -3, 16]
print(_pf_map(Geo_square, obs))
print(Geo_norm1(obs))
print(Geo_scaleAll(4, obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 19), obs))
