def applyLift(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 0
    return applyLift(lift)
sample: int = _pf_fn0()
print((sample, applyLift(1)))
def combine(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 2
    r = _pf_t0
    return pair(r, 6)
print((combine(Some(3)), combine(_None_)))
def finished(acc):
    async def _pf_fn1():
        return acc
    return _pf_Async(_pf_fn1)
def countUp(n: int, acc: int):
    async def _pf_fn2(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn2, n, acc)
print(asyncio.run(_pf_run(countUp(2572, 0))))
def digits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await countUp(9, 0)
    return digits(a * 83033, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
