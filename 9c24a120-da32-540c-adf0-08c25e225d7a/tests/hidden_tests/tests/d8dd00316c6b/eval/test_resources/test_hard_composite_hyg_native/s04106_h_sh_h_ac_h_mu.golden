print((tweak(3, True), tweak(2, False)))
def lift(n: int) -> int:
    return n + 50
def useBump(x: int) -> int:
    return lift(x)
def _pf_fn0():
    lift = 7
    return useBump(lift)
probe: int = _pf_fn0()
print((probe, useBump(7)))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 7:
        return _Low()
    elif scaled < 25:
        return _Mid()
    else:
        return _High()
def grade(n: int) -> str:
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    if isinstance(_pf_t2, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t2, _Mid):
        return "mid"
    if isinstance(_pf_t2, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(grade, [-1, 29, 19, 27, 5]))
def audit(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(audit([11, 23, 12, 19]))
