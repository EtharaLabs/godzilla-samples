from dataclasses import dataclass
from typing import Any
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(countUp(2027, 0))))
def countDigits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await countUp(5, 0)
    return countDigits(a * 1154, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
def adjust(x: int, flag: bool) -> tuple[int, int]:
    y = x * 2
    if flag:
        _y = x + 273
        _pf_t0 = _y - 1
    else:
        _pf_t0 = y
    z = _pf_t0
    return (y, z)
print((adjust(2, True), adjust(2, False)))
def bump2(n: int) -> int:
    return n + 61
def applyLift(x: int) -> int:
    return bump2(x)
def _pf_fn3():
    bump2 = 5
    return applyLift(bump2)
sample: int = _pf_fn3()
print((sample, applyLift(8)))
def swapSum(pairs: list[tuple[int, int]]) -> list[int]:
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn4(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn4, pairs))
print(swapSum([(2, 9), (8, 3)]))
def wrap(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([6, 3, 8]))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [8, 2, 0])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 1) + chatty(False, 5))
def quiet(x: int) -> int:
    return x + 2
print(mapTwice(quiet, [4]))
