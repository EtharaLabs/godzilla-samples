@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: "Team"
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Status = Active | Parked | Gone
def promote(s: Status) -> Status:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 6:
                _pf_t1 = t
                return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
