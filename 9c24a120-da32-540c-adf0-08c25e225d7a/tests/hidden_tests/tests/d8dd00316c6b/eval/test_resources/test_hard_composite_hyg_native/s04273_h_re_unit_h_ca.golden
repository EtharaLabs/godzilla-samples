from dataclasses import dataclass
from typing import Any
import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Person:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Person"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Crew"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Slot = Active | Idle | Gone
def promote(s: Slot) -> Slot:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 4:
                _pf_t1 = t
                return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Slot] = _pf_map(promote, [Active(Person("ada", 60)), _Gone, _Gone, _Gone])
print(slots)
people: list[Person] = [Person("oz", 6), Person("kit", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
legs: list[float] = [468.3, 21.2, 208.3, 128.0, 17.9]
splits: list[float] = [32.0, 68.9, 31.5, 54.9, 44.8]
total: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed: float = total / dur
print(_pf_fmt_fixed(3, speed))
side: float = math.sqrt(2.25)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [4, 8, 5])
print(mapTwice(lambda x: x + 5, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 2) + chatty(False, 6))
def quiet(x: int) -> int:
    return x + 1
print(mapTwice(quiet, [3]))
