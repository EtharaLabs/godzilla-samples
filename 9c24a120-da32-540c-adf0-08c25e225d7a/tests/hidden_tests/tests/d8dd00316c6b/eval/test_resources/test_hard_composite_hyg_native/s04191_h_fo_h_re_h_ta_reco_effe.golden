from dataclasses import dataclass
from typing import Any
import functools
import asyncio
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_upper(s):
    return s.upper()
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Instr = Put | Append | Noop
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Member"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Club"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Slot = Active | Idle | Gone
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
def replay(script: list[Instr]) -> list[int]:
    def apply(xs: list[int], op: Instr) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Append):
                n = op._0
                if n > 0:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 0:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Instr] = [_Noop, Put("cog", 4), Put("gear", 5), Put("cog", 2), Put("gear", 3)]
final: list[int] = replay(changes)
print(final)
sumSq: int = _pf_fold(lambda apply, x: apply + x * x, 0, [9, 7, 5, 6])
print(sumSq)
def promote(s: Slot) -> Slot:
    if isinstance(s, Active):
        p = s._0
        _pf_t1 = p
        return Active(Member(_pf_t1.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 4:
                _pf_t2 = t
                return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Slot] = _pf_map(promote, [Active(Member("ivy", 20)), Idle(Club("pin", 3)), _Gone])
print(roster)
members: list[Member] = [Member("jo", 1), Member("ivy", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def spin(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(spin(1587, 0))))
book: list[Ticket] = [Ticket(100, "oz", 148, True), Ticket(101, "oz", 234, True), Ticket(102, "gus", 204, True), Ticket(103, "gus", 239, False), Ticket(104, "oz", 78, False)]
def adjust(o: Ticket) -> Ticket:
    if o.urgent:
        _pf_t3 = o
        return Ticket(_pf_t3.id, _pf_t3.owner, o.amount + 13, _pf_t3.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(adjust, book)))
def _pf_fn2(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn2, (0, 0), book)
print(f"{nrec} records, {amt} total")
def _pf_fn3(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
perOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn3, _pf_group_by(lambda o: o.owner, book))
print(perOwner)
def net(price: int, qty: int) -> int:
    return price * qty - 3 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn4(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall: int = sum(_pf_map(_pf_fn4, [("nut", 40, 6), ("cap", 45, 6), ("wick", 21, 4), ("pin", 36, 1)]))
print(overall)
