from dataclasses import dataclass
from typing import Any
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(countUp(2097, 0))))
def countDigits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await countUp(5, 0)
    return countDigits(a * 6693, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [7, 6, 9])
print(_pf_map(lambda g: g(5), makers))
def outer(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([8, 9, 5]))
def step1(x: int) -> int:
    return x + 1
def dbl(x: int) -> int:
    return x * 2
def both(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: dbl(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [8, 4, 4]))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [9, 2, 6])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 4) + chatty(False, 8))
def quiet(x: int) -> int:
    return x + 4
print(mapTwice(quiet, [6]))
legs: list[float] = [167.3, 78.9, 353.5, 317.6]
times: list[float] = [49.0, 35.9, 30.3, 88.1]
total: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
pace: float = total / dur
print(_pf_fmt_fixed(3, pace))
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
def _pf_fn3(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn3, _pf_zip(legs, times))
print(best)
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
