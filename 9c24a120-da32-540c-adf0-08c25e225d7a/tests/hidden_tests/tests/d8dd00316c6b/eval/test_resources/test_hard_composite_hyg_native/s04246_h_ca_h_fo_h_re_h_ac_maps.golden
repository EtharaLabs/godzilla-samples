def replay(script: list[Change]) -> dict[str, int]:
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
