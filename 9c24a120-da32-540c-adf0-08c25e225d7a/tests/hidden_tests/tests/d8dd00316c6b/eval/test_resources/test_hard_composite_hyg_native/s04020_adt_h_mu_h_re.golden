from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: str
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: str
    _1: str
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
Token = Rest | Pop | Push | Emit
