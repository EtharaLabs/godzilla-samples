        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Club"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Status = Active | Idle | Gone
def explain(t: Token) -> str:
    if isinstance(t, Rest):
        s0 = t._0
        return f"rest({s0})"
    else:
        if isinstance(t, Pop):
            n0 = t._0
            n1 = t._1
            if n0 % 2 == 0:
                return f"pop!({n0},{n1})"
        if isinstance(t, Pop):
            n0 = t._0
            n1 = t._1
            return f"pop({n0},{n1})"
        else:
            if isinstance(t, Push):
                n0 = t._0
                if n0 > 1:
                    return f"push!({n0})"
            if isinstance(t, Push):
                n0 = t._0
                return f"push({n0})"
            else:
                s0 = t._0
                s1 = t._1
                return f"emit({s0},{s1})"
def rank(t: Token) -> int:
    if isinstance(t, Pop):
        x0 = t._0
        x1 = t._1
        return x0 + x1
    elif isinstance(t, Emit):
        return 1
    else:
        return 3
prog: list[Token] = [Emit("eli", "ada"), Pop(12, 6), Push(9), Emit("lu", "ray")]
print(_pf_map(explain, prog))
tally: int = _pf_sum_by(rank, prog)
print(f"tally={tally}")
print(_pf_max_by(rank, prog))
def audit(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(audit([13, 7, 18, 39]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "jo", "stop"])
print((logged, counts))
def promote(s: Status) -> Status:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Member(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 6:
                _pf_t1 = t
                return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Status] = _pf_map(promote, [_Gone, Active(Member("ivy", 58)), _Gone])
print(slots)
