def accept(n: int) -> bool:
    return n > 13 and n % 2 != 0
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
def _pf_fn4(_pf_x):
    def _pf_fn5(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn5, _pf_indexed(_pf_x))
answer: int = len(_pf_filter(accept, _pf_fn1(_pf_fn4(_pf_take(8, values)))))
print(answer)
def inspect(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(inspect([29, 16, 5, 12]))
