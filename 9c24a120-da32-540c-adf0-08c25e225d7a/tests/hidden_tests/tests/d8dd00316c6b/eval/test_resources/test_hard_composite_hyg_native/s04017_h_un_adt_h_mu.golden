from dataclasses import dataclass
from typing import Any
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    _1: int
    def __repr__(self):
        return f"Store({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
Token = Pop | Mark | Store | Emit
reach: float = math.hypot(4.0 / 1.0, 2.0 / 1.0) * 1.0
factor: float = math.sqrt(2.0)
side: float = math.sqrt(16.0)
vol: float = math.cbrt(27.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(reach / 1.0))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 6.0)))
def describe(t: Token) -> str:
    if isinstance(t, Pop):
        s0 = t._0
        return f"pop({s0})"
    elif isinstance(t, Mark):
        n0 = t._0
        return f"mark({n0})"
    elif isinstance(t, Store):
        s0 = t._0
        n1 = t._1
        return f"store({s0},{n1})"
    elif isinstance(t, Emit) and t._0 == 3:
        return "emit-3"
    else:
        n0 = t._0
        return f"emit({n0})"
def rank(t: Token) -> int:
    if isinstance(t, Pop):
        return 4
    elif isinstance(t, Mark):
        x0 = t._0
        return x0 * 4
    elif isinstance(t, Store):
        x1 = t._1
        return x1
    else:
        return 3
prog: list[Token] = [Pop("jo"), Emit(12), Emit(12), Pop("max"), Store("pam", 3)]
print(_pf_map(describe, prog))
total: int = _pf_sum_by(rank, prog)
print(f"total={total}")
print((_pf_head(prog), _pf_last(prog)))
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([28, 35, 30, 7, 13]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "ada", "stop"])
print((events, counts))
