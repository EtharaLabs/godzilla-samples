import functools
import math
import math as mth
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def digitSum(n: int) -> int:
    if n == 0:
        return 0
    else:
        return n % 10 + digitSum(n // 10)
print(digitSum(46945))
def euclid(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(30, 181))
span: float = math.hypot(8.0 / 1.0, 8.0 / 1.0) * 1.0
ratio: float = math.sqrt(10.0)
side: float = math.sqrt(64.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(span / 1.0))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 7.0)))
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([5, 29, 14, 35, 7]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "ivy", "stop"])
print((logged, counts))
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_square(x):
    return x * x
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
obs: list[int] = [28, 12, -15, 6]
print(_pf_map(functools.partial(Calc_clamp, 0, 15), obs))
print(_pf_map(Calc_square, obs))
print(Calc_scaleAll(3, obs))
