from dataclasses import dataclass
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: str
    def __repr__(self):
        return f"Turn({self._0!r})"
    def __eq__(self, other):
        return type(other) is Turn and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
    def __eq__(self, other):
        return type(other) is Drop and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
    def __eq__(self, other):
        return type(other) is Store and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
Token = Turn | Drop | Store
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 9:
        return _Low()
    elif scaled < 35:
        return _Mid()
    else:
        return _High()
def label(n: int) -> str:
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
        return "mid"
    if isinstance(_pf_t0, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(label, [6, 0, 27, 18, 23]))
def explain(t: Token) -> str:
    if isinstance(t, Turn):
        s0 = t._0
        return f"turn({s0})"
    elif isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    else:
        if isinstance(t, Store):
            n0 = t._0
            if 0 <= n0 < 9:
                return f"store!({n0})"
        n0 = t._0
        return f"store({n0})"
def score(t: Token) -> int:
    if isinstance(t, Store):
        x0 = t._0
        return x0
    elif isinstance(t, Turn):
        return 9
    else:
        return 3
batch: list[Token] = [Drop(11), Store(3), Store(8), Turn("dee")]
_pf_iter(lambda t: print(explain(t)), batch)
grandSum: int = _pf_sum_by(score, batch)
print(f"grandSum={grandSum}")
print(_pf_sort(batch))
def margin(price: int, qty: int) -> int:
    return price * qty - 9 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("bolt", 22, 2), ("cog", 34, 6), ("nut", 35, 3), ("cog", 6, 6)]))
print(overall)
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
forEach(shout, [3, 9, 6])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 1) + chatty(False, 4))
def quiet(x: int) -> int:
    return x + 8
print(mapTwice(quiet, [9]))
