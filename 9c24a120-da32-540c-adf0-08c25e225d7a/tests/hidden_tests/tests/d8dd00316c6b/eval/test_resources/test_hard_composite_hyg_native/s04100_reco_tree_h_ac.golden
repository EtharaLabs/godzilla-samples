    amount: int
    urgent: bool
    dest: "Site"
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Term"
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
Term = Num | Add | Mul | Neg | Var
tickets: list[Order] = [Order(100, "sue", 78, False, Site("Oslo", 3)), Order(101, "sue", 283, False, Site("Lima", 1)), Order(102, "sue", 285, True, Site("Rome", 4)), Order(103, "sue", 64, True, Site("Bern", 3))]
