def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def scale(n: int) -> int:
    return n * 4
def _pf_fn0():
    _pf_t0 = [5, 2]
    if _pf_t0:
        scale = _pf_t0[0]
        return scale + 1
    else:
        return 0
picked: int = _pf_fn0()
print((picked, scale(7)))
def tweak(x: int, flag: bool) -> tuple[int, int]:
    y = x * 2
    if flag:
        _y = x + 124
        _pf_t1 = _y - 1
    else:
        _pf_t1 = y
    z = _pf_t1
    return (y, z)
print((tweak(7, True), tweak(9, False)))
def bump2(n: int) -> int:
    return n + 56
def applyLift(x: int) -> int:
    return bump2(x)
def _pf_fn1():
    bump2 = 9
    return applyLift(bump2)
probe: int = _pf_fn1()
print((probe, applyLift(8)))
def inc(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def pipeline2(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: step2(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(pipeline2, [1, 2, 3]))
hits: int = 0
def note(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 2
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([51, 5, 19, 14, -4, 50, 38, -5]))
doubled: list[int] = _pf_map(note, [51, 5, 19, 14])
print(f"{doubled} after {hits} calls")
def inspect(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(inspect([24, 30, 39, 32, 6]))
events: list[str] = []
def logEvent(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(logEvent, ["start", "cy", "stop"])
print((events, counts))
