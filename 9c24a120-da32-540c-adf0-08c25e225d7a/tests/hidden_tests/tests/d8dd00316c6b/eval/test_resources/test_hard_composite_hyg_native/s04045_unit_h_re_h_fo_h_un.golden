from dataclasses import dataclass
from typing import Any
import functools
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Person:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Person"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: "Crew"
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Status = Active | Parked | Gone
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Instr = Put | Push | Skip
laps: list[float] = [285.3, 375.7, 346.9]
durations: list[float] = [30.6, 20.0, 86.1]
total: float = _pf_fold(lambda a, b: a + b, 0.0, laps)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace: float = total / elapsed
print(_pf_fmt_fixed(2, pace))
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
side: float = math.sqrt(4.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(laps, durations))
print(best)
def promote(s: Status) -> Status:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 6:
                _pf_t1 = t
                return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Status] = _pf_map(promote, [_Gone, _Gone, _Gone])
print(slots)
people: list[Person] = [Person("tom", 7), Person("bo", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
def runAll(script: list[Instr]) -> list[int]:
    def fold1(acc, op):
        return acc
    def fold1(xs: list[int], op: Instr) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Push):
                n = op._0
                if n > 1:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 1:
                _pf_t2 = n * 10
                xs.append(_pf_t2)
            case _:
                pass
    return xs
changes: list[Instr] = [Push(4), Push(4), Push(4), _Skip, _Skip, Push(0), _Skip]
state: list[int] = runAll(changes)
print(state)
