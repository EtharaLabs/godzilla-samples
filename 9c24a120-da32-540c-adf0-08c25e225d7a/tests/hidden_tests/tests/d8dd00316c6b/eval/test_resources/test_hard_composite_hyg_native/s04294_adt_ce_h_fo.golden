print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), parsed))))
def fold1(m: dict[str, int], op: Change) -> dict[str, int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
    elif isinstance(op, Append):
        n = op._0
        return _pf_map_add("pushed", n, m)
    else:
        return m
def runAll(script: list[Change]) -> dict[str, int]:
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t2 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t2
            case Append(n):
                m["pushed"] = n
            case Skip2():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
ops: list[Change] = [_Skip2, Put("nut", 5), Append(1), Append(4), Put("nut", 7), _Skip2, Put("nut", 4)]
final: dict[str, int] = runAll(ops)
