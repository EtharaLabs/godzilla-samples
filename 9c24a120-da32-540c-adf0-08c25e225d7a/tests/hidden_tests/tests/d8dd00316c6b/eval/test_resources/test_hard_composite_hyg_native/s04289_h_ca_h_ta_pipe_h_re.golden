def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 9) + chatty(False, 5))
def quiet(x: int) -> int:
    return x + 2
print(mapTwice(quiet, [1]))
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await done(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(countUp(2772, 0))))
