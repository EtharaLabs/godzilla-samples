from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
_Emit: Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: int
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
Msg = Pop | Emit | Load | Turn
def render(t: Msg) -> str:
    if isinstance(t, Pop):
        n0 = t._0
        if n0 > 3:
            return f"pop!({n0})"
    if isinstance(t, Pop):
        n0 = t._0
        return f"pop({n0})"
    elif isinstance(t, Emit):
        return f"emit"
    elif isinstance(t, Load):
        s0 = t._0
        return f"load({s0})"
    else:
        if isinstance(t, Turn):
            n0 = t._0
            n1 = t._1
            if n0 > 5:
                return f"turn!({n0},{n1})"
        n0 = t._0
        n1 = t._1
        return f"turn({n0},{n1})"
def cost(t: Msg) -> int:
    if isinstance(t, Pop):
        x0 = t._0
        return x0 * 5
    elif isinstance(t, Emit):
        return 3
    else:
        return 3
stream: list[Msg] = [_Emit, Pop(1), Pop(0), Turn(12, 5), _Emit]
print(_pf_str_join(" ", _pf_map(render, stream)))
total: int = _pf_sum_by(cost, stream)
print(f"total={total}")
print((_pf_head(stream), _pf_last(stream)))
def combine(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 1
    r = _pf_t0
    return pair(r, 6)
print((combine(Some(4)), combine(_None_)))
def tweak(x: int, flag: bool) -> tuple[int, int]:
    y = x * 2
    if flag:
        _y = x + 257
        _pf_t1 = _y - 1
    else:
        _pf_t1 = y
    z = _pf_t1
    return (y, z)
print((tweak(6, True), tweak(1, False)))
def outer(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([9, 1, 9]))
def step1(x: int) -> int:
    return x + 1
def dbl(x: int) -> int:
    return x * 2
def both(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: dbl(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [3, 0, 1]))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [4, 1, 2])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 4) + chatty(False, 1))
def quiet(x: int) -> int:
    return x + 6
print(mapTwice(quiet, [1]))
