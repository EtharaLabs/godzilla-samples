def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 5:
        return _Low()
    elif scaled < 28:
        return _Mid()
    else:
        return _High()
def grade(n: int) -> str:
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    if isinstance(_pf_t2, _Mid):
        if n % 2 == 0:
