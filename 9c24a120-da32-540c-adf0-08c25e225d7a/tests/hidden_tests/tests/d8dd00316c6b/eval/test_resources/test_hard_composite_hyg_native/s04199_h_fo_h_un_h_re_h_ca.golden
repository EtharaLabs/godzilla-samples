from dataclasses import dataclass
from typing import Any
import functools
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Append | Noop
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Member"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: "Team"
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Seat = Active | Parked | Gone
def replay(script: list[Op]) -> tuple[dict[str, int], list[int]]:
    def apply(acc: tuple[dict[str, int], list[int]], op: Op) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Append):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops: list[Op] = [Put("nut", 8), _Noop, _Noop, Put("bolt", 8), Put("nut", 3)]
state: tuple[dict[str, int], list[int]] = replay(ops)
mm, items = state
print((_pf_map_to_list(mm), items))
sumSq: int = _pf_fold(lambda apply, x: apply + x * x, 0, [8, 2, 2, 9])
print(sumSq)
reach: float = math.hypot(8.0 / 1.0, 6.0 / 1.0) * 1.0
ratio: float = math.sqrt(2.0)
side: float = math.sqrt(64.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 5.0)))
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Member(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 6:
                _pf_t1 = t
                return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Seat] = _pf_map(promote, [_Gone, Parked(Team("hub", 1)), _Gone, Parked(Team("tap", 5)), Parked(Team("gear", 1))])
print(roster)
members: list[Member] = [Member("oz", 8), Member("dee", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [4, 2, 4])
print(mapTwice(lambda x: x + 5, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 4) + maybeLog(False, 7))
def quiet(x: int) -> int:
    return x + 8
print(mapTwice(quiet, [5]))
