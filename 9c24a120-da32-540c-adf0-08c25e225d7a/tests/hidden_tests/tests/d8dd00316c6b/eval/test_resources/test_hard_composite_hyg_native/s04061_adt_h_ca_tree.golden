from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    _1: str
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    _1: str
    def __repr__(self):
        return f"Jump({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
Move = Halt | Push | Jump | Skip | Drop
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Term"
    def __repr__(self):
        return f"Neg({self._0!r})"
Term = Num | Add | Mul | Neg
def show(t: Move) -> str:
    if isinstance(t, Halt) and t._0 == 2:
        return "halt-2"
    elif isinstance(t, Halt):
        n0 = t._0
        return f"halt({n0})"
    elif isinstance(t, Push):
        s0 = t._0
        s1 = t._1
        return f"push({s0},{s1})"
    elif isinstance(t, Jump):
        s0 = t._0
        s1 = t._1
        return f"jump({s0},{s1})"
    elif isinstance(t, Skip):
        return f"skip"
    else:
        if isinstance(t, Drop):
            n0 = t._0
            n1 = t._1
            if n0 % 2 == 0:
                return f"drop!({n0},{n1})"
        n0 = t._0
        n1 = t._1
        return f"drop({n0},{n1})"
def cost(t: Move) -> int:
    if isinstance(t, Skip):
        return 7
    elif isinstance(t, Jump):
        return 6
    elif isinstance(t, Push):
        return 8
    elif isinstance(t, Halt):
        x0 = t._0
        return x0 * 5
    else:
        return 3
stream: list[Move] = [Drop(-3, 4), _Skip, Jump("dee", "lu"), Halt(6), Halt(-2), Jump("pam", "quin")]
print(_pf_map(show, stream))
grandSum: int = _pf_sum_by(cost, stream)
print(f"grandSum={grandSum}")
print((_pf_head(stream), _pf_last(stream)))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [8, 0, 4])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 3) + chatty(False, 4))
def quiet(x: int) -> int:
    return x + 3
print(mapTwice(quiet, [3]))
def evalE(e: Term) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    else:
        a = e._0
        return -evalE(a)
def render(e: Term) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    else:
        a = e._0
        return f"-{render(a)}"
exprs: list[Term] = [Add(Neg(Mul(Num(-1), Num(5))), Neg(Num(9))), Num(-1), Neg(Neg(Add(Num(1), Num(1))))]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evalE, exprs))
