from dataclasses import dataclass
from typing import Any
import functools
import asyncio
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_str_join(sep, xs):
    return sep.join(xs)
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Instr = Put | Push | Noop
def apply(m: dict[str, int], op: Instr) -> dict[str, int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
    elif isinstance(op, Push):
        n = op._0
        return _pf_map_add("pushed", n, m)
    else:
        return m
def execute(script: list[Instr]) -> dict[str, int]:
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
