from dataclasses import dataclass
from typing import Any
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Member"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: "Crew"
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Slot = Active | Parked | Gone
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def promote(s: Slot) -> Slot:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Member(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 2:
                _pf_t1 = t
                return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Slot] = _pf_map(promote, [_Gone, _Gone, _Gone, Parked(Crew("hub", 2)), Parked(Crew("bolt", 6))])
print(slots)
people: list[Member] = [Member("tom", 8), Member("eli", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 7:
        return _Low()
    elif scaled < 24:
        return _Mid()
    else:
        return _High()
def grade(n: int) -> str:
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    if isinstance(_pf_t2, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t2, _Mid):
        return "mid"
    if isinstance(_pf_t2, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(grade, [5, -3, 14, 9, 30]))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [7, 4, 2])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 1) + maybeLog(False, 8))
def quiet(x: int) -> int:
    return x + 3
print(mapTwice(quiet, [8]))
def euclid(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(361, 300))
def steps(n: int, acc: int) -> int:
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [16, 25, 17]))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [15, 29, 22, 16, 19]))
