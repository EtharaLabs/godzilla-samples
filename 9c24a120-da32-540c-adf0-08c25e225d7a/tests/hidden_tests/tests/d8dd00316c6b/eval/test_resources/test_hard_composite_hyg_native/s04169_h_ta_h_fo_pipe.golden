from dataclasses import dataclass
from typing import Any
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Change = Put | Push | Skip
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def spin(n: int, acc: int):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 2
        k = await _pf_fn1()
        if n <= 0:
            return await done(acc)
        else:
            return await spin(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(spin(60, 0))))
def countDigits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await spin(7, 0)
    return countDigits(a * 18537, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
def fold1(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
    m = acc[0]
    xs = acc[1]
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return (_pf_map_add(k, v, m), xs)
    elif isinstance(op, Push):
        n = op._0
        return (m, _pf_concat(xs, [n]))
    else:
        return acc
def runAll(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script: list[Change] = [Push(4), Push(1), _Skip, Push(8)]
outcome: tuple[dict[str, int], list[int]] = runAll(script)
mm, items = outcome
print((_pf_map_to_list(mm), items))
readings: list[int] = [18, 44, 24, -3, 0, 36, 46, -3, 32, -6, 42]
def isBig(n: int) -> bool:
    return n > 2 and n % 5 != 0
outcome2: int = len(_pf_filter(isBig, _pf_collect(lambda x: [x, x + 1], _pf_drop(2, _pf_filter(lambda x: x % 2 == 1, _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), (lambda _pf_x: _pf_map(sum, _pf_chunk(4, _pf_x)))(readings)))))))
print(outcome2)
