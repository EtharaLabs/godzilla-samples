        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
Signal = Push | Skip | Load | Rest
def describe(t: Signal) -> str:
    if isinstance(t, Push):
        n0 = t._0
        return f"push({n0})"
    else:
        if isinstance(t, Skip):
            n0 = t._0
            if n0 > 6:
                return f"skip!({n0})"
        if isinstance(t, Skip):
            n0 = t._0
            return f"skip({n0})"
        elif isinstance(t, Load):
            s0 = t._0
            return f"load({s0})"
        else:
            if isinstance(t, Rest):
                n0 = t._0
                if n0 > 3:
                    return f"rest!({n0})"
            n0 = t._0
            return f"rest({n0})"
def rank(t: Signal) -> int:
    if isinstance(t, Load):
        return 3
    elif isinstance(t, Rest):
        x0 = t._0
        return x0 * 3
    else:
        return 2
stream: list[Signal] = [Rest(3), Rest(8), Rest(2), Push(-3), Skip(4)]
_pf_iter(lambda t: print(describe(t)), stream)
grandSum: int = _pf_sum_by(rank, stream)
print(f"grandSum={grandSum}")
print(_pf_max_by(rank, stream))
def inspect(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(inspect([5, 23, 22]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "kit", "stop"])
