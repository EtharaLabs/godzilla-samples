def replay(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    def apply(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Append):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
