from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_result_map_error(f, r):
    if isinstance(r, Error):
        return Error(f(r._0))
    return r
def _pf_result_to_option(r):
    if isinstance(r, Ok):
        return Some(r._0)
    return _None_
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
