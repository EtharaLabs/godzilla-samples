        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 2:
        return _Low()
    elif scaled < 32:
        return _Mid()
    else:
        return _High()
def describe(n: int) -> str:
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
        return "mid"
    if isinstance(_pf_t0, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(describe, [21, 22, 7, 18, 29]))
