from dataclasses import dataclass
from typing import Any
import functools
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Delta = Put | Push | Noop
def wrap(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([3, 7, 6]))
def cross(pairs: list[tuple[int, int]]) -> list[int]:
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn0(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn0, pairs))
print(cross([(7, 7), (2, 3)]))
def step1(x: int) -> int:
    return x + 1
def dbl(x: int) -> int:
    return x * 2
def pipeline2(_pf_x: int) -> int:
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: dbl(step1(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(pipeline2, [3, 1, 1]))
def bump2(n: int) -> int:
    return n + 35
def applyLift(x: int) -> int:
    return bump2(x)
def _pf_fn1():
    bump2 = 8
    return applyLift(bump2)
sample: int = _pf_fn1()
print((sample, applyLift(5)))
reach: float = math.hypot(3.0 / 1.0, 5.0 / 1.0) * 1.0
ratio: float = math.sqrt(3.0)
side: float = math.sqrt(9.0)
vol: float = math.cbrt(8.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(reach / 1.0))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 6.0)))
def execute(script: list[Delta]) -> tuple[int, int]:
    def step(acc, op):
        return acc
    def step(acc: tuple[int, int], op: Delta) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Push):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(step, (0, 0), script)
script: list[Delta] = [Push(0), _Noop, _Noop, _Noop, _Noop]
state: tuple[int, int] = execute(script)
print(state)
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [6, 8, 7, 8])
print(acc)
