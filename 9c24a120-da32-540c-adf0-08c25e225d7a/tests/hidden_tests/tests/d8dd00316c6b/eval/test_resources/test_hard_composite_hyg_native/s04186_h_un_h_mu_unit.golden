import functools
import math
import math as mth
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
reach: float = math.hypot(7.0 / 1.0, 4.0 / 1.0) * 1.0
factor: float = math.sqrt(5.0)
side: float = math.sqrt(49.0)
vol: float = math.cbrt(8.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(reach / 1.0))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 7.0)))
def audit(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(audit([32, 39, 4, 27, 25, 16]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "fay", "stop"])
print((logged, counts))
segments: list[float] = [48.3, 276.9, 216.5, 112.0]
durations: list[float] = [21.2, 35.2, 47.8, 74.0]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate: float = dist / elapsed
print(_pf_fmt_fixed(1, rate))
side2: float = math.sqrt(6.25)
cube: float = side2 * side2 * side2
print(f"{side2} {math.cbrt(cube)}")
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
mass: float = 16.0
accel: float = 5.5
push: float = mass * accel
limit: float = 224.0
print("over" if push > limit else "under")
