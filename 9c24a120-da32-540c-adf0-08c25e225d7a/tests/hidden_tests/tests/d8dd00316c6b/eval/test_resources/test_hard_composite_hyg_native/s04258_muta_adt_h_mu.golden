Msg = Emit | Halt | Drop | Push | Load
calls: int = 0
def note(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 2
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([42, 21, 5, 24, 46, 59]))
doubled: list[int] = _pf_map(note, [42, 21, 5, 24])
print(f"{doubled} after {calls} calls")
def explain(t: Msg) -> str:
    if isinstance(t, Emit):
        s0 = t._0
        return f"emit({s0})"
    elif isinstance(t, Drop) and t._0 == 0:
        return "drop-0"
    elif isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Load):
        s0 = t._0
        return f"load({s0})"
    elif isinstance(t, Halt):
        return "halt/push"
    else:
        return "halt/push"
def score(t: Msg) -> int:
    if isinstance(t, Load):
        return 7
    elif isinstance(t, Emit):
        return 7
    elif isinstance(t, Push):
        return 6
    elif isinstance(t, Drop):
        x0 = t._0
        return x0 * 2
    else:
        return 1
queue: list[Msg] = [_Push, _Push, Emit("dee"), Load("fay")]
print(_pf_str_join("; ", _pf_map(explain, queue)))
grandSum: int = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print(_pf_sort(queue))
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([35, 28, 3]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "ada", "stop"])
print((logged, counts))
