import asyncio
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
span: float = math.hypot(8.0 / 1.0, 2.0 / 1.0) * 1.0
factor: float = math.sqrt(5.0)
side: float = math.sqrt(64.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 8.0)))
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await done(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(countUp(2921, 0))))
def digits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await countUp(4, 0)
    return digits(a * 45033, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
def inspect(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([35, 31, 0]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "hal", "stop"])
print((events, counts))
