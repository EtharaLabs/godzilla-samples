from dataclasses import dataclass
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
    def __eq__(self, other):
        return type(other) is Halt and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
    def __eq__(self, other):
        return type(other) is Load and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Load: Load = Load()
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
    def __eq__(self, other):
        return type(other) is Mark and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __eq__(self, other):
        return type(other) is Skip and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (3, self._0)
Instr = Halt | Load | Mark | Skip
def render(t: Instr) -> str:
    if isinstance(t, Halt):
        n0 = t._0
        return f"halt({n0})"
    elif isinstance(t, Load):
        return f"load"
    else:
        if isinstance(t, Mark):
            n0 = t._0
            if n0 > 1:
                return f"mark!({n0})"
        if isinstance(t, Mark):
            n0 = t._0
            return f"mark({n0})"
        else:
            if isinstance(t, Skip):
                n0 = t._0
                if n0 % 2 == 0:
                    return f"skip!({n0})"
            n0 = t._0
            return f"skip({n0})"
def cost(t: Instr) -> int:
    if isinstance(t, Load):
        return 7
    else:
        return 1
prog: list[Instr] = [Halt(10), Halt(1), Mark(-1), Mark(2), Mark(12), Mark(5), Skip(-2)]
print(_pf_str_join(" ", _pf_map(render, prog)))
total: int = _pf_sum_by(cost, prog)
print(f"total={total}")
print(_pf_sort(prog))
def scan(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(scan([29, 12, 3, 30]))
events: list[str] = []
def logEvent(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(logEvent, ["start", "cy", "stop"])
print((events, counts))
reach: float = math.hypot(2.0 / 1.0, 5.0 / 1.0) * 1.0
ratio: float = math.sqrt(3.0)
side: float = math.sqrt(4.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 9.0)))
