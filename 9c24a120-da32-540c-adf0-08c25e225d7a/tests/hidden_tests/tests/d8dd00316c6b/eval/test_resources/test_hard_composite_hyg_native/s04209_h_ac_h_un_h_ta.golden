from dataclasses import dataclass
import asyncio
import math
import math as mth
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 10:
        return _Low()
    elif scaled < 25:
        return _Mid()
    else:
        return _High()
def label(n: int) -> str:
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
        return "mid"
    if isinstance(_pf_t0, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(label, [8, 24, 20, 30, 16]))
reach: float = math.hypot(6.0 / 1.0, 4.0 / 1.0) * 1.0
factor: float = math.sqrt(3.0)
side: float = math.sqrt(36.0)
vol: float = math.cbrt(27.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(reach / 1.0))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 8.0)))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n: int, acc: int):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 3
        k = await _pf_fn1()
        if n <= 0:
            return await finished(acc)
        else:
            return await loop(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(loop(10, 0))))
def digits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await loop(9, 0)
    return digits(a * 20071, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
