from dataclasses import dataclass
from typing import Any
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def spin(n: int, acc: int):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 2
        k = await _pf_fn1()
        if n <= 0:
            return await done(acc)
        else:
            return await spin(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(spin(8, 0))))
