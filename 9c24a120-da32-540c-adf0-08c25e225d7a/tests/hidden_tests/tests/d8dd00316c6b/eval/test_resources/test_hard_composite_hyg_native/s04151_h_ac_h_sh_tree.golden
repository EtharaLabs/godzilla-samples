_pf_iter(print, _pf_map(describe, ["eli=23", "quin=x", "fay=28", "gus"]))
adders = _pf_map(lambda k: lambda x: x * 10 + k, [5, 9, 5])
print(_pf_map(lambda g: g(5), adders))
def inc(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def pipeline2(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: step2(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(pipeline2, [1, 3, 9]))
def adjust(x: int, flag: bool) -> tuple[int, int]:
    y = x * 2
    if flag:
        _y = x + 169
        _pf_t3 = _y - 1
    else:
        _pf_t3 = y
    z = _pf_t3
    return (y, z)
print((adjust(3, True), adjust(2, False)))
def insert(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
tree: Tree = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [27, 50, 46, 51, 45])
def depthT(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        rt = t._2
        return 1 + max(depthT(l), depthT(rt))
print(depthT(tree))
def containsT(x: int, t: Tree) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
