from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_flip(f, x, y):
    return f(y, x)
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Tree"
    _1: int
    _2: "Tree"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Tree = Leaf | Node
def _ap_KeyVal(s):
    _pf_t0 = _pf_str_split("=", s)
    if len(_pf_t0) == 2:
        k = _pf_t0[0]
        v = _pf_t0[1]
        _pf_t1 = _pf_str_to_int(v)
        if isinstance(_pf_t1, Some):
            n = _pf_t1._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def describe(s: str) -> str:
    _pf_t2 = _ap_KeyVal(s)
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        if _pf_snd(pair) > 9:
            return f"{_pf_fst(pair)} big"
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        return f"{_pf_fst(pair)}={_pf_snd(pair)}"
