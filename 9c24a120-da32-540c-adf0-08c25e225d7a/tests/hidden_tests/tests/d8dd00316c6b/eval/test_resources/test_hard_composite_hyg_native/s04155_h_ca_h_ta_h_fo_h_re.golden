from dataclasses import dataclass
from typing import Any
import functools
import asyncio
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_upper(s):
    return s.upper()
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Instr = Put | Push | Skip
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Pilot"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: "Crew"
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Slot = Active | Parked | Gone
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [9, 6, 6])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 8) + chatty(False, 2))
def quiet(x: int) -> int:
    return x + 7
print(mapTwice(quiet, [9]))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(2476, 0))))
def execute(script: list[Instr]) -> tuple[int, int]:
    def apply(acc: tuple[int, int], op: Instr) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Push):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(apply, (0, 0), script)
script: list[Instr] = [Put("bolt", 7), _Skip, Push(0), Push(1)]
final: tuple[int, int] = execute(script)
print(final)
sumSq: int = _pf_fold(lambda apply, x: apply + x * x, 0, [1, 9, 6, 3])
print(sumSq)
def promote(s: Slot) -> Slot:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Pilot(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 3:
                _pf_t1 = t
                return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Slot] = _pf_map(promote, [Parked(Crew("cap", 3)), _Gone, Active(Pilot("gus", 56)), Parked(Crew("tap", 3)), Active(Pilot("gus", 59))])
print(roster)
people: list[Pilot] = [Pilot("quin", 3), Pilot("quin", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
