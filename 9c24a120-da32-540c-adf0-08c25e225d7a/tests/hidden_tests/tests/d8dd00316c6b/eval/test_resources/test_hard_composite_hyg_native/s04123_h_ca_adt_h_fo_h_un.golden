from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
_Jump: Jump = Jump()
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
_Rest: Rest = Rest()
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    def __repr__(self):
        return "Mark"
_Mark: Mark = Mark()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    _1: int
    def __repr__(self):
        return f"Load({self._0!r}, {self._1!r})"
Cmd = Skip | Jump | Rest | Mark | Load
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip2:
    def __repr__(self):
        return "Skip2"
_Skip2: Skip2 = Skip2()
Delta = Put | Append | Skip2
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [9, 5, 8])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 1) + maybeLog(False, 3))
def quiet(x: int) -> int:
    return x + 6
print(mapTwice(quiet, [9]))
def render(t: Cmd) -> str:
    if isinstance(t, Skip):
        s0 = t._0
        return f"skip({s0})"
    elif isinstance(t, Mark):
        return f"mark"
    elif isinstance(t, Load):
        s0 = t._0
        n1 = t._1
        return f"load({s0},{n1})"
    elif isinstance(t, Jump):
        return "jump/rest"
    else:
        return "jump/rest"
def rank(t: Cmd) -> int:
    if isinstance(t, Jump):
        return 4
    elif isinstance(t, Skip):
        return 3
    elif isinstance(t, Load):
        x1 = t._1
        return x1
    else:
        return 0
prog: list[Cmd] = [Load("dee", 1), _Rest, _Mark, Skip("quin"), _Mark, _Mark]
print(_pf_map(render, prog))
grandSum: int = _pf_sum_by(rank, prog)
print(f"grandSum={grandSum}")
print((_pf_head(prog), _pf_last(prog)))
def runAll(script: list[Delta]) -> list[int]:
    def step(xs: list[int], op: Delta) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Append):
                n = op._0
                if n > 5:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 5:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Delta] = [Put("nut", 8), _Skip2, _Skip2, _Skip2, Put("nut", 9), Put("nut", 8)]
state: list[int] = runAll(changes)
print(state)
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [9, 7, 3, 8])
print(acc)
span: float = math.hypot(9.0 / 1.0, 4.0 / 1.0) * 1.0
ratio: float = math.sqrt(10.0)
side: float = math.sqrt(81.0)
vol: float = math.cbrt(27.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 3.0)))
