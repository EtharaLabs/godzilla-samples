def runAll(script: list[Instr]) -> tuple[dict[str, int], list[int]]:
    def apply(acc, op):
        return acc
    def apply(acc: tuple[dict[str, int], list[int]], op: Instr) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Push):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
