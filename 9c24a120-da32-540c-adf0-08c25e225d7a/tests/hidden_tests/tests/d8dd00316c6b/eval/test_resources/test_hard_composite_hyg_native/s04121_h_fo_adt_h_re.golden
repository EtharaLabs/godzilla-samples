@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
Msg = Turn | Drop | Mark | Jump | Halt
@dataclass(frozen=True, slots=True)
