_Gone: Gone = Gone()
Slot = Active | Parked | Gone
def fold1(acc: tuple[dict[str, int], list[int]], op: Instr) -> tuple[dict[str, int], list[int]]:
    m = acc[0]
    xs = acc[1]
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return (_pf_map_add(k, v, m), xs)
    elif isinstance(op, Push):
        n = op._0
        return (m, _pf_concat(xs, [n]))
    else:
        return acc
def replay(script: list[Instr]) -> tuple[dict[str, int], list[int]]:
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops: list[Instr] = [Push(5), _Noop, _Noop, _Noop, Push(9), Put("cog", 2)]
final: tuple[dict[str, int], list[int]] = replay(ops)
mm, items = final
print((_pf_map_to_list(mm), items))
def show(t: Msg) -> str:
    if isinstance(t, Turn):
        n0 = t._0
        if n0 % 2 == 0:
            return f"turn!({n0})"
    if isinstance(t, Turn):
        n0 = t._0
        return f"turn({n0})"
    else:
        if isinstance(t, Drop):
            n0 = t._0
            if 0 <= n0 < 5:
                return f"drop!({n0})"
        if isinstance(t, Drop):
            n0 = t._0
            return f"drop({n0})"
        elif isinstance(t, Mark):
            n0 = t._0
            n1 = t._1
            return f"mark({n0},{n1})"
        else:
            if isinstance(t, Jump):
                n0 = t._0
                if n0 > 0:
                    return f"jump!({n0})"
            if isinstance(t, Jump):
                n0 = t._0
                return f"jump({n0})"
            else:
                if isinstance(t, Halt):
                    n0 = t._0
                    if n0 % 2 == 0:
                        return f"halt!({n0})"
                n0 = t._0
                return f"halt({n0})"
def cost(t: Msg) -> int:
    if isinstance(t, Jump):
        x0 = t._0
        return x0
    else:
        return 1
batch: list[Msg] = [Halt(9), Mark(2, 5), Turn(10), Jump(-1), Jump(2), Halt(2), Turn(3)]
_pf_iter(lambda t: print(show(t)), batch)
grandSum: int = _pf_sum_by(cost, batch)
print(f"grandSum={grandSum}")
print((_pf_head(batch), _pf_last(batch)))
def promote(s: Slot) -> Slot:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Parked):
            t = s._0
            if t.size > 4:
                _pf_t1 = t
                return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Slot] = _pf_map(promote, [Parked(Crew("rod", 2)), Parked(Crew("gear", 1)), Parked(Crew("nut", 9)), Parked(Crew("cog", 3)), _Gone])
print(roster)
people: list[Person] = [Person("dee", 2), Person("quin", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
