from dataclasses import dataclass
from typing import Any
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Op = Put | Append | Skip
def replay(script: list[Op]) -> list[int]:
    def apply(acc, op):
        return acc
    def apply(xs: list[int], op: Op) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Append):
                n = op._0
                if n > 4:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 4:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Op] = [_Skip, _Skip, Put("gear", 5), Put("nut", 2), _Skip, Append(5)]
state: list[int] = replay(changes)
print(state)
def scan(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(scan([25, 23, 20, 14, 9]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "kit", "stop"])
print((logged, counts))
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await done(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(countUp(185, 0))))
def digits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await countUp(3, 0)
    return digits(a * 54645, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
legs: list[float] = [202.7, 36.3, 189.5]
durations: list[float] = [47.3, 82.7, 47.3]
dist: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed: float = dist / elapsed
print(_pf_fmt_fixed(2, speed))
def _pf_fn3(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn3, _pf_zip(legs, durations))
print(best)
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
