from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
reach: float = math.hypot(9.0 / 1.0, 7.0 / 1.0) * 1.0
factor: float = math.sqrt(3.0)
side: float = math.sqrt(81.0)
vol: float = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 2.0)))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 3:
        return _Low()
    elif scaled < 24:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    _pf_t0 = _pf_str_split("=", s)
    if len(_pf_t0) == 2:
        k = _pf_t0[0]
        v = _pf_t0[1]
        _pf_t1 = _pf_str_to_int(v)
        if isinstance(_pf_t1, Some):
            n = _pf_t1._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def tier(n: int) -> str:
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    elif isinstance(_pf_t2, _Mid):
        return "mid"
    elif isinstance(_pf_t2, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def label(s: str) -> str:
    _pf_t3 = _ap_KeyVal(s)
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(label, ["gus=15", "hal=x", "fay=28", "ada=27"]))
segments: list[float] = [83.5, 381.9, 292.8, 134.9]
splits: list[float] = [71.6, 71.1, 45.5, 44.5]
dist: float = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate: float = dist / dur
print(_pf_fmt_fixed(1, rate))
speeds: list[float] = _pf_map2(lambda d, t: d / t, segments, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn0(_pf_arg0):
