from dataclasses import dataclass
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __eq__(self, other):
        return type(other) is Skip and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
    def __eq__(self, other):
        return type(other) is Pop and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
    def __eq__(self, other):
        return type(other) is Load and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Load: Load = Load()
Instr = Skip | Pop | Load
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip2:
    def __repr__(self):
        return "Skip2"
_Skip2: Skip2 = Skip2()
Delta = Put | Append | Skip2
def describe(t: Instr) -> str:
    if isinstance(t, Skip):
        n0 = t._0
        return f"skip({n0})"
    elif isinstance(t, Pop):
        n0 = t._0
        return f"pop({n0})"
    else:
        return f"load"
def score(t: Instr) -> int:
    if isinstance(t, Pop):
        x0 = t._0
        return x0
    else:
        return 1
queue: list[Instr] = [Skip(0), Pop(9), Skip(6), Pop(10), Pop(8)]
print(_pf_str_join("; ", _pf_map(describe, queue)))
grandSum: int = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print(_pf_sort(queue))
span: float = math.hypot(5.0 / 1.0, 8.0 / 1.0) * 1.0
factor: float = math.sqrt(2.0)
side: float = math.sqrt(25.0)
vol: float = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 6.0)))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [3, 3, 2])
print(mapTwice(lambda x: x + 5, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 3) + maybeLog(False, 1))
def quiet(x: int) -> int:
    return x + 8
print(mapTwice(quiet, [9]))
def runAll(script: list[Delta]) -> list[int]:
    def fold1(xs: list[int], op: Delta) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Append):
                n = op._0
                if n > 3:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 3:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Delta] = [Append(7), Put("nut", 6), _Skip2, Put("gear", 5), Put("nut", 1), Put("bolt", 4)]
final: list[int] = runAll(changes)
print(final)
