from dataclasses import dataclass
import functools
import math
import math as mth
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Change = Put | Push | Noop
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("1000101") + int("100", base=8))
print(_pf_map(math.isqrt, [181, 33, 180, 131]))
def replay(script: list[Change]) -> list[int]:
    def step(acc, op):
        return acc
    def step(xs: list[int], op: Change) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Push):
                n = op._0
                if n > 2:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 2:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Change] = [Put("nut", 1), _Noop, Put("nut", 5), Put("gear", 3), Push(0)]
outcome: list[int] = replay(changes)
print(outcome)
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [2, 4, 8, 3])
print(acc)
def audit(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(audit([8, 20, 25]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "max", "stop"])
print((logged, counts))
span: float = math.hypot(7.0 / 1.0, 4.0 / 1.0) * 1.0
factor: float = math.sqrt(5.0)
side: float = math.sqrt(49.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(span / 1.0))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 7.0)))
