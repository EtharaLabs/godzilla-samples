from dataclasses import dataclass
from typing import Any
import math
import math as mth
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Pilot"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Crew"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Slot = Active | Idle | Gone
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [7, 2, 7])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 5) + maybeLog(False, 5))
def quiet(x: int) -> int:
    return x + 7
print(mapTwice(quiet, [2]))
reach: float = math.hypot(4.0 / 1.0, 9.0 / 1.0) * 1.0
ratio: float = math.sqrt(3.0)
side: float = math.sqrt(16.0)
vol: float = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(reach / 1.0))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 5.0)))
def promote(s: Slot) -> Slot:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Pilot(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 5:
                _pf_t1 = t
                return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Slot] = _pf_map(promote, [_Gone, Active(Pilot("fay", 47)), Idle(Crew("cog", 3)), _Gone])
print(slots)
people: list[Pilot] = [Pilot("bo", 6), Pilot("eli", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
