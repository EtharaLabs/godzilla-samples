import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def scale(n: int) -> int:
    return n * 2
def _pf_fn0():
    _pf_t0 = [2, 2]
    if _pf_t0:
        scale = _pf_t0[0]
        return scale + 1
    else:
        return 0
chosen: int = _pf_fn0()
print((chosen, scale(6)))
def lift(n: int) -> int:
    return n + 83
def applyLift(x: int) -> int:
    return lift(x)
def _pf_fn1():
    lift = 7
    return applyLift(lift)
sample: int = _pf_fn1()
print((sample, applyLift(5)))
def outer(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([6, 1, 6]))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
nums: list[int] = [24, 18, 19, -7, -7, 24]
print(Calc_mean(nums))
print(_pf_filter(functools.partial(Calc_between, -5, 19), nums))
print(Calc_scaleAll(3, nums))
print(_pf_map(functools.partial(Calc_clamp, 0, 11), nums))
def inspect(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([15, 6, 7, 28]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "dee", "stop"])
print((logged, counts))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [0, 7, 3])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 3) + chatty(False, 2))
def quiet(x: int) -> int:
    return x + 3
print(mapTwice(quiet, [3]))
