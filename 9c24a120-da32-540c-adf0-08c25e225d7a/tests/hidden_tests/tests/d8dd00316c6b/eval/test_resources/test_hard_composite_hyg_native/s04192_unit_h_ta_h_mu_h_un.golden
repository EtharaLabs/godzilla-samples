import functools
import asyncio
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
legs: list[float] = [329.3, 76.8, 142.5, 57.3, 255.5]
durations: list[float] = [24.2, 53.3, 85.0, 42.7, 75.5]
dist: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed: float = dist / dur
print(_pf_fmt_fixed(3, speed))
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
side: float = math.sqrt(36.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(1739, 0))))
def digits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await loop(3, 0)
    return digits(a * 24281, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
def audit(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(audit([8, 27, 0, 34]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "ned", "stop"])
print((logged, counts))
reach: float = math.hypot(3.0 / 1.0, 6.0 / 1.0) * 1.0
ratio: float = math.sqrt(10.0)
side2: float = math.sqrt(9.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side2, vol))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 8.0)))
