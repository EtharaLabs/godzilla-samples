from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_result_map_error(f, r):
    if isinstance(r, Error):
        return Error(f(r._0))
    return r
def _pf_result_to_option(r):
    if isinstance(r, Ok):
        return Some(r._0)
    return _None_
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
def decodeLine(line: str) -> Ok | Error:
    def _pf_fn0():
        _pf_t1 = _pf_str_split("=", line)
        if len(_pf_t1) == 2:
            _k = _pf_t1[0]
            _v = _pf_t1[1]
            _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
        else:
            _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t3 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t3, Ok):
                n = _pf_t3._0
                _pf_t2 = Error("negative") if n < 0 else Ok(n)
                if isinstance(_pf_t2, Ok):
                    checked = _pf_t2._0
                    return Ok((k, checked))
                else:
                    return _pf_t2
            else:
                return _pf_t3
        else:
            return _pf_t0
    return _pf_fn0()
