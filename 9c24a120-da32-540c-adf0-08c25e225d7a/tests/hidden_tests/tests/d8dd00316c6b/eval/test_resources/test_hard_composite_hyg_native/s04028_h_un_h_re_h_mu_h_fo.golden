from dataclasses import dataclass
from typing import Any
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Person:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Person"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Team"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Seat = Active | Idle | Gone
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Append | Noop
span: float = math.hypot(9.0 / 1.0, 6.0 / 1.0) * 1.0
ratio: float = math.sqrt(2.0)
side: float = math.sqrt(81.0)
vol: float = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 7.0)))
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 4:
                _pf_t1 = t
                return Idle(Team(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Seat] = _pf_map(promote, [Active(Person("ned", 68)), Active(Person("pam", 22)), Active(Person("quin", 56)), Active(Person("ray", 63)), Active(Person("ivy", 46))])
print(slots)
people: list[Person] = [Person("max", 5), Person("kit", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
def inspect(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(inspect([7, 39, 21, 5, 9]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "dee", "stop"])
print((logged, counts))
def execute(script: list[Op]) -> tuple[dict[str, int], list[int]]:
    def step(acc, op):
        return acc
    def step(acc: tuple[dict[str, int], list[int]], op: Op) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Append):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops: list[Op] = [Put("bolt", 7), _Noop, Append(9), Append(5)]
final: tuple[dict[str, int], list[int]] = execute(ops)
mm, items = final
print((_pf_map_to_list(mm), items))
