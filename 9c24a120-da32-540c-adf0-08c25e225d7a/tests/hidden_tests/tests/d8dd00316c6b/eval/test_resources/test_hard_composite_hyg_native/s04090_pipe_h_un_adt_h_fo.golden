from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
_Rest: Rest = Rest()
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    def __repr__(self):
        return "Pop"
_Pop: Pop = Pop()
Move = Halt | Rest | Pop
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Op = Put | Append | Skip
samples: list[int] = [30, -1, 27, 11, -8, 1, 42]
stage = lambda _pf_x: _pf_take(6, (lambda _pf_x: _pf_map(lambda x: x // 3 + x % 3, (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))(_pf_x)))(_pf_x))
result: Some | None_ = _pf_max(stage(samples))
print(result)
span: float = math.hypot(8.0 / 1.0, 5.0 / 1.0) * 1.0
ratio: float = math.sqrt(2.0)
side: float = math.sqrt(64.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 2.0)))
def describe(t: Move) -> str:
    if isinstance(t, Halt):
        s0 = t._0
        return f"halt({s0})"
    elif isinstance(t, Rest):
        return f"rest"
    else:
        return f"pop"
def score(t: Move) -> int:
    if isinstance(t, Halt):
        return 1
    else:
        return 3
stream: list[Move] = [_Rest, _Rest, Halt("ray"), Halt("bo"), Halt("cy"), _Rest]
_pf_iter(lambda t: print(describe(t)), stream)
tally: int = _pf_sum_by(score, stream)
print(f"tally={tally}")
print((_pf_head(stream), _pf_last(stream)))
def execute(script: list[Op]) -> dict[str, int]:
    def step(m: dict[str, int], op: Op) -> dict[str, int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        elif isinstance(op, Append):
            n = op._0
            return _pf_map_add("pushed", n, m)
        else:
            return m
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Append(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
ops: list[Op] = [Put("bolt", 4), Append(7), Put("nut", 8), _Skip]
final: dict[str, int] = execute(ops)
print(_pf_map_to_list(final))
sumSq: int = _pf_fold(lambda step, x: step + x * x, 0, [6, 7, 1, 8])
print(sumSq)
