from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Change = Put | Push | Skip
parcels: list[Parcel] = [Parcel(100, "quin", 272, False), Parcel(101, "gus", 28, True), Parcel(102, "ada", 246, False), Parcel(103, "quin", 94, False), Parcel(104, "ada", 263, True), Parcel(105, "ada", 44, False)]
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn0, (0, 0), parcels)
print(f"{cnt} records, {amt} total")
def bump2(o: Parcel) -> Parcel:
    if o.urgent:
        _pf_t0 = o
        return Parcel(_pf_t0.id, _pf_t0.owner, o.amount + 17, _pf_t0.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(bump2, parcels)))
def classify(o: Parcel) -> str:
    if isinstance(o, Parcel) and o.urgent is True:
        amount = o.amount
        if amount > 101:
            return "rush-big"
    if isinstance(o, Parcel) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 101:
            return "big"
        else:
            return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def replay(script: list[Change]) -> tuple[dict[str, int], list[int]]:
    def fold1(acc: tuple[dict[str, int], list[int]], op: Change) -> tuple[dict[str, int], list[int]]:
        m = acc[0]
        xs = acc[1]
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return (_pf_map_add(k, v, m), xs)
        elif isinstance(op, Push):
            n = op._0
            return (m, _pf_concat(xs, [n]))
        else:
            return acc
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
changes: list[Change] = [Put("gear", 2), Push(0), Push(8), Push(6), Push(4)]
state: tuple[dict[str, int], list[int]] = replay(changes)
mm, items = state
print((_pf_map_to_list(mm), items))
acc: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [1, 2, 3, 4])
print(acc)
def swapSum(pairs: list[tuple[int, int]]) -> list[int]:
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn1(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn1, pairs))
print(swapSum([(2, 7), (4, 3)]))
def lift(n: int) -> int:
    return n + 47
def applyLift(x: int) -> int:
    return lift(x)
def _pf_fn2():
    lift = 2
    return applyLift(lift)
sample: int = _pf_fn2()
print((sample, applyLift(3)))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [7, 2, 3])
print(_pf_map(lambda g: g(1), makers))
def tweak(x: int, flag: bool) -> tuple[int, int]:
    y = x * 2
    if flag:
        _y = x + 589
        _pf_t1 = _y - 1
    else:
        _pf_t1 = y
    z = _pf_t1
    return (y, z)
print((tweak(6, True), tweak(2, False)))
