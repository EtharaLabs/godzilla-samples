def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 7:
        return _Low()
    elif scaled < 38:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    _pf_t0 = _pf_str_split("=", s)
    if len(_pf_t0) == 2:
        k = _pf_t0[0]
        v = _pf_t0[1]
        _pf_t1 = _pf_str_to_int(v)
        if isinstance(_pf_t1, Some):
            n = _pf_t1._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def tier(n: int) -> str:
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    elif isinstance(_pf_t2, _Mid):
        return "mid"
    elif isinstance(_pf_t2, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def describe(s: str) -> str:
    _pf_t3 = _ap_KeyVal(s)
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(describe, ["ned=x", "pam=8", "dee=x", "hal=x"]))
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await done(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
