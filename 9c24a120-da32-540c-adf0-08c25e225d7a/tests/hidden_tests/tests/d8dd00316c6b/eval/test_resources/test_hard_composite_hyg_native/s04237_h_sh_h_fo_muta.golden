def lift(n: int) -> int:
    return n + 16
def applyLift(x: int) -> int:
    return lift(x)
def _pf_fn1():
    lift = 7
    return applyLift(lift)
sample: int = _pf_fn1()
print((sample, applyLift(6)))
def replay(script: list[Change]) -> list[int]:
    def step(xs: list[int], op: Change) -> list[int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_concat(xs, [v])
        else:
            if isinstance(op, Append):
                n = op._0
                if n > 1:
                    return _pf_concat(xs, [n * 10])
            return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 1:
                _pf_t2 = n * 10
                xs.append(_pf_t2)
            case _:
                pass
    return xs
ops: list[Change] = [Put("bolt", 7), Put("bolt", 6), Put("nut", 5), _Skip]
outcome: list[int] = replay(ops)
print(outcome)
ticks: int = 0
def track(x: int) -> int:
    global ticks
    ticks = ticks + 1
    return x * 2
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-17, 19, -19, 58]))
doubled: list[int] = _pf_map(track, [-17, 19, -19, 58])
print(f"{doubled} after {ticks} calls")
