from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [8, 9, 6])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 8) + maybeLog(False, 9))
def quiet(x: int) -> int:
    return x + 4
print(mapTwice(quiet, [8]))
laps: list[float] = [58.7, 215.2, 240.4]
durations: list[float] = [31.8, 21.7, 25.6]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace: float = dist / elapsed
print(_pf_fmt_fixed(3, pace))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(laps, durations))
print(best)
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def merge(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 0
    r = _pf_t0
    return pair(r, 3)
print((merge(Some(1)), merge(_None_)))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [1, 7, 9])
print(_pf_map(lambda g: g(3), makers))
def inc(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def pipeline2(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: step2(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(pipeline2, [3, 8, 6]))
def scale(n: int) -> int:
    return n * 4
def _pf_fn1():
    _pf_t1 = [5, 2]
    if _pf_t1:
        scale = _pf_t1[0]
        return scale + 1
    else:
        return 0
chosen: int = _pf_fn1()
print((chosen, scale(7)))
