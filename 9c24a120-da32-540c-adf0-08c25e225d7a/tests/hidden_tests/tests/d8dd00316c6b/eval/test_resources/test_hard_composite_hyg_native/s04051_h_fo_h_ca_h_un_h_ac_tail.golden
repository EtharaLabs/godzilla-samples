from dataclasses import dataclass
import functools
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Delta = Put | Append | Noop
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def step(xs: list[int], op: Delta) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Append):
            n = op._0
            if n > 1:
                return _pf_concat(xs, [n * 10])
        return xs
def runAll(script: list[Delta]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 1:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Delta] = [_Noop, _Noop, Append(5), _Noop, Put("cog", 4), Append(3)]
state: list[int] = runAll(changes)
print(state)
sumSq: int = _pf_fold(lambda step, x: step + x * x, 0, [2, 3, 9, 2])
print(sumSq)
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
forEach(shout, [0, 6, 9])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 9) + maybeLog(False, 3))
def quiet(x: int) -> int:
    return x + 1
print(mapTwice(quiet, [4]))
reach: float = math.hypot(8.0 / 1.0, 3.0 / 1.0) * 1.0
factor: float = math.sqrt(10.0)
side: float = math.sqrt(64.0)
vol: float = math.cbrt(8.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 4.0)))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 1:
        return _Low()
    elif scaled < 30:
        return _Mid()
    else:
        return _High()
def describe(n: int) -> str:
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    if isinstance(_pf_t1, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t1, _Mid):
        return "mid"
    if isinstance(_pf_t1, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(describe, [0, 29, 22, 17, 28]))
def countDown(n: int, acc: int) -> int:
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(458, 0))
def gcdLoop(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(404, 350))
