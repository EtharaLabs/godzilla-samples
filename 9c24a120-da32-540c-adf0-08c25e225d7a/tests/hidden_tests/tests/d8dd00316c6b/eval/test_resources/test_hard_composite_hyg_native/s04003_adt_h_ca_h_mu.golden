from dataclasses import dataclass
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    def __repr__(self):
        return "Drop"
_Drop: Drop = Drop()
Instr = Push | Skip | Mark | Drop
def render(t: Instr) -> str:
    if isinstance(t, Push):
        n0 = t._0
        if n0 > 3:
            return f"push!({n0})"
    if isinstance(t, Push):
        n0 = t._0
        return f"push({n0})"
    elif isinstance(t, Skip):
        s0 = t._0
        return f"skip({s0})"
    elif isinstance(t, Mark):
        n0 = t._0
        return f"mark({n0})"
    else:
        return f"drop"
def cost(t: Instr) -> int:
    if isinstance(t, Drop):
        return 1
    elif isinstance(t, Mark):
        x0 = t._0
        return x0
    elif isinstance(t, Push):
        x0 = t._0
        return x0 * 5
    else:
        return 2
stream: list[Instr] = [Skip("ivy"), _Drop, Mark(0), _Drop, Push(1), Push(-1)]
print(_pf_map(render, stream))
tally: int = _pf_sum_by(cost, stream)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: cost(t) > 4, stream)))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
forEach(shout, [0, 3, 4])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 6) + maybeLog(False, 9))
def quiet(x: int) -> int:
    return x + 5
print(mapTwice(quiet, [6]))
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([21, 7, 21, 19]))
events: list[str] = []
def push2(msg: str) -> int:
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts: list[int] = _pf_map(push2, ["start", "gus", "stop"])
print((events, counts))
