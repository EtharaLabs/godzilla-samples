from dataclasses import dataclass
from typing import Any
import functools
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Delta = Put | Append | Skip
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
reach: float = math.hypot(5.0 / 1.0, 5.0 / 1.0) * 1.0
ratio: float = math.sqrt(2.0)
side: float = math.sqrt(25.0)
vol: float = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(reach / 1.0))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 3.0)))
def apply(m: dict[str, int], op: Delta) -> dict[str, int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
    elif isinstance(op, Append):
        n = op._0
        return _pf_map_add("pushed", n, m)
    else:
        return m
def runAll(script: list[Delta]) -> dict[str, int]:
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Append(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
script: list[Delta] = [_Skip, Append(2), _Skip, _Skip, _Skip]
state: dict[str, int] = runAll(script)
print(_pf_map_to_list(state))
acc: int = _pf_fold(lambda apply, x: apply + x * x, 0, [2, 8, 4, 4])
print(acc)
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 6:
        return _Low()
    elif scaled < 32:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    _pf_t1 = _pf_str_split("=", s)
    if len(_pf_t1) == 2:
        k = _pf_t1[0]
        v = _pf_t1[1]
        _pf_t2 = _pf_str_to_int(v)
        if isinstance(_pf_t2, Some):
            n = _pf_t2._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def tier(n: int) -> str:
    _pf_t3 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t3, _Low):
        return "low"
    elif isinstance(_pf_t3, _Mid):
        return "mid"
    elif isinstance(_pf_t3, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def label(s: str) -> str:
    _pf_t4 = _ap_KeyVal(s)
    if isinstance(_pf_t4, Some):
        pair = _pf_t4._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t4, Some):
        pair = _pf_t4._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(label, ["sue", "pam=-1", "eli=x", "cy=1"]))
