from dataclasses import dataclass
from typing import Any
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Pilot"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Crew"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Seat = Active | Idle | Gone
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: str
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    def __repr__(self):
        return "Mark"
_Mark: Mark = Mark()
Action = Drop | Push | Turn | Rest | Mark
def promote(s: Seat) -> Seat:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Pilot(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 2:
                _pf_t1 = t
                return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
slots: list[Seat] = _pf_map(promote, [Active(Pilot("max", 65)), Active(Pilot("sue", 26)), Active(Pilot("pam", 55)), Active(Pilot("ned", 35)), Active(Pilot("pam", 26))])
print(slots)
people: list[Pilot] = [Pilot("ada", 5), Pilot("hal", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
span: float = math.hypot(2.0 / 1.0, 4.0 / 1.0) * 1.0
factor: float = math.sqrt(2.0)
side: float = math.sqrt(4.0)
vol: float = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 2.0)))
def explain(t: Action) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        if n0 > 1:
            return f"drop!({n0})"
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Push):
        s0 = t._0
        return f"push({s0})"
    elif isinstance(t, Turn):
        n0 = t._0
        s1 = t._1
        return f"turn({n0},{s1})"
    else:
        if isinstance(t, Rest):
            n0 = t._0
            if n0 % 2 == 0:
                return f"rest!({n0})"
        if isinstance(t, Rest):
            n0 = t._0
            return f"rest({n0})"
        else:
            return f"mark"
def score(t: Action) -> int:
    if isinstance(t, Push):
        return 4
    elif isinstance(t, Mark):
        return 2
    else:
        return 3
prog: list[Action] = [Drop(8), Turn(-2, "pam"), Push("ada"), Drop(3), Drop(-2)]
print(_pf_str_join("; ", _pf_map(explain, prog)))
total: int = _pf_sum_by(score, prog)
print(f"total={total}")
print(_pf_max_by(score, prog))
