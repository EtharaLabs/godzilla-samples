from dataclasses import dataclass
from typing import Any
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
_Halt: Halt = Halt()
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: str
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    _1: int
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
Move = Emit | Halt | Turn | Load | Mark
def _ap_KeyVal(s):
    _pf_t0 = _pf_str_split("=", s)
    if len(_pf_t0) == 2:
        k = _pf_t0[0]
        v = _pf_t0[1]
        _pf_t1 = _pf_str_to_int(v)
        if isinstance(_pf_t1, Some):
            n = _pf_t1._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def label(s: str) -> str:
    _pf_t2 = _ap_KeyVal(s)
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        if _pf_snd(pair) > 9:
            return f"{_pf_fst(pair)} big"
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        return f"{_pf_fst(pair)}={_pf_snd(pair)}"
    return "?"
_pf_iter(print, _pf_map(label, ["ray=x", "oz=6", "lu=x", "fay=x"]))
def explain(t: Move) -> str:
    if isinstance(t, Emit) and t._0 == 0:
        return "emit-0"
    elif isinstance(t, Emit):
        n0 = t._0
        return f"emit({n0})"
    elif isinstance(t, Halt):
        return f"halt"
    elif isinstance(t, Turn):
        s0 = t._0
        return f"turn({s0})"
    else:
        if isinstance(t, Load):
            n0 = t._0
            if n0 % 2 == 0:
                return f"load!({n0})"
        if isinstance(t, Load):
            n0 = t._0
            return f"load({n0})"
        else:
            s0 = t._0
            n1 = t._1
            return f"mark({s0},{n1})"
def rank(t: Move) -> int:
    if isinstance(t, Halt):
        return 7
    elif isinstance(t, Load):
        x0 = t._0
        return x0
    else:
        return 3
stream: list[Move] = [Mark("fay", 5), Load(6), Mark("ned", 1), _Halt, Emit(-1), Turn("jo")]
print(_pf_map(explain, stream))
total: int = _pf_sum_by(rank, stream)
print(f"total={total}")
print(_pf_max_by(rank, stream))
span: float = math.hypot(5.0 / 1.0, 3.0 / 1.0) * 1.0
factor: float = math.sqrt(2.0)
side: float = math.sqrt(25.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
