from dataclasses import dataclass
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Change = Put | Push | Noop
calls: int = 0
def note(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 2
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([31, 26, 48, 55, 47]))
doubled: list[int] = _pf_map(note, [31, 26, 48, 55])
print(f"{doubled} after {calls} calls")
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [0, 5, 7])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 3) + maybeLog(False, 3))
def quiet(x: int) -> int:
    return x + 1
print(mapTwice(quiet, [2]))
def replay(script: list[Change]) -> dict[str, int]:
    def step(m: dict[str, int], op: Change) -> dict[str, int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        elif isinstance(op, Push):
            n = op._0
            return _pf_map_add("pushed", n, m)
        else:
            return m
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
script: list[Change] = [Push(1), Push(2), Push(0), Put("nut", 8)]
outcome: dict[str, int] = replay(script)
print(_pf_map_to_list(outcome))
