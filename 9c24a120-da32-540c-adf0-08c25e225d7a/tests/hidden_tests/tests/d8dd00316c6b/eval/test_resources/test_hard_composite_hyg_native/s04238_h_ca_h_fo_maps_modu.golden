from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_set_intersect(a, b):
    return a.intersection(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Instr = Put | Append | Skip
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
forEach(shout, [1, 3, 4])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 2) + maybeLog(False, 4))
def quiet(x: int) -> int:
    return x + 6
print(mapTwice(quiet, [5]))
def replay(script: list[Instr]) -> dict[str, int]:
    def step(m: dict[str, int], op: Instr) -> dict[str, int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        elif isinstance(op, Append):
            n = op._0
            return _pf_map_add("pushed", n, m)
        else:
            return m
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Append(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
changes: list[Instr] = [Put("gear", 1), Append(9), Append(-2), Append(5), _Skip, Append(5)]
state: dict[str, int] = replay(changes)
print(_pf_map_to_list(state))
events: list[str] = ["ada", "ada", "bo", "dee", "eli", "cy", "bo"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in events:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t1 = n + 1
            m[w] = _pf_t1
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
hist: dict[str, int] = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(hist)))
print(len(_pf_map_filter(lambda k, v: v > 1, hist)))
sa: set[int] = set([2, 4, 9, 10, 12, 18])
sb: set[int] = set([1, 3, 5, 6, 15, 18])
print(_pf_sort(list(_pf_set_intersect(sa, sb))))
print((len(sa), 20 in sb, _pf_set_is_subset(set([2]), sa)))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs: list[int] = [24, 28, 12, 26]
print(Calc_scaleAll(3, obs))
print(Calc_norm1(obs))
print(Calc_mean(obs))
