from dataclasses import dataclass
import functools
import math
import math as mth
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Op = Put | Append | Skip
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_square(x):
    return x * x
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
nums: list[int] = [22, 4, -13, 16, 28, 8]
print(Stats_norm1(nums))
print(_pf_filter(functools.partial(Stats_between, 2, 12), nums))
print(_pf_map(Stats_square, nums))
print(_pf_map(functools.partial(Stats_clamp, 0, 19), nums))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [5, 3, 4])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 2) + chatty(False, 4))
def quiet(x: int) -> int:
    return x + 8
print(mapTwice(quiet, [6]))
def replay(script: list[Op]) -> tuple[int, int]:
    def fold1(acc, op):
        return acc
    def fold1(acc: tuple[int, int], op: Op) -> tuple[int, int]:
        puts = acc[0]
        total = acc[1]
        if isinstance(op, Put):
            v = op._1
            return (puts + 1, total + v)
        elif isinstance(op, Append):
            n = op._0
            return (puts, total + n)
        else:
            return acc
    return _pf_fold(fold1, (0, 0), script)
script: list[Op] = [_Skip, Append(8), Append(0), Put("nut", 3), _Skip, _Skip, Put("nut", 9)]
final: tuple[int, int] = replay(script)
print(final)
acc: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [6, 3, 4, 8])
print(acc)
reach: float = math.hypot(7.0 / 1.0, 2.0 / 1.0) * 1.0
ratio: float = math.sqrt(10.0)
side: float = math.sqrt(49.0)
vol: float = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(reach / 1.0))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 6.0)))
