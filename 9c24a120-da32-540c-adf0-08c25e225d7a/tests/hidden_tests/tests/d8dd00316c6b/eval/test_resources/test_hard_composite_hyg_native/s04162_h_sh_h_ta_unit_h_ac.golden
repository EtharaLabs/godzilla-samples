from dataclasses import dataclass
import functools
import asyncio
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def step1(x: int) -> int:
    return x + 1
def dbl(x: int) -> int:
    return x * 2
def both(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: dbl(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [8, 7, 9]))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [1, 5, 7])
print(_pf_map(lambda g: g(4), makers))
def tweak(x: int, flag: bool) -> tuple[int, int]:
    y = x * 2
    if flag:
        _y = x + 458
        _pf_t0 = _y - 1
    else:
        _pf_t0 = y
    z = _pf_t0
    return (y, z)
print((tweak(2, True), tweak(6, False)))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n: int, acc: int):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 3
        k = await _pf_fn1()
        if n <= 0:
            return await finished(acc)
        else:
            return await countUp(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(countUp(50, 0))))
legs: list[float] = [138.0, 357.5, 450.6, 246.5, 420.7]
durations: list[float] = [61.7, 62.3, 49.6, 37.6, 20.1]
total: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace: float = total / elapsed
print(_pf_fmt_fixed(3, pace))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 9:
        return _Low()
    elif scaled < 31:
        return _Mid()
    else:
        return _High()
def describe(n: int) -> str:
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    if isinstance(_pf_t1, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t1, _Mid):
        return "mid"
    if isinstance(_pf_t1, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(describe, [9, 24, 1, 5, 25]))
