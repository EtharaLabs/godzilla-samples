from dataclasses import dataclass
from typing import Any
import functools
import asyncio
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
reach: float = math.hypot(9.0 / 1.0, 5.0 / 1.0) * 1.0
ratio: float = math.sqrt(2.0)
side: float = math.sqrt(81.0)
vol: float = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 2.0)))
def safe(s: str) -> str:
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x4", "-13"]))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [7, 11, 5, 10]))
print(_pf_map(math.isqrt, [81, 181, 229, 257]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
hits: int = 0
def record(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 4
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-5, -17, 55, 52, 2, -1, 37]))
doubled: list[int] = _pf_map(record, [-5, -17, 55, 52])
print(f"{doubled} after {hits} calls")
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def spin(n: int, acc: int):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 2
        k = await _pf_fn1()
        if n <= 0:
            return await finished(acc)
        else:
            return await spin(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(spin(29, 0))))
def countDigits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await spin(8, 0)
    return countDigits(a * 37213, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
