import functools
import math
import math as mth
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_rev(s):
    return "".join(reversed(s))
def tweak(x: int, flag: bool) -> tuple[int, int]:
    y = x * 2
    if flag:
        _y = x + 878
        _pf_t0 = _y - 1
    else:
        _pf_t0 = y
    z = _pf_t0
    return (y, z)
print((tweak(3, True), tweak(6, False)))
def step1(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def both(_pf_x: int) -> int:
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: step2(step1(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(both, [6, 3, 0]))
def bump2(n: int) -> int:
    return n + 66
def applyLift(x: int) -> int:
    return bump2(x)
def _pf_fn0():
    bump2 = 4
    return applyLift(bump2)
sample: int = _pf_fn0()
print((sample, applyLift(1)))
adders = _pf_map(lambda k: lambda x: x * 10 + k, [1, 8, 7])
print(_pf_map(lambda g: g(4), adders))
span: float = math.hypot(4.0 / 1.0, 6.0 / 1.0) * 1.0
ratio: float = math.sqrt(2.0)
side: float = math.sqrt(16.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(span / 1.0))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 4.0)))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [1, 5, 4])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 4) + chatty(False, 7))
def quiet(x: int) -> int:
    return x + 9
print(mapTwice(quiet, [6]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
print(_pf_str_rev(str.upper("kit")))
def row(n: int) -> list[int]:
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
