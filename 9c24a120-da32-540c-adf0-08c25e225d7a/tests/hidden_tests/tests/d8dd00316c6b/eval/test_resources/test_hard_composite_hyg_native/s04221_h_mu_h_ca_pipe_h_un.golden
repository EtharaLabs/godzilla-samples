from dataclasses import dataclass
from typing import Any
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([19, 18, 15, 15, 31]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "fay", "stop"])
print((logged, counts))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [4, 1, 1])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def maybeLog(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 6) + maybeLog(False, 2))
def quiet(x: int) -> int:
    return x + 5
print(mapTwice(quiet, [8]))
readings: list[int] = [2, 17, 30, 32, 42, 38, 46, 15]
def isBig(n: int) -> bool:
    return n > 7 and n % 4 != 0
digest: Some | None_ = _pf_head((lambda _pf_x: _pf_map(sum, _pf_chunk(3, _pf_x)))(_pf_filter(lambda x: x % 4 == 2, _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), readings))))
print(digest)
span: float = math.hypot(8.0 / 1.0, 8.0 / 1.0) * 1.0
ratio: float = math.sqrt(5.0)
side: float = math.sqrt(64.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 2.0)))
