from dataclasses import dataclass
from typing import Any
import functools
import asyncio
import math
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Addr"
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("10011") + int("67", base=8))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [8, 11, 9, 9]))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(countUp(1051, 0))))
def countDigits(n: int, acc: int) -> int:
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await countUp(3, 0)
    return countDigits(a * 2003, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
parcels: list[Ticket] = [Ticket(100, "ada", 180, True, Addr("Baku", 4)), Ticket(101, "ada", 257, True, Addr("Rome", 4)), Ticket(102, "ray", 247, True, Addr("Bern", 4)), Ticket(103, "ivy", 41, True, Addr("Bern", 2)), Ticket(104, "ray", 142, False, Addr("Doha", 1)), Ticket(105, "ivy", 252, False, Addr("Kyiv", 1))]
def bump2(o: Ticket) -> Ticket:
    if o.urgent:
        _pf_t0 = o
        return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + 18, _pf_t0.urgent, _pf_t0.dest)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(bump2, parcels)))
def classify(o: Ticket) -> str:
    if isinstance(o, Ticket) and o.urgent is True:
        amount = o.amount
        if amount > 161:
            return "rush-big"
    if isinstance(o, Ticket) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 161:
            return "big"
        else:
            return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def _pf_fn3(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn3, _pf_group_by(lambda o: o.owner, parcels))
print(byOwner)
