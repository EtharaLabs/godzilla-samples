_Emit: Emit = Emit()
Cmd = Turn | Load | Drop | Emit
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Op = Put | Push | Skip
def explain(t: Cmd) -> str:
    if isinstance(t, Turn):
        n0 = t._0
        if 0 <= n0 < 11:
            return f"turn!({n0})"
    if isinstance(t, Turn):
        n0 = t._0
        return f"turn({n0})"
    elif isinstance(t, Load):
        s0 = t._0
        return f"load({s0})"
    elif isinstance(t, Drop):
        s0 = t._0
        s1 = t._1
        return f"drop({s0},{s1})"
    else:
        return f"emit"
def cost(t: Cmd) -> int:
    if isinstance(t, Turn):
        x0 = t._0
        return x0 * 2
    elif isinstance(t, Drop):
        return 7
    elif isinstance(t, Emit):
        return 2
    else:
        return 3
stream: list[Cmd] = [Drop("oz", "bo"), Drop("eli", "ada"), Load("ivy"), Load("fay"), Drop("max", "oz")]
print(_pf_str_join("; ", _pf_map(explain, stream)))
tally: int = _pf_sum_by(cost, stream)
print(f"tally={tally}")
print(_pf_sort(stream))
def runAll(script: list[Op]) -> dict[str, int]:
    def fold1(m: dict[str, int], op: Op) -> dict[str, int]:
        if isinstance(op, Put):
            k = op._0
            v = op._1
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        elif isinstance(op, Push):
            n = op._0
            return _pf_map_add("pushed", n, m)
        else:
            return m
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Push(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
ops: list[Op] = [Put("nut", 8), Push(6), Put("cog", 2), Push(7)]
outcome: dict[str, int] = runAll(ops)
print(_pf_map_to_list(outcome))
sumSq: int = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [6, 8, 8, 9])
print(sumSq)
def inspect(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([31, 15, 18, 12, 27, 17]))
