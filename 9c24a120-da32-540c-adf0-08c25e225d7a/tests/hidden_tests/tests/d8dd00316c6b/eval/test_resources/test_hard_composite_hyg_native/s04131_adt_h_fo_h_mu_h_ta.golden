from dataclasses import dataclass
import functools
import asyncio
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
    def __eq__(self, other):
        return type(other) is Turn and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
    def __eq__(self, other):
        return type(other) is Load and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: str
    _1: str
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
    def __eq__(self, other):
        return type(other) is Drop and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0, self._1)
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
    def __eq__(self, other):
        return type(other) is Emit and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
