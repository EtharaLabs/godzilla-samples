from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Place"
def step1(x: int) -> int:
    return x + 1
def dbl(x: int) -> int:
    return x * 2
def both(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: dbl(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [6, 5, 6]))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [5, 2, 8])
print(_pf_map(lambda g: g(3), makers))
def swapSum(pairs: list[tuple[int, int]]) -> list[int]:
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn0(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn0, pairs))
print(swapSum([(3, 1), (4, 3)]))
def bump2(n: int) -> int:
    return n + 78
def applyLift(x: int) -> int:
    return bump2(x)
def _pf_fn1():
    bump2 = 5
    return applyLift(bump2)
probe: int = _pf_fn1()
print((probe, applyLift(4)))
tickets: list[Order] = [Order(100, "cy", 123, True, Place("Riga", 1)), Order(101, "quin", 109, True, Place("Doha", 3)), Order(102, "quin", 24, True, Place("Bern", 3)), Order(103, "quin", 211, True, Place("Kyiv", 3))]
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by(lambda o: o.amount, tickets))))
def label(o: Order) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, tickets)))
def _pf_fn2(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn2, (0, 0), tickets)
print(f"{cnt} records, {amt} total")
def _pf_fn3(o):
    if o.dest.zone > 2:
        _pf_t3 = o
        return Order(_pf_t3.id, _pf_t3.owner, _pf_t3.amount, _pf_t3.urgent, Place("Hub", 1))
    else:
        return o
moved: list[Order] = _pf_map(_pf_fn3, tickets)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [5, 2, 4])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 2) + chatty(False, 5))
def quiet(x: int) -> int:
    return x + 8
print(mapTwice(quiet, [7]))
