from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Instr = Put | Append | Skip
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [1, 9, 7])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 3) + chatty(False, 6))
def quiet(x: int) -> int:
    return x + 7
print(mapTwice(quiet, [3]))
def step(acc: tuple[int, int], op: Instr) -> tuple[int, int]:
    puts = acc[0]
    total = acc[1]
    if isinstance(op, Put):
        v = op._1
        return (puts + 1, total + v)
    elif isinstance(op, Append):
        n = op._0
        return (puts, total + n)
    else:
        return acc
def runAll(script: list[Instr]) -> tuple[int, int]:
    return _pf_fold(step, (0, 0), script)
ops: list[Instr] = [Append(2), _Skip, Put("bolt", 9), _Skip]
outcome: tuple[int, int] = runAll(ops)
print(outcome)
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 6:
        return _Low()
    elif scaled < 34:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    _pf_t0 = _pf_str_split("=", s)
    if len(_pf_t0) == 2:
        k = _pf_t0[0]
        v = _pf_t0[1]
        _pf_t1 = _pf_str_to_int(v)
        if isinstance(_pf_t1, Some):
            n = _pf_t1._0
            return Some((_pf_str_strip(k), n))
        else:
            return _None_
    else:
        return _None_
def band(n: int) -> str:
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    elif isinstance(_pf_t2, _Mid):
        return "mid"
    elif isinstance(_pf_t2, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def label(s: str) -> str:
    _pf_t3 = _ap_KeyVal(s)
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t3, Some):
        pair = _pf_t3._0
        return f"{_pf_fst(pair)}: {band(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(label, ["max=4", "oz", "gus", "fay"]))
