def addK(k: int, x: int) -> int:
    return x + k
def accept(n: int) -> bool:
    return n > 11 and n % 3 != 0
result: int = sum(_pf_sort_by(lambda x: -x, _pf_collect(lambda x: [x, x + 1], _pf_rev(_pf_take(7, values)))))
print(result)
def apply(xs: list[int], op: Change) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Push):
            n = op._0
            if n > 5:
                return _pf_concat(xs, [n * 10])
        return xs
def replay(script: list[Change]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 5:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes: list[Change] = [Put("bolt", 5), Put("gear", 1), _Skip, Push(-2), Push(-2), _Skip]
outcome: list[int] = replay(changes)
print(outcome)
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 8:
        return _Low()
    elif scaled < 31:
        return _Mid()
    else:
        return _High()
def grade(n: int) -> str:
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    if isinstance(_pf_t1, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t1, _Mid):
        return "mid"
    if isinstance(_pf_t1, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(grade, [7, 8, 0, 1, 4]))
