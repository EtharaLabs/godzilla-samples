from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def scan(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(scan([33, 14, 38, 38, 36]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "max", "stop"])
print((logged, counts))
def step1(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def pipeline2(_pf_x: int) -> int:
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: step2(step1(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(pipeline2, [5, 4, 0]))
def merge(o: Some | None_) -> int:
    def pair(a: int, b: int) -> int:
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 4
    r = _pf_t0
    return pair(r, 3)
print((merge(Some(1)), merge(_None_)))
def wrap(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([2, 7, 3]))
adders = _pf_map(lambda k: lambda x: x * 10 + k, [2, 8, 5])
print(_pf_map(lambda g: g(1), adders))
span: float = math.hypot(5.0 / 1.0, 6.0 / 1.0) * 1.0
ratio: float = math.sqrt(5.0)
side: float = math.sqrt(25.0)
vol: float = math.cbrt(27.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 8.0)))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
obs: list[int] = [13, 29, 6, 26]
print(Calc_mean(obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 11), obs))
print(Calc_norm1(obs))
print(_pf_filter(functools.partial(Calc_between, -4, 22), obs))
