from dataclasses import dataclass
from typing import Any
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Member"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Club"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Status = Active | Idle | Gone
def promote(s: Status) -> Status:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Member(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 6:
                _pf_t1 = t
                return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Status] = _pf_map(promote, [Idle(Club("cog", 3)), _Gone, _Gone, Active(Member("oz", 21)), _Gone])
print(roster)
members: list[Member] = [Member("eli", 7), Member("max", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def scan(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([6, 33, 19, 36, 29]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "max", "stop"])
print((logged, counts))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [2, 9, 5])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def chatty(verbose: bool, x: int) -> int:
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 3) + chatty(False, 2))
def quiet(x: int) -> int:
    return x + 9
print(mapTwice(quiet, [3]))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
pts: list[int] = [-10, -14, 29, 21, -8, 26]
print(Geo_scaleAll(3, pts))
print(Geo_mean(pts))
print(_pf_filter(functools.partial(Geo_between, -2, 12), pts))
