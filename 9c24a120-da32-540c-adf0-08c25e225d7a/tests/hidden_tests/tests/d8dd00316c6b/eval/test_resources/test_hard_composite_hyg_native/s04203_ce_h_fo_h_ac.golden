def step(acc: tuple[int, int], op: Instr) -> tuple[int, int]:
    puts = acc[0]
    total = acc[1]
    if isinstance(op, Put):
        v = op._1
        return (puts + 1, total + v)
    elif isinstance(op, Append):
        n = op._0
        return (puts, total + n)
    else:
