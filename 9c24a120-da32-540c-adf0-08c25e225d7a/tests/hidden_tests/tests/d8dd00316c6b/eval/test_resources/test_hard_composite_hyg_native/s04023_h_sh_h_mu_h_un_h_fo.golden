from dataclasses import dataclass
import functools
import math
import math as mth
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop: Noop = Noop()
Op = Put | Append | Noop
def scale(n: int) -> int:
    return n * 3
def _pf_fn0():
    _pf_t0 = [1, 2]
    if _pf_t0:
        scale = _pf_t0[0]
        return scale + 1
    else:
        return 0
chosen: int = _pf_fn0()
print((chosen, scale(9)))
def outer(xs: list[int]) -> list[int]:
    def twice(x: int) -> int:
        return x * 2
    def go(twice: int) -> int:
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([3, 4, 8]))
def step1(x: int) -> int:
    return x + 1
def step2(x: int) -> int:
    return x * 2
def both(x: int) -> int:
    return (lambda _pf_x: (lambda _pf_x: step2(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [9, 1, 5]))
def inspect(xs: list[int]) -> str:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([9, 39, 8, 14]))
logged: list[str] = []
def push2(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(push2, ["start", "max", "stop"])
print((logged, counts))
span: float = math.hypot(5.0 / 1.0, 6.0 / 1.0) * 1.0
ratio: float = math.sqrt(3.0)
side: float = math.sqrt(25.0)
vol: float = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(span / 1.0))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 8.0)))
def step(xs: list[int], op: Op) -> list[int]:
    if isinstance(op, Put):
        k = op._0
        v = op._1
        return _pf_concat(xs, [v])
    else:
        if isinstance(op, Append):
            n = op._0
            if n > 1:
                return _pf_concat(xs, [n * 10])
        return xs
def replay(script: list[Op]) -> list[int]:
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 1:
                _pf_t1 = n * 10
                xs.append(_pf_t1)
            case _:
                pass
    return xs
changes: list[Op] = [Append(-1), Append(3), Append(6), _Noop, _Noop, Put("nut", 4), _Noop]
final: list[int] = replay(changes)
print(final)
acc: int = _pf_fold(lambda step, x: step + x * x, 0, [4, 5, 2, 7])
print(acc)
