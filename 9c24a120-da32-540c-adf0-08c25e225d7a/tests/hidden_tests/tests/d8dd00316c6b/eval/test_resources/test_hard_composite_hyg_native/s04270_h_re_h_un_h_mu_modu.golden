from dataclasses import dataclass
from typing import Any
import functools
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Person:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: "Person"
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: "Club"
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone: Gone = Gone()
Status = Active | Idle | Gone
def promote(s: Status) -> Status:
    if isinstance(s, Active):
        p = s._0
        _pf_t0 = p
        return Active(Person(_pf_t0.name, p.age + 1))
    else:
        if isinstance(s, Idle):
            t = s._0
            if t.size > 4:
                _pf_t1 = t
                return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        other = s
        return other
roster: list[Status] = _pf_map(promote, [Idle(Club("wick", 5)), _Gone, Idle(Club("cog", 2)), _Gone])
print(roster)
members: list[Person] = [Person("bo", 7), Person("fay", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
reach: float = math.hypot(3.0 / 1.0, 3.0 / 1.0) * 1.0
ratio: float = math.sqrt(2.0)
side: float = math.sqrt(9.0)
vol: float = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
def rateOf(d: int, t: int) -> float:
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 3.0)))
def audit(xs: list[int]) -> int:
    seen = 0
    best = 0
    def note(x: int):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n: int, acc: int) -> int:
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(audit([37, 20, 25, 39, 34]))
logged: list[str] = []
def logEvent(msg: str) -> int:
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts: list[int] = _pf_map(logEvent, ["start", "kit", "stop"])
print((logged, counts))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs: list[int] = [15, 13, -3, 14, 4, -1, 14]
print(Text_norm1(obs))
print(Text_scaleAll(2, obs))
print(_pf_map(functools.partial(Text_clamp, 0, 8), obs))
print(Text_mean(obs))
