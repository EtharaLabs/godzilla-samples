def show(t: Signal) -> str:
    if isinstance(t, Mark):
        n0 = t._0
        return f"mark({n0})"
    elif isinstance(t, Load):
        s0 = t._0
        n1 = t._1
        return f"load({s0},{n1})"
    elif isinstance(t, Turn):
        n0 = t._0
        return f"turn({n0})"
    else:
        if isinstance(t, Emit):
            n0 = t._0
            if n0 > 9:
                return f"emit!({n0})"
        n0 = t._0
        return f"emit({n0})"
def rank(t: Signal) -> int:
    if isinstance(t, Turn):
        x0 = t._0
        return x0 * 2
    elif isinstance(t, Load):
        x1 = t._1
        return x1
    else:
        return 2
