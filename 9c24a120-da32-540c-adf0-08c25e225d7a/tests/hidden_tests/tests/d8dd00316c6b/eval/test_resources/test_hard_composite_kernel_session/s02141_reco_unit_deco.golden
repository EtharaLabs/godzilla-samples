00005604from dataclasses import dataclass
import functools
import math
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_dec_bool(v):
    if isinstance(v, bool):
        return v
    raise ValueError("expected a bool, got " + type(v).__name__)
def _pf_dec_field(name, dec):
    def go(v):
        if not isinstance(v, dict):
            raise ValueError("expected a JSON object")
        return dec(v[name])
    return go
def _pf_dec_int(v):
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    raise ValueError("expected an int, got " + type(v).__name__)
def _pf_dec_map3(f, da, db, dc):
    def go(v):
        return f(da(v), db(v), dc(v))
    return go
def _pf_dec_string(v):
    if isinstance(v, str):
        return v
    raise ValueError("expected a string, got " + type(v).__name__)
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    points: int
    active: bool
