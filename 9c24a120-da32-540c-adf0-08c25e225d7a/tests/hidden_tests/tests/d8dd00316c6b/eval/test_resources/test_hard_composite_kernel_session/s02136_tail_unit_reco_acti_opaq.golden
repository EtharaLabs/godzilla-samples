00003424from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [2, 9, 0, 22, 3]))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [54, 57, 27]))
segments = [61.1, 388.0, 488.3, 268.3, 354.8]
splits = [14.5, 63.7, 79.1, 17.6, 69.7]
total = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = total / dur
print(_pf_fmt_fixed(3, rate))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
edge = math.sqrt(25.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
tickets = [Parcel(100, "tom", 153, False), Parcel(101, "cy", 282, True), Parcel(102, "bo", 52, False), Parcel(103, "cy", 90, False)]
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by_desc(lambda o: o.amount, tickets))))
def bucket(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 182:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 182:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, tickets))
print(_pf_count_by(bucket, tickets))
def _ap_Above(n):
    if n > 9:
        return Some(n - 9)
    else:
        return _None_
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(kindOf, [34, 4, 39, 2, 33]))
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("acc", 3)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
print(_pf_head(keys) == Some("u-1"))
