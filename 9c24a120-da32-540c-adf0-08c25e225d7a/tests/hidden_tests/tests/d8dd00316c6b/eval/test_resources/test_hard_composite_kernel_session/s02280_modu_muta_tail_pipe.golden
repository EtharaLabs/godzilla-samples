00002675from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_square(x):
    return x * x
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
pts = [-1, 12, 13, 29, 18]
print(Calc_norm1(pts))
print(_pf_map(Calc_square, pts))
print(Calc_mean(pts))
print(_pf_filter(functools.partial(Calc_between, -2, 23), pts))
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-7, 29, 13, 15, 18, 54, 6, 39]))
doubled = _pf_map(track, [-7, 29, 13, 15])
print(f"{doubled} after {ticks} calls")
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(2935, 0))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [2, 8, 14]))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(251, 342))
values = [43, 24, 2, -9, 4, 9, 43, 3, 38, 19, 33]
def shift(k, x):
    return x + k
stage = lambda _pf_x: _pf_map(lambda x: x * x - 5, (lambda _pf_x: (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(3, _pf_x)))(_pf_sort(_pf_x)))(_pf_x))
digest = _pf_max(stage(values))
print(digest)
