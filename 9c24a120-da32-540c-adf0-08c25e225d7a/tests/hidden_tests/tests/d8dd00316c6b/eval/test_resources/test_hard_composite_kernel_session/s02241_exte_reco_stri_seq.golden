00003138from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
print(_pf_map(math.isqrt, [294, 16, 170, 280]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1010111") + int("34", base=8))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
print(_pf_str_rev(str.upper("kit")))
orders = [Ticket(100, "max", 251, True), Ticket(101, "ned", 88, True), Ticket(102, "max", 30, False), Ticket(103, "kit", 294, True), Ticket(104, "ned", 195, True), Ticket(105, "ned", 299, True)]
cheap, dear = _pf_partition(lambda o: o.amount < 154, orders)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def bump2(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(bump2, 7), orders)))
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by(lambda o: o.amount, orders))))
sentence = "wick;ray;cap;ivy;jo;bolt"
parts = _pf_str_split(";", sentence)
print(_pf_str_slice(3, 9, sentence))
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
print(_pf_map(lambda w: (w, len(w)), parts))
count = len(parts)
print(f"count={count} {{braces}} {len(sentence)}")
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, parts))))
def _pf_fn0():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
    yield 175
series = _pf_fn0()
print(list(filter(lambda n: n % 2 == 0, series)))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
print(list(_pf_seq_take_while(lambda n: n < 539, fib)))
