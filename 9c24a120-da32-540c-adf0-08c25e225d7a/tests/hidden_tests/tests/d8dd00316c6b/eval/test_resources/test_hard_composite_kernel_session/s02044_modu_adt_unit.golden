00003837from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    _1: int
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: str
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums = [22, 28, 7, 3]
print(_pf_map(Text_square, nums))
print(Text_norm1(nums))
print(Text_mean(nums))
print(Text_scaleAll(5, nums))
def show(t):
    match t:
        case Push(n0):
            return f"push({n0})"
        case Mark(2, _):
            return "mark-2"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case Pop(n0) if n0 % 2 == 0:
            return f"pop!({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Drop(n0, n1) if n0 > 8:
            return f"drop!({n0},{n1})"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
        case Turn(n0, s1):
            return f"turn({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Mark(x0, x1):
            return x0 + x1 * 2
        case Push(x0):
            return x0 * 5
        case Drop(x0, x1):
            return x0 + x1 * 4
        case _:
            return 1
stream = [Drop(-3, 4), Push(4), Turn(10, "kit"), Pop(10)]
_pf_iter(lambda t: print(show(t)), stream)
total = _pf_sum_by(rank, stream)
print(f"total={total}")
print((_pf_head(stream), _pf_last(stream)))
laps = [400.0, 406.4, 316.6, 335.9, 440.2]
times = [30.6, 25.1, 10.8, 82.5, 31.4]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = dist / elapsed
print(_pf_fmt_fixed(1, rate))
mass = 68.0
accel = 2.5
push = mass * accel
limit = 141.0
print("over" if push > limit else "under")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(laps, times))
print(best)
speeds = _pf_map2(lambda d, t: d / t, laps, times)
def _pf_str_join(sep, xs):
    return sep.join(xs)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
