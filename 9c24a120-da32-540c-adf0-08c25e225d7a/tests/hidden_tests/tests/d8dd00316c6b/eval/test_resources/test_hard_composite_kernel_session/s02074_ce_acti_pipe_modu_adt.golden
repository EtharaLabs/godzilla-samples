def render(t):
    match t:
        case Jump(n0) if 0 <= n0 < 6:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Halt(n0) if n0 % 2 == 0:
            return f"halt!({n0})"
        case Halt(n0):
            return f"halt({n0})"
        case Store(n0) if n0 % 2 == 0:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
