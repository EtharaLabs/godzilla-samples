def render(t):
    match t:
        case Skip(n0) if n0 > 8:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Store(n0):
            return f"store({n0})"
        case Jump(s0):
            return f"jump({s0})"
        case Push(n0, n1) if n0 > 6:
            return f"push!({n0},{n1})"
        case Push(n0, n1):
            return f"push({n0},{n1})"
        case Rest(0):
            return "rest-0"
        case Rest(n0):
            return f"rest({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Skip(x0):
            return x0 * 5
        case Rest(x0):
            return x0
