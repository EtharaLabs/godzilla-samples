00004149from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
