00002637from dataclasses import dataclass
import functools
import itertools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def _pf_fn0():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
evens = _pf_fn0()
print(list(_pf_seq_take(2, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Add(Num(-2), Num(2)), Mul(Add(Mul(Num(9), Num(6)), Mul(Num(-2), Num(-1))), Add(Num(1), Add(Num(2), Num(6)))), Num(6)]
_pf_iter(print, _pf_map(render, terms))
print(_pf_map(calc, terms))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs = [29, 27, 23, 3, 21, 6, 20]
print(Text_scaleAll(5, obs))
print(_pf_filter(functools.partial(Text_between, -2, 19), obs))
print(Text_mean(obs))
print(_pf_map(functools.partial(Text_clamp, 0, 5), obs))
