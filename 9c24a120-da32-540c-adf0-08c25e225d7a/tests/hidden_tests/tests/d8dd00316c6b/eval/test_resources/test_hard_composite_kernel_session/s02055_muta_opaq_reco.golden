00002338from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 3
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([52, 26, 50, 26, 21]))
doubled = _pf_map(record, [52, 26, 50, 26])
print(f"{doubled} after {hits} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), hits))
def rawOf(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("acc", 3)
print(_pf_str_join(" ", _pf_map(rawOf, ids)))
print(_pf_head(ids) == Some("u-1"))
book = [Ticket(100, "cy", 104, False), Ticket(101, "cy", 207, True), Ticket(102, "fay", 89, False), Ticket(103, "cy", 35, False), Ticket(104, "quin", 145, True)]
rushSum = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(rushSum)
def line(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(line, book)))
cheap, dear = _pf_partition(lambda o: o.amount < 117, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
