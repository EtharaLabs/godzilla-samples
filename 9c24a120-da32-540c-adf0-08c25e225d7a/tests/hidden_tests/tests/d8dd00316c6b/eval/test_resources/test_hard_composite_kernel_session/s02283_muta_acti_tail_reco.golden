00003215from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([58, 2, 56, 11]))
doubled = _pf_map(track, [58, 2, 56, 11])
print(f"{doubled} after {ticks} calls")
def _ap_Above(n):
    if n > 19:
        return Some(n - 19)
    else:
        return _None_
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [21, 33, 29, -5, 32, 23, 11]))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(2230, 0))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(74016))
parcels = [Invoice(100, "bo", 9, True, Place("Lima", 3)), Invoice(101, "lu", 210, True, Place("Riga", 4)), Invoice(102, "lu", 239, True, Place("Oslo", 1)), Invoice(103, "lu", 282, False, Place("Lima", 4)), Invoice(104, "gus", 104, True, Place("Baku", 4)), Invoice(105, "bo", 172, True, Place("Baku", 4))]
cheap, dear = _pf_partition(lambda o: o.amount < 117, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
print(_pf_max_by(lambda o: o.amount, parcels))
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
