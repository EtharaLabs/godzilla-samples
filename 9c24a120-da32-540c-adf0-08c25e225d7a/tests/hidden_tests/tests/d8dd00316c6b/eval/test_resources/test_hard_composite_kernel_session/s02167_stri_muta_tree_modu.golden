ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 4
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([47, -14, 4, 60, -7]))
doubled = _pf_map(track, [47, -14, 4, 60])
print(f"{doubled} after {ticks} calls")
env = dict([("x", 2), ("y", 3)])
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Neg(Neg(Add(Num(0), Num(8)))), Mul(Add(Num(0), Num(-1)), Mul(Num(6), Var("x")))]
_pf_iter(print, _pf_map(pretty, terms))
print(_pf_map(evaluate, terms))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_square(x):
    return x * x
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
obs = [14, -13, -9, -14, 22]
print(Calc_mean(obs))
print(_pf_map(Calc_square, obs))
print(Calc_norm1(obs))
