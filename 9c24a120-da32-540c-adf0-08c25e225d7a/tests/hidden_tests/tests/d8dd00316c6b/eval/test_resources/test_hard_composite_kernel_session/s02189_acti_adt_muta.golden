00003058from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    _1: int
    def __repr__(self):
        return f"Halt({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    def __repr__(self):
        return "Store"
_Store = Store()
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 10:
        return Some(n - 10)
    else:
        return _None_
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif isinstance(_pf_t1, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [1, 8, 9, 22, 11]))
def describe(t):
    match t:
        case Drop(n0):
            return f"drop({n0})"
        case Halt(s0, n1):
            return f"halt({s0},{n1})"
        case Store():
            return f"store"
        case Emit(n0) if n0 > 9:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Emit(x0):
            return x0
        case Halt(_, x1):
            return x1
        case Store():
            return 2
        case _:
            return 2
batch = [Drop(-3), Emit(12), Drop(6), Emit(2), Halt("gus", 7), Drop(11), Emit(7)]
print(_pf_map(describe, batch))
total = _pf_sum_by(weight, batch)
print(f"total={total}")
print(_pf_max_by(weight, batch))
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-20, 13, 22, 6, 28, 39, -16]))
doubled = _pf_map(track, [-20, 13, 22, 6])
print(f"{doubled} after {ticks} calls")
