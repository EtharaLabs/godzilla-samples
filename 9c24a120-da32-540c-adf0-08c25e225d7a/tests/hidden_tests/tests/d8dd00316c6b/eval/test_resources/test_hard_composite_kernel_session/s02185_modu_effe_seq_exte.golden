00002603from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [16, 12, -14, 15]
print(_pf_filter(functools.partial(Calc_between, 4, 12), pts))
print(Calc_mean(pts))
print(_pf_map(functools.partial(Calc_clamp, 0, 12), pts))
print(Calc_norm1(pts))
def margin(price, qty):
    return price * qty - 7 * qty
def announce(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("hub", 18, 3), ("gear", 22, 3), ("wick", 35, 1)]))
print(overall)
def _pf_fn1():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
squares = _pf_fn1()
print(list(filter(lambda n: n % 2 == 0, squares)))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x2", "8"]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
def lcm(a, b):
    return a * b // math.gcd(a, b)
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
print(_pf_fold(lcm, 1, [7, 12, 4, 11]))
