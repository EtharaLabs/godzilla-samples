00002037from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-11, 47, 57, -6, -2, 35, 56, 13]))
doubled = _pf_map(track, [-11, 47, 57, -6])
print(f"{doubled} after {hits} calls")
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("u", 3)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1010000") + int("102", base=8))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [3, 6, 11, 11]))
laps = [152.5, 33.0, 277.2, 479.4]
splits = [84.0, 75.2, 34.5, 38.4]
total = _pf_fold(lambda a, b: a + b, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = total / elapsed
print(_pf_fmt_fixed(3, rate))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
edge = math.sqrt(6.25)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
