def show(t):
    match t:
        case Turn(0):
            return "turn-0"
        case Turn(n0):
            return f"turn({n0})"
        case Halt(n0) if 0 <= n0 < 15:
            return f"halt!({n0})"
        case Halt(n0):
            return f"halt({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Halt(x0):
            return x0
        case Turn(x0):
            return x0
        case Store(x0, x1):
            return x0 + x1
        case _:
            return 1
