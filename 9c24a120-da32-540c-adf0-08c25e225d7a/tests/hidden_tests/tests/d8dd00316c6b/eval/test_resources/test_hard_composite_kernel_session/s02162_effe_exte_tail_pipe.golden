00002195from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def discount(price, qty):
    return price * qty - 9 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("gear", 31, 4), ("cap", 27, 6), ("cap", 19, 4), ("cog", 49, 4)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(13)([1, 2, 3]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
print(_pf_map(math.isqrt, [215, 69, 59, 274]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1010101") + int("137", base=8))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(7, 14, 1))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(1455, 0))
data = [3, 32, -4, 33, 36, 42, 23]
digest = _pf_list_find(lambda x: x % 3 == 1, _pf_map(lambda b: 50 - b, _pf_filter(lambda x: x > 10, _pf_sort_desc(_pf_sort(_pf_rev(data))))))
print(digest)
print(len(data))
