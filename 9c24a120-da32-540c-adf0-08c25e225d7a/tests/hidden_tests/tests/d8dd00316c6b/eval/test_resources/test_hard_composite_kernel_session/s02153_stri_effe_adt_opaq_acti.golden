00003915from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    def __repr__(self):
        return "Turn"
_Turn = Turn()
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    def __repr__(self):
        return "Drop"
_Drop = Drop()
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
sentence = "pin;ada;bo;eli;rod;hub"
words = _pf_str_split(";", sentence)
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", "40,12,-3,7,40"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
print(_pf_map(lambda w: (w, len(w)), words))
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
def margin(price, qty):
    return price * qty - 9 * qty
def report(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("cap", 25, 6), ("hub", 36, 1), ("pin", 41, 3), ("rod", 12, 4)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(11)([1, 2, 3]))
def render(t):
    match t:
        case Jump(n0) if n0 > 0:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Pop(s0):
            return f"pop({s0})"
        case Turn() | Drop():
            return "turn/drop"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Jump(x0):
            return x0
        case Drop():
            return 5
        case Turn():
            return 7
        case _:
            return 3
prog = [Pop("hal"), Pop("kit"), Pop("fay"), Pop("pam"), Jump(11)]
print(_pf_map(render, prog))
tally = _pf_sum_by(weight, prog)
print(f"tally={tally}")
print((_pf_head(prog), _pf_last(prog)))
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("acc", 2)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("u-1"))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def bucketOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
_pf_iter(print, _pf_map(bucketOf, [36, 28, 13, 31, 28, 0, 14, 13]))
