00002029from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
def margin(price, qty):
    return price * qty - 6 * qty
def announce(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("nut", 39, 1), ("cog", 18, 4), ("cog", 43, 6), ("cap", 11, 1)]))
print(grand)
book = [Invoice(100, "cy", 73, False), Invoice(101, "hal", 268, False), Invoice(102, "hal", 87, False), Invoice(103, "tom", 207, False)]
def surcharge(o):
    if o.urgent:
        _pf_t0 = o
        return Invoice(_pf_t0.id, _pf_t0.owner, o.amount + 3, _pf_t0.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(surcharge, book)))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn1, (0, 0), book)
print(f"{cnt} records, {sumAmt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 190, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
hits = 0
def note(x):
    global hits
    hits = hits + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([11, 8, 39, 14, 6, 17]))
doubled = _pf_map(note, [11, 8, 39, 14])
print(f"{doubled} after {hits} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), hits))
