def _ap_Above(n):
    if n > 21:
        return Some(n - 21)
    else:
        return _None_
def kindOf(n):
    _pf_t1 = _ap_Above(n)
    if isinstance(_pf_t1, Some):
        d = _pf_t1._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
def _pf_iter(f, xs):
