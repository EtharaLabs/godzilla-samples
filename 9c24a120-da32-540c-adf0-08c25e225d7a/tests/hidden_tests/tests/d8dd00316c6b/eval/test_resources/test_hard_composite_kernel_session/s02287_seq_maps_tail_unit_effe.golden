def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [35, 27, 6]))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [4, 13, 23, 27, 9]))
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
