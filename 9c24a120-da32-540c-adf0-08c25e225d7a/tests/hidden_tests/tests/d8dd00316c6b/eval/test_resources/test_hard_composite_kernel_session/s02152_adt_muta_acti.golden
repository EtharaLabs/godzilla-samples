@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def show(t):
    match t:
        case Load(n0) if 0 <= n0 < 12:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Pop(n0, s1) if n0 % 2 == 0:
            return f"pop!({n0},{s1})"
        case Pop(n0, s1):
            return f"pop({n0},{s1})"
        case Halt():
            return f"halt"
        case Turn():
            return f"turn"
        case Store(3, _):
            return "store-3"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Halt():
            return 2
        case Store(x0, x1):
            return x0 + x1
        case _:
            return 0
queue = [Pop(7, "dee"), Store(-1, 3), _Turn, Load(-1), _Halt]
_pf_iter(lambda t: print(show(t)), queue)
tally = _pf_sum_by(cost, queue)
print(f"tally={tally}")
print((_pf_head(queue), _pf_last(queue)))
ticks = 0
def record(x):
    global ticks
    ticks = ticks + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([39, 58, 19, 38, 21]))
doubled = _pf_map(record, [39, 58, 19, 38])
print(f"{doubled} after {ticks} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), ticks))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def bucketOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(bucketOf, [12, 20, 25, 35, 34]))
