00002381from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
print(_pf_map(math.isqrt, [220, 343, 140, 289]))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [6, 12, -5, 26, -2, -5]
print(Calc_mean(pts))
print(Calc_scaleAll(2, pts))
print(Calc_norm1(pts))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(3, 5, 1))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [45, 12, 57]))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [13, 11, 30, 1, 11]))
legs = [34.7, 414.3, 490.0, 316.9]
splits = [18.4, 57.6, 71.7, 68.6]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = dist / dur
print(_pf_fmt_fixed(2, pace))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(legs, splits))
print(best)
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
