00003279from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
_Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    _1: str
    def __repr__(self):
        return f"Load({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: str
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(2749, 0))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [29, 6, 27, 0, 3]))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(6, 7, 1))
def net(price, qty):
    return price * qty - 8 * qty
def announce(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("rod", 38, 4), ("nut", 36, 6), ("wick", 35, 2)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(6)([1, 2, 3]))
def render(t):
    match t:
        case Halt(n0):
            return f"halt({n0})"
        case Load(2, _):
            return "load-2"
        case Load(n0, s1):
            return f"load({n0},{s1})"
        case Drop(n0, s1):
            return f"drop({n0},{s1})"
        case Skip() | Emit():
            return "skip/emit"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Emit():
            return 4
        case Skip():
            return 3
        case Drop(x0, _):
            return x0 * 5
        case Load(x0, _):
            return x0 * 5
        case _:
            return 0
batch = [_Emit, Drop(8, "fay"), _Emit, Halt(6)]
print(_pf_str_join("; ", _pf_map(render, batch)))
tally = _pf_sum_by(cost, batch)
print(f"tally={tally}")
