00002923from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
def Geo_square(x):
    return x * x
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums = [5, 1, -2, 26, 19]
print(_pf_map(Geo_square, nums))
print(Geo_mean(nums))
print(Geo_scaleAll(2, nums))
def discount(price, qty):
    return price * qty - 8 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("wick", 48, 5), ("hub", 16, 1), ("tap", 15, 6)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(13)([1, 2, 3]))
def _pf_fn1():
    for x in _pf_range(1, 6):
        y = x * x
        yield y
    yield 112
squares = _pf_fn1()
print(list(filter(lambda n: n % 3 == 0, squares)))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 947, fib)))
laps = [181.0, 251.4, 449.8]
splits = [42.3, 51.0, 41.8]
dist = _pf_fold(lambda a, b: a + b, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = dist / elapsed
print(_pf_fmt_fixed(2, speed))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
