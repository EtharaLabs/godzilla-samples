def offset(k, x):
    return x + k
def accept(n):
    return n > 0 and n % 3 != 0
outcome = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(_pf_distinct(_pf_collect(lambda x: [x, x + 1], _pf_map(functools.partial(offset, 7), data))))
print(outcome)
