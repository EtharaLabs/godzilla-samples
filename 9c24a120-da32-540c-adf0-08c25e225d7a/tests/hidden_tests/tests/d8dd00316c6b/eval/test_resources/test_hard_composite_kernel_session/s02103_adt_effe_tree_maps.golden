def describe(t):
    match t:
        case Rest(1):
            return "rest-1"
        case Rest(n0):
            return f"rest({n0})"
        case Halt():
            return f"halt"
        case Turn(n0):
            return f"turn({n0})"
        case Load(s0):
            return f"load({s0})"
        case Mark(0):
            return "mark-0"
        case Mark(n0):
            return f"mark({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Turn(x0):
            return x0 * 5
        case _:
            return 2
