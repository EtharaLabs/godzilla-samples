00002989from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: str
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
def render(t):
    match t:
        case Drop(1):
            return "drop-1"
        case Drop(n0):
            return f"drop({n0})"
        case Emit(s0):
            return f"emit({s0})"
        case Push(n0):
            return f"push({n0})"
        case Halt(n0) if n0 % 2 == 0:
            return f"halt!({n0})"
        case Halt(n0):
            return f"halt({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Drop(x0):
            return x0
        case _:
            return 0
stream = [Emit("jo"), Emit("quin"), Emit("kit"), Drop(6), Drop(4)]
print(_pf_str_join("; ", _pf_map(render, stream)))
tally = _pf_sum_by(rank, stream)
print(f"tally={tally}")
print(_pf_max_by(rank, stream))
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("u", 4)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
obs = [-5, -2, 0, -13, -11, -12, -6]
print(Stats_scaleAll(3, obs))
print(Stats_norm1(obs))
print(_pf_filter(functools.partial(Stats_between, -1, 17), obs))
print(_pf_str_rev(str.upper("hal")))
def fromBin(s):
    return int(s, base=2)
print(fromBin("11000") + int("54", base=8))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
def lcm(a, b):
    return a * b // math.gcd(a, b)
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
print(_pf_fold(lcm, 1, [3, 5, 4, 11]))
