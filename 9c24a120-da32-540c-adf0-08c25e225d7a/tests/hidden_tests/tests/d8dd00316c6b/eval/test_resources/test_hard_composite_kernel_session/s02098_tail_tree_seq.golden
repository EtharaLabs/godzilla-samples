def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(959, 0))
vars = dict([("x", 9), ("y", -4)])
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case Var(v):
            return _pf_map_find_or(v, 0, vars)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
def shrink(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(shrink(a), shrink(b))
            case Mul(a, b):
                return Mul(shrink(a), shrink(b))
            case _:
                return e
