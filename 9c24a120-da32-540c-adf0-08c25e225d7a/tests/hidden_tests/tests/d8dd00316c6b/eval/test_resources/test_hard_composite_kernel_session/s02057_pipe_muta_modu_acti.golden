00002525from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_sort(xs):
    return sorted(xs)
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
data = [18, 13, 15, 18, 36, 38, 26, -7, 22]
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
outcome = _pf_max(_pf_collect(lambda x: [x, x + 1], _pf_filter(lambda x: x % 5 == 2, _pf_sort(_pf_map(functools.partial(max, 2), _pf_distinct_by(lambda x: x % 3, _pf_fn1(data)))))))
print(outcome)
calls = 0
def track(x):
    global calls
    calls = calls + 1
    return x * 3
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([23, 18, 29, 59, -17, -18, 7, 12]))
doubled = _pf_map(track, [23, 18, 29, 59])
print(f"{doubled} after {calls} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), calls))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_square(x):
    return x * x
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
pts = [9, 22, -10, 2, 3]
print(_pf_filter(functools.partial(Calc_between, -3, 15), pts))
print(_pf_map(Calc_square, pts))
print(Calc_scaleAll(4, pts))
def _ap_Above(n):
    if n > 24:
        return Some(n - 24)
    else:
        return _None_
def classify(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [37, 15, 12, 2, 30, 36, 28, 28]))
