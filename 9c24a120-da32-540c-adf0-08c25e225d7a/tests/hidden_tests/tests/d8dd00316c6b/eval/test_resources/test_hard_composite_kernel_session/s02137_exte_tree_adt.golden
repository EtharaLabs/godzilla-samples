00003809from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    _1: int
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
print(_pf_map(math.isqrt, [206, 111, 30, 295]))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [5, 3, 3, 11]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
tree = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [21, 4, 44, 33, 25, 50, 3, 24])
def toListT(t):
    match t:
        case Leaf():
            return []
        case Node(l, v, rt):
            return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
        case _:
            raise RuntimeError("non-exhaustive match")
print(toListT(tree))
def depthT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, _, rt):
            return 1 + max(depthT(l), depthT(rt))
        case _:
            raise RuntimeError("non-exhaustive match")
print(depthT(tree))
def minT(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minT(tree))
def show(t):
    match t:
        case Pop(s0):
            return f"pop({s0})"
        case Drop(n0, n1) if n0 % 2 == 0:
            return f"drop!({n0},{n1})"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Drop(x0, x1):
            return x0 + x1
        case _:
            return 0
queue = [Drop(12, 7), Pop("dee"), Mark(4, -3), Mark(-2, 0)]
_pf_iter(lambda t: print(show(t)), queue)
tally = _pf_sum_by(weight, queue)
print(f"tally={tally}")
def _pf_filter(f, xs):
    return list(filter(f, xs))
print(len(_pf_filter(lambda t: weight(t) > 4, queue)))
