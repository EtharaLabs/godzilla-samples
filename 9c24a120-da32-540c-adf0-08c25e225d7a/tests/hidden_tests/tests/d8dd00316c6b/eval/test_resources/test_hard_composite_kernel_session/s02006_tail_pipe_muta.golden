00001917from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_str_join(sep, xs):
    return sep.join(xs)
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(49548))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(27, 151))
data = [19, 16, -10, 23, 29, 4, -2, 40, 19, 42, 1]
def keep(n):
    return n > 16 and n % 5 != 0
digest = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(_pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), _pf_take(3, (lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(data))))
print(digest)
print(len(data))
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([8, 31, 25, 38, -5, 50]))
doubled = _pf_map(track, [8, 31, 25, 38])
print(f"{doubled} after {hits} calls")
