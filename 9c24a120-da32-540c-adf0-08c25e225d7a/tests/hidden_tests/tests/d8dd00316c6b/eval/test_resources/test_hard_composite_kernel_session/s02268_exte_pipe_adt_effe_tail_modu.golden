00003367from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    def __repr__(self):
        return "Drop"
_Drop = Drop()
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    def __repr__(self):
        return "Turn"
_Turn = Turn()
def fromBin(s):
    return int(s, base=2)
print(fromBin("1001") + int("45", base=8))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "100"])))
readings = [1, 20, 17, -9, 41, 4, -10, 40]
result = len(_pf_filter(lambda x: x % 3 == 2, _pf_map(functools.partial(max, 7), _pf_collect(lambda x: [x, x + 1], readings))))
print(result)
print(len(readings))
def show(t):
    match t:
        case Store(s0):
            return f"store({s0})"
        case Drop() | Turn():
            return "drop/turn"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Turn():
            return 3
        case _:
            return 1
batch = [_Drop, _Turn, Store("quin"), _Drop]
_pf_iter(lambda t: print(show(t)), batch)
tally = _pf_sum_by(cost, batch)
print(f"tally={tally}")
print((_pf_head(batch), _pf_last(batch)))
def margin(price, qty):
    return price * qty - 2 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("rod", 34, 1), ("hub", 49, 1)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(15)([1, 2, 3]))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(368, 348))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(5, 15, 1))
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(13521))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
obs = [-11, -14, -1, 9, 29]
print(Calc_norm1(obs))
print(Calc_scaleAll(2, obs))
print(_pf_filter(functools.partial(Calc_between, 2, 19), obs))
