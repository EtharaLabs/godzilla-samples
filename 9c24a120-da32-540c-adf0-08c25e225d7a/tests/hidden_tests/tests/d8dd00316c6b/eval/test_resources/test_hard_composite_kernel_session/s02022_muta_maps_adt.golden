def describe(t):
    match t:
        case Push(n0):
            return f"push({n0})"
        case Halt(n0, n1) if n0 > 9:
            return f"halt!({n0},{n1})"
        case Halt(n0, n1):
            return f"halt({n0},{n1})"
        case Emit():
            return f"emit"
        case Drop(n0) if 0 <= n0 < 3:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Drop(x0):
            return x0
        case Halt(x0, x1):
            return x0 + x1 * 3
        case _:
            return 3
