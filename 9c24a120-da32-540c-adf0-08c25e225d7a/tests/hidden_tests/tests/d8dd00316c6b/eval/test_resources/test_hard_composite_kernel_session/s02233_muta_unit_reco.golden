00002637from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
hits = 0
def note(x):
    global hits
    hits = hits + 1
    return x * 3
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-12, -4, -12, 8, 3, 8, 22]))
doubled = _pf_map(note, [-12, -4, -12, 8])
print(f"{doubled} after {hits} calls")
segments = [44.1, 165.4, 494.8, 109.7]
times = [27.1, 68.1, 63.4, 74.5]
dist = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = dist / dur
print(_pf_fmt_fixed(2, rate))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
mass = 69.0
accel = 5.5
push = mass * accel
limit = 145.0
print("over" if push > limit else "under")
parcels = [Order(100, "ned", 224, False), Order(101, "lu", 219, False), Order(102, "ned", 83, False), Order(103, "lu", 83, False), Order(104, "ned", 179, True)]
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(urgentTotal)
def priority(o):
    match o:
        case Order(urgent=True, amount=amount) if amount > 104:
            return "rush-big"
        case Order(urgent=True):
            return "rush"
        case Order(amount=amount):
            if amount > 104:
                return "big"
            else:
                return "normal"
print(_pf_map(priority, parcels))
print(_pf_count_by(priority, parcels))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn0, (0, 0), parcels)
print(f"{nrec} records, {amt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 173, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
