def show(t):
    match t:
        case Load(n0) if n0 % 2 == 0:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Rest(n0, s1):
            return f"rest({n0},{s1})"
        case Push(s0, s1):
