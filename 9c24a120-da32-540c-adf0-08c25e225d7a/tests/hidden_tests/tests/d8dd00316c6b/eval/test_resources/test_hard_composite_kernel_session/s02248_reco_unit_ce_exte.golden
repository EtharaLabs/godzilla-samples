def decodeLine(line):
    def _pf_fn0():
        match _pf_str_split("=", line):
            case [_k, _v]:
                _pf_t1 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
            case _:
                _pf_t1 = Error(f"malformed: {line}")
        if isinstance(_pf_t1, Ok):
            k, v = _pf_t1._0
            _pf_t3 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
