parcels = [Invoice(100, "kit", 170, False, Site("Rome", 1)), Invoice(101, "quin", 25, False, Site("Lima", 2)), Invoice(102, "gus", 261, True, Site("Baku", 2)), Invoice(103, "quin", 249, True, Site("Rome", 1)), Invoice(104, "gus", 20, False, Site("Kyiv", 2))]
