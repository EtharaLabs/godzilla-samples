def explain(t):
    match t:
        case Store(0):
            return "store-0"
        case Store(n0):
            return f"store({n0})"
        case Push(n0) if 0 <= n0 < 5:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Emit(n0) if n0 % 2 == 0:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Load(s0):
            return f"load({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
