00004135from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def _pf_fn0():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
series = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, series))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def Geo_square(x):
    return x * x
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
nums = [20, -3, 18, -5, -1, 1, 18]
print(_pf_map(Geo_square, nums))
print(Geo_scaleAll(3, nums))
print(_pf_map(functools.partial(Geo_clamp, 0, 8), nums))
print(Geo_norm1(nums))
tickets = [Invoice(100, "fay", 124, False, Site("Doha", 1)), Invoice(101, "fay", 242, True, Site("Doha", 2)), Invoice(102, "ada", 208, False, Site("Kyiv", 2)), Invoice(103, "ada", 154, False, Site("Rome", 4)), Invoice(104, "ada", 173, False, Site("Baku", 1))]
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by(lambda o: o.amount, tickets))))
cheap, dear = _pf_partition(lambda o: o.amount < 117, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
sentence = "quin;bo;gus;cog;pam;dee;nut"
words = _pf_str_split(";", sentence)
print(_pf_str_replace("o", "O", sentence))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
print(_pf_str_slice(2, 4, sentence))
print((_pf_str_index_of("gu", sentence), "gu" in sentence))
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", "-3,7,5a,x,x"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), words)))
def margin(price, qty):
    return price * qty - 2 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn1, [("bolt", 6, 2), ("hub", 11, 4)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(14)([1, 2, 3]))
