00001527import functools
import math
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_square(x):
    return x * x
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs = [-9, -14, -12, 26, 8, -10, 25]
print(_pf_filter(functools.partial(Calc_between, -3, 12), obs))
print(_pf_map(Calc_square, obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 11), obs))
def net(price, qty):
    return price * qty - 6 * qty
def emit(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("tap", 22, 5), ("tap", 41, 3), ("cog", 31, 5)]))
print(grand)
print(_pf_map(math.isqrt, [52, 45, 221, 20]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("11001") + int("131", base=8))
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 3
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([28, -8, 21, 34]))
doubled = _pf_map(track, [28, -8, 21, 34])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
