outcome = sum(_pf_map(lambda b: 5 + b, _pf_drop(3, (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))((lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(_pf_collect(lambda x: [x, x + 1], samples))))))
