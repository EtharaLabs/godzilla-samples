_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_rev(s):
    return "".join(reversed(s))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
