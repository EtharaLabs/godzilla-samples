00002880from dataclasses import dataclass
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    _1: str
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    _1: int
    def __repr__(self):
        return f"Halt({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
_Jump = Jump()
def describe(t):
    match t:
        case Emit(n0) if n0 % 2 == 0:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Push(3):
            return "push-3"
        case Push(n0):
            return f"push({n0})"
        case Pop(n0, s1) if 0 <= n0 < 14:
            return f"pop!({n0},{s1})"
        case Pop(n0, s1):
            return f"pop({n0},{s1})"
        case Halt(s0, n1):
            return f"halt({s0},{n1})"
        case Jump():
            return f"jump"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Halt(_, x1):
            return x1
        case Push(x0):
            return x0 * 5
        case Jump():
            return 9
        case Emit(x0):
            return x0
        case _:
            return 1
queue = [Halt("kit", 12), Push(3), _Jump, Push(7), Emit(0)]
_pf_iter(lambda t: print(describe(t)), queue)
tally = _pf_sum_by(weight, queue)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: weight(t) > 4, queue)))
def net(price, qty):
    return price * qty - 2 * qty
def emit(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("bolt", 31, 2), ("wick", 14, 3), ("pin", 14, 3), ("pin", 25, 1)]))
print(grand)
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-14, 15, 45, 12]))
doubled = _pf_map(track, [-14, 15, 45, 12])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
