00003084from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    _1: int
    def __repr__(self):
        return f"Store({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    _1: int
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
calls = 0
def record(x):
    global calls
    calls = calls + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([11, 32, 2, 52, 21, 9, -16, 36]))
doubled = _pf_map(record, [11, 32, 2, 52])
print(f"{doubled} after {calls} calls")
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_square(x):
    return x * x
nums = [12, 14, 28, 21, 7, 25, -12]
print(Geo_mean(nums))
print(_pf_filter(functools.partial(Geo_between, 4, 20), nums))
print(Geo_scaleAll(2, nums))
print(_pf_map(Geo_square, nums))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def kindOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(kindOf, [6, 6, 9, 22, 4, 37, 0, 20]))
def render(t):
    match t:
        case Load(n0):
            return f"load({n0})"
        case Store(n0, n1) if 0 <= n0 < 7:
            return f"store!({n0},{n1})"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case Pop(s0, n1):
            return f"pop({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Store(x0, x1):
            return x0 + x1 * 4
        case Load(x0):
            return x0 * 2
        case _:
            return 1
stream = [Load(7), Store(-3, 8), Pop("quin", 11), Store(1, 8), Pop("eli", -3), Load(9), Pop("eli", 9)]
print(_pf_str_join("; ", _pf_map(render, stream)))
grandSum = _pf_sum_by(weight, stream)
print(f"grandSum={grandSum}")
print(len(_pf_filter(lambda t: weight(t) > 3, stream)))
