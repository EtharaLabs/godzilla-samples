00004382from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def _pf_fn0():
    for x in _pf_range(1, 8):
        y = x * x
        yield y
squares = _pf_fn0()
print(list(_pf_seq_take(2, map(lambda n: n + 1, squares))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 5)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1628, fib)))
raw = "ada kit cy quin bolt"
tokens = _pf_str_split(" ", raw)
print(_pf_map(lambda w: (w, len(w)), tokens))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, tokens))))
print(_pf_str_slice(1, 5, raw))
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
def shrink(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(shrink(a), shrink(b))
            case Mul(a, b):
                return Mul(shrink(a), shrink(b))
            case _:
                return e
exprs = [Add(Add(Num(0), Neg(Num(7))), Neg(Add(Num(2), Num(2)))), Add(Num(0), Mul(Num(7), Add(Num(2), Num(0)))), Add(Num(2), Mul(Neg(Num(6)), Neg(Num(2))))]
_pf_iter(print, _pf_map(pretty, _pf_map(shrink, exprs)))
print(_pf_map(evaluate, exprs))
def net(price, qty):
    return price * qty - 6 * qty
def report(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn2(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn2, [("tap", 31, 4), ("tap", 30, 3), ("hub", 31, 6), ("cap", 7, 2)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(19)([1, 2, 3]))
