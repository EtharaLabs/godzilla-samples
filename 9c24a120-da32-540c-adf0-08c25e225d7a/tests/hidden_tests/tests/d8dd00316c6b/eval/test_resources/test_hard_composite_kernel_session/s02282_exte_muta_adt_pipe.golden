00003169from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    def __repr__(self):
        return "Drop"
_Drop = Drop()
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
_Jump = Jump()
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
print(_pf_map(math.isqrt, [352, 3, 323, 311]))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [10, 10, 5, 4]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
ticks = 0
def record(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([60, 60, 21, 10]))
doubled = _pf_map(record, [60, 60, 21, 10])
print(f"{doubled} after {ticks} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), ticks))
def explain(t):
    match t:
        case Skip(n0):
            return f"skip({n0})"
        case Drop() | Jump():
            return "drop/jump"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Drop():
            return 8
        case _:
            return 2
batch = [Skip(12), Skip(2), _Jump, _Drop, Skip(12), _Drop, _Drop]
print(_pf_str_join(" ", _pf_map(explain, batch)))
total = _pf_sum_by(weight, batch)
print(f"total={total}")
print(_pf_max_by(weight, batch))
readings = [10, 11, 21, -6, 26, 47, -1, 24, 12]
def shift(k, x):
    return x + k
def accept(n):
    return n > 5 and n % 3 != 0
outcome = _pf_list_find(lambda x: x % 3 == 1, _pf_sort_desc(_pf_choose(lambda x: (Some(x // 4) if x % 4 == 0 else _None_), _pf_map(lambda b: 14 - b, _pf_filter(lambda x: x % 2 == 0, readings)))))
print(outcome)
