@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
def explain(t):
    match t:
        case Store(n0):
            return f"store({n0})"
        case Drop(s0):
            return f"drop({s0})"
        case Turn(s0, n1):
            return f"turn({s0},{n1})"
        case Load():
            return f"load"
        case Halt():
            return f"halt"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Store(x0):
            return x0 * 2
        case _:
            return 1
