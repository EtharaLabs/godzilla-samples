def render(t):
    match t:
        case Skip(n0) if 0 <= n0 < 13:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Turn(n0, n1) if 0 <= n0 < 11:
            return f"turn!({n0},{n1})"
        case Turn(n0, n1):
            return f"turn({n0},{n1})"
        case Mark(n0) if n0 > 1:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
