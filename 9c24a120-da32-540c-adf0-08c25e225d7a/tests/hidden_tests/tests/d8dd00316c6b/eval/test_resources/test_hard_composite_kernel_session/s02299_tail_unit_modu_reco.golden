00003276from dataclasses import dataclass
import functools
import math
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(2784, 0))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [37, 51, 16]))
segments = [222.0, 270.0, 90.4, 434.3, 76.7]
splits = [34.6, 21.6, 70.4, 50.3, 44.9]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = total / elapsed
print(_pf_fmt_fixed(2, speed))
edge = math.sqrt(9.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [25, 6, 17, 26, 25, -11, 15]
print(_pf_filter(functools.partial(Text_between, 3, 18), pts))
print(_pf_map(functools.partial(Text_clamp, 0, 7), pts))
print(Text_norm1(pts))
orders = [Parcel(100, "pam", 88, False), Parcel(101, "jo", 204, False), Parcel(102, "pam", 174, False), Parcel(103, "fay", 222, True), Parcel(104, "jo", 37, False)]
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by(lambda o: o.amount, orders))))
def surcharge(o):
    if o.urgent:
        _pf_t0 = o
        return Parcel(_pf_t0.id, _pf_t0.owner, o.amount + 9, _pf_t0.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(surcharge, orders)))
def label(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, orders)))
cheap, dear = _pf_partition(lambda o: o.amount < 200, orders)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def priority(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 52:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 52:
                return "big"
            else:
                return "normal"
print(_pf_map(priority, orders))
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
print(_pf_count_by(priority, orders))
