def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(95195))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(2, 12, 1))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(1721, 0))
def render(t):
    match t:
        case Jump(s0):
            return f"jump({s0})"
        case Pop(n0):
            return f"pop({n0})"
        case Load(n0) if 0 <= n0 < 14:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Drop(s0):
            return f"drop({s0})"
        case Rest(n0):
            return f"rest({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Pop(x0):
            return x0 * 5
        case Rest(x0):
            return x0
        case Drop(_):
            return 2
        case _:
            return 3
