def explain(t):
    match t:
        case Emit(n0) if n0 % 2 == 0:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Load(n0, n1):
            return f"load({n0},{n1})"
        case Halt(n0):
            return f"halt({n0})"
        case Drop(s0):
            return f"drop({s0})"
        case Mark(1):
            return "mark-1"
        case Mark(n0):
            return f"mark({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Halt(x0):
            return x0
        case Drop(_):
            return 6
        case Emit(x0):
            return x0 * 2
        case Mark(x0):
            return x0
        case _:
            return 1
