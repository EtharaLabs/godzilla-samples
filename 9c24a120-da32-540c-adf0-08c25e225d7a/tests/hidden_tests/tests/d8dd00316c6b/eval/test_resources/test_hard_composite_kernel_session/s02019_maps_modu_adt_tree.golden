def show(t):
    match t:
        case Mark(n0) if n0 % 2 == 0:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Store():
            return f"store"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
