def describe(t):
    match t:
        case Drop(n0):
            return f"drop({n0})"
        case Halt(n0, s1) if n0 > 4:
            return f"halt!({n0},{s1})"
        case Halt(n0, s1):
            return f"halt({n0},{s1})"
        case Mark():
            return f"mark"
        case Pop(n0) if n0 % 2 == 0:
            return f"pop!({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Emit(n0) if n0 > 0:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Drop(x0):
            return x0 * 2
        case Mark():
            return 5
        case Halt(x0, _):
            return x0
        case Emit(x0):
            return x0 * 3
        case _:
            return 3
