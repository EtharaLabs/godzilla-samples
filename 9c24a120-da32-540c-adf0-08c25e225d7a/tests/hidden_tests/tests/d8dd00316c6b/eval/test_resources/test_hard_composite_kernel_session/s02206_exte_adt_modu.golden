00002078from dataclasses import dataclass
import functools
import math
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    _1: str
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    def __repr__(self):
        return f"Push({self._0!r})"
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(3))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
def explain(t):
    match t:
        case Emit(n0):
            return f"emit({n0})"
        case Pop(n0, s1):
            return f"pop({n0},{s1})"
        case Rest(n0):
            return f"rest({n0})"
        case Push(s0):
            return f"push({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Rest(x0):
            return x0
        case _:
            return 2
batch = [Push("bo"), Rest(1), Rest(10), Pop(-1, "oz")]
print(_pf_str_join("; ", _pf_map(explain, batch)))
total = _pf_sum_by(score, batch)
print(f"total={total}")
print(len(_pf_filter(lambda t: score(t) > 2, batch)))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_square(x):
    return x * x
obs = [15, 27, -14, -4, -2, 10, 16]
print(Geo_norm1(obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 8), obs))
print(Geo_scaleAll(4, obs))
print(_pf_map(Geo_square, obs))
