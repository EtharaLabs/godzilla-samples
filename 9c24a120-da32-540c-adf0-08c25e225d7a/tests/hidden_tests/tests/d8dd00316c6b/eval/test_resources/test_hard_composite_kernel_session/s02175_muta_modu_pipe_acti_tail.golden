00003463from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 3
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([60, 8, 25, -17, 46, 11, 54]))
doubled = _pf_map(note, [60, 8, 25, -17])
print(f"{doubled} after {calls} calls")
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_between(lo, hi, x):
    return lo <= x <= hi
obs = [30, 14, 13, 23, -7, 20, 2]
print(Text_norm1(obs))
print(_pf_map(functools.partial(Text_clamp, 0, 14), obs))
print(_pf_filter(functools.partial(Text_between, 5, 16), obs))
data = [19, 17, 27, 20, 27, 15]
def shift(k, x):
    return x + k
def accept(n):
    return n > 2 and n % 2 != 0
pipeline = lambda _pf_x: (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))((lambda _pf_x: _pf_drop(3, (lambda _pf_x: _pf_collect(lambda x: [x, x + 1], (lambda _pf_x: _pf_map(lambda b: 3 * b, _pf_take_while(lambda x: x < 44, _pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
digest = _pf_head(pipeline(data))
print(digest)
def _ap_Above(n):
    if n > 30:
        return Some(n - 30)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(kindOf, [36, 12, -4, 13, -2, 13]))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(74103))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(165, 268))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(6, 20, 1))
