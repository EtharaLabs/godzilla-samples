00003550from dataclasses import dataclass
import functools
import math
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
book = [Booking(100, "ivy", 115, False, Site("Baku", 2)), Booking(101, "ray", 10, True, Site("Lima", 2)), Booking(102, "ray", 25, False, Site("Rome", 2)), Booking(103, "ray", 276, True, Site("Doha", 3)), Booking(104, "ned", 176, False, Site("Baku", 1)), Booking(105, "ned", 114, True, Site("Kyiv", 4))]
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Booking(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
rerouted = _pf_map(_pf_fn0, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn1, (0, 0), book)
print(f"{cnt} records, {sumAmt} total")
def bucket(o):
    match o:
        case Booking(urgent=True, amount=amount) if amount > 63:
            return "rush-big"
        case Booking(urgent=True):
            return "rush"
        case Booking(amount=amount):
            if amount > 63:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, book))
print(_pf_count_by(bucket, book))
def bump2(pct, o):
    extra = o.amount * pct // 100
    _pf_t3 = o
    return Booking(_pf_t3.id, _pf_t3.owner, o.amount + extra, False, _pf_t3.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(bump2, 14), book)))
segments = [434.0, 362.1, 261.8, 57.7, 260.1]
times = [7.8, 71.6, 63.7, 76.8, 32.4]
dist = _pf_fold(lambda a, b: a + b, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
speed = dist / elapsed
print(_pf_fmt_fixed(2, speed))
mass = 67.0
accel = 7.5
push = mass * accel
limit = 83.0
print("over" if push > limit else "under")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
speeds = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
side = math.sqrt(25.0)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(4, 3, 1))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [52, 22, 28]))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(19, 209))
