00003766from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [5, 11, 11, 12]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(7))
def fromBin(s):
    return int(s, base=2)
print(fromBin("11101") + int("34", base=8))
print(_pf_map(math.isqrt, [275, 208, 6, 227]))
orders = [Ticket(100, "quin", 201, True), Ticket(101, "quin", 175, False), Ticket(102, "cy", 281, False), Ticket(103, "sue", 37, True), Ticket(104, "sue", 153, False), Ticket(105, "cy", 163, False)]
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, orders))))
cheap, dear = _pf_partition(lambda o: o.amount < 120, orders)
print(f"{len(cheap)} cheap, {len(dear)} dear")
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, orders))
print(urgentTotal)
def bucket(o):
    match o:
        case Ticket(urgent=True, amount=amount) if amount > 64:
            return "rush-big"
        case Ticket(urgent=True):
            return "rush"
        case Ticket(amount=amount):
            if amount > 64:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, orders))
print(_pf_count_by(bucket, orders))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 14:
        return Some(n - 14)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(bucketOf, [0, -3, 40, 18, 8, 27]))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(3, 20, 1))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [1, 28, 27, 14, 7]))
