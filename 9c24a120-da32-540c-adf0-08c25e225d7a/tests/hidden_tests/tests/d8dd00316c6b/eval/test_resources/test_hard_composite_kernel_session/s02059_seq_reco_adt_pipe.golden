def render(t):
    match t:
        case Skip(0):
            return "skip-0"
        case Skip(n0):
            return f"skip({n0})"
        case Load(s0):
            return f"load({s0})"
        case Store(s0):
            return f"store({s0})"
        case Drop(s0, n1):
            return f"drop({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
