import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def Log_bind(m, f):
    v, out = m
    w, more = f(v)
    return (w, _pf_concat(out, more))
def Log_return_(x):
    return (x, [])
def Log_returnFrom(m):
    return m
Log_zero = (0, ["zero"])
def Log_yield_(x):
    return (x, [f"yield {x}"])
def Log_yieldFrom(m):
    return m
def Log_combine(a, b):
    x, out = a
    y, more = b(0)
    return (x + y, _pf_concat(out, more))
def Log_delay(f):
    return f
def Log_for_(xs, f):
    def _pf_fn1(acc, x):
        def _pf_fn2(_):
            return f(x)
        return Log_combine(acc, _pf_fn2)
    return _pf_fold(_pf_fn1, (0, []), xs)
def tell(msg):
    return (None, [msg])
r = Log_bind(tell("a"), lambda _: (lambda k: Log_combine(Log_yieldFrom((k, [])), Log_delay(lambda _: Log_returnFrom((1, [])))))(2))
