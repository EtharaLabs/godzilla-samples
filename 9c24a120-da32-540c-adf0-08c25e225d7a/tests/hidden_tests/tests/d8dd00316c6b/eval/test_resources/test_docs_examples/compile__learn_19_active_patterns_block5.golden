from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _ap_Hot(c):
    if c >= 25:
        return Some(c)
    else:
        return _None_
def describe(c):
    _pf_t0 = _ap_Hot(c)
    if isinstance(_pf_t0, Some):
        t = _pf_t0._0
        return f"hot at {t}"
    else:
        return "not hot"
print(describe(30))
print(describe(5))
