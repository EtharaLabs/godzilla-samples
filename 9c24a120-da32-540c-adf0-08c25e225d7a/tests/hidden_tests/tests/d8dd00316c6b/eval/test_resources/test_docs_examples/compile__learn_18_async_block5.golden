import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
async def _pf_fn0():
    await asyncio.sleep(0.01)
    return "rested"
nap = _pf_Async(_pf_fn0)
print(asyncio.run(_pf_run(nap)))
