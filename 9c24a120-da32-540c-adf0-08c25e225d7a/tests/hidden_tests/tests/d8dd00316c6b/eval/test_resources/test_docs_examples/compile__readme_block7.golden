import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
describe = lambda _pf_x: _pf_fold(lambda a, b: a + b, 0, (lambda _pf_x: _pf_map(lambda b: 2 * b, _pf_filter(lambda x: x > 0, _pf_x)))(_pf_x))
total = describe([1, -2, 3])
