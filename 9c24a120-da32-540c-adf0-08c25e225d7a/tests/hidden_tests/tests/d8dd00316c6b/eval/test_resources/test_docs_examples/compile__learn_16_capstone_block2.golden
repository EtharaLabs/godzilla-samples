from dataclasses import dataclass
import functools
import json
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_dec_field(name, dec):
    def go(v):
        if not isinstance(v, dict):
            raise ValueError("expected a JSON object")
        return dec(v[name])
    return go
def _pf_dec_float(v):
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return float(v)
    raise ValueError("expected a float, got " + type(v).__name__)
def _pf_dec_map3(f, da, db, dc):
    def go(v):
        return f(da(v), db(v), dc(v))
    return go
def _pf_dec_string(v):
    if isinstance(v, str):
        return v
    raise ValueError("expected a string, got " + type(v).__name__)
@dataclass(frozen=True, slots=True)
class Run:
    name: str
    distance: float
    time: float
runDecoder = _pf_dec_map3(lambda n, d, t: Run(n, d, t), _pf_dec_field("name", _pf_dec_string), _pf_dec_field("distance", _pf_dec_float), _pf_dec_field("time", _pf_dec_float))
input = "[\n  {\"name\": \"ada\", \"distance\": 100.0, \"time\": 20.0},\n  {\"name\": \"bo\", \"distance\": 140.0, \"time\": 30.0}\n]"
_pf_t1 = lambda n, d, t: Run(n, d, t)
try:
    _pf_t2 = json.loads(input)
    if not isinstance(_pf_t2, list):
        raise ValueError("expected a JSON array")
    _pf_t3 = []
    for _pf_t4 in _pf_t2:
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t5 = _pf_t4["name"]
        if not isinstance(_pf_t5, str):
            raise ValueError("expected a string, got " + type(_pf_t5).__name__)
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t6 = _pf_t4["distance"]
        if not (isinstance(_pf_t6, (int, float)) and not isinstance(_pf_t6, bool)):
            raise ValueError("expected a float, got " + type(_pf_t6).__name__)
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t7 = _pf_t4["time"]
        if not (isinstance(_pf_t7, (int, float)) and not isinstance(_pf_t7, bool)):
            raise ValueError("expected a float, got " + type(_pf_t7).__name__)
        _pf_t3.append(_pf_t1(_pf_t5, float(_pf_t6), float(_pf_t7)))
    _pf_t8 = Ok(_pf_t3)
except Exception as e:
    _pf_t8 = Error(_Exception(type(e).__name__, str(e)))
if isinstance(_pf_t8, Ok):
    runs = _pf_t8._0
    names = _pf_str_join(", ", _pf_map(lambda r: r.name, runs))
    dist = _pf_fold(lambda a, r: a + r.distance * 1.0, 0.0, runs)
    time = _pf_fold(lambda a, r: a + r.time * 1.0, 0.0, runs)
    avg = dist / time
    _pf_t0 = f"{names}: average speed {avg} m/s over {len(runs)} runs"
else:
    e = _pf_t8._0
    _pf_t0 = f"could not read input ({e.errorKind})"
report = _pf_t0
print(report)
