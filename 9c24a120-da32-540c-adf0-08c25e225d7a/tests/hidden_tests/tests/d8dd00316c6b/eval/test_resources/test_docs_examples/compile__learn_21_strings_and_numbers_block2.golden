def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_grouped(x):
    return format(x, ",")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_fmt_thousands(n, x):
    return format(x, f",.{n}f")
print(_pf_fmt_fixed(2, 3.14159))
print(_pf_fmt_thousands(2, 1234567.891))
print(_pf_fmt_grouped(1234567))
print(_pf_fmt_percent(1, 0.256))
print(_pf_fmt_pad_left(8, " ", "42"))
