from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
def eval(e):
    match e:
        case Num(n):
            return n
        case Add(l, r):
            return eval(l) + eval(r)
        case Mul(l, r):
            return eval(l) * eval(r)
        case _:
            raise RuntimeError("non-exhaustive match")
tree = Add(Num(1), Mul(Num(2), Num(3)))
print(eval(tree))
