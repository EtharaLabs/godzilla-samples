from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_float(s):
    try:
        return Some(float(s))
    except ValueError:
        return _None_
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
title = _pf_str_concat("Hello, ", "World")
loud = _pf_str_upper(title)
words = _pf_str_split(", ", title)
csv = _pf_str_join(",", words)
first5 = _pf_str_slice(0, 5, title)
print(title)
print(loud)
print(words)
print(csv)
print(first5)
print(_pf_option_with_default(0, _pf_str_to_int("41")))
print(_pf_option_with_default(0, _pf_str_to_int("x")))
print(_pf_option_with_default(0.0, _pf_str_to_float("2.5")))
