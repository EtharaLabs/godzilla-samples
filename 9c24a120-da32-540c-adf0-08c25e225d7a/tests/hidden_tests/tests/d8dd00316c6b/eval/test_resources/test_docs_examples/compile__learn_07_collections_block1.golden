from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
ns = [1, 2, 3, 4, 5]
squares = _pf_map(lambda x: x * x, ns)
bigs = _pf_filter(lambda x: x > 2, ns)
total = _pf_fold(lambda a, b: a + b, 0, ns)
doubled = _pf_map(lambda b: 2 * b, ns)
third = _pf_option_with_default(0, _pf_list_get(2, ns))
missing = _pf_option_with_default(0, _pf_list_get(9, ns))
uniq = set([1, 1, 2, 3])
scores = _pf_map_add("ada", 10, dict())
print(squares)
print(bigs)
print(total)
print(doubled)
print(third)
print(missing)
print(len(uniq))
