def describe(xs):
    match xs:
        case []:
            return "empty"
        case [only]:
            return f"just {only}"
        case [first, *mid, last]:
            return f"{first} ... {last}"
        case _:
            raise RuntimeError("non-exhaustive match")
print(describe([]))
print(describe([7]))
print(describe([1, 2, 3, 4]))
