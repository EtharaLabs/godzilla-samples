from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def describe(s):
    _pf_t0 = _pf_str_to_int(s)
    if isinstance(_pf_t0, Some):
        n = _pf_t0._0
        return f"got the number {n}"
    else:
        return "not a number"
print(describe("41"))
print(describe("hello"))
ns = [10, 20, 30]
third = _pf_option_with_default(0, _pf_list_get(2, ns))
missing = _pf_option_with_default(0, _pf_list_get(9, ns))
print(third)
print(missing)
