def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_str_join(sep, xs):
    return sep.join(xs)
names = ["ada", "alan"]
scores = [10, 9]
def line(pair):
    match pair:
        case (name, score):
            return f"{name}: {score}"
lines = _pf_map(line, _pf_zip(names, scores))
print(_pf_str_join(", ", lines))
