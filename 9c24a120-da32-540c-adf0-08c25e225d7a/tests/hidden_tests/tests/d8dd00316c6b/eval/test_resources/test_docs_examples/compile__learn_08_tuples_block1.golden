from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def swap(p):
    match p:
        case (a, b):
            return (b, a)
names = ["ada", "alan"]
scores = [10, 9]
def line(pair):
    match pair:
        case (name, score):
            return f"{name}: {score}"
lines = _pf_map(line, _pf_zip(names, scores))
byName = dict(_pf_zip(names, scores))
adaScore = _pf_option_with_default(0, _pf_map_try_find("ada", byName))
print(swap((1, 2)))
print(lines)
print(_pf_map_to_list(byName))
print(adaScore)
