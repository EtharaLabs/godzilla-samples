from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
raw: str = "rod;cy;lu;pam"
parts: list[str] = _pf_str_split(";", raw)
longest: Some | None_ = _pf_head(_pf_sort_by(lambda w: -len(w), parts))
print(_pf_option_with_default("?", longest))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), parts)))
print(_pf_str_slice(1, 6, raw))
count: int = len(parts)
print(f"count={count} {{braces}} {len(raw)}")
print(_pf_str_replace("o", "O", raw))
print((_pf_str_index_of("cy", raw), "cy" in raw))
segments: list[float] = [103.4, 320.9, 405.4, 251.1]
durations: list[float] = [31.4, 12.5, 44.5, 84.1]
total: float = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate: float = total / dur
print(_pf_fmt_fixed(3, rate))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(segments, durations))
print(best)
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
edge: float = math.sqrt(9.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def unwrap(x) -> str:
    s = x
    return s
def makeIds(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("sku", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
