from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Addr"
def net(price: int, qty: int) -> int:
    return price * qty - 2 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("wick", 37, 5), ("cog", 21, 6), ("pin", 8, 3), ("wick", 10, 4)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(19)([1, 2, 3]))
tickets: list[Invoice] = [Invoice(100, "dee", 72, False, Addr("Bern", 3)), Invoice(101, "sue", 149, False, Addr("Doha", 3)), Invoice(102, "fay", 83, True, Addr("Kyiv", 1)), Invoice(103, "fay", 111, False, Addr("Oslo", 4))]
def adjust(pct: int, o: Invoice) -> Invoice:
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Invoice(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 8), tickets)))
def _pf_fn1(o):
    if o.dest.zone > 2:
        _pf_t3 = o
        return Invoice(_pf_t3.id, _pf_t3.owner, _pf_t3.amount, _pf_t3.urgent, Addr("Hub", 1))
    else:
        return o
rerouted: list[Invoice] = _pf_map(_pf_fn1, tickets)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
cheap, dear = _pf_partition(lambda o: o.amount < 105, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, tickets))))
sentence: str = "tap;hub;kit;max;dee;gear"
words: list[str] = _pf_str_split(";", sentence)
print((_pf_str_index_of("de", sentence), "de" in sentence))
nums: list[Some | None_] = _pf_map(_pf_str_to_int, _pf_str_split(",", ",7,-3,-3,7"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
def row2(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(6, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(words)))
longest: Some | None_ = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
def rawOf(x) -> str:
    s = x
    return s
def makeIds(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("u", 2)
print(_pf_str_join(" ", _pf_map(rawOf, ids)))
print(_pf_head(ids) == Some("u-1"))
