def render(t: Signal) -> str:
    if isinstance(t, Push):
        n0 = t._0
        return f"push({n0})"
    elif isinstance(t, Load):
        n0 = t._0
        return f"load({n0})"
    elif isinstance(t, Jump):
        n0 = t._0
        return f"jump({n0})"
    else:
