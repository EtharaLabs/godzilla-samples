from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
samples: list[int] = [32, 40, -9, -1, 50, -10, 9]
def addK(k: int, x: int) -> int:
    return x + k
def accept(n: int) -> bool:
    return n > 19 and n % 5 != 0
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
answer: Some | None_ = _pf_list_find(lambda x: x % 3 == 1, _pf_filter(accept, _pf_sort(_pf_take(5, _pf_fn1(samples)))))
print(answer)
print(len(samples))
hits: int = 0
def track(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 2
def profile(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-19, 1, -3, 46, 20, 39, 28, 29]))
doubled: list[int] = _pf_map(track, [-19, 1, -3, 46])
print(f"{doubled} after {hits} calls")
sentence: str = "ned,cap,jo,fay"
words: list[str] = _pf_str_split(",", sentence)
count: int = len(words)
print(f"count={count} {{braces}} {len(sentence)}")
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
parcels: list[Ticket] = [Ticket(100, "jo", 125, True), Ticket(101, "ned", 30, False), Ticket(102, "ada", 94, True), Ticket(103, "ned", 48, False), Ticket(104, "jo", 161, True), Ticket(105, "ned", 141, True)]
def label(o: Ticket) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, parcels)))
cheap, dear = _pf_partition(lambda o: o.amount < 112, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def _pf_fn3(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn3, (0, 0), parcels)
print(f"{cnt} records, {sumAmt} total")
def adjust(o: Ticket) -> Ticket:
    if o.urgent:
        _pf_t1 = o
        return Ticket(_pf_t1.id, _pf_t1.owner, o.amount + 6, _pf_t1.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(adjust, parcels)))
