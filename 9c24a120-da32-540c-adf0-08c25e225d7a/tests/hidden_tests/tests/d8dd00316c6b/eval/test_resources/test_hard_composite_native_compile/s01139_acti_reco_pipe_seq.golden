from dataclasses import dataclass
from typing import Any
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Place"
def _ap_Above(n):
    if n > 28:
        return Some(n - 28)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(kindOf, [33, 15, 27, 37, 27, -4, 31, 38]))
parcels: list[Parcel] = [Parcel(100, "kit", 138, False, Place("Bern", 4)), Parcel(101, "kit", 56, False, Place("Lima", 4)), Parcel(102, "pam", 172, False, Place("Baku", 1)), Parcel(103, "tom", 6, True, Place("Baku", 3)), Parcel(104, "pam", 44, True, Place("Riga", 2))]
def label(_pf_arg0: Parcel) -> str:
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(label, parcels)))
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(rushSum)
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, amt = _pf_fold(_pf_fn0, (0, 0), parcels)
print(f"{nrec} records, {amt} total")
readings: list[int] = [5, 38, 40, 14, 45, 41]
def addK(k: int, x: int) -> int:
    return x + k
stage = lambda _pf_x: _pf_drop(2, (lambda _pf_x: _pf_map(lambda b: 5 * b, (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))(_pf_x)))(_pf_x))
result: str = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(stage(readings))
print(result)
print(len(readings))
def _pf_fn1():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
series = _pf_fn1()
print(_pf_fold(lambda a, b: a + b, 0, series))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
