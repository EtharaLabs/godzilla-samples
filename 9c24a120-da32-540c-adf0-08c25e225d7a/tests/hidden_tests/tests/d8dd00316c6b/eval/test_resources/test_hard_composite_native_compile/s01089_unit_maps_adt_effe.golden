from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    _1: str
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    _1: int
    def __repr__(self):
        return f"Halt({self._0!r}, {self._1!r})"
Signal = Store | Pop | Push | Halt
legs: list[float] = [460.1, 90.6, 286.7, 272.1]
times: list[float] = [44.6, 61.6, 35.1, 75.5]
dist: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
rate: float = dist / dur
print(_pf_fmt_fixed(2, rate))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(legs, times))
print(best)
events: list[str] = ["cy", "dee", "bo", "dee", "fay", "cy"]
m = dict()
for w in events:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
hist: dict[str, int] = m
def _pf_fn1(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn1, _pf_map_to_list(hist)))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(hist))))
print((_pf_map_try_find("gus", hist), "gus" in hist))
def render(t: Signal) -> str:
    if isinstance(t, Store):
        n0 = t._0
        if n0 > 3:
            return f"store!({n0})"
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    elif isinstance(t, Pop):
        n0 = t._0
        s1 = t._1
        return f"pop({n0},{s1})"
    elif isinstance(t, Push):
        s0 = t._0
        return f"push({s0})"
    else:
        s0 = t._0
        n1 = t._1
        return f"halt({s0},{n1})"
def rank(t: Signal) -> int:
    if isinstance(t, Store):
        x0 = t._0
        return x0
    elif isinstance(t, Pop):
        x0 = t._0
        return x0 * 4
    elif isinstance(t, Halt):
        x1 = t._1
        return x1
    else:
        return 3
queue: list[Signal] = [Halt("ray", 2), Pop(8, "oz"), Push("gus"), Push("gus"), Push("cy")]
print(_pf_map(render, queue))
grandSum: int = _pf_sum_by(rank, queue)
print(f"grandSum={grandSum}")
print(len(_pf_filter(lambda t: rank(t) > 1, queue)))
def discount(price: int, qty: int) -> int:
    return price * qty - 7 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn2(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall: int = sum(_pf_map(_pf_fn2, [("tap", 28, 5), ("rod", 15, 4), ("cog", 13, 4), ("tap", 16, 1)]))
print(overall)
