    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(6, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(words)))
def readPair(line: str) -> Some | None_:
    def _pf_fn0():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t1, Some):
            v = _pf_t1._0
            _pf_t0 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some(n * 4)
