from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Addr"
parcels: list[Invoice] = [Invoice(100, "sue", 122, False, Addr("Doha", 4)), Invoice(101, "oz", 293, True, Addr("Bern", 1)), Invoice(102, "sue", 62, True, Addr("Kyiv", 1)), Invoice(103, "sue", 287, False, Addr("Rome", 3)), Invoice(104, "oz", 5, True, Addr("Bern", 3))]
def tag(_pf_arg0: Invoice) -> str:
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, parcels)))
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by_desc(lambda o: o.amount, parcels))))
cheap, dear = _pf_partition(lambda o: o.amount < 141, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def bucket(o: Invoice) -> str:
    if isinstance(o, Invoice) and o.urgent is True:
        amount = o.amount
        if amount > 126:
            return "rush-big"
    if isinstance(o, Invoice) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 126:
            return "big"
        else:
            return "normal"
print(_pf_map(bucket, parcels))
print(_pf_count_by(bucket, parcels))
segments: list[float] = [379.7, 251.5, 337.1, 302.4, 407.7]
times: list[float] = [24.6, 75.1, 17.9, 33.3, 22.7]
total: float = _pf_fold(lambda a, b: a + b, 0.0, segments)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, times)
rate: float = total / elapsed
print(_pf_fmt_fixed(3, rate))
mass: float = 23.0
accel: float = 7.5
push: float = mass * accel
limit: float = 250.0
print("over" if push > limit else "under")
speeds: list[float] = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("110100") + int("60", base=8))
def safe(s: str) -> str:
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x7", "7"]))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_square(x):
    return x * x
def Geo_between(lo, hi, x):
    return lo <= x <= hi
pts: list[int] = [2, 10, 27, 5, 13, -12, -11]
print(Geo_norm1(pts))
print(_pf_map(Geo_square, pts))
print(_pf_filter(functools.partial(Geo_between, -3, 16), pts))
