import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
hits: int = 0
def track(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 3
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([-2, 47, -7, 5, 17, 32, 42]))
doubled: list[int] = _pf_map(track, [-2, 47, -7, 5])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
segments: list[float] = [24.8, 461.3, 77.0]
splits: list[float] = [54.3, 74.9, 10.2]
dist: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate: float = dist / dur
print(_pf_fmt_fixed(2, rate))
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_square(x):
    return x * x
pts: list[int] = [-2, 27, 20, 17, 5, 17, 11]
print(Calc_norm1(pts))
print(_pf_filter(functools.partial(Calc_between, -2, 16), pts))
print(_pf_map(Calc_square, pts))
data: list[int] = [-5, 39, 6, 30, -10, 42, 23]
def shift(k: int, x: int) -> int:
    return x + k
def keep(n: int) -> bool:
    return n > 10 and n % 4 != 0
pipeline = lambda _pf_x: _pf_drop(1, (lambda _pf_x: _pf_sort((lambda _pf_x: _pf_filter(lambda x: x % 2 == 1, _pf_collect(lambda x: [x, x + 1], _pf_x)))(_pf_x)))(_pf_x))
digest: int = sum(pipeline(data))
print(digest)
print(len(data))
