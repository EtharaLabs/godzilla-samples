from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Tree"
    _1: int
    _2: "Tree"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Tree = Leaf | Node
readings: list[int] = [38, 9, 17, 29, -8, 25, 42, -9, 41, 27]
def shift(k: int, x: int) -> int:
    return x + k
pipeline = lambda _pf_x: _pf_rev((lambda _pf_x: _pf_map(functools.partial(shift, 7), (lambda _pf_x: _pf_filter(lambda x: x % 2 == 1, (lambda _pf_x: _pf_drop(1, (lambda _pf_x: _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), _pf_sort(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
result: int = _pf_sum_by(lambda x: x * x, pipeline(readings))
print(result)
print(len(readings))
def add(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(add(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, add(x, rt))
        return t
root: Tree = _pf_fold(lambda acc, x: add(x, acc), _Leaf, [48, 13, 10, 59, 40, 50])
def toListT(t: Tree) -> list[int]:
    if isinstance(t, Leaf):
        return []
    else:
        l = t._0
        v = t._1
        rt = t._2
        return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
print(toListT(root))
def sumOf(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumOf(l) + v + sumOf(rt)
print(sumOf(root))
def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(5, 17, 1))
def euclid(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(364, 350))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [1, 6, 9, 9, 6]))
