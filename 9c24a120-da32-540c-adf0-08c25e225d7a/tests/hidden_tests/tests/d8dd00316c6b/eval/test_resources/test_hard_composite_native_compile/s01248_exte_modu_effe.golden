from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
def safe(s: str) -> str:
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x3", "-21"]))
print(_pf_str_rev(str.upper("tom")))
print(_pf_map(math.isqrt, [308, 197, 256, 295]))
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
nums: list[int] = [3, 2, 21, 11, 8, 27]
print(_pf_map(functools.partial(Stats_clamp, 0, 10), nums))
print(Stats_mean(nums))
print(Stats_norm1(nums))
def discount(price: int, qty: int) -> int:
    return price * qty - 8 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("hub", 9, 2), ("tap", 9, 3), ("pin", 13, 3)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(18)([1, 2, 3]))
