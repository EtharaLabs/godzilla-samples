import functools
import itertools
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
data: list[int] = [12, 10, 39, 6, 27, -9]
def isBig(n: int) -> bool:
    return n > 16 and n % 3 != 0
def _pf_fn7(_pf_x):
    def _pf_fn11(_pf_x):
        def _pf_fn13(_pf_x):
            def _pf_fn14(_pf_arg0):
                a, b = _pf_arg0
                return b - a
            return _pf_map(_pf_fn14, _pf_pairwise(_pf_x))
        return _pf_fn13((lambda _pf_x: _pf_drop(3, _pf_rev(_pf_x)))(_pf_x))
    return _pf_sort(_pf_fn11(_pf_x))
process = _pf_fn7
result: int = _pf_sum_by(lambda x: x * x, process(data))
print(result)
ticks: int = 0
def track(x: int) -> int:
    global ticks
    ticks = ticks + 1
    return x * 2
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([24, 23, 60, -18, 52]))
doubled: list[int] = _pf_map(track, [24, 23, 60, -18])
print(f"{doubled} after {ticks} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), ticks))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
nums: list[int] = [2, 29, 14, 3, 5, 22, 25]
print(Geo_scaleAll(5, nums))
print(Geo_norm1(nums))
print(_pf_filter(functools.partial(Geo_between, -5, 17), nums))
