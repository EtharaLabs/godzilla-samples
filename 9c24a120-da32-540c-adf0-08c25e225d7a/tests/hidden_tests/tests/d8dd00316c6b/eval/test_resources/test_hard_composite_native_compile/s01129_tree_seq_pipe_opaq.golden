Ast = Num | Add | Mul | Neg | Var
vars: dict[str, int] = dict([("x", 4), ("y", -2)])
def evaluate(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evaluate(a) + evaluate(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evaluate(a) * evaluate(b)
    elif isinstance(e, Neg):
        a = e._0
        return -evaluate(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, vars)
def show(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({show(a)} + {show(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{show(a)} * {show(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{show(a)}"
    else:
        v = e._0
        return v
terms: list[Ast] = [Add(Add(Num(5), Num(0)), Add(Num(0), Add(Num(1), Var("y")))), Mul(Var("y"), Neg(Mul(Var("y"), Var("y"))))]
_pf_iter(print, _pf_map(show, terms))
