from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
def discount(price: int, qty: int) -> int:
    return price * qty - 8 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("rod", 8, 3), ("rod", 32, 5), ("bolt", 25, 3), ("nut", 13, 5)]))
print(overall)
book: list[Order] = [Order(100, "ivy", 122, False), Order(101, "fay", 262, True), Order(102, "fay", 7, False), Order(103, "ivy", 174, True)]
def bump2(o: Order) -> Order:
    if o.urgent:
        _pf_t0 = o
        return Order(_pf_t0.id, _pf_t0.owner, o.amount + 11, _pf_t0.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(bump2, book)))
def bucket(o: Order) -> str:
    if isinstance(o, Order) and o.urgent is True:
        amount = o.amount
        if amount > 63:
            return "rush-big"
    if isinstance(o, Order) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 63:
            return "big"
        else:
            return "normal"
print(_pf_map(bucket, book))
print(_pf_count_by(bucket, book))
def tag(o: Order) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, book)))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_square(x):
    return x * x
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums: list[int] = [20, 23, 0, 0, 20, -11]
print(_pf_map(functools.partial(Geo_clamp, 0, 12), nums))
print(_pf_map(Geo_square, nums))
print(Geo_mean(nums))
segments: list[float] = [161.7, 269.7, 460.7]
times: list[float] = [55.0, 29.6, 83.0]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
rate: float = dist / dur
print(_pf_fmt_fixed(1, rate))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
mass: float = 36.0
accel: float = 6.5
push: float = mass * accel
limit: float = 384.0
print("over" if push > limit else "under")
speeds: list[float] = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
