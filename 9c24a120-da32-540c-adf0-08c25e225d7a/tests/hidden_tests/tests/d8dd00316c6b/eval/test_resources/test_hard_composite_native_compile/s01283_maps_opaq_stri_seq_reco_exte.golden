from dataclasses import dataclass
from typing import Any
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Place"
events: list[str] = ["dee", "fay", "eli", "bo", "eli", "ada", "bo", "cy"]
m = dict()
for w in events:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
hist: dict[str, int] = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(hist)))
extra: dict[str, int] = dict([("zed", 5), ("dee", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, hist))))
print(len(_pf_map_filter(lambda k, v: v > 1, hist)))
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("acc", 4)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
sentence: str = "pam;cy;fay;lu;bolt;tom"
tokens: list[str] = _pf_str_split(";", sentence)
longest: Some | None_ = _pf_head(_pf_sort_by(lambda w: -len(w), tokens))
print(_pf_option_with_default("?", longest))
print(_pf_map(lambda w: (w, len(w)), tokens))
print(_pf_str_slice(2, 9, sentence))
print((_pf_str_index_of("to", sentence), "to" in sentence))
fieldsN: list[Some | None_] = _pf_map(_pf_str_to_int, _pf_str_split(",", "x,5a,,7,x"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
def _pf_fn1():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
    yield 130
squares = _pf_fn1()
print(list(_pf_seq_take(3, map(lambda n: n + 1, squares))))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1895, fib)))
book: list[Order] = [Order(100, "kit", 252, False, Place("Kyiv", 1)), Order(101, "kit", 241, True, Place("Oslo", 2)), Order(102, "ray", 98, False, Place("Bern", 2)), Order(103, "kit", 210, True, Place("Baku", 2))]
def _pf_fn3(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn3, _pf_group_by(lambda o: o.owner, book))
print(byOwner)
urgentTotal: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(urgentTotal)
def tag(_pf_arg0: Order) -> str:
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, book)))
def row(n: int) -> list[int]:
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(3))
print(_pf_str_rev(str.upper("max")))
print(_pf_map(math.isqrt, [354, 391, 197, 82]))
