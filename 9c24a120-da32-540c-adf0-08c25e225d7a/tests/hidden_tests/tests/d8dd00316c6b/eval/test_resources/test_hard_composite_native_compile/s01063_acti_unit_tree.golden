from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Expr"
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
Expr = Num | Add | Mul | Neg | Var
def _ap_Above(n):
    if n > 9:
        return Some(n - 9)
    else:
        return _None_
def classify(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [7, 23, 35, 8, 25]))
segments: list[float] = [488.7, 121.8, 425.2, 368.8, 95.2]
durations: list[float] = [52.0, 14.8, 24.8, 74.1, 75.7]
total: float = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed: float = total / elapsed
print(_pf_fmt_fixed(1, speed))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
speeds: list[float] = _pf_map2(lambda d, t: d / t, segments, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
edge: float = math.sqrt(36.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
env: dict[str, int] = dict([("x", 7), ("y", -4)])
def calc(e: Expr) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return calc(a) + calc(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return calc(a) * calc(b)
    elif isinstance(e, Neg):
        a = e._0
        return -calc(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, env)
def show(e: Expr) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({show(a)} + {show(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{show(a)} * {show(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{show(a)}"
    else:
        v = e._0
        return v
def shrink(e: Expr) -> Expr:
    while True:
        if isinstance(e, Add) and isinstance(e._0, Num) and e._0._0 == 0:
            x = e._1
            e = x
            continue
        elif isinstance(e, Add) and isinstance(e._1, Num) and e._1._0 == 0:
            x = e._0
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 1:
            x = e._1
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 1:
            x = e._0
            e = x
            continue
        elif isinstance(e, Neg) and isinstance(e._0, Neg):
            x = e._0._0
            e = x
            continue
        elif isinstance(e, Add):
            a = e._0
            b = e._1
            return Add(shrink(a), shrink(b))
        elif isinstance(e, Mul):
            a = e._0
            b = e._1
            return Mul(shrink(a), shrink(b))
        else:
            return e
exprs: list[Expr] = [Var("y"), Add(Num(1), Add(Num(1), Mul(Num(9), Num(7)))), Num(-2)]
_pf_iter(print, _pf_map(show, _pf_map(shrink, exprs)))
print(_pf_map(calc, exprs))
