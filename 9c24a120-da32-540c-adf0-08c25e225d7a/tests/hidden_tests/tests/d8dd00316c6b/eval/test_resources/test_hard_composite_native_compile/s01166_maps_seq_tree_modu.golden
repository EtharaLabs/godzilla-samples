def evalE(e: Expr) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    else:
        a = e._0
        return -evalE(a)
def show(e: Expr) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({show(a)} + {show(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{show(a)} * {show(b)}"
    else:
        a = e._0
        return f"-{show(a)}"
def shrink(e: Expr) -> Expr:
    while True:
        if isinstance(e, Add) and isinstance(e._0, Num) and e._0._0 == 0:
            x = e._1
            e = x
            continue
        elif isinstance(e, Add) and isinstance(e._1, Num) and e._1._0 == 0:
            x = e._0
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 1:
            x = e._1
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 1:
            x = e._0
            e = x
            continue
        elif isinstance(e, Neg) and isinstance(e._0, Neg):
            x = e._0._0
            e = x
            continue
        elif isinstance(e, Add):
            a = e._0
            b = e._1
            return Add(shrink(a), shrink(b))
        elif isinstance(e, Mul):
            a = e._0
            b = e._1
            return Mul(shrink(a), shrink(b))
        else:
            return e
