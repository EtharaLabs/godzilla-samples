from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: int
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    def __repr__(self):
        return "Mark"
_Mark: Mark = Mark()
Signal = Store | Pop | Turn | Mark
def margin(price: int, qty: int) -> int:
    return price * qty - 6 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("pin", 24, 3), ("wick", 17, 5)]))
print(overall)
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 11:
        return Some(n - 11)
    else:
        return _None_
def kindOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif isinstance(_pf_t1, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [5, 0, 30, 19, 31, 28, 2]))
def show(t: Signal) -> str:
    if isinstance(t, Store):
        n0 = t._0
        if 0 <= n0 < 11:
            return f"store!({n0})"
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    else:
        if isinstance(t, Pop):
            n0 = t._0
            if 0 <= n0 < 20:
                return f"pop!({n0})"
        if isinstance(t, Pop):
            n0 = t._0
            return f"pop({n0})"
        elif isinstance(t, Turn):
            n0 = t._0
            n1 = t._1
            return f"turn({n0},{n1})"
        else:
            return f"mark"
def weight(t: Signal) -> int:
    if isinstance(t, Mark):
        return 7
    elif isinstance(t, Store):
        x0 = t._0
        return x0
    elif isinstance(t, Turn):
        x0 = t._0
        x1 = t._1
        return x0 + x1 * 4
    else:
        return 1
batch: list[Signal] = [Pop(1), Pop(0), Store(12), Store(5), _Mark, _Mark]
print(_pf_str_join(" ", _pf_map(show, batch)))
tally: int = _pf_sum_by(weight, batch)
print(f"tally={tally}")
print((_pf_head(batch), _pf_last(batch)))
def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(2, 13, 1))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [22, 0, 26, 30, 3]))
