from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
parcels: list[Parcel] = [Parcel(100, "tom", 155, False, Site("Oslo", 3)), Parcel(101, "fay", 46, True, Site("Kyiv", 2)), Parcel(102, "fay", 31, False, Site("Bern", 4)), Parcel(103, "ada", 209, False, Site("Kyiv", 1)), Parcel(104, "tom", 297, True, Site("Rome", 3))]
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Parcel(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
moved: list[Parcel] = _pf_map(_pf_fn0, parcels)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by_desc(lambda o: o.amount, parcels))))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn1, (0, 0), parcels)
print(f"{cnt} records, {amt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 153, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def bump2(pct: int, o: Parcel) -> Parcel:
    extra = o.amount * pct // 100
    _pf_t3 = o
    return Parcel(_pf_t3.id, _pf_t3.owner, o.amount + extra, False, _pf_t3.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(bump2, 13), parcels)))
sentence: str = "bo hal tap eli oz"
tokens: list[str] = _pf_str_split(" ", sentence)
print((_pf_str_index_of("oz", sentence), "oz" in sentence))
def row2(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(7, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(tokens)))
print(_pf_str_replace("i", "I", sentence))
def net(price: int, qty: int) -> int:
    return price * qty - 4 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn2(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn2, [("rod", 37, 3), ("wick", 25, 6), ("nut", 8, 3), ("tap", 24, 1)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(9)([1, 2, 3]))
laps: list[float] = [229.6, 217.6, 95.4]
times: list[float] = [11.7, 18.8, 6.8]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
speed: float = total / dur
print(_pf_fmt_fixed(3, speed))
def _pf_fn3(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn3, _pf_zip(laps, times))
print(best)
side: float = math.sqrt(49.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
