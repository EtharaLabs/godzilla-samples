from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
ticks: int = 0
def track(x: int) -> int:
    global ticks
    ticks = ticks + 1
    return x * 4
def profile(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([38, 49, 25, 3, 41, 58]))
doubled: list[int] = _pf_map(track, [38, 49, 25, 3])
print(f"{doubled} after {ticks} calls")
laps: list[float] = [96.8, 311.5, 482.2, 23.9, 452.6]
splits: list[float] = [10.9, 28.8, 85.8, 88.3, 13.1]
total: float = _pf_fold(lambda a, b: a + b, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate: float = total / dur
print(_pf_fmt_fixed(2, rate))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(laps, splits))
print(best)
mass: float = 85.0
accel: float = 9.5
push: float = mass * accel
limit: float = 288.0
print("over" if push > limit else "under")
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_between(lo, hi, x):
    return lo <= x <= hi
nums: list[int] = [30, 3, 28, 0]
print(Text_mean(nums))
print(Text_norm1(nums))
print(_pf_map(functools.partial(Text_clamp, 0, 7), nums))
print(_pf_filter(functools.partial(Text_between, 3, 15), nums))
