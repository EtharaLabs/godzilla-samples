        return o._0
    return d
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
