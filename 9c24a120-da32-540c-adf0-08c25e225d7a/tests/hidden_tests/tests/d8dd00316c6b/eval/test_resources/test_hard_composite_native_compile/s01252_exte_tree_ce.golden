print(_pf_fold(lcm, 1, [5, 8, 12, 2]))
def insert(x: int, t: Heap) -> Heap:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
tree: Heap = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [30, 6, 36, 27, 21])
def sumT(t: Heap) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumT(l) + v + sumT(rt)
print(sumT(tree))
def minOf(t: Heap) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
