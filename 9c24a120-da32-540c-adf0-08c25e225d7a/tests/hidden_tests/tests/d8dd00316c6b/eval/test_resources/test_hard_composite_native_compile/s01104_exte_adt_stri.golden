from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    _1: int
    def __repr__(self):
        return f"Rest({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    _1: int
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
Action = Mark | Rest | Push | Drop
def safe(s: str) -> str:
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x7", "32"]))
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("1000010") + int("100", base=8))
def show(t: Action) -> str:
    if isinstance(t, Mark):
        n0 = t._0
        if n0 % 2 == 0:
            return f"mark!({n0})"
    if isinstance(t, Mark):
        n0 = t._0
        return f"mark({n0})"
    elif isinstance(t, Rest) and t._0 == 0:
        return "rest-0"
    elif isinstance(t, Rest):
        n0 = t._0
        n1 = t._1
        return f"rest({n0},{n1})"
    elif isinstance(t, Push):
        s0 = t._0
        n1 = t._1
        return f"push({s0},{n1})"
    elif isinstance(t, Drop) and t._0 == 2:
        return "drop-2"
    else:
        n0 = t._0
        n1 = t._1
        return f"drop({n0},{n1})"
def cost(t: Action) -> int:
    if isinstance(t, Mark):
        x0 = t._0
        return x0 * 4
    elif isinstance(t, Drop):
        x0 = t._0
        x1 = t._1
        return x0 + x1 * 2
    else:
        return 0
stream: list[Action] = [Rest(10, 0), Mark(10), Push("sue", -1), Mark(-1), Mark(4), Mark(11), Mark(6)]
print(_pf_str_join("; ", _pf_map(show, stream)))
total: int = _pf_sum_by(cost, stream)
print(f"total={total}")
print((_pf_head(stream), _pf_last(stream)))
text: str = "bo lu cap bolt hub jo pam"
tokens: list[str] = _pf_str_split(" ", text)
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, tokens))))
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
print(_pf_str_slice(3, 8, text))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), tokens)))
print((_pf_str_index_of("bo", text), "bo" in text))
longest: Some | None_ = _pf_head(_pf_sort_by(lambda w: -len(w), tokens))
print(_pf_option_with_default("?", longest))
