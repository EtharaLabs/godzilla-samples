from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Ast"
    def __repr__(self):
        return f"Neg({self._0!r})"
Ast = Num | Add | Mul | Neg
segments: list[float] = [352.7, 196.9, 338.3, 442.3, 306.3]
times: list[float] = [77.3, 63.8, 41.2, 85.7, 12.2]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
rate: float = total / dur
print(_pf_fmt_fixed(3, rate))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(segments, times))
print(best)
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
speeds: list[float] = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
mass: float = 28.0
accel: float = 7.5
push: float = mass * accel
limit: float = 272.0
print("over" if push > limit else "under")
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n: int) -> str:
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [-2, -3, 31, 40, 8, -6]))
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_square(x):
    return x * x
pts: list[int] = [-1, 0, 28, 23, -14, 29]
print(_pf_map(functools.partial(Stats_clamp, 0, 16), pts))
print(Stats_norm1(pts))
print(_pf_map(Stats_square, pts))
def evalE(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    else:
        a = e._0
        return -evalE(a)
def pretty(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({pretty(a)} + {pretty(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{pretty(a)} * {pretty(b)}"
    else:
        a = e._0
        return f"-{pretty(a)}"
exprs: list[Ast] = [Num(-1), Add(Mul(Add(Num(3), Num(8)), Mul(Num(-2), Num(9))), Num(2)), Mul(Num(8), Num(5))]
_pf_iter(print, _pf_map(pretty, exprs))
print(_pf_map(evalE, exprs))
