from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
data: list[int] = [-5, 31, 44, 18, 39, 15]
def offset(k: int, x: int) -> int:
    return x + k
answer: int = sum(_pf_drop(3, _pf_filter(lambda x: x % 5 == 4, (lambda _pf_x: _pf_map(sum, _pf_chunk(3, _pf_x)))(_pf_take(5, _pf_collect(lambda x: [x, x + 1], _pf_choose(lambda x: (Some(x // 4) if x % 4 == 0 else _None_), data)))))))
print(answer)
print(len(data))
text: str = "ada;oz;gear;nut"
parts: list[str] = _pf_str_split(";", text)
n2: int = len(parts)
print(f"n2={n2} {{braces}} {len(text)}")
print((_pf_str_index_of("oz", text), "oz" in text))
print(_pf_str_replace("i", "I", text))
orders: list[Ticket] = [Ticket(100, "sue", 293, True), Ticket(101, "sue", 41, True), Ticket(102, "ivy", 175, False), Ticket(103, "hal", 78, False), Ticket(104, "hal", 192, True)]
def tag(_pf_arg0: Ticket) -> str:
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, orders)))
def surcharge(o: Ticket) -> Ticket:
    if o.urgent:
        _pf_t0 = o
        return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + 5, _pf_t0.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(surcharge, orders)))
def discount(price: int, qty: int) -> int:
    return price * qty - 5 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("wick", 49, 5), ("nut", 28, 2), ("cap", 23, 2)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(18)([1, 2, 3]))
ticks: int = 0
def note(x: int) -> int:
    global ticks
    ticks = ticks + 1
    return x * 2
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([50, 30, 54, -11, 3, 37, 9]))
doubled: list[int] = _pf_map(note, [50, 30, 54, -11])
print(f"{doubled} after {ticks} calls")
