def evaluate(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evaluate(a) + evaluate(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evaluate(a) * evaluate(b)
    else:
        a = e._0
        return -evaluate(a)
def show(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({show(a)} + {show(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{show(a)} * {show(b)}"
    else:
        a = e._0
        return f"-{show(a)}"
