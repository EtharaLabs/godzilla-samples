def accumulate(n: int, acc: int) -> int:
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(167, 0))
def powAcc(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(powAcc(7, 8, 1))
def sumDigits(n: int) -> int:
    if n == 0:
        return 0
    else:
        return n % 10 + sumDigits(n // 10)
print(sumDigits(30718))
