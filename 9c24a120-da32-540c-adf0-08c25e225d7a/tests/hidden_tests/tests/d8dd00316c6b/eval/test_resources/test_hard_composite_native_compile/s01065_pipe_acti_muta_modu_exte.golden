from dataclasses import dataclass
from typing import Any
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_reduce(f, xs):
    return Some(functools.reduce(f, xs)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
values: list[int] = [29, 48, 5, 36, 16, 49]
result: Some | None_ = _pf_reduce(lambda a, b: a + b, _pf_map(lambda b: 38 - b, _pf_drop_while(lambda x: x < -3, _pf_sort((lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(3, _pf_x)))((lambda _pf_x: _pf_map(sum, _pf_chunk(2, _pf_x)))(_pf_map(functools.partial(max, 9), values)))))))
print(result)
print(len(values))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 26:
        return Some(n - 26)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def classify(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(classify, [8, 29, 22, 29, 12, 37, 23, 25]))
ticks: int = 0
def record(x: int) -> int:
    global ticks
    ticks = ticks + 1
    return x * 4
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([12, -17, -17, 45, 21]))
doubled: list[int] = _pf_map(record, [12, -17, -17, 45])
print(f"{doubled} after {ticks} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), ticks))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_square(x):
    return x * x
def Geo_between(lo, hi, x):
    return lo <= x <= hi
obs: list[int] = [20, 26, -11, 23, 24, 4]
print(Geo_norm1(obs))
print(_pf_map(Geo_square, obs))
print(_pf_filter(functools.partial(Geo_between, 2, 25), obs))
