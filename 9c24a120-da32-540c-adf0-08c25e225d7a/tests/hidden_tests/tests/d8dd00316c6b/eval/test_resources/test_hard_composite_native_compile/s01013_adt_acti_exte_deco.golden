    def __repr__(self):
        return f"Rest({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
