        b = e._1
        return evaluate(a) * evaluate(b)
    else:
        a = e._0
        return -evaluate(a)
def show(e: Term) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
