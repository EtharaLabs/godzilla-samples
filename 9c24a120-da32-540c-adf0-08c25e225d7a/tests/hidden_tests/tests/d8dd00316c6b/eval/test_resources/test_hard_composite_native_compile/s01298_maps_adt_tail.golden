def explain(t: Token) -> str:
    if isinstance(t, Push):
        n0 = t._0
        return f"push({n0})"
    else:
        if isinstance(t, Store):
            n0 = t._0
            if 0 <= n0 < 5:
                return f"store!({n0})"
        if isinstance(t, Store):
            n0 = t._0
            return f"store({n0})"
        elif isinstance(t, Skip) and t._0 == 3:
            return "skip-3"
        elif isinstance(t, Skip):
            n0 = t._0
            s1 = t._1
            return f"skip({n0},{s1})"
        else:
            n0 = t._0
            return f"rest({n0})"
def weight(t: Token) -> int:
    if isinstance(t, Store):
        x0 = t._0
        return x0
    elif isinstance(t, Push):
        x0 = t._0
        return x0
    elif isinstance(t, Skip):
        x0 = t._0
        return x0
    else:
        return 0
