from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_result_map_error(f, r):
    if isinstance(r, Error):
        return Error(f(r._0))
    return r
def _pf_result_to_option(r):
    if isinstance(r, Ok):
        return Some(r._0)
    return _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
def readPair(line: str) -> Ok | Error:
    def _pf_fn0():
        _pf_t1 = _pf_str_split("=", line)
        if len(_pf_t1) == 2:
            _k = _pf_t1[0]
            _v = _pf_t1[1]
            _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
        else:
            _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t2 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t2, Ok):
                n = _pf_t2._0
                return Ok((k, n))
            else:
                return _pf_t2
        else:
            return _pf_t0
    return _pf_fn0()
entries: list[str] = ["oz = 1", "quin=4=1", "ivy=3=1", "max"]
parsed: list[Ok | Error] = _pf_map(readPair, entries)
_pf_iter(print, parsed)
goodOnes: list[tuple[str, int]] = _pf_choose(_pf_result_to_option, parsed)
print(sum(_pf_map(_pf_snd, goodOnes)))
def combine(xs: list[Ok | Error]) -> Ok | Error:
    def _pf_fn2(acc, r):
        def _pf_fn3():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
                    return r
            else:
                return acc
        return _pf_fn3()
    return _pf_fold(_pf_fn2, Ok(0), xs)
print(_pf_result_map_error(_pf_str_upper, combine(parsed)))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums: list[int] = [29, -9, 14, -15, 23, 12]
print(_pf_map(functools.partial(Geo_clamp, 0, 14), nums))
print(Geo_norm1(nums))
print(Geo_mean(nums))
print(Geo_scaleAll(2, nums))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [10, 3, 2, 5]))
print(_pf_map(math.isqrt, [42, 91, 293, 199]))
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("111110") + int("47", base=8))
sentence: str = "bo,oz,ada,lu,cap"
parts: list[str] = _pf_str_split(",", sentence)
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
print(_pf_str_replace("e", "E", sentence))
def cell(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(8, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(parts)))
longest: Some | None_ = _pf_head(_pf_sort_by(lambda w: -len(w), parts))
print(_pf_option_with_default("?", longest))
