def render(t: Cmd) -> str:
    if isinstance(t, Rest):
        n0 = t._0
        if n0 % 2 == 0:
            return f"rest!({n0})"
    if isinstance(t, Rest):
        n0 = t._0
        return f"rest({n0})"
    elif isinstance(t, Turn) and t._0 == 2:
        return "turn-2"
    elif isinstance(t, Turn):
        n0 = t._0
        return f"turn({n0})"
    else:
        if isinstance(t, Store):
            n0 = t._0
            if n0 > 0:
                return f"store!({n0})"
        if isinstance(t, Store):
            n0 = t._0
            return f"store({n0})"
        else:
            if isinstance(t, Mark):
                n0 = t._0
                if n0 % 2 == 0:
                    return f"mark!({n0})"
            if isinstance(t, Mark):
                n0 = t._0
                return f"mark({n0})"
