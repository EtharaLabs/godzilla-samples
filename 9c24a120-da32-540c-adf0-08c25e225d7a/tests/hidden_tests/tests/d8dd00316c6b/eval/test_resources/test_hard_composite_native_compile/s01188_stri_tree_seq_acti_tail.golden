from dataclasses import dataclass
from typing import Any
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_concat(a, b):
    return a + b
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Expr"
    def __repr__(self):
        return f"Neg({self._0!r})"
Expr = Num | Add | Mul | Neg
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
sentence: str = "dee;quin;ned;cap"
words: list[str] = _pf_str_split(";", sentence)
print(_pf_str_replace("a", "A", sentence))
def row2(_pf_arg0: tuple[int, str]) -> str:
