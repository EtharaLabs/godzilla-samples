import functools
import itertools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def gcdLoop(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(283, 172))
def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(4, 20, 1))
def margin(price: int, qty: int) -> int:
    return price * qty - 6 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("hub", 39, 4), ("hub", 44, 2), ("gear", 32, 5), ("hub", 16, 3)]))
print(grand)
def _pf_fn1():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
series = _pf_fn1()
print(list(filter(lambda n: n % 4 == 0, series)))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
legs: list[float] = [397.6, 322.7, 368.5, 456.5, 345.4]
splits: list[float] = [73.2, 18.9, 51.9, 57.9, 88.2]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate: float = total / elapsed
print(_pf_fmt_fixed(3, rate))
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
