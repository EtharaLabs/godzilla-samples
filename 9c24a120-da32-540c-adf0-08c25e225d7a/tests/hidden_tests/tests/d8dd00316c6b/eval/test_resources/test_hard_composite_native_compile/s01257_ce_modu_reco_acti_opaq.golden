from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def decodeLine(line: str) -> Some | None_:
    def _pf_fn0():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t1, Some):
            v = _pf_t1._0
            _pf_t0 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some(n * 2)
            else:
                return _pf_t0
        else:
            return _pf_t1
    return _pf_fn0()
entries: list[str] = ["fay", "dee = 1", "tom=x", "oz=0=1", "sue=x"]
results: list[Some | None_] = _pf_map(decodeLine, entries)
_pf_iter(print, results)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), results)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), results))))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_square(x):
    return x * x
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums: list[int] = [20, 29, 19, 0, 18, 23, 1]
print(_pf_map(functools.partial(Text_clamp, 0, 13), nums))
print(_pf_map(Text_square, nums))
print(_pf_filter(functools.partial(Text_between, 1, 14), nums))
print(Text_scaleAll(3, nums))
tickets: list[Order] = [Order(100, "eli", 265, True), Order(101, "ada", 175, False), Order(102, "lu", 154, False), Order(103, "eli", 101, False), Order(104, "eli", 206, True), Order(105, "lu", 20, True)]
def _pf_fn1(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
perOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn1, _pf_group_by(lambda o: o.owner, tickets))
print(perOwner)
cheap, dear = _pf_partition(lambda o: o.amount < 159, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(rushSum)
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n: int) -> str:
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t2, _Even):
        return "even"
    elif isinstance(_pf_t2, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [20, 22, 20, 26, 23, 19, 0]))
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("acc", 2)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("u-1"))
