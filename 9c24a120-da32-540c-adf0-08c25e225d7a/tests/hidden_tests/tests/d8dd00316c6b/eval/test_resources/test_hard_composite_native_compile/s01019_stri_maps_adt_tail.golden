def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(2, 14, 1))
def steps(n: int, acc: int) -> int:
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [24, 53, 37]))
