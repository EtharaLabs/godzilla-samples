def show(t: Instr) -> str:
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    else:
        if isinstance(t, Drop):
            n0 = t._0
            if n0 > 0:
                return f"drop!({n0})"
        if isinstance(t, Drop):
            n0 = t._0
            return f"drop({n0})"
        else:
            s0 = t._0
            return f"pop({s0})"
def score(t: Instr) -> int:
