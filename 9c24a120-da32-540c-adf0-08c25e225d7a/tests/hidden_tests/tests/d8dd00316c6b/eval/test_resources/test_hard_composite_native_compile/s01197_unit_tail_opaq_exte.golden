from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
legs: list[float] = [314.9, 421.0, 216.1, 18.4, 76.0]
times: list[float] = [67.0, 34.6, 74.8, 75.1, 84.9]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, times)
rate: float = dist / elapsed
print(_pf_fmt_fixed(3, rate))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(legs, times))
print(best)
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(5, 7, 1))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [24, 8, 19, 15, 22]))
def euclid(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(229, 393))
def rawOf(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("u", 4)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("acc-1"))
print(_pf_str_rev(str.upper("sue")))
def safe(s: str) -> str:
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x1", "-36"]))
