from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    _1: int
    def __repr__(self):
        return f"Halt({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    _1: int
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
Cmd = Pop | Jump | Halt | Load | Mark
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
def render(t: Cmd) -> str:
    if isinstance(t, Pop):
        n0 = t._0
        if n0 > 7:
            return f"pop!({n0})"
    if isinstance(t, Pop):
        n0 = t._0
        return f"pop({n0})"
    else:
        if isinstance(t, Jump):
            n0 = t._0
            if 0 <= n0 < 14:
                return f"jump!({n0})"
        if isinstance(t, Jump):
            n0 = t._0
            return f"jump({n0})"
        elif isinstance(t, Halt) and t._0 == 1:
            return "halt-1"
        elif isinstance(t, Halt):
            n0 = t._0
            n1 = t._1
            return f"halt({n0},{n1})"
        elif isinstance(t, Load):
            s0 = t._0
            return f"load({s0})"
        else:
            s0 = t._0
            n1 = t._1
            return f"mark({s0},{n1})"
def weight(t: Cmd) -> int:
    if isinstance(t, Mark):
        x1 = t._1
        return x1
    elif isinstance(t, Load):
        return 6
    elif isinstance(t, Pop):
        x0 = t._0
        return x0 * 4
    else:
        return 1
batch: list[Cmd] = [Mark("quin", 7), Halt(-1, -1), Load("ada"), Jump(8), Mark("bo", 2), Halt(7, 1), Jump(1)]
print(_pf_str_join("; ", _pf_map(render, batch)))
total: int = _pf_sum_by(weight, batch)
print(f"total={total}")
print((_pf_head(batch), _pf_last(batch)))
log: list[str] = ["eli", "bo", "dee", "eli", "fay", "eli"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in log:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
hist: dict[str, int] = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(hist)))
print(len(_pf_map_filter(lambda k, v: v > 1, hist)))
print((_pf_map_try_find("dee", hist), "dee" in hist))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, hist))
extra: dict[str, int] = dict([("zed", 5), ("eli", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, hist))))
book: list[Ticket] = [Ticket(100, "hal", 24, True), Ticket(101, "sue", 144, False), Ticket(102, "sue", 159, False), Ticket(103, "pam", 79, False), Ticket(104, "hal", 180, False)]
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn1, (0, 0), book)
print(f"{cnt} records, {amt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 109, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def line(o: Ticket) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(line, book)))
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(rushSum)
