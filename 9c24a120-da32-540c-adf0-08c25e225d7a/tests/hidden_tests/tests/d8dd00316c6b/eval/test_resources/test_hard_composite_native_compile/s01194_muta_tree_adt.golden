calls: int = 0
def record(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 2
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([18, 41, -16, -15]))
doubled: list[int] = _pf_map(record, [18, 41, -16, -15])
print(f"{doubled} after {calls} calls")
def insert(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
root: Tree = _pf_fold(lambda acc, x: insert(x, acc), _Leaf, [9, 36, 25, 58, 7, 29, 1, 54])
def minT(t: Tree) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minT(root))
def sumOf(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumOf(l) + v + sumOf(rt)
print(sumOf(root))
def containsT(x: int, t: Tree) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
print(_pf_map(lambda k: containsT(k, root), [9, 55, 37]))
def describe(t: Cmd) -> str:
    if isinstance(t, Store):
        n0 = t._0
        if 0 <= n0 < 13:
            return f"store!({n0})"
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    elif isinstance(t, Drop):
        s0 = t._0
        n1 = t._1
        return f"drop({s0},{n1})"
    else:
        if isinstance(t, Emit):
            n0 = t._0
            if 0 <= n0 < 13:
                return f"emit!({n0})"
        if isinstance(t, Emit):
            n0 = t._0
            return f"emit({n0})"
        elif isinstance(t, Halt):
            return "halt/pop"
        else:
            return "halt/pop"
def weight(t: Cmd) -> int:
    if isinstance(t, Pop):
        return 1
    else:
        return 3
prog: list[Cmd] = [_Halt, _Halt, Store(10), Store(8), Emit(-1), _Halt]
_pf_iter(lambda t: print(describe(t)), prog)
tally: int = _pf_sum_by(weight, prog)
print(f"tally={tally}")
print(_pf_sort(prog))
