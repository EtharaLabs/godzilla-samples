from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
readings: list[int] = [-6, 44, 25, 37, 43, 47, 5, 26]
def shift(k: int, x: int) -> int:
    return x + k
outcome: Some | None_ = _pf_max(_pf_sort_by(lambda x: -x, _pf_drop(1, _pf_map(functools.partial(shift, 2), _pf_distinct_by(lambda x: x % 4, readings)))))
print(outcome)
print(len(readings))
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
nums: list[int] = [12, 17, 18, 17, -2]
print(_pf_map(Text_square, nums))
print(Text_norm1(nums))
print(_pf_map(functools.partial(Text_clamp, 0, 17), nums))
text: str = "max dee tom hal"
words: list[str] = _pf_str_split(" ", text)
def cell(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(10, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(words)))
print(_pf_str_replace("a", "A", text))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), words)))
longest: Some | None_ = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
print(_pf_map(lambda w: (w, len(w)), words))
nums2: list[Some | None_] = _pf_map(_pf_str_to_int, _pf_str_split(",", "7,x,5a,5a,7"))
print(nums2)
print(sum(_pf_choose(_pf_id, nums2)))
ticks: int = 0
def record(x: int) -> int:
    global ticks
    ticks = ticks + 1
    return x * 3
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([47, 49, 47, -11, 50]))
doubled: list[int] = _pf_map(record, [47, 49, 47, -11])
print(f"{doubled} after {ticks} calls")
