from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
book: list[Order] = [Order(100, "ned", 42, True, Site("Rome", 3)), Order(101, "quin", 281, True, Site("Riga", 2)), Order(102, "quin", 131, False, Site("Rome", 1)), Order(103, "ned", 31, True, Site("Lima", 4)), Order(104, "quin", 26, False, Site("Doha", 2)), Order(105, "tom", 113, True, Site("Riga", 4))]
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(rushSum)
def surcharge(pct: int, o: Order) -> Order:
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Order(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 10), book)))
def line(o: Order) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(line, book)))
def margin(price: int, qty: int) -> int:
    return price * qty - 2 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("bolt", 40, 5), ("cap", 9, 4)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(13)([1, 2, 3]))
events: list[str] = ["eli", "ada", "ada", "dee", "cy", "cy", "dee", "cy", "dee", "cy"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in events:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t2 = n + 1
            m[w] = _pf_t2
        case None_():
            m[w] = 1
