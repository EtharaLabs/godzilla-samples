from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
def _ap_Above(n):
    if n > 21:
        return Some(n - 21)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [35, 18, 7, -5, -2, 39]))
def discount(price: int, qty: int) -> int:
    return price * qty - 3 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("hub", 33, 6), ("wick", 12, 5), ("pin", 22, 5), ("cog", 41, 5)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(7)([1, 2, 3]))
book: list[Ticket] = [Ticket(100, "pam", 177, True), Ticket(101, "cy", 55, False), Ticket(102, "ada", 240, True), Ticket(103, "pam", 43, False), Ticket(104, "cy", 233, True), Ticket(105, "cy", 225, True)]
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(rushSum)
def adjust(o: Ticket) -> Ticket:
    if o.urgent:
        _pf_t2 = o
        return Ticket(_pf_t2.id, _pf_t2.owner, o.amount + 12, _pf_t2.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(adjust, book)))
def label(o: Ticket) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, book)))
def priority(o: Ticket) -> str:
    if isinstance(o, Ticket) and o.urgent is True:
        amount = o.amount
        if amount > 59:
            return "rush-big"
    if isinstance(o, Ticket) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 59:
            return "big"
        else:
            return "normal"
print(_pf_map(priority, book))
print(_pf_count_by(priority, book))
cheap, dear = _pf_partition(lambda o: o.amount < 54, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
sentence: str = "hub bo dee cy"
tokens: list[str] = _pf_str_split(" ", sentence)
print(_pf_map(lambda w: (w, len(w)), tokens))
print((_pf_str_index_of("hu", sentence), "hu" in sentence))
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
longest: Some | None_ = _pf_head(_pf_sort_by(lambda w: -len(w), tokens))
print(_pf_option_with_default("?", longest))
count: int = len(tokens)
print(f"count={count} {{braces}} {len(sentence)}")
