from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Tree"
    _1: int
    _2: "Tree"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Tree = Leaf | Node
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("10011") + int("56", base=8))
def add(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(add(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, add(x, rt))
        return t
root: Tree = _pf_fold(lambda acc, x: add(x, acc), _Leaf, [36, 49, 37, 28, 12])
def sumT(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumT(l) + v + sumT(rt)
print(sumT(root))
def minOf(t: Tree) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minOf(root))
def toListT(t: Tree) -> list[int]:
    if isinstance(t, Leaf):
        return []
    else:
        l = t._0
        v = t._1
        rt = t._2
        return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
print(toListT(root))
def depthT(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        rt = t._2
        return 1 + max(depthT(l), depthT(rt))
print(depthT(root))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n: int) -> str:
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [-2, -5, 11, -6, 32, 9, 32]))
