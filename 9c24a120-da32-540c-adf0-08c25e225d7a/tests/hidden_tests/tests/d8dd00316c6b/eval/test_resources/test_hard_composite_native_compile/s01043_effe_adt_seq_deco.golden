def describe(t: Move) -> str:
    if isinstance(t, Store):
        s0 = t._0
        return f"store({s0})"
    else:
        if isinstance(t, Push):
            n0 = t._0
            if n0 % 2 == 0:
                return f"push!({n0})"
        if isinstance(t, Push):
            n0 = t._0
            return f"push({n0})"
        else:
            s0 = t._0
            s1 = t._1
            return f"halt({s0},{s1})"
def rank(t: Move) -> int:
