from dataclasses import dataclass
from typing import Any
import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Ast"
    def __repr__(self):
        return f"Neg({self._0!r})"
Ast = Num | Add | Mul | Neg
def evaluate(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evaluate(a) + evaluate(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evaluate(a) * evaluate(b)
    else:
        a = e._0
        return -evaluate(a)
def show(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({show(a)} + {show(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{show(a)} * {show(b)}"
    else:
        a = e._0
        return f"-{show(a)}"
def simplify(e: Ast) -> Ast:
    while True:
        if isinstance(e, Add) and isinstance(e._0, Num) and e._0._0 == 0:
            x = e._1
            e = x
            continue
        elif isinstance(e, Add) and isinstance(e._1, Num) and e._1._0 == 0:
            x = e._0
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 1:
            x = e._1
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 1:
            x = e._0
            e = x
            continue
        elif isinstance(e, Neg) and isinstance(e._0, Neg):
            x = e._0._0
            e = x
            continue
        elif isinstance(e, Add):
            a = e._0
            b = e._1
            return Add(simplify(a), simplify(b))
        elif isinstance(e, Mul):
            a = e._0
            b = e._1
            return Mul(simplify(a), simplify(b))
        else:
            return e
exprs: list[Ast] = [Add(Mul(Mul(Num(3), Num(-2)), Neg(Num(1))), Neg(Neg(Num(7)))), Mul(Mul(Add(Num(-1), Num(6)), Add(Num(8), Num(5))), Num(5))]
_pf_iter(print, _pf_map(show, _pf_map(simplify, exprs)))
print(_pf_map(evaluate, exprs))
laps: list[float] = [483.5, 326.0, 293.3, 438.7, 470.0]
times: list[float] = [83.8, 25.7, 71.3, 22.9, 55.4]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
pace: float = dist / dur
print(_pf_fmt_fixed(2, pace))
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
mass: float = 7.0
accel: float = 5.5
push: float = mass * accel
limit: float = 228.0
print("over" if push > limit else "under")
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
edge: float = math.sqrt(9.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
hits: int = 0
def note(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 2
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([43, -5, 52, 42, 12, -15]))
doubled: list[int] = _pf_map(note, [43, -5, 52, 42])
print(f"{doubled} after {hits} calls")
