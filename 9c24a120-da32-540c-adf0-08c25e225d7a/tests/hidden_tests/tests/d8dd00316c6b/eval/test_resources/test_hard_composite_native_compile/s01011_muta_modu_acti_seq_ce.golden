from dataclasses import dataclass
from typing import Any
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
calls: int = 0
def note(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 4
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([42, 22, 49, 43, 1, 30]))
doubled: list[int] = _pf_map(note, [42, 22, 49, 43])
print(f"{doubled} after {calls} calls")
def Text_square(x):
    return x * x
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs: list[int] = [10, 26, -14, 30]
print(_pf_map(Text_square, obs))
print(_pf_filter(functools.partial(Text_between, 3, 10), obs))
print(Text_scaleAll(3, obs))
print(_pf_map(functools.partial(Text_clamp, 0, 13), obs))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def bucketOf(n: int) -> str:
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(bucketOf, [14, 36, 7, 17, 11, 39, -3]))
def _pf_fn0():
    for x in _pf_range(1, 12):
        y = x * x
        yield y
evens = _pf_fn0()
print(list(_pf_seq_take(4, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def readPair(line: str) -> Some | None_:
    def _pf_fn1():
        _pf_t2 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t2, Some):
            v = _pf_t2._0
            _pf_t1 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t1, Some):
                n = _pf_t1._0
                return Some(n * 3)
            else:
                return _pf_t1
        else:
            return _pf_t2
    return _pf_fn1()
entries: list[str] = ["ivy", "pam=0=1", "oz", "tom=65", "sue=93", "ned=x"]
parsed: list[Some | None_] = _pf_map(readPair, entries)
_pf_iter(print, parsed)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), parsed)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), parsed))))
