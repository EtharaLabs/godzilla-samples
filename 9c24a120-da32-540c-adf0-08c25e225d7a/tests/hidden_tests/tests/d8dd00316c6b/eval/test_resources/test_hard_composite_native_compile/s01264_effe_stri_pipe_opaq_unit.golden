from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_concat(a, b):
    return a + b
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
def discount(price: int, qty: int) -> int:
    return price * qty - 3 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("gear", 38, 6), ("gear", 33, 6)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(11)([1, 2, 3]))
text: str = "cog;max;wick;hal;bo;ada"
parts: list[str] = _pf_str_split(";", text)
print((_pf_str_index_of("ha", text), "ha" in text))
print(_pf_str_replace("u", "U", text))
print(_pf_map(lambda w: (w, len(w)), parts))
count: int = len(parts)
print(f"count={count} {{braces}} {len(text)}")
def cell(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(9, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(parts)))
samples: list[int] = [16, 47, 22, 7, 11, 39]
def shift(k: int, x: int) -> int:
    return x + k
digest: bool = _pf_exists(lambda x: x > 5, _pf_sort(_pf_filter(lambda x: x > 0, _pf_take(5, samples))))
print(digest)
def rawOf(x) -> str:
    s = x
    return s
def makeIds(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("sku", 3)
print(_pf_str_join(" ", _pf_map(rawOf, ids)))
print(_pf_head(ids) == Some("u-1"))
legs: list[float] = [463.6, 377.9, 350.2]
splits: list[float] = [41.1, 12.9, 87.8]
total: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate: float = total / elapsed
print(_pf_fmt_fixed(2, rate))
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn1, _pf_zip(legs, splits))
print(best)
