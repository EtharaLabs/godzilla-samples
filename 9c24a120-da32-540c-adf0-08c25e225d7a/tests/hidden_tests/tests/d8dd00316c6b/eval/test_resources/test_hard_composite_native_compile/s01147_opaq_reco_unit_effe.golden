from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
def unwrap(x) -> str:
    s = x
    return s
def makeIds(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("u", 2)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
book: list[Order] = [Order(100, "jo", 119, True, Site("Lima", 2)), Order(101, "oz", 55, True, Site("Doha", 3)), Order(102, "ivy", 209, False, Site("Baku", 3)), Order(103, "ivy", 88, False, Site("Rome", 4))]
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, book))))
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(rushSum)
def adjust(pct: int, o: Order) -> Order:
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Order(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 6), book)))
segments: list[float] = [459.8, 176.0, 101.9]
durations: list[float] = [67.0, 9.5, 70.7]
dist: float = _pf_fold(lambda a, b: a + b, 0.0, segments)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed: float = dist / elapsed
print(_pf_fmt_fixed(3, speed))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(segments, durations))
print(best)
side: float = math.sqrt(25.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
def net(price: int, qty: int) -> int:
    return price * qty - 4 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand: int = sum(_pf_map(_pf_fn1, [("hub", 28, 3), ("bolt", 7, 5), ("tap", 32, 1), ("wick", 42, 2)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(19)([1, 2, 3]))
