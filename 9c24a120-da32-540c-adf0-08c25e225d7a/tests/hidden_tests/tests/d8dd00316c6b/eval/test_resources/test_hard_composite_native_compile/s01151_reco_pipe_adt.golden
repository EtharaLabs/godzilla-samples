from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
_Halt: Halt = Halt()
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
Msg = Drop | Emit | Halt | Pop | Push
book: list[Parcel] = [Parcel(100, "eli", 17, False, Site("Bern", 3)), Parcel(101, "ned", 168, True, Site("Bern", 3)), Parcel(102, "eli", 160, True, Site("Doha", 4)), Parcel(103, "dee", 142, True, Site("Riga", 1))]
def adjust(o: Parcel) -> Parcel:
    if o.urgent:
        _pf_t0 = o
        return Parcel(_pf_t0.id, _pf_t0.owner, o.amount + 1, _pf_t0.urgent, _pf_t0.dest)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(adjust, book)))
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, book))))
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t3 = o
        return Parcel(_pf_t3.id, _pf_t3.owner, _pf_t3.amount, _pf_t3.urgent, Site("Hub", 1))
    else:
        return o
rerouted: list[Parcel] = _pf_map(_pf_fn0, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
samples: list[int] = [43, 27, 2, 37, 43, 3]
def keep(n: int) -> bool:
    return n > 6 and n % 3 != 0
result: int = _pf_sum_by(lambda x: x * x, _pf_choose(lambda x: (Some(x // 4) if x % 4 == 0 else _None_), _pf_filter(keep, _pf_rev(samples))))
print(result)
def render(t: Msg) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        if n0 % 2 == 0:
            return f"drop!({n0})"
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Emit):
        n0 = t._0
        return f"emit({n0})"
    elif isinstance(t, Halt):
        return f"halt"
    elif isinstance(t, Pop):
        s0 = t._0
        return f"pop({s0})"
    else:
        n0 = t._0
        return f"push({n0})"
def rank(t: Msg) -> int:
    if isinstance(t, Pop):
        return 8
    else:
        return 3
batch: list[Msg] = [Push(8), Emit(11), Drop(-2), Pop("tom"), Push(1), _Halt]
_pf_iter(lambda t: print(render(t)), batch)
total: int = _pf_sum_by(rank, batch)
print(f"total={total}")
print((_pf_head(batch), _pf_last(batch)))
