def describe(t: Move) -> str:
    if isinstance(t, Mark) and t._0 == 2:
        return "mark-2"
    elif isinstance(t, Mark):
        n0 = t._0
        return f"mark({n0})"
    elif isinstance(t, Halt):
        s0 = t._0
        s1 = t._1
        return f"halt({s0},{s1})"
    else:
        if isinstance(t, Store):
            n0 = t._0
            if n0 > 8:
                return f"store!({n0})"
        if isinstance(t, Store):
            n0 = t._0
            return f"store({n0})"
        else:
            if isinstance(t, Push):
                n0 = t._0
                if n0 > 5:
                    return f"push!({n0})"
            n0 = t._0
            return f"push({n0})"
def cost(t: Move) -> int:
    if isinstance(t, Mark):
        x0 = t._0
        return x0
    elif isinstance(t, Halt):
        return 3
    elif isinstance(t, Store):
        x0 = t._0
        return x0 * 4
    else:
        return 2
