def bucket(o: Ticket) -> str:
    if isinstance(o, Ticket) and o.urgent is True:
        amount = o.amount
        if amount > 167:
            return "rush-big"
    if isinstance(o, Ticket) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 167:
            return "big"
        else:
            return "normal"
