def euclid(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(169, 142))
def countDown(n: int, acc: int) -> int:
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(1606, 0))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [17, 8, 16, 22, 6]))
