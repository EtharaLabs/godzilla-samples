from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_result_map_error(f, r):
    if isinstance(r, Error):
        return Error(f(r._0))
    return r
def _pf_result_to_option(r):
    if isinstance(r, Ok):
        return Some(r._0)
    return _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def discount(price: int, qty: int) -> int:
    return price * qty - 4 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("nut", 45, 3), ("cog", 22, 1), ("gear", 12, 5), ("nut", 45, 5)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(13)([1, 2, 3]))
def decodeLine(line: str) -> Ok | Error:
    def _pf_fn1():
        _pf_t1 = _pf_str_split("=", line)
        if len(_pf_t1) == 2:
            _k = _pf_t1[0]
            _v = _pf_t1[1]
            _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
        else:
            _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t2 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t2, Ok):
                n = _pf_t2._0
                return Ok((k, n))
            else:
                return _pf_t2
        else:
            return _pf_t0
    return _pf_fn1()
lines: list[str] = ["max", "lu=18", "cy = 0", "sue=2=1", "ray=x", "hal = 0"]
parsed: list[Ok | Error] = _pf_map(decodeLine, lines)
_pf_iter(print, parsed)
goodOnes: list[tuple[str, int]] = _pf_choose(_pf_result_to_option, parsed)
print(sum(_pf_map(_pf_snd, goodOnes)))
def combine(xs: list[Ok | Error]) -> Ok | Error:
    def _pf_fn3(acc, r):
        def _pf_fn4():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
                    return r
            else:
                return acc
        return _pf_fn4()
    return _pf_fold(_pf_fn3, Ok(0), xs)
print(_pf_result_map_error(_pf_str_upper, combine(parsed)))
legs: list[float] = [50.6, 31.1, 105.1]
times: list[float] = [84.4, 74.1, 60.6]
total: float = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
pace: float = total / dur
print(_pf_fmt_fixed(3, pace))
edge: float = math.sqrt(25.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn5(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn5, _pf_zip(legs, times))
print(best)
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 18:
        return Some(n - 18)
    else:
        return _None_
def bucketOf(n: int) -> str:
    _pf_t3 = _ap_Above(n)
    _pf_t4 = _ap_Even_Odd(n)
    if isinstance(_pf_t3, Some):
        d = _pf_t3._0
        return f"above by {d}"
    elif isinstance(_pf_t4, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(bucketOf, [14, 17, 19, 17, 12]))
