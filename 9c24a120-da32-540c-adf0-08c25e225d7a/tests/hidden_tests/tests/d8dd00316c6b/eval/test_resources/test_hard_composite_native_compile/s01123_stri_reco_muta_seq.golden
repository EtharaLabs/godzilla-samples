    return _pf_str_concat(_pf_fmt_pad_right(9, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(parts)))
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
parcels: list[Invoice] = [Invoice(100, "max", 218, False, Place("Lima", 1)), Invoice(101, "max", 38, False, Place("Bern", 3)), Invoice(102, "max", 83, False, Place("Baku", 3)), Invoice(103, "max", 141, False, Place("Bern", 3)), Invoice(104, "fay", 94, False, Place("Lima", 4)), Invoice(105, "max", 155, False, Place("Baku", 4))]
