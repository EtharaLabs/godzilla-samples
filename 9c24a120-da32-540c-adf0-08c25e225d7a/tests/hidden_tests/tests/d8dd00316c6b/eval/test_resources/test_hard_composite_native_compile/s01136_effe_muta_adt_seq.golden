from dataclasses import dataclass
from typing import Any
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: str
    def __repr__(self):
        return f"Drop({self._0!r})"
Action = Store | Pop | Halt | Drop
def discount(price: int, qty: int) -> int:
    return price * qty - 7 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand: int = sum(_pf_map(_pf_fn0, [("bolt", 45, 5), ("bolt", 17, 2)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(6)([1, 2, 3]))
hits: int = 0
def note(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 3
def profile(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([54, 46, 27, 31, 35, 8]))
doubled: list[int] = _pf_map(note, [54, 46, 27, 31])
print(f"{doubled} after {hits} calls")
def explain(t: Action) -> str:
    if isinstance(t, Store):
        s0 = t._0
        return f"store({s0})"
    elif isinstance(t, Pop):
        n0 = t._0
        return f"pop({n0})"
    elif isinstance(t, Halt):
        s0 = t._0
        return f"halt({s0})"
    else:
        s0 = t._0
        return f"drop({s0})"
def weight(t: Action) -> int:
    if isinstance(t, Drop):
        return 7
    else:
        return 3
stream: list[Action] = [Store("jo"), Store("ray"), Halt("bo"), Drop("cy"), Pop(11), Halt("tom")]
print(_pf_str_join(" ", _pf_map(explain, stream)))
total: int = _pf_sum_by(weight, stream)
print(f"total={total}")
print(len(_pf_filter(lambda t: weight(t) > 1, stream)))
def _pf_fn1():
    for x in _pf_range(1, 6):
        y = x * x
        yield y
series = _pf_fn1()
print(list(_pf_seq_take(4, map(lambda n: n + 1, series))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1332, fib)))
