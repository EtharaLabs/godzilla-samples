from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: str
    def __repr__(self):
        return f"Turn({self._0!r})"
Action = Halt | Drop | Pop | Load | Turn
def render(t: Action) -> str:
    if isinstance(t, Halt):
        n0 = t._0
        if 0 <= n0 < 17:
            return f"halt!({n0})"
    if isinstance(t, Halt):
        n0 = t._0
        return f"halt({n0})"
    else:
        if isinstance(t, Drop):
            n0 = t._0
            if n0 > 5:
                return f"drop!({n0})"
        if isinstance(t, Drop):
            n0 = t._0
            return f"drop({n0})"
        else:
            if isinstance(t, Pop):
                n0 = t._0
                n1 = t._1
                if 0 <= n0 < 5:
                    return f"pop!({n0},{n1})"
            if isinstance(t, Pop):
                n0 = t._0
                n1 = t._1
                return f"pop({n0},{n1})"
            elif isinstance(t, Load):
                s0 = t._0
                return f"load({s0})"
            else:
                s0 = t._0
                return f"turn({s0})"
def weight(t: Action) -> int:
    if isinstance(t, Pop):
        x0 = t._0
        x1 = t._1
        return x0 + x1 * 3
    elif isinstance(t, Drop):
        x0 = t._0
        return x0
    elif isinstance(t, Load):
        return 7
    elif isinstance(t, Halt):
        x0 = t._0
        return x0
    else:
        return 3
stream: list[Action] = [Drop(7), Drop(1), Load("hal"), Halt(7), Drop(8), Turn("ivy"), Halt(8)]
print(_pf_map(render, stream))
grandSum: int = _pf_sum_by(weight, stream)
print(f"grandSum={grandSum}")
print(_pf_max_by(weight, stream))
def _ap_Above(n):
    if n > 23:
        return Some(n - 23)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [21, 9, 10, 31, 18, -4, 29, 6]))
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("u", 2)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
