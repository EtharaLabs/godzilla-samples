from dataclasses import dataclass
from typing import Any
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Place"
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
pts: list[int] = [14, -8, 5, -15]
print(_pf_filter(functools.partial(Stats_between, -5, 20), pts))
print(_pf_map(functools.partial(Stats_clamp, 0, 5), pts))
print(Stats_mean(pts))
print(Stats_norm1(pts))
