from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Term"
    def __repr__(self):
        return f"Neg({self._0!r})"
Term = Num | Add | Mul | Neg
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
def evalE(e: Term) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    else:
        a = e._0
        return -evalE(a)
def render(e: Term) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    else:
        a = e._0
        return f"-{render(a)}"
def shrink(e: Term) -> Term:
    while True:
        if isinstance(e, Add) and isinstance(e._0, Num) and e._0._0 == 0:
            x = e._1
            e = x
            continue
        elif isinstance(e, Add) and isinstance(e._1, Num) and e._1._0 == 0:
            x = e._0
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 1:
            x = e._1
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 1:
            x = e._0
            e = x
            continue
        elif isinstance(e, Neg) and isinstance(e._0, Neg):
            x = e._0._0
            e = x
            continue
        elif isinstance(e, Add):
            a = e._0
            b = e._1
            return Add(shrink(a), shrink(b))
        elif isinstance(e, Mul):
            a = e._0
            b = e._1
            return Mul(shrink(a), shrink(b))
        else:
            return e
terms: list[Term] = [Add(Add(Num(0), Add(Num(4), Num(6))), Add(Num(0), Add(Num(5), Num(2)))), Neg(Neg(Add(Num(-2), Num(1)))), Add(Num(1), Num(2))]
_pf_iter(print, _pf_map(render, _pf_map(shrink, terms)))
print(_pf_map(evalE, terms))
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("acc", 2)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
tickets: list[Booking] = [Booking(100, "fay", 177, True, Site("Oslo", 4)), Booking(101, "ivy", 148, True, Site("Bern", 1)), Booking(102, "pam", 98, False, Site("Riga", 2)), Booking(103, "pam", 213, True, Site("Lima", 4)), Booking(104, "fay", 43, False, Site("Kyiv", 1)), Booking(105, "ivy", 30, False, Site("Lima", 1))]
def bucket(o: Booking) -> str:
    if isinstance(o, Booking) and o.urgent is True:
        amount = o.amount
        if amount > 95:
            return "rush-big"
    if isinstance(o, Booking) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 95:
            return "big"
        else:
            return "normal"
print(_pf_map(bucket, tickets))
print(_pf_count_by(bucket, tickets))
def surcharge(pct: int, o: Booking) -> Booking:
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Booking(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(surcharge, 16), tickets)))
print(_pf_max_by(lambda o: o.amount, tickets))
def label(o: Booking) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, tickets)))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn0, (0, 0), tickets)
print(f"{cnt} records, {sumAmt} total")
