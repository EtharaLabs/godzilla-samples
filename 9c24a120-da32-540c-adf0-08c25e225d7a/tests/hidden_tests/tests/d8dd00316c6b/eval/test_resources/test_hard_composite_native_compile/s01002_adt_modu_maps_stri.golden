from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_values(m):
    return list(m.values())
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    _1: int
    def __repr__(self):
        return f"Load({self._0!r}, {self._1!r})"
Signal = Jump | Halt | Load
def show(t: Signal) -> str:
    if isinstance(t, Jump):
        s0 = t._0
        return f"jump({s0})"
    else:
        if isinstance(t, Halt):
            n0 = t._0
            if n0 % 2 == 0:
                return f"halt!({n0})"
        if isinstance(t, Halt):
            n0 = t._0
            return f"halt({n0})"
        else:
            s0 = t._0
            n1 = t._1
            return f"load({s0},{n1})"
def weight(t: Signal) -> int:
    if isinstance(t, Load):
        x1 = t._1
        return x1
    elif isinstance(t, Jump):
        return 8
    else:
        return 3
queue: list[Signal] = [Jump("pam"), Jump("ray"), Jump("fay"), Load("fay", 1)]
print(_pf_map(show, queue))
grandSum: int = _pf_sum_by(weight, queue)
print(f"grandSum={grandSum}")
print(len(_pf_filter(lambda t: weight(t) > 3, queue)))
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs: list[int] = [3, 26, 17, -5, 4]
print(Stats_norm1(obs))
print(_pf_filter(functools.partial(Stats_between, -3, 18), obs))
print(Stats_mean(obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 19), obs))
visits: list[str] = ["cy", "cy", "fay", "cy", "ada", "fay"]
m = dict()
for w in visits:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
counts: dict[str, int] = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(counts))))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, counts))))
print(len(_pf_map_filter(lambda k, v: v > 1, counts)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, counts))
raw: str = "gear;cog;dee;hub;cy;quin"
tokens: list[str] = _pf_str_split(";", raw)
fieldsN: list[Some | None_] = _pf_map(_pf_str_to_int, _pf_str_split(",", "40,x,7,5a,"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
print(_pf_map(lambda w: (w, len(w)), tokens))
print(_pf_str_replace("o", "O", raw))
print(_pf_str_slice(0, 8, raw))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), tokens)))
