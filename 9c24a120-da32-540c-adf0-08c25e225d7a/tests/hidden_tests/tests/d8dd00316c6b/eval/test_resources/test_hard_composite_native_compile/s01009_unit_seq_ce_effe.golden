from dataclasses import dataclass
from typing import Any
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
legs: list[float] = [376.8, 113.5, 133.8, 84.2, 16.8]
durations: list[float] = [27.5, 77.2, 13.7, 48.9, 57.1]
total: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed: float = total / elapsed
print(_pf_fmt_fixed(2, speed))
mass: float = 2.0
accel: float = 8.5
push: float = mass * accel
limit: float = 256.0
print("over" if push > limit else "under")
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(legs, durations))
print(best)
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
def _pf_fn1():
    for x in _pf_range(1, 7):
        y = x * x
        yield y
series = _pf_fn1()
print(list(_pf_seq_take(2, map(lambda n: n + 1, series))))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 7)))))
def decodeLine(line: str) -> Some | None_:
    def _pf_fn2():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t1, Some):
            v = _pf_t1._0
            _pf_t0 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some(n * 4)
            else:
                return _pf_t0
        else:
            return _pf_t1
    return _pf_fn2()
inputs: list[str] = ["gus", "hal=9=1", "ivy=58", "eli=x", "ray = 9", "ned = 9"]
results: list[Some | None_] = _pf_map(decodeLine, inputs)
_pf_iter(print, results)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), results)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), results))))
def margin(price: int, qty: int) -> int:
    return price * qty - 4 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn3(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand: int = sum(_pf_map(_pf_fn3, [("tap", 35, 4), ("cap", 20, 2)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(16)([1, 2, 3]))
