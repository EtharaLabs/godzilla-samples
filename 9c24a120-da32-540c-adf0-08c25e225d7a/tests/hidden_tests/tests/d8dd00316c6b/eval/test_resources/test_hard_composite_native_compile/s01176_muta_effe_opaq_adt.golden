from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
_Halt: Halt = Halt()
Token = Jump | Emit | Halt
hits: int = 0
def record(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 4
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([60, 37, 49, 0, 9, 20]))
doubled: list[int] = _pf_map(record, [60, 37, 49, 0])
print(f"{doubled} after {hits} calls")
def margin(price: int, qty: int) -> int:
    return price * qty - 3 * qty
def announce(label, price: int, qty: int) -> int:
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("cog", 7, 2), ("nut", 32, 1), ("rod", 19, 1), ("hub", 42, 1)]))
print(overall)
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("u", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
def render(t: Token) -> str:
    if isinstance(t, Jump):
        s0 = t._0
        return f"jump({s0})"
    else:
        if isinstance(t, Emit):
            n0 = t._0
            if n0 % 2 == 0:
                return f"emit!({n0})"
        if isinstance(t, Emit):
            n0 = t._0
            return f"emit({n0})"
        else:
            return f"halt"
def weight(t: Token) -> int:
    if isinstance(t, Emit):
        x0 = t._0
        return x0
    elif isinstance(t, Halt):
        return 6
    else:
        return 0
prog: list[Token] = [Emit(7), Emit(1), Emit(1), Jump("pam"), _Halt, Jump("gus"), Emit(6)]
print(_pf_str_join(" ", _pf_map(render, prog)))
tally: int = _pf_sum_by(weight, prog)
print(f"tally={tally}")
print((_pf_head(prog), _pf_last(prog)))
