        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Term"
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
Term = Num | Add | Mul | Neg | Var
vars: dict[str, int] = dict([("x", 8), ("y", 5)])
def calc(e: Term) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return calc(a) + calc(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return calc(a) * calc(b)
    elif isinstance(e, Neg):
        a = e._0
        return -calc(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, vars)
def render(e: Term) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{render(a)}"
    else:
        v = e._0
        return v
def shrink(e: Term) -> Term:
    while True:
        if isinstance(e, Add) and isinstance(e._0, Num) and e._0._0 == 0:
            x = e._1
            e = x
            continue
        elif isinstance(e, Add) and isinstance(e._1, Num) and e._1._0 == 0:
            x = e._0
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 1:
            x = e._1
            e = x
            continue
        elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 1:
            x = e._0
            e = x
            continue
        elif isinstance(e, Neg) and isinstance(e._0, Neg):
            x = e._0._0
            e = x
            continue
        elif isinstance(e, Add):
            a = e._0
            b = e._1
            return Add(shrink(a), shrink(b))
        elif isinstance(e, Mul):
            a = e._0
            b = e._1
            return Mul(shrink(a), shrink(b))
        else:
            return e
exprs: list[Term] = [Add(Num(0), Add(Num(1), Neg(Var("x")))), Mul(Mul(Mul(Num(0), Num(8)), Mul(Num(1), Var("y"))), Mul(Var("y"), Add(Num(1), Num(8)))), Num(6)]
_pf_iter(print, _pf_map(render, _pf_map(shrink, exprs)))
