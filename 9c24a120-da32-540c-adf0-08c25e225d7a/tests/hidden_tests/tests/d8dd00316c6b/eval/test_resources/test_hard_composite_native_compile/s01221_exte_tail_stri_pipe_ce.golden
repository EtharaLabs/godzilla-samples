pipeline = lambda _pf_x: _pf_collect(lambda x: [x, x + 1], (lambda _pf_x: _pf_map(functools.partial(shift, 8), (lambda _pf_x: _pf_distinct(_pf_map(lambda x: x * x - 5, _pf_x)))(_pf_x)))(_pf_x))
digest: Some | None_ = _pf_list_find(lambda x: x % 2 == 1, pipeline(values))
