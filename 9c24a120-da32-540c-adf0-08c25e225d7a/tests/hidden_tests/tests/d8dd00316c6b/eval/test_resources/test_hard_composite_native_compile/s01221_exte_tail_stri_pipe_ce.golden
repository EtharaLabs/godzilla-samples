def decodeLine(line: str) -> Ok | Error:
    def _pf_fn0():
        _pf_t1 = _pf_str_split("=", line)
        if len(_pf_t1) == 2:
            _k = _pf_t1[0]
            _v = _pf_t1[1]
            _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
        else:
            _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t3 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t3, Ok):
                n = _pf_t3._0
                _pf_t2 = Error("negative") if n < 0 else Ok(n)
                if isinstance(_pf_t2, Ok):
                    checked = _pf_t2._0
                    return Ok((k, checked))
                else:
                    return _pf_t2
            else:
                return _pf_t3
        else:
            return _pf_t0
    return _pf_fn0()
lines: list[str] = ["eli=8=1", "bo", "pam = 1", "jo=9", "gus=-3", "ada=95"]
results: list[Ok | Error] = _pf_map(decodeLine, lines)
