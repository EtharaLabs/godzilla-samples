book: list[Order] = [Order(100, "ivy", 91, True, Place("Bern", 1)), Order(101, "cy", 69, False, Place("Riga", 1)), Order(102, "sue", 226, False, Place("Bern", 1)), Order(103, "ivy", 84, False, Place("Doha", 3))]
