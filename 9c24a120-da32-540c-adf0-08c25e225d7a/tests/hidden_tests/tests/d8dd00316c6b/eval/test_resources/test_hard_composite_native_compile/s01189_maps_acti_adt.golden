from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_set_union(a, b):
    return a.union(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
_Load: Load = Load()
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
_Rest: Rest = Rest()
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
_Push: Push = Push()
Instr = Drop | Skip | Load | Rest | Push
events: list[str] = ["bo", "bo", "ada", "cy", "bo", "cy"]
m = dict()
for w in events:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
freq: dict[str, int] = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(freq)))
sa: set[int] = set([7, 11, 15, 17, 18, 19])
sb: set[int] = set([1, 4, 5, 12, 14, 18])
print(_pf_sort(list(_pf_set_union(sa, sb))))
print((len(sa), 11 in sb, _pf_set_is_subset(set([7]), sa)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, freq))
extra: dict[str, int] = dict([("zed", 5), ("bo", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, freq))))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(freq))))
def _ap_Above(n):
    if n > 30:
        return Some(n - 30)
    else:
        return _None_
def classify(n: int) -> str:
    _pf_t1 = _ap_Above(n)
    if isinstance(_pf_t1, Some):
        d = _pf_t1._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [17, 20, 2, 5, 31]))
def show(t: Instr) -> str:
    if isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Skip) and t._0 == 1:
        return "skip-1"
    elif isinstance(t, Skip):
        n0 = t._0
        return f"skip({n0})"
    elif isinstance(t, Push):
        return f"push"
    elif isinstance(t, Load):
        return "load/rest"
    else:
        return "load/rest"
def rank(t: Instr) -> int:
    if isinstance(t, Push):
        return 7
    elif isinstance(t, Load):
        return 9
    elif isinstance(t, Rest):
        return 5
    elif isinstance(t, Drop):
        x0 = t._0
        return x0
    else:
        return 1
stream: list[Instr] = [_Load, _Push, _Push, Drop(8), _Rest, Drop(-3), _Load]
_pf_iter(lambda t: print(show(t)), stream)
grandSum: int = _pf_sum_by(rank, stream)
