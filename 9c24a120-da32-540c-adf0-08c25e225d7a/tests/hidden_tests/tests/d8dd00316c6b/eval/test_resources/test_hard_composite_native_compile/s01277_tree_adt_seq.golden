from dataclasses import dataclass
from typing import Any
import itertools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Term"
    def __repr__(self):
        return f"Neg({self._0!r})"
Term = Num | Add | Mul | Neg
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    _1: int
    def __repr__(self):
        return f"Jump({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    def __repr__(self):
        return "Pop"
_Pop: Pop = Pop()
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    def __repr__(self):
        return "Store"
_Store: Store = Store()
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Msg = Emit | Jump | Pop | Store | Skip
def evaluate(e: Term) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evaluate(a) + evaluate(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evaluate(a) * evaluate(b)
    else:
        a = e._0
        return -evaluate(a)
def render(e: Term) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    else:
        a = e._0
        return f"-{render(a)}"
terms: list[Term] = [Neg(Neg(Neg(Num(1)))), Add(Num(7), Neg(Neg(Num(3))))]
_pf_iter(print, _pf_map(render, terms))
print(_pf_map(evaluate, terms))
def describe(t: Msg) -> str:
    if isinstance(t, Emit):
        n0 = t._0
        if n0 > 0:
            return f"emit!({n0})"
    if isinstance(t, Emit):
        n0 = t._0
        return f"emit({n0})"
    elif isinstance(t, Jump):
        s0 = t._0
        n1 = t._1
        return f"jump({s0},{n1})"
    elif isinstance(t, Pop):
        return f"pop"
    elif isinstance(t, Store):
        return f"store"
    else:
        return f"skip"
def cost(t: Msg) -> int:
    if isinstance(t, Emit):
        x0 = t._0
        return x0
    else:
        return 2
prog: list[Msg] = [Emit(9), Jump("max", 9), Jump("max", 2), _Skip, _Store, _Store, Emit(11)]
print(_pf_str_join("; ", _pf_map(describe, prog)))
tally: int = _pf_sum_by(cost, prog)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: cost(t) > 0, prog)))
def _pf_fn0():
    for x in _pf_range(1, 7):
        y = x * x
        yield y
    yield 100
evens = _pf_fn0()
print(list(filter(lambda n: n % 2 == 0, evens)))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 7)))))
