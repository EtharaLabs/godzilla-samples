from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
_Rest: Rest = Rest()
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
Token = Drop | Rest | Halt | Skip
def discount(price: int, qty: int) -> int:
    return price * qty - 4 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("tap", 50, 2), ("cap", 9, 6)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(16)([1, 2, 3]))
def Geo_square(x):
    return x * x
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums: list[int] = [-3, 25, -15, 30, 21, -12]
print(_pf_map(Geo_square, nums))
print(_pf_filter(functools.partial(Geo_between, 5, 11), nums))
print(Geo_norm1(nums))
print(Geo_scaleAll(5, nums))
def render(t: Token) -> str:
    if isinstance(t, Drop) and t._0 == 2:
        return "drop-2"
    elif isinstance(t, Drop):
        n0 = t._0
        return f"drop({n0})"
    elif isinstance(t, Rest):
        return f"rest"
    elif isinstance(t, Halt):
        s0 = t._0
        return f"halt({s0})"
    else:
        if isinstance(t, Skip):
            n0 = t._0
            if 0 <= n0 < 19:
                return f"skip!({n0})"
        n0 = t._0
        return f"skip({n0})"
def score(t: Token) -> int:
    if isinstance(t, Halt):
        return 5
    else:
        return 3
batch: list[Token] = [_Rest, Drop(7), _Rest, Skip(11), _Rest, Drop(-3), Skip(-1)]
_pf_iter(lambda t: print(render(t)), batch)
grandSum: int = _pf_sum_by(score, batch)
print(f"grandSum={grandSum}")
print(len(_pf_filter(lambda t: score(t) > 5, batch)))
text: str = "hub,bo,ivy,sue,gear"
tokens: list[str] = _pf_str_split(",", text)
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
fieldsN: list[Some | None_] = _pf_map(_pf_str_to_int, _pf_str_split(",", ",7,-3,5a,-3"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
print(_pf_str_slice(3, 7, text))
print(_pf_map(lambda w: (w, len(w)), tokens))
n2: int = len(tokens)
print(f"n2={n2} {{braces}} {len(text)}")
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, tokens))))
