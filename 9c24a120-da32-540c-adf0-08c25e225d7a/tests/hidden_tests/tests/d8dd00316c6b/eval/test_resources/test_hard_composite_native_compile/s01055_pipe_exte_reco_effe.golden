def priority(o: Booking) -> str:
    if isinstance(o, Booking) and o.urgent is True:
        amount = o.amount
        if amount > 139:
            return "rush-big"
    if isinstance(o, Booking) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 139:
            return "big"
        else:
            return "normal"
