from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: str
    _1: str
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip: Skip = Skip()
Move = Turn | Mark | Emit | Skip
@dataclass(frozen=True, slots=True)
class Addr:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Addr"
def euclid(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(201, 192))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [12, 18, 23, 12, 8]))
def render(t: Move) -> str:
    if isinstance(t, Turn):
        n0 = t._0
        return f"turn({n0})"
    elif isinstance(t, Mark):
        s0 = t._0
        return f"mark({s0})"
    elif isinstance(t, Emit):
        s0 = t._0
        s1 = t._1
        return f"emit({s0},{s1})"
    else:
        return f"skip"
def weight(t: Move) -> int:
    if isinstance(t, Mark):
        return 6
    else:
        return 2
stream: list[Move] = [Turn(-2), Turn(4), Emit("oz", "fay"), _Skip, Turn(5)]
print(_pf_str_join(" ", _pf_map(render, stream)))
tally: int = _pf_sum_by(weight, stream)
print(f"tally={tally}")
print(_pf_max_by(weight, stream))
book: list[Parcel] = [Parcel(100, "ivy", 284, False, Addr("Lima", 2)), Parcel(101, "lu", 163, True, Addr("Oslo", 4)), Parcel(102, "lu", 119, True, Addr("Rome", 3)), Parcel(103, "ivy", 18, False, Addr("Doha", 4)), Parcel(104, "ivy", 230, False, Addr("Doha", 3))]
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn0, (0, 0), book)
print(f"{cnt} records, {amt} total")
urgentTotal: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, book))
print(urgentTotal)
cheap, dear = _pf_partition(lambda o: o.amount < 195, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("100100") + int("100", base=8))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [7, 3, 10, 12]))
def row(n: int) -> list[int]:
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
print(_pf_map(math.isqrt, [311, 134, 268, 277]))
