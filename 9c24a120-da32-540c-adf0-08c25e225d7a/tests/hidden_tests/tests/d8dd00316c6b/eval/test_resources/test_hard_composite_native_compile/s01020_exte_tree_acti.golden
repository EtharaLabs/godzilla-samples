from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Expr"
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
Expr = Num | Add | Mul | Neg | Var
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [10, 4, 5, 2]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
print(_pf_str_rev(str.upper("lu")))
print(_pf_map(math.isqrt, [31, 71, 157, 315]))
env: dict[str, int] = dict([("x", 3), ("y", 8)])
def evaluate(e: Expr) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evaluate(a) + evaluate(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evaluate(a) * evaluate(b)
    elif isinstance(e, Neg):
        a = e._0
        return -evaluate(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, env)
def pretty(e: Expr) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({pretty(a)} + {pretty(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{pretty(a)} * {pretty(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{pretty(a)}"
    else:
        v = e._0
        return v
terms: list[Expr] = [Neg(Neg(Var("x"))), Add(Num(0), Mul(Add(Num(1), Num(9)), Var("x")))]
_pf_iter(print, _pf_map(pretty, terms))
print(_pf_map(evaluate, terms))
def _ap_Above(n):
    if n > 8:
        return Some(n - 8)
    else:
        return _None_
def bucketOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [15, 39, 28, 1, 30]))
