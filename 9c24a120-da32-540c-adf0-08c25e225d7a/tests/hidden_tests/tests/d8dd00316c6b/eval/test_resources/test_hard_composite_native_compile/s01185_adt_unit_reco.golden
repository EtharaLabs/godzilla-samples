from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    _1: str
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
Signal = Load | Emit | Mark
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
def describe(t: Signal) -> str:
    if isinstance(t, Load):
        n0 = t._0
        return f"load({n0})"
    else:
        if isinstance(t, Emit):
            n0 = t._0
            s1 = t._1
            if n0 > 2:
                return f"emit!({n0},{s1})"
        if isinstance(t, Emit):
            n0 = t._0
            s1 = t._1
            return f"emit({n0},{s1})"
        else:
            if isinstance(t, Mark):
                n0 = t._0
                if n0 > 8:
                    return f"mark!({n0})"
            n0 = t._0
            return f"mark({n0})"
def score(t: Signal) -> int:
    if isinstance(t, Load):
        x0 = t._0
        return x0
    else:
        return 0
stream: list[Signal] = [Emit(10, "quin"), Mark(9), Mark(1), Load(-2)]
print(_pf_str_join("; ", _pf_map(describe, stream)))
grandSum: int = _pf_sum_by(score, stream)
print(f"grandSum={grandSum}")
print((_pf_head(stream), _pf_last(stream)))
segments: list[float] = [277.2, 242.0, 296.9]
durations: list[float] = [30.7, 41.9, 6.1]
dist: float = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate: float = dist / dur
print(_pf_fmt_fixed(1, rate))
km: float = dist / 1000.0
print(_pf_fmt_fixed(1, km))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn0, _pf_zip(segments, durations))
print(best)
edge: float = math.sqrt(6.25)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
book: list[Ticket] = [Ticket(100, "fay", 83, True, Site("Oslo", 3)), Ticket(101, "fay", 202, True, Site("Oslo", 3)), Ticket(102, "fay", 54, False, Site("Lima", 3)), Ticket(103, "gus", 294, True, Site("Bern", 3))]
def adjust(pct: int, o: Ticket) -> Ticket:
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Ticket(_pf_t0.id, _pf_t0.owner, o.amount + extra, False, _pf_t0.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 7), book)))
def tag(o: Ticket) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, book)))
def _pf_fn1(o):
    if o.dest.zone > 2:
        _pf_t4 = o
        return Ticket(_pf_t4.id, _pf_t4.owner, _pf_t4.amount, _pf_t4.urgent, Site("Hub", 1))
    else:
        return o
rerouted: list[Ticket] = _pf_map(_pf_fn1, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by_desc(lambda o: o.amount, book))))
