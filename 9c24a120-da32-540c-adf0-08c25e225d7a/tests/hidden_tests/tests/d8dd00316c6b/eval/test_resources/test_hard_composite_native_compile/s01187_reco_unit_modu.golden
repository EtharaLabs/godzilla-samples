from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
parcels: list[Order] = [Order(100, "jo", 74, False, Site("Doha", 2)), Order(101, "jo", 42, False, Site("Oslo", 1)), Order(102, "jo", 77, True, Site("Baku", 2)), Order(103, "jo", 224, False, Site("Riga", 1))]
cheap, dear = _pf_partition(lambda o: o.amount < 105, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, parcels))
print(byOwner)
rushSum: int = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(rushSum)
def bucket(o: Order) -> str:
    if isinstance(o, Order) and o.urgent is True:
        amount = o.amount
        if amount > 184:
            return "rush-big"
    if isinstance(o, Order) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 184:
            return "big"
        else:
            return "normal"
print(_pf_map(bucket, parcels))
print(_pf_count_by(bucket, parcels))
def _pf_fn1(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Order(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
moved: list[Order] = _pf_map(_pf_fn1, parcels)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
laps: list[float] = [152.4, 386.6, 217.5, 418.9, 113.6]
durations: list[float] = [21.5, 34.3, 15.5, 35.5, 52.1]
dist: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace: float = dist / elapsed
print(_pf_fmt_fixed(1, pace))
def _pf_fn2(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn2, _pf_zip(laps, durations))
print(best)
side: float = math.sqrt(49.0)
cube: float = side * side * side
print(f"{side} {math.cbrt(cube)}")
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_square(x):
    return x * x
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts: list[int] = [-1, 17, 14, -6, -12, 11]
print(Stats_scaleAll(5, pts))
print(_pf_map(Stats_square, pts))
print(Stats_norm1(pts))
print(Stats_mean(pts))
