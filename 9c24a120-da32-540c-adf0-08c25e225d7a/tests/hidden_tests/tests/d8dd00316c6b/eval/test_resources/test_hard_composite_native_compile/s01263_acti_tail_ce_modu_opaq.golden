from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _ap_Above(n):
    if n > 23:
        return Some(n - 23)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [19, 29, 33, 36, 13, -4]))
def collatz(n: int, acc: int) -> int:
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [3, 56, 34]))
def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(5, 13, 1))
def parseEntry(line: str) -> Some | None_:
    def _pf_fn0():
        _pf_t3 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t3, Some):
            v = _pf_t3._0
            _pf_t2 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t2, Some):
                n = _pf_t2._0
                return Some(n * 5)
            else:
                return _pf_t2
        else:
            return _pf_t3
    return _pf_fn0()
lines: list[str] = ["ned = 5", "gus", "dee=6=1", "ray = 4", "sue = 0"]
results: list[Some | None_] = _pf_map(parseEntry, lines)
_pf_iter(print, results)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), results)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), results))))
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
obs: list[int] = [30, 23, 19, 11, 20, 23, -7]
print(Stats_norm1(obs))
print(_pf_filter(functools.partial(Stats_between, -4, 23), obs))
print(Stats_scaleAll(3, obs))
def rawOf(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("sku", 3)
print(_pf_str_join(" ", _pf_map(rawOf, ids)))
print(_pf_head(ids) == Some("acc-1"))
