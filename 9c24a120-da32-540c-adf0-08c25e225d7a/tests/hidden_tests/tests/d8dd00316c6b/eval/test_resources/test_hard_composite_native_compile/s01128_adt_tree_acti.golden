from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    _1: int
    def __repr__(self):
        return f"Halt({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    def __repr__(self):
        return "Store"
_Store: Store = Store()
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
Move = Pop | Halt | Store | Skip
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Heap"
    _1: int
    _2: "Heap"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Heap = Leaf | Node
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def explain(t: Move) -> str:
    if isinstance(t, Pop):
        n0 = t._0
        return f"pop({n0})"
    elif isinstance(t, Halt):
        s0 = t._0
        n1 = t._1
        return f"halt({s0},{n1})"
    elif isinstance(t, Store):
        return f"store"
    else:
        s0 = t._0
        return f"skip({s0})"
def rank(t: Move) -> int:
    if isinstance(t, Pop):
        x0 = t._0
        return x0
    elif isinstance(t, Halt):
        x1 = t._1
        return x1
    elif isinstance(t, Skip):
        return 3
    else:
        return 2
prog: list[Move] = [Halt("lu", 2), Skip("cy"), Skip("fay"), Pop(10), Skip("sue")]
print(_pf_str_join(" ", _pf_map(explain, prog)))
grandSum: int = _pf_sum_by(rank, prog)
print(f"grandSum={grandSum}")
print(_pf_max_by(rank, prog))
def add(x: int, t: Heap) -> Heap:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(add(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, add(x, rt))
        return t
tree: Heap = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [59, 30, 47, 3, 33, 48])
def toListT(t: Heap) -> list[int]:
    if isinstance(t, Leaf):
        return []
    else:
        l = t._0
        v = t._1
        rt = t._2
        return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
print(toListT(tree))
def depthT(t: Heap) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        rt = t._2
        return 1 + max(depthT(l), depthT(rt))
print(depthT(tree))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 8:
        return Some(n - 8)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(bucketOf, [36, 5, -2, -3, 23, 4]))
