    return int(s, base=2)
print(fromBin("111010") + int("47", base=8))
log: list[str] = ["bo", "ada", "dee", "dee", "dee", "cy", "fay", "fay", "cy"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in log:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
counts: dict[str, int] = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, counts))
extra: dict[str, int] = dict([("zed", 5), ("bo", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, counts))))
print(len(_pf_map_filter(lambda k, v: v > 1, counts)))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [12, 8, 3, 11, 7]))
def digitSum(n: int) -> int:
    if n == 0:
        return 0
    else:
        return n % 10 + digitSum(n // 10)
print(digitSum(16842))
def insert(x: int, t: Tree) -> Tree:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
tree: Tree = _pf_fold(lambda acc, x: insert(x, acc), _Leaf, [50, 21, 22, 9, 10, 20, 48, 52])
def containsOf(x: int, t: Tree) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
print(_pf_map(lambda k: containsOf(k, tree), [50, 53, 12]))
def toListOf(t: Tree) -> list[int]:
    if isinstance(t, Leaf):
        return []
    else:
        l = t._0
        v = t._1
        rt = t._2
        return _pf_concat(toListOf(l), _pf_concat([v], toListOf(rt)))
print(toListOf(tree))
def depthT(t: Tree) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        rt = t._2
        return 1 + max(depthT(l), depthT(rt))
print(depthT(tree))
