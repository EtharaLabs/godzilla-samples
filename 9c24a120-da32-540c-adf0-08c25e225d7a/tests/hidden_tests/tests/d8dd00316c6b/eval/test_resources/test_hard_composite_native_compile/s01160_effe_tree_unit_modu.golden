from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Ast"
    _1: "Ast"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Ast"
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
Ast = Num | Add | Mul | Neg | Var
def discount(price: int, qty: int) -> int:
    return price * qty - 6 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("cap", 19, 5), ("cog", 49, 3), ("tap", 16, 4)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(12)([1, 2, 3]))
env: dict[str, int] = dict([("x", 6), ("y", -5)])
def evalE(e: Ast) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    elif isinstance(e, Neg):
        a = e._0
        return -evalE(a)
    else:
        v = e._0
        return _pf_map_find_or(v, 0, env)
def render(e: Ast) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    elif isinstance(e, Neg):
        a = e._0
        return f"-{render(a)}"
    else:
        v = e._0
        return v
exprs: list[Ast] = [Add(Num(1), Neg(Neg(Var("x")))), Mul(Neg(Num(7)), Add(Num(3), Mul(Var("x"), Num(2)))), Mul(Num(-1), Add(Add(Num(0), Num(0)), Neg(Var("y"))))]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evalE, exprs))
laps: list[float] = [321.0, 343.0, 123.8, 159.4, 446.8]
times: list[float] = [80.9, 7.8, 86.3, 80.3, 22.9]
total: float = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, times)
speed: float = total / elapsed
print(_pf_fmt_fixed(2, speed))
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn1, _pf_zip(laps, times))
print(best)
km: float = total / 1000.0
print(_pf_fmt_fixed(1, km))
edge: float = math.sqrt(16.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
speeds: list[float] = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_square(x):
    return x * x
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
obs: list[int] = [1, 17, -6, 10, 20]
print(_pf_filter(functools.partial(Calc_between, 0, 21), obs))
print(_pf_map(Calc_square, obs))
print(Calc_norm1(obs))
