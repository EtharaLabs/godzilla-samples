        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn5, _pf_indexed(_pf_x))
result: bool = _pf_exists(lambda x: x > 16, _pf_fn1(_pf_fn4(_pf_sort_by(lambda x: -x, _pf_filter(lambda x: x > 5, readings)))))
