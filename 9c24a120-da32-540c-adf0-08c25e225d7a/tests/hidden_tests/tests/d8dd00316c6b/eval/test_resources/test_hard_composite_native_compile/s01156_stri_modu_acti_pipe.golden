from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
sentence: str = "max;hub;pin;tap;rod;ned"
tokens: list[str] = _pf_str_split(";", sentence)
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
print(_pf_str_replace("o", "O", sentence))
print(_pf_str_slice(3, 6, sentence))
fieldsN: list[Some | None_] = _pf_map(_pf_str_to_int, _pf_str_split(",", "7,x,40,12,-3"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
def row2(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(10, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(tokens)))
count: int = len(tokens)
print(f"count={count} {{braces}} {len(sentence)}")
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_square(x):
    return x * x
obs: list[int] = [-7, 28, -2, 13, 10, -6]
print(_pf_filter(functools.partial(Geo_between, 5, 16), obs))
print(Geo_scaleAll(3, obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 7), obs))
print(_pf_map(Geo_square, obs))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 9:
        return Some(n - 9)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def classify(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(classify, [4, 38, 22, 27, 34]))
readings: list[int] = [15, 49, 28, 14, 39, 27]
def offset(k: int, x: int) -> int:
    return x + k
def _pf_fn1(_pf_x):
