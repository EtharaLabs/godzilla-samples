from dataclasses import dataclass
from typing import Any
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def countDown(n: int, acc: int) -> int:
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(1643, 0))
def collatz(n: int, acc: int) -> int:
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [60, 35, 40]))
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("u", 2)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
def net(price: int, qty: int) -> int:
    return price * qty - 4 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("gear", 44, 3), ("pin", 27, 1)]))
print(overall)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(5)([1, 2, 3]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
def row(n: int) -> list[int]:
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
