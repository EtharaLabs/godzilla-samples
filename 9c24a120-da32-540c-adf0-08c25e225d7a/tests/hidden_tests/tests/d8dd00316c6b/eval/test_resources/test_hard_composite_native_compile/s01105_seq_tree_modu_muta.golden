from dataclasses import dataclass
from typing import Any
import functools
import itertools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: "Term"
    _1: "Term"
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: "Term"
    def __repr__(self):
        return f"Neg({self._0!r})"
Term = Num | Add | Mul | Neg
def _pf_fn0():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
evens = _pf_fn0()
print(list(_pf_seq_take(3, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
def evalE(e: Term) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return evalE(a) + evalE(b)
    elif isinstance(e, Mul) and isinstance(e._0, Num) and e._0._0 == 0:
        return 0
    elif isinstance(e, Mul) and isinstance(e._1, Num) and e._1._0 == 0:
        return 0
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return evalE(a) * evalE(b)
    else:
        a = e._0
        return -evalE(a)
def pretty(e: Term) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({pretty(a)} + {pretty(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{pretty(a)} * {pretty(b)}"
    else:
        a = e._0
        return f"-{pretty(a)}"
terms: list[Term] = [Mul(Add(Num(1), Neg(Num(1))), Add(Neg(Num(5)), Num(3))), Neg(Neg(Neg(Num(-1)))), Neg(Add(Neg(Num(-2)), Mul(Num(7), Num(-1))))]
_pf_iter(print, _pf_map(pretty, terms))
print(_pf_map(evalE, terms))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_square(x):
    return x * x
pts: list[int] = [17, 10, 22, 28]
print(Geo_mean(pts))
print(_pf_filter(functools.partial(Geo_between, -4, 11), pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 11), pts))
print(_pf_map(Geo_square, pts))
hits: int = 0
def record(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 4
def profile(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([53, 34, 25, -19]))
doubled: list[int] = _pf_map(record, [53, 34, 25, -19])
print(f"{doubled} after {hits} calls")
