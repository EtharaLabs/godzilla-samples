from dataclasses import dataclass
from typing import Any
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_map_values(m):
    return list(m.values())
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
calls: int = 0
def record(x: int) -> int:
    global calls
    calls = calls + 1
    return x * 3
def summarize(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([37, 13, 37, 12]))
doubled: list[int] = _pf_map(record, [37, 13, 37, 12])
print(f"{doubled} after {calls} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), calls))
def lcm(a: int, b: int) -> int:
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [5, 10, 6, 7]))
def fromBin(s: str) -> int:
    return int(s, base=2)
print(fromBin("111") + int("11", base=8))
def _pf_fn0():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
evens = _pf_fn0()
print(list(filter(lambda n: n % 3 == 0, evens)))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
log: list[str] = ["dee", "cy", "eli", "dee", "fay", "bo", "eli", "ada", "eli"]
m = dict()
for w in log:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
hist: dict[str, int] = m
def _pf_fn1(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn1, _pf_map_to_list(hist)))
print((_pf_map_try_find("bo", hist), "bo" in hist))
extra: dict[str, int] = dict([("zed", 5), ("dee", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, hist))))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, hist))))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(hist))))
