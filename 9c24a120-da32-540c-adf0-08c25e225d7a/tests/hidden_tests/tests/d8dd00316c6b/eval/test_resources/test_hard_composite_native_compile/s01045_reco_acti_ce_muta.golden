def _ap_Above(n):
    if n > 28:
        return Some(n - 28)
    else:
        return _None_
def kindOf(n: int) -> str:
    _pf_t3 = _ap_Above(n)
    if isinstance(_pf_t3, Some):
        d = _pf_t3._0
