_pf_iter(print, _pf_map(kindOf, [15, 3, 18, 29, 30, 23, 7]))
def readPair(line: str) -> Some | None_:
    def _pf_fn2():
        _pf_t5 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t5, Some):
            v = _pf_t5._0
