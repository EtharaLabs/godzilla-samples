        _pf_t2 = o
        return Invoice(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
moved: list[Invoice] = _pf_map(_pf_fn0, orders)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
def _pf_fn1(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn1, _pf_group_by(lambda o: o.owner, orders))
print(byOwner)
cheap, dear = _pf_partition(lambda o: o.amount < 152, orders)
