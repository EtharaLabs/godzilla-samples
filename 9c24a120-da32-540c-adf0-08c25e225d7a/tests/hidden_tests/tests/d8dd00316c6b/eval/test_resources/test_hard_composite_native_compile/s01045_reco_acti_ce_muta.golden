    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
orders: list[Invoice] = [Invoice(100, "ned", 57, True, Site("Bern", 4)), Invoice(101, "ned", 272, False, Site("Bern", 2)), Invoice(102, "ned", 113, False, Site("Baku", 2)), Invoice(103, "ned", 82, False, Site("Lima", 4))]
