from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_concat(a, b):
    return a + b
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def parseEntry(line: str) -> Some | None_:
    def _pf_fn0():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t1, Some):
            v = _pf_t1._0
            _pf_t0 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some(n * 2)
            else:
                return _pf_t0
        else:
            return _pf_t1
    return _pf_fn0()
lines: list[str] = ["kit", "eli = 3", "bo = 0", "ned=x", "lu=50"]
parsed: list[Some | None_] = _pf_map(parseEntry, lines)
_pf_iter(print, parsed)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), parsed)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), parsed))))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs: list[int] = [3, 27, -11, 19, 22]
print(Geo_scaleAll(5, obs))
print(_pf_filter(functools.partial(Geo_between, -1, 18), obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 8), obs))
sentence: str = "ned oz eli rod quin cap sue"
words: list[str] = _pf_str_split(" ", sentence)
def row2(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(9, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(words)))
