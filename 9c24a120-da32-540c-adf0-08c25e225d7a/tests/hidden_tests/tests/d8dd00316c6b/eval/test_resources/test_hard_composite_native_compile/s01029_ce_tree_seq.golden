from dataclasses import dataclass
from typing import Any
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Heap"
    _1: int
    _2: "Heap"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Heap = Leaf | Node
def decodeLine(line: str) -> Some | None_:
