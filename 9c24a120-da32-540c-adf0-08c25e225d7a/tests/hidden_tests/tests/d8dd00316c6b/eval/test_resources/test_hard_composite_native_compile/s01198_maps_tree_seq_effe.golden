def calc(e: Expr) -> int:
    if isinstance(e, Num):
        n = e._0
        return n
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return calc(a) + calc(b)
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return calc(a) * calc(b)
    else:
        a = e._0
        return -calc(a)
def render(e: Expr) -> str:
    if isinstance(e, Num):
        n = e._0
        if n < 0:
            return f"({n})"
    if isinstance(e, Num):
        n = e._0
        return f"{n}"
    elif isinstance(e, Add):
        a = e._0
        b = e._1
        return f"({render(a)} + {render(b)})"
    elif isinstance(e, Mul):
        a = e._0
        b = e._1
        return f"{render(a)} * {render(b)}"
    else:
        a = e._0
        return f"-{render(a)}"
terms: list[Expr] = [Add(Num(4), Num(8)), Mul(Neg(Mul(Num(3), Num(9))), Num(7)), Add(Neg(Add(Num(4), Num(0))), Add(Add(Num(-2), Num(2)), Add(Num(0), Num(4))))]
