from dataclasses import dataclass
from typing import Any
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Ticket:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: "Site"
orders: list[Ticket] = [Ticket(100, "max", 35, False, Site("Oslo", 3)), Ticket(101, "ada", 75, False, Site("Kyiv", 2)), Ticket(102, "ada", 35, False, Site("Doha", 4)), Ticket(103, "max", 102, False, Site("Baku", 4))]
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, orders))))
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Ticket(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Site("Hub", 1))
    else:
        return o
moved: list[Ticket] = _pf_map(_pf_fn0, orders)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
def label(o: Ticket) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, orders)))
cheap, dear = _pf_partition(lambda o: o.amount < 66, orders)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("acc", 3)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
segments: list[float] = [302.4, 17.3, 396.6, 128.5, 288.5]
times: list[float] = [89.2, 24.9, 22.0, 33.6, 89.3]
total: float = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur: float = _pf_fold(lambda a, b: a + b, 0.0, times)
speed: float = total / dur
print(_pf_fmt_fixed(3, speed))
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best: Some | None_ = _pf_max_by(_pf_fn1, _pf_zip(segments, times))
print(best)
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
speeds: list[float] = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
readings: list[int] = [-7, 40, 17, -9, 41, 24, 9, -5, 7, 2]
answer: bool = _pf_exists(lambda x: x > 19, _pf_collect(lambda x: [x, x + 1], _pf_map(lambda x: (-x if x < 0 else x * 4), _pf_rev((lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(3, _pf_x)))(_pf_drop_while(lambda x: x < 1, readings))))))
print(answer)
print(len(readings))
