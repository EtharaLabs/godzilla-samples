from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Bst"
    _1: int
    _2: "Bst"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Bst = Leaf | Node
def net(price: int, qty: int) -> int:
    return price * qty - 5 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("bolt", 36, 5), ("hub", 6, 2), ("hub", 6, 4), ("wick", 14, 4)]))
print(overall)
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n: int) -> str:
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [29, 4, -4, 28, 1, -3]))
def parseEntry(line: str) -> Some | None_:
    def _pf_fn1():
        _pf_t2 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t2, Some):
            v = _pf_t2._0
            _pf_t1 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t1, Some):
                n = _pf_t1._0
                return Some(n * 4)
            else:
                return _pf_t1
        else:
            return _pf_t2
    return _pf_fn1()
lines: list[str] = ["gus=x", "hal = 8", "bo=76", "fay", "ivy=9=1"]
parsed: list[Some | None_] = _pf_map(parseEntry, lines)
_pf_iter(print, parsed)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), parsed)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), parsed))))
def insert(x: int, t: Bst) -> Bst:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
root: Bst = _pf_fold(lambda acc, x: insert(x, acc), _Leaf, [23, 49, 4, 42, 53])
def containsOf(x: int, t: Bst) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
print(_pf_map(lambda k: containsOf(k, root), [23, 54, 23]))
def depthT(t: Bst) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        rt = t._2
        return 1 + max(depthT(l), depthT(rt))
print(depthT(root))
def minOf(t: Bst) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minOf(root))
def sumT(t: Bst) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumT(l) + v + sumT(rt)
print(sumT(root))
