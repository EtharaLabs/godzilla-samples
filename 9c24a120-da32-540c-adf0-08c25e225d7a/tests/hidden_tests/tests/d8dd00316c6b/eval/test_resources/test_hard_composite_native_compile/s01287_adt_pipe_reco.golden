Msg = Rest | Store | Load | Drop | Skip
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
def render(t: Msg) -> str:
    if isinstance(t, Rest):
        s0 = t._0
        return f"rest({s0})"
    else:
        if isinstance(t, Store):
            n0 = t._0
            if n0 > 2:
                return f"store!({n0})"
        if isinstance(t, Store):
            n0 = t._0
            return f"store({n0})"
        elif isinstance(t, Load):
            s0 = t._0
            return f"load({s0})"
        elif isinstance(t, Drop):
            n0 = t._0
            n1 = t._1
            return f"drop({n0},{n1})"
        elif isinstance(t, Skip) and t._0 == 1:
            return "skip-1"
        else:
            n0 = t._0
            return f"skip({n0})"
def rank(t: Msg) -> int:
    if isinstance(t, Store):
        x0 = t._0
        return x0
    elif isinstance(t, Load):
        return 1
    elif isinstance(t, Rest):
        return 5
    else:
        return 3
