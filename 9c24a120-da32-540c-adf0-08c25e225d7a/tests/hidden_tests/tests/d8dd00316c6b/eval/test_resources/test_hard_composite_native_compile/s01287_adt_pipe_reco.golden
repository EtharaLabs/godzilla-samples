def bucket(o: Invoice) -> str:
    if isinstance(o, Invoice) and o.urgent is True:
        amount = o.amount
        if amount > 164:
            return "rush-big"
    if isinstance(o, Invoice) and o.urgent is True:
        return "rush"
    else:
        amount = o.amount
        if amount > 164:
            return "big"
        else:
            return "normal"
