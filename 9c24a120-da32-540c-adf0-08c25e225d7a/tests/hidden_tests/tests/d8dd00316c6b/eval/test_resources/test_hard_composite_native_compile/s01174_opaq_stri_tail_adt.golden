from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: str
    _1: int
    def __repr__(self):
        return f"Halt({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: str
    def __repr__(self):
        return f"Rest({self._0!r})"
Move = Store | Halt | Rest
def unwrap(x) -> str:
    s = x
    return s
def mint(prefix, n: int):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("sku", 2)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("u-1"))
raw: str = "pam;jo;eli;ivy;bo;tap;hal"
words: list[str] = _pf_str_split(";", raw)
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
n2: int = len(words)
print(f"n2={n2} {{braces}} {len(raw)}")
print((_pf_str_index_of("ha", raw), "ha" in raw))
print(_pf_str_replace("u", "U", raw))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
def euclid(a: int, b: int) -> int:
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(366, 257))
def ipow(b: int, e: int, acc: int) -> int:
    while True:
        if e == 0:
            return acc
        else:
            k = e
            if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            k = e
            b, e, acc = (b * b, k // 2, acc)
            continue
print(ipow(3, 20, 1))
def countDown(n: int, acc: int) -> int:
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(2130, 0))
def show(t: Move) -> str:
    if isinstance(t, Store):
        n0 = t._0
        if n0 > 8:
            return f"store!({n0})"
    if isinstance(t, Store):
        n0 = t._0
        return f"store({n0})"
    elif isinstance(t, Halt):
        s0 = t._0
        n1 = t._1
        return f"halt({s0},{n1})"
    else:
        s0 = t._0
        return f"rest({s0})"
def score(t: Move) -> int:
    if isinstance(t, Halt):
        x1 = t._1
        return x1
    else:
        return 1
batch: list[Move] = [Store(4), Store(0), Rest("oz"), Store(7)]
_pf_iter(lambda t: print(show(t)), batch)
tally: int = _pf_sum_by(score, batch)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: score(t) > 5, batch)))
