from dataclasses import dataclass
import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
legs: list[float] = [250.5, 252.5, 80.9, 24.3]
splits: list[float] = [74.4, 24.6, 23.5, 90.0]
total: float = _pf_fold(lambda a, b: a + b, 0.0, legs)
elapsed: float = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed: float = total / elapsed
print(_pf_fmt_fixed(3, speed))
def paceOf(d: int, t: int) -> float:
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
edge: float = math.sqrt(9.0)
cube: float = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
speeds: list[float] = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
orders: list[Order] = [Order(100, "oz", 153, False), Order(101, "oz", 299, False), Order(102, "quin", 30, False), Order(103, "quin", 43, False), Order(104, "quin", 243, False), Order(105, "cy", 124, True)]
def tag(o: Order) -> str:
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(tag, orders)))
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
perOwner: list[tuple[str, int, int]] = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, orders))
print(perOwner)
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by(lambda o: o.amount, orders))))
def net(price: int, qty: int) -> int:
    return price * qty - 9 * qty
def emit(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand: int = sum(_pf_map(_pf_fn1, [("rod", 20, 4), ("rod", 35, 4), ("nut", 10, 3)]))
print(grand)
def scaled(k: int):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(6)([1, 2, 3]))
text: str = "oz,ned,eli,cy,wick"
words: list[str] = _pf_str_split(",", text)
def row2(_pf_arg0: tuple[int, str]) -> str:
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(8, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(words)))
n2: int = len(words)
print(f"n2={n2} {{braces}} {len(text)}")
print(_pf_map(lambda w: (w, len(w)), words))
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
