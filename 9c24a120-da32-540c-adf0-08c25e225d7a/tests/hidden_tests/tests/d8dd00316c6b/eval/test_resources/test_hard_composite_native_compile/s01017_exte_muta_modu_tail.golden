import functools
import math
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_str_rev(s):
    return "".join(reversed(s))
def row(n: int) -> list[int]:
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(4))
print(_pf_map(math.isqrt, [348, 149, 28, 75]))
print(_pf_str_rev(str.upper("cy")))
hits: int = 0
def track(x: int) -> int:
    global hits
    hits = hits + 1
    return x * 3
def stats(xs: list[int]) -> str:
    lo = 1000
    hi = -1000
    total = 0
    def visit(x: int):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([55, 49, 59, 17, 11, 24, 42, -20]))
doubled: list[int] = _pf_map(track, [55, 49, 59, 17])
print(f"{doubled} after {hits} calls")
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_square(x):
    return x * x
pts: list[int] = [15, -3, -8, 9, 2]
print(Text_mean(pts))
print(_pf_map(functools.partial(Text_clamp, 0, 6), pts))
print(Text_scaleAll(3, pts))
print(_pf_map(Text_square, pts))
def collatz(n: int, acc: int) -> int:
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [10, 34, 10]))
def isEven(n: int) -> bool:
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n: int) -> bool:
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [18, 13, 19, 16, 7]))
