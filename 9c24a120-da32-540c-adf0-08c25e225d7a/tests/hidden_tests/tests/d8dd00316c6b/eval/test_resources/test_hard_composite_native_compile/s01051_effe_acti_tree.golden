from dataclasses import dataclass
from typing import Any
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf: Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: "Bst"
    _1: int
    _2: "Bst"
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
Bst = Leaf | Node
def net(price: int, qty: int) -> int:
    return price * qty - 7 * qty
def report(label, price: int, qty: int) -> int:
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall: int = sum(_pf_map(_pf_fn0, [("cog", 9, 6), ("pin", 30, 4), ("cap", 40, 1), ("wick", 28, 5)]))
print(overall)
def _ap_Above(n):
    if n > 24:
        return Some(n - 24)
    else:
        return _None_
def bucketOf(n: int) -> str:
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [23, 14, 40, 16, 15, 7]))
def insert(x: int, t: Bst) -> Bst:
    if isinstance(t, Leaf):
        return Node(_Leaf, x, _Leaf)
    else:
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x < v:
                return Node(insert(x, l), v, rt)
        if isinstance(t, Node):
            l = t._0
            v = t._1
            rt = t._2
            if x > v:
                return Node(l, v, insert(x, rt))
        return t
root: Bst = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [33, 45, 26, 15, 48, 56, 50, 49])
def minT(t: Bst) -> Some | None_:
    while True:
        if isinstance(t, Leaf):
            return _None_
        elif isinstance(t, Node) and isinstance(t._0, Leaf):
            v = t._1
            return Some(v)
        else:
            l = t._0
            t = l
            continue
print(minT(root))
def sumOf(t: Bst) -> int:
    if isinstance(t, Leaf):
        return 0
    else:
        l = t._0
        v = t._1
        rt = t._2
        return sumOf(l) + v + sumOf(rt)
print(sumOf(root))
def containsOf(x: int, t: Bst) -> bool:
    while True:
        if isinstance(t, Leaf):
            return False
        else:
            l = t._0
            v = t._1
            rt = t._2
            if x == v:
                return True
            elif x < v:
                x, t = (x, l)
                continue
            else:
                x, t = (x, rt)
                continue
print(_pf_map(lambda k: containsOf(k, root), [33, 50, 52]))
