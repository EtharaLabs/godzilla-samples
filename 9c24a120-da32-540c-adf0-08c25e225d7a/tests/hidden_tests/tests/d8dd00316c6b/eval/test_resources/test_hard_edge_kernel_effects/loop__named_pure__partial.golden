00000329import functools
counter = 0
def quiet(x):
    return None
def shout(x):
    return print(x)
def log(t, x):
    return print(f"{t}:{x}")
def loop(f, n):
    while True:
        if n == 0:
            return None
        else:
            f(n)
            f, n = (f, n - 1)
            continue
h = functools.partial(loop, quiet)
