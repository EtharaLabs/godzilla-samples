def describe(t):
    match t:
        case Rest(n0):
            return f"rest({n0})"
        case Push(n0, s1):
            return f"push({n0},{s1})"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Rest(x0):
            return x0
        case Drop(x0, x1):
            return x0 + x1 * 5
        case _:
            return 2
