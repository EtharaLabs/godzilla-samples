env = dict([("x", 3), ("y", 9)])
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Add(Num(1), Num(-2)), Num(3), Num(-2)]
_pf_iter(print, _pf_map(pretty, terms))
