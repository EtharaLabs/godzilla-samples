from dataclasses import dataclass
import functools
import itertools
import json
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
def _pf_dec_bool(v):
    if isinstance(v, bool):
        return v
    raise ValueError("expected a bool, got " + type(v).__name__)
def _pf_dec_field(name, dec):
    def go(v):
        if not isinstance(v, dict):
            raise ValueError("expected a JSON object")
        return dec(v[name])
    return go
def _pf_dec_int(v):
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    raise ValueError("expected an int, got " + type(v).__name__)
def _pf_dec_map3(f, da, db, dc):
    def go(v):
        return f(da(v), db(v), dc(v))
    return go
def _pf_dec_string(v):
    if isinstance(v, str):
        return v
    raise ValueError("expected a string, got " + type(v).__name__)
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    points: int
    active: bool
laps = [355.0, 191.6, 97.5]
durations = [33.6, 42.2, 87.5]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate = dist / dur
print(_pf_fmt_fixed(3, rate))
edge = math.sqrt(6.25)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
speeds = _pf_map2(lambda d, t: d / t, laps, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
mass = 26.0
accel = 7.5
push = mass * accel
limit = 341.0
print("over" if push > limit else "under")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
rows = [Stock("wick", 14, 2.74), Stock("bolt", 29, 15.25), Stock("gear", 0, 24.72), Stock("cog", 28, 9.08), Stock("nut", 3, 39.37)]
def showRow(x):
    return "{} {} {} {} {}".format(_pf_fmt_pad_right(7, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 11 else "ok", _pf_fmt_currency("$", 2, x.price * 9.0))
_pf_iter(print, _pf_map(showRow, rows))
print("{} rows, {}={}".format(len(rows), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, rows))))
def _pf_fn0():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
    yield 112
squares = _pf_fn0()
print(list(filter(lambda n: n % 3 == 0, squares)))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
decoder = _pf_dec_map3(lambda n, p, a: Entry(n, p, a), _pf_dec_field("name", _pf_dec_string), _pf_dec_field("points", _pf_dec_int), _pf_dec_field("active", _pf_dec_bool))
jsonText = "[{\"name\": \"gus\", \"points\": 25, \"active\": true}, {\"name\": \"pam\", \"points\": 27, \"active\": false}, {\"name\": \"oz\", \"points\": 15, \"active\": false}, {\"name\": \"bo\", \"points\": 85, \"active\": false}]"
_pf_t1 = lambda n, p, a: Entry(n, p, a)
try:
    _pf_t2 = json.loads(jsonText)
    if not isinstance(_pf_t2, list):
        raise ValueError("expected a JSON array")
    _pf_t3 = []
    for _pf_t4 in _pf_t2:
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t5 = _pf_t4["name"]
        if not isinstance(_pf_t5, str):
            raise ValueError("expected a string, got " + type(_pf_t5).__name__)
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t6 = _pf_t4["points"]
        if not (isinstance(_pf_t6, int) and not isinstance(_pf_t6, bool)):
            raise ValueError("expected an int, got " + type(_pf_t6).__name__)
        if not isinstance(_pf_t4, dict):
            raise ValueError("expected a JSON object")
        _pf_t7 = _pf_t4["active"]
        if not isinstance(_pf_t7, bool):
            raise ValueError("expected a bool, got " + type(_pf_t7).__name__)
        _pf_t3.append(_pf_t1(_pf_t5, _pf_t6, _pf_t7))
    _pf_t8 = Ok(_pf_t3)
except Exception as e:
    _pf_t8 = Error(_Exception(type(e).__name__, str(e)))
if isinstance(_pf_t8, Ok):
    ps = _pf_t8._0
    live = _pf_filter(lambda p: p.active, ps)
    _pf_t0 = print(f"{len(live)} active, {_pf_sum_by(lambda p: p.points, live)} points")
else:
    e = _pf_t8._0
    _pf_t0 = print(f"decode failed: {e.errorKind}")
_pf_t0
