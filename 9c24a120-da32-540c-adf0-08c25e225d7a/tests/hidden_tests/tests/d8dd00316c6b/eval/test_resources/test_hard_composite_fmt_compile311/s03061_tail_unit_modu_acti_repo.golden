from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [7, 8, 21, 14, 0]))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [14, 19, 31]))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(369, 153))
segments = [179.4, 450.6, 398.2, 187.9, 164.5]
times = [63.4, 51.4, 65.5, 88.7, 29.5]
dist = _pf_fold(lambda a, b: a + b, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = dist / elapsed
print(_pf_fmt_fixed(3, rate))
speeds = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(segments, times))
print(best)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_square(x):
    return x * x
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums = [1, -15, -7, 30, 26, 7]
print(_pf_map(functools.partial(Calc_clamp, 0, 8), nums))
print(Calc_scaleAll(2, nums))
print(_pf_map(Calc_square, nums))
print(Calc_mean(nums))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 9:
        return Some(n - 9)
    else:
        return _None_
def classify(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif isinstance(_pf_t1, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(classify, [17, 7, 8, -1, 27, 2]))
rows = [Stock("pin", 25, 16.09), Stock("hub", 9, 13.64), Stock("nut", 23, 17.03)]
def renderRow(x):
    return "{}: {}: {}".format(_pf_fmt_pad_right(9, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price))
_pf_iter(print, _pf_map(renderRow, rows))
print("{} rows, {}={}".format(len(rows), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, rows))))
