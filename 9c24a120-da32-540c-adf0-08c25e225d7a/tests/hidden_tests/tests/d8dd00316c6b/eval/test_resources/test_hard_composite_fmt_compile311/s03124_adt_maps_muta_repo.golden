def show(t):
    match t:
        case Turn(s0):
            return f"turn({s0})"
        case Rest(n0) if n0 > 7:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Skip(s0, n1):
            return f"skip({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
