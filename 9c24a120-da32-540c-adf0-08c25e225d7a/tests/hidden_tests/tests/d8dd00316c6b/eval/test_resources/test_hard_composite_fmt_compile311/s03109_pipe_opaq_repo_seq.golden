from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
samples = [25, -5, 23, -7, 6, 18, 6, 19, -2, 13, 49]
def offset(k, x):
    return x + k
stage = lambda _pf_x: _pf_collect(lambda x: [x, x + 1], (lambda _pf_x: _pf_distinct((lambda _pf_x: _pf_take(2, (lambda _pf_x: _pf_map(functools.partial(max, 2), _pf_drop(2, _pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
digest = _pf_exists(lambda x: x > 36, stage(samples))
print(digest)
print(len(samples))
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("sku", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
rows = [Line("cog", 12, 23.97), Line("cap", 17, 20.24), Line("rod", 8, 20.03), Line("tap", 7, 26.57)]
def showRow(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(8, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), _pf_fmt_currency("$", 2, x.price * 5.0))
_pf_iter(print, _pf_map(showRow, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
def _pf_fn0():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
series = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, series))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 961, fib)))
