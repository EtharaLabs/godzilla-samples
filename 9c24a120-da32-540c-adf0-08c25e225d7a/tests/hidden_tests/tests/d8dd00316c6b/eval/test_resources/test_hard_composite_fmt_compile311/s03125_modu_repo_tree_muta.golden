from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [20, 26, -15, 22, 17, 17, 28]
print(_pf_filter(functools.partial(Stats_between, 5, 13), pts))
print(_pf_map(functools.partial(Stats_clamp, 0, 5), pts))
print(Stats_scaleAll(5, pts))
print(Stats_norm1(pts))
entries = [Stock("rod", 28, 15.45), Stock("pin", 7, 3.16), Stock("bolt", 29, 8.13)]
def renderRow(x):
    return "{}|{}|{}|{}|{}".format(_pf_fmt_pad_right(10, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 13 else "ok", _pf_fmt_currency("$", 2, x.price * 6.0))
_pf_iter(print, _pf_map(renderRow, entries))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 8, entries))
print("low: {} ({})".format(_pf_str_join("", low), _pf_fmt_percent(1, 0.5 * 1.0)))
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Mul(Add(Num(2), Neg(Num(0))), Neg(Add(Num(0), Num(0)))), Add(Num(0), Num(3))]
_pf_iter(print, _pf_map(pretty, exprs))
print(_pf_map(calc, exprs))
hits = 0
def track(x):
    global hits
    hits = hits + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([20, 42, 25, 54, 58, 19]))
doubled = _pf_map(track, [20, 42, 25, 54])
print(f"{doubled} after {hits} calls")
trackTwice = lambda _pf_x: track(track(_pf_x))
print((trackTwice(3), hits))
