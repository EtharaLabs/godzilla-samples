from dataclasses import dataclass
import functools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
segments = [270.8, 268.1, 356.8]
durations = [59.9, 70.9, 71.2]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed = dist / elapsed
print(_pf_fmt_fixed(2, speed))
speeds = _pf_map2(lambda d, t: d / t, segments, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
edge = math.sqrt(9.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
lines = [Line("gear", 12, 25.83), Line("hub", 17, 39.81), Line("wick", 3, 8.49)]
def showRow(x):
    return "{}: {}: {}: {}".format(_pf_fmt_pad_right(7, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), _pf_fmt_currency("$", 2, x.price * 4.0))
_pf_iter(print, _pf_map(showRow, lines))
print("{} rows, {}={}".format(len(lines), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, lines))))
ticks = 0
def note(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([43, 53, -7, 57, 55, 8, -9]))
doubled = _pf_map(note, [43, 53, -7, 57])
print(f"{doubled} after {ticks} calls")
