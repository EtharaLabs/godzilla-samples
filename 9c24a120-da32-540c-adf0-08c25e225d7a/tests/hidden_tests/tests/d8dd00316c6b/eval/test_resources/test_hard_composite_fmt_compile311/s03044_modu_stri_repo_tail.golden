from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
def Geo_square(x):
    return x * x
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
pts = [24, 14, 15, 19, -11]
print(_pf_map(Geo_square, pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 15), pts))
print(_pf_filter(functools.partial(Geo_between, -5, 24), pts))
text = "gear;nut;lu;tom;max;cap"
tokens = _pf_str_split(";", text)
print(_pf_str_replace("u", "U", text))
print(_pf_str_slice(2, 6, text))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, tokens))))
n2 = len(tokens)
print(f"n2={n2} {{braces}} {len(text)}")
entries = [Entry("pin", 27, 34.76), Entry("gear", 27, 8.92), Entry("tap", 14, 9.61), Entry("bolt", 20, 39.53), Entry("hub", 20, 39.6)]
def renderRow(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(7, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 11 else "ok")
_pf_iter(print, _pf_map(renderRow, entries))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, entries))))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [21, 13, 24, 30, 8]))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(54361))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(7, 5, 1))
