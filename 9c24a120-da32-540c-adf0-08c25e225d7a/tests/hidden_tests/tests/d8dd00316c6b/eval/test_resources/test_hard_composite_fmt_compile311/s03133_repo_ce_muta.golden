print("{} rows, {}={}".format(len(rows), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, rows))))
def decodeLine(line):
    def _pf_fn0():
        match _pf_str_split("=", line):
            case [_k, _v]:
                _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
            case _:
