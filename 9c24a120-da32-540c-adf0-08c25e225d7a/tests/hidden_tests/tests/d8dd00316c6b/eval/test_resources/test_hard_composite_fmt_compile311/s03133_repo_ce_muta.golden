_pf_t2
def sumAll(xs):
    def _pf_fn2(acc, r):
        def _pf_fn3():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
