def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(1214, 0))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(42905))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
