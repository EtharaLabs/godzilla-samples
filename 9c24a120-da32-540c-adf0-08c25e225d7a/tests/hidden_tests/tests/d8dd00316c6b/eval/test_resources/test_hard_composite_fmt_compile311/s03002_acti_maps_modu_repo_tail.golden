            _pf_t3 = n + 1
            m[w] = _pf_t3
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
