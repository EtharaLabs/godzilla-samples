from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [35, 21, -1, 24, 6, 5, 30]))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
nums = [7, 10, 8, 3, 7, 12, 11]
print(Geo_scaleAll(3, nums))
print(_pf_map(functools.partial(Geo_clamp, 0, 15), nums))
print(_pf_filter(functools.partial(Geo_between, 2, 11), nums))
rows = [Row("nut", 16, 9.05), Row("gear", 21, 29.26), Row("cog", 1, 22.44), Row("bolt", 7, 22.48), Row("hub", 28, 9.02)]
def renderRow(x):
    return "{}: {}: {}".format(_pf_fmt_pad_right(10, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price))
_pf_iter(print, _pf_map(renderRow, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [39, 22, 17]))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(99854))
laps = [260.9, 232.0, 483.1]
splits = [28.7, 49.1, 81.9]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = dist / dur
print(_pf_fmt_fixed(2, speed))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(laps, splits))
print(best)
speeds = _pf_map2(lambda d, t: d / t, laps, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
side = math.sqrt(16.0)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
