from dataclasses import dataclass
from functools import total_ordering
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_upper(s):
    return s.upper()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Jump = Jump()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Push = Push()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    _1: int
    def __repr__(self):
        return f"Store({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (3, self._0, self._1)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
def render(t):
    match t:
        case Mark(s0):
            return f"mark({s0})"
        case Jump():
            return f"jump"
        case Push():
            return f"push"
        case Store(3, _):
            return "store-3"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Push():
            return 3
        case _:
            return 3
prog = [Store(7, 1), Store(12, -1), _Push, Mark("ray"), _Jump, _Jump, Mark("fay")]
print(_pf_map(render, prog))
tally = _pf_sum_by(rank, prog)
print(f"tally={tally}")
print(_pf_sort(prog))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_square(x):
    return x * x
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [9, -1, -11, -5, 16, 23]
print(Calc_norm1(obs))
print(_pf_map(Calc_square, obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 18), obs))
print(Calc_mean(obs))
entries = [Line("pin", 18, 17.6), Line("hub", 29, 29.21), Line("nut", 2, 18.73), Line("cog", 5, 34.14)]
def fmtLine(x):
    return "{} {} {} {} {}".format(_pf_fmt_pad_right(10, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 9 else "ok", _pf_fmt_currency("$", 2, x.price * 4.0))
_pf_iter(print, _pf_map(fmtLine, entries))
print("{} rows, {}={}".format(len(entries), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, entries))))
def _pf_fn0():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
series = _pf_fn0()
print(list(filter(lambda n: n % 2 == 0, series)))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 411, fib)))
