from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    def __repr__(self):
        return "Turn"
_Turn = Turn()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [39, 30, 51, 18, 1, 22, 12, 19])
def sumT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumT(l) + v + sumT(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumT(root))
def depthOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, _, rt):
            return 1 + max(depthOf(l), depthOf(rt))
        case _:
            raise RuntimeError("non-exhaustive match")
print(depthOf(root))
def render(t):
    match t:
        case Mark(s0):
            return f"mark({s0})"
        case Turn():
            return f"turn"
        case Load(s0):
            return f"load({s0})"
        case Jump(n0) if n0 > 5:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Skip(n0) if n0 % 2 == 0:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Mark(_):
            return 4
        case Jump(x0):
            return x0
        case Skip(x0):
            return x0
        case Load(_):
            return 6
        case _:
            return 2
batch = [Skip(2), Load("dee"), Skip(3), Mark("quin"), Mark("bo")]
print(_pf_str_join("; ", _pf_map(render, batch)))
tally = _pf_sum_by(score, batch)
print(f"tally={tally}")
print(_pf_max_by(score, batch))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def bucketOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(bucketOf, [12, 3, 31, 15, 2, 16, 34]))
