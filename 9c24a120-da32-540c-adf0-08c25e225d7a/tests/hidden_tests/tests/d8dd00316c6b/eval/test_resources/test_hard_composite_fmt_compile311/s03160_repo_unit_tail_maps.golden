from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
lines = [Line("bolt", 10, 28.6), Line("rod", 6, 6.28), Line("cap", 8, 31.02), Line("gear", 24, 24.04), Line("nut", 9, 20.33)]
def showRow(x):
    return "{}|{}|{}|{}".format(_pf_fmt_pad_right(10, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 4 else "ok")
_pf_iter(print, _pf_map(showRow, lines))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, lines))))
segments = [103.4, 24.9, 144.0, 372.7, 149.6]
durations = [49.0, 39.7, 12.4, 42.4, 85.1]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace = dist / elapsed
print(_pf_fmt_fixed(3, pace))
speeds = _pf_map2(lambda d, t: d / t, segments, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
edge = math.sqrt(2.25)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
def euclid(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(412, 330))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(4, 5, 1))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(2062))
visits = ["cy", "ada", "cy", "dee", "dee", "eli", "bo"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in visits:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, counts))))
print(len(_pf_map_filter(lambda k, v: v > 1, counts)))
