from dataclasses import dataclass
from functools import total_ordering
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    def __repr__(self):
        return "Store"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Store = Store()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Jump = Jump()
lines = [Entry("cap", 13, 32.38), Entry("cog", 1, 34.57), Entry("pin", 21, 15.96), Entry("wick", 16, 0.23), Entry("nut", 2, 4.49)]
def showRow(x):
    return "{}|{}|{}".format(_pf_fmt_pad_right(10, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price))
_pf_iter(print, _pf_map(showRow, lines))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, lines))))
samples = [32, 38, 41, 19, -1, 38, 34, -2, 18]
def addK(k, x):
    return x + k
process = lambda _pf_x: _pf_map(lambda x: x // 3 + x % 3, (lambda _pf_x: _pf_collect(lambda x: [x, x + 1], (lambda _pf_x: (lambda _pf_x: _pf_map(sum, _pf_chunk(3, _pf_x)))(_pf_map(functools.partial(max, 3), _pf_x)))(_pf_x)))(_pf_x))
outcome = _pf_list_find(lambda x: x % 2 == 1, process(samples))
print(outcome)
print(len(samples))
def rawOf(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("sku", 2)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("u-1"))
def render(t):
    match t:
        case Emit(n0) if 0 <= n0 < 12:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Store() | Jump():
            return "store/jump"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Emit(x0):
            return x0 * 4
        case _:
            return 1
queue = [Emit(12), Emit(9), Emit(8), _Store, _Store, _Jump, Emit(4)]
_pf_iter(lambda t: print(render(t)), queue)
grandSum = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print(_pf_sort(queue))
