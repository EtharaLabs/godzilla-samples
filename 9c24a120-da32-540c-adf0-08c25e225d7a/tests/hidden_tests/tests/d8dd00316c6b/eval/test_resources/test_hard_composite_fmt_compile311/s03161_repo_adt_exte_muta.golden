from dataclasses import dataclass
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    _1: str
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
rows = [Row("cog", 11, 26.03), Row("tap", 11, 10.02), Row("cap", 24, 24.96), Row("nut", 3, 38.46), Row("bolt", 12, 13.25)]
def showRow(x):
    return "{}|{}|{}|{}|{}".format(_pf_fmt_pad_right(9, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 7 else "ok", _pf_fmt_currency("$", 2, x.price * 9.0))
_pf_iter(print, _pf_map(showRow, rows))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 15, rows))
print("low: {} ({})".format(_pf_str_join("", low), _pf_fmt_percent(1, 0.5 * 1.0)))
def describe(t):
    match t:
        case Jump(3):
            return "jump-3"
        case Jump(n0):
            return f"jump({n0})"
        case Skip(n0) if n0 > 1:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Emit(n0, s1) if n0 > 5:
            return f"emit!({n0},{s1})"
        case Emit(n0, s1):
            return f"emit({n0},{s1})"
        case Store(n0):
            return f"store({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Jump(x0):
            return x0 * 2
        case Emit(x0, _):
            return x0
        case Store(x0):
            return x0
        case _:
            return 1
stream = [Skip(1), Emit(4, "fay"), Jump(6), Store(11), Skip(9), Jump(5)]
_pf_iter(lambda t: print(describe(t)), stream)
total = _pf_sum_by(rank, stream)
print(f"total={total}")
print(_pf_max_by(rank, stream))
print(_pf_str_rev(str.upper("oz")))
print(_pf_map(math.isqrt, [194, 201, 119, 113]))
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 3
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([23, 3, 0, 6, -7]))
doubled = _pf_map(note, [23, 3, 0, 6])
print(f"{doubled} after {calls} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), calls))
