from dataclasses import dataclass
from functools import total_ordering
import functools
import math
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def explain(t):
    match t:
        case Skip(n0) if n0 > 3:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Pop(x0):
            return x0 * 2
        case _:
            return 3
prog = [Pop(8), Skip(10), Rest(10), Skip(11), Pop(1)]
_pf_iter(lambda t: print(explain(t)), prog)
tally = _pf_sum_by(score, prog)
print(f"tally={tally}")
print(_pf_sort(prog))
lines = [Entry("tap", 10, 11.98), Entry("rod", 18, 5.2), Entry("cog", 23, 39.39), Entry("wick", 22, 22.74), Entry("bolt", 12, 9.51)]
def showRow(x):
    return "{}|{}|{}".format(_pf_fmt_pad_right(6, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price))
_pf_iter(print, _pf_map(showRow, lines))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, lines))))
book = [Parcel(100, "lu", 32, False, Place("Lima", 2)), Parcel(101, "lu", 66, True, Place("Oslo", 1)), Parcel(102, "kit", 247, False, Place("Rome", 1)), Parcel(103, "lu", 68, True, Place("Doha", 4)), Parcel(104, "lu", 158, True, Place("Riga", 1))]
print(_pf_map(lambda o: o.id, _pf_take(2, _pf_sort_by_desc(lambda o: o.amount, book))))
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, book))
print(byOwner)
def bucket(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 178:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 178:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, book))
print(_pf_count_by(bucket, book))
def _pf_fn1(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Parcel(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Place("Hub", 1))
    else:
        return o
moved = _pf_map(_pf_fn1, book)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", moved))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [7, 4, 7, 11]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(3))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
