rows = [Stock("pin", 25, 23.14), Stock("nut", 24, 26.53), Stock("hub", 24, 30.47), Stock("bolt", 19, 11.65)]
def showRow(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(6, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 4 else "ok")
