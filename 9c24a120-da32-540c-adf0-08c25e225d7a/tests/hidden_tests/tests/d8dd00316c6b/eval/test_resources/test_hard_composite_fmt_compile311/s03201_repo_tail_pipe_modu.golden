from dataclasses import dataclass
import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
entries = [Line("pin", 23, 34.66), Line("gear", 17, 10.7), Line("wick", 30, 5.05), Line("bolt", 8, 2.68)]
def renderRow(x):
    return "{}: {}: {}: {}".format(_pf_fmt_pad_right(7, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 4 else "ok")
_pf_iter(print, _pf_map(renderRow, entries))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, entries))))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(6, 8, 1))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [56, 34, 4]))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [29, 24, 30, 2, 25]))
data = [0, 20, 35, 10, 40, 27, 11, 18, -2]
def addK(k, x):
    return x + k
pipeline = lambda _pf_x: _pf_take(4, (lambda _pf_x: _pf_map(lambda x: (-x if x < 0 else x * 2), _pf_map(functools.partial(max, 2), _pf_x)))(_pf_x))
outcome = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(pipeline(data))
print(outcome)
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
obs = [6, 6, -12, 16, 15, -2]
print(Calc_scaleAll(4, obs))
print(Calc_norm1(obs))
print(_pf_filter(functools.partial(Calc_between, 4, 25), obs))
