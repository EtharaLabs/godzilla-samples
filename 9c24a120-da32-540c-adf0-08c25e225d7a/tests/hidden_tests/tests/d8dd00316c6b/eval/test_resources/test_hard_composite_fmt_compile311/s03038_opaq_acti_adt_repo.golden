@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
def rawOf(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("sku", 2)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("u-1"))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 15:
        return Some(n - 15)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [20, 35, 6, 25, 10, 35, -6]))
def describe(t):
    match t:
        case Emit(n0):
            return f"emit({n0})"
        case Push(n0) if n0 % 2 == 0:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Load(s0, n1):
            return f"load({s0},{n1})"
        case Rest(n0, s1):
            return f"rest({n0},{s1})"
        case Store(n0) if 0 <= n0 < 14:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Load(_, x1):
            return x1
        case Push(x0):
            return x0 * 3
        case Store(x0):
            return x0 * 4
        case Emit(x0):
            return x0
        case _:
            return 3
prog = [Emit(-2), Load("kit", 2), Load("fay", 6), Rest(2, "fay")]
print(_pf_str_join("; ", _pf_map(describe, prog)))
total = _pf_sum_by(score, prog)
print(f"total={total}")
print(_pf_sort(prog))
rows = [Stock("cog", 2, 26.17), Stock("gear", 17, 34.47), Stock("nut", 10, 35.26), Stock("hub", 13, 17.02), Stock("tap", 18, 16.51)]
def renderRow(x):
    return "{}|{}|{}|{}|{}".format(_pf_fmt_pad_right(10, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 6 else "ok", _pf_fmt_currency("$", 2, x.price * 9.0))
_pf_iter(print, _pf_map(renderRow, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
