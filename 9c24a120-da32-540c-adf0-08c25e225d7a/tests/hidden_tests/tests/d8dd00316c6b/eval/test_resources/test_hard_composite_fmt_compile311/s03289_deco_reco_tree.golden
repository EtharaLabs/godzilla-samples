def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
