def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
