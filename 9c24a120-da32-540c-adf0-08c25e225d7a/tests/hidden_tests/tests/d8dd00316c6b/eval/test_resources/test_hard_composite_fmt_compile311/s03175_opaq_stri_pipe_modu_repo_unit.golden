from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_reduce(f, xs):
    return Some(functools.reduce(f, xs)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("sku", 3)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
text = "gear,rod,eli,cog"
words = _pf_str_split(",", text)
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
print(_pf_str_slice(0, 8, text))
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", "40,x,40,x,12"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
data = [50, 38, 8, 15, 9, 13, 15, 26]
def shift(k, x):
    return x + k
def keep(n):
    return n > 15 and n % 5 != 0
answer = _pf_reduce(lambda a, b: a + b, _pf_map(lambda b: 2 * b, _pf_sort(_pf_drop(3, _pf_sort_by(lambda x: -x, _pf_map(lambda x: x * x - 3, _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), data)))))))
print(answer)
print(len(data))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_square(x):
    return x * x
nums2 = [-10, 11, 0, -13, 26, 21]
print(_pf_map(functools.partial(Geo_clamp, 0, 7), nums2))
print(_pf_filter(functools.partial(Geo_between, -4, 20), nums2))
print(_pf_map(Geo_square, nums2))
entries = [Row("rod", 3, 7.35), Row("tap", 9, 21.39), Row("pin", 26, 36.22)]
def renderRow(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(10, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 4 else "ok")
_pf_iter(print, _pf_map(renderRow, entries))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, entries))))
laps = [361.9, 234.4, 325.5, 468.6]
splits = [79.9, 28.8, 65.9, 38.9]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = total / elapsed
print(_pf_fmt_fixed(3, speed))
speeds = _pf_map2(lambda d, t: d / t, laps, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
edge = math.sqrt(6.25)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
