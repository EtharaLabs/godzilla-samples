from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("u", 2)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [7, 5, -8, -10, -2]
print(Text_mean(pts))
print(Text_scaleAll(3, pts))
print(_pf_map(Text_square, pts))
print(Text_norm1(pts))
entries = [Line("cap", 4, 38.97), Line("cog", 18, 36.57), Line("hub", 0, 2.1), Line("bolt", 25, 9.0)]
def showRow(x):
    return "{}: {}: {}: {}".format(_pf_fmt_pad_right(6, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), _pf_fmt_currency("$", 2, x.price * 9.0))
_pf_iter(print, _pf_map(showRow, entries))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 8, entries))
print("low: {} ({})".format(_pf_str_join("", low), _pf_fmt_percent(1, 0.5 * 1.0)))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def kindOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(kindOf, [18, 17, 5, 15, -5, 26, 2]))
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([45, 19, 25, 57, -5, -18]))
doubled = _pf_map(record, [45, 19, 25, 57])
print(f"{doubled} after {hits} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), hits))
