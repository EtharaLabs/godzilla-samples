from dataclasses import dataclass
import functools
import itertools
import math
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
def _pf_fn0():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
squares = _pf_fn0()
print(list(_pf_seq_take(2, map(lambda n: n + 1, squares))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def steps(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: steps(n, 0), [36, 32, 19]))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(2996, 0))
segments = [419.8, 432.1, 176.6, 280.1, 199.4]
durations = [18.3, 23.1, 47.2, 85.3, 24.1]
total = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed = total / elapsed
print(_pf_fmt_fixed(3, speed))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, elapsed) * 1000.0))
mass = 30.0
accel = 5.5
push = mass * accel
limit = 161.0
print("over" if push > limit else "under")
speeds = _pf_map2(lambda d, t: d / t, segments, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
edge = math.sqrt(2.25)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [-13, 13, 19, 17, -4, 5, -6]
print(Geo_norm1(obs))
print(_pf_map(functools.partial(Geo_clamp, 0, 11), obs))
print(Geo_scaleAll(4, obs))
print(Geo_mean(obs))
rows = [Row("nut", 29, 32.84), Row("hub", 27, 4.34), Row("rod", 9, 26.89)]
def fmtLine(x):
    return "{}|{}|{}".format(_pf_fmt_pad_right(9, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price))
_pf_iter(print, _pf_map(fmtLine, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
