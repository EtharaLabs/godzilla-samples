from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
entries = [Line("bolt", 26, 23.47), Line("tap", 1, 10.7), Line("pin", 10, 26.47)]
def showRow(x):
    return "{}|{}|{}|{}".format(_pf_fmt_pad_right(7, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), _pf_fmt_currency("$", 2, x.price * 6.0))
_pf_iter(print, _pf_map(showRow, entries))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, entries))))
visits = ["ada", "cy", "bo", "cy", "fay", "cy", "fay", "ada", "ada", "bo"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in visits:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, counts))))
print(len(_pf_map_filter(lambda k, v: v > 1, counts)))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(counts))))
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts = [-2, 14, -4, -3, -8]
print(_pf_filter(functools.partial(Text_between, -4, 13), pts))
print(Text_scaleAll(4, pts))
print(Text_norm1(pts))
print(Text_mean(pts))
def _pf_fn1():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
    yield 106
squares = _pf_fn1()
print(_pf_fold(lambda a, b: a + b, 0, squares))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 993, fib)))
