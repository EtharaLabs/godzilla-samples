def show(t):
    match t:
        case Drop(s0):
            return f"drop({s0})"
        case Turn(n0) if n0 > 3:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Halt():
            return f"halt"
        case Jump(n0, n1):
            return f"jump({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
