def render(t):
    match t:
        case Halt(s0):
            return f"halt({s0})"
        case Jump(n0):
            return f"jump({n0})"
        case Rest(n0) if n0 > 1:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
