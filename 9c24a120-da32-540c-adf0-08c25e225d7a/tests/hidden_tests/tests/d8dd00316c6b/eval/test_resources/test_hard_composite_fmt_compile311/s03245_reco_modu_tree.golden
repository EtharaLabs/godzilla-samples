from dataclasses import dataclass
import functools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
book = [Order(100, "sue", 256, False), Order(101, "sue", 185, False), Order(102, "sue", 263, False), Order(103, "sue", 250, False), Order(104, "hal", 86, False)]
def classify(o):
    match o:
        case Order(urgent=True, amount=amount) if amount > 142:
            return "rush-big"
        case Order(urgent=True):
            return "rush"
        case Order(amount=amount):
            if amount > 142:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, book))
print(_pf_count_by(classify, book))
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
nrec, sumAmt = _pf_fold(_pf_fn0, (0, 0), book)
print(f"{nrec} records, {sumAmt} total")
def tag(_pf_arg0):
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, book)))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_square(x):
    return x * x
pts = [19, 10, 24, -1, 14, 24]
print(Geo_mean(pts))
print(Geo_norm1(pts))
print(Geo_scaleAll(3, pts))
print(_pf_map(Geo_square, pts))
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
def shrink(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(shrink(a), shrink(b))
            case Mul(a, b):
                return Mul(shrink(a), shrink(b))
            case _:
                return e
exprs = [Add(Add(Num(1), Num(-2)), Add(Num(1), Mul(Num(9), Num(0)))), Mul(Neg(Neg(Num(5))), Add(Mul(Num(9), Num(-1)), Neg(Num(2))))]
_pf_iter(print, _pf_map(render, _pf_map(shrink, exprs)))
print(_pf_map(evalE, exprs))
