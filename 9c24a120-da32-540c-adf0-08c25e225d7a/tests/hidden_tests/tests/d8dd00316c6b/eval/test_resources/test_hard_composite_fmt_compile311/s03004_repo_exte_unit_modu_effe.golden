from dataclasses import dataclass
import functools
import math
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
rows = [Entry("hub", 17, 15.22), Entry("cap", 19, 14.43), Entry("pin", 28, 32.64)]
def fmtLine(x):
    return "{}|{}|{}".format(_pf_fmt_pad_right(6, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price))
_pf_iter(print, _pf_map(fmtLine, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [4, 12, 4, 5]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1000101") + int("107", base=8))
print(_pf_str_rev(str.upper("quin")))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
legs = [211.4, 143.0, 324.7, 370.9]
splits = [33.1, 12.7, 68.3, 84.9]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = dist / elapsed
print(_pf_fmt_fixed(3, rate))
edge = math.sqrt(36.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
mass = 78.0
accel = 4.5
push = mass * accel
limit = 146.0
print("over" if push > limit else "under")
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
pts = [20, -11, 10, 14, 22, -11]
print(Geo_scaleAll(4, pts))
print(_pf_filter(functools.partial(Geo_between, -4, 18), pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 13), pts))
def margin(price, qty):
    return price * qty - 3 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("gear", 32, 6), ("tap", 42, 4)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(5)([1, 2, 3]))
