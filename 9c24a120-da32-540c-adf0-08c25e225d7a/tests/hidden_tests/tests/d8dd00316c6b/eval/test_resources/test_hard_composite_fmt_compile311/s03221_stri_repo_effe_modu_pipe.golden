from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
raw = "pin pam cog wick fay"
parts = _pf_str_split(" ", raw)
count = len(parts)
print(f"count={count} {{braces}} {len(raw)}")
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", "x,12,x,40,-3"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
print(_pf_str_slice(1, 6, raw))
lines = [Line("pin", 20, 1.19), Line("cap", 14, 25.68), Line("gear", 14, 11.67)]
def fmtLine(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(8, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 9 else "ok")
_pf_iter(print, _pf_map(fmtLine, lines))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, lines))))
def discount(price, qty):
    return price * qty - 2 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("wick", 49, 2), ("hub", 12, 3)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(discount, k))
print(scaled(17)([1, 2, 3]))
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums2 = [-8, -5, 11, 11, -14, 4, 15]
print(_pf_map(Text_square, nums2))
print(Text_norm1(nums2))
print(_pf_map(functools.partial(Text_clamp, 0, 14), nums2))
print(Text_scaleAll(2, nums2))
readings = [16, -1, 35, 41, 5, 24, 44]
def _pf_fn2(_pf_x):
    def _pf_fn3(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn3, _pf_indexed(_pf_x))
answer = _pf_fold(lambda acc, x: acc * 2 - x, 0, (lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(_pf_drop(1, _pf_map(functools.partial(max, 3), _pf_fn2(readings)))))
print(answer)
print(len(readings))
