from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 27:
        return Some(n - 27)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def classify(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(classify, [-4, 27, 10, 29, -6, 34]))
def rawOf(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("u", 4)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("u-1"))
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(lambda acc, x: add(x, acc), _Leaf, [2, 28, 39, 50, 33, 31, 22, 46])
def depthT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, _, rt):
            return 1 + max(depthT(l), depthT(rt))
        case _:
            raise RuntimeError("non-exhaustive match")
print(depthT(root))
def sumT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumT(l) + v + sumT(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumT(root))
lines = [Entry("rod", 29, 21.78), Entry("tap", 27, 37.85), Entry("gear", 9, 39.97), Entry("hub", 5, 35.92)]
def renderRow(x):
    return "{}: {}: {}".format(_pf_fmt_pad_right(8, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price))
_pf_iter(print, _pf_map(renderRow, lines))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 9, lines))
print("low: {} ({})".format(_pf_str_join("", low), _pf_fmt_percent(1, 0.5 * 1.0)))
