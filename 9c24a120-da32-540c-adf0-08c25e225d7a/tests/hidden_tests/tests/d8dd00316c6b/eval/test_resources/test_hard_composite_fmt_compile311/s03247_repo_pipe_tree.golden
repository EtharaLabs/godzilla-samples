from dataclasses import dataclass
import functools
import itertools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_upper(s):
    return s.upper()
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
lines = [Entry("wick", 24, 39.24), Entry("hub", 6, 18.52), Entry("tap", 1, 26.98), Entry("pin", 23, 37.13), Entry("bolt", 2, 33.9)]
def fmtLine(x):
    return "{}: {}: {}".format(_pf_fmt_pad_right(8, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price))
_pf_iter(print, _pf_map(fmtLine, lines))
print("{} rows, {}={}".format(len(lines), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, lines))))
readings = [-8, 7, 34, 46, -7, 45, 12, -9, 22, 23]
def addK(k, x):
    return x + k
def keep(n):
    return n > 19 and n % 4 != 0
outcome = len(_pf_map(functools.partial(addK, 2), _pf_take_while(lambda x: x < 39, _pf_distinct_by(lambda x: x % 2, _pf_filter(keep, readings)))))
print(outcome)
print(len(readings))
def insert(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(insert(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, insert(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [31, 54, 23, 7, 22, 44])
def toListOf(t):
    match t:
        case Leaf():
            return []
        case Node(l, v, rt):
            return _pf_concat(toListOf(l), _pf_concat([v], toListOf(rt)))
        case _:
            raise RuntimeError("non-exhaustive match")
print(toListOf(root))
def sumOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumOf(l) + v + sumOf(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumOf(root))
def containsT(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsT(k, root), [31, 45, 48]))
