from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
def _pf_fn0():
    for x in _pf_range(1, 12):
        y = x * x
        yield y
evens = _pf_fn0()
print(list(_pf_seq_take(4, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 5)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1574, fib)))
samples = [32, 26, 45, 4, -6, -10]
def addK(k, x):
    return x + k
outcome = _pf_head(_pf_rev(_pf_take(4, _pf_distinct_by(lambda x: x % 4, _pf_sort_desc(_pf_filter(lambda x: x % 4 == 2, samples))))))
print(outcome)
entries = [Row("tap", 24, 37.95), Row("pin", 26, 12.9), Row("bolt", 26, 20.13), Row("wick", 25, 1.69), Row("rod", 15, 13.93)]
def showRow(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(8, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 10 else "ok")
_pf_iter(print, _pf_map(showRow, entries))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, entries))))
raw = "cy,hub,bolt,oz"
words = _pf_str_split(",", raw)
count = len(words)
print(f"count={count} {{braces}} {len(raw)}")
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, words))))
print(_pf_str_replace("e", "E", raw))
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", "12,,,40,40"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
laps = [190.8, 84.0, 23.6]
durations = [34.5, 58.2, 44.4]
dist = _pf_fold(lambda a, b: a + b, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
rate = dist / elapsed
print(_pf_fmt_fixed(1, rate))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
speeds = _pf_map2(lambda d, t: d / t, laps, durations)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn2(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn2, _pf_zip(laps, durations))
print(best)
