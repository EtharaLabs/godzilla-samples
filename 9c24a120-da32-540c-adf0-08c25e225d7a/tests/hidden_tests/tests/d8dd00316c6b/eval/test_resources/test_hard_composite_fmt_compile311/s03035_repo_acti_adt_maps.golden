def explain(t):
    match t:
        case Load(n0):
            return f"load({n0})"
        case Pop(0):
            return "pop-0"
        case Pop(n0):
            return f"pop({n0})"
        case Emit(n0, n1) if 0 <= n0 < 13:
            return f"emit!({n0},{n1})"
        case Emit(n0, n1):
            return f"emit({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Emit(x0, x1):
            return x0 + x1
        case Load(x0):
            return x0
        case _:
            return 1
