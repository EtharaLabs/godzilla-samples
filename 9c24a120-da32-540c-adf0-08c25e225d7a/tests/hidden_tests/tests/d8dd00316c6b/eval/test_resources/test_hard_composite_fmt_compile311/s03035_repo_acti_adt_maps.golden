def _ap_Above(n):
    if n > 6:
        return Some(n - 6)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
