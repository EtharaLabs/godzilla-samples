from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_set_union(a, b):
    return a.union(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
segments = [350.1, 306.6, 403.8, 307.3]
splits = [80.6, 18.5, 46.3, 15.6]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = total / elapsed
print(_pf_fmt_fixed(3, speed))
edge = math.sqrt(4.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
mass = 82.0
accel = 7.5
push = mass * accel
limit = 292.0
print("over" if push > limit else "under")
rows = [Row("hub", 7, 28.28), Row("rod", 30, 5.94), Row("tap", 19, 22.8), Row("gear", 7, 25.55)]
def renderRow(x):
    return "{}: {}: {}".format(_pf_fmt_pad_right(8, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price))
_pf_iter(print, _pf_map(renderRow, rows))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 6, rows))
print("low: {} ({})".format(_pf_str_join("", low), _pf_fmt_percent(1, 0.5 * 1.0)))
events = ["eli", "cy", "eli", "bo", "fay", "bo"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in events:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
hist = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
