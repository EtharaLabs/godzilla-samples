entries = [Entry("cog", 5, 9.47), Entry("pin", 28, 33.43), Entry("gear", 19, 30.69), Entry("nut", 16, 9.48)]
def renderRow(x):
    return "{}: {}: {}: {}: {}".format(_pf_fmt_pad_right(10, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 6 else "ok", _pf_fmt_currency("$", 2, x.price * 3.0))
