from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_fmt_percent(n, x):
    return format(x, f".{n}%")
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(30814))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(1264, 0))
samples = [10, 39, 15, 15, 24, -10]
def offset(k, x):
    return x + k
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn2, _pf_indexed(_pf_x))
outcome = _pf_max((lambda _pf_x: _pf_map(sum, _pf_chunk(2, _pf_x)))(_pf_fn1(_pf_map(functools.partial(offset, 4), _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), samples)))))
print(outcome)
print(_pf_map(math.isqrt, [292, 8, 336, 79]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(3))
lines = [Stock("hub", 1, 11.33), Stock("wick", 23, 1.38), Stock("pin", 4, 36.74)]
def showRow(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(9, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 10 else "ok")
_pf_iter(print, _pf_map(showRow, lines))
low = _pf_map(lambda x: f"<{x.name}>", _pf_filter(lambda x: x.qty < 9, lines))
print("low: {} ({})".format(_pf_str_join("", low), _pf_fmt_percent(1, 0.5 * 1.0)))
