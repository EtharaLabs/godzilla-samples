print((recordTwice(3), ticks))
playerDecoder = _pf_dec_map3(lambda n, p, a: Reading(n, p, a), _pf_dec_field("name", _pf_dec_string), _pf_dec_field("points", _pf_dec_int), _pf_dec_field("active", _pf_dec_bool))
