def Geo_square(x):
    return x * x
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums = [10, 4, 29, 1, 2, -12, -5]
