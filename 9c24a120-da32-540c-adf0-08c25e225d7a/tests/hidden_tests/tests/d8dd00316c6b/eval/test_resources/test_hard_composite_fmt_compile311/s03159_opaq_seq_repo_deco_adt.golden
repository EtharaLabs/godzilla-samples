def show(t):
    match t:
        case Jump(s0):
            return f"jump({s0})"
        case Mark(s0, n1):
            return f"mark({s0},{n1})"
        case Pop(n0):
            return f"pop({n0})"
        case Turn(n0) if 0 <= n0 < 17:
