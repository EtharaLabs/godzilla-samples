def explain(t):
    match t:
        case Turn(s0):
            return f"turn({s0})"
        case Store(s0):
            return f"store({s0})"
        case Skip(n0, n1) if n0 > 0:
            return f"skip!({n0},{n1})"
        case Skip(n0, n1):
            return f"skip({n0},{n1})"
        case Rest():
            return f"rest"
        case _:
            raise RuntimeError("non-exhaustive match")
