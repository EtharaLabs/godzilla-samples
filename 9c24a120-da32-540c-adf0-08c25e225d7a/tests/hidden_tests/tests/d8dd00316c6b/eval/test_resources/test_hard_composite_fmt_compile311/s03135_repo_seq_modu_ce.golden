from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
lines = [Stock("pin", 6, 23.25), Stock("nut", 30, 25.49), Stock("cog", 5, 32.78)]
def showRow(x):
    return "{}|{}|{}|{}|{}".format(_pf_fmt_pad_right(10, ".", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 5 else "ok", _pf_fmt_currency("$", 2, x.price * 4.0))
_pf_iter(print, _pf_map(showRow, lines))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, lines))))
def _pf_fn0():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
series = _pf_fn0()
print(list(_pf_seq_take(2, map(lambda n: n + 1, series))))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_between(lo, hi, x):
    return lo <= x <= hi
pts = [1, -14, 3, 17, -7, 21, 22]
print(Text_norm1(pts))
print(Text_scaleAll(5, pts))
print(_pf_filter(functools.partial(Text_between, -4, 25), pts))
def readPair(line):
    def _pf_fn1():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t1, Some):
            v = _pf_t1._0
            _pf_t0 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some(n * 5)
            else:
                return _pf_t0
        else:
            return _pf_t1
    return _pf_fn1()
entries = ["bo=5=1", "lu = 4", "tom=x", "oz = 5"]
results = _pf_map(readPair, entries)
_pf_iter(print, results)
print(sum(_pf_map(functools.partial(_pf_option_with_default, 0), results)))
print(len(_pf_filter(_pf_option_is_some, _pf_map(functools.partial(_pf_option_map, lambda n: n + 1), results))))
