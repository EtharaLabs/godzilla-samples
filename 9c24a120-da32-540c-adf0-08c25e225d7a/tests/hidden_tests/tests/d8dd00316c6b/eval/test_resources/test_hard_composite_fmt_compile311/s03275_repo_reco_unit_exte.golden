from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
entries = [Row("tap", 17, 37.5), Row("cap", 14, 3.86), Row("gear", 6, 17.43)]
def showRow(x):
    return "{} {} {}".format(_pf_fmt_pad_right(7, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price))
_pf_iter(print, _pf_map(showRow, entries))
print("{} rows, {}={}".format(len(entries), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, entries))))
parcels = [Booking(100, "jo", 201, True, Place("Baku", 3)), Booking(101, "cy", 50, False, Place("Riga", 4)), Booking(102, "jo", 22, True, Place("Bern", 2)), Booking(103, "cy", 268, True, Place("Baku", 4)), Booking(104, "cy", 214, False, Place("Kyiv", 2))]
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, parcels))
print(urgentTotal)
def _pf_fn0(o):
    if o.dest.zone > 2:
        _pf_t2 = o
        return Booking(_pf_t2.id, _pf_t2.owner, _pf_t2.amount, _pf_t2.urgent, Place("Hub", 1))
    else:
        return o
rerouted = _pf_map(_pf_fn0, parcels)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
def line(o):
    id = o.id
    amount = o.amount
    return "#{}:{}".format(id, _pf_fmt_pad_left(5, " ", str(amount)))
print(_pf_str_join(", ", _pf_map(line, parcels)))
def adjust(pct, o):
    extra = o.amount * pct // 100
    _pf_t4 = o
    return Booking(_pf_t4.id, _pf_t4.owner, o.amount + extra, False, _pf_t4.dest)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 9), parcels)))
legs = [21.7, 73.8, 112.5, 363.2, 170.0]
times = [83.2, 71.6, 21.5, 23.8, 16.9]
total = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = total / dur
print(_pf_fmt_fixed(2, pace))
speeds = _pf_map2(lambda d, t: d / t, legs, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn1, _pf_zip(legs, times))
print(best)
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(7))
print(_pf_map(math.isqrt, [297, 135, 395, 171]))
