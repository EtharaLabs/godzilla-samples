def render(t):
    match t:
        case Push(s0):
            return f"push({s0})"
        case Halt(s0):
            return f"halt({s0})"
        case Turn():
            return f"turn"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Push(_):
            return 5
        case _:
            return 2
prog = [Push("ada"), _Turn, Push("bo"), Halt("cy"), Halt("eli")]
