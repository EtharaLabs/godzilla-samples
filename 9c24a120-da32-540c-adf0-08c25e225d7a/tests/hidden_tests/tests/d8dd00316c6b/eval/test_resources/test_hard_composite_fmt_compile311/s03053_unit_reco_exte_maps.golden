from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
segments = [434.0, 310.4, 414.6]
times = [70.0, 18.3, 14.9]
dist = _pf_fold(lambda a, b: a + b, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = dist / dur
print(_pf_fmt_fixed(3, pace))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(segments, times))
print(best)
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
parcels = [Order(100, "ray", 21, False), Order(101, "ray", 75, False), Order(102, "dee", 254, False), Order(103, "ray", 157, True)]
print(_pf_max_by(lambda o: o.amount, parcels))
cheap, dear = _pf_partition(lambda o: o.amount < 134, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def adjust(pct, o):
    extra = o.amount * pct // 100
    _pf_t0 = o
    return Order(_pf_t0.id, _pf_t0.owner, o.amount + extra, False)
print(_pf_map(lambda o: o.amount, _pf_map(functools.partial(adjust, 1), parcels)))
def classify(o):
    match o:
        case Order(urgent=True, amount=amount) if amount > 96:
            return "rush-big"
        case Order(urgent=True):
            return "rush"
        case Order(amount=amount):
            if amount > 96:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn1, (0, 0), parcels)
print(f"{cnt} records, {amt} total")
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [11, 3, 4, 6]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1001000") + int("133", base=8))
events = ["cy", "eli", "bo", "bo", "fay", "fay", "bo", "cy", "eli", "eli"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in events:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t1 = n + 1
            m[w] = _pf_t1
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
freq = m
def _pf_fn2(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn2, _pf_map_to_list(freq)))
extra = dict([("zed", 5), ("cy", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, freq))))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(freq))))
