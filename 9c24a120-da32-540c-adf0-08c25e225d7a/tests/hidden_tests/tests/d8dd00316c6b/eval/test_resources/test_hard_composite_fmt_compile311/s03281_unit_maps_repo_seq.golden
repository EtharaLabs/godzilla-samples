from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_values(m):
    return list(m.values())
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
legs = [65.7, 205.4, 467.3, 60.2, 72.1]
splits = [50.5, 6.8, 88.7, 27.1, 30.5]
total = _pf_fold(lambda a, b: a + b, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = total / dur
print(_pf_fmt_fixed(1, pace))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
side = math.sqrt(2.25)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
events = ["dee", "bo", "bo", "ada", "dee", "bo"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in events:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
hist = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(hist)))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(hist))))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, hist))))
print((_pf_map_try_find("dee", hist), "dee" in hist))
rows = [Stock("rod", 14, 28.18), Stock("nut", 2, 38.57), Stock("gear", 1, 24.48), Stock("pin", 12, 16.41)]
def fmtLine(x):
    return "{}|{}|{}".format(_pf_fmt_pad_right(7, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price))
_pf_iter(print, _pf_map(fmtLine, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
def _pf_fn1():
    for x in _pf_range(1, 7):
        y = x * x
        yield y
    yield 191
evens = _pf_fn1()
