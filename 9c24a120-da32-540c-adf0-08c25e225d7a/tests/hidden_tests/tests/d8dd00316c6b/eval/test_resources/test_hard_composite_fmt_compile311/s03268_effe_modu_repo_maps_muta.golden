from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_map_values(m):
    return list(m.values())
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Line:
    name: str
    qty: int
    price: float
def net(price, qty):
    return price * qty - 8 * qty
def report(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("cap", 11, 3), ("rod", 27, 3), ("pin", 32, 2)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(11)([1, 2, 3]))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_between(lo, hi, x):
    return lo <= x <= hi
nums = [6, 24, 7, -10]
print(Stats_mean(nums))
print(Stats_scaleAll(2, nums))
print(_pf_filter(functools.partial(Stats_between, 1, 23), nums))
rows = [Line("wick", 23, 18.17), Line("hub", 28, 5.78), Line("bolt", 30, 12.1), Line("cap", 14, 17.12)]
def showRow(x):
    return "{}: {}: {}: {}".format(_pf_fmt_pad_right(6, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 12 else "ok")
