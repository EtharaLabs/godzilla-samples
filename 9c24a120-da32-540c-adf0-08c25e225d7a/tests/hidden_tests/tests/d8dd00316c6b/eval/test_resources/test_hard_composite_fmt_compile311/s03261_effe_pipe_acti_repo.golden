from dataclasses import dataclass
import functools
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
def net(price, qty):
    return price * qty - 3 * qty
def emit(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("cap", 38, 3), ("nut", 15, 4), ("rod", 29, 6), ("tap", 35, 3)]))
print(grand)
data = [8, 47, 41, -3, -9, 42, 26]
def offset(k, x):
    return x + k
def isBig(n):
    return n > 2 and n % 3 != 0
pipeline = lambda _pf_x: _pf_filter(isBig, (lambda _pf_x: _pf_filter(lambda x: x % 5 == 4, (lambda _pf_x: _pf_take(3, _pf_distinct_by(lambda x: x % 4, _pf_x)))(_pf_x)))(_pf_x))
result = _pf_fold(lambda acc, x: acc * 2 - x, 0, pipeline(data))
print(result)
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def kindOf(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(kindOf, [5, 4, 39, -1, 33]))
entries = [Row("wick", 16, 13.76), Row("cap", 4, 12.47), Row("rod", 26, 21.87), Row("bolt", 19, 3.46), Row("nut", 11, 6.45)]
def fmtLine(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(10, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), _pf_fmt_currency("$", 2, x.price * 5.0))
_pf_iter(print, _pf_map(fmtLine, entries))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, entries))))
