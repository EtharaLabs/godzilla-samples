from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    _1: int
    def __repr__(self):
        return f"Load({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    _1: str
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    _1: int
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
rows = [Row("cap", 7, 19.15), Row("wick", 21, 29.29), Row("cog", 3, 1.44), Row("tap", 10, 2.3), Row("bolt", 11, 23.69)]
def showRow(x):
    return "{}: {}: {}: {}".format(_pf_fmt_pad_right(9, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), "restock" if x.qty > 4 else "ok")
_pf_iter(print, _pf_map(showRow, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [13, 59, 8]))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(38122))
def describe(t):
    match t:
        case Store(s0):
            return f"store({s0})"
        case Load(n0, n1):
            return f"load({n0},{n1})"
        case Emit(n0, s1) if n0 > 6:
            return f"emit!({n0},{s1})"
        case Emit(n0, s1):
            return f"emit({n0},{s1})"
        case Mark(1, _):
            return "mark-1"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Load(x0, x1):
            return x0 + x1 * 4
        case Emit(x0, _):
            return x0
        case Store(_):
            return 2
        case _:
            return 3
queue = [Store("fay"), Emit(0, "dee"), Load(3, -1), Store("tom"), Store("ray")]
print(_pf_str_join(" ", _pf_map(describe, queue)))
total = _pf_sum_by(score, queue)
print(f"total={total}")
print(_pf_max_by(score, queue))
