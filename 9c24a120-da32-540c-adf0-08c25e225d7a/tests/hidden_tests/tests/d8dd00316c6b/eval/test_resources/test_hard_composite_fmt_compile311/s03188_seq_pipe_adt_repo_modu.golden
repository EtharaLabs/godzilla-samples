from dataclasses import dataclass
from functools import total_ordering
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    def __repr__(self):
        return "Mark"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Mark = Mark()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    _1: int
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0, self._1)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    _1: int
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (3, self._0, self._1)
@dataclass(frozen=True, slots=True)
class Row:
    name: str
    qty: int
    price: float
def _pf_fn0():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
    yield 172
squares = _pf_fn0()
print(list(_pf_seq_take(3, map(lambda n: n + 1, squares))))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 5)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1320, fib)))
samples = [-3, -7, 10, -7, 16, 19, 20, 47, -1, -6, 14]
def isBig(n):
    return n > 14 and n % 3 != 0
def _pf_fn3(_pf_x):
    def _pf_fn4(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn4, _pf_indexed(_pf_x))
outcome = _pf_exists(lambda x: x > 9, _pf_choose(lambda x: (Some(x // 5) if x % 5 == 0 else _None_), _pf_map(functools.partial(max, 8), _pf_collect(lambda x: [x, x + 1], _pf_fn3(_pf_sort_by(lambda x: x % 3, _pf_rev(samples)))))))
print(outcome)
print(len(samples))
def render(t):
    match t:
        case Halt(n0):
            return f"halt({n0})"
        case Mark():
            return f"mark"
        case Emit(n0, n1):
            return f"emit({n0},{n1})"
        case Push(n0, n1) if 0 <= n0 < 15:
            return f"push!({n0},{n1})"
        case Push(n0, n1):
            return f"push({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Mark():
            return 7
        case Halt(x0):
            return x0 * 5
        case _:
            return 0
batch = [Push(4, 0), Halt(2), Push(2, 4), Push(-1, 3)]
print(_pf_str_join(" ", _pf_map(render, batch)))
grandSum = _pf_sum_by(score, batch)
print(f"grandSum={grandSum}")
print(_pf_sort(batch))
entries = [Row("tap", 23, 24.21), Row("cog", 19, 14.27), Row("gear", 0, 12.12), Row("hub", 5, 31.5), Row("wick", 16, 18.17)]
