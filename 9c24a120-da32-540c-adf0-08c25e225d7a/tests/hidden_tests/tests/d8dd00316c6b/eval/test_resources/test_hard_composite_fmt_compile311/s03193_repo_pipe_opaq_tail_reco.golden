from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Entry:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
entries = [Entry("cog", 6, 11.5), Entry("hub", 2, 37.9), Entry("tap", 9, 30.59), Entry("cap", 24, 31.68)]
def showRow(x):
    return "{}|{}|{}|{}".format(_pf_fmt_pad_right(8, "-", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), _pf_fmt_currency("$", 2, x.price * 2.0))
_pf_iter(print, _pf_map(showRow, entries))
print("{} rows, {}={}".format(len(entries), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, entries))))
data = [34, 39, -1, 33, -6, 9, 4, 47, 47, 50]
def shift(k, x):
    return x + k
def accept(n):
    return n > 1 and n % 3 != 0
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
def _pf_fn4(_pf_x):
    def _pf_fn5(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn5, _pf_indexed(_pf_x))
outcome = sum(_pf_fn1(_pf_map(lambda x: (-x if x < 0 else x * 5), _pf_fn4(_pf_filter(accept, _pf_sort(data))))))
