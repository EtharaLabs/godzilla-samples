print(len(data))
def rawOf(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("sku", 2)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("acc-1"))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(175, 0))
def ipow(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(ipow(4, 9, 1))
orders = [Invoice(100, "kit", 166, False), Invoice(101, "oz", 112, False), Invoice(102, "sue", 104, False), Invoice(103, "kit", 230, False), Invoice(104, "oz", 5, False), Invoice(105, "kit", 135, True)]
