readings = [0, 30, 41, 35, 44, 48, -4, 28, 15]
def shift(k, x):
    return x + k
pipeline = lambda _pf_x: (lambda _pf_x: _pf_map(sum, _pf_chunk(3, _pf_x)))((lambda _pf_x: _pf_drop(3, (lambda _pf_x: _pf_take_while(lambda x: x < 44, (lambda _pf_x: _pf_map(lambda b: 41 - b, (lambda _pf_x: (lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))(_pf_sort(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
answer = sum(pipeline(readings))
