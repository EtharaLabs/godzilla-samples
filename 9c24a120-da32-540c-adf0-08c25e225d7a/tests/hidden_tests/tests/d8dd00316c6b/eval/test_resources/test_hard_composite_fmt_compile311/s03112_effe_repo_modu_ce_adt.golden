def show(t):
    match t:
        case Rest(n0) if n0 > 4:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Push():
            return f"push"
        case Jump() | Emit():
            return "jump/emit"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Push():
            return 7
        case Rest(x0):
            return x0
        case Jump():
            return 1
        case _:
            return 3
