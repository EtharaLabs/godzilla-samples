        return "Emit"
_Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
_Push = Push()
def net(price, qty):
    return price * qty - 7 * qty
def report(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
