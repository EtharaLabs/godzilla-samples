from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
_Rest = Rest()
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    def __repr__(self):
        return f"Store({self._0!r})"
rows = [Stock("pin", 0, 5.58), Stock("nut", 15, 39.48), Stock("wick", 4, 3.19)]
def showRow(x):
    return "{} {} {} {}".format(_pf_fmt_pad_right(8, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(2, x.price), _pf_fmt_currency("$", 2, x.price * 6.0))
_pf_iter(print, _pf_map(showRow, rows))
print("items: {}".format(_pf_str_join(", ", _pf_map(lambda x: x.name, rows))))
sentence = "eli;nut;quin;pam;cap;bolt;cog"
tokens = _pf_str_split(";", sentence)
print(_pf_map(lambda w: (w, len(w)), tokens))
print(_pf_str_replace("i", "I", sentence))
print((_pf_str_index_of("pa", sentence), "pa" in sentence))
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), tokens))
print(_pf_option_with_default("?", longest))
def explain(t):
    match t:
        case Push(s0):
            return f"push({s0})"
        case Turn(n0) if n0 % 2 == 0:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Load(n0) if n0 > 0:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Rest():
            return f"rest"
        case Store(s0):
            return f"store({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Push(_):
            return 7
        case Store(_):
            return 9
        case _:
            return 1
batch = [_Rest, _Rest, Load(-2), Push("oz"), _Rest, Push("hal")]
_pf_iter(lambda t: print(explain(t)), batch)
total = _pf_sum_by(weight, batch)
print(f"total={total}")
print(len(_pf_filter(lambda t: weight(t) > 2, batch)))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_square(x):
    return x * x
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
nums = [14, -14, -12, 23, 17, -3]
print(_pf_map(functools.partial(Geo_clamp, 0, 12), nums))
print(_pf_map(Geo_square, nums))
print(Geo_scaleAll(4, nums))
print(_pf_filter(functools.partial(Geo_between, -3, 11), nums))
