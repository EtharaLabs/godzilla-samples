def describe(t):
    match t:
        case Emit(s0):
            return f"emit({s0})"
        case Turn():
            return f"turn"
        case Pop(n0) if 0 <= n0 < 8:
            return f"pop!({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Store(1):
            return "store-1"
        case Store(n0):
            return f"store({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Pop(x0):
            return x0 * 5
        case _:
            return 3
prog = [Pop(-1), Pop(8), _Turn, Pop(8), Pop(8), Pop(3)]
print(_pf_str_join("; ", _pf_map(describe, prog)))
tally = _pf_sum_by(rank, prog)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: rank(t) > 2, prog)))
