    for x in _pf_range(1, 6):
        y = x * x
        yield y
squares = _pf_fn0()
print(list(_pf_seq_take(2, map(lambda n: n + 1, squares))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 6)))))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [8, -6, -7, -14, 15, 21, -15]
