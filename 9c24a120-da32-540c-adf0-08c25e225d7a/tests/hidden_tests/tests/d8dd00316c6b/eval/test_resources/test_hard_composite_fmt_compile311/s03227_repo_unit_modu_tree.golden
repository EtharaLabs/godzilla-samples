from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_fmt_currency(sym, n, x):
    return sym + format(x, f",.{n}f")
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Stock:
    name: str
    qty: int
    price: float
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
entries = [Stock("nut", 22, 8.21), Stock("pin", 9, 26.14), Stock("tap", 7, 16.53), Stock("rod", 0, 28.72), Stock("gear", 22, 19.65)]
def renderRow(x):
    return "{}: {}: {}: {}: {}".format(_pf_fmt_pad_right(6, " ", x.name), _pf_fmt_pad_left(4, " ", str(x.qty)), _pf_fmt_fixed(1, x.price), "restock" if x.qty > 4 else "ok", _pf_fmt_currency("$", 2, x.price * 4.0))
_pf_iter(print, _pf_map(renderRow, entries))
print("{} rows, {}={}".format(len(entries), _pf_str_upper("total"), _pf_fmt_fixed(2, _pf_fold(lambda a, x: a + x.price, 0.0, entries))))
legs = [314.8, 280.3, 499.6]
splits = [54.9, 75.8, 62.6]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = dist / elapsed
print(_pf_fmt_fixed(2, pace))
speeds = _pf_map2(lambda d, t: d / t, legs, splits)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
mass = 19.0
accel = 3.5
push = mass * accel
limit = 165.0
print("over" if push > limit else "under")
def Stats_square(x):
    return x * x
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs = [1, -5, 4, 16, 24]
print(_pf_map(Stats_square, obs))
print(Stats_scaleAll(2, obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 18), obs))
def insert(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(insert(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, insert(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(lambda acc, x: insert(x, acc), _Leaf, [37, 30, 39, 33, 48, 16])
def minOf(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minOf(root))
def toListOf(t):
    match t:
        case Leaf():
            return []
        case Node(l, v, rt):
            return _pf_concat(toListOf(l), _pf_concat([v], toListOf(rt)))
        case _:
            raise RuntimeError("non-exhaustive match")
print(toListOf(root))
def sumOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumOf(l) + v + sumOf(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumOf(root))
