from dataclasses import dataclass
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([14, 19, 8, 13, 19]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "kit", "stop"])
print((logged, counts))
adders = _pf_map(lambda k: lambda x: x * 10 + k, [3, 5, 9])
print(_pf_map(lambda g: g(5), adders))
def swapSum(pairs):
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn0(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn0, pairs))
print(swapSum([(7, 9), (1, 3)]))
def combine(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 2
    r = _pf_t0
    return pair(r, 9)
print((combine(Some(3)), combine(_None_)))
def done(acc):
    async def _pf_fn1():
        return acc
    return _pf_Async(_pf_fn1)
def spin(n, acc):
    async def _pf_fn3():
        async def _pf_fn2():
            return n * 2
        k = await _pf_fn2()
        if n <= 0:
            return await done(acc)
        else:
            return await spin(n - 1, acc + k)
    return _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(spin(28, 0))))
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_square(x):
    return x * x
