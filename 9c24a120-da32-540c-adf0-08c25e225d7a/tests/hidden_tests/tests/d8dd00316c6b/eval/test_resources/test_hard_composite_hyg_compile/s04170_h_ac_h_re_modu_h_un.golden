def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 1:
        return _Low()
    elif scaled < 33:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    match _pf_str_split("=", s):
        case [k, v]:
