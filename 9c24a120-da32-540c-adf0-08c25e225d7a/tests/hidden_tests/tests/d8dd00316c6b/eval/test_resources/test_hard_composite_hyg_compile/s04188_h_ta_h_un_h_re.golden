from dataclasses import dataclass
import asyncio
import math
import math as mth
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n, acc):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(2887, 0))))
def countDigits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await loop(8, 0)
    return countDigits(a * 68546, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
span = math.hypot(9.0 / 1.0, 6.0 / 1.0) * 1.0
ratio = math.sqrt(3.0)
side = math.sqrt(81.0)
vol = math.cbrt(64.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(span / 1.0))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 7.0)))
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Pilot(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 6:
            _pf_t1 = t
            return Idle(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [Active(Pilot("tom", 32)), Active(Pilot("ivy", 41)), Idle(Team("rod", 1)), Idle(Team("wick", 9)), Active(Pilot("hal", 50))])
print(roster)
people = [Pilot("jo", 2), Pilot("kit", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
