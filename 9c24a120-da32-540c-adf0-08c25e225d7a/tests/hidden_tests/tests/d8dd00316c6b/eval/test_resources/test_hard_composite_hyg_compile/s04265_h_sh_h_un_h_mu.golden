from dataclasses import dataclass
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def wrap(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([7, 0, 9]))
def scale(n):
    return n * 2
def _pf_fn0():
    _pf_t0 = [1, 2]
    if _pf_t0:
        scale = _pf_t0[0]
        return scale + 1
    else:
        return 0
chosen = _pf_fn0()
print((chosen, scale(6)))
def combine(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t1 = _pair
    else:
        _pf_t1 = 3
    r = _pf_t1
    return pair(r, 5)
print((combine(Some(3)), combine(_None_)))
reach = math.hypot(9.0 / 1.0, 5.0 / 1.0) * 1.0
ratio = math.sqrt(10.0)
side = math.sqrt(81.0)
vol = math.cbrt(27.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 4.0)))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(inspect([19, 14, 1, 12]))
logged = []
def push2(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(push2, ["start", "ray", "stop"])
print((logged, counts))
