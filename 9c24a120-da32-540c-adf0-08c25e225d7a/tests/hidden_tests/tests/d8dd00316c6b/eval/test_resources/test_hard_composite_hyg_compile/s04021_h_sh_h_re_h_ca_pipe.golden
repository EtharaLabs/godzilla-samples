def combine(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t1 = _pair
    else:
        _pf_t1 = 0
    r = _pf_t1
    return pair(r, 2)
print((combine(Some(1)), combine(_None_)))
def wrap(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([1, 5, 7]))
def promote(s):
    match s:
        case Active(p):
            _pf_t2 = p
            return Active(Pilot(_pf_t2.name, p.age + 1))
        case Idle(t) if t.size > 3:
            _pf_t3 = t
            return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [_Gone, _Gone, Active(Pilot("kit", 36)), _Gone])
