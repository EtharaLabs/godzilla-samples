outcome2 = len(_pf_filter(isBig, _pf_collect(lambda x: [x, x + 1], _pf_drop(2, _pf_filter(lambda x: x % 2 == 1, _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), (lambda _pf_x: _pf_map(sum, _pf_chunk(4, _pf_x)))(readings)))))))
