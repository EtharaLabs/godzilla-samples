from dataclasses import dataclass
import asyncio
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
reach = math.hypot(5.0 / 1.0, 8.0 / 1.0) * 1.0
factor = math.sqrt(2.0)
side = math.sqrt(25.0)
vol = math.cbrt(27.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 5.0)))
log = ["cy", "eli", "dee", "ada", "bo", "eli", "bo", "cy", "dee", "ada"]
m = dict()
for w in log:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
print((_pf_map_try_find("cy", counts), "cy" in counts))
extra = dict([("zed", 5), ("cy", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, counts))))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, counts))
def net(price, qty):
    return price * qty - 2 * qty
def announce(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand = sum(_pf_map(_pf_fn1, [("cog", 8, 3), ("gear", 37, 3), ("wick", 7, 2)]))
print(grand)
def finished(acc):
    async def _pf_fn2():
        return acc
    return _pf_Async(_pf_fn2)
def spin(n, acc):
    async def _pf_fn3(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn3, n, acc)
print(asyncio.run(_pf_run(spin(230, 0))))
def countDigits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn4():
    a = await spin(3, 0)
    return countDigits(a * 31133, 0)
main = _pf_Async(_pf_fn4)
print(asyncio.run(_pf_run(main)))
