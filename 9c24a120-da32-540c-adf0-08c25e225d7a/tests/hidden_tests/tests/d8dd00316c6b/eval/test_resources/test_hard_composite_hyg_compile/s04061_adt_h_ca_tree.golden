from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    _0: int
    def __repr__(self):
        return f"Halt({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    _1: str
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: str
    _1: str
    def __repr__(self):
        return f"Jump({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def show(t):
    match t:
        case Halt(2):
            return "halt-2"
        case Halt(n0):
            return f"halt({n0})"
        case Push(s0, s1):
            return f"push({s0},{s1})"
        case Jump(s0, s1):
            return f"jump({s0},{s1})"
        case Skip():
            return f"skip"
        case Drop(n0, n1) if n0 % 2 == 0:
            return f"drop!({n0},{n1})"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Skip():
            return 7
        case Jump(_, _):
            return 6
        case Push(_, _):
            return 8
        case Halt(x0):
            return x0 * 5
        case _:
            return 3
stream = [Drop(-3, 4), _Skip, Jump("dee", "lu"), Halt(6), Halt(-2), Jump("pam", "quin")]
print(_pf_map(show, stream))
grandSum = _pf_sum_by(cost, stream)
print(f"grandSum={grandSum}")
print((_pf_head(stream), _pf_last(stream)))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [8, 0, 4])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 3) + chatty(False, 4))
def quiet(x):
    return x + 3
print(mapTwice(quiet, [3]))
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Add(Neg(Mul(Num(-1), Num(5))), Neg(Num(9))), Num(-1), Neg(Neg(Add(Num(1), Num(1))))]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evalE, exprs))
