import functools
import math
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_rev(s):
    return "".join(reversed(s))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
print(_pf_str_rev(str.upper("gus")))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout2(x):
    return print(f"* {x}")
forEach(shout2, [0, 3, 3])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 5) + maybeLog(False, 7))
def quiet(x):
    return x + 5
print(mapTwice(quiet, [3]))
reach = math.hypot(8.0 / 1.0, 2.0 / 1.0) * 1.0
ratio = math.sqrt(5.0)
side = math.sqrt(64.0)
vol = math.cbrt(27.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 7.0)))
ticks = 0
def record(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([42, -12, 52, -15, 49, 24]))
doubled = _pf_map(record, [42, -12, 52, -15])
print(f"{doubled} after {ticks} calls")
