from dataclasses import dataclass
import functools
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: object
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([38, 4, 8, 4, 9]))
logged = []
def push2(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(push2, ["start", "tom", "stop"])
print((logged, counts))
span = math.hypot(4.0 / 1.0, 9.0 / 1.0) * 1.0
factor = math.sqrt(10.0)
side = math.sqrt(16.0)
vol = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 6.0)))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
nums = [16, -14, 2, 28, 26, -12]
print(Geo_scaleAll(3, nums))
print(_pf_map(functools.partial(Geo_clamp, 0, 18), nums))
print(_pf_filter(functools.partial(Geo_between, -1, 10), nums))
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Pilot(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 2:
            _pf_t1 = t
            return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [Active(Pilot("gus", 62)), Active(Pilot("lu", 59)), Active(Pilot("gus", 41)), _Gone, _Gone])
print(roster)
people = [Pilot("lu", 8), Pilot("cy", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
