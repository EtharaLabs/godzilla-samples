    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 0
    r = _pf_t0
    return pair(r, 3)
print((merge(Some(5)), merge(_None_)))
