from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
reach = math.hypot(6.0 / 1.0, 4.0 / 1.0) * 1.0
factor = math.sqrt(2.0)
side = math.sqrt(36.0)
vol = math.cbrt(27.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 2.0)))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
def fromBin(s):
    return int(s, base=2)
print(fromBin("100100") + int("46", base=8))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x0", "-34"]))
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(audit([17, 40, 20]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "fay", "stop"])
print((events, counts))
def fold1(m, op):
    match op:
        case Put(k, v):
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        case Append(n):
            return _pf_map_add("pushed", n, m)
        case Noop():
            return m
        case _:
            raise RuntimeError("non-exhaustive match")
def runAll(script):
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t2 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t2
            case Append(n):
                m["pushed"] = n
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
changes = [Put("gear", 1), _Noop, Put("bolt", 9), Append(3), Put("gear", 1)]
final = runAll(changes)
print(_pf_map_to_list(final))
sumSq = _pf_fold(lambda fold1, x: fold1 + x * x, 0, [2, 8, 3, 7])
print(sumSq)
