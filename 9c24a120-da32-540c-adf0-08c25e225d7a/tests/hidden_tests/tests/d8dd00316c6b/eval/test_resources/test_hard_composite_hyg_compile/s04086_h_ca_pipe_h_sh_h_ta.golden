import functools
import asyncio
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [2, 0, 2])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 5) + maybeLog(False, 2))
def quiet(x):
    return x + 8
print(mapTwice(quiet, [4]))
samples = [7, 9, -8, 1, -5, 41]
def accept(n):
    return n > 12 and n % 4 != 0
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
digest = _pf_fold(lambda acc, x: acc * 2 - x, 0, _pf_fn1(_pf_map(lambda b: 23 - b, _pf_distinct(samples))))
print(digest)
adders = _pf_map(lambda k: lambda x: x * 10 + k, [0, 1, 1])
print(_pf_map(lambda g: g(5), adders))
def inc(x):
    return x + 1
def dbl(x):
    return x * 2
def both(x):
    return (lambda _pf_x: (lambda _pf_x: dbl(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [3, 5, 8]))
def wrap(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([9, 6, 0]))
def scale(n):
    return n * 2
def _pf_fn3():
    _pf_t0 = [3, 2]
    if _pf_t0:
        scale = _pf_t0[0]
        return scale + 1
    else:
        return 0
chosen = _pf_fn3()
print((chosen, scale(8)))
def done(acc):
    async def _pf_fn4():
        return acc
    return _pf_Async(_pf_fn4)
def loop(n, acc):
    async def _pf_fn6():
        async def _pf_fn5():
            return n * 3
        k = await _pf_fn5()
        if n <= 0:
            return await done(acc)
        else:
            return await loop(n - 1, acc + k)
    return _pf_Async(_pf_fn6)
print(asyncio.run(_pf_run(loop(41, 0))))
def digits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn7():
    a = await loop(9, 0)
    return digits(a * 19052, 0)
main = _pf_Async(_pf_fn7)
print(asyncio.run(_pf_run(main)))
