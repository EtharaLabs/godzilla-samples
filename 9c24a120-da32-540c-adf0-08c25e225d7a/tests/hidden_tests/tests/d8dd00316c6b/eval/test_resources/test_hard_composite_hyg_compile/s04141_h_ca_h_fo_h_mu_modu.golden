from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [0, 9, 4])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 7) + maybeLog(False, 5))
def quiet(x):
    return x + 5
print(mapTwice(quiet, [1]))
def apply(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Append(n):
                    return (puts, total + n)
                case Noop():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def execute(script):
    return _pf_fold(apply, (0, 0), script)
changes = [Append(3), Put("cog", 8), Append(7), Append(4)]
outcome = execute(changes)
print(outcome)
sumSq = _pf_fold(lambda apply, x: apply + x * x, 0, [7, 6, 6, 1])
print(sumSq)
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([28, 9, 3]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "cy", "stop"])
print((events, counts))
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [-5, -15, 7, -11, -15, -6, 13]
print(_pf_map(Text_square, obs))
print(Text_norm1(obs))
print(Text_mean(obs))
