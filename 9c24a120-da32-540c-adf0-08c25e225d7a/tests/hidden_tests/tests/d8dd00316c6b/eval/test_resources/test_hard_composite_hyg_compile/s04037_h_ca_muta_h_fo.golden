from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [0, 0, 7])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 5) + chatty(False, 8))
def quiet(x):
    return x + 9
print(mapTwice(quiet, [1]))
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 4
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([13, -18, 20, 34, -7, -16, 5, 59]))
doubled = _pf_map(note, [13, -18, 20, 34])
print(f"{doubled} after {calls} calls")
def step(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Append(n):
                    return (puts, total + n)
                case Noop():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def runAll(script):
    return _pf_fold(step, (0, 0), script)
ops = [Append(-1), _Noop, _Noop, Append(3), Put("cog", 7), Put("nut", 5), Put("cog", 9)]
outcome = runAll(ops)
print(outcome)
