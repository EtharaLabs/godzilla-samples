from dataclasses import dataclass
import functools
import math
import math as mth
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
def scale(n):
    return n * 3
def _pf_fn0():
    _pf_t0 = [1, 2]
    if _pf_t0:
        scale = _pf_t0[0]
        return scale + 1
    else:
        return 0
chosen = _pf_fn0()
print((chosen, scale(9)))
def outer(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([3, 4, 8]))
def step1(x):
    return x + 1
def step2(x):
    return x * 2
def both(x):
    return (lambda _pf_x: (lambda _pf_x: step2(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [9, 1, 5]))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([9, 39, 8, 14]))
logged = []
def push2(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(push2, ["start", "max", "stop"])
print((logged, counts))
span = math.hypot(5.0 / 1.0, 6.0 / 1.0) * 1.0
ratio = math.sqrt(3.0)
side = math.sqrt(25.0)
vol = math.cbrt(125.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(span / 1.0))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 8.0)))
def step(xs, op):
    match op:
        case Put(k, v):
            return _pf_concat(xs, [v])
        case Append(n) if n > 1:
            return _pf_concat(xs, [n * 10])
        case _:
            return xs
def replay(script):
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 1:
                _pf_t1 = n * 10
                xs.append(_pf_t1)
            case _:
                pass
    return xs
changes = [Append(-1), Append(3), Append(6), _Noop, _Noop, Put("nut", 4), _Noop]
final = replay(changes)
print(final)
acc = _pf_fold(lambda step, x: step + x * x, 0, [4, 5, 2, 7])
print(acc)
