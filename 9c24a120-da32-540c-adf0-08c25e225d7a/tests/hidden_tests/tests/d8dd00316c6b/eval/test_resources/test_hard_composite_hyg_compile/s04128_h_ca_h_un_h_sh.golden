from dataclasses import dataclass
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [8, 0, 3])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 2) + chatty(False, 9))
def quiet(x):
    return x + 8
print(mapTwice(quiet, [2]))
reach = math.hypot(3.0 / 1.0, 8.0 / 1.0) * 1.0
factor = math.sqrt(10.0)
side = math.sqrt(9.0)
vol = math.cbrt(125.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(reach / 1.0))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 9.0)))
def bump2(n):
    return n + 23
def applyLift(x):
    return bump2(x)
def _pf_fn0():
    bump2 = 1
    return applyLift(bump2)
sample = _pf_fn0()
print((sample, applyLift(6)))
def step1(x):
    return x + 1
def dbl(x):
    return x * 2
def pipeline2(_pf_x):
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: dbl(step1(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(pipeline2, [5, 9, 5]))
def merge(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 3
    r = _pf_t0
    return pair(r, 2)
print((merge(Some(1)), merge(_None_)))
