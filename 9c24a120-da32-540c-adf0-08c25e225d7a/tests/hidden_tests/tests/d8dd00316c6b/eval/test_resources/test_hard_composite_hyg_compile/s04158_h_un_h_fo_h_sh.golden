def execute(script):
    def step(acc, op):
        match acc:
            case (puts, total):
                match op:
                    case Put(_, v):
                        return (puts + 1, total + v)
                    case Append(n):
                        return (puts, total + n)
                    case Noop():
                        return acc
                    case _:
                        raise RuntimeError("non-exhaustive match")
    return _pf_fold(step, (0, 0), script)
