from dataclasses import dataclass
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_list_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(audit([14, 30, 40, 34]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "pam", "stop"])
print((events, counts))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [8, 5, 6])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 1) + maybeLog(False, 4))
def quiet(x):
    return x + 5
print(mapTwice(quiet, [2]))
data = [17, -5, 32, 12, -2, 4, -4]
def offset(k, x):
    return x + k
def accept(n):
    return n > 18 and n % 4 != 0
answer = _pf_list_find(lambda x: x % 4 == 1, _pf_filter(accept, _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), _pf_map(lambda x: x * x - 3, _pf_sort_by(lambda x: -x, data)))))
print(answer)
print(len(data))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def spin(n, acc):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 2
        k = await _pf_fn1()
        if n <= 0:
            return await finished(acc)
        else:
            return await spin(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(spin(8, 0))))
def digits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await spin(6, 0)
    return digits(a * 99411, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
