from dataclasses import dataclass
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    def __repr__(self):
        return "Drop"
_Drop = Drop()
def render(t):
    match t:
        case Push(n0) if n0 > 3:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Skip(s0):
            return f"skip({s0})"
        case Mark(n0):
            return f"mark({n0})"
        case Drop():
            return f"drop"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Drop():
            return 1
        case Mark(x0):
            return x0
        case Push(x0):
            return x0 * 5
        case _:
            return 2
stream = [Skip("ivy"), _Drop, Mark(0), _Drop, Push(1), Push(-1)]
print(_pf_map(render, stream))
tally = _pf_sum_by(cost, stream)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: cost(t) > 4, stream)))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
forEach(shout, [0, 3, 4])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 6) + maybeLog(False, 9))
def quiet(x):
    return x + 5
print(mapTwice(quiet, [6]))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([21, 7, 21, 19]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "gus", "stop"])
print((events, counts))
