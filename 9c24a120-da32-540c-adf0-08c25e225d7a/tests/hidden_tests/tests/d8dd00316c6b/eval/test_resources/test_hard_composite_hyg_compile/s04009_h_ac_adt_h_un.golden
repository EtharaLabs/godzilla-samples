def explain(t):
    match t:
        case Emit(0):
            return "emit-0"
        case Emit(n0):
            return f"emit({n0})"
        case Halt():
            return f"halt"
        case Turn(s0):
            return f"turn({s0})"
        case Load(n0) if n0 % 2 == 0:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Mark(s0, n1):
            return f"mark({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Halt():
            return 7
        case Load(x0):
            return x0
        case _:
            return 3
stream = [Mark("fay", 5), Load(6), Mark("ned", 1), _Halt, Emit(-1), Turn("jo")]
