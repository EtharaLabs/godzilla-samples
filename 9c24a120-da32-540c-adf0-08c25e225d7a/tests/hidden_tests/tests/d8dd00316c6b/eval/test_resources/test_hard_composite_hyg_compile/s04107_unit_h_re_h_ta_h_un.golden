def finished(acc):
    async def _pf_fn1():
        return acc
    return _pf_Async(_pf_fn1)
def spin(n, acc):
    async def _pf_fn2(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn2, n, acc)
print(asyncio.run(_pf_run(spin(2508, 0))))
def countDigits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await spin(7, 0)
    return countDigits(a * 47843, 0)
