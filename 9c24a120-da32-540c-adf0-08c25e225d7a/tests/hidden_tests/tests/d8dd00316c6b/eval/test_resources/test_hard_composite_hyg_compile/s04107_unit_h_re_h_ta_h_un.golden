def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Member(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 2:
            _pf_t1 = t
            return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
