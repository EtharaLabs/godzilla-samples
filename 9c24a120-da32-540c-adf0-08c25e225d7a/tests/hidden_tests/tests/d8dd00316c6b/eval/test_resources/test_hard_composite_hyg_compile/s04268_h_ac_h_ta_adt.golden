from dataclasses import dataclass
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: str
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    _1: int
    def __repr__(self):
        return f"Push({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 6:
        return _Low()
    elif scaled < 23:
        return _Mid()
    else:
        return _High()
def label(n):
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
        return "mid"
    if isinstance(_pf_t0, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(label, [9, 24, 25, 18, -4]))
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n, acc):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await done(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(1465, 0))))
def countDigits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await loop(5, 0)
    return countDigits(a * 93709, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
def explain(t):
    match t:
        case Emit(s0):
            return f"emit({s0})"
        case Store(n0) if 0 <= n0 < 3:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case Skip(n0) if 0 <= n0 < 16:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Push(s0, n1):
            return f"push({s0},{n1})"
        case Drop(n0) if n0 > 4:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Skip(x0):
            return x0 * 2
        case Store(x0):
            return x0
        case _:
            return 1
batch = [Drop(1), Skip(11), Push("tom", 6), Store(3)]
_pf_iter(lambda t: print(explain(t)), batch)
total = _pf_sum_by(cost, batch)
print(f"total={total}")
print((_pf_head(batch), _pf_last(batch)))
