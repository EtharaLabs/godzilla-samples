from dataclasses import dataclass
import functools
import math
import math as mth
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Team:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
span = math.hypot(2.0 / 1.0, 3.0 / 1.0) * 1.0
factor = math.sqrt(2.0)
side = math.sqrt(4.0)
vol = math.cbrt(27.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(span / 1.0))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 8.0)))
ticks = 0
def note(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([45, 18, 8, 38, -2, 34]))
doubled = _pf_map(note, [45, 18, 8, 38])
print(f"{doubled} after {ticks} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), ticks))
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Pilot(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 5:
            _pf_t1 = t
            return Idle(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [Active(Pilot("ray", 43)), Idle(Team("bolt", 1)), Idle(Team("gear", 2)), Active(Pilot("max", 25)), _Gone])
print(roster)
members = [Pilot("quin", 4), Pilot("pam", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def Text_square(x):
    return x * x
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
pts = [-15, -7, -10, -6, 7, -6, 28]
print(_pf_map(Text_square, pts))
print(Text_mean(pts))
print(Text_norm1(pts))
print(_pf_map(functools.partial(Text_clamp, 0, 19), pts))
