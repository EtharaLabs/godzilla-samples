from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
_Jump = Jump()
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
_Rest = Rest()
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    def __repr__(self):
        return "Mark"
_Mark = Mark()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    _1: int
    def __repr__(self):
        return f"Load({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip2:
    def __repr__(self):
        return "Skip2"
_Skip2 = Skip2()
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [9, 5, 8])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 1) + maybeLog(False, 3))
def quiet(x):
    return x + 6
print(mapTwice(quiet, [9]))
def render(t):
    match t:
        case Skip(s0):
            return f"skip({s0})"
        case Mark():
            return f"mark"
        case Load(s0, n1):
            return f"load({s0},{n1})"
        case Jump() | Rest():
            return "jump/rest"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Jump():
            return 4
        case Skip(_):
            return 3
        case Load(_, x1):
            return x1
        case _:
            return 0
prog = [Load("dee", 1), _Rest, _Mark, Skip("quin"), _Mark, _Mark]
print(_pf_map(render, prog))
grandSum = _pf_sum_by(rank, prog)
print(f"grandSum={grandSum}")
print((_pf_head(prog), _pf_last(prog)))
def runAll(script):
    def step(xs, op):
        match op:
            case Put(k, v):
                return _pf_concat(xs, [v])
            case Append(n) if n > 5:
                return _pf_concat(xs, [n * 10])
            case _:
                return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 5:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes = [Put("nut", 8), _Skip2, _Skip2, _Skip2, Put("nut", 9), Put("nut", 8)]
state = runAll(changes)
print(state)
acc = _pf_fold(lambda step, x: step + x * x, 0, [9, 7, 3, 8])
print(acc)
span = math.hypot(9.0 / 1.0, 4.0 / 1.0) * 1.0
ratio = math.sqrt(10.0)
side = math.sqrt(81.0)
vol = math.cbrt(27.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 3.0)))
