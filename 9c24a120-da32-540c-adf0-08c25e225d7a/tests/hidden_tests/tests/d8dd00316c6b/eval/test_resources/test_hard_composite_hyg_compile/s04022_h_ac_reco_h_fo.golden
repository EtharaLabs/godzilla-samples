class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 6:
        return _Low()
    elif scaled < 33:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    match _pf_str_split("=", s):
        case [k, v]:
            _pf_t0 = _pf_str_to_int(v)
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some((_pf_str_strip(k), n))
            else:
                return _None_
        case _:
            return _None_
def tier(n):
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    elif isinstance(_pf_t1, _Mid):
        return "mid"
    elif isinstance(_pf_t1, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def grade(s):
    _pf_t2 = _ap_KeyVal(s)
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
