    return _pf_Async(_pf_fn0)
def loop(n, acc):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 3
        k = await _pf_fn1()
        if n <= 0:
            return await finished(acc)
        else:
            return await loop(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(loop(13, 0))))
def countDigits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await loop(7, 0)
    return countDigits(a * 6606, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
