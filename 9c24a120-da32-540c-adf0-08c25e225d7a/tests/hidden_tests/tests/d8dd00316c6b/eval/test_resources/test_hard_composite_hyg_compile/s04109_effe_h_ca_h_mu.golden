def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def net(price, qty):
    return price * qty - 4 * qty
def report(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("wick", 7, 3), ("tap", 6, 6), ("pin", 26, 3), ("wick", 5, 2)]))
print(overall)
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [1, 5, 3])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 2) + chatty(False, 6))
def quiet(x):
    return x + 7
print(mapTwice(quiet, [2]))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([21, 39, 9]))
logged = []
def push2(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(push2, ["start", "sue", "stop"])
print((logged, counts))
