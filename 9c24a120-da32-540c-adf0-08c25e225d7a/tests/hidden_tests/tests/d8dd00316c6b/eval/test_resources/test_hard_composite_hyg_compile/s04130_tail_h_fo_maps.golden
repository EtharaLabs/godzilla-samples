from dataclasses import dataclass
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(20, 77))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(62353))
def runAll(script):
    def fold1(acc, op):
        return acc
    def fold1(acc, op):
        match acc:
            case (m, xs):
                match op:
                    case Put(k, v):
                        return (_pf_map_add(k, v, m), xs)
                    case Push(n):
                        return (m, _pf_concat(xs, [n]))
                    case Skip():
                        return acc
                    case _:
                        raise RuntimeError("non-exhaustive match")
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
