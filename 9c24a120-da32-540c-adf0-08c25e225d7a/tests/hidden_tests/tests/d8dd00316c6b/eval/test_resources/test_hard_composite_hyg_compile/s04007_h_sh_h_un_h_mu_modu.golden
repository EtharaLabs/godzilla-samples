from dataclasses import dataclass
import functools
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
makers = _pf_map(lambda k: lambda x: x * 10 + k, [3, 2, 0])
print(_pf_map(lambda g: g(2), makers))
def inc(x):
    return x + 1
def dbl(x):
    return x * 2
def pipeline2(x):
    return (lambda _pf_x: (lambda _pf_x: dbl(inc(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(pipeline2, [6, 1, 0]))
def combine(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 3
    r = _pf_t0
    return pair(r, 3)
print((combine(Some(6)), combine(_None_)))
span = math.hypot(3.0 / 1.0, 7.0 / 1.0) * 1.0
factor = math.sqrt(10.0)
side = math.sqrt(9.0)
vol = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(span / 1.0))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 3.0)))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(4, 0)
print(scan([18, 8, 0, 19, 17]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "cy", "stop"])
print((logged, counts))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [16, 20, -13, -11, -10, 2]
print(Text_scaleAll(4, pts))
print(_pf_filter(functools.partial(Text_between, 2, 19), pts))
print(Text_norm1(pts))
