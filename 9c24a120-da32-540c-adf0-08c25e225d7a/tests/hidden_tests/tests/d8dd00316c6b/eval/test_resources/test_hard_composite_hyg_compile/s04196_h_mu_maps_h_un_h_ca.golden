from dataclasses import dataclass
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_map_values(m):
    return list(m.values())
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(1, 0)
print(inspect([27, 18, 36]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "gus", "stop"])
print((logged, counts))
events = ["bo", "cy", "ada", "eli", "fay", "cy"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in events:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
freq = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(freq)))
print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, freq))))
extra = dict([("zed", 5), ("bo", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, freq))))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, freq))
span = math.hypot(2.0 / 1.0, 8.0 / 1.0) * 1.0
ratio = math.sqrt(3.0)
side = math.sqrt(4.0)
vol = math.cbrt(8.0)
