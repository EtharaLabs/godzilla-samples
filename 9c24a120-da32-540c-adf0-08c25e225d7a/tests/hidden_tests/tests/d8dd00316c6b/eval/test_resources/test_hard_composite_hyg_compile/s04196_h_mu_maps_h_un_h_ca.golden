def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 5.0)))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [2, 9, 2])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 6) + maybeLog(False, 6))
def quiet(x):
    return x + 8
print(mapTwice(quiet, [2]))
