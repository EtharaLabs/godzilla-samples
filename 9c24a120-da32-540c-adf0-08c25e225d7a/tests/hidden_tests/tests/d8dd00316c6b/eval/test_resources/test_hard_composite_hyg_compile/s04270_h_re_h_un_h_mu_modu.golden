from dataclasses import dataclass
import functools
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Person:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Person(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 4:
            _pf_t1 = t
            return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [Idle(Club("wick", 5)), _Gone, Idle(Club("cog", 2)), _Gone])
print(roster)
members = [Person("bo", 7), Person("fay", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
reach = math.hypot(3.0 / 1.0, 3.0 / 1.0) * 1.0
ratio = math.sqrt(2.0)
side = math.sqrt(9.0)
vol = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 3.0)))
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(audit([37, 20, 25, 39, 34]))
logged = []
def logEvent(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(logEvent, ["start", "kit", "stop"])
print((logged, counts))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [15, 13, -3, 14, 4, -1, 14]
print(Text_norm1(obs))
print(Text_scaleAll(2, obs))
print(_pf_map(functools.partial(Text_clamp, 0, 8), obs))
print(Text_mean(obs))
