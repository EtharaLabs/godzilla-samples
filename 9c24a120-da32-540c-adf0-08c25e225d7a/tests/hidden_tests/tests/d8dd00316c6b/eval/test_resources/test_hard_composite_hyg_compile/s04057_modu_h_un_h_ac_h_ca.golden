from dataclasses import dataclass
import functools
import math
import math as mth
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def Stats_square(x):
    return x * x
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
obs = [2, 25, 11, -3, 13]
print(_pf_map(Stats_square, obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 5), obs))
print(_pf_filter(functools.partial(Stats_between, -4, 24), obs))
print(Stats_mean(obs))
reach = math.hypot(5.0 / 1.0, 2.0 / 1.0) * 1.0
factor = math.sqrt(10.0)
side = math.sqrt(25.0)
vol = math.cbrt(64.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, factor), side, vol))
print(mth.floor(reach / 1.0))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(reach, 5.0)))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 2:
        return _Low()
    elif scaled < 20:
        return _Mid()
    else:
        return _High()
def label(n):
    _pf_t0 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t0, _Low):
        return "low"
    if isinstance(_pf_t0, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t0, _Mid):
        return "mid"
    if isinstance(_pf_t0, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(label, [27, 8, 17, -1, -5]))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [2, 1, 5])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 4) + chatty(False, 9))
def quiet(x):
    return x + 3
print(mapTwice(quiet, [7]))
