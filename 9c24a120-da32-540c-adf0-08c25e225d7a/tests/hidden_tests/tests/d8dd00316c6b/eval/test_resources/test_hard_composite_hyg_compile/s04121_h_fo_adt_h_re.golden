_Gone = Gone()
def fold1(acc, op):
    match acc:
        case (m, xs):
            match op:
                case Put(k, v):
                    return (_pf_map_add(k, v, m), xs)
                case Push(n):
                    return (m, _pf_concat(xs, [n]))
                case Noop():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def replay(script):
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
ops = [Push(5), _Noop, _Noop, _Noop, Push(9), Put("cog", 2)]
final = replay(ops)
mm, items = final
print((_pf_map_to_list(mm), items))
def show(t):
    match t:
        case Turn(n0) if n0 % 2 == 0:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Drop(n0) if 0 <= n0 < 5:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case Jump(n0) if n0 > 0:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Halt(n0) if n0 % 2 == 0:
            return f"halt!({n0})"
        case Halt(n0):
            return f"halt({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Jump(x0):
            return x0
        case _:
            return 1
batch = [Halt(9), Mark(2, 5), Turn(10), Jump(-1), Jump(2), Halt(2), Turn(3)]
_pf_iter(lambda t: print(show(t)), batch)
grandSum = _pf_sum_by(cost, batch)
print(f"grandSum={grandSum}")
print((_pf_head(batch), _pf_last(batch)))
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Person(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 4:
            _pf_t1 = t
            return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [Parked(Crew("rod", 2)), Parked(Crew("gear", 1)), Parked(Crew("nut", 9)), Parked(Crew("cog", 3)), _Gone])
print(roster)
