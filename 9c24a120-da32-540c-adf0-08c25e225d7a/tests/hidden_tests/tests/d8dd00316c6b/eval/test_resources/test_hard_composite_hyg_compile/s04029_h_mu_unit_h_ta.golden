from dataclasses import dataclass
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(inspect([0, 37, 35, 16, 23, 16]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "oz", "stop"])
print((events, counts))
segments = [290.0, 62.3, 55.6, 210.3, 19.6]
durations = [41.7, 36.7, 11.9, 43.3, 78.8]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed = dist / dur
print(_pf_fmt_fixed(2, speed))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
mass = 15.0
accel = 7.5
push = mass * accel
limit = 392.0
print("over" if push > limit else "under")
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(segments, durations))
print(best)
def finished(acc):
    async def _pf_fn1():
        return acc
    return _pf_Async(_pf_fn1)
def spin(n, acc):
    async def _pf_fn2(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn2, n, acc)
print(asyncio.run(_pf_run(spin(1963, 0))))
def digits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await spin(3, 0)
    return digits(a * 16239, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
