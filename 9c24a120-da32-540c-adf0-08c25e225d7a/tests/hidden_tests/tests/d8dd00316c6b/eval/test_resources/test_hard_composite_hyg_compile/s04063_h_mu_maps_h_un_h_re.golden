    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 8.0)))
def promote(s):
    match s:
        case Active(p):
            _pf_t1 = p
            return Active(Pilot(_pf_t1.name, p.age + 1))
        case Parked(t) if t.size > 5:
            _pf_t2 = t
            return Parked(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
