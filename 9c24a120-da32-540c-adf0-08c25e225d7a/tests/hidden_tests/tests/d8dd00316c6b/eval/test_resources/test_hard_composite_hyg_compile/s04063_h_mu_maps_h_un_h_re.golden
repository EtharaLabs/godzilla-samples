print(_pf_sort(_pf_map_values(_pf_map_map(lambda k, v: v * 10, freq))))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, freq))
span = math.hypot(5.0 / 1.0, 4.0 / 1.0) * 1.0
ratio = math.sqrt(10.0)
side = math.sqrt(25.0)
vol = math.cbrt(64.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
