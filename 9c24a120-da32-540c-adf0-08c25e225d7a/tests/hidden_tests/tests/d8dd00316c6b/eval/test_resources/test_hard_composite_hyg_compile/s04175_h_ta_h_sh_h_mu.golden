from dataclasses import dataclass
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n, acc):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(2701, 0))))
def digits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await loop(5, 0)
    return digits(a * 69818, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
def inc(x):
    return x + 1
def step2(x):
    return x * 2
def both(_pf_x):
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: step2(inc(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(both, [3, 2, 7]))
def swapSum(pairs):
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn3(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn3, pairs))
print(swapSum([(7, 5), (2, 3)]))
adders = _pf_map(lambda k: lambda x: x * 10 + k, [6, 4, 7])
print(_pf_map(lambda g: g(2), adders))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(inspect([38, 16, 4, 30, 6, 7]))
logged = []
def push2(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(push2, ["start", "tom", "stop"])
print((logged, counts))
