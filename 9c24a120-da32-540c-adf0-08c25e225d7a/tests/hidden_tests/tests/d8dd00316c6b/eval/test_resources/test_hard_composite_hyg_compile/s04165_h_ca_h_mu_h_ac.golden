from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [3, 0, 7])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 8) + chatty(False, 1))
def quiet(x):
    return x + 7
print(mapTwice(quiet, [6]))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(inspect([3, 10, 14, 5]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "dee", "stop"])
print((events, counts))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 8:
        return _Low()
    elif scaled < 30:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    match _pf_str_split("=", s):
        case [k, v]:
            _pf_t0 = _pf_str_to_int(v)
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some((_pf_str_strip(k), n))
            else:
                return _None_
        case _:
            return _None_
def tier(n):
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    elif isinstance(_pf_t1, _Mid):
        return "mid"
    elif isinstance(_pf_t1, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def grade(s):
    _pf_t2 = _ap_KeyVal(s)
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(grade, ["dee=x", "cy=x", "lu=3", "max=15"]))
