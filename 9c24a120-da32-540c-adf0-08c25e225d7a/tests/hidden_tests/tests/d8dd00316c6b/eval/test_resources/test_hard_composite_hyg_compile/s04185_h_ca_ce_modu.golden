    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 8) + maybeLog(False, 7))
def quiet(x):
    return x + 8
print(mapTwice(quiet, [7]))
def decodeLine(line):
    def _pf_fn0():
        match _pf_str_split("=", line):
            case [_k, _v]:
                _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
            case _:
                _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t1 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t1, Ok):
                n = _pf_t1._0
                return Ok((k, n))
            else:
                return _pf_t1
        else:
            return _pf_t0
    return _pf_fn0()
entries = ["pam", "quin = 9", "kit = 6", "bo=x"]
results = _pf_map(decodeLine, entries)
_pf_iter(print, results)
errs = len(_pf_filter(_pf_result_is_error, results))
print(f"{errs} errors")
def sumAll(xs):
    def _pf_fn2(acc, r):
        def _pf_fn3():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
                    return r
            else:
                return acc
        return _pf_fn3()
    return _pf_fold(_pf_fn2, Ok(0), xs)
print(_pf_result_map_error(_pf_str_upper, sumAll(results)))
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_square(x):
    return x * x
def Calc_between(lo, hi, x):
    return lo <= x <= hi
nums = [-14, 17, 1, 12, 19, -11, 24]
