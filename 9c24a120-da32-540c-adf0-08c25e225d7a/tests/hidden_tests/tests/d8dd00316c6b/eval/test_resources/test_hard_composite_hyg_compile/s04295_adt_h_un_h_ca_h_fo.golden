from dataclasses import dataclass
from functools import total_ordering
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    def __repr__(self):
        return "Load"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Load = Load()
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip2:
    def __repr__(self):
        return "Skip2"
_Skip2 = Skip2()
def describe(t):
    match t:
        case Skip(n0):
            return f"skip({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Load():
            return f"load"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Pop(x0):
            return x0
        case _:
            return 1
queue = [Skip(0), Pop(9), Skip(6), Pop(10), Pop(8)]
print(_pf_str_join("; ", _pf_map(describe, queue)))
grandSum = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print(_pf_sort(queue))
span = math.hypot(5.0 / 1.0, 8.0 / 1.0) * 1.0
factor = math.sqrt(2.0)
side = math.sqrt(25.0)
vol = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 6.0)))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [3, 3, 2])
print(mapTwice(lambda x: x + 5, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 3) + maybeLog(False, 1))
def quiet(x):
    return x + 8
print(mapTwice(quiet, [9]))
def runAll(script):
    def fold1(xs, op):
        match op:
            case Put(k, v):
                return _pf_concat(xs, [v])
            case Append(n) if n > 3:
                return _pf_concat(xs, [n * 10])
            case _:
                return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 3:
                _pf_t0 = n * 10
                xs.append(_pf_t0)
            case _:
                pass
    return xs
changes = [Append(7), Put("nut", 6), _Skip2, Put("gear", 5), Put("nut", 1), Put("bolt", 4)]
final = runAll(changes)
print(final)
