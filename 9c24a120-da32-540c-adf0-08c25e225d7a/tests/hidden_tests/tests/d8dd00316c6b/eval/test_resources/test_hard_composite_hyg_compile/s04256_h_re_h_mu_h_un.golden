from dataclasses import dataclass
import math
import math as mth
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Club:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Pilot(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 3:
            _pf_t1 = t
            return Idle(Club(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [_Gone, _Gone, Idle(Club("tap", 7)), Active(Pilot("quin", 53)), Active(Pilot("oz", 65))])
print(slots)
members = [Pilot("jo", 1), Pilot("fay", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(audit([8, 8, 13, 26, 1, 12]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "sue", "stop"])
print((events, counts))
span = math.hypot(4.0 / 1.0, 5.0 / 1.0) * 1.0
ratio = math.sqrt(2.0)
side = math.sqrt(16.0)
vol = math.cbrt(64.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(span / 1.0))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 2.0)))
