def runAll(script):
    def fold1(acc, op):
        return acc
    def fold1(xs, op):
        match op:
            case Put(k, v):
                return _pf_concat(xs, [v])
            case Push(n) if n > 1:
                return _pf_concat(xs, [n * 10])
            case _:
                return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Push(n) if n > 1:
                _pf_t2 = n * 10
                xs.append(_pf_t2)
            case _:
                pass
    return xs
