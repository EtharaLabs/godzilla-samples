_Skip = Skip()
laps = [285.3, 375.7, 346.9]
durations = [30.6, 20.0, 86.1]
total = _pf_fold(lambda a, b: a + b, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
pace = total / elapsed
print(_pf_fmt_fixed(2, pace))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
side = math.sqrt(4.0)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
