from dataclasses import dataclass
import asyncio
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: int
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Noop:
    def __repr__(self):
        return "Noop"
_Noop = Noop()
def step(acc, op):
    match acc:
        case (m, xs):
            match op:
                case Put(k, v):
                    return (_pf_map_add(k, v, m), xs)
                case Push(n):
                    return (m, _pf_concat(xs, [n]))
                case Noop():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def runAll(script):
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Push(n):
                xs.append(n)
            case Noop():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
changes = [Put("cog", 9), _Noop, Put("cog", 2), _Noop]
state = runAll(changes)
mm, items = state
print((_pf_map_to_list(mm), items))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def spin(n, acc):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 3
        k = await _pf_fn1()
        if n <= 0:
            return await finished(acc)
        else:
            return await spin(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(spin(27, 0))))
def digits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn3():
    a = await spin(3, 0)
    return digits(a * 27708, 0)
main = _pf_Async(_pf_fn3)
print(asyncio.run(_pf_run(main)))
span = math.hypot(2.0 / 1.0, 6.0 / 1.0) * 1.0
factor = math.sqrt(5.0)
side = math.sqrt(4.0)
vol = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(span, 6.0)))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [0, 0, 2])
print(mapTwice(lambda x: x + 3, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 4) + chatty(False, 6))
def quiet(x):
    return x + 9
print(mapTwice(quiet, [1]))
