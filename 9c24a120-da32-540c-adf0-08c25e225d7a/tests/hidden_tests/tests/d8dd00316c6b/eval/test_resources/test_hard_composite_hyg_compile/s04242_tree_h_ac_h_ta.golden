from dataclasses import dataclass
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Low:
    def __repr__(self):
        return "_Low"
@dataclass(frozen=True, slots=True, repr=False)
class _Mid:
    def __repr__(self):
        return "_Mid"
@dataclass(frozen=True, slots=True, repr=False)
class _High:
    def __repr__(self):
        return "_High"
def insert(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(insert(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, insert(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
tree = _pf_fold(lambda acc, x: insert(x, acc), _Leaf, [57, 32, 30, 7, 38, 45])
def sumT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumT(l) + v + sumT(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumT(tree))
def minT(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minT(tree))
def containsOf(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsOf(k, tree), [57, 46, 25]))
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 7:
        return _Low()
    elif scaled < 38:
        return _Mid()
    else:
        return _High()
def _ap_KeyVal(s):
    match _pf_str_split("=", s):
        case [k, v]:
            _pf_t0 = _pf_str_to_int(v)
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some((_pf_str_strip(k), n))
            else:
                return _None_
        case _:
            return _None_
def tier(n):
    _pf_t1 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t1, _Low):
        return "low"
    elif isinstance(_pf_t1, _Mid):
        return "mid"
    elif isinstance(_pf_t1, _High):
        return "high"
    else:
        raise RuntimeError("non-exhaustive match")
def describe(s):
    _pf_t2 = _ap_KeyVal(s)
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        if _pf_snd(pair) < 0:
            return f"{_pf_fst(pair)}: negative"
    if isinstance(_pf_t2, Some):
        pair = _pf_t2._0
        return f"{_pf_fst(pair)}: {tier(_pf_snd(pair))}"
    return "?"
_pf_iter(print, _pf_map(describe, ["ned=x", "pam=8", "dee=x", "hal=x"]))
def done(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n, acc):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await done(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(1515, 0))))
