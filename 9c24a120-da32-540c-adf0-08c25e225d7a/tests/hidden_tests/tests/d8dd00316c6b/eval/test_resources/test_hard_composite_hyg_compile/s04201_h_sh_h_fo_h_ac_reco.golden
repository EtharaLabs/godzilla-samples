print((combine(Some(7)), combine(_None_)))
def fold1(xs, op):
    match op:
        case Put(k, v):
            return _pf_concat(xs, [v])
        case Append(n) if n > 2:
            return _pf_concat(xs, [n * 10])
        case _:
            return xs
def replay(script):
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 2:
                _pf_t1 = n * 10
                xs.append(_pf_t1)
            case _:
                pass
    return xs
changes = [Append(4), _Skip, _Skip, _Skip, Put("gear", 3), Append(3), _Skip]
state = replay(changes)
print(state)
def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 9:
        return _Low()
    elif scaled < 26:
        return _Mid()
    else:
        return _High()
def grade(n):
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    if isinstance(_pf_t2, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t2, _Mid):
        return "mid"
    if isinstance(_pf_t2, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(grade, [6, 25, 1, 17, 2]))
