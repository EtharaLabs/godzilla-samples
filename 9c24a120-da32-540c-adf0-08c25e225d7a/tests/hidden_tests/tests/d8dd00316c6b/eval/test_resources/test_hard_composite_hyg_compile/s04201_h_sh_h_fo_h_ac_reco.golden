from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
