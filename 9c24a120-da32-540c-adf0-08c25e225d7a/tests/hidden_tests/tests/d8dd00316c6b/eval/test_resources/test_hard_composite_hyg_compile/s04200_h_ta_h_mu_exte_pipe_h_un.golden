from dataclasses import dataclass
import asyncio
import math
import math as mth
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n, acc):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(1272, 0))))
def countDigits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await loop(8, 0)
    return countDigits(a * 94071, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(scan([10, 27, 27]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "hal", "stop"])
print((events, counts))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1011111") + int("31", base=8))
print(_pf_map(math.isqrt, [29, 396, 234, 171]))
data = [2, 38, 49, 30, 35, 15, 47, 4, -3, 0]
def addK(k, x):
    return x + k
def keep(n):
    return n > 17 and n % 5 != 0
process = lambda _pf_x: _pf_filter(lambda x: x % 5 == 4, (lambda _pf_x: (lambda _pf_x: _pf_map(sum, _pf_chunk(2, _pf_x)))((lambda _pf_x: _pf_choose(lambda x: (Some(x // 5) if x % 5 == 0 else _None_), _pf_take(4, _pf_x)))(_pf_x)))(_pf_x))
outcome = _pf_sum_by(lambda x: x * x, process(data))
print(outcome)
reach = math.hypot(4.0 / 1.0, 7.0 / 1.0) * 1.0
ratio = math.sqrt(10.0)
side = math.sqrt(16.0)
vol = math.cbrt(8.0)
print((_pf_fmt_fixed(3, reach), _pf_fmt_fixed(4, ratio), side, vol))
print(mth.floor(reach / 1.0))
def rateOf(d, t):
    return d / t
print(_pf_fmt_fixed(2, rateOf(reach, 6.0)))
