_pf_iter(print, _pf_map(safe, ["12", "x8", "44"]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(7))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1100010") + int("46", base=8))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
forEach(shout, [3, 1, 5])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 5) + chatty(False, 7))
def quiet(x):
