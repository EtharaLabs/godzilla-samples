from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Member:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Member(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 5:
            _pf_t1 = t
            return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [_Gone, Active(Member("sue", 69)), Idle(Crew("tap", 2)), Active(Member("ray", 38))])
print(roster)
members = [Member("quin", 3), Member("oz", 1)]
print((_pf_map(lambda x: x.name, members), _pf_sum_by(lambda x: x.age, members)))
def safe(s):
    try:
        _pf_t2 = Ok(int(s))
    except Exception as _pf_t3:
        _pf_t2 = Error(_Exception(type(_pf_t3).__name__, str(_pf_t3)))
    if isinstance(_pf_t2, Ok):
        n = _pf_t2._0
