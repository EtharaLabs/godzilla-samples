def _ap_Low_Mid_High(n):
    scaled = n * 2
    if scaled < 9:
        return _Low()
    elif scaled < 30:
        return _Mid()
    else:
        return _High()
def describe2(n):
    _pf_t2 = _ap_Low_Mid_High(n)
    if isinstance(_pf_t2, _Low):
        return "low"
    if isinstance(_pf_t2, _Mid):
        if n % 2 == 0:
            return "mid-even"
    if isinstance(_pf_t2, _Mid):
        return "mid"
    if isinstance(_pf_t2, _High):
        return "high"
    raise RuntimeError("non-exhaustive match")
print(_pf_map(describe2, [4, 16, 20, 15, -5]))
