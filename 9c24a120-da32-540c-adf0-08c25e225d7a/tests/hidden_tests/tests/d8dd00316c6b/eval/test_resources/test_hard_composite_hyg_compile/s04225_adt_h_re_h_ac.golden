def describe(t):
    match t:
        case Turn(s0):
            return f"turn({s0})"
        case Emit(n0) if 0 <= n0 < 9:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Store(s0, n1):
            return f"store({s0},{n1})"
        case Jump():
            return f"jump"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Store(_, x1):
            return x1
        case _:
            return 0
queue = [_Jump, Store("lu", -3), Emit(7), Store("max", 9), Emit(0)]
print(_pf_map(describe, queue))
total = _pf_sum_by(weight, queue)
print(f"total={total}")
print((_pf_head(queue), _pf_last(queue)))
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Member(_pf_t0.name, p.age + 1))
        case Parked(t) if t.size > 2:
            _pf_t1 = t
            return Parked(Team(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
roster = _pf_map(promote, [Active(Member("jo", 58)), Parked(Team("tap", 2)), _Gone])
