def step(m, op):
    match op:
        case Put(k, v):
            return _pf_map_add(k, _pf_map_find_or(k, 0, m) + v, m)
        case Append(n):
            return _pf_map_add("pushed", n, m)
        case Skip():
            return m
        case _:
            raise RuntimeError("non-exhaustive match")
def runAll(script):
    m = dict()
    for op in script:
        match op:
            case Put(k, v):
                _pf_t0 = _pf_map_find_or(k, 0, m) + v
                m[k] = _pf_t0
            case Append(n):
                m["pushed"] = n
            case Skip():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return m
