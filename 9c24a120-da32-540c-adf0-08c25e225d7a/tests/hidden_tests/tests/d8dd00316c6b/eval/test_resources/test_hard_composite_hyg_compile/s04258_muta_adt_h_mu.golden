from dataclasses import dataclass
from functools import total_ordering
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: str
    def __repr__(self):
        return f"Emit({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Halt = Halt()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (3,)
_Push = Push()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (4, self._0)
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 2
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([42, 21, 5, 24, 46, 59]))
doubled = _pf_map(note, [42, 21, 5, 24])
print(f"{doubled} after {calls} calls")
def explain(t):
    match t:
        case Emit(s0):
            return f"emit({s0})"
        case Drop(0):
            return "drop-0"
        case Drop(n0):
            return f"drop({n0})"
        case Load(s0):
            return f"load({s0})"
        case Halt() | Push():
            return "halt/push"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Load(_):
            return 7
        case Emit(_):
            return 7
        case Push():
            return 6
        case Drop(x0):
            return x0 * 2
        case _:
            return 1
queue = [_Push, _Push, Emit("dee"), Load("fay")]
print(_pf_str_join("; ", _pf_map(explain, queue)))
grandSum = _pf_sum_by(score, queue)
print(f"grandSum={grandSum}")
print(_pf_sort(queue))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([35, 28, 3]))
logged = []
def push2(msg):
    global logged
    logged = _pf_concat(logged, [msg])
    return len(logged)
counts = _pf_map(push2, ["start", "ada", "stop"])
print((logged, counts))
