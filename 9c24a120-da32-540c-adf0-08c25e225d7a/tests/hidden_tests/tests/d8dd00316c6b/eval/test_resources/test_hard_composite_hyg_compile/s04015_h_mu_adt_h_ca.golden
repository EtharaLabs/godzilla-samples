from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    def __repr__(self):
        return "Store"
_Store = Store()
def audit(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(audit([34, 34, 3, 30]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "jo", "stop"])
print((events, counts))
def render(t):
    match t:
        case Drop(n0):
            return f"drop({n0})"
        case Turn(1):
            return "turn-1"
        case Turn(n0):
            return f"turn({n0})"
        case Store():
            return f"store"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Turn(x0):
            return x0 * 3
        case Drop(x0):
            return x0 * 5
        case _:
            return 3
queue = [Turn(-1), Drop(-1), Drop(6), Turn(0), Turn(9)]
print(_pf_str_join(" ", _pf_map(render, queue)))
total = _pf_sum_by(cost, queue)
print(f"total={total}")
print((_pf_head(queue), _pf_last(queue)))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
visitAll(say, [3, 8, 8])
print(mapTwice(lambda x: x + 2, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 2) + maybeLog(False, 4))
def quiet(x):
    return x + 3
print(mapTwice(quiet, [5]))
