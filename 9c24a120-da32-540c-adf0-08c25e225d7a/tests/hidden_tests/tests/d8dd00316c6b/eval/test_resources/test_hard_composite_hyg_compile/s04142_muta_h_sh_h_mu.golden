from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
ticks = 0
def record(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([46, 32, 56, -1]))
doubled = _pf_map(record, [46, 32, 56, -1])
print(f"{doubled} after {ticks} calls")
def grow(n):
    return n * 3
def _pf_fn0():
    _pf_t0 = [3, 2]
    if _pf_t0:
        grow = _pf_t0[0]
        return grow + 1
    else:
        return 0
chosen = _pf_fn0()
print((chosen, grow(1)))
def inc(x):
    return x + 1
def step2(x):
    return x * 2
def pipeline2(_pf_x):
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: step2(inc(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(pipeline2, [8, 7, 5]))
def combine(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t1 = _pair
    else:
        _pf_t1 = 3
    r = _pf_t1
    return pair(r, 3)
print((combine(Some(2)), combine(_None_)))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(3, 0)
print(scan([12, 0, 36]))
events = []
def logEvent(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(logEvent, ["start", "ned", "stop"])
print((events, counts))
