    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t1 = _pair
    else:
        _pf_t1 = 3
    r = _pf_t1
    return pair(r, 2)
print((combine(Some(4)), combine(_None_)))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [7, 6, 2])
print(_pf_map(lambda g: g(1), makers))
def cross(pairs):
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
    def _pf_fn4(_pf_arg0):
        a, b = _pf_arg0
        return a * b
    return _pf_map(lambda x: x + a - b, _pf_map(_pf_fn4, pairs))
