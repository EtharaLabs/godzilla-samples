print((combine(Some(4)), combine(_None_)))
def tweak(x, flag):
    y = x * 2
    if flag:
        _y = x + 257
        _pf_t1 = _y - 1
    else:
        _pf_t1 = y
    z = _pf_t1
    return (y, z)
print((tweak(6, True), tweak(1, False)))
def outer(xs):
    def twice(x):
        return x * 2
    def go(twice):
        return twice + 1
    return _pf_map(lambda x: go(twice(x)), xs)
print(outer([9, 1, 9]))
def step1(x):
    return x + 1
def dbl(x):
    return x * 2
def both(x):
    return (lambda _pf_x: (lambda _pf_x: dbl(step1(_pf_x)))((lambda y: y - x)(_pf_x)))(x)
print(_pf_map(both, [3, 0, 1]))
def forEach(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def say(x):
    return print(f"* {x}")
forEach(say, [4, 1, 2])
print(mapTwice(lambda x: x + 4, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 4) + chatty(False, 1))
def quiet(x):
    return x + 6
print(mapTwice(quiet, [1]))
