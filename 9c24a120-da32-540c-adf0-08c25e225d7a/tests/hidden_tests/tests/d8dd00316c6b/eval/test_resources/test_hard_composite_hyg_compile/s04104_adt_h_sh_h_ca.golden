from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
_Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    _1: int
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
def render(t):
    match t:
        case Pop(n0) if n0 > 3:
            return f"pop!({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Emit():
            return f"emit"
        case Load(s0):
            return f"load({s0})"
        case Turn(n0, n1) if n0 > 5:
            return f"turn!({n0},{n1})"
        case Turn(n0, n1):
            return f"turn({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Pop(x0):
            return x0 * 5
        case Emit():
            return 3
        case _:
            return 3
stream = [_Emit, Pop(1), Pop(0), Turn(12, 5), _Emit]
print(_pf_str_join(" ", _pf_map(render, stream)))
total = _pf_sum_by(cost, stream)
print(f"total={total}")
print((_pf_head(stream), _pf_last(stream)))
def combine(o):
    def pair(a, b):
        return a + b
    if isinstance(o, Some):
        _pair = o._0
        _pf_t0 = _pair
    else:
        _pf_t0 = 1
    r = _pf_t0
