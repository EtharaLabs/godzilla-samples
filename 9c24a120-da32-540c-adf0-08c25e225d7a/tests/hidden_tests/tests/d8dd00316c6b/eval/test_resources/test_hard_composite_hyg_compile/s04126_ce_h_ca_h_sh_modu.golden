    return _pf_map(lambda x: go(twice(x)), xs)
print(wrap([3, 9, 1]))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_square(x):
    return x * x
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
