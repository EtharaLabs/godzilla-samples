print(mapTwice(quiet, [8]))
def step1(x):
    return x + 1
def dbl(x):
    return x * 2
def both(_pf_x):
    return (lambda _pf_x0: (lambda x: x + _pf_x)((lambda _pf_x: dbl(step1(_pf_x)))(_pf_x0)))(_pf_x)
print(_pf_map(both, [6, 6, 5]))
makers = _pf_map(lambda k: lambda x: x * 10 + k, [9, 1, 5])
print(_pf_map(lambda g: g(3), makers))
def cross(pairs):
    a, b = _pf_option_with_default((0, 0), _pf_head(pairs))
    b, a = (a + 1, b + 1)
