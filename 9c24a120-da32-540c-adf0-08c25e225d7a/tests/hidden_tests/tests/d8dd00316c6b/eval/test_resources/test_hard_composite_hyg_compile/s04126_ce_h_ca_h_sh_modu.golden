            v = _pf_t1._0
            _pf_t0 = _pf_str_to_int(_pf_str_strip(v))
            if isinstance(_pf_t0, Some):
                n = _pf_t0._0
                return Some(n * 5)
            else:
                return _pf_t0
        else:
            return _pf_t1
    return _pf_fn0()
inputs = ["ivy", "jo=81", "tom=47", "pam = 2", "bo", "ray=73"]
