from dataclasses import dataclass
import math
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Person:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Parked:
    _0: object
    def __repr__(self):
        return f"Parked({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(1291, 0))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(299, 125))
