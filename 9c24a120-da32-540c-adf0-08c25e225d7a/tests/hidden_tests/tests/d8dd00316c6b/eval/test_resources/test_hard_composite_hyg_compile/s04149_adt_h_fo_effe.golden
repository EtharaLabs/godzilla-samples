def replay(script):
    def fold1(acc, op):
        match acc:
            case (m, xs):
                match op:
                    case Put(k, v):
                        return (_pf_map_add(k, v, m), xs)
                    case Append(n):
                        return (m, _pf_concat(xs, [n]))
                    case Skip2():
                        return acc
                    case _:
                        raise RuntimeError("non-exhaustive match")
    m = dict()
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                m[k] = v
            case Append(n):
                xs.append(n)
            case Skip2():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    return (m, xs)
script = [Append(4), Append(5), Put("nut", 9), Put("cog", 7), Append(7), Put("nut", 8), _Skip2]
outcome = replay(script)
