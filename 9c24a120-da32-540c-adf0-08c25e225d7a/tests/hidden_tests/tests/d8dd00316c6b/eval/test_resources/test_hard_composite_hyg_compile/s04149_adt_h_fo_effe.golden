def describe(t):
    match t:
        case Skip(n0) if n0 % 2 == 0:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Push(n0) if 0 <= n0 < 8:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Emit(n0) if n0 > 1:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Drop():
            return f"drop"
        case Load(s0):
            return f"load({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Emit(x0):
            return x0
        case Drop():
            return 1
        case Load(_):
            return 1
        case Push(x0):
            return x0
        case _:
            return 2
queue = [Emit(8), Skip(9), Push(5), Emit(1), Load("gus")]
print(_pf_str_join("; ", _pf_map(describe, queue)))
