def replay(script):
    def step(xs, op):
        match op:
            case Put(k, v):
                return _pf_concat(xs, [v])
            case Append(n) if n > 1:
                return _pf_concat(xs, [n * 10])
            case _:
                return xs
    xs = []
    for op in script:
        match op:
            case Put(k, v):
                xs.append(v)
            case Append(n) if n > 1:
                _pf_t2 = n * 10
                xs.append(_pf_t2)
            case _:
                pass
    return xs
