_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
