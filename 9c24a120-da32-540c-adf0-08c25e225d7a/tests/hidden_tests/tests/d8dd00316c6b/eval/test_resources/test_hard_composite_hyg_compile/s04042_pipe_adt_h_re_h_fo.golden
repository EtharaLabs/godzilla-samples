def runAll(script):
    def step(acc, op):
        return acc
    def step(xs, op):
        match op:
            case Put(k, v):
                return _pf_concat(xs, [v])
            case Push(n) if n > 2:
                return _pf_concat(xs, [n * 10])
            case _:
                return xs
