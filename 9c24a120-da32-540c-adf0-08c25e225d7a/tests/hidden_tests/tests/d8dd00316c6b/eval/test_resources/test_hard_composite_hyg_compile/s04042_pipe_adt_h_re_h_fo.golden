def show(t):
    match t:
        case Jump(s0):
            return f"jump({s0})"
        case Turn(n0, s1) if n0 > 8:
            return f"turn!({n0},{s1})"
        case Turn(n0, s1):
            return f"turn({n0},{s1})"
        case Pop(s0):
            return f"pop({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Turn(x0, _):
            return x0
        case Jump(_):
            return 5
        case _:
            return 2
