def explain(t):
    match t:
        case Rest(s0):
            return f"rest({s0})"
        case Pop(n0, n1) if n0 % 2 == 0:
            return f"pop!({n0},{n1})"
        case Pop(n0, n1):
            return f"pop({n0},{n1})"
        case Push(n0) if n0 > 1:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Emit(s0, s1):
            return f"emit({s0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Pop(x0, x1):
            return x0 + x1
        case Emit(_, _):
            return 1
        case _:
            return 3
