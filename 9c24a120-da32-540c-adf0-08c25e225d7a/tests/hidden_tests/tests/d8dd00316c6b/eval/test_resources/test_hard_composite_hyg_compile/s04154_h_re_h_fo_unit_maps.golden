from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_map_values(m):
    return list(m.values())
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_set_union(a, b):
    return a.union(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Pilot:
    name: str
    age: int
@dataclass(frozen=True, slots=True)
class Crew:
    name: str
    size: int
@dataclass(frozen=True, slots=True, repr=False)
class Active:
    _0: object
    def __repr__(self):
        return f"Active({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Idle:
    _0: object
    def __repr__(self):
        return f"Idle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Gone:
    def __repr__(self):
        return "Gone"
_Gone = Gone()
@dataclass(frozen=True, slots=True, repr=False)
class Put:
    _0: str
    _1: int
    def __repr__(self):
        return f"Put({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Append:
    _0: int
    def __repr__(self):
        return f"Append({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
_Skip = Skip()
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Pilot(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 2:
            _pf_t1 = t
            return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [_Gone, Active(Pilot("jo", 34)), Active(Pilot("tom", 39)), Active(Pilot("cy", 45))])
print(slots)
people = [Pilot("jo", 2), Pilot("gus", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
def apply(acc, op):
    match acc:
        case (puts, total):
            match op:
                case Put(_, v):
                    return (puts + 1, total + v)
                case Append(n):
                    return (puts, total + n)
                case Skip():
                    return acc
                case _:
                    raise RuntimeError("non-exhaustive match")
def replay(script):
    return _pf_fold(apply, (0, 0), script)
ops = [Append(8), Put("gear", 9), Append(9), _Skip]
final = replay(ops)
print(final)
sumSq = _pf_fold(lambda apply, x: apply + x * x, 0, [5, 9, 9, 7])
print(sumSq)
segments = [105.8, 73.2, 201.0, 365.2, 423.2]
splits = [55.8, 60.4, 6.8, 52.5, 73.5]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = dist / dur
print(_pf_fmt_fixed(2, pace))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
log = ["fay", "ada", "bo", "eli", "bo", "fay", "eli"]
m = dict()
for w in log:
    _pf_t2 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t2
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
