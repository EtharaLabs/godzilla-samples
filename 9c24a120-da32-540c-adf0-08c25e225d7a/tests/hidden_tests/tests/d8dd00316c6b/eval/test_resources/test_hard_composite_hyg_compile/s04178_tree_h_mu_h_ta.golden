from dataclasses import dataclass
import functools
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_flip(f, x, y):
    return f(y, x)
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [6, 9, 53, 39, 42, 25, 7])
def containsOf(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsOf(k, root), [6, 8, 47]))
def sumT(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumT(l) + v + sumT(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumT(root))
def minOf(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minOf(root))
def toListT(t):
    match t:
        case Leaf():
            return []
        case Node(l, v, rt):
            return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
        case _:
            raise RuntimeError("non-exhaustive match")
print(toListT(root))
def scan(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    return f"seen={seen} best={best}"
print(scan([23, 30, 22, 38, 13]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "eli", "stop"])
print((events, counts))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def loop(n, acc):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
print(asyncio.run(_pf_run(loop(2007, 0))))
def countDigits(n, acc):
    while True:
        if n < 10:
            return acc + 1
        else:
            n, acc = (n // 10, acc + 1)
            continue
async def _pf_fn2():
    a = await loop(3, 0)
    return countDigits(a * 62082, 0)
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
