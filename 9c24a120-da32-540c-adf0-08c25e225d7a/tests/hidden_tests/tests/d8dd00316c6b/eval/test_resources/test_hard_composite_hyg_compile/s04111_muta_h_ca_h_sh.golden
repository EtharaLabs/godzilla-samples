def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
hits = 0
def note(x):
    global hits
    hits = hits + 1
    return x * 4
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-2, 54, -16, 30, 59, 18, 54, 16]))
doubled = _pf_map(note, [-2, 54, -16, 30])
print(f"{doubled} after {hits} calls")
noteTwice = lambda _pf_x: note(note(_pf_x))
print((noteTwice(3), hits))
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [8, 3, 1])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def chatty(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(chatty(True, 4) + chatty(False, 2))
def quiet(x):
    return x + 3
print(mapTwice(quiet, [5]))
def scale(n):
    return n * 2
def _pf_fn0():
    _pf_t0 = [9, 2]
    if _pf_t0:
        scale = _pf_t0[0]
        return scale + 1
    else:
        return 0
picked = _pf_fn0()
print((picked, scale(9)))
def tweak(x, flag):
    y = x * 2
    if flag:
        _y = x + 287
        _pf_t1 = _y - 1
    else:
        _pf_t1 = y
    z = _pf_t1
    return (y, z)
print((tweak(8, True), tweak(5, False)))
def lift(n):
    return n + 50
def applyLift(x):
    return lift(x)
def _pf_fn1():
    lift = 2
    return applyLift(lift)
sample = _pf_fn1()
print((sample, applyLift(2)))
