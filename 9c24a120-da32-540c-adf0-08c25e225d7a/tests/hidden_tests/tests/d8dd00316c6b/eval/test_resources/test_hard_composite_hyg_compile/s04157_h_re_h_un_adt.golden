_Mark = Mark()
def promote(s):
    match s:
        case Active(p):
            _pf_t0 = p
            return Active(Pilot(_pf_t0.name, p.age + 1))
        case Idle(t) if t.size > 2:
            _pf_t1 = t
            return Idle(Crew(_pf_str_upper(t.name), t.size - 1))
        case other:
            return other
slots = _pf_map(promote, [Active(Pilot("max", 65)), Active(Pilot("sue", 26)), Active(Pilot("pam", 55)), Active(Pilot("ned", 35)), Active(Pilot("pam", 26))])
print(slots)
people = [Pilot("ada", 5), Pilot("hal", 1)]
print((_pf_map(lambda x: x.name, people), _pf_sum_by(lambda x: x.age, people)))
span = math.hypot(2.0 / 1.0, 4.0 / 1.0) * 1.0
factor = math.sqrt(2.0)
side = math.sqrt(4.0)
vol = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, factor), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 2.0)))
def explain(t):
    match t:
        case Drop(n0) if n0 > 1:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case Push(s0):
            return f"push({s0})"
        case Turn(n0, s1):
            return f"turn({n0},{s1})"
        case Rest(n0) if n0 % 2 == 0:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Mark():
            return f"mark"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Push(_):
            return 4
        case Mark():
            return 2
        case _:
            return 3
prog = [Drop(8), Turn(-2, "pam"), Push("ada"), Drop(3), Drop(-2)]
print(_pf_str_join("; ", _pf_map(explain, prog)))
total = _pf_sum_by(score, prog)
print(f"total={total}")
print(_pf_max_by(score, prog))
