import asyncio
import math
def _pf_concat(xs, ys):
    return xs + ys
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def visitAll(f, xs):
    return _pf_iter(f, xs)
def mapTwice(f, xs):
    return _pf_map(lambda _pf_x: f(f(_pf_x)), xs)
def shout(x):
    return print(f"* {x}")
visitAll(shout, [4, 2, 7])
print(mapTwice(lambda x: x + 1, [1, 2, 3]))
def maybeLog(verbose, x):
    if verbose:
        print(f"value {x}")
        return x
    else:
        return x * 2
print(maybeLog(True, 9) + maybeLog(False, 2))
def quiet(x):
    return x + 6
print(mapTwice(quiet, [6]))
def inspect(xs):
    seen = 0
    best = 0
    def note(x):
        nonlocal best, seen
        seen = seen + 1
        best = max(best, x)
        return None
    _pf_iter(note, xs)
    def rec_count(n, acc):
        while True:
            if n == 0:
                return acc + seen
            else:
                n, acc = (n - 1, acc + best)
                continue
    return rec_count(2, 0)
print(inspect([11, 17, 19, 15]))
events = []
def push2(msg):
    global events
    events = _pf_concat(events, [msg])
    return len(events)
counts = _pf_map(push2, ["start", "cy", "stop"])
print((events, counts))
span = math.hypot(6.0 / 1.0, 3.0 / 1.0) * 1.0
ratio = math.sqrt(2.0)
side = math.sqrt(36.0)
vol = math.cbrt(8.0)
print((_pf_fmt_fixed(3, span), _pf_fmt_fixed(4, ratio), side, vol))
def velocity(d, t):
    return d / t
print(_pf_fmt_fixed(2, velocity(span, 8.0)))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countUp(n, acc):
    async def _pf_fn2():
        async def _pf_fn1():
            return n * 3
        k = await _pf_fn1()
        if n <= 0:
            return await finished(acc)
        else:
            return await countUp(n - 1, acc + k)
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(countUp(31, 0))))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(91, 266))
def accumulate(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(accumulate(2812, 0))
