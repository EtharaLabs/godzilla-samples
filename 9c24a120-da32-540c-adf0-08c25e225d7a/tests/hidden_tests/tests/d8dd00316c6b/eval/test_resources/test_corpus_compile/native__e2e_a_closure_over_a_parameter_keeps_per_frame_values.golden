def _pf_concat(xs, ys):
    return xs + ys
def _pf_map(f, xs):
    return list(map(f, xs))
def collect(n: int, acc):
    if n == 0:
        return acc
    else:
        return collect(n - 1, _pf_concat(acc, [lambda k: n]))
fns = collect(3, [])
values: list[int] = _pf_map(lambda f: f(0), fns)
