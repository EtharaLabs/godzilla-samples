import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
x: int = 100
acc = []
for e in [1, 2, 3]:
    acc.append(e)
total: list[int] = acc
doubled: list[int] = _pf_fold(lambda acc, x: _pf_concat(acc, [x * 2]), [], [1, 2, 3])
out: tuple[int, list[int], list[int]] = (x, doubled, total)
