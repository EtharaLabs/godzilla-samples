from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def bump(x):
    return x + 100
def f(xs):
    acc = dict()
    for o in xs:
        match o:
            case Some(_bump):
                acc[_bump] = 1
            case None_():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    seen = acc
    return bump(len(seen))
r = f([Some(1), _None_, Some(2)])
