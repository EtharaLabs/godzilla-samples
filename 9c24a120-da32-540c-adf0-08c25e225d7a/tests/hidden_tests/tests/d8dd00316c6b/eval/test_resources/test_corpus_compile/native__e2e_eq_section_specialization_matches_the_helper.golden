from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_find_eq(x, xs):
    try:
        return Some(xs[xs.index(x)])
    except ValueError:
        return _None_
def _pf_index_of(x, xs):
    try:
        return Some(xs.index(x))
    except ValueError:
        return _None_
a: Some | None_ = _pf_index_of(3, [1, 2, 3, 3])
b: Some | None_ = _pf_index_of(9, [1, 2, 3])
c: Some | None_ = _pf_find_eq("b", ["a", "b"])
d: Some | None_ = _pf_find_eq("z", ["a", "b"])
e: bool = 2 in [1, 2]
f: bool = 5 in [1, 2]
g: Some | None_ = _pf_index_of((1, 2), [(0, 0), (1, 2)])
h: Some | None_ = _pf_index_of(0, [])
