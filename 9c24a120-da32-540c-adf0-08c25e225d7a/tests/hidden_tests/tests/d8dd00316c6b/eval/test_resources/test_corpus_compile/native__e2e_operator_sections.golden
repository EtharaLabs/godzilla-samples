import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
mul = lambda a, b: a * b
double = lambda b: 2 * b
total: int = _pf_fold(lambda a, b: a + b, 0, [1, 2, 3, 4])
cmp: bool = (lambda a, b: a < b)(2, 3)
a: int = mul(3, 4)
b: int = double(5)
