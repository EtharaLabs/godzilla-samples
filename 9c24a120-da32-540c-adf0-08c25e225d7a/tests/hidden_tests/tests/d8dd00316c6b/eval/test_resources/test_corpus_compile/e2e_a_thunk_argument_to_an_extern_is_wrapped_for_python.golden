import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def answer(n):
    return n * 7
async def _pf_fn2():
    def _pf_fn0(_):
        return 6 * 7
    v = await asyncio.to_thread(lambda: _pf_fn0(None))
    def _pf_fn1(_):
        return answer(7)
    w = await asyncio.to_thread(lambda: _pf_fn1(None))
    return v + w
main = _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(main)))
