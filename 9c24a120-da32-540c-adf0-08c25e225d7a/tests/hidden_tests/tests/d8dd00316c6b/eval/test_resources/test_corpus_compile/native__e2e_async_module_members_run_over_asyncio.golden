        return 8
    first = await _pf_async_race([slow(7), _pf_Async(_pf_fn1)])
    _ = print(first)
    t = await _pf_async_timeout(0.001, _pf_Async(asyncio.sleep, 0.5))
    _ = print(t)
    u = await _pf_async_timeout(1.0, slow(9))
    _ = print(u)
    def _pf_fn2(_):
        return 41
    v = await _pf_async_to_thread(_pf_fn2)
    _ = print(v)
    r = await _pf_async_catch(_pf_Async(asyncio.sleep, "oops"))
    if isinstance(r, Ok):
        _pf_t0 = print("ok")
    else:
        e = r._0
        _pf_t0 = print(f"caught {e.errorKind}")
    _ = _pf_t0
