import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_set_filter(f, s):
    return set(filter(f, s))
def _pf_set_is_empty(s):
    return not s
def _pf_set_map(f, s):
    return set(map(f, s))
def _pf_set_partition(f, s):
    yes = set()
    no = set()
    for x in s:
        if f(x):
            yes.add(x)
        else:
            no.add(x)
    return (yes, no)
s = set([1, 2, 3])
e = _pf_set_is_empty(s)
m = _pf_set_map(lambda x: x * 2, s)
f = _pf_set_filter(lambda x: x > 1, s)
t = _pf_fold(lambda acc, x: acc + x, 0, s)
p = _pf_set_partition(lambda x: x > 1, s)
