import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
xs: list[int] = [1, 2, 3, 4]
doubled: list[int] = _pf_map(lambda x: x * 2, xs)
small: list[int] = _pf_filter(lambda x: x < 3, xs)
total: int = _pf_fold(lambda a, b: a + b, 0, xs)
n: int = len(xs)
s: int = sum(xs)
r: list[int] = _pf_rev(xs)
q: list[int] = _pf_range(1, 4)
