from dataclasses import dataclass
from typing import Any
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
s: list[int] = list(_pf_seq_take(1, _pf_seq_unfold(lambda n: Some((n, n)), 0)))
