from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
m = _pf_max([3, 1])
s = _pf_sort_desc([3, 1])
