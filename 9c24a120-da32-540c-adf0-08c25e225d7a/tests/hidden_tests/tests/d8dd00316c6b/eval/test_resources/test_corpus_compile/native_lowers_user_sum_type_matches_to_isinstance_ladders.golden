from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Dot:
    def __repr__(self):
        return "Dot"
_Dot = Dot()
def describe(s):
    match s:
        case Circle(r) if r > 10.0:
            return "big circle"
        case Circle(r):
            return f"circle {r}"
        case Rect(w, h):
            return f"rect {w * h}"
        case Dot():
            return "dot"
        case _:
            raise RuntimeError("non-exhaustive match")
print(describe(Circle(20.0)))
print(describe(Circle(1.5)))
print(describe(Rect(2.0, 3.0)))
print(describe(_Dot))
