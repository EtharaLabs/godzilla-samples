from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True)
class Box:
    item: object
    tag: bool
def f(b):
    match b:
        case Box(item=Some(n), tag=True):
            return n
        case Box(item=Some(n)):
            return n + 100
        case _:
            return 0
a = f(Box(Some(5), True))
b = f(Box(Some(5), False))
c = f(Box(_None_, True))
