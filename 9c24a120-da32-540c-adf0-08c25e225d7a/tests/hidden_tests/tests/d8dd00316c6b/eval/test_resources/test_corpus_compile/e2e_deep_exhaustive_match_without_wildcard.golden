from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def f(o):
    match o:
        case Some(True):
            return 1
        case Some(False):
            return 2
        case None_():
            return 3
        case _:
            raise RuntimeError("non-exhaustive match")
a = f(Some(True))
b = f(Some(False))
c = f(_None_)
