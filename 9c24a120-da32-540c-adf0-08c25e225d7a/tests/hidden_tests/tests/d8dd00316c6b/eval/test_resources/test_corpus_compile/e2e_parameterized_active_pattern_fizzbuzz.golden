def _ap_DivisibleBy(d, n):
    return n % d == 0
def fizz(n):
    _pf_t0 = _ap_DivisibleBy(15, n)
    _pf_t1 = _ap_DivisibleBy(3, n)
    _pf_t2 = _ap_DivisibleBy(5, n)
    if _pf_t0:
        return "fizzbuzz"
    elif _pf_t1:
        return "fizz"
    elif _pf_t2:
        return "buzz"
    else:
        return str(n)
a = fizz(15)
b = fizz(9)
c = fizz(10)
d = fizz(7)
