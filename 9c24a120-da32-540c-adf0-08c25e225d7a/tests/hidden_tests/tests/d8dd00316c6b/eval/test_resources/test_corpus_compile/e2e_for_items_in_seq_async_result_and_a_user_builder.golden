from dataclasses import dataclass
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_concat(xs, ys):
    return xs + ys
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def Html_yield_(n):
    return [n]
def Html_combine(a, b):
    return _pf_concat(a, b)
def Html_delay(f):
    return f(None)
def Html_for_(xs, f):
    return _pf_collect(f, xs)
def page(rows):
    return Html_combine(Html_yield_("h1"), Html_delay(lambda _: Html_combine(Html_for_(rows, lambda r: Html_yield_(f"tr {r}")), Html_delay(lambda _: Html_yield_("p")))))
print(page(["a", "b"]))
def _pf_fn0():
    for x in [1, 2, 3]:
        y = x * x
        yield y
    yield 100
squares = _pf_fn0()
print(list(squares))
def _pf_fn1():
    for x in [1, 2]:
        for y in iter([10, 20]):
            yield x + y
nested = _pf_fn1()
print(list(nested))
def _pf_fn2():
    for (a, b) in [(1, 2), (3, 4)]:
        yield a + b
pairs = _pf_fn2()
print(list(pairs))
def check(x):
    if x > 0:
        return Ok(x)
    else:
        return Error(f"bad {x}")
def allGood(xs):
    def _pf_fn3():
        for x in xs:
            _pf_t0 = check(x)
            if isinstance(_pf_t0, Ok):
                _ = _pf_t0._0
            else:
                return _pf_t0
        return Ok("all positive")
    return _pf_fn3()
print(allGood([1, 2, 3]))
print(allGood([1, -2, 3]))
async def _pf_fn4():
    for n in [1, 2]:
        await asyncio.sleep(0.001)
        _ = print(n)
    return None
main = _pf_Async(_pf_fn4)
asyncio.run(_pf_run(main))
