from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: float
    def __repr__(self):
        return f"Square({self._0!r})"
@dataclass(frozen=True, slots=True)
class Point:
    x: int
    y: int
def area(s):
    match s:
        case Circle(r):
            return 3.0 * r * r
        case Square(w):
            return w * w
        case _:
            raise RuntimeError("non-exhaustive match")
def shift(p, dx):
    _pf_t0 = p
    return Point(p.x + dx, _pf_t0.y)
def names(xs):
    return _pf_map(lambda s: _pf_str_upper(s), xs)
def first(xs):
    return _pf_head(xs)
def apply(f, x):
    return f(x)
print(area(Square(2.0)))
print(shift(Point(1, 2), 3).x)
print(names(["a"]))
print(first([1]))
print(apply(lambda n: n + 1, 1))
