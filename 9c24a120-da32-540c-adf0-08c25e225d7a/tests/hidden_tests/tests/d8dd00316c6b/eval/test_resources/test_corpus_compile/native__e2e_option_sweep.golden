from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_opt_exists(f, o):
    return isinstance(o, Some) and f(o._0)
def _pf_opt_flatten(o):
    return o._0 if isinstance(o, Some) else _None_
def _pf_opt_map2(f, a, b):
    if isinstance(a, Some) and isinstance(b, Some):
        return Some(f(a._0, b._0))
    return _None_
def _pf_opt_or_else(fallback, o):
    return o if isinstance(o, Some) else fallback
def _pf_opt_to_list(o):
    return [o._0] if isinstance(o, Some) else []
some1: Some | None_ = Some(1)
some2: Some | None_ = Some(2)
none: Some | None_ = _pf_head(_pf_drop(9, [1]))
both: Some | None_ = _pf_opt_map2(lambda a, b: a + b, some1, some2)
missing: Some | None_ = _pf_opt_map2(lambda a, b: a + b, some1, none)
kept: Some | None_ = _pf_opt_or_else(some2, some1)
fellBack: Some | None_ = _pf_opt_or_else(some2, none)
flat: Some | None_ = _pf_opt_flatten(Some(Some(5)))
flatNone: Some | None_ = _pf_opt_flatten(Some(none))
listed: list[int] = _pf_opt_to_list(some1)
empty: list[int] = _pf_opt_to_list(none)
holds: bool = _pf_opt_exists(lambda x: x > 0, some1)
holdsNot: bool = _pf_opt_exists(lambda x: x > 0, none)
