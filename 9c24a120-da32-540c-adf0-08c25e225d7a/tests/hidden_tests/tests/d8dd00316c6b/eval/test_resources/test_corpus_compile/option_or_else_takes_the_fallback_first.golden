from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_opt_or_else(fallback, o):
    return o if isinstance(o, Some) else fallback
s = _pf_opt_or_else(Some(2), Some(1))
