from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_split_at(n, xs):
    m = max(n, 0)
    return (xs[0:m], xs[m:len(xs)])
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_tail(xs):
    return Some(xs[1:len(xs)]) if xs else _None_
xs = [3, 1, 4, 1, 5]
first = _pf_head(xs)
none = _pf_head(_pf_drop(9, [1]))
rest = _pf_tail(xs)
taken = _pf_take(2, xs)
dropped = _pf_drop(3, xs)
overTake = _pf_take(99, xs)
negTake = _pf_take(-1, xs)
split = _pf_split_at(2, xs)
