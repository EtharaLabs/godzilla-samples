def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def build(steps):
    def add(m, _pf_arg1):
        p, l = _pf_arg1
        return _pf_map_add(p, l, m)
    m = dict()
    for (p, l) in steps:
        m[p] = l
    return m
out: list[tuple[int, str]] = _pf_map_to_list(build([(1, "x"), (2, "y")]))
