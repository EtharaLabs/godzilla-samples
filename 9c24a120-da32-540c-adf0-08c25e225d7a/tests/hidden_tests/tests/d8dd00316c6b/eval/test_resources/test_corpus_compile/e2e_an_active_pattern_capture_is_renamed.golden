from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _ap_Positive(n):
    if n > 0:
        return Some(n)
    else:
        return _None_
def f(p, n):
    _pf_t1 = _ap_Positive(n)
    if isinstance(_pf_t1, Some):
        _p = _pf_t1._0
        _pf_t0 = _p * 2
    else:
        _pf_t0 = 0
    label = _pf_t0
    return label + p
r = f(1000, 5)
s = f(1000, 0)
