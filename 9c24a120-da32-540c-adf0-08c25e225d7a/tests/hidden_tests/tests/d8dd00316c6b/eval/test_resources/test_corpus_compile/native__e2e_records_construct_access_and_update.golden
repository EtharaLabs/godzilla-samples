from dataclasses import dataclass
@dataclass(frozen=True, slots=True)
class Point:
    x: int
    y: int
p: Point = Point(3, 4)
_pf_t0 = p
moved: Point = Point(10, _pf_t0.y)
sx: int = p.x
sy: int = moved.y
mx: int = moved.x
def sumxy(r: Point) -> int:
    return r.x + r.y
total: int = sumxy(p)
