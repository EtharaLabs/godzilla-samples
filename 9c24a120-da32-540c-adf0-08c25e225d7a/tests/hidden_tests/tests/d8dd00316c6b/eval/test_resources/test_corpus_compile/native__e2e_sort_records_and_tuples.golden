from dataclasses import dataclass
def _pf_sort(xs):
    return sorted(xs)
@dataclass(frozen=True, slots=True, order=True)
class Point:
    x: int
    y: int
pts: list[Point] = _pf_sort([Point(2, 0), Point(1, 9), Point(1, 3)])
tups: list[tuple[int, int]] = _pf_sort([(1, 3), (1, 2), (0, 9)])
