from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Nil:
    def __repr__(self):
        return "Nil"
_Nil = Nil()
@dataclass(frozen=True, slots=True, repr=False)
class Cons:
    _0: object
    _1: object
    def __repr__(self):
        return f"Cons({self._0!r}, {self._1!r})"
def head(d, xs):
    match xs:
        case Nil():
            return d
        case Cons(h, t):
            return h
        case _:
            raise RuntimeError("non-exhaustive match")
r = head(0, Cons(7, Cons(8, _Nil)))
