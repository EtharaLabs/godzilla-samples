def f(xs):
    match xs:
        case [] | [_]:
            return "short"
        case [a, b]:
            return f"pair {a}{b}"
        case [a, *mid, z]:
            return f"{a}..{z} with {len(mid)} inside"
        case _:
            raise RuntimeError("non-exhaustive match")
def g(n):
    match n:
        case 1 | 2 | 3:
            return "small"
        case _:
            return "big"
print(f([]))
print(f([7]))
print(f([1, 2]))
print(f([1, 2, 3, 4]))
print(g(2))
print(g(9))
