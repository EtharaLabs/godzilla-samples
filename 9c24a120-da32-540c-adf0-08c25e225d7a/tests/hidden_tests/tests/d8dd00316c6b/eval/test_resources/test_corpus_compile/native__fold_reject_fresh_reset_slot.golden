import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def rf(acc, x: int):
    m = acc[0]
    n = acc[1]
    if x == 0:
        return (dict(), n)
    else:
        return (_pf_map_add(x, x, m), n)
_pf_t1 = _pf_fold(rf, (dict(), 0), [0, 1, 2])
m = _pf_t1[0]
n = _pf_t1[1]
_pf_t0 = (_pf_map_to_list(m), n)
