from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_slice(start, end, s):
    return s[start:end]
s = "hello world"
a = _pf_str_slice(0, 5, s)
b = _pf_str_slice(6, 100, s)
c = _pf_option_with_default(0 - 1, _pf_str_index_of("world", s))
d = _pf_option_with_default(0 - 1, _pf_str_index_of("zzz", s))
