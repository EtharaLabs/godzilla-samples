import functools
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def f(n: int) -> list[int]:
    def go(acc: int, k: int) -> list[int]:
        if k == 0:
            return [acc]
        else:
            return _pf_collect(functools.partial(go, acc + 1), [k - 1])
    return go(0, n)
r: list[int] = f(3)
