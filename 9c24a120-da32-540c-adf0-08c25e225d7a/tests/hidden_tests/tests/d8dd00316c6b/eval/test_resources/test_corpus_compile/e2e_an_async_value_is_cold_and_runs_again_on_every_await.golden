import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
def _pf_async_parallel(xs):
    async def run():
        return list(await asyncio.gather(*map(_pf_run, xs)))
    return _pf_Async(run)
async def _pf_run(a):
    return await a
async def _pf_fn0():
    _ = print("run")
    return 1
job = _pf_Async(_pf_fn0)
print("built")
async def _pf_fn1():
    a = await job
    b = await job
    both = await _pf_async_parallel([job, job])
    return a + b + sum(both)
twice = _pf_Async(_pf_fn1)
print(asyncio.run(_pf_run(twice)))
