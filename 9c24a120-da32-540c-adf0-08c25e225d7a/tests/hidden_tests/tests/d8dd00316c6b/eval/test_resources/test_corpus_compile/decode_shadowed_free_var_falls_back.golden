from dataclasses import dataclass
import json
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_dec_decode_string(dec, s):
    try:
        return Ok(dec(json.loads(s)))
    except Exception as e:
        return Error(_Exception(type(e).__name__, str(e)))
def _pf_dec_int(v):
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    raise ValueError("expected an int, got " + type(v).__name__)
def _pf_dec_map(f, dec):
    def go(v):
        return f(dec(v))
    return go
def bump(n):
    return n + 100
dec = _pf_dec_map(lambda x: bump(x), _pf_dec_int)
def run(u):
    bump = 0
    r = _pf_dec_decode_string(dec, "5")
    if isinstance(r, Ok):
        v = r._0
        return f"ok: {v} ({bump})"
    else:
        e = r._0
        return e.errorKind
useIt = run(0)
