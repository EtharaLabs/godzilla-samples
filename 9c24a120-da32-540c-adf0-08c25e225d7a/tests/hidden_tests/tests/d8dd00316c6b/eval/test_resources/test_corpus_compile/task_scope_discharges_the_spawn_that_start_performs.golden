import asyncio
import contextvars
_pf_scope = contextvars.ContextVar("_pf_scope")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def _pf_task_scope(body):
    async def run():
        async def scoped():
            async with asyncio.TaskGroup() as tg:
                _pf_scope.set(tg)
                return await body
        return await asyncio.create_task(scoped())
    return _pf_Async(run)
def _pf_task_start(c):
    _pf_scope.get().create_task(_pf_run(c))
    return None
async def _pf_fn0():
    await asyncio.sleep(0.01)
worker = _pf_Async(_pf_fn0)
def launch(w):
    return _pf_task_start(w)
async def _pf_fn1():
    _ = _pf_task_start(worker)
    _ = launch(worker)
    return 1
session = _pf_task_scope(_pf_Async(_pf_fn1))
