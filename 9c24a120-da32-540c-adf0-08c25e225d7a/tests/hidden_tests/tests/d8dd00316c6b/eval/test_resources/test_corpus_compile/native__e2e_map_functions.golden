from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_remove(k, m):
    r = dict(m)
    r.pop(k, None)
    return r
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
m: dict[str, int] = _pf_map_add("a", 1, _pf_map_add("b", 2, dict()))
found: int = _pf_map_find_or("a", 0, m)
dflt: int = _pf_map_find_or("z", 99, m)
sz: int = len(m)
mc: bool = "b" in m
rm: int = len(_pf_map_remove("b", m))
ks: int = len(_pf_map_keys(m))
hit: int = _pf_option_with_default(0, _pf_map_try_find("a", m))
miss: int = _pf_option_with_default(0, _pf_map_try_find("z", m))
