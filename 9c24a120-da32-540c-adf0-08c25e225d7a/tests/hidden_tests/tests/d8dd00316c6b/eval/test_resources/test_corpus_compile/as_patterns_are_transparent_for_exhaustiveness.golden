from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
def f(s):
    match s:
        case Circle(r) as w:
            return r
        case Rect(a, b) as w:
            return a
        case _:
            raise RuntimeError("non-exhaustive match")
