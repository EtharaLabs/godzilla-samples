def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_insert_at(i, v, xs):
    out = list(xs)
    out.insert(max(i, 0), v)
    return out
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_remove_at(i, xs):
    out = list(xs)
    if 0 <= i < len(out):
        out.pop(i)
    return out
def _pf_update_at(i, v, xs):
    out = list(xs)
    if 0 <= i < len(out):
        out[i] = v
    return out
def _pf_windowed(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(len(xs) - n + 1):
        out.append(xs[i:i + n])
    return out
u = _pf_update_at(0, 9, [1, 2])
i = _pf_insert_at(0, 9, [1, 2])
r = _pf_remove_at(0, [1, 2])
p = _pf_pairwise([1, 2, 3])
w = _pf_windowed(2, [1, 2, 3])
c = _pf_chunk(2, [1, 2, 3])
