from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
print(1 < 2)
print("a" < "b")
print(3 == 3)
print(Some(1) == Some(1))
print(Some(1) == Some(2))
