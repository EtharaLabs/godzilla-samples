import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
xs = [1, 2, 3]
ys = _pf_map(lambda x: x + 1, xs)
zs = _pf_filter(lambda x: x < 2, xs)
t = _pf_fold(lambda a, b: a + b, 0, xs)
n = len(xs)
s = sum(xs)
r = _pf_rev(xs)
q = _pf_range(0, 5)
