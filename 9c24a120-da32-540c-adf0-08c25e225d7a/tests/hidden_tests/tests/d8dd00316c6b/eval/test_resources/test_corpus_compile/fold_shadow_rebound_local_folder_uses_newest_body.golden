def _pf_concat(xs, ys):
    return xs + ys
def build(xs):
    def step(acc, x):
        return _pf_concat(acc, [x + 100])
    def step(acc, x):
        return _pf_concat(acc, [x * 2])
    acc = []
    for x in xs:
        _pf_t0 = x * 2
        acc.append(_pf_t0)
    return acc
out = build([1, 2, 3])
