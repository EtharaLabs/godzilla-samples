from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def report(o: Some | None_):
    if isinstance(o, Some):
        n = o._0
        print(n)
    else:
        print("none")
    return print("done")
report(Some(1))
