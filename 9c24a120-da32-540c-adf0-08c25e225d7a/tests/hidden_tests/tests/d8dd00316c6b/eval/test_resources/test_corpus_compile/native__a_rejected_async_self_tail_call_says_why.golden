def _pf_concat(xs, ys):
    return xs + ys
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def collect(n: int, acc):
    async def _pf_fn1():
        if n == 0:
            return await finished(acc)
        else:
            return await collect(n - 1, _pf_concat(acc, [lambda k: n]))
    return _pf_Async(_pf_fn1)
