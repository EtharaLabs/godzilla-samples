from dataclasses import dataclass
@dataclass(frozen=True, slots=True)
class Point:
    x: int
    y: int
def f(y: int, p: Point, q: tuple[int, int]) -> int:
    if isinstance(p, Point) and p.x == 0:
        _y = p.y
        _pf_t0 = _y
    else:
        x = p.x
        _pf_t0 = x + y
    a = _pf_t0
    if q[0] == 0:
        _y2 = q[1]
        _pf_t1 = _y2
    elif q[1] == 0:
        _y3 = q[0]
        _pf_t1 = _y3
    else:
        _pf_t1 = y
    b = _pf_t1
    return a + b
r: int = f(1000, Point(0, 2), (0, 3))
s: int = f(1000, Point(4, 2), (7, 8))
