from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True)
class P:
    name: str
    age: int
ps = [P("a", 2)]
byAge = _pf_sort_by(lambda p: p.age, ps)
oldest = _pf_max_by(lambda p: p.age, ps)
