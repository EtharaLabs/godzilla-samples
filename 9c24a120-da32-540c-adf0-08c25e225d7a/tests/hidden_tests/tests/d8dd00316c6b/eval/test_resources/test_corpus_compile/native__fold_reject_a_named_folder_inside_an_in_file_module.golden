import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def step(m, x):
    return _pf_map_add(x, x, m)
def M_scan(xs):
    return _pf_fold(step, dict(), xs)
r: int = len(M_scan([1, 2, 3]))
