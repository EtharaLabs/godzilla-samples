import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
x = 100
acc = []
for e in [1, 2, 3]:
    acc.append(e)
total = acc
doubled = _pf_fold(lambda acc, x: _pf_concat(acc, [x * 2]), [], [1, 2, 3])
out = (x, doubled, total)
