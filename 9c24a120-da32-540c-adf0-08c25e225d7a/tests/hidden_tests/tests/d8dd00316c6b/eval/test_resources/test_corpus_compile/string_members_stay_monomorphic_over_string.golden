def _pf_str_is_empty(s):
    return not s
def _pf_str_repeat(n, s):
    return s * max(n, 0)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split_lines(s):
    return s.splitlines()
def _pf_str_trim_end(s):
    return s.rstrip()
def _pf_str_trim_start(s):
    return s.lstrip()
e = _pf_str_is_empty("")
r = _pf_str_repeat(2, "ab")
a = _pf_str_trim_start(" x")
b = _pf_str_trim_end("x ")
l = _pf_str_split_lines("a")
v = _pf_str_rev("abc")
