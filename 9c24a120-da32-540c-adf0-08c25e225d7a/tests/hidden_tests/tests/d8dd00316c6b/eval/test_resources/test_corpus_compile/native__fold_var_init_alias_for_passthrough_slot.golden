from typing import Any
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def step(acc, x):
    m = acc[0]
    keep = acc[1]
    return (_pf_map_add(x, x, m), keep)
seed: dict[Any, Any] = dict()
seed2: dict[Any, Any] = dict()
