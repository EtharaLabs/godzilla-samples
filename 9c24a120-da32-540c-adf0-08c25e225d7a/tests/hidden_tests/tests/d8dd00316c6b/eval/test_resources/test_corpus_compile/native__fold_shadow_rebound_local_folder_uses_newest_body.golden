def _pf_concat(xs, ys):
    return xs + ys
def build(xs: list[int]) -> list[int]:
    def step(acc: list[int], x: int) -> list[int]:
        return _pf_concat(acc, [x + 100])
    def step(acc: list[int], x: int) -> list[int]:
        return _pf_concat(acc, [x * 2])
    acc = []
    for x in xs:
        _pf_t0 = x * 2
        acc.append(_pf_t0)
    return acc
out: list[int] = build([1, 2, 3])
