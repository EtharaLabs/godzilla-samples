from dataclasses import dataclass
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
@dataclass(frozen=True, slots=True, repr=False)
class Go:
    _0: int
    def __repr__(self):
        return f"Go({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Stop:
    def __repr__(self):
        return "Stop"
_Stop = Stop()
def finished(n):
    async def _pf_fn0():
        return n
    return _pf_Async(_pf_fn0)
def loop(n):
    async def _pf_fn1(n):
        while True:
            match n:
                case Go(k):
                    n = _Stop
                    continue
                case Stop():
                    return await finished(0)
                case _:
                    raise RuntimeError("non-exhaustive match")
    return _pf_Async(_pf_fn1, n)
