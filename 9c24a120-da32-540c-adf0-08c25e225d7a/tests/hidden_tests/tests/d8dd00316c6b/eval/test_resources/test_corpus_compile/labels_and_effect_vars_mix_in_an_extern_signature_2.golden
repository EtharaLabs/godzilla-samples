import mymod
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
r = _pf_Async(mymod.gather, lambda x: x, [1, 2])
