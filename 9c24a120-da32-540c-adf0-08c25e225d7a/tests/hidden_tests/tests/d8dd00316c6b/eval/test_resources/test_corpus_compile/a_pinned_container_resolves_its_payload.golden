from dataclasses import dataclass
@dataclass(frozen=True, slots=True)
class Placed:
    row: int
    letter: str
@dataclass(frozen=True, slots=True)
class Cell:
    row: int
    letter: str
    blank: bool
board = dict([(1, Placed(1, "A"))])
def at(k):
    if k in board:
        p = board[k]
        return p.letter
    else:
        return ""
