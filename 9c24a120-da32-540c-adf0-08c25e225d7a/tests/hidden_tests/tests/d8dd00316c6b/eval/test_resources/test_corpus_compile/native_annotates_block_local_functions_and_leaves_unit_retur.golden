from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: float
    def __repr__(self):
        return f"Square({self._0!r})"
def total(shapes):
    def area(s):
        match s:
            case Circle(r):
                return 3.0 * r * r
            case Square(w):
                return w * w
            case _:
                raise RuntimeError("non-exhaustive match")
    def add(acc, s):
        return acc + area(s)
    return _pf_fold(add, 0.0, shapes)
def report(n):
    return print(n + 0.0)
report(total([Circle(1.0), Square(2.0)]))
