from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def _pf_res_map2(f, a, b):
    if isinstance(a, Error):
        return a
    if isinstance(b, Error):
        return b
    return Ok(f(a._0, b._0))
def _pf_res_or_else(fallback, r):
    return r if isinstance(r, Ok) else fallback
def _pf_res_to_list(r):
    return [r._0] if isinstance(r, Ok) else []
ok1 = Ok(1)
ok2 = Ok(2)
bad = Error("boom")
both = _pf_res_map2(lambda a, b: a + b, ok1, ok2)
failed = _pf_res_map2(lambda a, b: a + b, bad, ok2)
kept = _pf_res_or_else(ok2, ok1)
fellBack = _pf_res_or_else(ok2, bad)
listed = _pf_res_to_list(ok1)
empty = _pf_res_to_list(bad)
