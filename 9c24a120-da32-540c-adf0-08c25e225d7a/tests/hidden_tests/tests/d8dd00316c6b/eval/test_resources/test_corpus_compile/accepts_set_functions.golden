def _pf_set_add(x, s):
    return s.union([x])
def _pf_set_difference(a, b):
    return a.difference(b)
def _pf_set_intersect(a, b):
    return a.intersection(b)
def _pf_set_remove(x, s):
    return s.difference([x])
def _pf_set_union(a, b):
    return a.union(b)
