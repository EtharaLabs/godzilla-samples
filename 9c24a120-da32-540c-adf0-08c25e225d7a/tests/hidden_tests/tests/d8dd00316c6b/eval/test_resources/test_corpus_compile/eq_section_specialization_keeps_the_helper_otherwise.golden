from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_find_index(f, xs):
    for p in enumerate(xs):
        if f(p[1]):
            return Some(p[0])
    return _None_
def p(l):
    return functools.partial(_pf_find_index, lambda b: l == b)
def q(l, rack):
    return _pf_find_index(lambda y: y > l, rack)
def r(rack):
    return _pf_find_index(lambda y: y == y, rack)
def s(l, rack):
    return _pf_exists(lambda l: l == l, rack)
