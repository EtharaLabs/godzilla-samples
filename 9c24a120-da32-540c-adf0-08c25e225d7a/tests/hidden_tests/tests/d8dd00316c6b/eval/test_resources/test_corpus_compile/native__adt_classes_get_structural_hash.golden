from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Red:
    def __repr__(self):
        return "Red"
_Red: Red = Red()
@dataclass(frozen=True, slots=True, repr=False)
class Green:
    def __repr__(self):
        return "Green"
_Green: Green = Green()
@dataclass(frozen=True, slots=True, repr=False)
class Blue:
    def __repr__(self):
        return "Blue"
_Blue: Blue = Blue()
Color = Red | Green | Blue
s: set[Color] = set([_Red, _Red, _Green])
n: int = len(s)
hasRed: bool = _Red in s
hasBlue: bool = _Blue in s
