from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_option_bind(f, o):
    if isinstance(o, Some):
        return f(o._0)
    return _None_
r = _pf_option_bind(lambda x: Some(x + 1), Some(1))
