from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Empty:
    def __repr__(self):
        return "Empty"
_Empty: Empty = Empty()
@dataclass(frozen=True, slots=True, repr=False)
class Has:
    _0: Any
    def __repr__(self):
        return f"Has({self._0!r})"
