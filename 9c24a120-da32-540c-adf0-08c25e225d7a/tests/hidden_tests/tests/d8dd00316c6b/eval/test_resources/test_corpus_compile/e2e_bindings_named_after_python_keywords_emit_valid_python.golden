from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True)
class P:
    lambda_: int
def f(class_):
    return class_ + 1
def g(o):
    if isinstance(o, Some):
        def_ = o._0
        return def_
    else:
        return 0
h = _pf_map(lambda global_: global_ + 1, [1])
def k(n):
    pass_ = n + 1
    return pass_ * 2
p = P(7)
print(f(1))
print(g(Some(3)))
print(h)
print(k(3))
print(p.lambda_)
