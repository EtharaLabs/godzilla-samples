from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
def _pf_opt_contains(x, o):
    return isinstance(o, Some) and o._0 == x
def _pf_opt_forall(f, o):
    return not isinstance(o, Some) or f(o._0)
def _pf_res_contains(x, r):
    return isinstance(r, Ok) and r._0 == x
def _pf_seq_distinct_by(f, xs):
    seen = set()
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            yield x
def _pf_seq_get(i, xs):
    return next(map(Some, itertools.islice(xs, max(i, 0), None)), _None_)
def _pf_seq_last(xs):
    out = _None_
    for x in xs:
        out = Some(x)
    return out
def _pf_seq_max(xs):
    items = list(xs)
    return Some(max(items)) if items else _None_
def _pf_seq_min(xs):
    items = list(xs)
    return Some(min(items)) if items else _None_
def _pf_seq_reduce(f, xs):
    items = list(xs)
    return Some(functools.reduce(f, items)) if items else _None_
def _pf_seq_replicate(n, x):
    return itertools.repeat(x, max(n, 0))
def _pf_seq_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_sign(x):
    return (x > 0) - (x < 0)
xs = [1, 2, 3, 1, 2]
taken = _pf_take_while(lambda x: x < 3, xs)
dropped = _pf_drop_while(lambda x: x < 3, xs)
desc = _pf_sort_by_desc(lambda x: x, xs)
counted = _pf_count_by(lambda x: x % 2, xs)
uniqBy = list(_pf_seq_distinct_by(lambda x: x % 2, iter(xs)))
copies = list(_pf_seq_replicate(3, "a"))
none = list(iter([]))
at = _pf_seq_get(2, iter(xs))
final = _pf_seq_last(iter(xs))
doubled = _pf_seq_sum_by(lambda x: x * 2, iter(xs))
biggest = _pf_seq_max(iter(xs))
smallest = _pf_seq_min(iter(xs))
joined = _pf_seq_reduce(lambda a, b: a + b, iter(xs))
holds = _pf_opt_forall(lambda x: x > 0, Some(1))
has = _pf_opt_contains(1, Some(1))
okHas = _pf_res_contains(1, Ok(1))
negative = _pf_sign(-5)
zero = _pf_sign(0)
positive = _pf_sign(42)
