from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def f(x: int, o: Some | None_, p: Some | None_) -> int:
    if isinstance(o, Some):
        _x = o._0
        if isinstance(p, Some):
            _x2 = p._0
            _pf_t0 = _x2 * 10
        else:
            _pf_t0 = _x
        inner = _pf_t0
        return inner + _x
    else:
        return x
r: int = f(1, Some(2), Some(3))
