from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
@dataclass(frozen=True, slots=True, repr=False)
class Red:
    def __repr__(self):
        return "Red"
_Red = Red()
@dataclass(frozen=True, slots=True, repr=False)
class Green:
    def __repr__(self):
        return "Green"
_Green = Green()
@dataclass(frozen=True, slots=True, repr=False)
class Blue:
    def __repr__(self):
        return "Blue"
_Blue = Blue()
@dataclass(frozen=True, slots=True)
class Point:
    x: int
    y: int
cs = set([_Red, _Green, _Red, _Blue])
ncolors = len(cs)
hasGreen = _Green in cs
m = _pf_map_add(Some(1), "one", dict())
v = _pf_option_with_default("?", _pf_map_try_find(Some(1), m))
pts = set([Point(1, 2), Point(1, 2), Point(3, 4)])
npts = len(pts)
