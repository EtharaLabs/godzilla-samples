import functools
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_const(x, y):
    return x
def _pf_flip(f, x, y):
    return f(y, x)
def _pf_id(x):
    return x
def sub(a, b):
    return a - b
i = _pf_id(42)
k = _pf_const(7, "ignored")
f = _pf_flip(sub, 3, 10)
mapped = _pf_map(functools.partial(_pf_const, 0), [1, 2, 3])
identity = _pf_map(_pf_id, [4, 5, 6])
flipped = _pf_map(functools.partial(_pf_flip, sub, 100), [1, 2])
