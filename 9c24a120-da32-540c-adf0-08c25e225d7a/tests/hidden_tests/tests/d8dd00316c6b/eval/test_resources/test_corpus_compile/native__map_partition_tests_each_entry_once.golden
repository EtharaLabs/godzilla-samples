def _pf_map_partition(f, m):
    yes = dict()
    no = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            yes[kv[0]] = kv[1]
        else:
            no[kv[0]] = kv[1]
    return (yes, no)
m: dict[int, str] = dict([(1, "a")])
p: tuple[dict[int, str], dict[int, str]] = _pf_map_partition(lambda k, v: k > 0, m)
