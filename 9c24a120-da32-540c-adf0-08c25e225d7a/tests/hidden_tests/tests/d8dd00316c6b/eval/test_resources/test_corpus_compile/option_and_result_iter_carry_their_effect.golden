from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_opt_iter(f, o):
    if isinstance(o, Some):
        f(o._0)
    return None
go = _pf_opt_iter(lambda x: print(x), Some(1))
