import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def cap(acc, x):
    match acc:
        case (m, fs):
            return (_pf_map_add(x, x, m), _pf_concat(fs, [lambda u: len(m)]))
match _pf_fold(cap, (dict(), []), [1, 2]):
    case (m, fs):
        _pf_t0 = _pf_map(lambda f: f(0), fs)
out = _pf_t0
