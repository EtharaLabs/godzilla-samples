from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Across:
    def __repr__(self):
        return "Across"
_Across = Across()
@dataclass(frozen=True, slots=True, repr=False)
class Down:
    def __repr__(self):
        return "Down"
_Down = Down()
d = _Across
ds = [_Down, _Down]
