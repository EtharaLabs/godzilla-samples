import itertools
def _pf_seq_collect(f, xs):
    return itertools.chain.from_iterable(map(f, xs))
def _pf_seq_concat(xs, ys):
    return itertools.chain(xs, ys)
def _pf_seq_distinct(xs):
    seen = set()
    for x in xs:
        if not x in seen:
            seen.add(x)
            yield x
def _pf_seq_drop(n, xs):
    return itertools.islice(xs, max(n, 0), None)
def _pf_seq_drop_while(f, xs):
    return itertools.dropwhile(f, xs)
def _pf_seq_flatten(xs):
    return itertools.chain.from_iterable(xs)
def _pf_seq_init(n, f):
    return map(f, range(max(n, 0)))
def _pf_seq_pairwise(xs):
    return itertools.pairwise(xs)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
