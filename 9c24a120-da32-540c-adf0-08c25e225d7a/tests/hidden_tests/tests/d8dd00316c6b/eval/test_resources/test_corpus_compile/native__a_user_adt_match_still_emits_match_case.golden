from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Across:
    def __repr__(self):
        return "Across"
_Across: Across = Across()
@dataclass(frozen=True, slots=True, repr=False)
class Down:
    def __repr__(self):
        return "Down"
_Down: Down = Down()
Dir = Across | Down
def delta(d: Dir) -> tuple[int, int]:
    if isinstance(d, Across):
        return (0, 1)
    else:
        return (1, 0)
