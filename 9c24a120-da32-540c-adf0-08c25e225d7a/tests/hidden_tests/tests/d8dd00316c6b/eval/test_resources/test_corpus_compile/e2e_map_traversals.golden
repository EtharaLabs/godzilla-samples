def _pf_map_exists(f, m):
    for kv in m.items():
        if f(kv[0], kv[1]):
            return True
    return False
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_fold(f, acc, m):
    for kv in m.items():
        acc = f(acc, kv[0], kv[1])
    return acc
def _pf_map_forall(f, m):
    for kv in m.items():
        if not f(kv[0], kv[1]):
            return False
    return True
def _pf_map_is_empty(m):
    return not m
def _pf_map_map(f, m):
    out = dict()
    for kv in m.items():
        out[kv[0]] = f(kv[0], kv[1])
    return out
def _pf_map_partition(f, m):
    yes = dict()
    no = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            yes[kv[0]] = kv[1]
        else:
            no[kv[0]] = kv[1]
    return (yes, no)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_str_concat(a, b):
    return a + b
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
m = dict([(1, "one"), (2, "two"), (3, "three")])
empty = _pf_map_is_empty(dict([]))
full = _pf_map_is_empty(m)
shouted = _pf_map_to_list(_pf_map_map(lambda k, v: _pf_str_concat(v, "!"), m))
kept = _pf_map_to_list(_pf_map_filter(lambda k, v: k > 1, m))
keySum = _pf_map_fold(lambda acc, k, v: acc + k, 0, m)
any = _pf_map_exists(lambda k, v: v == "two", m)
all = _pf_map_forall(lambda k, v: k > 0, m)
joined = _pf_map_to_list(_pf_map_union(m, dict([(3, "THREE"), (4, "four")])))
split = _pf_map_partition(lambda k, v: k > 1, m)
passing = _pf_map_to_list(_pf_fst(split))
failing = _pf_map_to_list(_pf_snd(split))
