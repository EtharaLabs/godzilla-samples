def f(flag: bool, n: int) -> int:
    def go(k: int) -> int:
        return k * 100
    if flag:
        def _go(k: int) -> int:
            if k == 0:
                return 0
            else:
                return k + _go(k - 1)
        _pf_t0 = _go(n)
    else:
        _pf_t0 = 0
    y = _pf_t0
    return y + go(1)
r: int = f(True, 3)
