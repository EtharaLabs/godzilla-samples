from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_index_of(x, xs):
    try:
        return Some(xs.index(x))
    except ValueError:
        return _None_
def f(n: int) -> int:
    return n + 1
def a(rack: list[int]) -> Some | None_:
    return _pf_index_of(f(1), rack)
def b(rack: list[int]) -> bool:
    return f(1) in rack
