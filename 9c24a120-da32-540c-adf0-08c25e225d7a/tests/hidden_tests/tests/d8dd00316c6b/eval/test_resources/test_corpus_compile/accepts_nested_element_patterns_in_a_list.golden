from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def f(xs):
    match xs:
        case [Some(x), *rest]:
            return x
        case [None_(), *rest]:
            return 0
        case []:
            return 0
        case _:
            raise RuntimeError("non-exhaustive match")
