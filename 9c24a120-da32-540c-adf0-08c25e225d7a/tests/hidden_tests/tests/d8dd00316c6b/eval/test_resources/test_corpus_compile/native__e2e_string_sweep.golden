from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_str_get(i, s):
    return Some(s[i]) if 0 <= i < len(s) else _None_
def _pf_str_is_empty(s):
    return not s
def _pf_str_of_list(xs):
    return "".join(xs)
def _pf_str_repeat(n, s):
    return s * max(n, 0)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_split_lines(s):
    return s.splitlines()
def _pf_str_trim_end(s):
    return s.rstrip()
def _pf_str_trim_start(s):
    return s.lstrip()
empty: bool = _pf_str_is_empty("")
full: bool = _pf_str_is_empty("a")
at: Some | None_ = _pf_str_get(1, "abc")
past: Some | None_ = _pf_str_get(9, "abc")
thrice: str = _pf_str_repeat(3, "ab")
none: str = _pf_str_repeat(0, "ab")
left: str = _pf_str_trim_start("  hi  ")
right: str = _pf_str_trim_end("  hi  ")
lines: list[str] = _pf_str_split_lines("a\nb\nc\n")
backwards: str = _pf_str_rev("abc")
joined: str = _pf_str_of_list(["a", "b", "c"])
roundTrip: str = _pf_str_of_list(list("xyz"))
