from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def f(x, o):
    if isinstance(o, Some):
        _x = o._0
        return _x
    else:
        return x
a = f(1, Some(5))
b = f(1, _None_)
