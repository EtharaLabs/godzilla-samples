from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Nil:
    def __repr__(self):
        return "Nil"
_Nil: Nil = Nil()
@dataclass(frozen=True, slots=True, repr=False)
class Cons:
    _0: Any
    _1: Any
    def __repr__(self):
        return f"Cons({self._0!r}, {self._1!r})"
Lst = Nil | Cons
def head(d, xs: Lst):
    if isinstance(xs, Nil):
        return d
    else:
        h = xs._0
        t = xs._1
        return h
r: int = head(0, Cons(7, Cons(8, _Nil)))
