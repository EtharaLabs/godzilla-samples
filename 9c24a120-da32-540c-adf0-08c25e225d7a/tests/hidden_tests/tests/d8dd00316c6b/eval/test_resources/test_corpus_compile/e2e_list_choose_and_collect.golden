from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
xs = [1, 2, 3]
a = _pf_choose(lambda x: (Some(x * 10) if x > 1 else _None_), xs)
b = _pf_collect(lambda x: [x, x], xs)
c = _pf_collect(lambda x: x, [[1], [2, 3]])
keepOdd = functools.partial(_pf_choose, lambda x: (Some(x) if x % 2 == 1 else _None_))
d = keepOdd(xs)
e = _pf_collect(lambda x: [x, 0], xs)
