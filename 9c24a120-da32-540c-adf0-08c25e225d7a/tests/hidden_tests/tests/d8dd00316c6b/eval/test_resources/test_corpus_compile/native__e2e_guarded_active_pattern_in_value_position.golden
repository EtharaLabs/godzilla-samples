from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_str_concat(a, b):
    return a + b
def _ap_Positive(n):
    if n > 0:
        return Some(n)
    else:
        return _None_
def classify(n: int) -> str:
    _pf_t1 = False
    if not _pf_t1:
        _pf_t2 = _ap_Positive(n)
        if isinstance(_pf_t2, Some):
            p = _pf_t2._0
            if p > 100:
                _pf_t0 = "big"
                _pf_t1 = True
    if not _pf_t1:
        if isinstance(_pf_t2, Some):
            p = _pf_t2._0
            _pf_t0 = "small"
            _pf_t1 = True
    if not _pf_t1:
        _pf_t0 = "nonpos"
        _pf_t1 = True
    label = _pf_t0
    return _pf_str_concat(label, "!")
a: str = classify(250)
b: str = classify(5)
c: str = classify(0)
