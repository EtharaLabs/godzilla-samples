from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def bump(x: int) -> int:
    return x + 100
def f(xs: list[Some | None_]) -> int:
    acc = dict()
    for o in xs:
        match o:
            case Some(_bump):
                acc[_bump] = 1
            case None_():
                pass
            case _:
                raise RuntimeError("non-exhaustive match")
    seen = acc
    return bump(len(seen))
r: int = f([Some(1), _None_, Some(2)])
