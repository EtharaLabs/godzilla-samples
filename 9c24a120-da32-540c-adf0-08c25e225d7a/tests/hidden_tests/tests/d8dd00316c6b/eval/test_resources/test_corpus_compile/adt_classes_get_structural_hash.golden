from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Red:
    def __repr__(self):
        return "Red"
_Red = Red()
@dataclass(frozen=True, slots=True, repr=False)
class Green:
    def __repr__(self):
        return "Green"
_Green = Green()
@dataclass(frozen=True, slots=True, repr=False)
class Blue:
    def __repr__(self):
        return "Blue"
_Blue = Blue()
s = set([_Red, _Red, _Green])
n = len(s)
hasRed = _Red in s
hasBlue = _Blue in s
