import itertools
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
xs = [1, 2, 3]
a = _pf_take_while(lambda x: x < 3, xs)
b = _pf_drop_while(lambda x: x < 3, xs)
c = _pf_sort_by_desc(lambda x: x, xs)
d = _pf_count_by(lambda x: x % 2, xs)
