def _ap_DivisibleBy(d, n):
    return n % d == 0
def fizz(n: int) -> str:
    _pf_t0 = _ap_DivisibleBy(15, n)
    _pf_t1 = _ap_DivisibleBy(3, n)
    _pf_t2 = _ap_DivisibleBy(5, n)
    if _pf_t0:
        return "fizzbuzz"
    elif _pf_t1:
        return "fizz"
    elif _pf_t2:
        return "buzz"
    else:
        return str(n)
a: str = fizz(15)
b: str = fizz(9)
c: str = fizz(10)
d: str = fizz(7)
