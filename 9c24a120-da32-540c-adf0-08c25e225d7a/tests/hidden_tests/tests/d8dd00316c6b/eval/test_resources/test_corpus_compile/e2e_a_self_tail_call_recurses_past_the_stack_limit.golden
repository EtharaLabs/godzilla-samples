def countdown(n):
    while True:
        if n == 0:
            return "done"
        else:
            n = n - 1
            continue
def sumTo(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue
deep = countdown(50000)
total = sumTo(100000, 0)
