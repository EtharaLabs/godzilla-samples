from typing import Any
def _pf_concat(xs, ys):
    return xs + ys
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_set_add(x, s):
    return s.union([x])
def step(acc, x):
    m = acc[0]
    l = acc[1]
    s = acc[2]
    return (_pf_map_add(x, x, m), _pf_concat(l, [x]), _pf_set_add(x, s))
dseed: dict[Any, Any] = dict()
lseed: list[Any] = []
sseed: set[Any] = set()
m = dict(dseed)
l = list(lseed)
s = set(sseed)
for x in [1, 2]:
    m[x] = x
    l.append(x)
    s.add(x)
r: tuple[dict[int, int], list[int], set[int]] = (m, l, s)
m = r[0]
l = r[1]
s = r[2]
_pf_t0 = (_pf_map_to_list(m), l, list(s))
out: tuple[list[tuple[int, int]], list[int], list[int]] = _pf_t0
origs: tuple[int, int, int] = (len(dseed), len(lseed), len(sseed))
