from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
@dataclass(frozen=True, slots=True)
class Box:
    item: Any
    tag: bool
def f(b: Box) -> int:
    if isinstance(b, Box) and isinstance(b.item, Some) and b.tag is True:
        n = b.item._0
        return n
    elif isinstance(b, Box) and isinstance(b.item, Some):
        n = b.item._0
        return n + 100
    else:
        return 0
a: int = f(Box(Some(5), True))
b: int = f(Box(Some(5), False))
c: int = f(Box(_None_, True))
