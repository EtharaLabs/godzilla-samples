from dataclasses import dataclass
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
@dataclass(frozen=True, slots=True, repr=False)
class Plain:
    def __repr__(self):
        return "Plain"
_Plain = Plain()
@dataclass(frozen=True, slots=True, repr=False)
class Double:
    def __repr__(self):
        return "Double"
_Double = Double()
layout = [_Plain, _Double]
size = len(layout)
empty = dict()
print(size)
print(len(_pf_map_add(1, "a", empty)))
