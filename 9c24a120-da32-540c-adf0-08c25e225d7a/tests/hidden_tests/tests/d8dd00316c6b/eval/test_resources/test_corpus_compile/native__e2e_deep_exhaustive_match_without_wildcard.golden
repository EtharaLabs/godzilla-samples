from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def f(o: Some | None_) -> int:
    if isinstance(o, Some) and o._0 is True:
        return 1
    elif isinstance(o, Some) and o._0 is False:
        return 2
    else:
        return 3
a: int = f(Some(True))
b: int = f(Some(False))
c: int = f(_None_)
