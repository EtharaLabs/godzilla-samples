from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class _Small:
    _0: Any
    def __repr__(self):
        return f"_Small({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Big:
    _0: Any
    def __repr__(self):
        return f"_Big({self._0!r})"
def _ap_Small_Big(n):
    if n < 10:
        return _Small(n)
    else:
        return _Big(n - 10)
def f(n: int) -> int:
    _pf_t0 = _ap_Small_Big(n)
    if isinstance(_pf_t0, _Small):
        s = _pf_t0._0
        return s
    elif isinstance(_pf_t0, _Big):
        b = _pf_t0._0
        return b
    else:
        raise RuntimeError("non-exhaustive match")
a: int = f(7)
