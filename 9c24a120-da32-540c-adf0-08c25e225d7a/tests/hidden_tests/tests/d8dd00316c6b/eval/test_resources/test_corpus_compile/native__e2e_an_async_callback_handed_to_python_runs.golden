        line = await reader.readline()
        _ = writer.write(_pf_str_upper(line.decode()).encode())
        await writer.drain()
        _ = writer.close()
    return _pf_Async(_pf_fn0)
async def _pf_fn1():
    server = await asyncio.start_server(lambda *_pf_a: _pf_run(shout(*_pf_a)), "127.0.0.1", 47321)
    reader, writer = await asyncio.open_connection("127.0.0.1", 47321)
    _ = writer.write("hello\n".encode())
    await writer.drain()
    reply = await _pf_async_timeout(5.0, _pf_Async(reader.readline))
    _ = print(_pf_option_map(lambda b: _pf_str_strip(b.decode()), reply))
