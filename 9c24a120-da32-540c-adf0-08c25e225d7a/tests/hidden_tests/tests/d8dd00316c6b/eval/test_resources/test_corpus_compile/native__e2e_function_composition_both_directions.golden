def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_strip(s):
    return s.strip()
def _pf_str_upper(s):
    return s.upper()
def inc(x: int) -> int:
    return x + 1
def double(x: int) -> int:
    return x * 2
ltr = lambda _pf_x: double(inc(_pf_x))
rtl = lambda _pf_x: inc(double(_pf_x))
a: int = ltr(3)
b: int = rtl(3)
piped: int = (lambda _pf_x: double(inc(_pf_x)))(5)
mapped: list[int] = _pf_map(lambda _pf_x: inc(double(_pf_x)), [1, 2, 3])
clean: str = (lambda _pf_x: _pf_str_upper(_pf_str_strip(_pf_x)))("  hi  ")
