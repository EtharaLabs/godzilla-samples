from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def Maybe_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Maybe_return_(x):
    return Some(x)
def safe(a, b):
    return Maybe_bind(a, lambda x: Maybe_bind(b, lambda y: Maybe_return_(x + y)))
def unwrap(m):
    if isinstance(m, Some):
        n = m._0
        return n
    else:
        return 0
r1 = unwrap(safe(Some(3), Some(4)))
r2 = unwrap(safe(Some(3), _None_))
