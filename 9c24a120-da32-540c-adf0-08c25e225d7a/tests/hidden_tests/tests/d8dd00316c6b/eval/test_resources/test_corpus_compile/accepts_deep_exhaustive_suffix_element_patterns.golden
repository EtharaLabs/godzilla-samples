from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def f(xs):
    match xs:
        case []:
            return 0
        case [*_, None_()]:
            return 1
        case [*_, Some(x)]:
            return x
        case _:
            raise RuntimeError("non-exhaustive match")
