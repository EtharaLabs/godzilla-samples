from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_opt_map2(f, a, b):
    if isinstance(a, Some) and isinstance(b, Some):
        return Some(f(a._0, b._0))
    return _None_
s = _pf_opt_map2(lambda a, b: a + b, Some(1), Some(2))
