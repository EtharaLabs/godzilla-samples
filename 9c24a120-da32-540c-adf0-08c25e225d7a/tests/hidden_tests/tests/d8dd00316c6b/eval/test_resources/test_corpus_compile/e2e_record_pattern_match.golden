from dataclasses import dataclass
@dataclass(frozen=True, slots=True)
class Point:
    x: int
    y: int
def classify(p):
    match p:
        case Point(x=0, y=0):
            return 1
        case Point(x=0):
            return 2
        case Point(x=x, y=y):
            return x + y
a = classify(Point(0, 0))
b = classify(Point(0, 9))
c = classify(Point(3, 4))
