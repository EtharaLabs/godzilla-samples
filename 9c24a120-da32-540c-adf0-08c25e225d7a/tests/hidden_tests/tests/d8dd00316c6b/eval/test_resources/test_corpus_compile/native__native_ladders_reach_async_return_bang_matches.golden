from dataclasses import dataclass
from typing import Any
import asyncio
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def check(n: int) -> Ok | Error:
    if n > 0:
        return Ok(n)
    else:
        return Error("negative")
def describe(n: int):
    async def _pf_fn2():
        _pf_t0 = check(n)
        if isinstance(_pf_t0, Ok):
            v = _pf_t0._0
            async def _pf_fn0():
                return f"ok {v}"
            return await _pf_fn0()
        else:
            why = _pf_t0._0
            async def _pf_fn1():
                return why
            return await _pf_fn1()
    return _pf_Async(_pf_fn2)
print(asyncio.run(_pf_run(describe(3))))
print(asyncio.run(_pf_run(describe(0 - 1))))
