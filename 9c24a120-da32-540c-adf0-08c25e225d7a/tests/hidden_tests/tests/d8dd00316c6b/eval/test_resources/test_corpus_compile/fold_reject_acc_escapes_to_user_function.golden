import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def ins(x, acc):
    return _pf_concat([x], acc)
def rev(xs):
    return _pf_fold(lambda acc, x: ins(x, acc), [], xs)
out = rev([1, 2, 3])
