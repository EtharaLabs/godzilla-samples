def _pf_concat(xs, ys):
    return xs + ys
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def step(acc, x):
    match acc:
        case (m, log):
            return (_pf_map_add(x, x, m), _pf_concat(log, [len(m)]))
