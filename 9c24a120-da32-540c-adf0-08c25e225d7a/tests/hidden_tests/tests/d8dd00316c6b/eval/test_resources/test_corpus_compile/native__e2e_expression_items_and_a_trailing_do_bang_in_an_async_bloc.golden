import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
async def _pf_fn0():
    _ = await asyncio.sleep(0.001)
    _ = print("napped")
    _pf_t1 = 1
    if _pf_t1 == 1:
        _pf_t0 = print("one")
    else:
        _pf_t0 = print("other")
    _ = _pf_t0
    _ = print("yes") if True else None
    await asyncio.sleep(0.001)
nap = _pf_Async(_pf_fn0)
print(asyncio.run(_pf_run(nap)))
