from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class Red:
    def __repr__(self):
        return "Red"
_Red: Red = Red()
@dataclass(frozen=True, slots=True, repr=False)
class Green:
    def __repr__(self):
        return "Green"
_Green: Green = Green()
@dataclass(frozen=True, slots=True, repr=False)
class Blue:
    def __repr__(self):
        return "Blue"
_Blue: Blue = Blue()
Color = Red | Green | Blue
def unwrap(o: Some | None_) -> int:
    if isinstance(o, Some):
        v = o._0
        return v
    else:
        return 0
r1: int = unwrap(Some(5))
r2: int = unwrap(_None_)
def rank(c: Color) -> int:
    if isinstance(c, Red):
        return 1
    elif isinstance(c, Green):
        return 2
    else:
        return 3
r3: int = rank(_Green)
