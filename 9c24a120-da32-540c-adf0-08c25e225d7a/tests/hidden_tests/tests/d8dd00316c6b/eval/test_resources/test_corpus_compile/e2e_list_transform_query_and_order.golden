from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_index_of(x, xs):
    try:
        return Some(xs.index(x))
    except ValueError:
        return _None_
xs = [3, 1, 4, 1, 5]
summed = _pf_map2(lambda a, b: a + b, [1, 2, 3], [10, 20])
ix = _pf_indexed(["a", "b"])
any = _pf_exists(lambda x: x > 4, xs)
all = _pf_forall(lambda x: x > 0, xs)
at = _pf_index_of(4, xs)
missing = _pf_index_of(99, xs)
desc = _pf_sort_desc(xs)
uniq = _pf_distinct(xs)
grouped = _pf_group_by(lambda x: x % 2, [1, 2, 3, 4])
