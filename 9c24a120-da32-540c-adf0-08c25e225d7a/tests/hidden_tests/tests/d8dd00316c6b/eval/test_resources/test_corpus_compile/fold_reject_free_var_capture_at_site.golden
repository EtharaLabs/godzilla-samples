import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
base = 10
def addb(acc, x):
    return _pf_concat(acc, [x + base])
def usefn(n):
    base = 99
    return _pf_fold(addb, [], [1])
out = usefn(0)
