def f(flag, n):
    def go(k):
        return k * 100
    if flag:
        def _go(k):
            if k == 0:
                return 0
            else:
                return k + _go(k - 1)
        _pf_t0 = _go(n)
    else:
        _pf_t0 = 0
    y = _pf_t0
    return y + go(1)
r = f(True, 3)
