from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
@dataclass(frozen=True, slots=True)
class Leg:
    depMin: int
    dest: str
def dedupLegs(legs):
    def step(acc, leg):
        match acc:
            case (seen, out):
                k = f"{leg.depMin}|{leg.dest}"
                if k in seen:
                    return (seen, out)
                else:
                    return (_pf_map_add(k, True, seen), _pf_concat(out, [leg]))
    seen = dict()
    out = []
    for leg in legs:
        k = f"{leg.depMin}|{leg.dest}"
        match _pf_map_try_find(k, seen):
            case Some(_):
                pass
            case None_():
                seen[k] = True
                out.append(leg)
            case _:
                raise RuntimeError("non-exhaustive match")
    match (seen, out):
        case (_, out):
            return out
out = _pf_map(lambda l: l.depMin, dedupLegs([Leg(1, "a"), Leg(1, "a"), Leg(2, "b")]))
