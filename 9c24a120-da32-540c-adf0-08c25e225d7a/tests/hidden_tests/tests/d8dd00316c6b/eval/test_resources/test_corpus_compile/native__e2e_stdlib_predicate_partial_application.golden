import functools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_str_contains(sub, s):
    return sub in s
f = functools.partial(_pf_str_contains, "lo")
a: bool = f("hello")
b: bool = f("hi")
r: list[str] = _pf_filter(functools.partial(_pf_str_contains, "a"), ["cat", "dog", "bat"])
n: int = len(r)
