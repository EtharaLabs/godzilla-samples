def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def build(xs: list[int]) -> dict[int, int]:
    def step(acc: dict[int, int], x: int) -> dict[int, int]:
        return _pf_map_add(x, x * 2, acc)
    acc = dict()
    for x in xs:
        _pf_t0 = x * 2
        acc[x] = _pf_t0
    return acc
out: list[tuple[int, int]] = _pf_map_to_list(build([1, 2, 3]))
