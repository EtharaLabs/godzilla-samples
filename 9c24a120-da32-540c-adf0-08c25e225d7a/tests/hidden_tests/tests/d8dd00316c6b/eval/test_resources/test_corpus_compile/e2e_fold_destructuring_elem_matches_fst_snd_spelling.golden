def _pf_map_to_list(m):
    return list(m.items())
def _pf_fst(p):
    return p[0]
def _pf_snd(p):
    return p[1]
steps = [("a", 1), ("b", 2), ("a", 3)]
m = dict()
for (p, l) in steps:
    m[p] = l
slow = m
m = dict()
for s in steps:
    _pf_t0 = _pf_fst(s)
    _pf_t1 = _pf_snd(s)
    m[_pf_t0] = _pf_t1
fast = m
out = (_pf_map_to_list(slow), _pf_map_to_list(fast), slow == fast)
