def classify(n):
    match n:
        case 0:
            base = 100
            return base
        case _:
            acc = n
            acc = acc * 2
            return acc
def absdiff(a, b):
    if a > b:
        d = a - b
        return d
    else:
        d = b - a
        return d
r1 = classify(0)
r2 = classify(5)
r3 = absdiff(3, 10)
