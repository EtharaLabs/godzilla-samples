from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
_pf_t1 = 6
_pf_t2 = _ap_Even_Odd(_pf_t1)
if isinstance(_pf_t2, _Even):
    _pf_t0 = "even"
elif isinstance(_pf_t2, _Odd):
    _pf_t0 = "odd"
else:
    raise RuntimeError("non-exhaustive match")
r = _pf_t0
