from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: Any
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: Any
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_option_bind(f, o):
    if isinstance(o, Some):
        return f(o._0)
    return _None_
def _pf_option_filter(f, o):
    return o if isinstance(o, Some) and f(o._0) else _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_result_is_error(r):
    return isinstance(r, Error)
def _pf_result_with_default(d, r):
    if isinstance(r, Ok):
        return r._0
    return d
half = lambda x: (Some(x // 2) if x % 2 == 0 else _None_)
a: int = _pf_option_with_default(0, _pf_option_bind(half, Some(8)))
b: int = _pf_option_with_default(0, _pf_option_bind(half, Some(7)))
c: int = _pf_option_with_default(0, _pf_option_filter(lambda x: x > 5, Some(8)))
d: int = _pf_option_with_default(0, _pf_option_filter(lambda x: x > 5, Some(2)))
e: int = _pf_result_with_default(0, _pf_option_to_result(0, Some(42)))
f: bool = _pf_result_is_error(_pf_option_to_result(0, _None_))
