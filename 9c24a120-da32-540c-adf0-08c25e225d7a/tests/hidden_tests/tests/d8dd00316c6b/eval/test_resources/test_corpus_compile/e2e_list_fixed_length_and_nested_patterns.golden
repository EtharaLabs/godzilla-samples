from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def describe(xs):
    match xs:
        case []:
            return 0
        case [x]:
            return 1
        case [x, y]:
            return 2
        case [x, y, *rest]:
            return 3
        case _:
            raise RuntimeError("non-exhaustive match")
def head(xs):
    match xs:
        case [Some(x), *rest]:
            return x
        case _:
            return 0
a = describe([10, 20, 30])
b = describe([7])
c = describe([])
d = head([Some(42), _None_])
