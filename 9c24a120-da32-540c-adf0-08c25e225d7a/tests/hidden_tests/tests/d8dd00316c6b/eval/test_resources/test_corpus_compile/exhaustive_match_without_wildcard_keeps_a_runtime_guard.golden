from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Red:
    def __repr__(self):
        return "Red"
_Red = Red()
@dataclass(frozen=True, slots=True, repr=False)
class Green:
    def __repr__(self):
        return "Green"
_Green = Green()
@dataclass(frozen=True, slots=True, repr=False)
class Blue:
    def __repr__(self):
        return "Blue"
_Blue = Blue()
def f(c):
    match c:
        case Red():
            return 1
        case Green():
            return 2
        case Blue():
            return 3
        case _:
            raise RuntimeError("non-exhaustive match")
