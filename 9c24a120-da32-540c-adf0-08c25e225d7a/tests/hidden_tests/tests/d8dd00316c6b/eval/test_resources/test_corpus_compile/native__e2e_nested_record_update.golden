from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True)
class Inner:
    a: int
    b: int
@dataclass(frozen=True, slots=True)
class Outer:
    inner: "Inner"
    tag: str
o: Outer = Outer(Inner(1, 2), "x")
_pf_t0 = o
o2: Outer = Outer(Inner(99, _pf_t0.inner.b), _pf_t0.tag)
_pf_t1 = o
both: Outer = Outer(Inner(10, _pf_t1.inner.b), "y")
na: int = o2.inner.a
nb: int = o2.inner.b
nt: str = o2.tag
ba: int = both.inner.a
bt: str = both.tag
