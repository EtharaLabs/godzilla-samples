from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True)
class Box:
    item: object
def f(b):
    match b:
        case Box(item=Some(n)):
            return n
        case Box(item=None_()):
            return 0
        case _:
            raise RuntimeError("non-exhaustive match")
