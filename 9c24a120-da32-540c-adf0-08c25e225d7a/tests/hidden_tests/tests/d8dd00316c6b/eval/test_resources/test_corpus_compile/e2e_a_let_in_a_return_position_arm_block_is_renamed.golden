from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def f(o):
    n = 1
    if isinstance(o, Some):
        k = o._0
        _n = n * 10 + k
        return _n + 1
    else:
        return n
r = f(Some(2))
s = f(_None_)
