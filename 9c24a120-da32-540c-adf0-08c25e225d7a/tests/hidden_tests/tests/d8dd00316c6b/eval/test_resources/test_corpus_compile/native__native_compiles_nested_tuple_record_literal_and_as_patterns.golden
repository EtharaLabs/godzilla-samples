from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: "Expr"
    _1: "Expr"
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
Expr = Num | Add
@dataclass(frozen=True, slots=True)
class Point:
    x: int
    y: int
def simp(e: Expr) -> Expr:
    if isinstance(e, Add) and isinstance(e._0, Num) and e._0._0 == 0:
        b = e._1
        return b
    elif isinstance(e, Add) and isinstance(e._1, Num) and e._1._0 == 0:
        a = e._0
        return a
    else:
        other = e
        return other
def quad(p: Point) -> str:
    if isinstance(p, Point) and p.x == 0 and p.y == 0:
        _pf_t0 = "origin"
    elif isinstance(p, Point) and p.x == 0:
        _pf_t0 = "y axis"
    else:
        whole = p
        x = p.x
        y = p.y
        _pf_t0 = f"{x},{y} {whole.x}"
    q = _pf_t0
    return q
def name(i) -> str:
    _pf_t1 = (i, True)
    if _pf_t1[0] == "root" and _pf_t1[1] is True:
        return "admin"
    else:
        s = _pf_t1[0]
        return s
print(simp(Add(Num(0), Num(7))))
print(simp(Add(Num(5), Num(0))))
print(quad(Point(0, 0)))
print(quad(Point(0, 3)))
print(quad(Point(2, 3)))
print(name("root"))
print(name("ada"))
