def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_strip(s):
    return s.strip()
def _pf_str_upper(s):
    return s.upper()
def inc(x):
    return x + 1
def double(x):
    return x * 2
ltr = lambda _pf_x: double(inc(_pf_x))
rtl = lambda _pf_x: inc(double(_pf_x))
a = ltr(3)
b = rtl(3)
piped = (lambda _pf_x: double(inc(_pf_x)))(5)
mapped = _pf_map(lambda _pf_x: inc(double(_pf_x)), [1, 2, 3])
clean = (lambda _pf_x: _pf_str_upper(_pf_str_strip(_pf_x)))("  hi  ")
