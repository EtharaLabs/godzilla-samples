import functools
import asyncio
def _pf_map(f, xs):
    return list(map(f, xs))
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
pauses = _pf_map(lambda _pf_p0: _pf_Async(asyncio.sleep, _pf_p0), [0.0, 0.0])
values = _pf_map(functools.partial(lambda _pf_p0, _pf_p1: _pf_Async(asyncio.sleep, _pf_p0, _pf_p1), 0.0), [1, 2])
async def _pf_fn0():
    for p in pauses:
        await p
        await p
    for v in values:
        a = await v
        b = await v
        _ = print(a + b)
    return None
main = _pf_Async(_pf_fn0)
asyncio.run(_pf_run(main))
