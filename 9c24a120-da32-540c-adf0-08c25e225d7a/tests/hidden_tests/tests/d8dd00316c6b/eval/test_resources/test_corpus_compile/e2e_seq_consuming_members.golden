from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_seq_contains(x, xs):
    return x in xs
def _pf_seq_exists(f, xs):
    return any(map(f, xs))
def _pf_seq_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_seq_forall(f, xs):
    return all(map(f, xs))
def _pf_seq_head(xs):
    return next(map(Some, xs), _None_)
def _pf_seq_is_empty(xs):
    return not isinstance(next(map(Some, xs), _None_), Some)
def _pf_seq_len(xs):
    return len(list(xs))
first = _pf_seq_head(iter([7, 8]))
none = _pf_seq_head(iter([]))
empty = _pf_seq_is_empty(iter([]))
full = _pf_seq_is_empty(iter([1]))
n = _pf_seq_len(iter([1, 2, 3]))
any = _pf_seq_exists(lambda x: x > 2, iter([1, 2, 3]))
all = _pf_seq_forall(lambda x: x > 0, iter([1, 2, 3]))
has = _pf_seq_contains(2, iter([1, 2, 3]))
total = sum(iter([1, 2, 3]))
found = _pf_seq_find(lambda x: x > 1, iter([1, 2, 3]))
missing = _pf_seq_find(lambda x: x > 9, iter([1, 2, 3]))
