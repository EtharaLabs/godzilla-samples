import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
def _pf_async_to_thread(f):
    return _pf_Async(asyncio.to_thread, f, None)
def go(x):
    def _pf_fn0(_):
        return x + 1
    return _pf_async_to_thread(_pf_fn0)
