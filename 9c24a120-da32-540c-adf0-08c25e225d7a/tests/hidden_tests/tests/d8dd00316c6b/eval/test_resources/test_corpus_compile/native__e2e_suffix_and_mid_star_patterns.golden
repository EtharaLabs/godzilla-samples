def lastOr(fallback, xs):
    if len(xs) >= 1:
        last = xs[-1]
        return last
    else:
        return fallback
def bounds(xs: list[int]) -> int:
    if len(xs) == 0:
        return 0
    elif len(xs) == 1:
        x = xs[0]
        return x
    else:
        first = xs[0]
        last = xs[-1]
        mid = xs[1:len(xs) - 1]
        return first + last + len(mid)
a: int = lastOr(0, [5, 6, 7])
b: int = lastOr(9, [])
c: int = bounds([1, 2, 3, 4])
d: int = bounds([7])
