from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_seq_contains(x, xs):
    return x in xs
def _pf_seq_exists(f, xs):
    return any(map(f, xs))
def _pf_seq_find(f, xs):
    return next(map(Some, filter(f, xs)), _None_)
def _pf_seq_forall(f, xs):
    return all(map(f, xs))
def _pf_seq_head(xs):
    return next(map(Some, xs), _None_)
def _pf_seq_is_empty(xs):
    return not isinstance(next(map(Some, xs), _None_), Some)
def _pf_seq_len(xs):
    return len(list(xs))
first: Some | None_ = _pf_seq_head(iter([7, 8]))
none: Some | None_ = _pf_seq_head(iter([]))
empty: bool = _pf_seq_is_empty(iter([]))
full: bool = _pf_seq_is_empty(iter([1]))
n: int = _pf_seq_len(iter([1, 2, 3]))
any: bool = _pf_seq_exists(lambda x: x > 2, iter([1, 2, 3]))
all: bool = _pf_seq_forall(lambda x: x > 0, iter([1, 2, 3]))
has: bool = _pf_seq_contains(2, iter([1, 2, 3]))
total: int = sum(iter([1, 2, 3]))
found: Some | None_ = _pf_seq_find(lambda x: x > 1, iter([1, 2, 3]))
missing: Some | None_ = _pf_seq_find(lambda x: x > 9, iter([1, 2, 3]))
