from dataclasses import dataclass
import json
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_dec_bool(v):
    if isinstance(v, bool):
        return v
    raise ValueError("expected a bool, got " + type(v).__name__)
def _pf_dec_int(v):
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    raise ValueError("expected an int, got " + type(v).__name__)
def _pf_dec_map(f, dec):
    def go(v):
        return f(dec(v))
    return go
def _pf_dec_one_of(decs):
    def go(v):
        def _try(i):
            if i >= len(decs):
                raise ValueError("Decode.oneOf: no decoder matched")
            try:
                return decs[i](v)
            except Exception:
                return _try(i + 1)
        return _try(0)
    return go
def show(r):
    if isinstance(r, Ok):
        v = r._0
        return f"ok: {v}"
    else:
        e = r._0
        return e.errorMessage
