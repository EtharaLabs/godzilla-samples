from dataclasses import dataclass
from typing import Any
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Square:
    _0: float
    def __repr__(self):
        return f"Square({self._0!r})"
Shape = Circle | Square
@dataclass(frozen=True, slots=True)
class Point:
    x: int
    y: int
def area(s: Shape) -> float:
    if isinstance(s, Circle):
        r = s._0
        return 3.0 * r * r
    else:
        w = s._0
        return w * w
def shift(p: Point, dx: int) -> Point:
    _pf_t0 = p
    return Point(p.x + dx, _pf_t0.y)
def names(xs: list[str]) -> list[str]:
    return _pf_map(lambda s: _pf_str_upper(s), xs)
def first(xs) -> Some | None_:
    return _pf_head(xs)
def apply(f, x):
    return f(x)
print(area(Square(2.0)))
print(shift(Point(1, 2), 3).x)
print(names(["a"]))
print(first([1]))
print(apply(lambda n: n + 1, 1))
