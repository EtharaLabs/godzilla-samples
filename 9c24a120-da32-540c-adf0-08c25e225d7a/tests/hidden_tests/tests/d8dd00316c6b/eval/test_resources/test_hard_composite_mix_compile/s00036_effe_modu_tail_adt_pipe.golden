from dataclasses import dataclass
from functools import total_ordering
import functools
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_desc(xs):
    return sorted(xs, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: str
    _1: str
    def __repr__(self):
        return f"Store({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    def __repr__(self):
        return "Skip"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Skip = Skip()
def margin(price, qty):
    return price * qty - 5 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("gear", 40, 3), ("wick", 35, 1), ("tap", 17, 6)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(7)([1, 2, 3]))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_square(x):
    return x * x
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts = [8, 8, 16, -13, 4, 12]
print(_pf_map(functools.partial(Text_clamp, 0, 7), pts))
print(_pf_map(Text_square, pts))
print(Text_norm1(pts))
print(Text_mean(pts))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [48, 11, 55]))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [29, 29, 21, 25, 24]))
def show(t):
    match t:
        case Mark(n0) if n0 % 2 == 0:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Store(s0, s1):
            return f"store({s0},{s1})"
        case Skip():
            return f"skip"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Store(_, _):
            return 5
        case Mark(x0):
            return x0
        case _:
            return 3
stream = [_Skip, Store("gus", "fay"), _Skip, Store("pam", "sue")]
print(_pf_str_join(" ", _pf_map(show, stream)))
tally = _pf_sum_by(weight, stream)
print(f"tally={tally}")
print(_pf_sort(stream))
values = [40, 38, 10, 41, 39, 29, 16, 1]
def accept(n):
    return n > 10 and n % 5 != 0
digest = _pf_forall(lambda x: x >= 0, _pf_map(lambda x: (-x if x < 0 else x * 4), _pf_map(lambda b: 4 + b, _pf_filter(lambda x: x % 4 == 3, _pf_sort_desc(_pf_drop(1, _pf_sort(values)))))))
print(digest)
