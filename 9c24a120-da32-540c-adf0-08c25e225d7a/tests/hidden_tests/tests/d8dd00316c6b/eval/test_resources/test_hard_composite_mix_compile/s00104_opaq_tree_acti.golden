from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = mint("sku", 4)
print(_pf_str_join(" ", _pf_map(unwrap, keys)))
print(_pf_head(keys) == Some("acc-1"))
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [58, 14, 59, 28, 27, 21, 50])
def sumOf(t):
    match t:
        case Leaf():
            return 0
        case Node(l, v, rt):
            return sumOf(l) + v + sumOf(rt)
        case _:
            raise RuntimeError("non-exhaustive match")
print(sumOf(root))
def toListOf(t):
    match t:
        case Leaf():
            return []
        case Node(l, v, rt):
            return _pf_concat(toListOf(l), _pf_concat([v], toListOf(rt)))
        case _:
            raise RuntimeError("non-exhaustive match")
print(toListOf(root))
def minOf(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minOf(root))
def containsT(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsT(k, root), [58, 51, 48]))
def _ap_Above(n):
    if n > 26:
        return Some(n - 26)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def classify(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [19, 15, 27, 20, 31]))
