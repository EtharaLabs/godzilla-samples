def show(t):
    match t:
        case Halt(n0) if 0 <= n0 < 15:
            return f"halt!({n0})"
        case Halt(n0):
            return f"halt({n0})"
        case Load(s0):
            return f"load({s0})"
        case Rest(s0, s1):
            return f"rest({s0},{s1})"
        case Turn(n0) if n0 > 6:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Rest(_, _):
            return 9
        case Turn(x0):
            return x0 * 4
        case _:
            return 3
