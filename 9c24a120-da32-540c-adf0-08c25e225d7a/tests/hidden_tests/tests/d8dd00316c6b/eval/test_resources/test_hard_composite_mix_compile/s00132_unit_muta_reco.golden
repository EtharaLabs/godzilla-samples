from dataclasses import dataclass
import functools
import math
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
laps = [366.4, 442.7, 201.5, 404.2]
durations = [82.6, 89.3, 70.6, 75.7]
dist = _pf_fold(lambda a, b: a + b, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed = dist / dur
print(_pf_fmt_fixed(3, speed))
edge = math.sqrt(36.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
mass = 20.0
accel = 1.5
push = mass * accel
limit = 362.0
print("over" if push > limit else "under")
ticks = 0
def note(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([60, 54, 27, 44, 17, -2, -3]))
doubled = _pf_map(note, [60, 54, 27, 44])
print(f"{doubled} after {ticks} calls")
parcels = [Parcel(100, "dee", 259, True), Parcel(101, "dee", 95, True), Parcel(102, "dee", 86, False), Parcel(103, "ned", 29, False), Parcel(104, "eli", 74, False)]
cheap, dear = _pf_partition(lambda o: o.amount < 130, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def classify(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 152:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 152:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def adjust(o):
    if o.urgent:
        _pf_t0 = o
        return Parcel(_pf_t0.id, _pf_t0.owner, o.amount + 6, _pf_t0.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(adjust, parcels)))
