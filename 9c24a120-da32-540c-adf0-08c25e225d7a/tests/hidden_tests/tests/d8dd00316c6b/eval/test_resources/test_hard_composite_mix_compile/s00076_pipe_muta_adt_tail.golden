from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_collect(f, xs):
    out = []
    for x in xs:
        out.extend(f(x))
    return out
def _pf_distinct(xs):
    return list(dict.fromkeys(xs))
def _pf_drop(n, xs):
    return xs[max(n, 0):len(xs)]
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_last(xs):
    return Some(xs[-1]) if xs else _None_
def _pf_reduce(f, xs):
    return Some(functools.reduce(f, xs)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    _1: int
    def __repr__(self):
        return f"Skip({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
data = [50, 29, 33, 22, -3, -4, 14, 29, 18]
def accept(n):
    return n > 2 and n % 5 != 0
stage = lambda _pf_x: _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), (lambda _pf_x: _pf_filter(accept, (lambda _pf_x: (lambda _pf_x: _pf_map(sum, _pf_chunk(4, _pf_x)))((lambda _pf_x: _pf_drop(2, (lambda _pf_x: _pf_collect(lambda x: [x, x + 1], _pf_distinct(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x)))(_pf_x))
outcome = _pf_reduce(lambda a, b: a + b, stage(data))
print(outcome)
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 2
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([-13, -14, -11, 26, 52]))
doubled = _pf_map(record, [-13, -14, -11, 26])
print(f"{doubled} after {hits} calls")
def explain(t):
    match t:
        case Emit(2):
            return "emit-2"
        case Emit(n0):
            return f"emit({n0})"
        case Skip(s0, n1):
            return f"skip({s0},{n1})"
        case Rest(n0):
            return f"rest({n0})"
        case Turn(0):
            return "turn-0"
        case Turn(n0):
            return f"turn({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Emit(x0):
            return x0 * 4
        case _:
            return 1
queue = [Rest(5), Emit(0), Skip("gus", 11), Skip("quin", -2), Rest(10), Skip("max", 8), Turn(-1)]
print(_pf_str_join("; ", _pf_map(explain, queue)))
tally = _pf_sum_by(cost, queue)
