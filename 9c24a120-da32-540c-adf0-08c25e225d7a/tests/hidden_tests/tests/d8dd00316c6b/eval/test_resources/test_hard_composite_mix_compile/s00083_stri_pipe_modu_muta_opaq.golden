from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take_while(f, xs):
    return list(itertools.takewhile(f, xs))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_replace(old, new, s):
    return s.replace(old, new)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_id(x):
    return x
raw = "dee,ivy,max,quin,cap"
parts = _pf_str_split(",", raw)
print(_pf_str_replace("o", "O", raw))
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", "-3,,-3,,-3"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), parts))
print(_pf_option_with_default("?", longest))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, parts))))
print((_pf_str_index_of("ca", raw), "ca" in raw))
print(_pf_str_slice(1, 6, raw))
values = [25, 21, 40, 29, 44, 41, -4, 29, 16, 31]
def keep(n):
    return n > 4 and n % 4 != 0
outcome = _pf_exists(lambda x: x > 23, (lambda _pf_x: _pf_map(sum, _pf_chunk(2, _pf_x)))(_pf_sort(_pf_take_while(lambda x: x < 47, _pf_map(lambda b: 4 + b, _pf_choose(lambda x: (Some(x // 4) if x % 4 == 0 else _None_), _pf_map(lambda x: x * x - 4, values)))))))
print(outcome)
print(len(values))
def Stats_norm1(xs):
    return sum(_pf_map(abs, xs))
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_between(lo, hi, x):
    return lo <= x <= hi
def Stats_square(x):
    return x * x
nums = [-5, 19, -2, 18, -9, 20]
print(Stats_norm1(nums))
print(Stats_scaleAll(3, nums))
print(_pf_filter(functools.partial(Stats_between, -4, 12), nums))
print(_pf_map(Stats_square, nums))
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 2
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([44, 48, 22, -10, 28]))
doubled = _pf_map(record, [44, 48, 22, -10])
print(f"{doubled} after {hits} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), hits))
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("acc", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("u-1"))
