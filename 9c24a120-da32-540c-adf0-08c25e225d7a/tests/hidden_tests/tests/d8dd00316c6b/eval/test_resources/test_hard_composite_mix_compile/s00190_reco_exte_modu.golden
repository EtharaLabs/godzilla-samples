from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_group_by(f, xs):
    groups = dict()
    for x in xs:
        groups.setdefault(f(x), []).append(x)
    return list(groups.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
tickets = [Invoice(100, "cy", 231, False), Invoice(101, "ada", 225, True), Invoice(102, "hal", 58, True), Invoice(103, "hal", 217, True)]
urgentTotal = _pf_sum_by(lambda o: o.amount, _pf_filter(lambda o: o.urgent, tickets))
print(urgentTotal)
def classify(o):
    match o:
        case Invoice(urgent=True, amount=amount) if amount > 149:
            return "rush-big"
        case Invoice(urgent=True):
            return "rush"
        case Invoice(amount=amount):
            if amount > 149:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, tickets))
print(_pf_count_by(classify, tickets))
cheap, dear = _pf_partition(lambda o: o.amount < 71, tickets)
print(f"{len(cheap)} cheap, {len(dear)} dear")
print(_pf_map(lambda o: o.id, _pf_take(4, _pf_sort_by_desc(lambda o: o.amount, tickets))))
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, tickets))
print(byOwner)
print(_pf_map(math.isqrt, [297, 96, 20, 91]))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x9", "13"]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1001100") + int("126", base=8))
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_square(x):
    return x * x
def Stats_between(lo, hi, x):
    return lo <= x <= hi
obs = [5, 7, 18, 30, 8]
print(Stats_mean(obs))
print(Stats_scaleAll(5, obs))
print(_pf_map(Stats_square, obs))
print(_pf_filter(functools.partial(Stats_between, 3, 22), obs))
