from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts = [28, -3, -11, 3, 14, -6, 0]
print(Calc_norm1(pts))
print(_pf_map(functools.partial(Calc_clamp, 0, 7), pts))
print(_pf_filter(functools.partial(Calc_between, 1, 17), pts))
print(Calc_mean(pts))
def lcm(a, b):
    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [9, 7, 12, 7]))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x6", "30"]))
print(_pf_str_rev(str.upper("ivy")))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1100010") + int("50", base=8))
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Num(6), Mul(Add(Add(Num(0), Num(5)), Neg(Num(1))), Neg(Mul(Num(-1), Num(8))))]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evaluate, exprs))
