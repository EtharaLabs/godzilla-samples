from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_filter(f, m):
    out = dict()
    for kv in m.items():
        if f(kv[0], kv[1]):
            out[kv[0]] = kv[1]
    return out
def _pf_map_keys(m):
    return list(m.keys())
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_set_union(a, b):
    return a.union(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_square(x):
    return x * x
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts = [-6, 28, 3, 29, -7]
print(Geo_scaleAll(4, pts))
print(_pf_map(Geo_square, pts))
print(_pf_map(functools.partial(Geo_clamp, 0, 12), pts))
print(Geo_mean(pts))
log = ["dee", "cy", "bo", "cy", "ada", "fay", "fay", "eli"]
def bump(m, w):
    if w in m:
        n = m[w]
        return _pf_map_add(w, n + 1, m)
    else:
        return _pf_map_add(w, 1, m)
m = dict()
for w in log:
    match _pf_map_try_find(w, m):
        case Some(n):
            _pf_t0 = n + 1
            m[w] = _pf_t0
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
freq = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(freq)))
print(_pf_str_join(",", _pf_sort(_pf_map_keys(freq))))
print(len(_pf_map_filter(lambda k, v: v > 1, freq)))
sa = set([4, 5, 6, 11, 16, 19])
sb = set([4, 7, 11, 12, 17, 19])
print(_pf_sort(list(_pf_set_union(sa, sb))))
print((len(sa), 10 in sb, _pf_set_is_subset(set([4]), sa)))
ticks = 0
def track(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([60, 47, 33, 23, 25, 2, 33]))
doubled = _pf_map(track, [60, 47, 33, 23])
print(f"{doubled} after {ticks} calls")
