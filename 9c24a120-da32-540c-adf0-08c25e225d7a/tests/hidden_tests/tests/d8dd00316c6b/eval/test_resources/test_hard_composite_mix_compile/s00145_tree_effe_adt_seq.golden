from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    _0: str
    def __repr__(self):
        return f"Push({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    def __repr__(self):
        return "Drop"
_Drop = Drop()
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    _1: int
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
def add(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(add(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, add(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
root = _pf_fold(functools.partial(_pf_flip, add), _Leaf, [18, 33, 36, 54, 48, 32, 6, 51, 58])
def minOf(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minOf(root))
def containsOf(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsOf(k, root), [18, 59, 43]))
def margin(price, qty):
    return price * qty - 9 * qty
def announce(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("wick", 28, 1), ("wick", 31, 4), ("hub", 11, 4), ("hub", 20, 1)]))
print(overall)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(12)([1, 2, 3]))
def explain(t):
    match t:
        case Push(s0):
            return f"push({s0})"
        case Drop():
            return f"drop"
        case Pop(s0, n1):
            return f"pop({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Push(_):
            return 8
        case Pop(_, x1):
            return x1
        case _:
            return 0
batch = [_Drop, Push("ned"), _Drop, _Drop]
print(_pf_str_join("; ", _pf_map(explain, batch)))
total = _pf_sum_by(weight, batch)
print(f"total={total}")
print(len(_pf_filter(lambda t: weight(t) > 4, batch)))
def _pf_fn1():
    for x in _pf_range(1, 8):
        y = x * x
        yield y
squares = _pf_fn1()
print(list(filter(lambda n: n % 3 == 0, squares)))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1500, fib)))
