from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
values = [43, 21, 42, 1, 50, 31, 3, 47]
answer = (lambda _pf_x: _pf_str_join("-", _pf_map(str, _pf_x)))(_pf_distinct_by(lambda x: x % 2, _pf_sort_by(lambda x: x % 3, _pf_drop_while(lambda x: x < 5, values))))
print(answer)
def margin(price, qty):
    return price * qty - 6 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("wick", 47, 6), ("tap", 18, 3), ("cap", 17, 3)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(margin, k))
print(scaled(20)([1, 2, 3]))
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(54071))
def euclid(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(263, 132))
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(13, 0))
def _pf_fn1():
    for x in _pf_range(1, 6):
        y = x * x
        yield y
series = _pf_fn1()
print(list(filter(lambda n: n % 3 == 0, series)))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
def _pf_fn2(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn2, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1133, fib)))
def Text_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
nums = [-15, -8, 19, -12]
print(Text_scaleAll(4, nums))
print(Text_norm1(nums))
print(Text_mean(nums))
