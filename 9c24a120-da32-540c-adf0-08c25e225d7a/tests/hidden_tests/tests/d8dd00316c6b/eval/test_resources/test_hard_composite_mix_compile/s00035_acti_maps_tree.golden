            _pf_t1 = n + 1
            m[w] = _pf_t1
        case None_():
            m[w] = 1
        case _:
            raise RuntimeError("non-exhaustive match")
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
print(_pf_map_fold(lambda acc, k, v: acc + v, 0, counts))
