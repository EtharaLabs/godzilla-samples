from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def rawOf(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("acc", 4)
print(_pf_str_join(" ", _pf_map(rawOf, ids)))
print(_pf_head(ids) == Some("u-1"))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 19:
        return Some(n - 19)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [30, 39, 15, 8, 18]))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
nums = [-15, 14, 7, 2, 1, 19, 20]
print(Geo_norm1(nums))
print(_pf_filter(functools.partial(Geo_between, 4, 14), nums))
print(Geo_scaleAll(4, nums))
segments = [71.6, 372.0, 444.0]
splits = [35.5, 17.8, 85.4]
total = _pf_fold(lambda a, b: a + b, 0.0, segments)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = total / elapsed
print(_pf_fmt_fixed(2, pace))
mass = 80.0
accel = 1.5
push = mass * accel
limit = 68.0
print("over" if push > limit else "under")
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(segments, splits))
print(best)
