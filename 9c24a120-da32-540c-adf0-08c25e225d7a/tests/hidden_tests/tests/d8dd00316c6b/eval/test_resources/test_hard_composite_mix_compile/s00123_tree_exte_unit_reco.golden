from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by_desc(f, xs):
    return sorted(xs, key=f, reverse=True)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Num(0), Neg(Num(9)), Mul(Num(7), Mul(Neg(Num(9)), Num(9)))]
_pf_iter(print, _pf_map(pretty, exprs))
print(_pf_map(evalE, exprs))
def fromBin(s):
    return int(s, base=2)
print(fromBin("11001") + int("37", base=8))
print(_pf_map(math.isqrt, [133, 121, 371, 220]))
segments = [355.9, 393.4, 78.3]
splits = [54.7, 44.9, 65.9]
total = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = total / dur
print(_pf_fmt_fixed(1, pace))
mass = 79.0
accel = 5.5
push = mass * accel
limit = 152.0
print("over" if push > limit else "under")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
side = math.sqrt(16.0)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
tickets = [Parcel(100, "ada", 179, True), Parcel(101, "ada", 16, True), Parcel(102, "cy", 237, False), Parcel(103, "kit", 36, False)]
def surcharge(o):
    if o.urgent:
        _pf_t0 = o
        return Parcel(_pf_t0.id, _pf_t0.owner, o.amount + 7, _pf_t0.urgent)
    else:
        return o
print(_pf_map(lambda o: o.amount, _pf_map(surcharge, tickets)))
print(_pf_max_by(lambda o: o.amount, tickets))
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by_desc(lambda o: o.amount, tickets))))
