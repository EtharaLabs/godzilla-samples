from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Order:
    id: int
    owner: str
    amount: int
    urgent: bool
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    def __repr__(self):
        return "Emit"
_Emit = Emit()
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
_Push = Push()
def _ap_Above(n):
    if n > 13:
        return Some(n - 13)
    else:
        return _None_
def classify(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [-5, 11, 16, 22, 33]))
parcels = [Order(100, "max", 76, True), Order(101, "max", 31, True), Order(102, "eli", 15, True), Order(103, "ned", 269, True), Order(104, "max", 36, False)]
print(_pf_max_by(lambda o: o.amount, parcels))
def tag(_pf_arg0):
    id = _pf_arg0.id
    owner = _pf_arg0.owner
    return f"#{id} {_pf_str_upper(owner)}"
print(_pf_str_join(", ", _pf_map(tag, parcels)))
def priority(o):
    match o:
        case Order(urgent=True, amount=amount) if amount > 191:
            return "rush-big"
        case Order(urgent=True):
            return "rush"
        case Order(amount=amount):
            if amount > 191:
                return "big"
            else:
                return "normal"
print(_pf_map(priority, parcels))
print(_pf_count_by(priority, parcels))
def describe(t):
    match t:
        case Rest(n0) if n0 > 4:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Emit() | Push():
            return "emit/push"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Emit():
            return 7
        case _:
            return 3
stream = [Rest(0), Rest(-3), Rest(7), _Emit]
print(_pf_str_join("; ", _pf_map(describe, stream)))
total = _pf_sum_by(cost, stream)
print(f"total={total}")
print(_pf_max_by(cost, stream))
