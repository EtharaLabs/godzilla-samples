def explain(t):
    match t:
        case Push(n0) if 0 <= n0 < 3:
            return f"push!({n0})"
        case Push(n0):
            return f"push({n0})"
        case Pop(n0) if n0 > 4:
            return f"pop!({n0})"
        case Pop(n0):
