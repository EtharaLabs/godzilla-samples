from dataclasses import dataclass
from functools import total_ordering
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    def __repr__(self):
        return "Rest"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Rest = Rest()
def _ap_Above(n):
    if n > 11:
        return Some(n - 11)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [25, -3, 20, 37, -4, 8, 2, 1]))
segments = [410.4, 115.7, 166.8, 248.5, 345.2]
splits = [72.3, 35.9, 38.9, 19.4, 47.6]
total = _pf_fold(lambda acc, d: acc + d, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
pace = total / dur
print(_pf_fmt_fixed(1, pace))
mass = 13.0
accel = 6.5
push = mass * accel
limit = 73.0
print("over" if push > limit else "under")
side = math.sqrt(36.0)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
def explain(t):
    match t:
        case Skip(n0) if 0 <= n0 < 19:
            return f"skip!({n0})"
        case Skip(n0):
            return f"skip({n0})"
        case Store(n0):
            return f"store({n0})"
        case Rest():
            return f"rest"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Rest():
            return 7
        case _:
            return 3
stream = [Store(6), Store(6), Store(2), Skip(2), _Rest]
print(_pf_str_join("; ", _pf_map(explain, stream)))
grandSum = _pf_sum_by(score, stream)
print(f"grandSum={grandSum}")
print(_pf_sort(stream))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
obs = [11, 7, -8, 17]
print(Geo_mean(obs))
print(Geo_scaleAll(3, obs))
print(Geo_norm1(obs))
