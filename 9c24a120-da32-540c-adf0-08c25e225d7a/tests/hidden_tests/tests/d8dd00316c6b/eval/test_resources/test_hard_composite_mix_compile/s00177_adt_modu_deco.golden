def render(t):
    match t:
        case Skip(s0):
            return f"skip({s0})"
        case Emit(n0, s1) if n0 % 2 == 0:
            return f"emit!({n0},{s1})"
        case Emit(n0, s1):
            return f"emit({n0},{s1})"
        case Jump(2):
            return "jump-2"
        case Jump(n0):
            return f"jump({n0})"
        case Store(s0, n1):
            return f"store({s0},{n1})"
        case Rest(s0):
            return f"rest({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Emit(x0, _):
            return x0
        case Rest(_):
            return 2
        case _:
            return 1
