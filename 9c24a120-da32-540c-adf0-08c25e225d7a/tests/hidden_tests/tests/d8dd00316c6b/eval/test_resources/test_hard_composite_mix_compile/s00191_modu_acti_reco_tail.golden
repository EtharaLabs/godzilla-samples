from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@dataclass(frozen=True, slots=True)
class Site:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def Stats_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Stats_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Stats_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Stats_square(x):
    return x * x
obs = [6, -10, 20, 0, 16, 30]
print(Stats_scaleAll(5, obs))
print(Stats_mean(obs))
print(_pf_map(functools.partial(Stats_clamp, 0, 11), obs))
print(_pf_map(Stats_square, obs))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def classify(n):
    _pf_t0 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, _Even):
        return "even"
    elif isinstance(_pf_t0, _Odd):
        return "odd"
    else:
        raise RuntimeError("non-exhaustive match")
_pf_iter(print, _pf_map(classify, [27, 23, -5, 1, -3, -4]))
tickets = [Parcel(100, "ray", 290, True, Site("Riga", 2)), Parcel(101, "max", 171, True, Site("Doha", 4)), Parcel(102, "ray", 298, True, Site("Kyiv", 4)), Parcel(103, "max", 61, False, Site("Baku", 1))]
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn0, (0, 0), tickets)
print(f"{cnt} records, {sumAmt} total")
def classify2(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 99:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 99:
                return "big"
            else:
                return "normal"
print(_pf_map(classify2, tickets))
print(_pf_count_by(classify2, tickets))
def _pf_fn1(o):
    if o.dest.zone > 2:
        _pf_t3 = o
        return Parcel(_pf_t3.id, _pf_t3.owner, _pf_t3.amount, _pf_t3.urgent, Site("Hub", 1))
    else:
        return o
rerouted = _pf_map(_pf_fn1, tickets)
print(_pf_map(lambda o: f"{o.dest.city}/{o.dest.zone}", rerouted))
print(_pf_max_by(lambda o: o.amount, tickets))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(6724))
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(2561, 0))
