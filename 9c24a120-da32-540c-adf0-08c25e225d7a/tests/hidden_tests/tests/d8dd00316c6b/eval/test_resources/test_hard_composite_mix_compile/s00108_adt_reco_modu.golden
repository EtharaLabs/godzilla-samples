@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
def render(t):
    match t:
        case Push(s0):
            return f"push({s0})"
        case Emit(s0):
            return f"emit({s0})"
        case Store(s0):
            return f"store({s0})"
        case Halt():
            return f"halt"
        case Drop(s0):
            return f"drop({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Halt():
            return 1
        case Emit(_):
            return 5
        case Drop(_):
            return 7
        case _:
            return 2
stream = [Emit("quin"), _Halt, Emit("jo"), Emit("quin")]
print(_pf_str_join(" ", _pf_map(render, stream)))
tally = _pf_sum_by(weight, stream)
print(f"tally={tally}")
print((_pf_head(stream), _pf_last(stream)))
parcels = [Parcel(100, "fay", 295, False), Parcel(101, "quin", 264, True), Parcel(102, "quin", 44, True), Parcel(103, "quin", 239, True), Parcel(104, "ned", 11, True), Parcel(105, "ned", 82, False)]
def _pf_fn0(_pf_arg0):
    k, os = _pf_arg0
    return (k, len(os), _pf_sum_by(lambda o: o.amount, os))
byOwner = _pf_map(_pf_fn0, _pf_group_by(lambda o: o.owner, parcels))
