from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_split(sep, s):
    return s.split(sep)
def margin(price, qty):
    return price * qty - 4 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("cog", 22, 4), ("pin", 13, 1), ("rod", 23, 4)]))
print(overall)
text = "hub;tap;bo;hal;tom"
words = _pf_str_split(";", text)
count = len(words)
print(f"count={count} {{braces}} {len(text)}")
print((_pf_str_index_of("bo", text), "bo" in text))
print(_pf_map(lambda w: (w, len(w)), words))
def _pf_fn1():
    for x in _pf_range(1, 6):
        y = x * x
        yield y
    yield 182
evens = _pf_fn1()
print(_pf_fold(lambda a, b: a + b, 0, evens))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 7)))))
ticks = 0
def record(x):
    global ticks
    ticks = ticks + 1
    return x * 3
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([32, 27, -9, 18, 43, -6]))
doubled = _pf_map(record, [32, 27, -9, 18])
print(f"{doubled} after {ticks} calls")
