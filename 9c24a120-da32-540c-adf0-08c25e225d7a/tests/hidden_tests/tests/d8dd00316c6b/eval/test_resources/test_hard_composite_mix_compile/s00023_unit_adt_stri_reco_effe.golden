def show(t):
    match t:
        case Turn(s0):
            return f"turn({s0})"
        case Drop(s0):
            return f"drop({s0})"
        case Emit() | Rest():
            return "emit/rest"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Emit():
            return 9
        case _:
            return 1
