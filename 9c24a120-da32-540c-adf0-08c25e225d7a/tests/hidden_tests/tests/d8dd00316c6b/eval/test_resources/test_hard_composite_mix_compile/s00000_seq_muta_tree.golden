from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_flip(f, x, y):
    return f(y, x)
@dataclass(frozen=True, slots=True, repr=False)
class Leaf:
    def __repr__(self):
        return "Leaf"
_Leaf = Leaf()
@dataclass(frozen=True, slots=True, repr=False)
class Node:
    _0: object
    _1: int
    _2: object
    def __repr__(self):
        return f"Node({self._0!r}, {self._1!r}, {self._2!r})"
def _pf_fn0():
    for x in _pf_range(1, 12):
        y = x * x
        yield y
    yield 162
series = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, series))
print(list(_pf_seq_take(5, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
calls = 0
def track(x):
    global calls
    calls = calls + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([27, -2, 49, -12, 3]))
doubled = _pf_map(track, [27, -2, 49, -12])
print(f"{doubled} after {calls} calls")
def insert(x, t):
    match t:
        case Leaf():
            return Node(_Leaf, x, _Leaf)
        case Node(l, v, rt) if x < v:
            return Node(insert(x, l), v, rt)
        case Node(l, v, rt) if x > v:
            return Node(l, v, insert(x, rt))
        case Node(_, _, _):
            return t
        case _:
            raise RuntimeError("non-exhaustive match")
tree = _pf_fold(functools.partial(_pf_flip, insert), _Leaf, [37, 55, 6, 22, 35, 29, 31])
def toListT(t):
    match t:
        case Leaf():
            return []
        case Node(l, v, rt):
            return _pf_concat(toListT(l), _pf_concat([v], toListT(rt)))
        case _:
            raise RuntimeError("non-exhaustive match")
print(toListT(tree))
def minOf(t):
    while True:
        match t:
            case Leaf():
                return _None_
            case Node(Leaf(), v, _):
                return Some(v)
            case Node(l, _, _):
                t = l
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(minOf(tree))
def containsT(x, t):
    while True:
        match t:
            case Leaf():
                return False
            case Node(l, v, rt):
                if x == v:
                    return True
                elif x < v:
                    x, t = (x, l)
                    continue
                else:
                    x, t = (x, rt)
                    continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(_pf_map(lambda k: containsT(k, tree), [37, 32, 20]))
