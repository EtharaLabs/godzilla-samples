def describe(t):
    match t:
        case Mark(n0):
            return f"mark({n0})"
        case Store(s0, n1):
            return f"store({s0},{n1})"
        case Push(n0, s1):
            return f"push({n0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Store(_, x1):
            return x1
        case _:
            return 2
