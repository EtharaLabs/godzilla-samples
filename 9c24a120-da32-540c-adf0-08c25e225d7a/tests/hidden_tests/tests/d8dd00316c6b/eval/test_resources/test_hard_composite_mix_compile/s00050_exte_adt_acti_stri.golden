def show(t):
    match t:
        case Mark(n0) if n0 > 9:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Pop(n0) if n0 > 4:
            return f"pop!({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Load(s0, n1):
            return f"load({s0},{n1})"
        case Jump():
            return f"jump"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Pop(x0):
            return x0
        case Mark(x0):
            return x0 * 4
        case Jump():
            return 1
        case _:
            return 2
