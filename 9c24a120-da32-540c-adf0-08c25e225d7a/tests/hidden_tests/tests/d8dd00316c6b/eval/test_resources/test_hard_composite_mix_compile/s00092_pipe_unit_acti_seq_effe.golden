from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
readings = [11, 13, 3, 6, 47, 1, -3, 14, 11, 48, 19]
def shift(k, x):
    return x + k
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
answer = _pf_head(_pf_rev(_pf_map(functools.partial(shift, 7), _pf_sort(_pf_filter(lambda x: x > 8, _pf_fn1(_pf_take(5, readings)))))))
print(answer)
print(len(readings))
legs = [107.4, 426.8, 10.7, 395.1, 54.4]
times = [77.5, 50.8, 73.0, 24.2, 16.3]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, legs)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, times)
pace = dist / elapsed
print(_pf_fmt_fixed(2, pace))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, elapsed) * 1000.0))
side = math.sqrt(49.0)
cube = side * side * side
print(f"{side} {math.cbrt(cube)}")
def _pf_fn3(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn3, _pf_zip(legs, times))
print(best)
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
def _ap_Above(n):
    if n > 7:
        return Some(n - 7)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def classify(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(classify, [35, -6, 21, 5, 21, 8]))
def _pf_fn4():
    for x in _pf_range(1, 7):
        y = x * x
        yield y
    yield 174
series = _pf_fn4()
print(list(_pf_seq_take(3, map(lambda n: n + 1, series))))
print(list(_pf_seq_take(4, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 5)))))
def margin(price, qty):
    return price * qty - 8 * qty
def emit(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn5(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn5, [("nut", 50, 5), ("cog", 8, 1), ("cog", 10, 4), ("tap", 48, 1)]))
