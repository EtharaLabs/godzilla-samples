sentence = "pin,pam,tom,hub"
parts = _pf_str_split(",", sentence)
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
n2 = len(parts)
print(f"n2={n2} {{braces}} {len(sentence)}")
print((_pf_str_index_of("pi", sentence), "pi" in sentence))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, parts))))
print(_pf_str_replace("i", "I", sentence))
print(_pf_str_slice(0, 6, sentence))
def _pf_fn0():
    for x in _pf_range(1, 6):
        y = x * x
        yield y
    yield 199
evens = _pf_fn0()
print(list(_pf_seq_take(4, map(lambda n: n + 1, evens))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 5)))))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_square(x):
    return x * x
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [15, -14, -5, -10, -15, 11, 19]
print(Text_mean(pts))
print(_pf_map(Text_square, pts))
print(_pf_map(functools.partial(Text_clamp, 0, 11), pts))
print(Text_norm1(pts))
env = dict([("x", 8), ("y", 5)])
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Add(Num(1), Add(Num(1), Add(Num(0), Num(-2)))), Mul(Mul(Neg(Num(0)), Mul(Num(-1), Num(9))), Add(Num(0), Num(8)))]
_pf_iter(print, _pf_map(pretty, exprs))
print(_pf_map(calc, exprs))
