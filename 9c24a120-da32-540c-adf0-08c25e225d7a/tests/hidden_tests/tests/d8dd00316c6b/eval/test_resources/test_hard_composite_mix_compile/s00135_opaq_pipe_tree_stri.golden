        return f"Var({self._0!r})"
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("acc", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("u-1"))
samples = [-9, 24, 40, 19, 8, 33, 22, 37]
def addK(k, x):
    return x + k
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
