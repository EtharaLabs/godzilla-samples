    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
digest = len(_pf_map(functools.partial(addK, 9), (lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(_pf_sort(_pf_collect(lambda x: [x, x + 1], _pf_filter(lambda x: x > 8, _pf_fn1(samples)))))))
print(digest)
env = dict([("x", 1), ("y", 4)])
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
