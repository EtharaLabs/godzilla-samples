env = dict([("x", 3), ("y", 7)])
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def show(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({show(a)} + {show(b)})"
        case Mul(a, b):
            return f"{show(a)} * {show(b)}"
        case Neg(a):
            return f"-{show(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Neg(Neg(Mul(Num(8), Var("x")))), Add(Num(1), Var("x")), Add(Add(Num(0), Add(Var("y"), Num(-2))), Add(Num(0), Var("y")))]
_pf_iter(print, _pf_map(show, terms))
print(_pf_map(evalE, terms))
