def render(t):
    match t:
        case Emit(s0):
            return f"emit({s0})"
        case Mark():
            return f"mark"
        case Halt(n0, s1):
            return f"halt({n0},{s1})"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
