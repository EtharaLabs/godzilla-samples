from dataclasses import dataclass
import functools
import itertools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_drop_while(f, xs):
    return list(itertools.dropwhile(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_join(sep, xs):
    return sep.join(xs)
data = [4, 2, 10, 18, 5, 16, 24, 0, 21, 2]
result = _pf_fold(lambda acc, x: acc * 2 - x, 0, _pf_take(8, _pf_rev((lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(_pf_drop_while(lambda x: x < 4, _pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), data))))))
print(result)
def net(price, qty):
    return price * qty - 9 * qty
def announce(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("gear", 44, 6), ("wick", 40, 2), ("gear", 49, 4)]))
print(grand)
def _pf_fn1():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
    yield 149
squares = _pf_fn1()
print(list(_pf_seq_take(3, map(lambda n: n + 1, squares))))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
segments = [384.2, 388.2, 282.7, 142.5]
times = [29.7, 84.8, 47.7, 25.0]
total = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, segments)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
speed = total / dur
print(_pf_fmt_fixed(1, speed))
speeds = _pf_map2(lambda d, t: d / t, segments, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
edge = math.sqrt(2.25)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(total, dur) * 1000.0))
km = total / 1000.0
print(_pf_fmt_fixed(1, km))
