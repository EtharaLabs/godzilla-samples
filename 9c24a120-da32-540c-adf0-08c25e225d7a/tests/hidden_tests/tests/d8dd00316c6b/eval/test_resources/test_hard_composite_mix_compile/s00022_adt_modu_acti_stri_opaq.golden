from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Store:
    _0: int
    def __repr__(self):
        return f"Store({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    _1: str
    def __repr__(self):
        return f"Rest({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    _1: int
    def __repr__(self):
        return f"Skip({self._0!r}, {self._1!r})"
def describe(t):
    match t:
        case Store(n0) if 0 <= n0 < 14:
            return f"store!({n0})"
        case Store(n0):
            return f"store({n0})"
        case Rest(n0, s1):
            return f"rest({n0},{s1})"
        case Skip(1, _):
            return "skip-1"
        case Skip(n0, n1):
            return f"skip({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Rest(x0, _):
            return x0 * 2
        case Skip(x0, x1):
            return x0 + x1
        case _:
            return 2
queue = [Rest(-1, "hal"), Rest(-1, "oz"), Skip(2, 5), Skip(1, 9), Store(4), Store(-2), Rest(12, "fay")]
print(_pf_str_join("; ", _pf_map(describe, queue)))
total = _pf_sum_by(rank, queue)
print(f"total={total}")
print(len(_pf_filter(lambda t: rank(t) > 6, queue)))
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_square(x):
    return x * x
obs = [-1, -13, 10, 25, 7, -7, -7]
print(Calc_norm1(obs))
print(_pf_filter(functools.partial(Calc_between, 4, 16), obs))
print(_pf_map(Calc_square, obs))
def _ap_Above(n):
    if n > 14:
        return Some(n - 14)
    else:
        return _None_
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [31, 19, 31, 7, 1]))
sentence = "cap;tom;wick;kit;rod"
words = _pf_str_split(";", sentence)
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), words)))
print(_pf_str_join("|", _pf_map(_pf_str_upper, words)))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), words))
print(_pf_option_with_default("?", longest))
def rawOf(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("acc", 2)
print(_pf_str_join(" ", _pf_map(rawOf, ids)))
print(_pf_head(ids) == Some("u-1"))
