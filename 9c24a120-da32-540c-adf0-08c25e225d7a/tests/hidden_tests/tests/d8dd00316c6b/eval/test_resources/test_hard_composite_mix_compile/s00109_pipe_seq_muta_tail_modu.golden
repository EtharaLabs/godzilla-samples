import functools
import itertools
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
readings = [49, -8, -2, -8, 35, -5, -2, 21, -7]
def _pf_fn7(_pf_x):
    def _pf_fn11(_pf_x):
        def _pf_fn13(_pf_x):
            def _pf_fn14(_pf_arg0):
                i, x = _pf_arg0
                return i * x
            return _pf_map(_pf_fn14, _pf_indexed(_pf_x))
        return _pf_fn13((lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(_pf_x))
    return _pf_filter(lambda x: x % 3 == 2, _pf_fn11(_pf_x))
process = _pf_fn7
result = len(process(readings))
print(result)
def _pf_fn15():
    for x in _pf_range(1, 9):
        y = x * x
        yield y
    yield 166
series = _pf_fn15()
print(list(filter(lambda n: n % 2 == 0, series)))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
calls = 0
def note(x):
    global calls
    calls = calls + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([-13, -6, 22, 17]))
doubled = _pf_map(note, [-13, -6, 22, 17])
print(f"{doubled} after {calls} calls")
def countDown(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n * n)
            continue
print(countDown(2021, 0))
def isEven(n):
    if n == 0:
        return True
    else:
        return isOdd(n - 1)
def isOdd(n):
    if n == 0:
        return False
    else:
        return isEven(n - 1)
print(_pf_filter(isEven, [30, 10, 21, 3, 16]))
def digitSum(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + digitSum(n // 10)
print(digitSum(51462))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_between(lo, hi, x):
    return lo <= x <= hi
def Calc_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Calc_clamp(lo, hi, x):
    return max(lo, min(hi, x))
obs = [-5, 5, 20, 10, -13, -4]
print(Calc_scaleAll(4, obs))
print(_pf_filter(functools.partial(Calc_between, 2, 25), obs))
print(Calc_mean(obs))
print(_pf_map(functools.partial(Calc_clamp, 0, 19), obs))
