from dataclasses import dataclass
import functools
import itertools
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_indexed(xs):
    return list(enumerate(xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_fmt_pad_right(w, fill, s):
    return s.ljust(w, fill)
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_concat(a, b):
    return a + b
def _pf_str_split(sep, s):
    return s.split(sep)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
def net(price, qty):
    return price * qty - 8 * qty
def report(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("pin", 22, 2), ("wick", 31, 3), ("cap", 7, 6)]))
print(grand)
def _pf_fn1():
    for x in _pf_range(1, 6):
        y = x * x
        yield y
    yield 187
evens = _pf_fn1()
print(_pf_fold(lambda a, b: a + b, 0, evens))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 7)))))
vars = dict([("x", 3), ("y", 1)])
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case Var(v):
            return _pf_map_find_or(v, 0, vars)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
terms = [Add(Num(0), Add(Num(1), Mul(Var("y"), Num(7)))), Var("x")]
_pf_iter(print, _pf_map(render, terms))
print(_pf_map(evaluate, terms))
raw = "cap,quin,pam,gear"
parts = _pf_str_split(",", raw)
print(_pf_map(lambda w: (w, len(w)), parts))
n2 = len(parts)
print(f"n2={n2} {{braces}} {len(raw)}")
def row2(_pf_arg0):
    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(10, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(row2, _pf_indexed(parts)))
def Geo_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Geo_square(x):
    return x * x
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
obs = [-13, 24, 17, 29]
print(Geo_mean(obs))
print(_pf_map(Geo_square, obs))
print(_pf_filter(functools.partial(Geo_between, -4, 21), obs))
print(Geo_scaleAll(2, obs))
