from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_to_result(err, o):
    if isinstance(o, Some):
        return Ok(o._0)
    return Error(err)
def _pf_result_map_error(f, r):
    if isinstance(r, Error):
        return Error(f(r._0))
    return r
def _pf_result_to_option(r):
    if isinstance(r, Ok):
        return Some(r._0)
    return _None_
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_snd(p):
    return p[1]
@dataclass(frozen=True, slots=True)
class Place:
    city: str
    zone: int
@dataclass(frozen=True, slots=True)
class Invoice:
    id: int
    owner: str
    amount: int
    urgent: bool
    dest: object
def readPair(line):
    def _pf_fn0():
        match _pf_str_split("=", line):
            case [_k, _v]:
                _pf_t0 = Ok((_pf_str_strip(_k), _pf_str_strip(_v)))
            case _:
                _pf_t0 = Error(f"malformed: {line}")
        if isinstance(_pf_t0, Ok):
            k, v = _pf_t0._0
            _pf_t2 = _pf_option_to_result(f"not a number: {v}", _pf_str_to_int(v))
            if isinstance(_pf_t2, Ok):
                n = _pf_t2._0
                _pf_t1 = Error("negative") if n < 0 else Ok(n)
                if isinstance(_pf_t1, Ok):
                    checked = _pf_t1._0
                    return Ok((k, checked))
                else:
                    return _pf_t1
            else:
                return _pf_t2
        else:
            return _pf_t0
    return _pf_fn0()
inputs = ["bo=x", "kit=8=1", "ivy=x", "jo = 2"]
results = _pf_map(readPair, inputs)
_pf_iter(print, results)
goodOnes = _pf_choose(_pf_result_to_option, results)
print(sum(_pf_map(_pf_snd, goodOnes)))
def sumAll(xs):
    def _pf_fn2(acc, r):
        def _pf_fn3():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
                    return r
            else:
                return acc
        return _pf_fn3()
    return _pf_fold(_pf_fn2, Ok(0), xs)
print(_pf_result_map_error(_pf_str_upper, sumAll(results)))
ticks = 0
def note(x):
    global ticks
    ticks = ticks + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-1, 56, 55, 46, 42, 31, 9]))
doubled = _pf_map(note, [-1, 56, 55, 46])
print(f"{doubled} after {ticks} calls")
book = [Invoice(100, "ivy", 271, True, Place("Oslo", 4)), Invoice(101, "max", 94, True, Place("Rome", 3)), Invoice(102, "gus", 117, True, Place("Bern", 4)), Invoice(103, "gus", 243, False, Place("Rome", 3)), Invoice(104, "gus", 161, True, Place("Bern", 4)), Invoice(105, "gus", 132, True, Place("Rome", 3))]
def _pf_fn4(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, amt = _pf_fold(_pf_fn4, (0, 0), book)
print(f"{cnt} records, {amt} total")
cheap, dear = _pf_partition(lambda o: o.amount < 140, book)
print(f"{len(cheap)} cheap, {len(dear)} dear")
print(_pf_map(lambda o: o.id, _pf_take(3, _pf_sort_by(lambda o: o.amount, book))))
print(_pf_max_by(lambda o: o.amount, book))
