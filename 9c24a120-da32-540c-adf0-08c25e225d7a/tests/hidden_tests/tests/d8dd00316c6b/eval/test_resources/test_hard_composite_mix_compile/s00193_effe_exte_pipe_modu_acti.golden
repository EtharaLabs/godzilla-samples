from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_exists(f, xs):
    return any(map(f, xs))
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_rev(xs):
    return list(reversed(xs))
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def margin(price, qty):
    return price * qty - 7 * qty
def report(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("pin", 10, 5), ("tap", 27, 6)]))
print(overall)
def fromBin(s):
    return int(s, base=2)
print(fromBin("1001101") + int("125", base=8))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
print(_pf_map(math.isqrt, [247, 262, 289, 182]))
readings = [32, -9, -2, 27, 28, 40, 3, 5]
def shift(k, x):
    return x + k
outcome = _pf_exists(lambda x: x > 24, _pf_filter(lambda x: x % 4 == 3, _pf_map(lambda b: 4 + b, _pf_rev(_pf_filter(lambda x: x > -5, readings)))))
print(outcome)
print(len(readings))
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Geo_square(x):
    return x * x
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
obs = [15, 21, 13, 25]
print(_pf_map(functools.partial(Geo_clamp, 0, 14), obs))
print(_pf_map(Geo_square, obs))
print(Geo_norm1(obs))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 21:
        return Some(n - 21)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(bucketOf, [38, 37, 28, 28, 13, 25, 8, 18]))
