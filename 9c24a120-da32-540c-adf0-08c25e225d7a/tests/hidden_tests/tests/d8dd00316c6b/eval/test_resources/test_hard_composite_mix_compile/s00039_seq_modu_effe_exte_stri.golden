from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
def _pf_fn0():
    for x in _pf_range(1, 12):
        y = x * x
        yield y
squares = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, squares))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 7)))))
def Geo_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_square(x):
    return x * x
pts = [24, 10, -13, 19, 2, 1, -14]
print(Geo_scaleAll(5, pts))
print(_pf_filter(functools.partial(Geo_between, 2, 14), pts))
print(Geo_norm1(pts))
print(_pf_map(Geo_square, pts))
def margin(price, qty):
    return price * qty - 6 * qty
def announce(label, price, qty):
    print(f"{label}: {margin(price, qty)}")
    return margin(price, qty)
def _pf_fn1(_pf_arg0):
    n, pr, q = _pf_arg0
    return announce(n, pr, q)
grand = sum(_pf_map(_pf_fn1, [("cog", 13, 4), ("rod", 17, 2), ("cap", 25, 1), ("cog", 10, 6)]))
print(grand)
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x8", "-3"]))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "7"])))
sentence = "jo tom quin gus eli rod nut"
tokens = _pf_str_split(" ", sentence)
nums = _pf_map(_pf_str_to_int, _pf_str_split(",", "-3,x,-3,-3,40"))
print(nums)
print(sum(_pf_choose(_pf_id, nums)))
print(_pf_map(lambda w: (w, len(w)), tokens))
print((_pf_str_index_of("nu", sentence), "nu" in sentence))
