    return a * b // math.gcd(a, b)
print(_pf_fold(lcm, 1, [11, 6, 11, 10]))
print(_pf_map(math.isqrt, [194, 364, 305, 125]))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x1", "-24"]))
def fromBin(s):
    return int(s, base=2)
print(fromBin("1100010") + int("113", base=8))
def describe(t):
    match t:
        case Store(s0):
            return f"store({s0})"
        case Turn(n0):
            return f"turn({n0})"
        case Rest():
            return f"rest"
        case Emit(n0):
            return f"emit({n0})"
        case Mark(n0, n1) if n0 > 1:
            return f"mark!({n0},{n1})"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Store(_):
            return 2
        case Turn(x0):
            return x0 * 2
        case Rest():
            return 2
        case Emit(x0):
            return x0 * 5
        case _:
            return 0
stream = [Store("oz"), _Rest, Store("oz"), Emit(-1), Mark(0, 2)]
_pf_iter(lambda t: print(describe(t)), stream)
total = _pf_sum_by(cost, stream)
print(f"total={total}")
print(_pf_max_by(cost, stream))
