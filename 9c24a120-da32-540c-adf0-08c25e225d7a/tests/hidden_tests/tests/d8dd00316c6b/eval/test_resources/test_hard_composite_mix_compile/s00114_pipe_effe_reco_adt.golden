data = [24, 5, 17, 35, 33, -6, 20, 40, 48]
def keep(n):
    return n > 2 and n % 3 != 0
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        i, x = _pf_arg0
        return i * x
    return _pf_map(_pf_fn2, _pf_indexed(_pf_x))
outcome = _pf_sum_by(lambda x: x * x, _pf_fn1((lambda _pf_x: _pf_map(lambda w: _pf_option_with_default(0, _pf_max(w)), _pf_windowed(2, _pf_x)))(_pf_filter(lambda x: x % 3 == 0, (lambda _pf_x: _pf_map(sum, _pf_chunk(5, _pf_x)))(data)))))
