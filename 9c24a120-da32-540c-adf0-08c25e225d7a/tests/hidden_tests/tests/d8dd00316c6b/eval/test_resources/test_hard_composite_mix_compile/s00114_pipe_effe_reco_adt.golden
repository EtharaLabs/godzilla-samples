def show(t):
    match t:
        case Rest(n0):
            return f"rest({n0})"
        case Load():
            return f"load"
        case Mark():
            return f"mark"
        case Drop(n0, n1) if 0 <= n0 < 18:
            return f"drop!({n0},{n1})"
        case Drop(n0, n1):
            return f"drop({n0},{n1})"
        case Emit(s0, n1):
            return f"emit({s0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Load():
            return 1
        case Mark():
            return 1
        case _:
            return 1
