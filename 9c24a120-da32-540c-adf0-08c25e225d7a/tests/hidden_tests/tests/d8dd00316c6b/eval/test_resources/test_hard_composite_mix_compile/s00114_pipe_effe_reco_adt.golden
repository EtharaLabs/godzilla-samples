def classify(o):
    match o:
        case Booking(urgent=True, amount=amount) if amount > 96:
            return "rush-big"
        case Booking(urgent=True):
            return "rush"
        case Booking(amount=amount):
            if amount > 96:
                return "big"
            else:
                return "normal"
