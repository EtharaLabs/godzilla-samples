from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_chunk(n, xs):
    if n <= 0:
        return []
    out = []
    for i in range(0, len(xs), n):
        out.append(xs[i:i + n])
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_pairwise(xs):
    return list(zip(xs, xs[1:len(xs)]))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max(xs):
    return Some(max(xs)) if xs else _None_
def _ap_Above(n):
    if n > 6:
        return Some(n - 6)
    else:
        return _None_
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(kindOf, [2, 7, 15, 0, 20]))
readings = [29, 38, 21, 3, 20, 25, 17, 50, 11, 49]
def _pf_fn1(_pf_x):
    def _pf_fn2(_pf_arg0):
        a, b = _pf_arg0
        return b - a
    return _pf_map(_pf_fn2, _pf_pairwise(_pf_x))
result = _pf_max((lambda _pf_x: _pf_map(sum, _pf_chunk(4, _pf_x)))(_pf_fn1(_pf_choose(lambda x: (Some(x // 2) if x % 2 == 0 else _None_), _pf_sort_by(lambda x: -x, readings)))))
print(result)
print(len(readings))
def euclid(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(euclid(136, 452))
def sumDigits(n):
    match n:
        case 0:
            return 0
        case _:
            return n % 10 + sumDigits(n // 10)
print(sumDigits(51880))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_square(x):
    return x * x
def Text_between(lo, hi, x):
    return lo <= x <= hi
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
pts = [-2, 21, -7, 19]
print(_pf_map(functools.partial(Text_clamp, 0, 18), pts))
print(_pf_map(Text_square, pts))
print(_pf_filter(functools.partial(Text_between, 0, 16), pts))
print(Text_norm1(pts))
laps = [226.7, 355.8, 109.8, 230.9]
splits = [10.3, 80.8, 31.5, 9.4]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = dist / dur
print(_pf_fmt_fixed(2, rate))
km = dist / 1000.0
print(_pf_fmt_fixed(1, km))
edge = math.sqrt(49.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
