from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_partition(f, xs):
    yes = []
    no = []
    for x in xs:
        if f(x):
            yes.append(x)
        else:
            no.append(x)
    return (yes, no)
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_fmt_pad_left(w, fill, s):
    return s.rjust(w, fill)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_union(a, b):
    out = dict(a)
    out.update(b)
    return out
def _pf_set_difference(a, b):
    return a.difference(b)
def _pf_set_is_subset(a, b):
    return a.issubset(b)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
def Text_norm1(xs):
    return sum(_pf_map(abs, xs))
def Text_clamp(lo, hi, x):
    return max(lo, min(hi, x))
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
pts = [4, 26, 17, 26, 23, 1, -9]
print(Text_norm1(pts))
print(_pf_map(functools.partial(Text_clamp, 0, 12), pts))
print(Text_mean(pts))
log = ["eli", "fay", "eli", "dee", "ada", "fay", "fay", "bo", "ada", "dee"]
m = dict()
for w in log:
    _pf_t0 = _pf_map_find_or(w, 0, m) + 1
    m[w] = _pf_t0
counts = m
def _pf_fn0(_pf_arg0):
    k, v = _pf_arg0
    return (-v, k)
print(_pf_sort_by(_pf_fn0, _pf_map_to_list(counts)))
extra = dict([("zed", 5), ("eli", 0)])
print(_pf_sort(_pf_map_to_list(_pf_map_union(extra, counts))))
sa = set([3, 9, 14, 15, 16, 17])
sb = set([1, 10, 11, 13, 14, 16])
print(_pf_sort(list(_pf_set_difference(sa, sb))))
print((len(sa), 14 in sb, _pf_set_is_subset(set([3]), sa)))
parcels = [Booking(100, "ned", 11, True), Booking(101, "ned", 49, True), Booking(102, "ivy", 66, True), Booking(103, "ned", 58, False), Booking(104, "ned", 77, False)]
cheap, dear = _pf_partition(lambda o: o.amount < 90, parcels)
print(f"{len(cheap)} cheap, {len(dear)} dear")
def label(o):
    id = o.id
    amount = o.amount
    return f"#{id}:{_pf_fmt_pad_left(5, " ", str(amount))}"
print(_pf_str_join(", ", _pf_map(label, parcels)))
def _pf_fn1(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn1, (0, 0), parcels)
print(f"{cnt} records, {sumAmt} total")
def rawOf(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
keys = makeIds("sku", 4)
print(_pf_str_join(" ", _pf_map(rawOf, keys)))
print(_pf_head(keys) == Some("acc-1"))
