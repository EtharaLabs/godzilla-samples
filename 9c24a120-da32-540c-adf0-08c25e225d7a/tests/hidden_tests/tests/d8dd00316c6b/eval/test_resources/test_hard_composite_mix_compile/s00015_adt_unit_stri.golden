from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: str
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    def __repr__(self):
        return f"Rest({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
def describe(t):
    match t:
        case Turn(s0):
            return f"turn({s0})"
        case Rest(3):
            return "rest-3"
        case Rest(n0):
            return f"rest({n0})"
        case Skip(s0):
            return f"skip({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Skip(_):
            return 8
        case _:
            return 3
batch = [Skip("ivy"), Rest(6), Rest(5), Turn("lu"), Skip("tom"), Rest(2), Rest(8)]
_pf_iter(lambda t: print(describe(t)), batch)
tally = _pf_sum_by(rank, batch)
print(f"tally={tally}")
print(_pf_max_by(rank, batch))
laps = [132.1, 312.5, 77.4]
times = [80.0, 74.8, 73.9]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
speed = dist / dur
print(_pf_fmt_fixed(1, speed))
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(laps, times))
print(best)
speeds = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
text = "nut,jo,kit,fay,quin,tap,tom"
parts = _pf_str_split(",", text)
print(_pf_map(lambda w: (w, len(w)), parts))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), parts))
print(_pf_option_with_default("?", longest))
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, parts))))
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), parts)))
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", "40,12,7,-3,7"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
