    def __repr__(self):
        return f"Jump({self._0!r})"
def _pf_fn0():
    for x in _pf_range(1, 8):
        y = x * x
        yield y
    yield 130
squares = _pf_fn0()
print(list(filter(lambda n: n % 2 == 0, squares)))
print(list(_pf_seq_take(3, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 2)))))
legs = [294.6, 264.9, 112.2]
splits = [12.0, 43.6, 41.7]
dist = _pf_fold(lambda acc, d: acc + d * 1.0, 0.0, legs)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
speed = dist / dur
