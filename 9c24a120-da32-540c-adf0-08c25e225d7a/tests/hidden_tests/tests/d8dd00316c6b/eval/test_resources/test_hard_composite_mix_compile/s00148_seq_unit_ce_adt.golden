def render(t):
    match t:
        case Rest(s0):
            return f"rest({s0})"
        case Mark(s0):
            return f"mark({s0})"
        case Emit(n0, n1):
            return f"emit({n0},{n1})"
        case Jump(n0):
            return f"jump({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Jump(x0):
            return x0
        case Rest(_):
            return 8
        case Emit(x0, x1):
            return x0 + x1
        case _:
            return 3
