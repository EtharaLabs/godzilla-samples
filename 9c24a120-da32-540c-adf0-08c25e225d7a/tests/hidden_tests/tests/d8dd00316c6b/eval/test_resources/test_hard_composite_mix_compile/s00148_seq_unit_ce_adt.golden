print(f"{side} {math.cbrt(cube)}")
def parseEntry(line):
    def _pf_fn2():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
        if isinstance(_pf_t1, Some):
            v = _pf_t1._0
