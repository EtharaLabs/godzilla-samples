def explain(t):
    match t:
        case Emit(n0) if n0 % 2 == 0:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Rest(n0) if n0 % 2 == 0:
            return f"rest!({n0})"
        case Rest(n0):
            return f"rest({n0})"
        case Pop(n0) if n0 % 2 == 0:
            return f"pop!({n0})"
        case Pop(n0):
            return f"pop({n0})"
        case Store(n0, s1) if n0 % 2 == 0:
            return f"store!({n0},{s1})"
        case Store(n0, s1):
            return f"store({n0},{s1})"
        case Turn(n0):
            return f"turn({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Emit(x0):
            return x0
        case _:
            return 1
queue = [Emit(7), Store(3, "tom"), Turn(6), Pop(5)]
print(_pf_str_join("; ", _pf_map(explain, queue)))
grandSum = _pf_sum_by(weight, queue)
print(f"grandSum={grandSum}")
print(_pf_max_by(weight, queue))
parcels = [Order(100, "oz", 254, True), Order(101, "oz", 95, True), Order(102, "dee", 259, True), Order(103, "quin", 215, True), Order(104, "dee", 197, True)]
