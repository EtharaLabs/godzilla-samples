print(f"{len(cheap)} cheap, {len(dear)} dear")
def classify(o):
    match o:
        case Order(urgent=True, amount=amount) if amount > 138:
            return "rush-big"
        case Order(urgent=True):
            return "rush"
        case Order(amount=amount):
            if amount > 138:
                return "big"
            else:
                return "normal"
print(_pf_map(classify, parcels))
print(_pf_count_by(classify, parcels))
def line(_pf_arg0):
