def explain(t):
    match t:
        case Rest(s0):
            return f"rest({s0})"
        case Push():
            return f"push"
        case Emit(n0):
            return f"emit({n0})"
        case Skip() | Load():
            return "skip/load"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Rest(_):
            return 8
        case Load():
            return 1
        case _:
            return 3
prog = [Emit(9), _Skip, Rest("quin"), _Load, Emit(-1), _Push]
print(_pf_str_join(" ", _pf_map(explain, prog)))
total = _pf_sum_by(cost, prog)
print(f"total={total}")
print(len(_pf_filter(lambda t: cost(t) > 3, prog)))
def evaluate(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evaluate(a) + evaluate(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return evaluate(a) * evaluate(b)
        case Neg(a):
            return -evaluate(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def pretty(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({pretty(a)} + {pretty(b)})"
        case Mul(a, b):
            return f"{pretty(a)} * {pretty(b)}"
        case Neg(a):
            return f"-{pretty(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
def simplify(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(simplify(a), simplify(b))
            case Mul(a, b):
                return Mul(simplify(a), simplify(b))
            case _:
                return e
exprs = [Add(Num(2), Neg(Num(0))), Neg(Add(Mul(Num(2), Num(5)), Add(Num(0), Num(6)))), Add(Num(1), Num(3))]
_pf_iter(print, _pf_map(pretty, _pf_map(simplify, exprs)))
print(_pf_map(evaluate, exprs))
