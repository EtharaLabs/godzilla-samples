def explain(t):
    match t:
        case Mark(s0):
            return f"mark({s0})"
        case Jump(n0):
            return f"jump({n0})"
        case Rest():
            return f"rest"
        case Emit(n0, n1):
            return f"emit({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Jump(x0):
            return x0
        case Mark(_):
            return 7
        case Emit(x0, x1):
            return x0 + x1
        case _:
            return 2
