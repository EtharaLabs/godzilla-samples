from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: str
    def __repr__(self):
        return f"Pop({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: str
    _1: str
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    _0: int
    def __repr__(self):
        return f"Jump({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rest:
    _0: int
    _1: int
    def __repr__(self):
        return f"Rest({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: str
    _1: str
    def __repr__(self):
        return f"Turn({self._0!r}, {self._1!r})"
def fromBin(s):
    return int(s, base=2)
print(fromBin("10011") + int("141", base=8))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(7))
print(_pf_str_rev(str.upper("oz")))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "1a"])))
def discount(price, qty):
    return price * qty - 9 * qty
def report(label, price, qty):
    print(f"{label}: {discount(price, qty)}")
    return discount(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return report(n, pr, q)
overall = sum(_pf_map(_pf_fn0, [("wick", 12, 1), ("hub", 34, 2), ("gear", 23, 6), ("gear", 19, 5)]))
print(overall)
def render(t):
    match t:
        case Pop(s0):
            return f"pop({s0})"
        case Mark(s0, s1):
            return f"mark({s0},{s1})"
        case Jump(1):
            return "jump-1"
        case Jump(n0):
            return f"jump({n0})"
        case Rest(2, _):
            return "rest-2"
        case Rest(n0, n1):
            return f"rest({n0},{n1})"
        case Turn(s0, s1):
            return f"turn({s0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Jump(x0):
            return x0
        case _:
            return 0
batch = [Mark("kit", "fay"), Jump(1), Mark("lu", "ivy"), Mark("dee", "ned"), Mark("hal", "ned"), Jump(5), Rest(7, 11)]
_pf_iter(lambda t: print(render(t)), batch)
tally = _pf_sum_by(cost, batch)
print(f"tally={tally}")
print(_pf_max_by(cost, batch))
laps = [180.7, 270.0, 265.7, 378.1]
times = [85.8, 52.9, 66.3, 66.7]
dist = _pf_fold(lambda a, b: a + b, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, times)
rate = dist / dur
print(_pf_fmt_fixed(2, rate))
edge = math.sqrt(25.0)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def _pf_fn1(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn1, _pf_zip(laps, times))
print(best)
speeds = _pf_map2(lambda d, t: d / t, laps, times)
print(_pf_str_join(" ", _pf_map(functools.partial(_pf_fmt_fixed, 2), speeds)))
def paceOf(d, t):
    return t / d
print(_pf_fmt_fixed(3, paceOf(dist, dur) * 1000.0))
