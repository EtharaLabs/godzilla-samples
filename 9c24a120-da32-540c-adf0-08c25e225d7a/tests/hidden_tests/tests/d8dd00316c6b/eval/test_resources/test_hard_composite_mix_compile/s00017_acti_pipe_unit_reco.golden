laps = [231.1, 181.0, 406.2]
splits = [18.8, 31.0, 40.6]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
dur = _pf_fold(lambda a, b: a + b, 0.0, splits)
rate = dist / dur
print(_pf_fmt_fixed(1, rate))
