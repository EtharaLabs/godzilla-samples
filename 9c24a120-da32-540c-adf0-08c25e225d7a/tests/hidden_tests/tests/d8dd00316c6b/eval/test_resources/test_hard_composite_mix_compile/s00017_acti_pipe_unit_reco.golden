book = [Ticket(100, "ada", 134, True), Ticket(101, "ada", 209, False), Ticket(102, "ada", 21, True), Ticket(103, "gus", 126, True), Ticket(104, "ada", 77, False)]
def bucket(o):
    match o:
        case Ticket(urgent=True, amount=amount) if amount > 84:
            return "rush-big"
        case Ticket(urgent=True):
            return "rush"
        case Ticket(amount=amount):
            if amount > 84:
                return "big"
            else:
                return "normal"
