                        def _pf_fn126(_pf_arg0):
                            a, b = _pf_arg0
                            return b - a
                        return _pf_map(_pf_fn126, _pf_pairwise(_pf_x))
                    return _pf_filter(lambda x: x % 3 == 2, _pf_fn125(_pf_x))
                return _pf_map(lambda b: 36 - b, _pf_fn123(_pf_x))
            return _pf_rev(_pf_fn119(_pf_x))
        return _pf_choose(lambda x: (Some(x // 3) if x % 3 == 0 else _None_), _pf_fn111(_pf_x))
    return _pf_take_while(lambda x: x < 54, _pf_fn95(_pf_x))
