from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
env = dict([("x", 1), ("y", 4)])
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(Num(0), _) | Mul(_, Num(0)):
            return 0
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def show(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({show(a)} + {show(b)})"
        case Mul(a, b):
            return f"{show(a)} * {show(b)}"
        case Neg(a):
            return f"-{show(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
def simplify(e):
    while True:
        match e:
            case Add(Num(0), x) | Add(x, Num(0)):
                e = x
                continue
            case Mul(Num(1), x) | Mul(x, Num(1)):
                e = x
                continue
            case Neg(Neg(x)):
                e = x
                continue
            case Add(a, b):
                return Add(simplify(a), simplify(b))
            case Mul(a, b):
                return Mul(simplify(a), simplify(b))
            case _:
                return e
exprs = [Mul(Var("x"), Add(Num(0), Neg(Var("y")))), Num(-2), Add(Var("x"), Add(Num(0), Neg(Num(8))))]
_pf_iter(print, _pf_map(show, _pf_map(simplify, exprs)))
print(_pf_map(calc, exprs))
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("sku", 4)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("u-1"))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(5, 13, 1))
def gcdLoop(a, b):
    while True:
        if b == 0:
            return a
        else:
            a, b = (b, a % b)
            continue
print(gcdLoop(233, 422))
