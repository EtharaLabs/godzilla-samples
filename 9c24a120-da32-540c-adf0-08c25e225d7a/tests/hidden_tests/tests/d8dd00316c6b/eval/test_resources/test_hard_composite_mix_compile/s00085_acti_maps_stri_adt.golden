def show(t):
    match t:
        case Turn(s0):
            return f"turn({s0})"
        case Jump(n0):
            return f"jump({n0})"
        case Halt(s0):
            return f"halt({s0})"
        case Drop(n0) if 0 <= n0 < 9:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case Store(n0, n1):
            return f"store({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Jump(x0):
            return x0
        case Store(x0, x1):
            return x0 + x1
        case Drop(x0):
            return x0
        case Turn(_):
            return 7
        case _:
            return 3
batch = [Drop(11), Drop(9), Halt("hal"), Turn("jo"), Drop(1)]
print(_pf_str_join("; ", _pf_map(show, batch)))
grandSum = _pf_sum_by(cost, batch)
print(f"grandSum={grandSum}")
print(len(_pf_filter(lambda t: cost(t) > 6, batch)))
