    i, w = _pf_arg0
    return _pf_str_concat(_pf_fmt_pad_right(9, ".", w), _pf_fmt_pad_left(4, " ", str(i + 1)))
_pf_iter(print, _pf_map(cell, _pf_indexed(tokens)))
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", ",x,,,"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
print(_pf_map(lambda w: (w, len(w)), tokens))
count = len(tokens)
print(f"count={count} {{braces}} {len(sentence)}")
print((_pf_str_index_of("pi", sentence), "pi" in sentence))
