def render(t):
    match t:
        case Jump(n0) if 0 <= n0 < 11:
            return f"jump!({n0})"
        case Jump(n0):
            return f"jump({n0})"
        case Turn(s0):
            return f"turn({s0})"
        case Store(s0, s1):
            return f"store({s0},{s1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Turn(_):
            return 1
        case _:
            return 2
