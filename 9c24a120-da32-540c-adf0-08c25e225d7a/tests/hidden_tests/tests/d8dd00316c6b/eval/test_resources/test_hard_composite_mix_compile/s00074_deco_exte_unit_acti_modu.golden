from dataclasses import dataclass
import functools
import json
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_map2(f, xs, ys):
    out = []
    for p in zip(xs, ys):
        out.append(f(p[0], p[1]))
    return out
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_dec_bool(v):
    if isinstance(v, bool):
        return v
    raise ValueError("expected a bool, got " + type(v).__name__)
def _pf_dec_field(name, dec):
    def go(v):
        if not isinstance(v, dict):
            raise ValueError("expected a JSON object")
        return dec(v[name])
    return go
def _pf_dec_int(v):
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    raise ValueError("expected an int, got " + type(v).__name__)
def _pf_dec_map3(f, da, db, dc):
    def go(v):
        return f(da(v), db(v), dc(v))
    return go
def _pf_dec_string(v):
    if isinstance(v, str):
        return v
    raise ValueError("expected a string, got " + type(v).__name__)
