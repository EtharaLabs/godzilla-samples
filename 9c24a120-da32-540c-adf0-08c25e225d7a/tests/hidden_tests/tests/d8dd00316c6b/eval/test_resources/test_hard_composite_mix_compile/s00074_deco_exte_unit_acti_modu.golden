def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 29:
        return Some(n - 29)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t9 = _ap_Above(n)
    _pf_t10 = _ap_Zero(n)
    _pf_t11 = _ap_Even_Odd(n)
    if isinstance(_pf_t9, Some):
