from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_distinct_by(f, xs):
    seen = set()
    out = []
    for x in xs:
        k = f(x)
        if not k in seen:
            seen.add(k)
            out.append(x)
    return out
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_forall(f, xs):
    return all(map(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_take(n, xs):
    return xs[0:max(n, 0)]
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
samples = [29, 8, 29, 33, 26, 41, -3, 32, 14, 43]
def addK(k, x):
    return x + k
def isBig(n):
    return n > 20 and n % 3 != 0
result = _pf_forall(lambda x: x >= 0, _pf_filter(lambda x: x % 2 == 1, _pf_map(lambda b: 5 + b, _pf_take(3, _pf_distinct_by(lambda x: x % 3, samples)))))
print(result)
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 17:
        return Some(n - 17)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(bucketOf, [33, 12, 7, 12, 14, 6, 11, 5]))
def rawOf(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("u", 4)
print(_pf_str_join(" ", _pf_map(rawOf, ids)))
print(_pf_head(ids) == Some("acc-1"))
def net(price, qty):
    return price * qty - 2 * qty
def emit(label, price, qty):
    print(f"{label}: {net(price, qty)}")
    return net(price, qty)
def _pf_fn0(_pf_arg0):
    n, pr, q = _pf_arg0
    return emit(n, pr, q)
grand = sum(_pf_map(_pf_fn0, [("tap", 18, 5), ("nut", 15, 6), ("bolt", 41, 1), ("pin", 9, 1)]))
print(grand)
def scaled(k):
    return functools.partial(_pf_map, functools.partial(net, k))
print(scaled(6)([1, 2, 3]))
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-18, -4, 39, 22, 16]))
doubled = _pf_map(record, [-18, -4, 39, 22])
print(f"{doubled} after {hits} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), hits))
