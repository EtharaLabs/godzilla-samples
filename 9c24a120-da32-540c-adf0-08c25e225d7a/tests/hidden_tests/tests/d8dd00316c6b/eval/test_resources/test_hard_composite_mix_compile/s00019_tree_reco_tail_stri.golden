from dataclasses import dataclass
import functools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_count_by(f, xs):
    counts = dict()
    for x in xs:
        k = f(x)
        counts[k] = counts.get(k, 0) + 1
    return list(counts.items())
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_rev(xs):
    return list(reversed(xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_map_find_or(k, default, m):
    return m.get(k, default)
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_index_of(sub, s):
    i = s.find(sub)
    return Some(i) if i >= 0 else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_rev(s):
    return "".join(reversed(s))
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Var:
    _0: str
    def __repr__(self):
        return f"Var({self._0!r})"
@dataclass(frozen=True, slots=True)
class Parcel:
    id: int
    owner: str
    amount: int
    urgent: bool
env = dict([("x", 4), ("y", -3)])
def calc(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return calc(a) + calc(b)
        case Mul(a, b):
            return calc(a) * calc(b)
        case Neg(a):
            return -calc(a)
        case Var(v):
            return _pf_map_find_or(v, 0, env)
        case _:
            raise RuntimeError("non-exhaustive match")
def show(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({show(a)} + {show(b)})"
        case Mul(a, b):
            return f"{show(a)} * {show(b)}"
        case Neg(a):
            return f"-{show(a)}"
        case Var(v):
            return v
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Var("y"), Add(Num(1), Add(Add(Num(5), Num(1)), Add(Num(1), Num(4)))), Mul(Add(Num(1), Add(Num(6), Num(9))), Num(9))]
_pf_iter(print, _pf_map(show, exprs))
print(_pf_map(calc, exprs))
book = [Parcel(100, "gus", 198, True), Parcel(101, "gus", 132, False), Parcel(102, "cy", 217, True), Parcel(103, "bo", 10, True)]
def _pf_fn0(_pf_arg0, o):
    n, s = _pf_arg0
    return (n + 1, s + o.amount)
cnt, sumAmt = _pf_fold(_pf_fn0, (0, 0), book)
print(f"{cnt} records, {sumAmt} total")
def bucket(o):
    match o:
        case Parcel(urgent=True, amount=amount) if amount > 129:
            return "rush-big"
        case Parcel(urgent=True):
            return "rush"
        case Parcel(amount=amount):
            if amount > 129:
                return "big"
            else:
                return "normal"
print(_pf_map(bucket, book))
print(_pf_count_by(bucket, book))
print(_pf_max_by(lambda o: o.amount, book))
def collatz(n, acc):
    while True:
        if n == 1:
            return acc
        elif n % 2 == 0:
            n, acc = (n // 2, acc + 1)
            continue
        else:
            n, acc = (3 * n + 1, acc + 1)
            continue
print(_pf_map(lambda n: collatz(n, 0), [45, 55, 15]))
def powAcc(b, e, acc):
    while True:
        match e:
            case 0:
                return acc
            case k if k % 2 == 1:
                b, e, acc = (b, k - 1, acc * b)
                continue
            case k:
                b, e, acc = (b * b, k // 2, acc)
                continue
print(powAcc(4, 6, 1))
text = "hal jo oz nut max bolt"
tokens = _pf_str_split(" ", text)
print(_pf_str_join("", _pf_map(lambda w: _pf_str_upper(_pf_str_slice(0, 1, w)), tokens)))
print((_pf_str_index_of("bo", text), "bo" in text))
print(_pf_map(lambda w: (w, len(w)), tokens))
print(_pf_str_join("|", _pf_map(_pf_str_upper, tokens)))
print(_pf_str_join(" ", _pf_rev(_pf_map(_pf_str_rev, tokens))))
longest = _pf_head(_pf_sort_by(lambda w: -len(w), tokens))
print(_pf_option_with_default("?", longest))
