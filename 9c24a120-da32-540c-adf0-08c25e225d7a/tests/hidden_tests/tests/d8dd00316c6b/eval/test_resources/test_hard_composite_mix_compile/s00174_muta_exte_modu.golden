from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_str_rev(s):
    return "".join(reversed(s))
calls = 0
def record(x):
    global calls
    calls = calls + 1
    return x * 4
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([56, 9, 0, 41, -16, 33, 18]))
doubled = _pf_map(record, [56, 9, 0, 41])
print(f"{doubled} after {calls} calls")
recordTwice = lambda _pf_x: record(record(_pf_x))
print((recordTwice(3), calls))
print(sum(_pf_map(functools.partial(int, base=16), ["ff", "c0"])))
def safe(s):
    try:
        _pf_t0 = Ok(int(s))
    except Exception as _pf_t1:
        _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
    if isinstance(_pf_t0, Ok):
        n = _pf_t0._0
        return f"ok {n}"
    else:
        e = _pf_t0._0
        return f"bad ({e.errorKind})"
_pf_iter(print, _pf_map(safe, ["12", "x1", "-50"]))
print(_pf_str_rev(str.upper("lu")))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(6))
def Geo_norm1(xs):
    return sum(_pf_map(abs, xs))
def Geo_between(lo, hi, x):
    return lo <= x <= hi
def Geo_square(x):
    return x * x
def Geo_clamp(lo, hi, x):
    return max(lo, min(hi, x))
nums = [-11, 25, 12, -13, -5, 26, 1]
print(Geo_norm1(nums))
print(_pf_filter(functools.partial(Geo_between, -5, 21), nums))
print(_pf_map(Geo_square, nums))
print(_pf_map(functools.partial(Geo_clamp, 0, 20), nums))
