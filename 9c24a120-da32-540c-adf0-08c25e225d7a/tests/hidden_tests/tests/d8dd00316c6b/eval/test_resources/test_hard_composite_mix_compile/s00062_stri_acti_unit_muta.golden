from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort_by(f, xs):
    return sorted(xs, key=f)
def _pf_zip(xs, ys):
    return list(zip(xs, ys))
def _pf_choose(f, xs):
    out = []
    for x in xs:
        y = f(x)
        if isinstance(y, Some):
            out.append(y._0)
    return out
def _pf_fmt_fixed(n, x):
    return format(x, f".{n}f")
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
def _pf_id(x):
    return x
raw = "rod,hal,hub,max"
parts = _pf_str_split(",", raw)
count = len(parts)
print(f"count={count} {{braces}} {len(raw)}")
longest = _pf_head(_pf_sort_by(lambda w: -len(w), parts))
print(_pf_option_with_default("?", longest))
fieldsN = _pf_map(_pf_str_to_int, _pf_str_split(",", "-3,,7,7,7"))
print(fieldsN)
print(sum(_pf_choose(_pf_id, fieldsN)))
print(_pf_map(lambda w: (w, len(w)), parts))
print(_pf_str_slice(0, 6, raw))
print(_pf_str_join("|", _pf_map(_pf_str_upper, parts)))
def _ap_Above(n):
    if n > 20:
        return Some(n - 20)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    _pf_t1 = _ap_Zero(n)
    if _pf_t1:
        return "zero"
    m = n
    if m < 0:
        return "negative"
    return "small"
_pf_iter(print, _pf_map(bucketOf, [16, 36, 32, 31, 3, 0]))
laps = [372.3, 395.3, 295.6, 399.9, 180.4]
durations = [31.5, 84.3, 8.6, 88.7, 16.2]
dist = _pf_fold(lambda acc, d: acc + d, 0.0, laps)
elapsed = _pf_fold(lambda a, b: a + b, 0.0, durations)
speed = dist / elapsed
print(_pf_fmt_fixed(3, speed))
edge = math.sqrt(2.25)
cube = edge * edge * edge
print(f"{edge} {math.cbrt(cube)}")
def _pf_fn0(_pf_arg0):
    d, t = _pf_arg0
    return d / t
best = _pf_max_by(_pf_fn0, _pf_zip(laps, durations))
print(best)
calls = 0
def record(x):
    global calls
    calls = calls + 1
    return x * 2
def stats(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(stats([3, 11, 44, 46, 31]))
doubled = _pf_map(record, [3, 11, 44, 46])
print(f"{doubled} after {calls} calls")
