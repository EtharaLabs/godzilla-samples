from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
@dataclass(frozen=True, slots=True, repr=False)
class Turn:
    _0: int
    def __repr__(self):
        return f"Turn({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    def __repr__(self):
        return f"Load({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    _1: int
    def __repr__(self):
        return f"Mark({self._0!r}, {self._1!r})"
hits = 0
def record(x):
    global hits
    hits = hits + 1
    return x * 2
def summarize(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(summarize([16, 60, 60, 37, 21, 22, 10, -15]))
doubled = _pf_map(record, [16, 60, 60, 37])
print(f"{doubled} after {hits} calls")
def _pf_fn0():
    for x in _pf_range(1, 11):
        y = x * x
        yield y
    yield 169
squares = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, squares))
print(list(_pf_seq_take(6, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 3)))))
def _pf_fn1(_pf_arg0):
    a, b = _pf_arg0
    return Some((a, (b, a + b)))
fib = _pf_seq_unfold(_pf_fn1, (0, 1))
print(list(_pf_seq_take_while(lambda n: n < 1306, fib)))
def explain(t):
    match t:
        case Turn(n0) if n0 > 4:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Load(n0) if 0 <= n0 < 10:
            return f"load!({n0})"
        case Load(n0):
            return f"load({n0})"
        case Mark(1, _):
            return "mark-1"
        case Mark(n0, n1):
            return f"mark({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def rank(t):
    match t:
        case Mark(x0, x1):
            return x0 + x1
        case _:
            return 1
batch = [Turn(1), Mark(8, 9), Mark(0, 3), Turn(5)]
_pf_iter(lambda t: print(explain(t)), batch)
tally = _pf_sum_by(rank, batch)
print(f"tally={tally}")
print(_pf_max_by(rank, batch))
