from dataclasses import dataclass
from functools import total_ordering
import functools
import itertools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
@dataclass(frozen=True, slots=True, repr=False)
class Num:
    _0: int
    def __repr__(self):
        return f"Num({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Add:
    _0: object
    _1: object
    def __repr__(self):
        return f"Add({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mul:
    _0: object
    _1: object
    def __repr__(self):
        return f"Mul({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Neg:
    _0: object
    def __repr__(self):
        return f"Neg({self._0!r})"
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: str
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Push:
    def __repr__(self):
        return "Push"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Push = Push()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Halt = Halt()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    def __repr__(self):
        return f"Drop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (3, self._0)
def _pf_fn0():
    for x in _pf_range(1, 10):
        y = x * x
        yield y
    yield 161
evens = _pf_fn0()
print(_pf_fold(lambda a, b: a + b, 0, evens))
print(list(_pf_seq_take(2, filter(lambda n: n % 2 == 0, _pf_seq_init_inf(lambda i: i * 4)))))
def evalE(e):
    match e:
        case Num(n):
            return n
        case Add(a, b):
            return evalE(a) + evalE(b)
        case Mul(a, b):
            return evalE(a) * evalE(b)
        case Neg(a):
            return -evalE(a)
        case _:
            raise RuntimeError("non-exhaustive match")
def render(e):
    match e:
        case Num(n) if n < 0:
            return f"({n})"
        case Num(n):
            return f"{n}"
        case Add(a, b):
            return f"({render(a)} + {render(b)})"
        case Mul(a, b):
            return f"{render(a)} * {render(b)}"
        case Neg(a):
            return f"-{render(a)}"
        case _:
            raise RuntimeError("non-exhaustive match")
exprs = [Num(6), Mul(Neg(Mul(Num(9), Num(4))), Num(8))]
_pf_iter(print, _pf_map(render, exprs))
print(_pf_map(evalE, exprs))
def describe(t):
    match t:
        case Skip(s0):
            return f"skip({s0})"
        case Drop(n0) if 0 <= n0 < 8:
            return f"drop!({n0})"
        case Drop(n0):
            return f"drop({n0})"
        case Push() | Halt():
            return "push/halt"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Drop(x0):
            return x0 * 4
        case _:
            return 1
prog = [Skip("gus"), Drop(-3), _Push, Drop(10), Skip("max"), _Push, Skip("jo")]
_pf_iter(lambda t: print(describe(t)), prog)
grandSum = _pf_sum_by(cost, prog)
print(f"grandSum={grandSum}")
print(_pf_sort(prog))
