from dataclasses import dataclass
import functools
import itertools
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def _pf_option_is_some(o):
    return isinstance(o, Some)
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
def _pf_seq_take_while(f, xs):
    return itertools.takewhile(f, xs)
def _pf_seq_unfold(f, state):
    while True:
        step = f(state)
        if not isinstance(step, Some):
            return None
        pair = step._0
        yield pair[0]
        state = pair[1]
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_strip(s):
    return s.strip()
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def unwrap(x):
    match x:
        case s:
            return s
def makeIds(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = makeIds("acc", 3)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
def decodeLine(line):
    def _pf_fn0():
        _pf_t1 = _pf_list_get(1, _pf_str_split("=", line))
