        return "Skip"
_Skip = Skip()
@dataclass(frozen=True, slots=True, repr=False)
class Halt:
    def __repr__(self):
        return "Halt"
_Halt = Halt()
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: str
