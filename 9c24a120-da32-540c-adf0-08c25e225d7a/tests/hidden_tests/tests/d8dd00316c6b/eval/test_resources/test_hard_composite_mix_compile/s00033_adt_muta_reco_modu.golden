@dataclass(frozen=True, slots=True)
class Booking:
    id: int
    owner: str
    amount: int
    urgent: bool
def show(t):
    match t:
        case Mark(s0):
            return f"mark({s0})"
        case Turn(n0) if n0 % 2 == 0:
            return f"turn!({n0})"
        case Turn(n0):
            return f"turn({n0})"
        case Skip():
            return f"skip"
        case Halt():
            return f"halt"
        case Load(s0):
            return f"load({s0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def cost(t):
    match t:
        case Turn(x0):
            return x0 * 4
        case Load(_):
            return 7
        case _:
            return 2
batch = [Mark("oz"), _Halt, _Skip, Mark("quin"), _Halt, _Skip, _Skip]
print(_pf_map(show, batch))
tally = _pf_sum_by(cost, batch)
print(f"tally={tally}")
print(len(_pf_filter(lambda t: cost(t) > 2, batch)))
calls = 0
def track(x):
    global calls
    calls = calls + 1
    return x * 2
def profile(xs):
    lo = 1000
    hi = -1000
    total = 0
    def visit(x):
        nonlocal hi, lo, total
        lo = min(lo, x)
        hi = max(hi, x)
        total = total + x
        return None
    _pf_iter(visit, xs)
    return f"lo={lo} hi={hi} total={total}"
print(profile([-6, 47, -13, 42, -17]))
doubled = _pf_map(track, [-6, 47, -13, 42])
print(f"{doubled} after {calls} calls")
