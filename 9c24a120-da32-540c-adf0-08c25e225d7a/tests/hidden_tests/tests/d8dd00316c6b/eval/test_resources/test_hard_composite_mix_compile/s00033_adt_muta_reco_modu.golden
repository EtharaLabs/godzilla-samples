def Text_square(x):
    return x * x
def Text_mean(xs):
    if not xs:
        return 0
    else:
        return sum(xs) // len(xs)
def Text_between(lo, hi, x):
    return lo <= x <= hi
pts = [22, 30, 26, -6, -9, -7]
