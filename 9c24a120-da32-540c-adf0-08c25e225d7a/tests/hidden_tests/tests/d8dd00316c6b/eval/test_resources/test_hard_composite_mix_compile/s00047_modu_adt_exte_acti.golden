from dataclasses import dataclass
import functools
import math
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_max_by(f, xs):
    return Some(max(xs, key=f)) if xs else _None_
def _pf_str_rev(s):
    return "".join(reversed(s))
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Mark:
    _0: int
    def __repr__(self):
        return f"Mark({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    _1: int
    def __repr__(self):
        return f"Pop({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Jump:
    def __repr__(self):
        return "Jump"
_Jump = Jump()
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    _1: int
    def __repr__(self):
        return f"Emit({self._0!r}, {self._1!r})"
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
def Calc_norm1(xs):
    return sum(_pf_map(abs, xs))
def Calc_scaleAll(k, xs):
    return _pf_map(lambda b: k * b, xs)
def Calc_square(x):
    return x * x
def Calc_between(lo, hi, x):
    return lo <= x <= hi
nums = [20, 30, -12, 1, 27, -11]
print(Calc_norm1(nums))
print(Calc_scaleAll(3, nums))
print(_pf_map(Calc_square, nums))
print(_pf_filter(functools.partial(Calc_between, 1, 22), nums))
def describe(t):
    match t:
        case Skip(1):
            return "skip-1"
        case Skip(n0):
            return f"skip({n0})"
        case Mark(n0) if 0 <= n0 < 8:
            return f"mark!({n0})"
        case Mark(n0):
            return f"mark({n0})"
        case Pop(n0, n1) if n0 % 2 == 0:
            return f"pop!({n0},{n1})"
        case Pop(n0, n1):
            return f"pop({n0},{n1})"
        case Jump():
            return f"jump"
        case Emit(2, _):
            return "emit-2"
        case Emit(n0, n1):
            return f"emit({n0},{n1})"
        case _:
            raise RuntimeError("non-exhaustive match")
def weight(t):
    match t:
        case Pop(x0, x1):
            return x0 + x1 * 3
        case Skip(x0):
            return x0 * 4
        case Jump():
            return 6
        case _:
            return 2
stream = [Emit(6, 5), _Jump, Pop(5, 12), Skip(6), Mark(10)]
_pf_iter(lambda t: print(describe(t)), stream)
total = _pf_sum_by(weight, stream)
print(f"total={total}")
print(_pf_max_by(weight, stream))
print(_pf_map(math.isqrt, [149, 348, 313, 105]))
def row(n):
    return _pf_map(functools.partial(math.comb, n), _pf_range(0, n + 1))
print(row(5))
print(_pf_str_rev(str.upper("ada")))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 28:
        return Some(n - 28)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def kindOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(kindOf, [12, 20, 10, 35, 21, 1]))
