def sumAll(xs):
    def _pf_fn3(acc, r):
        def _pf_fn4():
            if isinstance(acc, Ok):
                total = acc._0
                if isinstance(r, Ok):
                    _, n = r._0
                    return Ok(total + n)
                else:
                    return r
            else:
                return acc
        return _pf_fn4()
    return _pf_fold(_pf_fn3, Ok(0), xs)
