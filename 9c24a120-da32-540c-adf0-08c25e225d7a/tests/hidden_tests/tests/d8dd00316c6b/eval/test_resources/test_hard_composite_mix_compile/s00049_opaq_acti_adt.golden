from dataclasses import dataclass
from functools import total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def _pf_iter(f, xs):
    for x in xs:
        f(x)
    return None
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_range(lo, hi):
    return list(range(lo, hi))
def _pf_sort(xs):
    return sorted(xs)
def _pf_sum_by(f, xs):
    return sum(map(f, xs))
def _pf_head(xs):
    return Some(xs[0]) if xs else _None_
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class _Even:
    def __repr__(self):
        return "_Even"
@dataclass(frozen=True, slots=True, repr=False)
class _Odd:
    def __repr__(self):
        return "_Odd"
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Skip:
    _0: int
    def __repr__(self):
        return f"Skip({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Emit:
    _0: int
    def __repr__(self):
        return f"Emit({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Drop:
    _0: int
    _1: str
    def __repr__(self):
        return f"Drop({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0, self._1)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Load:
    _0: int
    _1: str
    def __repr__(self):
        return f"Load({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (3, self._0, self._1)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Pop:
    _0: int
    def __repr__(self):
        return f"Pop({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (4, self._0)
def unwrap(x):
    match x:
        case s:
            return s
def mint(prefix, n):
    return _pf_map(lambda i: f"{prefix}-{i}", _pf_range(1, n + 1))
ids = mint("acc", 2)
print(_pf_str_join(" ", _pf_map(unwrap, ids)))
print(_pf_head(ids) == Some("acc-1"))
def _ap_Even_Odd(n):
    if n % 2 == 0:
        return _Even()
    else:
        return _Odd()
def _ap_Above(n):
    if n > 19:
        return Some(n - 19)
    else:
        return _None_
def _ap_Zero(n):
    return n == 0
def bucketOf(n):
    _pf_t0 = _ap_Above(n)
    _pf_t1 = _ap_Zero(n)
    _pf_t2 = _ap_Even_Odd(n)
    if isinstance(_pf_t0, Some):
        d = _pf_t0._0
        return f"above by {d}"
    elif _pf_t1:
        return "zero"
    elif isinstance(_pf_t2, _Even):
        return "even"
    else:
        return "odd"
_pf_iter(print, _pf_map(bucketOf, [2, 12, 2, 36, 17]))
def describe(t):
    match t:
        case Skip(n0):
            return f"skip({n0})"
        case Emit(n0) if 0 <= n0 < 14:
            return f"emit!({n0})"
        case Emit(n0):
            return f"emit({n0})"
        case Drop(n0, s1) if 0 <= n0 < 11:
            return f"drop!({n0},{s1})"
        case Drop(n0, s1):
            return f"drop({n0},{s1})"
        case Load(3, _):
            return "load-3"
        case Load(n0, s1):
            return f"load({n0},{s1})"
        case Pop(1):
            return "pop-1"
        case Pop(n0):
            return f"pop({n0})"
        case _:
            raise RuntimeError("non-exhaustive match")
def score(t):
    match t:
        case Drop(x0, _):
            return x0 * 4
        case Skip(x0):
            return x0 * 5
        case Emit(x0):
            return x0
        case _:
            return 3
prog = [Skip(7), Load(8, "kit"), Drop(5, "hal"), Load(-1, "quin"), Skip(7), Skip(7), Pop(-3)]
print(_pf_map(describe, prog))
total = _pf_sum_by(score, prog)
print(f"total={total}")
print(_pf_sort(prog))
