import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def later(n):
    async def _pf_fn0():
        await asyncio.sleep(0.0)
        return n * 2
    return asyncio.run(_pf_run(_pf_Async(_pf_fn0)))
twice = lambda _pf_x: (lambda v: (v, v))(later(_pf_x))
print(twice(5))
