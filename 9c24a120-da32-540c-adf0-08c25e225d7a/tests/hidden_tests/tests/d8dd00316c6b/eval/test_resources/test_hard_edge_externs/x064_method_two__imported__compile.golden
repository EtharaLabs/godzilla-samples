# ==== ffi.py ====
swapc = lambda _pf_recv: _pf_recv.replace

# ==== main.py ====
import functools
import ffi
def _pf_map(f, xs):
    return list(map(f, xs))
print(ffi.swapc("banana", "a", "o"))
print(_pf_map(functools.partial(ffi.swapc, "banana", "a"), ["o"]))

