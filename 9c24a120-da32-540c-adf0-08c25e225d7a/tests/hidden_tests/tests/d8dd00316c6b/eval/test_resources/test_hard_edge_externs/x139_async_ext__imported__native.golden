# ==== ffi.py ====
import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
runAsync = lambda _pf_p0: asyncio.run(_pf_run(_pf_p0))
sleep = lambda _pf_p0: _pf_Async(asyncio.sleep, _pf_p0)
def later(n: int) -> int:
    async def _pf_fn0():
        await asyncio.sleep(0.0)
        return n * 2
    return asyncio.run(_pf_run(_pf_Async(_pf_fn0)))

# ==== main.py ====
import ffi
def _pf_map(f, xs):
    return list(map(f, xs))
print(ffi.later(5))
print(_pf_map(ffi.later, [5]))

