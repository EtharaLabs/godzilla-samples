# ==== ffi.py ====
import pathlib
toPath = pathlib.PurePosixPath
suffix = lambda _pf_recv: _pf_recv.suffix
def pathSuffix(s):
    return pathlib.PurePosixPath(s).suffix

# ==== main.py ====
import ffi
def _pf_map(f, xs):
    return list(map(f, xs))
print(ffi.pathSuffix("report.csv"))
print(_pf_map(ffi.pathSuffix, ["report.csv"]))

