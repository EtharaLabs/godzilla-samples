# ==== gen.py ====
import random
newRng = random.Random
def make(seed):
    return random.Random(seed)

# ==== main.py ====
from dataclasses import dataclass
import gen
@dataclass(frozen=True, slots=True, order=True)
class Holder:
    h: object
x = Holder(gen.make(1))
print("ok")

