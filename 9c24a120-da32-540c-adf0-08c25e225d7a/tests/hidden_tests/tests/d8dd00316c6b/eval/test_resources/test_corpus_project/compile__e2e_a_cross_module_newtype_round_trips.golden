# ==== ids.py ====
def _pf_str_concat(a, b):
    return a + b
def greet(u):
    match u:
        case s:
            return _pf_str_concat("hi ", s)

# ==== main.py ====
import ids
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_id(x):
    return x
uid = "ana"
match uid:
    case s:
        _pf_t0 = s
unwrapped = _pf_t0
mapped = _pf_map(_pf_id, ["a", "b"])
print(ids.greet(uid))
print(unwrapped)
print(len(mapped))

