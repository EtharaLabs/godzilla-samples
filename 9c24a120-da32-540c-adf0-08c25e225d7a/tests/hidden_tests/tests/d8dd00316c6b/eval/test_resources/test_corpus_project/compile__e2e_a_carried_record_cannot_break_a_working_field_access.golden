# ==== inner.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Config:
    size: int
def make(n):
    return Config(n)

# ==== middle.py ====
from dataclasses import dataclass
import inner
@dataclass(frozen=True, slots=True, order=True)
class Wrap:
    wConf: object
def mk(n):
    return Wrap(inner.make(n))

# ==== main.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Local:
    size: bool
def f(p):
    return p.size
print(f(Local(True)))

