# ==== deep.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Core:
    cv: int
def mkCore(n):
    return Core(n)

# ==== mid.py ====
from dataclasses import dataclass
import deep
@dataclass(frozen=True, slots=True, order=True)
class Two:
    w1: object
def mk2(n):
    return Two(deep.mkCore(n))

# ==== top.py ====
from dataclasses import dataclass
import mid
@dataclass(frozen=True, slots=True, order=True)
class Three:
    w2: object
def mk3(n):
    return Three(mid.mk2(n))

# ==== main.py ====
import top
x = top.mk3(7)
print(x.w2.w1.cv)

