# ==== gen.py ====
import random
newRng = random.Random
def make(seed):
    return random.Random(seed)

# ==== middle.py ====
import gen
def fresh(n):
    return gen.make(n)

# ==== main.py ====
from dataclasses import dataclass
import middle
@dataclass(frozen=True, slots=True, order=True)
class H:
    h: object
x = H(middle.fresh(1))

