# ==== inner.py ====
from dataclasses import dataclass
from _pyfun_rt import Some, None_, _None_
@dataclass(frozen=True, slots=True, order=True)
class A:
    av: int
    ab: object
@dataclass(frozen=True, slots=True, order=True)
class B:
    bv: int
    ba: object
def mkA(n):
    return A(n, _None_)
def mkB(n):
    return B(n, Some(mkA(n)))

# ==== middle.py ====
import inner
def make(n):
    return inner.mkB(n)

# ==== main.py ====
import middle
from _pyfun_rt import Some, None_, _None_
def _pf_option_map(f, o):
    if isinstance(o, Some):
        return Some(f(o._0))
    return _None_
b = middle.make(3)
v = b.bv
w = _pf_option_map(lambda a: a.av, b.ba)

# ==== _pyfun_rt.py ====
from dataclasses import dataclass
from functools import total_ordering
import contextvars
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0,)
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
_pf_scope = contextvars.ContextVar("_pf_scope")

