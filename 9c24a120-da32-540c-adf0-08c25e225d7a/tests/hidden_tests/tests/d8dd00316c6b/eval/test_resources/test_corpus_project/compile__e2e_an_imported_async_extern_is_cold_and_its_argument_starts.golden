# ==== clock.py ====
import asyncio
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
runAsync = lambda _pf_p0: asyncio.run(_pf_run(_pf_p0))
pause = lambda _pf_p0: _pf_Async(asyncio.sleep, _pf_p0)

# ==== main.py ====
import clock
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
tick = clock.pause(0.0)
async def _pf_fn0():
    await tick
    await tick
    return 2
twice = _pf_Async(_pf_fn0)
print(clock.runAsync(twice))

