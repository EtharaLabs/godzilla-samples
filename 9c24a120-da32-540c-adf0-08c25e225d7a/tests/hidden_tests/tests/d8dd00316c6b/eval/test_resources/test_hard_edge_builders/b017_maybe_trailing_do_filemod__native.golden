from _pyfun_rt import Some, None_, _None_
def bind(m: Some | None_, f) -> Some | None_:
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def return_(x) -> Some | None_:
    return Some(x)

# ==== main.py ====
import maybe
from _pyfun_rt import Some, None_, _None_
def go(a: Some | None_, b: Some | None_) -> Some | None_:
    return maybe.bind(a, lambda x: b)
print(go(Some(1), Some(9)))
print(go(Some(1), _None_))

