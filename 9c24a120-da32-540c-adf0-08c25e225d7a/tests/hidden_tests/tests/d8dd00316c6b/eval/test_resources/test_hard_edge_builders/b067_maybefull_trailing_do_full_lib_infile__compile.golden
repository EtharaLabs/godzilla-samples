from _pyfun_rt import Some, None_, _None_
def Opt_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Opt_return_(x):
    return Some(x)
def Opt_returnFrom(m):
    return m
Opt_zero = _None_
def go(a, b):
    return Opt_bind(a, lambda x: (b if x > 0 else _None_))

