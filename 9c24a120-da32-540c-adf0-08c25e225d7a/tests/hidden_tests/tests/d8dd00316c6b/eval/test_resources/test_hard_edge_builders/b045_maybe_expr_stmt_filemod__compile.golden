import maybe
from _pyfun_rt import Some, None_, _None_
def go(a, b):
    def _pf_fn1(x):
        def _pf_fn2(_):
            return maybe.return_(x)
        return _pf_fn2(print(f"got {x}"))
    return maybe.bind(a, _pf_fn1)
print(go(Some(7), _None_))

