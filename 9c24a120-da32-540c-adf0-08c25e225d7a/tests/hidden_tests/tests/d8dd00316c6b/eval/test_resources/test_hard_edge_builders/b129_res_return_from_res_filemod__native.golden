# ==== res.py ====
from _pyfun_rt import Ok, Error
def bind(r: Ok | Error, f) -> Ok | Error:
    if isinstance(r, Ok):
        v = r._0
        return f(v)
    else:
        e = r._0
        return Error(e)
def return_(x) -> Ok | Error:
    return Ok(x)
def returnFrom(r):
    return r

# ==== main.py ====
import res
from _pyfun_rt import Ok, Error
def go(a: Ok | Error, b: Ok | Error) -> Ok | Error:
    return res.bind(a, lambda x: res.returnFrom(b if x > 1 else Ok(0)))
print(go(Ok(2), Ok(5)))
print(go(Ok(1), Error("x")))

