# ==== many.py ====
def _pf_concat(xs, ys):
    return xs + ys
def yield_(x):
    return [x]
def yieldFrom(xs):
    return xs
def combine(a, d):
    return _pf_concat(a, d(None))
def delay(f):
    return f
def for_(xs, f):
    acc = []
    for x in xs:
        _pf_t0 = f(x)
        acc.extend(_pf_t0)
    return acc
zero = []
def bind(xs, f):
    acc = []
    for x in xs:
        _pf_t1 = f(x)
        acc.extend(_pf_t1)
    return acc
def return_(x):
    return [x]

# ==== lib.py ====
import many
def go(xs):
    return many.for_(xs, lambda x: many.for_(xs, lambda y: many.yield_(x * y)))

# ==== main.py ====
import lib
print(lib.go([1, 2, 3]))

