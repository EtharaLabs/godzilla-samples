from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
def Res_bind(r, f):
    if isinstance(r, Ok):
        v = r._0
        return f(v)
    else:
        e = r._0
        return Error(e)
def Res_return_(x):
    return Ok(x)
def Res_returnFrom(r):
    return r
def go(a, b):
    return Res_bind(a, lambda x: Res_returnFrom(b if x > 1 else Ok(0)))
print(go(Ok(2), Ok(5)))
print(go(Ok(1), Error("x")))
