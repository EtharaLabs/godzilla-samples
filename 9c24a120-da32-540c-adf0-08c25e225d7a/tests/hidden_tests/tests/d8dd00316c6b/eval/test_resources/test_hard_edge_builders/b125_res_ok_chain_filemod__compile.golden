# ==== res.py ====
from _pyfun_rt import Ok, Error
def bind(r, f):
    if isinstance(r, Ok):
        v = r._0
        return f(v)
    else:
        e = r._0
        return Error(e)
def return_(x):
    return Ok(x)
def returnFrom(r):
    return r

# ==== main.py ====
import res
from _pyfun_rt import Ok, Error
def go(a, b):
    return res.bind(a, lambda x: res.bind(b if x > 0 else Error("neg"), lambda y: res.return_(x + y)))
print(go(Ok(1), Ok(2)))
print(go(Ok(0), Ok(2)))
print(go(Error("e"), Ok(2)))

# ==== _pyfun_rt.py ====
from dataclasses import dataclass
from functools import total_ordering
import contextvars
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0,)
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
_pf_scope = contextvars.ContextVar("_pf_scope")

