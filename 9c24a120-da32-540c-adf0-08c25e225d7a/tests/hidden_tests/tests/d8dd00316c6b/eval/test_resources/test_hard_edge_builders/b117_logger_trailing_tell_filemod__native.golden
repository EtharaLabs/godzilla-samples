# ==== logger.py ====
def _pf_concat(xs, ys):
    return xs + ys
def bind(m, f):
    v, log = m
    v2, log2 = f(v)
    return (v2, _pf_concat(log, log2))
def return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])

# ==== main.py ====
import logger
def go(a, b) -> tuple[None, list[str]]:
    return logger.bind(logger.tell("a"), lambda _: logger.tell(f"b{a}"))
print(go(3, 4))

