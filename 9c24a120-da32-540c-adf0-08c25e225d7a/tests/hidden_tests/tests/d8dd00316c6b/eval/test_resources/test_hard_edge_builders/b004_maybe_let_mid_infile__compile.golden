from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_ = None_()
def Maybe_bind(m, f):
    if isinstance(m, Some):
        x = m._0
        return f(x)
    else:
        return _None_
def Maybe_return_(x):
    return Some(x)
def go(a, b):
    return Maybe_bind(a, lambda x: (lambda z: Maybe_bind(b, lambda y: Maybe_return_(z + y)))(x * 2))
print(go(Some(3), Some(4)))
print(go(Some(3), _None_))
