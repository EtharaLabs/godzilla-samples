# ==== many.py ====
from typing import Any
def _pf_concat(xs, ys):
    return xs + ys
def yield_(x):
    return [x]
def yieldFrom(xs):
    return xs
def combine(a, d):
    return _pf_concat(a, d(None))
def delay(f):
    return f
def for_(xs, f):
    acc = []
    for x in xs:
        _pf_t0 = f(x)
        acc.extend(_pf_t0)
    return acc
zero: list[Any] = []
def bind(xs, f):
    acc = []
    for x in xs:
        _pf_t1 = f(x)
        acc.extend(_pf_t1)
    return acc
def return_(x):
    return [x]

# ==== main.py ====
import many
def go(xs: list[int]) -> list[int]:
    return many.combine(many.yieldFrom(xs), many.delay(lambda _: many.yield_(5)))
print(go([7, 8]))

