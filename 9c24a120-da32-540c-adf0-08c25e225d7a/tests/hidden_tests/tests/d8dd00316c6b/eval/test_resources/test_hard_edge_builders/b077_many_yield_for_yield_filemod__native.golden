# ==== many.py ====
from typing import Any
def _pf_concat(xs, ys):
    return xs + ys
def yield_(x):
    return [x]
def yieldFrom(xs):
    return xs
def combine(a, d):
    return _pf_concat(a, d(None))
def delay(f):
    return f
def for_(xs, f):
    acc = []
    for x in xs:
        _pf_t0 = f(x)
        acc.extend(_pf_t0)
    return acc
zero: list[Any] = []
def bind(xs, f):
    acc = []
    for x in xs:
        _pf_t1 = f(x)
        acc.extend(_pf_t1)
    return acc
def return_(x):
    return [x]

# ==== main.py ====
import many
def go(xs: list[int]) -> list[int]:
    return many.combine(many.yield_(0), many.delay(lambda _: many.combine(many.for_(xs, lambda x: many.yield_(x)), many.delay(lambda _: many.yield_(99)))))
print(go([1, 2]))

