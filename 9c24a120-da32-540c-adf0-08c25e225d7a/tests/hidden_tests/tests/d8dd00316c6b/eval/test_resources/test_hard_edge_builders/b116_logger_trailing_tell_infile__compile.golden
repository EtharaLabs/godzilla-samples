def _pf_concat(xs, ys):
    return xs + ys
def Logger_bind(m, f):
    v, log = m
    v2, log2 = f(v)
    return (v2, _pf_concat(log, log2))
def Logger_return_(x):
    return (x, [])
def Logger_tell(msg):
    return (None, [msg])
def go(a, b):
    return Logger_bind(Logger_tell("a"), lambda _: Logger_tell(f"b{a}"))
print(go(3, 4))
