# ==== logger.py ====
def _pf_concat(xs, ys):
    return xs + ys
def bind(m, f):
    v, log = m
    v2, log2 = f(v)
    return (v2, _pf_concat(log, log2))
def return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])

# ==== main.py ====
import logger
def go(a: int, b: int) -> tuple[int, list[str]]:
    return logger.bind(logger.tell("start"), lambda _: logger.bind(logger.return_(a + b), lambda x: logger.bind(logger.tell(f"sum={x}"), lambda _: logger.return_(x * 2))))
print(go(1, 2))

