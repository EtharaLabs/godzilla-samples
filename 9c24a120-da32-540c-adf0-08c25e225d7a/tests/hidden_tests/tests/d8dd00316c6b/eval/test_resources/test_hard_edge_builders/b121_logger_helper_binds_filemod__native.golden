# ==== logger.py ====
def _pf_concat(xs, ys):
    return xs + ys
def bind(m, f):
    v, log = m
    v2, log2 = f(v)
    return (v2, _pf_concat(log, log2))
def return_(x):
    return (x, [])
def tell(msg):
    return (None, [msg])

# ==== main.py ====
import logger
def go(a, b):
    return logger.bind(logger.return_(a), lambda x: logger.bind(logger.return_(b), lambda y: logger.bind(logger.tell("gt" if x > y else "le"), lambda _: logger.return_((x, y)))))
print(go(5, 2))
print(go(1, 9))

