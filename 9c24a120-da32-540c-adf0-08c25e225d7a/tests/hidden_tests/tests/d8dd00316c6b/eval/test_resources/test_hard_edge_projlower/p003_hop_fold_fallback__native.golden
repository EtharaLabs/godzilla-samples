# ==== lib.py ====
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
x0: int = 1
def doubled(xs) -> list[int]:
    return _pf_fold(lambda acc, x: _pf_concat(acc, acc), [x0], xs)

# ==== mid.py ====
import lib
ready: bool = True
print(len(lib.doubled([1, 2, 3])))

# ==== main.py ====
import mid
print(mid.ready)

