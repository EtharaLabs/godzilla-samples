# ==== lib.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Cell:
    row: int
    col: int
def index(pairs):
    m = dict()
    for (k, v) in pairs:
        m[k] = v
    return m
def keys(cells):
    def _pf_fn0():
        for c in cells:
            k = c.row * 10 + c.col
            yield k
    return _pf_fn0()

# ==== main.py ====
import lib
def _pf_map_to_list(m):
    return list(m.items())
print(_pf_map_to_list(lib.index([(1, "a"), (2, "b"), (1, "c")])))
print(list(lib.keys([lib.Cell(1, 2), lib.Cell(3, 4)])))

