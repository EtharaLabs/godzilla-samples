# ==== lib.py ====
force: float = 10.0
mass: float = 2.0
def walk(n: int, acc: int) -> int:
    peek = lambda z: z + n
    if n == 0:
        return acc
    else:
        return walk(n - 1, peek(acc))

# ==== main.py ====
import lib
print(lib.force / lib.mass)
print(lib.walk(3, 0))

--- stderr ---
note: in `Lib`: `walk` calls itself in tail position but keeps its recursive form: a closure in it captures `n`
