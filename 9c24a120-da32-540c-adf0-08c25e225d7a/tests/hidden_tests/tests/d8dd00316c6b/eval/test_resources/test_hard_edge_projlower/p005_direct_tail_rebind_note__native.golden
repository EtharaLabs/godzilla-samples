# ==== lib.py ====
def go(n: int) -> int:
    while True:
        def go(k: int) -> int:
            return k * 10
        if n == 0:
            return 0
        else:
            n = n - 1
            continue

# ==== main.py ====
import lib
print(lib.go(4))

