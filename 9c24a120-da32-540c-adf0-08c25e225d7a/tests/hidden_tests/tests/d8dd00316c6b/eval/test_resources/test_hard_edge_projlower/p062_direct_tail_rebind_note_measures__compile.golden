# ==== lib.py ====
def go(n):
    def go(k):
        return k * 10
    if n == 0:
        return 0
    else:
        return go(n - 1)
def speed(d, t):
    return d / t
lap = 400.0

# ==== main.py ====
import lib
print(lib.go(4))
print(lib.speed(lib.lap, 50.0))

