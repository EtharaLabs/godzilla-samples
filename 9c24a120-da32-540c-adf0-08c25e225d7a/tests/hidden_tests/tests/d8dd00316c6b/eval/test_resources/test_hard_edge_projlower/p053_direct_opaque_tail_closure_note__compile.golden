# ==== lib.py ====
def mk(s):
    return s
def show(u):
    match u:
        case s:
            return f"user:{s}"
def walk(n, acc):
    peek = lambda z: z + n
    if n == 0:
        return acc
    else:
        return walk(n - 1, peek(acc))

# ==== main.py ====
import lib
print(lib.show(lib.mk("u1")))
print(lib.walk(3, 0))

--- stderr ---
note: in `Lib`: `walk` calls itself in tail position but keeps its recursive form: a closure in it captures `n`
