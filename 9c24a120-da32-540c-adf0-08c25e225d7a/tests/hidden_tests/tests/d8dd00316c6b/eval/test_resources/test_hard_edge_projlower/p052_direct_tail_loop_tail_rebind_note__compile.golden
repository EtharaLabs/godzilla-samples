# ==== lib.py ====
def sumTo(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue
def go(n):
    def go(k):
        return k * 10
    if n == 0:
        return 0
    else:
        return go(n - 1)

# ==== main.py ====
import lib
print(lib.sumTo(5000, 0))
print(lib.go(4))

--- stderr ---
note: in `Lib`: `go` calls itself in tail position but keeps its recursive form: the body rebinds `go`
