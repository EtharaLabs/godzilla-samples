# ==== lib.py ====
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def within(lo, x, hi):
    return lo <= x < hi
def total(xs):
    return 1 + _pf_fold(lambda a, x: a + x * 2, 0, xs)

# ==== main.py ====
import lib
def _pf_map(f, xs):
    return list(map(f, xs))
print(_pf_map(lambda v: lib.within(0, v, 3), [0, 3, -1]))
print(lib.total([1, 2, 3]))

