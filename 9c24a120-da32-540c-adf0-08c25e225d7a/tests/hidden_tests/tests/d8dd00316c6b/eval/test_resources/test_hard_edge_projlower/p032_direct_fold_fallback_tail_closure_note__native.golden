# ==== lib.py ====
import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
x0: int = 1
def doubled(xs) -> list[int]:
    return _pf_fold(lambda acc, x: _pf_concat(acc, acc), [x0], xs)
def walk(n: int, acc: int) -> int:
    peek = lambda z: z + n
    if n == 0:
        return acc
    else:
        return walk(n - 1, peek(acc))

# ==== main.py ====
import lib
print(len(lib.doubled([1, 2, 3])))
print(lib.walk(3, 0))

--- stderr ---
note: in `Lib`: `walk` calls itself in tail position but keeps its recursive form: a closure in it captures `n`
