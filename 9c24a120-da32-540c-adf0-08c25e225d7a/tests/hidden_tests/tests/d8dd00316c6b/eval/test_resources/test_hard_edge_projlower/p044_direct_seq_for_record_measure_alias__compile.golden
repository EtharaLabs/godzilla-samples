# ==== lib.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Cell:
    row: int
    col: int
def keys(cells):
    def _pf_fn0():
        for c in cells:
            k = c.row * 10 + c.col
            yield k
    return _pf_fn0()
force = 10.0
mass = 2.0

# ==== main.py ====
import lib
print(list(lib.keys([lib.Cell(1, 2), lib.Cell(3, 4)])))
print(lib.force / lib.mass)

