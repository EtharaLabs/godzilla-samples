import lib
from _pyfun_rt import Some, None_, _None_
print(lib.addOpt(Some(1), Some(2)))
print(lib.addOpt(_None_, Some(2)))
print(list(lib.keys([lib.Cell(1, 2), lib.Cell(3, 4)])))

