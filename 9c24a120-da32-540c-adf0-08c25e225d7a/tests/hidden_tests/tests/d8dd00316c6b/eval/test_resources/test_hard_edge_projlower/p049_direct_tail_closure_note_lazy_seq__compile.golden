# ==== lib.py ====
import itertools
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
def walk(n, acc):
    peek = lambda z: z + n
    if n == 0:
        return acc
    else:
        return walk(n - 1, peek(acc))
naturals = _pf_seq_init_inf(lambda i: i * i)

# ==== main.py ====
import itertools
import lib
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
print(lib.walk(3, 0))
print(list(_pf_seq_take(4, lib.naturals)))

--- stderr ---
note: in `Lib`: `walk` calls itself in tail position but keeps its recursive form: a closure in it captures `n`
