# ==== lib.py ====
def sumTo(n: int, acc: int) -> int:
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue
def go(n: int) -> int:
    while True:
        def go(k: int) -> int:
            return k * 10
        if n == 0:
            return 0
        else:
            n = n - 1
            continue

# ==== main.py ====
import lib
print(lib.sumTo(5000, 0))
print(lib.go(4))

