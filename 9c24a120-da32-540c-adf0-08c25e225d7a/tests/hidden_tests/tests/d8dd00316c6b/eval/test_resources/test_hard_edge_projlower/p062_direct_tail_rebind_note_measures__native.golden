# ==== lib.py ====
def go(n: int) -> int:
    while True:
        def go(k: int) -> int:
            return k * 10
        if n == 0:
            return 0
        else:
            n = n - 1
            continue
def speed(d: int, t: int) -> float:
    return d / t
lap: float = 400.0

# ==== main.py ====
import lib
print(lib.go(4))
print(lib.speed(lib.lap, 50.0))

