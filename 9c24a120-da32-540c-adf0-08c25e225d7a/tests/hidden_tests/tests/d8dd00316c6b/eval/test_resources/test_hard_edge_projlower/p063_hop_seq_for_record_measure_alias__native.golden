# ==== lib.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Cell:
    row: int
    col: int
def keys(cells: list[Cell]):
    def _pf_fn0():
        for c in cells:
            k = c.row * 10 + c.col
            yield k
    return _pf_fn0()
force: float = 10.0
mass: float = 2.0

# ==== mid.py ====
import lib
ready: bool = True
print(list(lib.keys([lib.Cell(1, 2), lib.Cell(3, 4)])))
print(lib.force / lib.mass)

# ==== main.py ====
import mid
print(mid.ready)

