# ==== lib.py ====
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
hits: int = 0
def hit(u) -> int:
    global hits
    hits = hits + 1
    return hits
def total(xs: list[int]) -> int:
    return 1 + _pf_fold(lambda a, x: a + x * 2, 0, xs)

# ==== main.py ====
import lib
print(lib.hit(None))
print(lib.hit(None))
print(lib.total([1, 2, 3]))

