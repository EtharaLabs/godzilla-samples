# ==== lib.py ====
def mk(s: str):
    return s
def show(u) -> str:
    s = u
    return f"user:{s}"
def within(lo, x, hi) -> bool:
    return lo <= x < hi

# ==== mid.py ====
import lib
def _pf_map(f, xs):
    return list(map(f, xs))
ready: bool = True
print(lib.show(lib.mk("u1")))
print(_pf_map(lambda v: lib.within(0, v, 3), [0, 3, -1]))

# ==== main.py ====
import mid
print(mid.ready)

