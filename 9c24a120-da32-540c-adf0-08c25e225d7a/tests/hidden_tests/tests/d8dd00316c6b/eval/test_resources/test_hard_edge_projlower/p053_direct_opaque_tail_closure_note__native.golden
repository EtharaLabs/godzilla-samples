# ==== lib.py ====
def mk(s: str):
    return s
def show(u) -> str:
    s = u
    return f"user:{s}"
def walk(n: int, acc: int) -> int:
    peek = lambda z: z + n
    if n == 0:
        return acc
    else:
        return walk(n - 1, peek(acc))

# ==== main.py ====
import lib
print(lib.show(lib.mk("u1")))
print(lib.walk(3, 0))

--- stderr ---
note: in `Lib`: `walk` calls itself in tail position but keeps its recursive form: a closure in it captures `n`
