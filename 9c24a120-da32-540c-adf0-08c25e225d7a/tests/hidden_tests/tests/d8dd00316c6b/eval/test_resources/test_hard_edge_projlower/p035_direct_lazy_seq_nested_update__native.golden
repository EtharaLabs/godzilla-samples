# ==== lib.py ====
from dataclasses import dataclass
from typing import Any
import itertools
def _pf_seq_init_inf(f):
    return map(f, itertools.count())
@dataclass(frozen=True, slots=True, order=True)
class Inner:
    a: int
    b: int
@dataclass(frozen=True, slots=True, order=True)
class Outer:
    name: str
    inner: "Inner"
naturals = _pf_seq_init_inf(lambda i: i * i)
base: Outer = Outer("o", Inner(1, 2))

# ==== main.py ====
import itertools
import lib
def _pf_seq_take(n, xs):
    return itertools.islice(xs, n)
print(list(_pf_seq_take(4, lib.naturals)))
_pf_t0 = lib.base
changed = lib.Outer(_pf_t0.name, lib.Inner(_pf_t0.inner.a, 20))
print(changed.inner.b)
print(lib.base.inner.b)

