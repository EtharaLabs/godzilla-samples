# ==== lib.py ====
hits = 0
def hit(u):
    global hits
    hits = hits + 1
    return hits
def mk(s):
    return s
def show(u):
    match u:
        case s:
            return f"user:{s}"

# ==== main.py ====
import lib
print(lib.hit(None))
print(lib.hit(None))
print(lib.show(lib.mk("u1")))

