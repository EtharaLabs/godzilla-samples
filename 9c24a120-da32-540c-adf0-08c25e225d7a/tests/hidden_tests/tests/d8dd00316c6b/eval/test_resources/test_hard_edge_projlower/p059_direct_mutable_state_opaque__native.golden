# ==== lib.py ====
hits: int = 0
def hit(u) -> int:
    global hits
    hits = hits + 1
    return hits
def mk(s: str):
    return s
def show(u) -> str:
    s = u
    return f"user:{s}"

# ==== main.py ====
import lib
print(lib.hit(None))
print(lib.hit(None))
print(lib.show(lib.mk("u1")))

