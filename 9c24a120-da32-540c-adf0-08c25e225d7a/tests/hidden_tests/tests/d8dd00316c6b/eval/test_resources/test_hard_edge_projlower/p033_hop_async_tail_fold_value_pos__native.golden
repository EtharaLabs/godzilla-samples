# ==== lib.py ====
import functools
import asyncio
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
runAsync = lambda _pf_p0: asyncio.run(_pf_run(_pf_p0))
def finished(acc):
    async def _pf_fn0():
        return acc
    return _pf_Async(_pf_fn0)
def countdown(n: int, acc: int):
    async def _pf_fn1(n, acc):
        while True:
            if n == 0:
                return await finished(acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return _pf_Async(_pf_fn1, n, acc)
def runCount(n: int) -> int:
    return asyncio.run(_pf_run(countdown(n, 0)))
def total(xs: list[int]) -> int:
    return 1 + _pf_fold(lambda a, x: a + x * 2, 0, xs)

# ==== mid.py ====
import lib
ready: bool = True
print(lib.runCount(4))
print(lib.total([1, 2, 3]))

