# ==== lib.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Inner:
    a: int
    b: int
@dataclass(frozen=True, slots=True, order=True)
class Outer:
    name: str
    inner: object
def sums(pairs):
    def _pf_fn0():
        for (a, b) in pairs:
            yield a + b
        yield 0
    return _pf_fn0()
base = Outer("o", Inner(1, 2))

# ==== main.py ====
import lib
print(list(lib.sums([(1, 2), (3, 4)])))
_pf_t0 = lib.base
changed = lib.Outer(_pf_t0.name, lib.Inner(_pf_t0.inner.a, 20))
print(changed.inner.b)
print(lib.base.inner.b)

