# ==== loop.py ====
def go(n, a, b):
    def count(k, c):
        while True:
            if k == 0:
                return c
            else:
                k, c = (k - 1, c + 1)
                continue
    seen = 0
    def bump(k):
        nonlocal seen
        seen = seen + k
        return seen
    if n == 0:
        return a
    else:
        return go(n - 1, b, a + b)

# ==== main.py ====
import loop
print(loop.go(10, 0, 1))

