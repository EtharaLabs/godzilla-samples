def go(n: int) -> int:
    while True:
        seen = 0
        def bump(k: int) -> int:
            nonlocal seen
            seen = seen + k
            return seen
        if n % 7 == 0:
            return n
        else:
            n = n + 1
            continue
print(go(8))
