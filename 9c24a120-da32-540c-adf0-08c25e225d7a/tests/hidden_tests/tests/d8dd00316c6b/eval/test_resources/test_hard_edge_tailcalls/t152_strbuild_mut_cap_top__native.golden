def _pf_str_concat(a, b):
    return a + b
def go(s: str, n: int) -> str:
    while True:
        seen = 0
        def bump(k: int) -> int:
            nonlocal seen
            seen = seen + k
            return seen
        if n == 0:
            return s
        else:
            s, n = (_pf_str_concat(s, str(n)), n - 1)
            continue
print(go(">", 4))
