def Loop_go(xs, acc):
    while True:
        inc = lambda z: z + 1
        match xs:
            case []:
                return acc
            case [h, *t]:
                xs, acc = (t, acc + h)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(Loop_go([4, 5, 6], 0))
