def go(n: int, acc: int) -> int:
    while True:
        inc = lambda z: z + 1
        if n <= 0:
            return acc
        elif n % 2 == 0:
            n, acc = (n - 1, acc * 2)
            continue
        else:
            n, acc = (n - 1, acc + 1)
            continue
print(go(7, 1))
