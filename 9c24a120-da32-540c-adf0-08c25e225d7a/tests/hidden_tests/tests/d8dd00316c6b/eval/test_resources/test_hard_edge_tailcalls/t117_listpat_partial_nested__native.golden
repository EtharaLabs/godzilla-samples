import functools
def outer(u) -> int:
    def go(xs: list[int], acc: int) -> int:
        while True:
            again = functools.partial(go, xs)
            if len(xs) == 0:
                return acc
            else:
                h = xs[0]
                t = xs[1:len(xs)]
                xs, acc = (t, acc + h)
                continue
    return go([4, 5, 6], 0)
print(outer(None))
