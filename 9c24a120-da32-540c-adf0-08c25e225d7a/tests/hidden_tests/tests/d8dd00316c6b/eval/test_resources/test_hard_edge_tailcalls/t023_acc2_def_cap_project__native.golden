# ==== loop.py ====
def go(n: int, acc: int) -> int:
    while True:
        def helper(z):
            return (n, z)
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue

# ==== main.py ====
import loop
print(loop.go(6, 0))

