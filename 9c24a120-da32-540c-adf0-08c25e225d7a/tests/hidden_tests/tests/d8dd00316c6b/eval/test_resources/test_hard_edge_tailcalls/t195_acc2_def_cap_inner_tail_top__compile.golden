def go(n, acc):
    def helper(z):
        return (n, z)
    def count(k, c):
        while True:
            if k == 0:
                return c
            else:
                k, c = (k - 1, c + 1)
                continue
    if n == 0:
        return acc
    else:
        return go(n - 1, acc + n)
print(go(6, 0))
