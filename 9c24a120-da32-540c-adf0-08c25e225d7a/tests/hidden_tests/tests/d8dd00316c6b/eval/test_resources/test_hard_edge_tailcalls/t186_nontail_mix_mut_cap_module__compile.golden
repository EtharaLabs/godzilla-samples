def Loop_go(n, acc):
    seen = 0
    def bump(k):
        nonlocal seen
        seen = seen + k
        return seen
    if n == 0:
        return acc
    elif n == 3:
        return 1 + Loop_go(n - 1, acc)
    else:
        return Loop_go(n - 1, acc + n)
print(Loop_go(5, 0))
