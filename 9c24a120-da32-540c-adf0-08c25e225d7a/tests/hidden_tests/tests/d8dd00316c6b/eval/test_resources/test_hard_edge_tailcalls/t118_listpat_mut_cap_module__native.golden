def Loop_go(xs, acc):
    while True:
        seen = 0
        def bump(k: int) -> int:
            nonlocal seen
            seen = seen + k
            return seen
        if len(xs) == 0:
            return acc
        else:
            h = xs[0]
            t = xs[1:len(xs)]
            xs, acc = (t, acc + h)
            continue
print(Loop_go([4, 5, 6], 0))
