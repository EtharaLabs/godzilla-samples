from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Inc:
    _0: int
    def __repr__(self):
        return f"Inc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Dec:
    _0: int
    def __repr__(self):
        return f"Dec({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Stop:
    def __repr__(self):
        return "Stop"
_Stop = Stop()
def outer(u):
    def go(cmds, total):
        while True:
            print(f"at {cmds}")
            match cmds:
                case []:
                    return total
                case [Inc(k), *rest] if k > 9:
                    cmds, total = (rest, total + 1)
                    continue
                case [Inc(k), *rest]:
                    cmds, total = (rest, total + k)
                    continue
                case [Dec(k), *rest]:
                    cmds, total = (rest, total - k)
                    continue
                case [Stop(), *_]:
                    return total
                case _:
                    raise RuntimeError("non-exhaustive match")
    return go([Inc(3), Inc(20), Dec(1), _Stop, Inc(5)], 0)
print(outer(None))
