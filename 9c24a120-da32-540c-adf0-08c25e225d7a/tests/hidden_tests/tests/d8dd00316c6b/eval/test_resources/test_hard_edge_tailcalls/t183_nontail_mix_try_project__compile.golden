# ==== loop.py ====
from _pyfun_rt import Ok, Error
from _pyfun_rt import Some, None_, _None_
from _pyfun_rt import _Exception
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def go(n, acc):
    while True:
        try:
            _pf_t0 = Ok(_pf_str_to_int("12"))
        except Exception as _pf_t1:
            _pf_t0 = Error(_Exception(type(_pf_t1).__name__, str(_pf_t1)))
        r = _pf_t0
        if n == 0:
            return acc
        elif n == 3:
            return 1 + go(n - 1, acc)
        else:
            n, acc = (n - 1, acc + n)
            continue

