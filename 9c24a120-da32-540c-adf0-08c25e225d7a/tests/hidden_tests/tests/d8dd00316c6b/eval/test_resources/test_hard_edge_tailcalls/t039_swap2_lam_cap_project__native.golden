# ==== loop.py ====
def go(a: int, b: int) -> tuple[int, int]:
    peek = lambda z: (a, z)
    if a > 50:
        return (a, b)
    else:
        return go(b, a + b)

# ==== main.py ====
import loop
print(loop.go(1, 2))

