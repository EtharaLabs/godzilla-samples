# ==== loop.py ====
def go(n, acc):
    while True:
        print(f"at {n}")
        match n:
            case 0:
                return acc
            case 1:
                n, acc = (0, acc + 100)
                continue
            case k if k > 5:
                n, acc = (k - 2, acc + k)
                continue
            case k:
                n, acc = (k - 1, acc - 1)
                continue

# ==== main.py ====
import loop
print(loop.go(9, 0))

