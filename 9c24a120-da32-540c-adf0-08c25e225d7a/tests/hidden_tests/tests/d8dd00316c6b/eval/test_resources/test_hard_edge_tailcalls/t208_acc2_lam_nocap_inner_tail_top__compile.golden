def go(n, acc):
    while True:
        inc = lambda z: z + 1
        def count(k, c):
            while True:
                if k == 0:
                    return c
                else:
                    k, c = (k - 1, c + 1)
                    continue
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue
