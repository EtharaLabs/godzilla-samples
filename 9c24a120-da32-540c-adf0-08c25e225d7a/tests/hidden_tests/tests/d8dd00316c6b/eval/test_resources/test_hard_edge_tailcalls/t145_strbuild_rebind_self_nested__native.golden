def _pf_str_concat(a, b):
    return a + b
def outer(u) -> str:
    def go(s: str, n: int) -> str:
        _go = go
        if n == 0:
            return s
        else:
            return _go(_pf_str_concat(s, str(n)), n - 1)
    return go(">", 4)
print(outer(None))
