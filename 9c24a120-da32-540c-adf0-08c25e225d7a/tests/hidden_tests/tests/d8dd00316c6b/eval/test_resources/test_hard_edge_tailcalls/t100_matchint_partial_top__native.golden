import functools
def go(n: int, acc: int) -> int:
    while True:
        again = functools.partial(go, n)
        if n == 0:
            return acc
        elif n == 1:
            n, acc = (0, acc + 100)
            continue
        else:
            k = n
            if k > 5:
                n, acc = (k - 2, acc + k)
                continue
            k = n
            n, acc = (k - 1, acc - 1)
            continue
print(go(9, 0))
