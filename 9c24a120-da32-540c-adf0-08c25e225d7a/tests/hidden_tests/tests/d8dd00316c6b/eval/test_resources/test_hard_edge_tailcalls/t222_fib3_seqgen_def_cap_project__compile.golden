# ==== loop.py ====
def go(n, a, b):
    def _pf_fn0():
        yield 1
        yield 2
    ys = _pf_fn0()
    def helper(z):
        return (n, z)
    if n == 0:
        return a
    else:
        return go(n - 1, b, a + b)

