# ==== loop.py ====
def go(xs, acc):
    peek = lambda z: (xs, z)
    d = xs
    match xs:
        case []:
            return acc
        case [h, *t]:
            return go(t, acc + h)
        case _:
            raise RuntimeError("non-exhaustive match")

# ==== main.py ====
import loop
print(loop.go([4, 5, 6], 0))

