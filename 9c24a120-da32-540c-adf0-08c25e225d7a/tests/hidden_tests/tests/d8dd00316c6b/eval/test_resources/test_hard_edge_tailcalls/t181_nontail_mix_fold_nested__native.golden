def outer(u) -> int:
    def go(n: int, acc: int) -> int:
        while True:
            a = []
            for x in [1, 2]:
                a.append(x)
            folded = a
            if n == 0:
                return acc
            elif n == 3:
                return 1 + go(n - 1, acc)
            else:
                n, acc = (n - 1, acc + n)
                continue
    return go(5, 0)
print(outer(None))
