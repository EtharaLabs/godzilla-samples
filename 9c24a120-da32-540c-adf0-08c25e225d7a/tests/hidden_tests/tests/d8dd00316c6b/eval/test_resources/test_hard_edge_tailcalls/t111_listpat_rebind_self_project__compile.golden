# ==== loop.py ====
def go(xs, acc):
    _go = go
    match xs:
        case []:
            return acc
        case [h, *t]:
            return _go(t, acc + h)
        case _:
            raise RuntimeError("non-exhaustive match")

# ==== main.py ====
import loop
print(loop.go([4, 5, 6], 0))

