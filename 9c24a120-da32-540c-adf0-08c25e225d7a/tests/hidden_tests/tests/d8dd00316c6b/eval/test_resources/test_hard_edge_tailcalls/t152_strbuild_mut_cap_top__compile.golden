def _pf_str_concat(a, b):
    return a + b
def go(s, n):
    seen = 0
    def bump(k):
        nonlocal seen
        seen = seen + k
        return seen
    if n == 0:
        return s
    else:
        return go(_pf_str_concat(s, str(n)), n - 1)
