def go(n, acc):
    seen = 0
    def bump(k):
        nonlocal seen
        seen = seen + k
        return seen
    if n <= 0:
        return acc
    elif n % 2 == 0:
        return go(n - 1, acc * 2)
    else:
        return go(n - 1, acc + 1)
print(go(7, 1))
