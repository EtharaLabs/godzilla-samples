# ==== loop.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Inc:
    _0: int
    def __repr__(self):
        return f"Inc({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Dec:
    _0: int
    def __repr__(self):
        return f"Dec({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Stop:
    def __repr__(self):
        return "Stop"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Stop = Stop()
def go(cmds, total):
    while True:
        inc = lambda z: z + 1
        match cmds:
            case []:
                return total
            case [Inc(k), *rest] if k > 9:
                cmds, total = (rest, total + 1)
                continue
            case [Inc(k), *rest]:
                cmds, total = (rest, total + k)
                continue
            case [Dec(k), *rest]:
                cmds, total = (rest, total - k)
                continue
            case [Stop(), *_]:
                return total
            case _:
                raise RuntimeError("non-exhaustive match")

# ==== main.py ====
import loop
print(loop.go([loop.Inc(3), loop.Inc(20), loop.Dec(1), loop._Stop, loop.Inc(5)], 0))

