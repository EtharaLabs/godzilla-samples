def outer(u):
    def go(n, acc):
        while True:
            def count(k, c):
                while True:
                    if k == 0:
                        return c
                    else:
                        k, c = (k - 1, c + 1)
                        continue
            match n:
                case 0:
                    return acc
                case 1:
                    n, acc = (0, acc + 100)
                    continue
                case k if k > 5:
                    n, acc = (k - 2, acc + k)
                    continue
                case k:
