# ==== loop.py ====
def go(xs: list[int], acc: int) -> int:
    peek = lambda z: (xs, z)
    if len(xs) == 0:
        return acc
    else:
        h = xs[0]
        t = xs[1:len(xs)]
        return go(t, acc + h)

# ==== main.py ====
import loop
print(loop.go([4, 5, 6], 0))

--- stderr ---
note: in `Loop`: `go` calls itself in tail position but keeps its recursive form: a closure in it captures `xs`
