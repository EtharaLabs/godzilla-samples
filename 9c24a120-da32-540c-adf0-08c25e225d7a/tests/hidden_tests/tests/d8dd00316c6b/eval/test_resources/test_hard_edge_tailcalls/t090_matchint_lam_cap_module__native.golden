def Loop_go(n, acc):
    peek = lambda z: (n, z)
    if n == 0:
        return acc
    elif n == 1:
        return Loop_go(0, acc + 100)
    else:
        k = n
        if k > 5:
            return Loop_go(k - 2, acc + k)
        k = n
        return Loop_go(k - 1, acc - 1)
print(Loop_go(9, 0))
