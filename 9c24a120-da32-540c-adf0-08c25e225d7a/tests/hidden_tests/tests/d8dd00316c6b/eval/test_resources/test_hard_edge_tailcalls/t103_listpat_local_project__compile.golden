# ==== loop.py ====
def go(xs, acc):
    while True:
        d = xs
        match xs:
            case []:
                return acc
            case [h, *t]:
                xs, acc = (t, acc + h)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")

# ==== main.py ====
import loop
print(loop.go([4, 5, 6], 0))

