# ==== loop.py ====
def go(n: int, acc: int) -> int:
    while True:
        def helper(z: int) -> int:
            return z * 2
        if n <= 0:
            return acc
        elif n % 2 == 0:
            n, acc = (n - 1, acc * 2)
            continue
        else:
            n, acc = (n - 1, acc + 1)
            continue

# ==== main.py ====
import loop
print(loop.go(7, 1))

