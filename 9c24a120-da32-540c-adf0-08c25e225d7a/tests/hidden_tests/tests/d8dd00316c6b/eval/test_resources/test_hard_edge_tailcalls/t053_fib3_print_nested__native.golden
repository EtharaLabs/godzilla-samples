def outer(u) -> int:
    def go(n: int, a: int, b: int) -> int:
        while True:
            print(f"at {n}")
            if n == 0:
                return a
            else:
                n, a, b = (n - 1, b, a + b)
                continue
    return go(10, 0, 1)
print(outer(None))
