# ==== loop.py ====
def go(n, acc):
    while True:
        def _pf_fn0():
            yield 1
            yield 2
        ys = _pf_fn0()
        go2 = go
        if n <= 0:
            return acc
        elif n % 2 == 0:
            n, acc = (n - 1, acc * 2)
            continue
        else:
            n, acc = (n - 1, acc + 1)
            continue

