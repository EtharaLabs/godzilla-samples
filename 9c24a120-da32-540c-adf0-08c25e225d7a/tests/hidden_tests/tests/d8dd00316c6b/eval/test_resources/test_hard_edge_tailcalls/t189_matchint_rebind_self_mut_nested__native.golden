def outer(u) -> int:
    def go(n: int, acc: int) -> int:
        _go = go
        t = 0
        t = t + 1
        if n == 0:
            return acc
        elif n == 1:
            return _go(0, acc + 100)
        else:
            k = n
            if k > 5:
                return _go(k - 2, acc + k)
            k = n
            return _go(k - 1, acc - 1)
    return go(9, 0)
print(outer(None))
