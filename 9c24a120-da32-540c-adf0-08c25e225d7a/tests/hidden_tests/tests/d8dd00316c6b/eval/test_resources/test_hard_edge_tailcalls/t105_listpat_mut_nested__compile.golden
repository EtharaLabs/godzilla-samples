def outer(u):
    def go(xs, acc):
        while True:
            t = 0
            t = t + 1
            match xs:
                case []:
                    return acc
                case [h, *_t]:
                    xs, acc = (_t, acc + h)
                    continue
                case _:
                    raise RuntimeError("non-exhaustive match")
    return go([4, 5, 6], 0)
print(outer(None))
