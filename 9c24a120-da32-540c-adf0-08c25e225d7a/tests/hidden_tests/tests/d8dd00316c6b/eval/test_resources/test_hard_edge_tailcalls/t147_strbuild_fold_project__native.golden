# ==== loop.py ====
def _pf_str_concat(a, b):
    return a + b
def go(s: str, n: int) -> str:
    while True:
        a = []
        for x in [1, 2]:
            a.append(x)
        folded = a
        if n == 0:
            return s
        else:
            s, n = (_pf_str_concat(s, str(n)), n - 1)
            continue

# ==== main.py ====
import loop
print(loop.go(">", 4))

