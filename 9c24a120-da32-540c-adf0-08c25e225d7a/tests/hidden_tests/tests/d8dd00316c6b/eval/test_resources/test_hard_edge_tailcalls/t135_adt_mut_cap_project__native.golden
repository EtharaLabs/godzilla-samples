# ==== loop.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Inc:
    _0: int
    def __repr__(self):
        return f"Inc({self._0!r})"
    def __eq__(self, other):
        return type(other) is Inc and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Dec:
    _0: int
    def __repr__(self):
        return f"Dec({self._0!r})"
    def __eq__(self, other):
        return type(other) is Dec and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Stop:
    def __repr__(self):
        return "Stop"
    def __eq__(self, other):
        return type(other) is Stop and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (2,)
_Stop: Stop = Stop()
Cmd = Inc | Dec | Stop
def go(cmds: list[Cmd], total: int) -> int:
    while True:
        seen = 0
        def bump(k: int) -> int:
            nonlocal seen
            seen = seen + k
            return seen
        if len(cmds) == 0:
            return total
        else:
            if len(cmds) >= 1 and isinstance(cmds[0], Inc):
                k = cmds[0]._0
                rest = cmds[1:len(cmds)]
                if k > 9:
                    cmds, total = (rest, total + 1)
                    continue
            if len(cmds) >= 1 and isinstance(cmds[0], Inc):
                k = cmds[0]._0
                rest = cmds[1:len(cmds)]
                cmds, total = (rest, total + k)
                continue
            elif len(cmds) >= 1 and isinstance(cmds[0], Dec):
                k = cmds[0]._0
                rest = cmds[1:len(cmds)]
                cmds, total = (rest, total - k)
                continue
            else:
                return total

# ==== main.py ====
import loop
print(loop.go([loop.Inc(3), loop.Inc(20), loop.Dec(1), loop._Stop, loop.Inc(5)], 0))

