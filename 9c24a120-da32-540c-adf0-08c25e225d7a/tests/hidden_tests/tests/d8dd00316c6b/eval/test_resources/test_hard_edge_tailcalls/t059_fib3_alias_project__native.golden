# ==== loop.py ====
def go(n: int, a: int, b: int) -> int:
    while True:
        go2 = go
        if n == 0:
            return a
        else:
            n, a, b = (n - 1, b, a + b)
            continue

# ==== main.py ====
import loop
print(loop.go(10, 0, 1))

