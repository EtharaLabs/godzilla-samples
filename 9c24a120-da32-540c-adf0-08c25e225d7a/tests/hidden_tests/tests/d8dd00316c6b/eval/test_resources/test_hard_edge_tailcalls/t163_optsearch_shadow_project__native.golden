from _pyfun_rt import Some, None_, _None_
def _pf_list_get(i, xs):
    return Some(xs[i]) if 0 <= i < len(xs) else _None_
def go(i: int, xs: list[int]) -> Some | None_:
    while True:
        i = i
        _pf_t0 = _pf_list_get(i, xs)
        if isinstance(_pf_t0, Some):
            v = _pf_t0._0
            if v > 3:
                return Some(i)
        if isinstance(_pf_t0, Some):
            i, xs = (i + 1, xs)
            continue
        else:
            return _None_

