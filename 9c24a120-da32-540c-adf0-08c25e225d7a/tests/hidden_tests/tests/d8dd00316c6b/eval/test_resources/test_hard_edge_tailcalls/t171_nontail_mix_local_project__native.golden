# ==== loop.py ====
def go(n: int, acc: int) -> int:
    while True:
        d = n
        if n == 0:
            return acc
        elif n == 3:
            return 1 + go(n - 1, acc)
        else:
            n, acc = (n - 1, acc + n)
            continue

# ==== main.py ====
import loop
print(loop.go(5, 0))

