def outer(u):
    def go(n, acc):
        seen = 0
        def bump(k):
            nonlocal seen
            seen = seen + k
            return seen
        match n:
            case 0:
                return acc
            case 1:
                return go(0, acc + 100)
            case k if k > 5:
                return go(k - 2, acc + k)
            case k:
                return go(k - 1, acc - 1)
    return go(9, 0)
print(outer(None))
