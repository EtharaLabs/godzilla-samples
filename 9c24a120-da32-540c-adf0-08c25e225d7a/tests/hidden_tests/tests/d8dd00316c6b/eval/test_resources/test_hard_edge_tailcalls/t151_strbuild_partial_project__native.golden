# ==== loop.py ====
import functools
def _pf_str_concat(a, b):
    return a + b
def go(s: str, n: int) -> str:
    while True:
        again = functools.partial(go, s)
        if n == 0:
            return s
        else:
            s, n = (_pf_str_concat(s, str(n)), n - 1)
            continue

# ==== main.py ====
import loop
print(loop.go(">", 4))

