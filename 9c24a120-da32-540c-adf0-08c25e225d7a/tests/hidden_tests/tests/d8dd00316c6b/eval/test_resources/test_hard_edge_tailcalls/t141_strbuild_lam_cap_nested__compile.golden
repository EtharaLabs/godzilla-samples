def _pf_str_concat(a, b):
    return a + b
def outer(u):
    def go(s, n):
        peek = lambda z: (s, z)
        if n == 0:
            return s
        else:
            return go(_pf_str_concat(s, str(n)), n - 1)
    return go(">", 4)
print(outer(None))
