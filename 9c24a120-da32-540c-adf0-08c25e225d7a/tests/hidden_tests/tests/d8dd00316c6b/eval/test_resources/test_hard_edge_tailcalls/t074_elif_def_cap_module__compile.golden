def Loop_go(n, acc):
    def helper(z):
        return (n, z)
    if n <= 0:
        return acc
    elif n % 2 == 0:
        return Loop_go(n - 1, acc * 2)
    else:
        return Loop_go(n - 1, acc + 1)
print(Loop_go(7, 1))
