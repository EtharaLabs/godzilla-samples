import functools
def _pf_concat(xs, ys):
    return xs + ys
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def Loop_go(n, a, b):
    while True:
        folded = _pf_fold(lambda a, x: _pf_concat(a, [x]), [], [1, 2])
        if n == 0:
            return a
        else:
            n, a, b = (n - 1, b, a + b)
            continue
print(Loop_go(10, 0, 1))
