# ==== loop.py ====
def go(n: int) -> int:
    while True:
        a = []
        for x in [1, 2]:
            a.append(x)
        folded = a
        if n % 7 == 0:
            return n
        else:
            n = n + 1
            continue

# ==== main.py ====
import loop
print(loop.go(8))

