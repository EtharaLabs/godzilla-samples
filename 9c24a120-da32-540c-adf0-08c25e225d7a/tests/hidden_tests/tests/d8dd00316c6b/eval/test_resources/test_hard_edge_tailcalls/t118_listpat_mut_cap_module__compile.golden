def Loop_go(xs, acc):
    seen = 0
    def bump(k):
        nonlocal seen
        seen = seen + k
        return seen
    match xs:
        case []:
            return acc
        case [h, *t]:
            return Loop_go(t, acc + h)
        case _:
            raise RuntimeError("non-exhaustive match")
print(Loop_go([4, 5, 6], 0))
