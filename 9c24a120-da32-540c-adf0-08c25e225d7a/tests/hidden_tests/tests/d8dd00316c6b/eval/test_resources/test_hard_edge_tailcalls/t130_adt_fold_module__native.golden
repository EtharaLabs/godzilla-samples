from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class Inc:
    _0: int
    def __repr__(self):
        return f"Inc({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Dec:
    _0: int
    def __repr__(self):
        return f"Dec({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Stop:
    def __repr__(self):
        return "Stop"
_Stop: Stop = Stop()
Cmd = Inc | Dec | Stop
def Loop_go(cmds, total):
    while True:
        a = []
        for x in [1, 2]:
            a.append(x)
        folded = a
        if len(cmds) == 0:
            return total
        else:
            if len(cmds) >= 1 and isinstance(cmds[0], Inc):
                k = cmds[0]._0
                rest = cmds[1:len(cmds)]
                if k > 9:
                    cmds, total = (rest, total + 1)
                    continue
            if len(cmds) >= 1 and isinstance(cmds[0], Inc):
                k = cmds[0]._0
                rest = cmds[1:len(cmds)]
                cmds, total = (rest, total + k)
                continue
            elif len(cmds) >= 1 and isinstance(cmds[0], Dec):
                k = cmds[0]._0
                rest = cmds[1:len(cmds)]
                cmds, total = (rest, total - k)
                continue
            else:
                return total
print(Loop_go([Inc(3), Inc(20), Dec(1), _Stop, Inc(5)], 0))
