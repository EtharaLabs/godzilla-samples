import functools
def outer(u) -> tuple[int, int]:
    def go(a: int, b: int) -> tuple[int, int]:
        while True:
            again = functools.partial(go, a)
            if a > 50:
                return (a, b)
            else:
                a, b = (b, a + b)
                continue
    return go(1, 2)
