# ==== loop.py ====
def go(n, acc):
    def helper(z):
        return (n, z)
    match n:
        case 0:
            return acc
        case 1:
            return go(0, acc + 100)
        case k if k > 5:
            return go(k - 2, acc + k)
        case k:
            return go(k - 1, acc - 1)

# ==== main.py ====
import loop
print(loop.go(9, 0))

