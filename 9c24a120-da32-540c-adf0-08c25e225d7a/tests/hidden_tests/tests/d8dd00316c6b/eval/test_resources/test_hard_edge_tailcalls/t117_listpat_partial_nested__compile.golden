import functools
def outer(u):
    def go(xs, acc):
        while True:
            again = functools.partial(go, xs)
            match xs:
                case []:
                    return acc
                case [h, *t]:
                    xs, acc = (t, acc + h)
                    continue
                case _:
                    raise RuntimeError("non-exhaustive match")
    return go([4, 5, 6], 0)
print(outer(None))
