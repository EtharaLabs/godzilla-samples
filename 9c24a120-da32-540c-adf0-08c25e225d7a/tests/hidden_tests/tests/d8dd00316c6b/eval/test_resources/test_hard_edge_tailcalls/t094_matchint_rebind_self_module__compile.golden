def Loop_go(n, acc):
    _go = Loop_go
    match n:
        case 0:
            return acc
        case 1:
            return _go(0, acc + 100)
        case k if k > 5:
            return _go(k - 2, acc + k)
        case k:
            return _go(k - 1, acc - 1)
print(Loop_go(9, 0))
