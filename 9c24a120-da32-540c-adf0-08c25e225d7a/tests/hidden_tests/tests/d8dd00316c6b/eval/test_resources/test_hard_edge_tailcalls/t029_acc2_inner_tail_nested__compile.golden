def outer(u):
    def go(n, acc):
        while True:
            def count(k, c):
                while True:
                    if k == 0:
                        return c
                    else:
                        k, c = (k - 1, c + 1)
                        continue
            if n == 0:
                return acc
            else:
                n, acc = (n - 1, acc + n)
                continue
    return go(6, 0)
