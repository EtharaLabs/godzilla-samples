def go(xs: list[int], acc: int) -> int:
    while True:
        print(f"at {xs}")
        if len(xs) == 0:
            return acc
        else:
            h = xs[0]
            t = xs[1:len(xs)]
            xs, acc = (t, acc + h)
            continue
print(go([4, 5, 6], 0))
