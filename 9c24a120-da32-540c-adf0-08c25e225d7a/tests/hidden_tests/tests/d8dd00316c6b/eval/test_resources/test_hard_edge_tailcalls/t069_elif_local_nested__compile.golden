def outer(u):
    def go(n, acc):
        while True:
            d = n
            if n <= 0:
                return acc
            elif n % 2 == 0:
                n, acc = (n - 1, acc * 2)
                continue
            else:
                n, acc = (n - 1, acc + 1)
                continue
    return go(7, 1)
print(outer(None))
