def go(n: int, acc: int) -> int:
    while True:
        def helper(z):
            return (n, z)
        if n == 0:
            return acc
        elif n == 3:
            return 1 + go(n - 1, acc)
        else:
            n, acc = (n - 1, acc + n)
            continue
print(go(5, 0))
