def go(xs, acc):
    while True:
        xs = xs
        match xs:
            case []:
                return acc
            case [h, *t]:
                xs, acc = (t, acc + h)
                continue
            case _:
                raise RuntimeError("non-exhaustive match")
print(go([4, 5, 6], 0))
