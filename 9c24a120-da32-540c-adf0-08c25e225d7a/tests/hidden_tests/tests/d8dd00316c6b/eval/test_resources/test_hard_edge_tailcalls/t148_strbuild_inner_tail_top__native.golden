def _pf_str_concat(a, b):
    return a + b
def go(s: str, n: int) -> str:
    while True:
        def count(k: int, c: int) -> int:
            while True:
                if k == 0:
                    return c
                else:
                    k, c = (k - 1, c + 1)
                    continue
        if n == 0:
            return s
        else:
            s, n = (_pf_str_concat(s, str(n)), n - 1)
            continue
print(go(">", 4))
