def outer(u):
    def go(n, acc):
        seen = 0
        def bump(k):
            nonlocal seen
            seen = seen + k
            return seen
        if n == 0:
            return acc
        else:
            return go(n - 1, acc + n)
    return go(6, 0)
print(outer(None))
