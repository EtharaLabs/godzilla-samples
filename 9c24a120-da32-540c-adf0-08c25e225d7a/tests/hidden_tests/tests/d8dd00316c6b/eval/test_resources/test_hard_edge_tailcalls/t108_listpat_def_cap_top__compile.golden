def go(xs, acc):
    def helper(z):
        return (xs, z)
    match xs:
        case []:
            return acc
        case [h, *t]:
            return go(t, acc + h)
        case _:
            raise RuntimeError("non-exhaustive match")
print(go([4, 5, 6], 0))
