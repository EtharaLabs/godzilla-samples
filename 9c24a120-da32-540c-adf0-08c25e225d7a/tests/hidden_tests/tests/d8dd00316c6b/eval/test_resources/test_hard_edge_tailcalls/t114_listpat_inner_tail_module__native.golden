def Loop_go(xs, acc):
    while True:
        def count(k: int, c: int) -> int:
            while True:
                if k == 0:
                    return c
                else:
                    k, c = (k - 1, c + 1)
                    continue
        if len(xs) == 0:
            return acc
        else:
            h = xs[0]
            t = xs[1:len(xs)]
            xs, acc = (t, acc + h)
            continue
print(Loop_go([4, 5, 6], 0))
