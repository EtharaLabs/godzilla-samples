def go(n: int, acc: int) -> int:
    while True:
        def helper(z):
            return (n, z)
        def count(k: int, c: int) -> int:
            while True:
                if k == 0:
                    return c
                else:
                    k, c = (k - 1, c + 1)
                    continue
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue
