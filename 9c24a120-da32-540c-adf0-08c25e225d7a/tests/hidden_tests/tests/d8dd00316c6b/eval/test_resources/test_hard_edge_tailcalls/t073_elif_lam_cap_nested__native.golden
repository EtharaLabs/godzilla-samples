def outer(u) -> int:
    def go(n: int, acc: int) -> int:
        peek = lambda z: (n, z)
        if n <= 0:
            return acc
        elif n % 2 == 0:
            return go(n - 1, acc * 2)
        else:
            return go(n - 1, acc + 1)
    return go(7, 1)
print(outer(None))
