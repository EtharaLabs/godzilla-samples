def outer(u) -> int:
    def go(n: int, acc: int) -> int:
        while True:
            seen = 0
            def bump(k: int) -> int:
                nonlocal seen
                seen = seen + k
                return seen
            if n == 0:
                return acc
            else:
                n, acc = (n - 1, acc + n)
                continue
    return go(6, 0)
print(outer(None))
