# ==== alpha.py ====
import delta
import golf
print("loading Alpha")
base = 8 + delta.base + golf.base
def step(x):
    return golf.step(delta.step(x)) + 8
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))

# ==== foxtrot.py ====
import alpha
import bravo
import delta
import echo
base = 6 + echo.base + bravo.base + delta.base + alpha.base
def step(x):
    return alpha.step(delta.step(bravo.step(echo.step(x)))) + 6
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== main.py ====
import delta
import foxtrot
print(foxtrot.base)
print(foxtrot.step(1))
print(foxtrot.probe)
print(delta.probe)
print(delta.unwrap(delta.make(5)))
print(delta.make(1).id)

