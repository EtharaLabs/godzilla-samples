from dataclasses import dataclass
import alpha
import bravo
import echo
import foxtrot
import hotel
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
base = 4 + echo.base + foxtrot.base + bravo.base + hotel.base + alpha.base
def step(x):
    return alpha.step(hotel.step(bravo.step(foxtrot.step(echo.step(x))))) + 4
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecD(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)
