import delta
import golf
print("loading Alpha")
base = 8 + delta.base + golf.base
def step(x):
    return golf.step(delta.step(x)) + 8
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))
