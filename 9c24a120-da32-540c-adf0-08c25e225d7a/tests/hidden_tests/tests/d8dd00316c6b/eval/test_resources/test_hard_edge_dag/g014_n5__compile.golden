# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 7
def step(x):
    return x + 7

# ==== foxtrot.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaF:
    _0: int
    def __repr__(self):
        return f"KaF({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbF:
    def __repr__(self):
        return "KbF"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbF = KbF()
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
print("loading Foxtrot")
def pickF(n):
    if n > 2:
        return KaF(n)
    else:
        return _KbF
base = 1 + alpha.base
def step(x):
    return alpha.step(x) + 1
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecF(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)

# ==== bravo.py ====
import foxtrot
print("loading Bravo")
base = 7 + foxtrot.base
def step(x):
    return foxtrot.step(x) + 7
def describe(k):
    match k:
        case foxtrot.KaF(v):
            return v * 10
        case foxtrot.KbF():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(foxtrot.pickF(base))

# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
import bravo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 1 + bravo.base + alpha.base
def step(x):
    return alpha.step(bravo.step(x)) + 1
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecD(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import delta
import foxtrot
print(delta.base)
print(delta.step(1))
print(foxtrot.probe)
print(foxtrot.unwrap(foxtrot.make(5)))
print(foxtrot.make(1).id)
print(delta.probe)
print(delta.unwrap(delta.make(5)))
print(delta.make(1).id)

