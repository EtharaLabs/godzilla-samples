# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 6 + echo.base
def step(x):
    return echo.step(x) + 6
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))

# ==== delta.py ====
from dataclasses import dataclass
import alpha
import bravo
import echo
import foxtrot
import hotel
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
base = 4 + echo.base + foxtrot.base + bravo.base + hotel.base + alpha.base
def step(x):
    return alpha.step(hotel.step(bravo.step(foxtrot.step(echo.step(x))))) + 4
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecD(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import delta
print(delta.base)
print(delta.step(1))
print(delta.probe)
print(delta.unwrap(delta.make(5)))
print(delta.make(1).id)

