# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
print("loading Bravo")
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 7 + echo.base
def step(x):
    return echo.step(x) + 7

