# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 5
def step(x):
    return x + 5

# ==== foxtrot.py ====
import bravo
print("loading Foxtrot")
base = 4 + bravo.base
def step(x):
    return bravo.step(x) + 4
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import foxtrot
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 4 + foxtrot.base + bravo.base
def step(x):
    return bravo.step(foxtrot.step(x)) + 4
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== delta.py ====
from dataclasses import dataclass
import alpha
import bravo
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
base = 3 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 3
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecD(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import delta
import foxtrot
print(delta.base)
print(delta.step(1))
print(delta.probe)
print(delta.unwrap(delta.make(5)))
print(delta.make(1).id)
print(foxtrot.probe)

