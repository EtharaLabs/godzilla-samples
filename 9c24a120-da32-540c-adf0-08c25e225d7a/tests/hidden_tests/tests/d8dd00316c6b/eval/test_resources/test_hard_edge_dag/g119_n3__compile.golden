# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
print("loading Alpha")
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 6 + bravo.base + delta.base
def step(x):
    return delta.step(bravo.step(x)) + 6

# ==== main.py ====
import alpha
print(alpha.base)
print(alpha.step(1))

