# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
print("loading Alpha")
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 4 + bravo.base
def step(x):
    return bravo.step(x) + 4

# ==== golf.py ====
from dataclasses import dataclass
import alpha
import bravo
@dataclass(frozen=True, slots=True, order=True)
class RecG:
    id: int
    kind: object
base = 6 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 6
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecG(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import golf
print(golf.base)
print(golf.step(1))
print(golf.probe)
print(golf.unwrap(golf.make(5)))
print(golf.make(1).id)

