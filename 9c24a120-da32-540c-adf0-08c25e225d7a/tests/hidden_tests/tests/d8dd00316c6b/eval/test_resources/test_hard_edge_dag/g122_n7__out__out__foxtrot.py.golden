from dataclasses import dataclass
import echo
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
print("loading Foxtrot")
base = 7 + echo.base
def step(x):
    return echo.step(x) + 7
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecF(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)
