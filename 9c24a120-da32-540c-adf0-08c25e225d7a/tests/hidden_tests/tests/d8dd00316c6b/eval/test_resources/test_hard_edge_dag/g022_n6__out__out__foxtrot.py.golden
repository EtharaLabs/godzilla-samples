from dataclasses import dataclass
from functools import total_ordering
import alpha
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaF:
    _0: int
    def __repr__(self):
        return f"KaF({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbF:
    def __repr__(self):
        return "KbF"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbF = KbF()
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
def pickF(n):
    if n > 2:
        return KaF(n)
    else:
        return _KbF
base = 2 + alpha.base
def step(x):
    return alpha.step(x) + 2
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecF(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)
