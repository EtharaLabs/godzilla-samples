# ==== foxtrot.py ====
print("loading Foxtrot")
base = 1
def step(x):
    return x + 1

# ==== delta.py ====
import foxtrot
print("loading Delta")
base = 2 + foxtrot.base
def step(x):
    return foxtrot.step(x) + 2

# ==== echo.py ====
import delta
print("loading Echo")
base = 3 + delta.base
def step(x):
    return delta.step(x) + 3

# ==== alpha.py ====
import delta
import echo
import foxtrot
print("loading Alpha")
base = 5 + echo.base + foxtrot.base + delta.base
def step(x):
    return delta.step(foxtrot.step(echo.step(x))) + 5

# ==== bravo.py ====
import alpha
base = 4 + alpha.base
def step(x):
    return alpha.step(x) + 4

# ==== main.py ====
import bravo
print(bravo.base)
print(bravo.step(1))

