# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
import foxtrot
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 6 + foxtrot.base
def step(x):
    return foxtrot.step(x) + 6

# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import echo
import foxtrot
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
print("loading Delta")
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 5 + foxtrot.base + echo.base + bravo.base
def step(x):
    return bravo.step(echo.step(foxtrot.step(x))) + 5
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== alpha.py ====
from dataclasses import dataclass
import bravo
import foxtrot
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
print("loading Alpha")
base = 7 + bravo.base + foxtrot.base
def step(x):
    return foxtrot.step(bravo.step(x)) + 7
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecA(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import alpha
import delta
print(delta.base)
print(delta.step(1))
print(delta.probe)
print(alpha.probe)
print(alpha.unwrap(alpha.make(5)))
print(alpha.make(1).id)

