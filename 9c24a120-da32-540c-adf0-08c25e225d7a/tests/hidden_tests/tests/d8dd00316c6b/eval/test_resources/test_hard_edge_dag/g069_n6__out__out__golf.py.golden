import bravo
import delta
base = 1 + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(x)) + 1
def describe(k):
    match k:
        case delta.KaD(v):
            return v * 10
        case delta.KbD():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(delta.pickD(base))
