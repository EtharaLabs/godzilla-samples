# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
print("loading Echo")
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 8 + alpha.base
def step(x):
    return alpha.step(x) + 8

# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
@dataclass(frozen=True, slots=True, order=True)
class RecB:
    id: int
    kind: object
print("loading Bravo")
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 8 + echo.base
def step(x):
    return echo.step(x) + 8
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecB(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)

# ==== delta.py ====
import alpha
import bravo
base = 1 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 1
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== main.py ====
import delta
print(delta.base)
print(delta.step(1))
print(delta.probe)

