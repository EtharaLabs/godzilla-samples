from dataclasses import dataclass
from functools import total_ordering
import alpha
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaH:
    _0: int
    def __repr__(self):
        return f"KaH({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbH:
    def __repr__(self):
        return "KbH"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbH = KbH()
@dataclass(frozen=True, slots=True, order=True)
class RecH:
    id: int
    kind: object
print("loading Hotel")
def pickH(n):
    if n > 2:
        return KaH(n)
    else:
        return _KbH
base = 5 + echo.base + alpha.base
def step(x):
    return alpha.step(echo.step(x)) + 5
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecH(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)
