# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
print("loading Bravo")
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 4
def step(x):
    return x + 4

# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 9 + bravo.base
def step(x):
    return bravo.step(x) + 9
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecD(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import delta
print(delta.base)
print(delta.step(1))
print(delta.probe)
print(delta.unwrap(delta.make(5)))
print(delta.make(1).id)

