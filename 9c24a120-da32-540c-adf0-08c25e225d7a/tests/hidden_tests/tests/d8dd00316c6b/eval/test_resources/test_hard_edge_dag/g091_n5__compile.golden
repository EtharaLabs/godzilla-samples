# ==== alpha.py ====
import delta
print("loading Alpha")
base = 2 + delta.base
def step(x):
    return delta.step(x) + 2

# ==== foxtrot.py ====
import alpha
import delta
print("loading Foxtrot")
base = 4 + delta.base + alpha.base
def step(x):
    return alpha.step(delta.step(x)) + 4

# ==== bravo.py ====
import alpha
import foxtrot
print("loading Bravo")
base = 4 + foxtrot.base + alpha.base
def step(x):
    return alpha.step(foxtrot.step(x)) + 4

# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
print("loading Echo")
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 5 + delta.base
def step(x):
    return delta.step(x) + 5

