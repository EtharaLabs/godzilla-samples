import alpha
import bravo
print("loading Echo")
base = 8 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 8
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
