import golf
base = 6 + golf.base
def step(x):
    return golf.step(x) + 6
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))
