import foxtrot
print("loading Golf")
base = 3 + foxtrot.base
def step(x):
    return foxtrot.step(x) + 3
def describe(k):
    match k:
        case foxtrot.KaF(v):
            return v * 10
        case foxtrot.KbF():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(foxtrot.pickF(base))
