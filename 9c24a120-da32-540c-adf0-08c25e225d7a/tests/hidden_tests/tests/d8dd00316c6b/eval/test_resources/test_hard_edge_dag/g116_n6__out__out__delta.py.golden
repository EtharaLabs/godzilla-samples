import bravo
import foxtrot
import golf
print("loading Delta")
base = 8 + golf.base + bravo.base + foxtrot.base
def step(x):
    return foxtrot.step(bravo.step(golf.step(x))) + 8
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
