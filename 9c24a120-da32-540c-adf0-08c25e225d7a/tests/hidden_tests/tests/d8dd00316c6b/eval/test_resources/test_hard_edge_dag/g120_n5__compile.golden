# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 8
def step(x):
    return x + 8

# ==== bravo.py ====
import echo
base = 1 + echo.base
def step(x):
    return echo.step(x) + 1
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))

# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 6 + bravo.base
def step(x):
    return bravo.step(x) + 6

# ==== delta.py ====
from dataclasses import dataclass
import alpha
import bravo
import echo
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
base = 3 + alpha.base + bravo.base + echo.base
def step(x):
    return echo.step(bravo.step(alpha.step(x))) + 3
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecD(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import bravo
import delta
print(delta.base)
print(delta.step(1))
print(delta.probe)
print(delta.unwrap(delta.make(5)))
print(delta.make(1).id)
print(bravo.probe)

