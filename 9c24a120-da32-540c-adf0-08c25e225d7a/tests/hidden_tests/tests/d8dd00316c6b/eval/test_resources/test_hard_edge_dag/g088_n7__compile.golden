# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
import foxtrot
import hotel
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
print("loading Delta")
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 1 + foxtrot.base + echo.base + hotel.base
def step(x):
    return hotel.step(echo.step(foxtrot.step(x))) + 1

# ==== main.py ====
import delta
import echo
print(delta.base)
print(delta.step(1))
print(echo.probe)
print(echo.unwrap(echo.make(5)))
print(echo.make(1).id)

