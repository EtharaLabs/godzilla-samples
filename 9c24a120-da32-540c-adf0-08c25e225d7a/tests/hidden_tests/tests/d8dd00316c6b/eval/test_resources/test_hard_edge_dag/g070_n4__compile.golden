# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 4
def step(x):
    return x + 4

# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 6 + alpha.base
def step(x):
    return alpha.step(x) + 6
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))

# ==== bravo.py ====
from dataclasses import dataclass
import alpha
import delta
@dataclass(frozen=True, slots=True, order=True)
class RecB:
    id: int
    kind: object
print("loading Bravo")
base = 3 + delta.base + alpha.base
def step(x):
    return alpha.step(delta.step(x)) + 3
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecB(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import bravo
import delta
print(bravo.base)
print(bravo.step(1))
print(bravo.probe)
print(bravo.unwrap(bravo.make(5)))
print(bravo.make(1).id)
print(delta.probe)

