# ==== foxtrot.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
import bravo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaF:
    _0: int
    def __repr__(self):
        return f"KaF({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbF:
    def __repr__(self):
        return "KbF"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbF = KbF()
def pickF(n):
    if n > 2:
        return KaF(n)
    else:
        return _KbF
base = 3 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 3

# ==== hotel.py ====
import foxtrot
base = 3 + foxtrot.base
def step(x):
    return foxtrot.step(x) + 3
def describe(k):
    match k:
        case foxtrot.KaF(v):
            return v * 10
        case foxtrot.KbF():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(foxtrot.pickF(base))

# ==== golf.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
import hotel
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaG:
    _0: int
    def __repr__(self):
        return f"KaG({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbG:
    def __repr__(self):
        return "KbG"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbG = KbG()
print("loading Golf")
def pickG(n):
    if n > 2:
        return KaG(n)
    else:
        return _KbG
base = 3 + hotel.base + alpha.base
def step(x):
    return alpha.step(hotel.step(x)) + 3

# ==== main.py ====
import golf
print(golf.base)
print(golf.step(1))

