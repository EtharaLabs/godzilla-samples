# ==== delta.py ====
import alpha
import bravo
import golf
import hotel
print("loading Delta")
base = 2 + golf.base + hotel.base + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(hotel.step(golf.step(x)))) + 2
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

