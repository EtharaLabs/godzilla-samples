# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 1
def step(x):
    return x + 1

# ==== foxtrot.py ====
from dataclasses import dataclass
import echo
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
print("loading Foxtrot")
base = 7 + echo.base
def step(x):
    return echo.step(x) + 7
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecF(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)

