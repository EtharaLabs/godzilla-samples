import bravo
print("loading Foxtrot")
base = 4 + bravo.base
def step(x):
    return bravo.step(x) + 4
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
