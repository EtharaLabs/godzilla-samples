# ==== golf.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaG:
    _0: int
    def __repr__(self):
        return f"KaG({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbG:
    def __repr__(self):
        return "KbG"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbG = KbG()
print("loading Golf")
def pickG(n):
    if n > 2:
        return KaG(n)
    else:
        return _KbG
base = 4 + delta.base
def step(x):
    return delta.step(x) + 4

# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
import golf
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
@dataclass(frozen=True, slots=True, order=True)
class RecE:
    id: int
    kind: object
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 6 + delta.base + golf.base
def step(x):
    return golf.step(delta.step(x)) + 6
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))
def make(n):
    return RecE(n, golf.pickG(n))
def unwrap(r):
    return describe(r.kind)

# ==== foxtrot.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaF:
    _0: int
    def __repr__(self):
        return f"KaF({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbF:
    def __repr__(self):
        return "KbF"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbF = KbF()
def pickF(n):
    if n > 2:
        return KaF(n)
    else:
        return _KbF
base = 2 + echo.base
def step(x):
    return echo.step(x) + 2
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))

# ==== main.py ====
import echo
import foxtrot
print(foxtrot.base)
print(foxtrot.step(1))
print(echo.probe)
print(echo.unwrap(echo.make(5)))
print(echo.make(1).id)
print(foxtrot.probe)

