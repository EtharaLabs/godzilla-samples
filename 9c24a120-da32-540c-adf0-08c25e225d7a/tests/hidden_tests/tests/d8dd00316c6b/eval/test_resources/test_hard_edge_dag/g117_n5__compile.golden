# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 2 + delta.base
def step(x):
    return delta.step(x) + 2

# ==== alpha.py ====
from dataclasses import dataclass
import bravo
import delta
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
base = 3 + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(x)) + 3
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecA(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== foxtrot.py ====
from dataclasses import dataclass
import bravo
import delta
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
print("loading Foxtrot")
base = 6 + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(x)) + 6
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecF(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== echo.py ====
import alpha
import foxtrot
print("loading Echo")
base = 2 + alpha.base + foxtrot.base
def step(x):
    return foxtrot.step(alpha.step(x)) + 2

# ==== main.py ====
import echo
import foxtrot
print(echo.base)
print(echo.step(1))
print(foxtrot.probe)
print(foxtrot.unwrap(foxtrot.make(5)))
print(foxtrot.make(1).id)

