from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaH:
    _0: int
    def __repr__(self):
        return f"KaH({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbH:
    def __repr__(self):
        return "KbH"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbH = KbH()
print("loading Hotel")
def pickH(n):
    if n > 2:
        return KaH(n)
    else:
        return _KbH
base = 8 + echo.base
def step(x):
    return echo.step(x) + 8
