from dataclasses import dataclass
import hotel
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
print("loading Foxtrot")
base = 5 + hotel.base
def step(x):
    return hotel.step(x) + 5
def describe(k):
    match k:
        case hotel.KaH(v):
            return v * 10
        case hotel.KbH():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(hotel.pickH(base))
def make(n):
    return RecF(n, hotel.pickH(n))
def unwrap(r):
    return describe(r.kind)
