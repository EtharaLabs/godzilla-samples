# ==== golf.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaG:
    _0: int
    def __repr__(self):
        return f"KaG({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbG:
    def __repr__(self):
        return "KbG"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbG = KbG()
print("loading Golf")
def pickG(n):
    if n > 2:
        return KaG(n)
    else:
        return _KbG
base = 7
def step(x):
    return x + 7

# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import golf
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 7 + golf.base
def step(x):
    return golf.step(x) + 7
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))
def make(n):
    return RecD(n, golf.pickG(n))
def unwrap(r):
    return describe(r.kind)

