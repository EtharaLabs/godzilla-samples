# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import delta
import golf
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
@dataclass(frozen=True, slots=True, order=True)
class RecE:
    id: int
    kind: object
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 5 + golf.base + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(golf.step(x))) + 5
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecE(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import echo
print(echo.base)
print(echo.step(1))
print(echo.probe)
print(echo.unwrap(echo.make(5)))
print(echo.make(1).id)

