# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
print("loading Bravo")
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 7
def step(x):
    return x + 7

# ==== echo.py ====
from dataclasses import dataclass
import bravo
@dataclass(frozen=True, slots=True, order=True)
class RecE:
    id: int
    kind: object
print("loading Echo")
base = 4 + bravo.base
def step(x):
    return bravo.step(x) + 4
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecE(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== alpha.py ====
from dataclasses import dataclass
import bravo
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
print("loading Alpha")
base = 1 + bravo.base
def step(x):
    return bravo.step(x) + 1
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecA(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import alpha
import echo
print(echo.base)
print(echo.step(1))
print(echo.probe)
print(echo.unwrap(echo.make(5)))
print(echo.make(1).id)
print(alpha.probe)
print(alpha.unwrap(alpha.make(5)))
print(alpha.make(1).id)

