# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 1 + delta.base
def step(x):
    return delta.step(x) + 1

# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 9 + echo.base
def step(x):
    return echo.step(x) + 9
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecA(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)

# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
@dataclass(frozen=True, slots=True, order=True)
class RecB:
    id: int
    kind: object
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 4 + echo.base
def step(x):
    return echo.step(x) + 4
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecB(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import alpha
import bravo
print(bravo.base)
print(bravo.step(1))
print(alpha.probe)
print(alpha.unwrap(alpha.make(5)))
print(alpha.make(1).id)
print(bravo.probe)
print(bravo.unwrap(bravo.make(5)))
print(bravo.make(1).id)

