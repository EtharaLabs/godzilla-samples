# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
import golf
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 1 + golf.base
def step(x):
    return golf.step(x) + 1

# ==== delta.py ====
from dataclasses import dataclass
import bravo
import golf
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
base = 3 + bravo.base + golf.base
def step(x):
    return golf.step(bravo.step(x)) + 3
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecD(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)

# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import golf
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
print("loading Echo")
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 7 + golf.base
def step(x):
    return golf.step(x) + 7

# ==== main.py ====
import delta
print(delta.base)
print(delta.step(1))
print(delta.probe)
print(delta.unwrap(delta.make(5)))
print(delta.make(1).id)

