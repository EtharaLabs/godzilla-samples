import bravo
import delta
base = 7 + bravo.base + delta.base
def step(x):
    return delta.step(bravo.step(x)) + 7
def describe(k):
    match k:
        case delta.KaD(v):
            return v * 10
        case delta.KbD():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(delta.pickD(base))

