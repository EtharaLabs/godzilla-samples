# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
print("loading Delta")
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 3
def step(x):
    return x + 3

# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 6 + delta.base
def step(x):
    return delta.step(x) + 6
def describe(k):
    match k:
        case delta.KaD(v):
            return v * 10
        case delta.KbD():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(delta.pickD(base))
def make(n):
    return RecA(n, delta.pickD(n))
def unwrap(r):
    return describe(r.kind)

# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 6 + alpha.base
def step(x):
    return alpha.step(x) + 6
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))

# ==== main.py ====
import bravo
print(bravo.base)
print(bravo.step(1))
print(bravo.probe)

