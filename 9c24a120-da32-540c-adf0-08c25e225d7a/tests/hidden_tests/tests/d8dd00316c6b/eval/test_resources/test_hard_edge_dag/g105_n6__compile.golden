# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import foxtrot
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
print("loading Alpha")
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 4 + foxtrot.base
def step(x):
    return foxtrot.step(x) + 4

# ==== golf.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
import foxtrot
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaG:
    _0: int
    def __repr__(self):
        return f"KaG({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbG:
    def __repr__(self):
        return "KbG"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbG = KbG()
def pickG(n):
    if n > 2:
        return KaG(n)
    else:
        return _KbG
base = 9 + alpha.base + foxtrot.base
def step(x):
    return foxtrot.step(alpha.step(x)) + 9
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))

