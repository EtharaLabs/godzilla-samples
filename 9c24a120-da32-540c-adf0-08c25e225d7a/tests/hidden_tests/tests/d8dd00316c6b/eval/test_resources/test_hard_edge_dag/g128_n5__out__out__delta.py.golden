from dataclasses import dataclass
import alpha
import bravo
@dataclass(frozen=True, slots=True, order=True)
class RecD:
    id: int
    kind: object
print("loading Delta")
base = 3 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 3
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecD(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)
