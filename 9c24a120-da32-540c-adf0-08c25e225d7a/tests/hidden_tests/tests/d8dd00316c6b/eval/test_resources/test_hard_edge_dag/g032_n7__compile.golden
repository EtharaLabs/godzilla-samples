# ==== delta.py ====
import echo
import golf
base = 4 + golf.base + echo.base
def step(x):
    return echo.step(golf.step(x)) + 4
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))

# ==== hotel.py ====
from dataclasses import dataclass
from functools import total_ordering
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaH:
    _0: int
    def __repr__(self):
        return f"KaH({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbH:
    def __repr__(self):
        return "KbH"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbH = KbH()
print("loading Hotel")
def pickH(n):
    if n > 2:
        return KaH(n)
    else:
        return _KbH
base = 8 + echo.base
def step(x):
    return echo.step(x) + 8

# ==== bravo.py ====
from dataclasses import dataclass
import echo
import hotel
@dataclass(frozen=True, slots=True, order=True)
class RecB:
    id: int
    kind: object
print("loading Bravo")
base = 7 + hotel.base + echo.base
def step(x):
    return echo.step(hotel.step(x)) + 7
def describe(k):
    match k:
        case hotel.KaH(v):
            return v * 10
        case hotel.KbH():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(hotel.pickH(base))
def make(n):
    return RecB(n, hotel.pickH(n))
def unwrap(r):
    return describe(r.kind)

