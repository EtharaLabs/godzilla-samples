            return v * 10
        case foxtrot.KbF():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(foxtrot.pickF(base))

# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
import delta
import foxtrot
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
@dataclass(frozen=True, slots=True, order=True)
class RecE:
    id: int
    kind: object
print("loading Echo")
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 4 + foxtrot.base + delta.base + alpha.base
def step(x):
    return alpha.step(delta.step(foxtrot.step(x))) + 4
def describe(k):
    match k:
        case foxtrot.KaF(v):
            return v * 10
        case foxtrot.KbF():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(foxtrot.pickF(base))
def make(n):
    return RecE(n, foxtrot.pickF(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import bravo
import echo
print(echo.base)
print(echo.step(1))
print(bravo.probe)
print(echo.probe)
print(echo.unwrap(echo.make(5)))
print(echo.make(1).id)

