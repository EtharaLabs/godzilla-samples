# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 6 + delta.base
def step(x):
    return delta.step(x) + 6

# ==== foxtrot.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaF:
    _0: int
    def __repr__(self):
        return f"KaF({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbF:
    def __repr__(self):
        return "KbF"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbF = KbF()
print("loading Foxtrot")
def pickF(n):
    if n > 2:
        return KaF(n)
    else:
        return _KbF
base = 2 + delta.base + echo.base
def step(x):
    return echo.step(delta.step(x)) + 2
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))

# ==== golf.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
import echo
import foxtrot
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaG:
    _0: int
    def __repr__(self):
        return f"KaG({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbG:
    def __repr__(self):
        return "KbG"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbG = KbG()
print("loading Golf")
def pickG(n):
    if n > 2:
        return KaG(n)
    else:
        return _KbG
base = 2 + echo.base + foxtrot.base + delta.base
def step(x):
    return delta.step(foxtrot.step(echo.step(x))) + 2
def describe(k):
    match k:
        case foxtrot.KaF(v):
            return v * 10
        case foxtrot.KbF():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(foxtrot.pickF(base))

# ==== main.py ====
import golf
print(golf.base)
print(golf.step(1))
print(golf.probe)

