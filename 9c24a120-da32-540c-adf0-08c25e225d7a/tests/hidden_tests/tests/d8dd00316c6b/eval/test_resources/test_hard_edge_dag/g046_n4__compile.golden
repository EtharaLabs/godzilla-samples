# ==== bravo.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 2
def step(x):
    return x + 2

# ==== delta.py ====
import bravo
print("loading Delta")
base = 5 + bravo.base
def step(x):
    return bravo.step(x) + 5
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== alpha.py ====
import bravo
import delta
base = 1 + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(x)) + 1
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== echo.py ====
import alpha
import bravo
print("loading Echo")
base = 8 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 8
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))

# ==== main.py ====
import alpha
import delta
import echo
print(echo.base)
print(echo.step(1))
print(delta.probe)
print(alpha.probe)
print(echo.probe)

