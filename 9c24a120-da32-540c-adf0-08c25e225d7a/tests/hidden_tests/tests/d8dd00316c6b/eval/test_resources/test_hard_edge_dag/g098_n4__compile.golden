# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 1 + bravo.base
def step(x):
    return bravo.step(x) + 1

# ==== echo.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
@dataclass(frozen=True, slots=True, order=True)
class RecE:
    id: int
    kind: object
print("loading Echo")
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 3 + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(x)) + 3
def describe(k):
    match k:
        case delta.KaD(v):
            return v * 10
        case delta.KbD():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(delta.pickD(base))
def make(n):
    return RecE(n, delta.pickD(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import echo
print(echo.base)
print(echo.step(1))
print(echo.probe)
print(echo.unwrap(echo.make(5)))
print(echo.make(1).id)

