import bravo
import delta
import foxtrot
base = 5 + foxtrot.base + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(foxtrot.step(x))) + 5
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
