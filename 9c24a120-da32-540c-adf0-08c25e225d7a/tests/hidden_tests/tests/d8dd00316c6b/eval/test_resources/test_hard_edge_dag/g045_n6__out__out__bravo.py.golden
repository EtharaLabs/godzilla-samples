from dataclasses import dataclass
from functools import total_ordering
import golf
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaB:
    _0: int
    def __repr__(self):
        return f"KaB({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbB:
    def __repr__(self):
        return "KbB"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbB = KbB()
def pickB(n):
    if n > 2:
        return KaB(n)
    else:
        return _KbB
base = 6 + golf.base
def step(x):
    return golf.step(x) + 6
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))
