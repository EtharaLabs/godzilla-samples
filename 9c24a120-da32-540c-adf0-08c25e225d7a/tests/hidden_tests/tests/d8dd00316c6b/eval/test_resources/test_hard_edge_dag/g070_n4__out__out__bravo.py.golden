from dataclasses import dataclass
import alpha
import delta
@dataclass(frozen=True, slots=True, order=True)
class RecB:
    id: int
    kind: object
print("loading Bravo")
base = 3 + delta.base + alpha.base
def step(x):
    return alpha.step(delta.step(x)) + 3
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecB(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)
