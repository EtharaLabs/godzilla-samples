# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 5
def step(x):
    return x + 5

# ==== alpha.py ====
from dataclasses import dataclass
import delta
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
print("loading Alpha")
base = 2 + delta.base
def step(x):
    return delta.step(x) + 2
def describe(k):
    match k:
        case delta.KaD(v):
            return v * 10
        case delta.KbD():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(delta.pickD(base))
def make(n):
    return RecA(n, delta.pickD(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import alpha
print(alpha.base)
print(alpha.step(1))
print(alpha.probe)
print(alpha.unwrap(alpha.make(5)))
print(alpha.make(1).id)

