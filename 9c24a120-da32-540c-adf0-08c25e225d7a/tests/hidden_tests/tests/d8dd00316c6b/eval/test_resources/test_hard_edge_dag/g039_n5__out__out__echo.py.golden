from dataclasses import dataclass
from functools import total_ordering
import alpha
import bravo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaE:
    _0: int
    def __repr__(self):
        return f"KaE({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbE:
    def __repr__(self):
        return "KbE"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbE = KbE()
@dataclass(frozen=True, slots=True, order=True)
class RecE:
    id: int
    kind: object
print("loading Echo")
def pickE(n):
    if n > 2:
        return KaE(n)
    else:
        return _KbE
base = 7 + alpha.base + bravo.base
def step(x):
    return bravo.step(alpha.step(x)) + 7
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecE(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)
