# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import delta
import foxtrot
import golf
import hotel
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 5 + hotel.base + foxtrot.base + golf.base + delta.base
def step(x):
    return delta.step(golf.step(foxtrot.step(hotel.step(x)))) + 5
def describe(k):
    match k:
        case delta.KaD(v):
            return v * 10
        case delta.KbD():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(delta.pickD(base))

