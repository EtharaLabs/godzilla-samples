# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 2
def step(x):
    return x + 2

# ==== delta.py ====
import alpha
base = 5 + alpha.base
def step(x):
    return alpha.step(x) + 5
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))

# ==== foxtrot.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaF:
    _0: int
    def __repr__(self):
        return f"KaF({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbF:
    def __repr__(self):
        return "KbF"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbF = KbF()
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
def pickF(n):
    if n > 2:
        return KaF(n)
    else:
        return _KbF
base = 2 + alpha.base
def step(x):
    return alpha.step(x) + 2
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))
def make(n):
    return RecF(n, alpha.pickA(n))
def unwrap(r):
    return describe(r.kind)

# ==== bravo.py ====
import alpha
import delta
import foxtrot
base = 1 + delta.base + foxtrot.base + alpha.base
def step(x):
    return alpha.step(foxtrot.step(delta.step(x))) + 1
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))

# ==== golf.py ====
import bravo
print("loading Golf")
base = 1 + bravo.base
def step(x):
    return bravo.step(x) + 1

# ==== echo.py ====
import delta
import golf
base = 6 + delta.base + golf.base
def step(x):
    return golf.step(delta.step(x)) + 6

