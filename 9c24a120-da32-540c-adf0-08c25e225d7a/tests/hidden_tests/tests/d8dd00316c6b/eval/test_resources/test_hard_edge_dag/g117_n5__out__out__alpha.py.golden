from dataclasses import dataclass
import bravo
import delta
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
base = 3 + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(x)) + 3
def describe(k):
    match k:
        case bravo.KaB(v):
            return v * 10
        case bravo.KbB():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(bravo.pickB(base))
def make(n):
    return RecA(n, bravo.pickB(n))
def unwrap(r):
    return describe(r.kind)
