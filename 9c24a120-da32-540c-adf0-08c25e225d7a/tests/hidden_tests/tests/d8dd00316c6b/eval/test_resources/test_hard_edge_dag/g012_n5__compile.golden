# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
print("loading Alpha")
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 3
def step(x):
    return x + 3

# ==== delta.py ====
from dataclasses import dataclass
from functools import total_ordering
import alpha
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaD:
    _0: int
    def __repr__(self):
        return f"KaD({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbD:
    def __repr__(self):
        return "KbD"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbD = KbD()
def pickD(n):
    if n > 2:
        return KaD(n)
    else:
        return _KbD
base = 8 + alpha.base
def step(x):
    return alpha.step(x) + 8
def describe(k):
    match k:
        case alpha.KaA(v):
            return v * 10
        case alpha.KbA():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(alpha.pickA(base))

