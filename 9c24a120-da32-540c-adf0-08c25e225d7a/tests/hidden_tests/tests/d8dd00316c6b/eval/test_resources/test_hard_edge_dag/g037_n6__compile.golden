# ==== alpha.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import delta
import echo
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaA:
    _0: int
    def __repr__(self):
        return f"KaA({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbA:
    def __repr__(self):
        return "KbA"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbA = KbA()
@dataclass(frozen=True, slots=True, order=True)
class RecA:
    id: int
    kind: object
def pickA(n):
    if n > 2:
        return KaA(n)
    else:
        return _KbA
base = 6 + bravo.base + echo.base + delta.base
def step(x):
    return delta.step(echo.step(bravo.step(x))) + 6
def describe(k):
    match k:
        case echo.KaE(v):
            return v * 10
        case echo.KbE():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(echo.pickE(base))
def make(n):
    return RecA(n, echo.pickE(n))
def unwrap(r):
    return describe(r.kind)

# ==== main.py ====
import alpha
print(alpha.base)
print(alpha.step(1))
print(alpha.probe)
print(alpha.unwrap(alpha.make(5)))
print(alpha.make(1).id)

