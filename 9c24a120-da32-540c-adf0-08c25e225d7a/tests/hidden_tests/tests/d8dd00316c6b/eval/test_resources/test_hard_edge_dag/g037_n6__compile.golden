# ==== golf.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import delta
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaG:
    _0: int
    def __repr__(self):
        return f"KaG({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbG:
    def __repr__(self):
        return "KbG"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbG = KbG()
def pickG(n):
    if n > 2:
        return KaG(n)
    else:
        return _KbG
base = 4 + delta.base + bravo.base
def step(x):
    return bravo.step(delta.step(x)) + 4

# ==== foxtrot.py ====
from dataclasses import dataclass
from functools import total_ordering
import bravo
import golf
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaF:
    _0: int
    def __repr__(self):
        return f"KaF({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbF:
    def __repr__(self):
        return "KbF"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbF = KbF()
print("loading Foxtrot")
def pickF(n):
    if n > 2:
        return KaF(n)
    else:
        return _KbF
base = 4 + bravo.base + golf.base
def step(x):
    return golf.step(bravo.step(x)) + 4
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))

