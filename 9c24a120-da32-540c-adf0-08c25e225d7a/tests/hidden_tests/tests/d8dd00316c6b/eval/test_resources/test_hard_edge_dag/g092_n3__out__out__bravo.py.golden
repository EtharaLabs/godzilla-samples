from dataclasses import dataclass
import delta
@dataclass(frozen=True, slots=True, order=True)
class RecB:
    id: int
    kind: object
base = 6 + delta.base
def step(x):
    return delta.step(x) + 6
def describe(k):
    match k:
        case delta.KaD(v):
            return v * 10
        case delta.KbD():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(delta.pickD(base))
def make(n):
    return RecB(n, delta.pickD(n))
def unwrap(r):
    return describe(r.kind)
