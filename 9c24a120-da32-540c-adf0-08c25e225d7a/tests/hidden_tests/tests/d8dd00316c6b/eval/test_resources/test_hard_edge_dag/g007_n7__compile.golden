# ==== hotel.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KaH:
    _0: int
    def __repr__(self):
        return f"KaH({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class KbH:
    def __repr__(self):
        return "KbH"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_KbH = KbH()
def pickH(n):
    if n > 2:
        return KaH(n)
    else:
        return _KbH
base = 8
def step(x):
    return x + 8

# ==== bravo.py ====
from dataclasses import dataclass
import hotel
@dataclass(frozen=True, slots=True, order=True)
class RecB:
    id: int
    kind: object
base = 9 + hotel.base
def step(x):
    return hotel.step(x) + 9
def describe(k):
    match k:
        case hotel.KaH(v):
            return v * 10
        case hotel.KbH():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(hotel.pickH(base))
def make(n):
    return RecB(n, hotel.pickH(n))
def unwrap(r):
    return describe(r.kind)

# ==== foxtrot.py ====
from dataclasses import dataclass
import hotel
@dataclass(frozen=True, slots=True, order=True)
class RecF:
    id: int
    kind: object
print("loading Foxtrot")
base = 5 + hotel.base
def step(x):
    return hotel.step(x) + 5
def describe(k):
    match k:
        case hotel.KaH(v):
            return v * 10
        case hotel.KbH():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(hotel.pickH(base))
def make(n):
    return RecF(n, hotel.pickH(n))
def unwrap(r):
    return describe(r.kind)

# ==== delta.py ====
import foxtrot
print("loading Delta")
base = 7 + foxtrot.base
def step(x):
    return foxtrot.step(x) + 7

# ==== golf.py ====
import delta
base = 6 + delta.base
def step(x):
    return delta.step(x) + 6

# ==== main.py ====
import bravo
print(bravo.base)
print(bravo.step(1))
print(bravo.probe)
print(bravo.unwrap(bravo.make(5)))
print(bravo.make(1).id)

