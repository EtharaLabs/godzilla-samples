import echo
import golf
base = 4 + golf.base + echo.base
def step(x):
    return echo.step(golf.step(x)) + 4
def describe(k):
    match k:
        case golf.KaG(v):
            return v * 10
        case golf.KbG():
            return -1
        case _:
            raise RuntimeError("non-exhaustive match")
probe = describe(golf.pickG(base))
