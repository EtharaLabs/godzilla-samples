# ==== shapes.py ====
from dataclasses import dataclass
from functools import total_ordering
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
def area(s):
    match s:
        case Circle(r):
            return 3.0 * r * r
        case Rect(w, h):
            return w * h
        case _:
            raise RuntimeError("non-exhaustive match")
def total(xs):
    return _pf_fold(lambda acc, s: acc + area(s), 0.0, xs)

# ==== util.py ====
def firstOr(d, xs):
    if xs:
        x = xs[0]
        return x
    else:
        return d
def label(n):
    return f"#{n}"

# ==== main.py ====
import shapes as _pf_shapes
import util
shapes = [_pf_shapes.Circle(1.0), _pf_shapes.Rect(2.0, 3.0)]
print(f"total={_pf_shapes.total(shapes)} first={util.firstOr(0, [7, 8])} {util.label(3)}")

