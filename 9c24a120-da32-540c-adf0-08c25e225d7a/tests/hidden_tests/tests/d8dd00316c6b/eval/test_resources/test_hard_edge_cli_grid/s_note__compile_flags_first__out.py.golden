def go(n: int) -> int:
    while True:
        def go(k: int) -> int:
            return k + 1
        if n == 0:
            return 0
        else:
            n = n - 1
            continue
def count(n: int, acc: int) -> int:
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue
print(f"{go(5)} {count(4, 0)}")
