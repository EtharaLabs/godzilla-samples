# ==== loops.py ====
def go(n):
    def go(k):
        return k + 1
    if n == 0:
        return 0
    else:
        return go(n - 1)
def count(n, acc):
    while True:
        if n == 0:
            return acc
        else:
            n, acc = (n - 1, acc + n)
            continue

# ==== main.py ====
import loops
print(loops.go(3))
print(loops.count(3, 0))

--- stderr ---
note: in `Loops`: `go` calls itself in tail position but keeps its recursive form: the body rebinds `go`
