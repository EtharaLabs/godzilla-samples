from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __eq__(self, other):
        return type(other) is Circle and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
    def __eq__(self, other):
        return type(other) is Rect and self._pf_order_key() == other._pf_order_key()
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def __le__(self, other):
        return self._pf_order_key() <= other._pf_order_key()
    def __gt__(self, other):
        return self._pf_order_key() > other._pf_order_key()
    def __ge__(self, other):
        return self._pf_order_key() >= other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)
Shape = Circle | Rect
def area(s: Shape) -> float:
    if isinstance(s, Circle):
        r = s._0
        return 3.0 * r * r
    else:
        w = s._0
        h = s._1
        return w * h
def total(xs: list[Shape]) -> float:
    return _pf_fold(lambda acc, s: acc + area(s), 0.0, xs)
