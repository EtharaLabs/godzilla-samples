from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
Shape = Circle | Rect
def area(s: Shape) -> float:
    if isinstance(s, Circle):
        r = s._0
        return 3.0 * r * r
    else:
        w = s._0
        h = s._1
        return w * h
def total(xs: list[Shape]) -> float:
    return _pf_fold(lambda acc, s: acc + area(s), 0.0, xs)
names: list[str] = ["ann", "bo"]
if names:
    n = names[0]
    _pf_t0 = n
else:
    _pf_t0 = "-"
shown: str = _pf_t0
print("total={} first={} all={}".format(total([Circle(1.0), Rect(2.0, 3.0)]), shown, _pf_str_join(", ", names)))
