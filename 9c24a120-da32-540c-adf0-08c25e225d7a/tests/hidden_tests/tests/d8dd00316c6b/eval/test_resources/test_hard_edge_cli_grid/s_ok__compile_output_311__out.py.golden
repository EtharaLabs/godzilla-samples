from dataclasses import dataclass
import functools
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_str_join(sep, xs):
    return sep.join(xs)
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: float
    def __repr__(self):
        return f"Circle({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: float
    _1: float
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
def area(s):
    match s:
        case Circle(r):
            return 3.0 * r * r
        case Rect(w, h):
            return w * h
        case _:
            raise RuntimeError("non-exhaustive match")
def total(xs):
    return _pf_fold(lambda acc, s: acc + area(s), 0.0, xs)
names = ["ann", "bo"]
if names:
    n = names[0]
    _pf_t0 = n
else:
    _pf_t0 = "-"
shown = _pf_t0
print("total={} first={} all={}".format(total([Circle(1.0), Rect(2.0, 3.0)]), shown, _pf_str_join(", ", names)))
