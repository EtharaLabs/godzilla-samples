from dataclasses import dataclass
import carry
import geo
@dataclass(frozen=True, slots=True, order=True)
class Shelf:
    top: object
    count: int
shelf = Shelf(carry.item, 2)
_pf_t0 = carry.item
n = carry.Item(_pf_t0.name, _pf_t0.kind, geo.Pos(9, _pf_t0.at.y))
print(n.at.x)
print(carry.item.at.x)
