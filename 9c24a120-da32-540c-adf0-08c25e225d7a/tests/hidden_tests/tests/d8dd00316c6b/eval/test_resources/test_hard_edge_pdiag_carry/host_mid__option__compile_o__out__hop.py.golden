from dataclasses import dataclass
import carry
import geo
from _pyfun_rt import Some, None_, _None_
@dataclass(frozen=True, slots=True, order=True)
class Shelf:
    top: object
    count: int
shelf = Shelf(carry.item, 2)
match carry.bag.best:
    case Some(geo.Box(w, h)):
        _pf_t0 = w + h
    case Some(k):
        _pf_t0 = geo.size(k)
    case None_():
        _pf_t0 = -1.0
    case _:
        raise RuntimeError("non-exhaustive match")
r = _pf_t0
print(r)
