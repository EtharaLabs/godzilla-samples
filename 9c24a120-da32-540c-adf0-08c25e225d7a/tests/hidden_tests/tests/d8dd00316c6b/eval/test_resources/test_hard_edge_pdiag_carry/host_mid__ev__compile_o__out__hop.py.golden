from dataclasses import dataclass
import carry
@dataclass(frozen=True, slots=True, order=True)
class Shelf:
    top: object
    count: int
shelf = Shelf(carry.item, 2)
match carry.ev:
    case carry.Moved(p):
        _pf_t0 = p.x + p.y
    case carry.Resized(_):
        _pf_t0 = 0
    case carry.Idle():
        _pf_t0 = -1
    case _:
        raise RuntimeError("non-exhaustive match")
r = _pf_t0
print(r)
