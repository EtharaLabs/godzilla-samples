from dataclasses import dataclass
import carry
import geo
def _pf_map(f, xs):
    return list(map(f, xs))
@dataclass(frozen=True, slots=True, order=True)
class Shelf:
    top: object
    count: int
shelf = Shelf(carry.item, 2)
print(_pf_map(lambda it: it.name, carry.bag.items))
print(_pf_map(lambda it: geo.size(it.kind), carry.bag.items))
