@dataclass(frozen=True, slots=True, order=True)
class Pt:
    x: int
    y: int

# ==== logic.py ====
import kinds
def classify(p) -> str:
    if isinstance(p, kinds.Pt):
        x = p.x
        y = p.y
        if y == 0 or y > 4:
            return f"a0 {x} {y}"
    if isinstance(p, kinds.Pt):
        x = p.x
        y = p.y
        return f"a1 {x} {y}"
    else:
        if isinstance(p, kinds.Pt):
            x = p.x
            if x > 1:
                return f"a2 {x}"
        return "rest"

# ==== main.py ====
import kinds
import logic
def _pf_map(f, xs):
    return list(map(f, xs))
print(_pf_map(logic.classify, [kinds.Pt(0, 0), kinds.Pt(1, 5), kinds.Pt(4, 4)]))

