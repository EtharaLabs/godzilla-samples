# ==== logic.py ====
import kinds
def classify(s, n: int) -> str:
    _pf_t0 = (s, n)
    if isinstance(_pf_t0[0], kinds.Group) and len(_pf_t0[0]._0) == 0:
        return f"a0"
    else:
        if isinstance(_pf_t0[0], kinds.Circle):
            v10 = _pf_t0[0]._0
            v11 = _pf_t0[1]
            if (v10 > 1 or v11 > 1) and v10 != v11:
                return f"a1 {v10} {v11}"
        if isinstance(_pf_t0[0], kinds.Group) and len(_pf_t0[0]._0) == 0:
            return f"a2"
        elif _pf_t0[1] == 0:
            v30 = _pf_t0[0]
            return f"a3"
        else:
            return "rest"

# ==== main.py ====
import kinds
import logic
def _pf_map(f, xs):
    return list(map(f, xs))
print(_pf_map(lambda s: logic.classify(s, 1), [kinds._Dot, kinds.Circle(1), kinds.Circle(5), kinds.Rect(0, 2), kinds.Rect(3, 3), kinds.Tagged(kinds._Red, kinds.Circle(2)), kinds.Tagged(kinds._Blue, kinds._Dot), kinds.Group([]), kinds.Group([kinds._Dot, kinds.Circle(1)])]))
