    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (4, self._0)
@dataclass(frozen=True, slots=True, order=True)
class Pt:
    x: int
    y: int

# ==== logic.py ====
import kinds
def classify(p):
    match p:
        case kinds.Pt(x=x) if x > 1:
            return f"a0 {x}"
        case kinds.Pt(x=x) if x > 1:
            return f"a1 {x}"
        case _:
            return "rest"

# ==== main.py ====
import kinds
import logic
def _pf_map(f, xs):
    return list(map(f, xs))
print(_pf_map(logic.classify, [kinds.Pt(0, 0), kinds.Pt(1, 5), kinds.Pt(4, 4)]))

