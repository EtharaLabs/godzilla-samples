_Dot = Dot()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: int
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: int
    _1: int
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0, self._1)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Tagged:
    _0: object
    _1: object
    def __repr__(self):
        return f"Tagged({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
