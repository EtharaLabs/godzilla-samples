# ==== logic.py ====
import kinds
def classify(s):
    match s:
        case kinds.Group([]) | kinds.Circle(5):
            return f"a0"
        case kinds.Group([kinds.Dot(), *v10]):
            return f"a1"
        case kinds.Tagged(kinds.Red() | kinds.Green(), kinds.Group([kinds.Dot(), *v20])):
            return f"a2"
        case kinds.Group([kinds.Group([kinds.Rect(_, v30), *v31]), *v32]):
            return f"a3 {v30}"
        case _:
            return "rest"

# ==== main.py ====
import kinds
import logic
def _pf_map(f, xs):
    return list(map(f, xs))
print(_pf_map(logic.classify, [kinds._Dot, kinds.Circle(1), kinds.Circle(5), kinds.Rect(0, 2), kinds.Rect(3, 3), kinds.Tagged(kinds._Red, kinds.Circle(2)), kinds.Tagged(kinds._Blue, kinds._Dot), kinds.Group([]), kinds.Group([kinds._Dot, kinds.Circle(1)])]))

