from typing import Any
import functools
import sqlite3
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
db = sqlite3.connect(":memory:")
_ = db.execute("create table t (x int)")
_ = db.execute("insert into t values (1), (2), (3)")
def firstCol(r):
    x = r[0]
    return x
rows: list[Any] = db.execute("select x, x * x from t order by x").fetchall()
total: int = _pf_fold(lambda acc, r: acc + firstCol(r), 0, rows)
print(rows)
print(total)
