from dataclasses import dataclass
import asyncio
import contextvars
_pf_scope = contextvars.ContextVar("_pf_scope")
class _pf_Async:
    __slots__ = ("fn", "args")
    def __init__(self, fn, *args):
        self.fn = fn
        self.args = args
    def __await__(self):
        return self.fn(*self.args).__await__()
    async def __call__(self):
        return await self
    def __repr__(self):
        return "<Async>"
async def _pf_run(a):
    return await a
def _pf_task_scope(body):
    async def run():
        async def scoped():
            async with asyncio.TaskGroup() as tg:
                _pf_scope.set(tg)
                return await body
        return await asyncio.create_task(scoped())
    return _pf_Async(run)
def _pf_task_start(c):
    _pf_scope.get().create_task(_pf_run(c))
    return None
@dataclass(frozen=True, slots=True, repr=False)
class Said:
    _0: str
    def __repr__(self):
        return f"Said({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class Tick:
    def __repr__(self):
        return "Tick"
_Tick = Tick()
@dataclass(frozen=True, slots=True, repr=False)
class Quit:
    def __repr__(self):
        return "Quit"
_Quit = Quit()
def heard(count, s):
    print(f"agent heard {s}")
    return count + 1
def finished(count):
    async def _pf_fn0():
        return count
    return _pf_Async(_pf_fn0)
def agentLoop(inbox, count):
    async def _pf_fn1(inbox, count):
        while True:
            msg = await inbox.get()
            match msg:
                case Said(s):
                    inbox, count = (inbox, heard(count, s))
                    continue
                case Tick():
                    inbox, count = (inbox, count)
                    continue
                case Quit():
                    return await finished(count)
                case _:
                    raise RuntimeError("non-exhaustive match")
    return _pf_Async(_pf_fn1, inbox, count)
def producer(inbox):
    async def _pf_fn2():
        for s in ["hello", "world"]:
            await asyncio.sleep(0.01)
            _ = inbox.put_nowait(Said(s))
        _ = inbox.put_nowait(_Tick)
        _ = inbox.put_nowait(_Quit)
    return _pf_Async(_pf_fn2)
async def _pf_fn3():
    inbox = asyncio.Queue()
    _ = _pf_task_start(producer(inbox))
    count = await agentLoop(inbox, 0)
    return count
session = _pf_task_scope(_pf_Async(_pf_fn3))
count = asyncio.run(_pf_run(session))
print(f"agent handled {count} messages")
