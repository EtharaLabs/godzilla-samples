from dataclasses import dataclass
from typing import Any
import functools
import nr_stream
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: Any
    def __repr__(self):
        return f"Some({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
_None_: None_ = None_()
def _pf_concat(xs, ys):
    return xs + ys
def _pf_filter(f, xs):
    return list(filter(f, xs))
def _pf_fold(f, acc, xs):
    return functools.reduce(f, xs, acc)
def _pf_map(f, xs):
    return list(map(f, xs))
def _pf_sort(xs):
    return sorted(xs)
def _pf_map_add(k, v, m):
    return dict(list(m.items()) + [[k, v]])
def _pf_map_to_list(m):
    return list(m.items())
def _pf_map_try_find(k, m):
    if k in m:
        return Some(m.get(k))
    return _None_
def _pf_option_with_default(d, o):
    if isinstance(o, Some):
        return o._0
    return d
def _pf_str_join(sep, xs):
    return sep.join(xs)
def _pf_str_lower(s):
    return s.lower()
def _pf_str_slice(start, end, s):
    return s[start:end]
def _pf_str_split(sep, s):
    return s.split(sep)
def _pf_str_to_int(s):
    try:
        return Some(int(s))
    except ValueError:
        return _None_
def _pf_str_upper(s):
    return s.upper()
@dataclass(frozen=True, slots=True)
class Stop:
    tiploc: str
    arr: str
    dep: str
@dataclass(frozen=True, slots=True)
class Run:
    uid: str
    days: str
    stp: str
    stops: list
@dataclass(frozen=True, slots=True)
class Leg:
    dest: str
    finalDest: str
    rdays: str
    depMin: int
    arrMin: int
    jt: int
    via: list
dataFile: str = "examples/interop/network-rail/sample.ndjson"
outFile: str = "examples/interop/network-rail/chippenham-routes.md"
def toStop(t: tuple[str, str, str]) -> Stop:
    tp = t[0]
    a = t[1]
    d = t[2]
    return Stop(tp, a, d)
def toRun(r: tuple[str, str, str, list[tuple[str, str, str]]]) -> Run:
    uid = r[0]
    days = r[1]
    stp = r[2]
    stops = r[3]
    return Run(uid, days, stp, _pf_map(toStop, stops))
def calls(s: Stop) -> bool:
    return s.arr != "" and s.arr != "0000" or s.dep != "" and s.dep != "0000"
def toMin(hhmm: str) -> int:
    _pf_t0 = (_pf_str_to_int(_pf_str_slice(0, 2, hhmm)), _pf_str_to_int(_pf_str_slice(2, 4, hhmm)))
    if isinstance(_pf_t0[0], Some) and isinstance(_pf_t0[1], Some):
        h = _pf_t0[0]._0
        m = _pf_t0[1]._0
        return h * 60 + m
    else:
        return -1
def fmt2(n: int) -> str:
    if n < 10:
        return f"0{n}"
    else:
        return f"{n}"
def showTime(m: int) -> str:
    return f"{fmt2(m // 60)}:{fmt2(m % 60)}"
def jtime(dep: int, arr: int) -> int:
    d = arr - dep
    if d < 0:
        return d + 1440
    else:
        return d
def fromChippenham(stops: list[Stop]) -> Some | None_:
    while True:
        if len(stops) == 0:
            return _None_
        else:
            s = stops[0]
            rest = stops[1:len(stops)]
            if s.tiploc == "CHIPNHM" and calls(s):
                return Some((s.dep, rest))
            else:
                stops = rest
                continue
def lastTiploc(stops: list[Stop]) -> str:
    while True:
        if len(stops) == 0:
            return ""
        elif len(stops) == 1:
            s = stops[0]
            return s.tiploc
        else:
            rest = stops[1:len(stops)]
            stops = rest
            continue
def walkLegs(days: str, term: str, depM: int, via: list[str], stops: list[Stop]) -> list[Leg]:
    while True:
        if len(stops) == 0:
            return []
        else:
            s = stops[0]
            rest = stops[1:len(stops)]
            if calls(s):
                arrM = toMin(s.arr)
                onward = _pf_concat(via, [s.tiploc])
                if arrM < 0:
                    days, term, depM, via, stops = (days, term, depM, onward, rest)
                    continue
                else:
                    leg = Leg(s.tiploc, term, days, depM, arrM, jtime(depM, arrM), via)
                    return _pf_concat([leg], walkLegs(days, term, depM, onward, rest))
            else:
                days, term, depM, via, stops = (days, term, depM, via, rest)
                continue
def legsOfRun(r: Run) -> list[Leg]:
    if r.stp == "C":
        return []
    else:
        _pf_t1 = fromChippenham(r.stops)
        if isinstance(_pf_t1, None_):
            return []
        else:
            chippDep, downstream = _pf_t1._0
            depM = toMin(chippDep)
            if depM < 0:
                return []
            else:
                return walkLegs(r.days, lastTiploc(downstream), depM, [], downstream)
def runsOn(day: int, days: str) -> bool:
    return _pf_str_slice(day, day + 1, days) == "1"
def dedupLegs(legs: list[Leg]) -> list[Leg]:
    def step(acc: tuple[dict[str, bool], list[Leg]], leg: Leg) -> tuple[dict[str, bool], list[Leg]]:
        seen = acc[0]
        out = acc[1]
        k = f"{leg.depMin}|{leg.dest}"
        if k in seen:
            return (seen, out)
        else:
            return (_pf_map_add(k, True, seen), _pf_concat(out, [leg]))
    seen = dict()
    out = []
    for leg in legs:
        k = f"{leg.depMin}|{leg.dest}"
        match _pf_map_try_find(k, seen):
            case Some(_):
                pass
            case None_():
                seen[k] = True
                out.append(leg)
            case _:
                raise RuntimeError("non-exhaustive match")
    _pf_t2 = (seen, out)
    out = _pf_t2[1]
    return out
def groupByDest(acc: dict[str, list[Leg]], leg: Leg) -> dict[str, list[Leg]]:
    return _pf_map_add(leg.dest, _pf_concat(_pf_option_with_default([], _pf_map_try_find(leg.dest, acc)), [leg]), acc)
def insertByDep(leg: Leg, sorted_: list[Leg]) -> list[Leg]:
    if len(sorted_) == 0:
        return [leg]
    else:
        x = sorted_[0]
        rest = sorted_[1:len(sorted_)]
        if leg.depMin <= x.depMin:
            return _pf_concat([leg], sorted_)
        else:
            return _pf_concat([x], insertByDep(leg, rest))
def sortLegs(legs: list[Leg]) -> list[Leg]:
    return _pf_fold(lambda acc, l: insertByDep(l, acc), [], legs)
def minOf(xs: list[int]) -> int:
    if len(xs) == 0:
        return 0
    elif len(xs) == 1:
        x = xs[0]
        return x
    else:
        x = xs[0]
        rest = xs[1:len(xs)]
        m = minOf(rest)
        if x < m:
            return x
        else:
            return m
def maxOf(xs: list[int]) -> int:
    if len(xs) == 0:
        return 0
    elif len(xs) == 1:
        x = xs[0]
        return x
    else:
        x = xs[0]
        rest = xs[1:len(xs)]
        m = maxOf(rest)
        if x > m:
            return x
        else:
            return m
def capFirst(chars: list[str]) -> list[str]:
    if len(chars) == 0:
        return []
    else:
        c = chars[0]
        rest = chars[1:len(chars)]
        if _pf_str_upper(c) != c:
            return _pf_concat([_pf_str_upper(c)], rest)
        else:
            return _pf_concat([c], capFirst(rest))
def capWord(w: str) -> str:
    return _pf_str_join("", capFirst(list(w)))
def titleHyphen(w: str) -> str:
    return _pf_str_join("-", _pf_map(capWord, _pf_str_split("-", w)))
def titleCase(name: str) -> str:
    return _pf_str_join(" ", _pf_map(titleHyphen, _pf_str_split(" ", _pf_str_lower(name))))
def nameOf(names: dict[str, str], tp: str) -> str:
    return titleCase(_pf_option_with_default(tp, _pf_map_try_find(tp, names)))
def plural(n: int, word) -> str:
    if n == 1:
        return f"{n} {word}"
    else:
        return f"{n} {word}s"
def rangeStr(lo, hi) -> str:
    if lo == hi:
        return f"{lo} min"
    else:
        return f"{lo}-{hi} min"
def renderService(names: dict[str, str], leg: Leg) -> str:
    _pf_t4 = leg.via
    if len(_pf_t4) == 0:
        _pf_t3 = "direct"
    else:
        viaStr = _pf_str_join(", ", _pf_map(functools.partial(nameOf, names), leg.via))
        _pf_t3 = f"via {viaStr}"
    stopStr = _pf_t3
    onward = "" if leg.dest == leg.finalDest else f" _(to {nameOf(names, leg.finalDest)})_"
    return f"- **{showTime(leg.depMin)} → {showTime(leg.arrMin)}** · {leg.jt} min · {stopStr}{onward}"
def renderGroup(names: dict[str, str], g: tuple[str, list[Leg]]) -> str:
    dest = g[0]
    legs = g[1]
    times = _pf_map(lambda l: l.jt, legs)
    tr = plural(len(legs), "train")
    header = f"### {nameOf(names, dest)} — {tr}, {rangeStr(minOf(times), maxOf(times))}"
    body = _pf_str_join("\n", _pf_map(functools.partial(renderService, names), sortLegs(legs)))
    return f"{header}\n\n{body}"
def daySection(names: dict[str, str], label, day: int, allLegs: list[Leg]) -> str:
    legs = dedupLegs(_pf_filter(lambda l: runsOn(day, l.rdays), allLegs))
    def _pf_fn0(g):
        dest = g[0]
        ls = g[1]
        return (nameOf(names, dest), renderGroup(names, g))
    acc = dict()
    for leg in legs:
        _pf_t6 = _pf_concat(_pf_option_with_default([], _pf_map_try_find(leg.dest, acc)), [leg])
        acc[leg.dest] = _pf_t6
    pairs = _pf_map(_pf_fn0, _pf_map_to_list(acc))
    def _pf_fn1(p):
        nm = p[0]
        txt = p[1]
        return txt
    body = _pf_str_join("\n\n", _pf_map(_pf_fn1, _pf_sort(pairs)))
    return f"## {label}\n\n{body}"
def buildReport(names: dict[str, str], raw: list[tuple[str, str, str, list[tuple[str, str, str]]]]) -> str:
    acc = []
    for r in _pf_map(toRun, raw):
        _pf_t8 = legsOfRun(r)
        acc.extend(_pf_t8)
    allLegs = acc
    intro = "# Direct services from Chippenham\n\n_Every station reachable directly (no change) from Chippenham, grouped by destination, in departure order. Counts reflect the weekly day-of-week pattern of permanent + new schedules minus cancellations; a specific date may differ._"
    wd = daySection(names, "Monday–Friday (representative day: Tuesday)", 1, allLegs)
    sa = daySection(names, "Saturday", 5, allLegs)
    su = daySection(names, "Sunday", 6, allLegs)
    return _pf_str_join("\n\n", [intro, wd, sa, su])
_pf_t10 = nr_stream.scan(dataFile)
names = _pf_t10[0]
raw = _pf_t10[1]
_pf_t9 = nr_stream.write_utf8(outFile, buildReport(names, raw))
_ = _pf_t9
print(f"Wrote Markdown direct Chippenham services to {outFile}")
