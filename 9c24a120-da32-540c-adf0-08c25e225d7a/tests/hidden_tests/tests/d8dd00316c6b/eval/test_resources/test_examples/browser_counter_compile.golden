# ==== dom.py ====
import js
import pyodide.ffi
byId = js.document.getElementById
setText = lambda _pf_recv, _pf_a1: _pf_recv.replaceChildren(_pf_a1)
setAttr = lambda _pf_recv, _pf_a1, _pf_a2: _pf_recv.setAttribute(_pf_a1, _pf_a2)
append = lambda _pf_recv, _pf_a1: _pf_recv.append(_pf_a1)
create = js.document.createElement
on = lambda _pf_recv, _pf_a1, _pf_a2: _pf_recv.addEventListener(_pf_a1, _pf_a2)
proxy = pyodide.ffi.create_proxy

# ==== counter.py ====
import dom
count = 0
def render(_):
    return dom.setText(dom.byId("count"), f"{count}")
def bump(_):
    global count
    count = count + 1
    return render(None)
dom.on(dom.byId("plus"), "click", dom.proxy(bump))
render(None)
print("counter ready")

