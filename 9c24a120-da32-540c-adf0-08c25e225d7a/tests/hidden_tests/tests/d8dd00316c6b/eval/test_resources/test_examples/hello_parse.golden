type Color = Red | Green | Blue
type Point = { x: int, y: int }
let pure add a b = (a + b)
let inc = (add 1)
let five = (4 |> inc)
let fact n = (if (n == 0) then 1 else (n * (fact (n - 1))))
let same = (id 42)
let always7 = ((const 7) "discarded")
let subtract a b = (a - b)
let backwards = (((flip subtract) 3) 10)
let zeroed = ((List.map (const 0)) [1, 2, 3])
let dropped = (ignore 42)
## Returns 1 when the flag is set, else 0.
let pick b = (if b then 1 else 0)
## A traffic signal.
## `Walk` when clear, `Wait` while it counts down, `Stop` otherwise. Ordered by
## declaration, so `Walk < Wait < Stop` under the derived comparison.
type Signal = Walk | Wait | Stop
let scaled a b =
    let mut acc = a
    (acc <- (acc + b))
    (acc <- (acc * 2))
    acc
let accumulate =
    let mut running = 0
    let tally x =
        (running <- (running + x))
        running
    let first = (tally 10)
    (tally 5)
let describeSign n =
    match n:
        case 0: "zero"
        case _:
            let positive = (n > 0)
            (if positive then "positive" else "negative")
let unwrap o =
    match o:
        case (Some v): v
        case None: 0
let answer = (unwrap (Some 42))
let doubleIfSome o =
    match o:
        case ((Some v) as w): w
        case None: None
let stillFortyTwo = (doubleIfSome (Some 42))
let rank c =
    match c:
        case Red: 1
        case Green: 2
        case Blue: 3
let isEven n = (if (n == 0) then true else (isOdd (n - 1)))
let isOdd n = (if (n == 0) then false else (isEven (n - 1)))
let tenEven = (isEven 10)
let size n =
    match n:
        case (1 | 2 | 3): "small"
        case _: "big"
let sign n =
    match n:
        case 0: "zero"
        case m if (m > 0): "positive"
        case _: "negative"
let grade n = (if (n >= 90) then "A" elif (n >= 80) then "B" elif (n >= 70) then "C" else "F")
let compose = (fun f g x -> (f (g x)))
let inc2 = ((compose inc) inc)
let seven = (inc2 five)
let twice x = (x * 2)
let incThenDouble = (inc >> twice)
let doubleThenInc = (inc << twice)
let eight = (incThenDouble 3)
let sevenC = (doubleThenInc 3)
let sevenB = (inc <| (twice 3))
module Geom =
    let square x = (x * x)
    let area w h = (w * h)
    let diagSq w h = ((square w) + (square h))
let floorArea = ((Geom.area 4) 5)
let diag = ((Geom.diagSq 3) 4)
let checked ok v = result { let! x = (if ok then (Ok v) else (Error 0)) return (x + 1) }
let firstTwo xs = option { let! a = ((List.get 0) xs) let! b = ((List.get 1) xs) return (a + b) }
(print (firstTwo [10, 20, 30]))
(print (firstTwo [10]))
let small = seq { yield 1 yield 2 yield 3 }
extern runAsync: (Async a) -> a = asyncio.run
let computed = async { let! x = async { return 20 } return (x + 1) }
(print (runAsync computed))
module Maybe =
    let bind m f =
        match m:
            case (Some x): (f x)
            case None: None
    let return_ x = (Some x)
let addOpt a b = Maybe { let! x = a let! y = b return (x + y) }
let pairUp a b = (a, b)
let origin = (0, 0)
let swap p =
    match p:
        case (a, b): (b, a)
let labelled = (1, "one", true)
let firstOf t =
    match t:
        case (a, _, _): a
