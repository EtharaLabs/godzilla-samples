let (|Even|Odd|) n = (if ((n % 2) == 0) then Even else Odd)
let parity n =
    match n:
        case Even: "even"
        case Odd: "odd"
let (|Positive|_|) n = (if (n > 0) then (Some n) else None)
let clamped n =
    match n:
        case (Positive p): p
        case _: 0
let (|Blank|_|) s = ((String.strip s) == "")
let lineKind s =
    match s:
        case Blank: "empty"
        case _: "text"
