# ==== shape.py ====
from dataclasses import dataclass
from functools import total_ordering
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Circle:
    _0: int
    def __repr__(self):
        return f"Circle({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Rect:
    _0: int
    _1: int
    def __repr__(self):
        return f"Rect({self._0!r}, {self._1!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0, self._1)

# ==== main.py ====
import shape
def area(s):
    match s:
        case shape.Circle(r):
            return r * r
        case shape.Rect(w, h):
            return w * h
        case _:
            raise RuntimeError("non-exhaustive match")
print(area(shape.Circle(3)))
print(area(shape.Rect(4, 5)))

