# ==== strx.py ====
import operator
import sys
shout = lambda _pf_recv: _pf_recv.upper()
realPart = lambda _pf_recv: _pf_recv.real
limit = lambda *_pf_a: sys.getrecursionlimit()
times = lambda _pf_a0, _pf_a1, _pf_a2: operator.mul(_pf_a0, _pf_a2)

# ==== main.py ====
import strx
def _pf_map(f, xs):
    return list(map(f, xs))
print(strx.shout("hi"))
print(_pf_map(strx.shout, ["ab", "cd"]))
print(strx.realPart(5))
print(strx.limit(None))
print(strx.times("ab", None, 3))

