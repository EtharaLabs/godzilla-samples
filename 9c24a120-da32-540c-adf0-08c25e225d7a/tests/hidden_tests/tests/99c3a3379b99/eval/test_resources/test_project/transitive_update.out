# ==== inner.py ====
from dataclasses import dataclass
@dataclass(frozen=True, slots=True, order=True)
class Config:
    cSize: int
def make(n):
    return Config(n)

# ==== middle.py ====
from dataclasses import dataclass
import inner
@dataclass(frozen=True, slots=True, order=True)
class Wrap:
    wConf: object
def mk(n):
    return Wrap(inner.make(n))
def size(w):
    return w.wConf.cSize

# ==== main.py ====
import inner
import middle
x = middle.mk(5)
_pf_t0 = x
y = middle.Wrap(inner.Config(9))
_pf_t1 = x.wConf
z = inner.Config(7)
print(y.wConf.cSize)
print(z.cSize)
print(middle.size(y))

