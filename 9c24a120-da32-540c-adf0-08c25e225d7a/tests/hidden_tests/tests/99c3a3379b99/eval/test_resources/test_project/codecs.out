# ==== rules.py ====
from dataclasses import dataclass
from functools import total_ordering
from _pyfun_rt import Some, None_, _None_
@dataclass(frozen=True, slots=True, order=True)
class Placed:
    letter: str
    score: int
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Ann:
    def __repr__(self):
        return "Ann"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0,)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Bob:
    def __repr__(self):
        return "Bob"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1,)
_Bob = Bob()
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Guest:
    _0: str
    def __repr__(self):
        return f"Guest({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (2, self._0)
@dataclass(frozen=True, slots=True, order=True)
class View:
    board: dict
    turn: object
_Ann = 0
sample = View(dict([((1, 2), Placed("Q", 10))]), Some(_Bob))

# ==== main.py ====
from dataclasses import dataclass
import dataclasses
import json
import keyword
import rules
from _pyfun_rt import Ok, Error
from _pyfun_rt import Some, None_, _None_
from _pyfun_rt import _Exception
def _pf_dec_decode_string(dec, s):
    try:
        return Ok(dec(json.loads(s)))
    except Exception as e:
        return Error(_Exception(type(e).__name__, str(e)))
@dataclass(frozen=True, slots=True, order=True)
class Seat:
    who: object
    at: int
def _pf_dec_auto(d):
    return lambda v: _pf_dec_auto_value(d, v)
def _pf_dec_auto_value(d, v):
    k = d[0]
    if k == "ref":
        return _pf_dec_auto_value(_pf_codecs[d[1]], v)
    if k == "int":
        if isinstance(v, bool) or not isinstance(v, int):
            raise ValueError("expected an int, got " + type(v).__name__)
        return v
    if k == "float":
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            raise ValueError("expected a float, got " + type(v).__name__)
        return float(v)
    if k == "bool":
        if not isinstance(v, bool):
            raise ValueError("expected a bool, got " + type(v).__name__)
        return v
    if k == "str":
        if not isinstance(v, str):
            raise ValueError("expected a string, got " + type(v).__name__)
        return v
    if k == "unit":
        if not v is None:
            raise ValueError("expected null, got " + type(v).__name__)
        return None
    if k == "option":
        if v is None:
            return _None_
        return Some(_pf_dec_auto_value(d[1], v))
    if k == "list" or k == "set":
        if not isinstance(v, list):
            raise ValueError("expected a list, got " + type(v).__name__)
        out = []
        for x in v:
            out.append(_pf_dec_auto_value(d[1], x))
        return out if k == "list" else set(out)
    if k == "tuple":
        if not isinstance(v, list) or len(v) != len(d[1]):
            raise ValueError("expected a list of " + str(len(d[1])) + " items")
        return tuple(map(_pf_dec_auto_value, d[1], v))
    if k == "map":
        out = {}
        if d[1][0] == "str":
            if not isinstance(v, dict):
                raise ValueError("expected an object, got " + type(v).__name__)
            for key in v:
                out[key] = _pf_dec_auto_value(d[2], v[key])
            return out
        if not isinstance(v, list):
            raise ValueError("expected a list of pairs, got " + type(v).__name__)
        for pair in v:
            out[_pf_dec_auto_value(d[1], pair[0])] = _pf_dec_auto_value(d[2], pair[1])
        return out
    if k == "record":
        if not isinstance(v, dict):
            raise ValueError("expected an object, got " + type(v).__name__)
        args = []
        for field in d[2]:
            args.append(_pf_dec_auto_value(field[1], v[field[0]]))
        return d[1](*args)
    if k == "adt":
        if not isinstance(v, dict):
            raise ValueError("expected an object, got " + type(v).__name__)
        tag = v["type"]
        if not tag in d[1]:
            raise ValueError("unknown case " + str(tag))
        ctor, descs = d[1][tag]
        fields = v.get("fields", [])
        if len(fields) != len(descs):
            raise ValueError("case " + tag + (" takes " + (str(len(descs)) + " fields")))
        if not descs:
            return ctor
        return ctor(*map(_pf_dec_auto_value, descs, fields))
    raise ValueError("unknown codec " + str(k))
def _pf_enc_auto(v):
    return json.dumps(_pf_enc_value(v))
def _pf_enc_value(v):
    if v is None or isinstance(v, (bool, int, float, str)):
        return v
    if isinstance(v, (list, tuple, set, frozenset)):
        return list(map(_pf_enc_value, v))
    if isinstance(v, dict):
        pairs = []
        strings = True
        for key in v:
            if not isinstance(key, str):
                strings = False
            pairs.append([_pf_enc_value(key), _pf_enc_value(v[key])])
        return dict(pairs) if strings else pairs
    if isinstance(v, Some):
        return _pf_enc_value(v._0)
    if isinstance(v, None_):
        return None
    names = []
    for f in dataclasses.fields(v):
        names.append(f.name)
    positional = True
    for n in names:
        if not n.startswith("_"):
            positional = False
    if positional:
        out = {"type": type(v).__name__}
        if names:
            out["fields"] = []
            for n in names:
                out["fields"].append(_pf_enc_value(getattr(v, n)))
        return out
    out = {}
    for n in names:
        key = n[0:-1] if n.endswith("_") and keyword.iskeyword(n[0:-1]) else n
        out[key] = _pf_enc_value(getattr(v, n))
    return out
_pf_codecs = {"Placed": ("record", rules.Placed, [("letter", ("str",)), ("score", ("int",))]), "Player": ("adt", {"Ann": (rules.Ann(), []), "Bob": (rules._Bob, []), "Guest": (rules.Guest, [("str",)])}), "Seat": ("record", Seat, [("who", ("ref", "Player")), ("at", ("int",))]), "View": ("record", rules.View, [("board", ("map", ("tuple", [("int",), ("int",)]), ("ref", "Placed"))), ("turn", ("option", ("ref", "Player")))])}
wire = _pf_enc_auto(rules.sample)
print(wire)
back = _pf_dec_decode_string(_pf_dec_auto(("ref", "View")), wire)
if isinstance(back, Ok):
    v = back._0
    _pf_t0 = print(v == rules.sample)
else:
    e = back._0
    _pf_t0 = print(e.errorMessage)
_pf_t0
seats = [Seat(rules.Guest("zed"), 1), Seat(rules.Ann(), 2), Seat(rules._Bob, 3)]
seatWire = _pf_enc_auto(seats)
print(seatWire)
_pf_t2 = _pf_dec_decode_string(_pf_dec_auto(("list", ("ref", "Seat"))), seatWire)
if isinstance(_pf_t2, Ok):
    v = _pf_t2._0
    _pf_t1 = print(v == seats)
else:
    e = _pf_t2._0
    _pf_t1 = print(e.errorMessage)
_pf_t1

# ==== _pyfun_rt.py ====
from dataclasses import dataclass
from functools import total_ordering
import contextvars
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Ok:
    _0: object
    def __repr__(self):
        return f"Ok({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Error:
    _0: object
    def __repr__(self):
        return f"Error({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class Some:
    _0: object
    def __repr__(self):
        return f"Some({self._0!r})"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (1, self._0)
@total_ordering
@dataclass(frozen=True, slots=True, repr=False)
class None_:
    def __repr__(self):
        return "None_"
    def __lt__(self, other):
        return self._pf_order_key() < other._pf_order_key()
    def _pf_order_key(self):
        return (0,)
_None_ = None_()
@dataclass(frozen=True, slots=True, repr=False)
class _Exception:
    errorKind: str
    errorMessage: str
    def __repr__(self):
        return f"_Exception({self.errorKind!r}, {self.errorMessage!r})"
_pf_scope = contextvars.ContextVar("_pf_scope")

