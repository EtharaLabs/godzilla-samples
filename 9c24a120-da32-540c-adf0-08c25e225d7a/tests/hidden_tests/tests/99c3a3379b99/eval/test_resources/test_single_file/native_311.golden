from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class A:
    _0: int
    def __repr__(self):
        return f"A({self._0!r})"
@dataclass(frozen=True, slots=True, repr=False)
class B:
    def __repr__(self):
        return "B"
_B: B = B()
T = A | B
def show(t: T) -> str:
    if isinstance(t, A):
        n = t._0
        return f"A {n}"
    else:
        return "B"
print(show(A(1)))
