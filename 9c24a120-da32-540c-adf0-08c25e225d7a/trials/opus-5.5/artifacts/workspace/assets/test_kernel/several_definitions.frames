00000285from dataclasses import dataclass
@dataclass(frozen=True, slots=True, repr=False)
class U:
    def __repr__(self):
        return "U"
_U = U()
@dataclass(frozen=True, slots=True, repr=False)
class V:
    def __repr__(self):
        return "V"
_V = V()
a, b = (1, "x")
c = a + 1
d = _U
