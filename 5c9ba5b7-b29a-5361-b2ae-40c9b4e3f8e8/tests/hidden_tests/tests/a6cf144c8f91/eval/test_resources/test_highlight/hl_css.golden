exit: 0
--- stdout ---
/* Lini syntax highlighting — the token palette [SPEC 18].
   Printed by `lini highlight --css`; re-tint a role by redeclaring its variable. */
@layer lini.defaults {
  :root {
    --lini-tok-comment: light-dark(#8a8f98, #6272a4);
    --lini-tok-string: light-dark(#0a7d2c, #f1fa8c);
    --lini-tok-value: light-dark(#8250df, #bd93f9);
    --lini-tok-type: light-dark(#1078a8, #8be9fd);
    --lini-tok-prop: light-dark(#c2185b, #ff79c6);
    --lini-tok-var: light-dark(#b3530b, #ffb86c);
    --lini-tok-op: light-dark(#c2185b, #ff79c6);
    --lini-tok-class: light-dark(#1a7f37, #50fa7b);
    --lini-tok-punct: light-dark(#6e7781, #7b7f9e);
  }
}

.lini-tok-comment {
  color: var(--lini-tok-comment);
  font-style: italic;
}

.lini-tok-string {
  color: var(--lini-tok-string);
}

.lini-tok-number,
.lini-tok-const,
.lini-tok-keyword {
  color: var(--lini-tok-value);
}

.lini-tok-type {
  color: var(--lini-tok-type);
  font-style: italic;
}

.lini-tok-prop {
  color: var(--lini-tok-prop);
}

.lini-tok-type-user {
  color: var(--lini-tok-type);
  font-style: italic;
  opacity: 0.65;
}

.lini-tok-prop-user {
  color: var(--lini-tok-prop);
  opacity: 0.65;
}

.lini-tok-var {
  color: var(--lini-tok-var);
}

.lini-tok-op {
  color: var(--lini-tok-op);
}

.lini-tok-class {
  color: var(--lini-tok-class);
  font-style: italic;
}

.lini-tok-punct {
  color: var(--lini-tok-punct);
}
--- stderr ---
