exit: 0
--- stdout ---
<span class="lini-tok-comment">// Positioning &amp; spacing — pin (the 9 named anchor points), translate (a</span>
<span class="lini-tok-comment">// post-placement nudge, a tucked badge, exact coordinates), and the 1-, 2- and</span>
<span class="lini-tok-comment">// 4-value padding forms. Palette colours.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">column</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">start</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-op">::</span><span class="lini-tok-type">block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">chip</span><span class="lini-tok-op">::</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--amber-soft</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--amber-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--amber-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">pad</span><span class="lini-tok-op">::</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--green-soft</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--green-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--green-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-comment">// pin: lift a child out of flow and sit it flush on a named point of the parent</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">anchors</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">8</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">caption</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;pin&quot;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">pins</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">180</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">120</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-wash</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">radius</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">8</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;center&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--teal-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;TL&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">top</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--rose-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;T&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--rose-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;TR&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">top</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--rose-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;L&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--rose-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;R&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--rose-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;BL&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;B&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">dot</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;BR&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// translate: a flow nudge that moves nobody, a badge tucked out over its corner,</span>
<span class="lini-tok-comment">// and — with pin: center — exact parent-local coordinates, no size arithmetic</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">moves</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">14</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">caption</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;translate&quot;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">row</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">14</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">chip</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">a</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;A&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">chip</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">b</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;nudged&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">card</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">140</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">74</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--purple-wash</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--purple-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--purple-ink</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-string">&quot;Card&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">badge</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;9&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-4</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;id 42&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pin</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--muted</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// padding takes 1-, 2-, or 4-value forms, and places the content it insets</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">spacing</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">10</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">caption</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;padding&quot;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">pad</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;scalar&quot;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">pad</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;v h&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span> <span class="lini-tok-number">14</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">pad</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;t r b l&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span> <span class="lini-tok-number">8</span> <span class="lini-tok-number">16</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>
--- stderr ---
