exit: 0
--- stdout ---
<span class="lini-tok-comment">// A 3.3 V rail — the smallest honest sheet: a linear regulator, its output</span>
<span class="lini-tok-comment">// cap, and the header it feeds. `layout: schematic` splits the children by</span>
<span class="lini-tok-comment">// role — 3+-pin parts are **anchors** and ride the scope's track row; labels</span>
<span class="lini-tok-comment">// and 1–2-pin parts are **satellites**, seated at the pin their wire touches</span>
<span class="lini-tok-comment">// and auto-posed to face back up the chain. The wires stay the router's,</span>
<span class="lini-tok-comment">// landing on fixed ports: a pin's stub tip, a label's connection point.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">schematic</span><span class="lini-tok-punct">;</span>

  <span class="lini-tok-comment">// A power flag is a define with intrinsic text [SPEC 8/16.4]: the symbol is</span>
  <span class="lini-tok-comment">// drawn with its connection point at the bottom, so a chain ending in one</span>
  <span class="lini-tok-comment">// grows **up** out of the pin it feeds.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">v5</span><span class="lini-tok-op">::</span><span class="lini-tok-type">label</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> power<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-string">&quot;5V&quot;</span>
  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-comment">// ── anchors ──</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">component</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">U1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;AMS1117-3.3&quot;</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">vin</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">vout</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>
<span class="lini-tok-comment">// `pins: 4` generates p1–p4 as **one column** facing left [SPEC 16.2] — a</span>
<span class="lini-tok-comment">// connector is a header, not a bilateral part — so the header already faces</span>
<span class="lini-tok-comment">// back at the regulator; `rotate: 180` would turn the whole column the other</span>
<span class="lini-tok-comment">// way, and is read at lowering (the rail reverses, every text stays upright).</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">J</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">J1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;JST XH&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">pins</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>

<span class="lini-tok-comment">// ── satellites ──</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">C</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">C1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;22u&quot;</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">G1</span><span class="lini-tok-punct">|</span>

<span class="lini-tok-comment">// ── wires ──</span>
U1.vin <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">v5</span><span class="lini-tok-punct">|</span>
<span class="lini-tok-comment">// a chain **passes through** the cap: it enters on p1 and leaves by p2, so the</span>
<span class="lini-tok-comment">// output rail, the decoupling cap and its ground are one series statement,</span>
<span class="lini-tok-comment">// hanging off the wire that leaves `vout`</span>
U1.vout <span class="lini-tok-op">-</span> C1 <span class="lini-tok-op">-</span> G1
<span class="lini-tok-comment">// a net name is the wire's own label, placed along the route — a sheet writes</span>
<span class="lini-tok-comment">// it just **beside** the trace and never cuts one open [SPEC 16.4/16.5]</span>
U1.vout <span class="lini-tok-op">-</span> J1.p3 <span class="lini-tok-string">&quot;3V3&quot;</span>
<span class="lini-tok-comment">// the capsule form — a label declared where it is wired</span>
U1.gnd <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span>
<span class="lini-tok-comment">// a label wire — the one-ended statement mints the net tag it points at, and</span>
<span class="lini-tok-comment">// the op's end marker **shapes** it: bare `-` leaves it `plain`, so the tag is</span>
<span class="lini-tok-comment">// a **run** — the wire travels its length and the name rides over the trace,</span>
<span class="lini-tok-comment">// the sheet's own convention. A marker makes it a drawn tag instead, which is</span>
<span class="lini-tok-comment">// how a global label terminates its net.</span>
J1.p1 <span class="lini-tok-op">-&gt;</span> <span class="lini-tok-string">&quot;NSTDBY&quot;</span>
<span class="lini-tok-comment">// `-&lt;` points the other way, `-&lt;&gt;` draws both ends, `-*` rounds it — the same</span>
<span class="lini-tok-comment">// statement, four outlines. A plain run takes `side:` to pick which side of</span>
<span class="lini-tok-comment">// the trace its name sits on, and `width:` to lengthen the run under it.</span>
J1.p2 <span class="lini-tok-op">-&lt;</span> <span class="lini-tok-string">&quot;SLEEP&quot;</span>
<span class="lini-tok-comment">// a plain run, one-ended: the wire runs its own length and the name rides</span>
<span class="lini-tok-comment">// over it — no tag drawn, no trace cut. `side:` picks which side of the trace</span>
<span class="lini-tok-comment">// the name sits on and `width:` lengthens the run beneath it; both are left at</span>
<span class="lini-tok-comment">// their defaults here, which on stacked pins is what keeps a name unambiguous.</span>
J1.p4 <span class="lini-tok-op">-</span> <span class="lini-tok-string">&quot;SENSE&quot;</span>
--- stderr ---
