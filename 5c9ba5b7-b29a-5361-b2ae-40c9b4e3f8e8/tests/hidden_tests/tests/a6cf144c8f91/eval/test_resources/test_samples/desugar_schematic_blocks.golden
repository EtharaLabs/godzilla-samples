exit: 0
--- stdout ---
{
  layout: flow; padding: 0; gap: 36; font-size: 15; density: 4.7;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-path { fill: --fill; stroke: --stroke; stroke-width: 2; }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-rect { radius: 0; }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-caption {
    pin: top left; translate: 0 -20; color: --caption-color; font-scale: 12 15; font-weight: --caption-font-weight;
  }
  .lini-sheet-caption {
    translate: 10 10; font-scale: 16 15; font-weight: semibold;
  }
  .lini-row { direction: row; }
  .lini-column { direction: column; }
  .lini-table {
    layout: grid; align: stretch; justify: stretch; gap: 1; gap-fill: --stroke; padding: 0; fill: none; stroke: --stroke; stroke-width: 2; stroke-style: solid; font-size: 14; font-weight: normal; scale: 1;
  }
  .lini-cell { padding: 4 8; }
  .lini-header { fill: --header-fill; font-weight: semibold; }
  .lini-page { fill: --bg; stroke-width: 0; width: 210; height: 297; }
  .lini-title-block {
    font-size: 14; font-weight: semibold; stroke-width: 1; radius: 0;
  }
  .lini-field { font-size: 12; font-weight: normal; color: --footer-color; }
  .lini-frame { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-zone { font-size: 11; color: --stroke-light; }
  .lini-tick { stroke: --stroke; stroke-width: 1; fill: none; }
  .lini-component {
    fill: --component-fill; stroke: --component-stroke; stroke-width: 1.5; radius: 0; padding: 8; prefix: "U";
  }
  .lini-pin { height: 20; padding: 0; font-size: 11; gap: 0; }
  .lini-space { width: 20; height: 20; }
  .lini-label { shape: plain; font-size: 11; color: --label-ink; gap: 4; }
  .lini-junction { fill: --wire; stroke: none; width: 8; }
  .lini-gnd { symbol: gnd; }
  .lini-nc { symbol: nc; }
  .lini-vsys { symbol: power; }
  .lini-vm { symbol: power; }
  .lini-region { layout: schematic; padding: 60 20; }
  .lini-align-start { align: start; }
  .lini-align-end { align: end; }
  .lini-justify-start { justify: start; }
  .lini-justify-end { justify: end; }
  .lini-sch-line { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-sch-solid { fill: --component-stroke; stroke: none; }
  .lini-sch-tag-line { fill: none; stroke: --label-ink; stroke-width: 1.5; }
  .lini-pin-stub { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-pin-number { color: --pin-number; font-size: 10; }
  .lini-ref { font-size: 12; font-weight: semibold; }
  .lini-part-value { font-size: 12; }
  .lini-net-run { width: 40; padding: 0 4; }
}

|block| .lini-page.lini-block {
  width: 420; height: 297; layout: grid; padding: 0; columns: 800, 1000; gap: 10; px-per-unit: 4.7;
} [
  |block#boost| .lini-region.lini-group.lini-block {
