exit: 0
--- stdout ---
{
  layout: flow; padding: 30; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-table {
    layout: grid; align: stretch; justify: stretch; gap: 1; gap-fill: --stroke; padding: 0; fill: none; stroke: --stroke; stroke-width: 2; stroke-style: solid; font-size: 14; font-weight: normal; scale: 1;
  }
  .lini-cell { padding: 4 8; }
  .lini-header { fill: --header-fill; font-weight: semibold; }
  .lini-entity { columns: auto, auto; }
  .lini-align-start { align: start; }
  .lini-align-end { align: end; }
  .lini-justify-start { justify: start; }
  .lini-justify-end { justify: end; }
}

|block#user| .lini-entity.lini-table.lini-group.lini-block {
  pin: center; translate: 0 -14; columns: auto, auto, auto; stroke: --blue-ink; fill: --blue-wash;
} [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "User" ]
  |block| .lini-cell.lini-block [ "PK" ]
  |block#pk| .lini-cell.lini-block [ "id" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "" ]
  |block| .lini-cell.lini-block [ "name" ]
  |block| .lini-cell.lini-block [ "varchar" ]
  |block| .lini-cell.lini-block [ "" ]
  |block| .lini-cell.lini-block [ "email" ]
  |block| .lini-cell.lini-block [ "varchar" ]
]
|block#order| .lini-entity.lini-table.lini-group.lini-block {
  pin: center; translate: 200 124; columns: auto, auto, auto; stroke: --teal-ink; fill: --teal-wash;
} [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "Order" ]
  |block| .lini-cell.lini-block [ "PK" ]
  |block| .lini-cell.lini-block [ "id" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "FK" ]
  |block#user_fk| .lini-cell.lini-block [ "user_id" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "" ]
  |block| .lini-cell.lini-block [ "total" ]
  |block| .lini-cell.lini-block [ "decimal" ]
]
|block#item| .lini-entity.lini-table.lini-group.lini-block {
  pin: center; translate: 19 304; columns: auto, auto, auto; stroke: --amber-ink; fill: --amber-wash;
} [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "LineItem" ]
  |block| .lini-cell.lini-block [ "PK" ]
  |block| .lini-cell.lini-block [ "id" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "FK" ]
  |block| .lini-cell.lini-block [ "order_id" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "FK" ]
  |block#product_fk| .lini-cell.lini-block [ "product_id" ]
  |block| .lini-cell.lini-block [ "int" ]
]
|block#product| .lini-entity.lini-table.lini-group.lini-block {
  pin: center; translate: -204 185; columns: auto, auto, auto; stroke: --green-ink; fill: --green-wash;
} [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "Product" ]
  |block| .lini-cell.lini-block [ "PK" ]
  |block#pk| .lini-cell.lini-block [ "id" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "" ]
  |block| .lini-cell.lini-block [ "name" ]
  |block| .lini-cell.lini-block [ "varchar" ]
  |block| .lini-cell.lini-block [ "" ]
  |block| .lini-cell.lini-block [ "price" ]
  |block| .lini-cell.lini-block [ "decimal" ]
]
|block#cart| .lini-entity.lini-table.lini-group.lini-block {
  pin: center; translate: 176 -171; stroke: --rose-ink; fill: --rose-wash;
} [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "Cart" ]
  |block| .lini-cell.lini-block [ "items" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "updated" ]
  |block| .lini-cell.lini-block [ "timestamp" ]
]
|block#category| .lini-entity.lini-table.lini-group.lini-block {
  pin: center; translate: -195 -143;
} [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "Category" ]
  |block| .lini-cell.lini-block [ "name" ]
  |block| .lini-cell.lini-block [ "varchar" ]
  |block| .lini-cell.lini-block [ "slug" ]
  |block| .lini-cell.lini-block [ "varchar" ]
]

user.pk -o< order.user_fk:left
user -o+ cart
order -+< item:right
product.pk -o< item.product_fk
category -o< product
--- stderr ---
