exit: 0
--- stdout ---
{
  layout: grid; padding: 30; gap: 26; font-size: 15; columns: repeat(4);
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-oval {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-hex {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-slant {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12; skew: 15;
  }
  .lini-cyl {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-diamond {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-poly { fill: --fill; stroke: --stroke; stroke-width: 2; }
  .lini-path { fill: --fill; stroke: --stroke; stroke-width: 2; }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-icon {
    fill: --icon-fill; stroke: --stroke; stroke-width: 2; width: 32; height: 32;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-rect { radius: 0; }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-caption {
    pin: top left; translate: 0 -20; color: --caption-color; font-scale: 12 15; font-weight: --caption-font-weight;
  }
  .lini-footnote {
    pin: bottom; translate: 0 19; font-scale: 12 15; color: --footer-color;
  }
  .lini-badge {
    pin: top right; translate: 6 -6; radius: 8; padding: 2 6; shadow: 2 3 3; fill: --accent; color: --accent-text; font-size: 11; font-weight: normal;
  }
  .lini-column { direction: column; }
  .lini-table {
    layout: grid; align: stretch; justify: stretch; gap: 1; gap-fill: --stroke; padding: 0; fill: none; stroke: --stroke; stroke-width: 2; stroke-style: solid; font-size: 14; font-weight: normal; scale: 1;
  }
  .lini-cell { padding: 4 8; }
  .lini-header { fill: --header-fill; font-weight: semibold; }
  .lini-tile { gap: 9; align: center; }
  .lini-cap { font-size: 12; color: --muted; }
  .lini-align-start { align: start; }
  .lini-align-end { align: end; }
  .lini-justify-start { justify: start; }
  .lini-justify-end { justify: end; }
}

|block| .lini-tile.lini-column.lini-block [
  |block| .lini-box.lini-block {
    width: 66; height: 46; fill: --red-wash; stroke: --red-deep;
  } [
    |block| .lini-badge.lini-block [ "new" ]
  ]
  |block| .lini-cap.lini-block [ "box + badge" ]
]
|block| .lini-tile.lini-column.lini-block [
  |block| .lini-rect.lini-box.lini-block {
    width: 66; height: 46; fill: --orange-wash; stroke: --orange-deep;
  }
  |block| .lini-cap.lini-block [ "rect" ]
]
|block| .lini-tile.lini-column.lini-block [
  |oval| .lini-oval {
    width: 68; height: 54; fill: --amber-wash; stroke: --amber-deep;
  }
  |block| .lini-cap.lini-block [ "oval" ]
]
|block| .lini-tile.lini-column.lini-block [
  |hex| .lini-hex {
    width: 68; height: 58; fill: --lime-wash; stroke: --lime-deep;
  }
  |block| .lini-cap.lini-block [ "hex" ]
]
|block| .lini-tile.lini-column.lini-block [
  |slant| .lini-slant {
    width: 66; height: 46; fill: --green-wash; stroke: --green-deep;
  }
  |block| .lini-cap.lini-block [ "slant" ]
]
|block| .lini-tile.lini-column.lini-block [
  |cyl| .lini-cyl {
    width: 58; height: 56; fill: --teal-wash; stroke: --teal-deep;
  }
  |block| .lini-cap.lini-block [ "cyl" ]
]
|block| .lini-tile.lini-column.lini-block [
  |diamond| .lini-diamond {
    width: 70; height: 60; fill: --sky-wash; stroke: --sky-deep;
  }
  |block| .lini-cap.lini-block [ "diamond" ]
]
|block| .lini-tile.lini-column.lini-block [
  |poly| .lini-poly {
    points: 0 -30, 30 -6, 17 28, -17 28, -30 -6; fill: --purple-wash; stroke: --purple-deep;
  }
  |block| .lini-cap.lini-block [ "poly" ]
]
|block| .lini-tile.lini-column.lini-block [
  |path| .lini-path {
    path: "M -32 26 Q 0 -28 32 26"; stroke: --rose-deep; stroke-width: 4;
  }
  |block| .lini-cap.lini-block [ "path" ]
]
|block| .lini-tile.lini-column.lini-block [
  |line| .lini-line {
    points: -32 0, 32 0; marker-end: arrow; stroke: --red; stroke-width: 3;
  }
  |block| .lini-cap.lini-block [ "line" ]
]
|block| .lini-tile.lini-column.lini-block [
  |icon| .lini-icon {
    symbol: house; width: 42; height: 42; fill: --teal-wash; stroke: --teal-deep;
  }
  |block| .lini-cap.lini-block [ "icon" ]
]
|block| .lini-tile.lini-column.lini-block [
  |block| .lini-group.lini-block { padding: 12; } [
    |block| .lini-caption.lini-block [ "Group" ]
    |block| .lini-box.lini-block {
      width: 56; height: 34; fill: --gray-wash; stroke: --gray-ink;
    }
    |block| .lini-footnote.lini-caption.lini-block [ "footnote" ]
  ]
]
|block| .lini-tile.lini-column.lini-block [
  |block| .lini-table.lini-group.lini-block { columns: 24, 24, 24; } [
    |block| .lini-cell.lini-block [ "a" ]
    |block| .lini-cell.lini-block [ "b" ]
    |block| .lini-cell.lini-block [ "c" ]
    |block| .lini-cell.lini-block [ "d" ]
    |block| .lini-cell.lini-block [ "e" ]
    |block| .lini-cell.lini-block [ "f" ]
  ]
  |block| .lini-cap.lini-block [ "table" ]
]
|block| .lini-tile.lini-column.lini-block [
  |path| .lini-path {
    path: "M 0 -28 C 22 -30 31 -12 23 4 C 17 16 30 25 11 30 C -7 34 -27 25 -26 6 C -25 -11 -22 -28 0 -28 Z"; fill: --rose-wash; stroke: --rose-ink; stroke-width: 2;
  }
  |block| .lini-cap.lini-block [ "blob path" ]
]
--- stderr ---
