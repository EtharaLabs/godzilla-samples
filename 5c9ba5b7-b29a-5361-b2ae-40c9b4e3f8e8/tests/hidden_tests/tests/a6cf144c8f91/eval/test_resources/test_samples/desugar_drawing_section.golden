    ]
    |block| .lini-cell.lini-block {
      direction: column; padding: 2 6; width: 96; gap: 4; field: "Drawn";
    } [
      |block| .lini-field.lini-block [ "Drawn" ]
      "AM"
    ]
  ]
  |block| .lini-frame.lini-rect.lini-box.lini-block {
    chrome: frame; pin: center;
