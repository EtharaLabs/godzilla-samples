exit: 0
--- stdout ---
{
  layout: flow; padding: 0; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-oval {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-sketch { fill: --fill; stroke: --stroke-dark; stroke-width: 2; }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-rect { radius: 0; }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-caption {
    pin: top left; translate: 0 -20; color: --caption-color; font-scale: 12 15; font-weight: --caption-font-weight;
  }
  .lini-footnote {
    pin: bottom; translate: 0 19; font-scale: 12 15; color: --footer-color;
  }
  .lini-table {
    layout: grid; align: stretch; justify: stretch; gap: 1; gap-fill: --stroke; padding: 0; fill: none; stroke: --stroke; stroke-width: 2; stroke-style: solid; font-size: 14; font-weight: normal; scale: 1;
  }
  .lini-cell { padding: 4 8; }
  .lini-header { fill: --header-fill; font-weight: semibold; }
  .lini-drawing { layout: drawing; padding: 0; }
  .lini-hole { fill: --bg; stroke: --stroke-dark; }
  .lini-centerline {
    stroke-style: center; stroke: --stroke-light; stroke-width: 1; fill: none;
  }
  .lini-hidden {
    stroke-style: dashed; stroke: --stroke-dark; stroke-width: 1; fill: none;
  }
  .lini-shoulder { stroke: --stroke-dark; }
  .lini-threadline { stroke: --stroke-light; stroke-width: 1; fill: none; }
  .lini-plane {
    stroke-style: center; stroke: --stroke-light; stroke-width: 1; fill: none;
  }
  .lini-magnifier { stroke: --stroke-light; stroke-width: 1; fill: none; }
  .lini-page { fill: --bg; stroke-width: 0; width: 210; height: 297; }
  .lini-title-block {
    font-size: 14; font-weight: semibold; stroke-width: 1; radius: 0;
  }
  .lini-field { font-size: 12; font-weight: normal; color: --footer-color; }
  .lini-frame { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-zone { font-size: 11; color: --stroke-light; }
  .lini-tick { stroke: --stroke; stroke-width: 1; fill: none; }
  .lini-steel { fill: hatch(45, 5); }
  .lini-bronze { fill: hatch(-45, 4); }
  .lini-align-start { align: start; }
  .lini-align-end { align: end; }
  .lini-justify-start { justify: start; }
  .lini-justify-end { justify: end; }
}

|block#sheet| .lini-page.lini-block {
  width: 420; height: 297; gap: 28; align: origin; direction: row; px-per-unit: 4;
} [
  |block#front| .lini-drawing.lini-block { scale: 1; px-per-unit: 4; } [
    |block| .lini-footnote.lini-caption.lini-block [ "PUMP BODY" ]
    |sketch#body| .lini-sketch {
      draw: move(-62, 0) up(52) fillet(12) right(124) fillet(12):c1 down(104)
            fillet(12) left(124) fillet(12) up(52) close();
      fill: none;
    } [
      |oval#bolt| .lini-hole.lini-oval {
        width: 8; translate: -46 -36; pattern: grid(2, 2, 92, 72); thread: 1.25;
      } [
        |line| .lini-centerline.lini-line { chrome: x-axis; }
        |line| .lini-centerline.lini-line { chrome: y-axis; }
        |line| .lini-threadline.lini-line { chrome: thread-arc internal 1.25; }
      ]
    ]
    |oval#chamber| .lini-oval {
      width: 64; height: 64; fill: --bg; stroke: --stroke-dark;
    }
    |oval#seat| .lini-oval {
      width: 28; height: 28; fill: --bg; stroke: --stroke-dark;
    }
    |oval#shaft| .lini-oval {
      width: 20; height: 20; fill: --bg; stroke: --stroke-dark;
    }
    |sketch#drill| .lini-hidden.lini-sketch {
      draw: move(-62, -11.19) right(32.02)
            move(-62, 11.19) right(32.02);
    }
    |sketch#port| .lini-steel.lini-sketch {
      draw: move(62, -22) left(38.76) fillet(3) arc(6.74, 10.81, 32) fillet(3)
            right(32.02):m24 close();
      revolve: x-axis; thread: m24 1.5;
    } [
      |line| .lini-centerline.lini-line { chrome: x-axis; }
      |line| .lini-shoulder.lini-line { chrome: edges; }
      |line| .lini-threadline.lini-line { chrome: thread; }
    ]
    |line#a| "A" .lini-plane.lini-line { at: 0; chrome: plane; }
    |oval#c| .lini-magnifier.lini-oval { width: 30; translate: 48 -40; } [ "C" ]
    body:left (-) body:right { side: bottom; }
    body:top (-) body:bottom { side: right; }
    chamber (o) { side: left; }
    port:m24 <- { along: 0.5; side: right; } [ "THRU, 2×" ]
    body.bolt <- { along: 0.5; side: bottom; } [ "4× M8×1.25, 16 DEEP" ]
  ]
  |block#sec| .lini-drawing.lini-block { of: a; scale: 1; px-per-unit: 4; } [
    |block| .lini-footnote.lini-caption.lini-block { of-title: view; }
    |sketch#beyond| .lini-sketch {
      draw: move(-22, -35) down(70)
            move(-19, -35) down(70)
            move(12, -32) down(64)
            move(26, -10) down(20)
            move(-6, 0) circle(11.19);
      fill: none;
    }
    |sketch#wall| .lini-steel.lini-sketch {
      draw: move(-26, -52) right(52) down(38) left(14) up(18) left(31) up(3)
            left(3) down(3) left(4) close();
      mirror: x-axis;
    } [
      |oval#coolant| .lini-hole.lini-oval { width: 6; translate: -8 -42; } [
        |line| .lini-centerline.lini-line { chrome: x-axis; }
        |line| .lini-centerline.lini-line { chrome: y-axis; }
      ]
      |oval#vent| .lini-hole.lini-oval {
        width: 4; translate: 16 -42; mirror: none;
      } [
        |line| .lini-centerline.lini-line { chrome: x-axis; }
        |line| .lini-centerline.lini-line { chrome: y-axis; }
      ]
    ]
    |sketch#bush| .lini-bronze.lini-sketch {
      draw: move(12, -14) right(14) down(4) left(14) close();
      mirror: x-axis;
    }
    |line| .lini-centerline.lini-line { points: -34 0, 34 0; }
    wall:left (-) wall:right { side: bottom; }
    wall:left (-) wall.coolant { side: top; }
    wall.coolant (o)
  ]
  |block#det| .lini-drawing.lini-block { of: c; scale: 3; px-per-unit: 4; } [
    |block| .lini-footnote.lini-caption.lini-block { of-title: view; }
    body:c1 (o)
  ]
  |block| .lini-title-block.lini-table.lini-group.lini-block {
    columns: auto, auto, auto; pin: bottom right;
  } [
    |block| .lini-cell.lini-block {
      direction: column; padding: 2 6; width: 96; gap: 4; field: "Title"; span: 3 1;
    } [
      |block| .lini-field.lini-block [ "Title" ]
      "Pump body"
    ]
    |block| .lini-cell.lini-block {
      direction: column; padding: 2 6; width: 96; gap: 4; field: "Dwg No.";
    } [
      |block| .lini-field.lini-block [ "Dwg No." ]
      "LN-PMP-24-001"
    ]
    |block| .lini-cell.lini-block {
      direction: column; padding: 2 6; width: 96; gap: 4; field: "Rev";
    } [
      |block| .lini-field.lini-block [ "Rev" ]
      "B"
    ]
    |block| .lini-cell.lini-block {
      direction: column; padding: 2 6; width: 96; gap: 4; field: "Sheet";
    } [
