    .lini-scope-eb25ef20 .lini-marker-dim { fill: var(--lini-gray-ink); }
    .lini-scope-eb25ef20 .lini-marker-datum { fill: var(--lini-gray-ink); }
    .lini-scope-eb25ef20 .lini-dim-line.lini-dim { stroke: var(--lini-blue-ink); stroke-width: 1; }
    .lini-scope-eb25ef20 .lini-ext-line.lini-dim { stroke: var(--lini-blue-ink); stroke-width: 1; }
    .lini-scope-eb25ef20 .lini-marker-dim.lini-dim { fill: var(--lini-blue-ink); }
