      .lini-scope-eb25ef20[data-theme="dark"], [data-theme="dark"] .lini-scope-eb25ef20 { color-scheme: dark; }
      .lini-scope-eb25ef20[data-theme="light"], [data-theme="light"] .lini-scope-eb25ef20 { color-scheme: light; }
    }
    .lini-scope-eb25ef20, .lini-scope-eb25ef20 text { font-family: var(--lini-font-family); }
    .lini-scope-eb25ef20 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-eb25ef20 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-eb25ef20 .lini-oval { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-eb25ef20 .lini-poly { stroke-dasharray: none; }
    .lini-scope-eb25ef20 .lini-path { stroke-dasharray: none; }
    .lini-scope-eb25ef20 .lini-sketch { fill: var(--lini-fill); stroke: var(--lini-stroke-dark); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-eb25ef20 .lini-line { fill: none; stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-eb25ef20 .lini-dim-line { fill: none; stroke: var(--lini-gray-ink); stroke-width: 1; }
    .lini-scope-eb25ef20 .lini-ext-line { fill: none; stroke: var(--lini-gray-ink); stroke-width: 1; }
    .lini-scope-eb25ef20 .lini-dim-text { font-size: 12px; font-weight: var(--lini-link-font-weight); }
    .lini-scope-eb25ef20 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-eb25ef20 .lini-gutter { stroke: none; }
    .lini-scope-eb25ef20 .lini-cut-bg { fill: white; stroke: none; }
    .lini-scope-eb25ef20 .lini-halo { stroke: black; }
    .lini-scope-eb25ef20 .lini-group { fill: var(--lini-group-fill); stroke: var(--lini-group-stroke); stroke-width: 1; stroke-dasharray: 5,4; }
    .lini-scope-eb25ef20 .lini-caption { color: var(--lini-caption-color); font-size: 12px; font-weight: var(--lini-caption-font-weight); }
    .lini-scope-eb25ef20 .lini-footnote { color: var(--lini-footer-color); font-size: 12px; }
    .lini-scope-eb25ef20 .lini-table { fill: none; stroke: var(--lini-stroke); stroke-width: 2; font-size: 14px; font-weight: normal; stroke-dasharray: none; }
    .lini-scope-eb25ef20 .lini-header { fill: var(--lini-header-fill); font-weight: 600; }
    .lini-scope-eb25ef20 .lini-note { fill: var(--lini-fill); stroke: var(--lini-stroke); }
    .lini-scope-eb25ef20 .lini-balloon { fill: var(--lini-fill); stroke: var(--lini-stroke); font-size: 11px; }
    .lini-scope-eb25ef20 .lini-hole { fill: var(--lini-bg); stroke: var(--lini-stroke-dark); }
    .lini-scope-eb25ef20 .lini-centerline { fill: none; stroke: var(--lini-stroke-light); stroke-width: 1; stroke-dasharray: 10,3,1,3; }
