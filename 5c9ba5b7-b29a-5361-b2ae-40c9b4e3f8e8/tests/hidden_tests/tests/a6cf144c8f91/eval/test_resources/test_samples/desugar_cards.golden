exit: 0
--- stdout ---
{
  layout: flow; padding: 26; gap: 24; font-size: 15; font-family: "Google Sans"; direction: column;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 15;
  }
  .lini-row { direction: row; }
  .card-title { font-size: 17; font-weight: bold; }
  .card-brief { font-size: 15; font-weight: medium; color: --teal-deep; }
}

"Pick a plan" { font-size: 24; font-weight: semibold; }
|block#plans| .lini-row.lini-block { gap: 24; align: start; } [
  |block#starter| .lini-box.lini-block {
    max-width: 190; radius: 12; padding: 18; align: start;
  } [
    "Starter" .card-title
    "Free" .card-brief
    "For side projects and weekend experiments. One seat, community support." {
      font-size: 13;
    }
  ]
  |block#team| .lini-box.lini-block {
    max-width: 190; radius: 12; padding: 18; align: start; fill: --teal-wash;
  } [
    "Team" .card-title
    "$12 / seat" .card-brief
    "Shared workspaces, review flows, and priority support for growing groups." {
      font-size: 13;
    }
  ]
  |block#scale| .lini-box.lini-block {
    max-width: 190; radius: 12; padding: 18; align: start;
  } [
    "Scale" .card-title
    "Custom" .card-brief
    "Dedicated infrastructure, audit logs, and a human who answers the phone." {
      font-size: 13;
    }
  ]
]

plans.starter -> plans.team { along: 0.5; } [ "grow" ]
plans.team -> plans.scale { along: 0.5; } [ "scale up" ]
--- stderr ---
