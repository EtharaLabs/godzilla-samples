exit: 0
--- stdout ---
{
  layout: drawing; padding: 20; font-size: 15; px-per-unit: 4;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-rect { radius: 0; }
}

|block#r| .lini-rect.lini-box.lini-block { width: 10; height: 5; }
--- stderr ---
