exit: 0
--- stdout ---
{
  layout: flow; padding: 0; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-rect { radius: 0; }
  .lini-page { fill: --bg; stroke-width: 0; width: 210; height: 297; }
  .lini-frame { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-zone { font-size: 11; color: --stroke-light; }
  .lini-tick { stroke: --stroke; stroke-width: 1; fill: none; }
}

|block#p| .lini-page.lini-block {
  width: 148; height: 210; direction: column; px-per-unit: 4;
} [
  |block| .lini-frame.lini-rect.lini-box.lini-block {
    chrome: frame; pin: center;
  }
  |line| .lini-tick.lini-line {
    chrome: tick left 1; pin: center; points: 0 0, 0 0;
  }
  |line| .lini-tick.lini-line {
    chrome: tick left 3; pin: center; points: 0 0, 0 0;
  }
  |line| .lini-tick.lini-line {
    chrome: tick right 1; pin: center; points: 0 0, 0 0;
  }
  |line| .lini-tick.lini-line {
    chrome: tick right 3; pin: center; points: 0 0, 0 0;
  }
  |line| .lini-tick.lini-line {
    chrome: mark top; pin: center; points: 0 0, 0 0;
  }
  |line| .lini-tick.lini-line {
    chrome: mark bottom; pin: center; points: 0 0, 0 0;
  }
  |line| .lini-tick.lini-line {
    chrome: mark left; pin: center; points: 0 0, 0 0;
  }
  |line| .lini-tick.lini-line {
    chrome: mark right; pin: center; points: 0 0, 0 0;
  }
  |block| .lini-zone.lini-block { chrome: zone top 0; pin: center; } [ "1" ]
  |block| .lini-zone.lini-block { chrome: zone top 1; pin: center; } [ "2" ]
  |block| .lini-zone.lini-block { chrome: zone bottom 0; pin: center; } [ "1" ]
  |block| .lini-zone.lini-block { chrome: zone bottom 1; pin: center; } [ "2" ]
  |block| .lini-zone.lini-block { chrome: zone left 0; pin: center; } [ "A" ]
  |block| .lini-zone.lini-block { chrome: zone left 1; pin: center; } [ "B" ]
  |block| .lini-zone.lini-block { chrome: zone left 2; pin: center; } [ "C" ]
  |block| .lini-zone.lini-block { chrome: zone left 3; pin: center; } [ "D" ]
  |block| .lini-zone.lini-block { chrome: zone right 0; pin: center; } [ "A" ]
  |block| .lini-zone.lini-block { chrome: zone right 1; pin: center; } [ "B" ]
  |block| .lini-zone.lini-block { chrome: zone right 2; pin: center; } [ "C" ]
  |block| .lini-zone.lini-block { chrome: zone right 3; pin: center; } [ "D" ]
]
--- stderr ---
