exit: 0
--- stdout ---
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-path { fill: --fill; stroke: --stroke; stroke-width: 2; }
  .lini-schematic { layout: schematic; gap: 100; clearance: 10; fill: --sheet; }
  .lini-component {
    fill: --component-fill; stroke: --component-stroke; stroke-width: 1.5; radius: 0; padding: 8; prefix: "U";
  }
  .lini-junction { fill: --wire; stroke: none; width: 8; }
  .lini-opamp { fill: none; stroke: none; prefix: "U"; }
  .lini-amp { prefix: "A"; }
  .lini-sch-line { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-ref { font-size: 12; font-weight: semibold; }
}

|block#s| .lini-schematic.lini-block [
  |block| .lini-amp.lini-opamp.lini-component.lini-block [
    |path| .lini-sch-line.lini-path {
      path: "M 0 0 M 64 64 M 12 4 L 60 32 L 12 60 Z M 0 12 L 12 12 M 0 52 L 12 52 M 60 32 L 64 32 M 17 17 L 25 17 M 21 13 L 21 21 M 17 47 L 25 47";
    }
    |block| .lini-ref.lini-block { pin: top; translate: 0 -20; } [ "A1" ]
  ]
]
--- stderr ---
