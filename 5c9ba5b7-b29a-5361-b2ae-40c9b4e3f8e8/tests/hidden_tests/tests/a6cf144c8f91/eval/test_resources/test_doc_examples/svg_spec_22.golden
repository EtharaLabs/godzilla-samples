<svg xmlns="http://www.w3.org/2000/svg" viewBox="-41 -41 82 82" width="82" height="82" class="lini lini-scope-23bce1b6">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-23bce1b6 { color-scheme: light dark; --lini-brand: #ff6600; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-23bce1b6[data-theme="dark"], [data-theme="dark"] .lini-scope-23bce1b6 { color-scheme: dark; }
      .lini-scope-23bce1b6[data-theme="light"], [data-theme="light"] .lini-scope-23bce1b6 { color-scheme: light; }
    }
    .lini-scope-23bce1b6, .lini-scope-23bce1b6 text { font-family: var(--lini-font-family); }
    .lini-scope-23bce1b6 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-23bce1b6 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-23bce1b6 .lini-box { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; }
  </style>
  <defs/>
