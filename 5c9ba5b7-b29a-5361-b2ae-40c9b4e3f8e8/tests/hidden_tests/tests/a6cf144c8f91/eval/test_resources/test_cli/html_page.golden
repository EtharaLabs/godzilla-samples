<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>lini</title>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="-115.9625 -48.5 231.925 97" width="231.925" height="97" class="lini lini-scope-06c07c44">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-06c07c44 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-link-font-weight: 400; --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-06c07c44[data-theme="dark"], [data-theme="dark"] .lini-scope-06c07c44 { color-scheme: dark; }
      .lini-scope-06c07c44[data-theme="light"], [data-theme="light"] .lini-scope-06c07c44 { color-scheme: light; }
    }
    .lini-scope-06c07c44, .lini-scope-06c07c44 text { font-family: var(--lini-font-family); }
    .lini-scope-06c07c44 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-06c07c44 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-06c07c44 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-06c07c44 .lini-box { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; }
    .lini-scope-06c07c44 .lini-link { fill: none; stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-06c07c44 .lini-link-label { fill: currentColor; stroke: none; text-anchor: middle; font-size: 11px; font-weight: var(--lini-link-font-weight); }
    .lini-scope-06c07c44 .lini-cut-bg { fill: white; stroke: none; }
    .lini-scope-06c07c44 .lini-cut { fill: black; stroke: none; }
    .lini-scope-06c07c44 .lini-marker { fill: var(--lini-stroke); stroke: none; }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-box lini-block" data-id="a" transform="translate(-54.945,0)">
      <rect x="-40.0175" y="-27.5" width="80.035" height="55" rx="8" ry="8"/>
      <text class="lini-text" x="0" y="0" dy="0.358em">Alpha</text>
    </g>
    <g class="lini-node lini-box lini-block" data-id="b" transform="translate(59.0175,0)">
      <rect x="-35.945" y="-27.5" width="71.89" height="55" rx="8" ry="8"/>
      <text class="lini-text" x="0" y="0" dy="0.358em">Beta</text>
    </g>
  </g>
  <g class="lini-links">
    <g class="lini-link" data-from="a" data-to="b">
      <mask id="lini-label-cut-07dd1b1d" maskUnits="userSpaceOnUse" x="-15.9275" y="-2" width="40" height="4"><rect class="lini-cut-bg" x="-15.9275" y="-2" width="40" height="4"/><rect class="lini-cut" x="-10.0075" y="-7.15" width="28.16" height="14.3"/></mask>
      <path d="M -13.9275 0 L 18.5725 0" mask="url(#lini-label-cut-07dd1b1d)"/>
      <polygon class="lini-marker lini-marker-arrow" points="22.5725,0 13.5725,4.5 13.5725,-4.5"/>
      <text class="lini-link-label" x="4.0725" y="0" dy="0.358em">calls</text>
    </g>
  </g>
</svg>
