<svg xmlns="http://www.w3.org/2000/svg" viewBox="-45.5225 -48.5 91.045 97" width="91.045" height="97" class="lini lini-scope-ca0186c2">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-ca0186c2 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-ca0186c2[data-theme="dark"], [data-theme="dark"] .lini-scope-ca0186c2 { color-scheme: dark; }
      .lini-scope-ca0186c2[data-theme="light"], [data-theme="light"] .lini-scope-ca0186c2 { color-scheme: light; }
    }
    .lini-scope-ca0186c2, .lini-scope-ca0186c2 text { font-family: var(--lini-font-family); }
    .lini-scope-ca0186c2 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-ca0186c2 .lini-oval { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-ca0186c2 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-oval" transform="translate(0,0)">
