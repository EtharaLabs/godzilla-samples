exit: 0
--- stdout ---
/* lini theme — copy & edit. Colours; sizes are baked, not themeable. */
:root, .lini {
  --lini-accent: #0a84ff;
  --lini-accent-text: white;
  --lini-amber: #cb8b00;
  --lini-amber-deep: #9f6900;
  --lini-amber-ink: #6d3b00;
  --lini-amber-soft: #eec978;
  --lini-amber-wash: #feedca;
  --lini-bg: white;
  --lini-blue: #3f98ff;
  --lini-blue-deep: #2774ce;
  --lini-blue-ink: #004496;
  --lini-blue-soft: #9fd1ff;
  --lini-blue-wash: #daf1ff;
  --lini-caption-color: rgba(0, 0, 0, 0.5);
  --lini-caption-font-weight: 400;
  --lini-component-fill: #fdf6d8;
  --lini-component-stroke: #8a1c1c;
  --lini-cyan: var(--lini-teal);
  --lini-danger: crimson;
  --lini-fg: black;
  --lini-fill: white;
  /* --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; */
  --lini-font-weight: 500;
  --lini-footer-color: rgba(0, 0, 0, 0.5);
  --lini-gray: #989898;
  --lini-gray-deep: #747474;
  --lini-gray-ink: #484848;
  --lini-gray-soft: #cecece;
  --lini-gray-wash: #eeeeee;
  --lini-green: #00b66e;
  --lini-green-deep: #008d51;
  --lini-green-ink: #005d26;
  --lini-green-soft: #94e2b5;
  --lini-green-wash: #d6f8e3;
  --lini-grid: rgba(0, 0, 0, 0.1);
  --lini-group-fill: rgba(0, 0, 0, 0.03);
  --lini-group-stroke: rgba(0, 0, 0, 0.4);
  --lini-header-fill: rgba(0, 0, 0, 0.06);
  --lini-icon-fill: rgba(0, 0, 0, 0.16);
  --lini-indigo: var(--lini-purple);
  --lini-label-ink: #0e6a6a;
  --lini-lime: #82a900;
  --lini-lime-deep: #628200;
  --lini-lime-ink: #385300;
  --lini-lime-soft: #c0da8f;
  --lini-lime-wash: #e8f4d3;
  --lini-link-font-weight: 400;
  --lini-muted: #888;
  --lini-orange: #e47600;
  --lini-orange-deep: #b45700;
  --lini-orange-ink: #7e2800;
  --lini-orange-soft: #ffbd8d;
  --lini-orange-wash: #ffe8d2;
  --lini-pin-number: #00000073;
  --lini-pink: var(--lini-rose);
  --lini-purple: #9084ff;
  --lini-purple-deep: #6e62cc;
  --lini-purple-ink: #443394;
  --lini-purple-soft: #c6c4ff;
  --lini-purple-wash: #eaebff;
  --lini-red: #ef675e;
  --lini-red-deep: #bc4943;
  --lini-red-ink: #851618;
  --lini-red-soft: #ffb5ac;
  --lini-red-wash: #ffe4df;
  --lini-rose: #e96490;
  --lini-rose-deep: #b8476e;
  --lini-rose-ink: #811442;
  --lini-rose-soft: #ffb2c9;
  --lini-rose-wash: #ffe3ec;
  --lini-shadow-color: rgba(0, 0, 0, 0.2);
  --lini-sheet: #faf6ea;
  --lini-sky: #00ace2;
  --lini-sky-deep: #0085b3;
  --lini-sky-ink: #00547e;
  --lini-sky-soft: #7eddfd;
  --lini-sky-wash: #cff6ff;
  --lini-stray: crimson;
  --lini-stroke: #444;
  --lini-stroke-dark: black;
  --lini-stroke-light: rgba(0, 0, 0, 0.545);
  --lini-teal: #00b8ac;
  --lini-teal-deep: #008e85;
  --lini-teal-ink: #005d56;
  --lini-teal-soft: #79e3da;
  --lini-teal-wash: #cdf9f4;
  --lini-text-color: var(--lini-fg);
  --lini-tip-bg: #333;
  --lini-tip-fg: white;
  --lini-warn: orange;
  --lini-wire: #0a7a2f;
  --lini-yellow: var(--lini-amber);
}
