exit: 0
--- stdout ---
/* lini theme — copy & edit. Colours; sizes are baked, not themeable. */
:root, .lini {
  --lini-accent: #4aa3ff;
  --lini-accent-text: white;
  --lini-amber: #9e6000;
  --lini-amber-deep: #dba200;
  --lini-amber-ink: #ffdf5c;
  --lini-amber-soft: #593900;
  --lini-amber-wash: #35280a;
  --lini-bg: #1b1b1f;
  --lini-blue: #006cd3;
  --lini-blue-deep: #62aeff;
  --lini-blue-ink: #a0ecff;
  --lini-blue-soft: #113f75;
  --lini-blue-wash: #192b41;
  --lini-caption-color: rgba(255, 255, 255, 0.55);
  --lini-caption-font-weight: 400;
  --lini-component-fill: #3a3626;
  --lini-component-stroke: #d98f8f;
  --lini-cyan: var(--lini-teal);
  --lini-danger: #ff6b6b;
  --lini-fg: #e8e8ea;
  --lini-fill: #26262b;
  /* --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; */
  --lini-font-weight: 500;
  --lini-footer-color: rgba(255, 255, 255, 0.55);
  --lini-gray: #6f6f6f;
  --lini-gray-deep: #acacac;
  --lini-gray-ink: #e8e8e8;
  --lini-gray-soft: #404040;
  --lini-gray-wash: #2a2a2a;
  --lini-green: #008a45;
  --lini-green-deep: #42c887;
  --lini-green-ink: #8bffc3;
  --lini-green-soft: #004f2a;
  --lini-green-wash: #143121;
  --lini-grid: rgba(255, 255, 255, 0.14);
  --lini-group-fill: rgba(255, 255, 255, 0.05);
  --lini-group-stroke: rgba(255, 255, 255, 0.4);
  --lini-header-fill: rgba(255, 255, 255, 0.08);
  --lini-icon-fill: rgba(255, 255, 255, 0.18);
  --lini-indigo: var(--lini-purple);
  --lini-label-ink: #57c4c4;
  --lini-lime: #5a7d00;
  --lini-lime-deep: #98bc42;
  --lini-lime-ink: #d3f986;
  --lini-lime-soft: #354800;
  --lini-lime-wash: #252e13;
  --lini-link-font-weight: 400;
  --lini-muted: #9aa0a6;
  --lini-orange: #b44a00;
  --lini-orange-deep: #f39042;
  --lini-orange-ink: #ffcd84;
  --lini-orange-soft: #662e00;
  --lini-orange-wash: #3b2413;
  --lini-pin-number: #ffffff80;
  --lini-pink: var(--lini-rose);
  --lini-purple: #6858d0;
  --lini-purple-deep: #a39cff;
  --lini-purple-ink: #ded9ff;
  --lini-purple-soft: #3c3574;
  --lini-purple-wash: #282741;
  --lini-red: #bd3936;
  --lini-red-deep: #fd8379;
  --lini-red-ink: #ffc1b5;
  --lini-red-soft: #6b2622;
  --lini-red-wash: #3e211e;
  --lini-rose: #b83667;
  --lini-rose-deep: #f880a5;
  --lini-rose-ink: #ffbee0;
  --lini-rose-soft: #68243c;
  --lini-rose-wash: #3c2028;
  --lini-shadow-color: rgba(0, 0, 0, 0.5);
  --lini-sheet: #22201b;
  --lini-sky: #0080b4;
  --lini-sky-deep: #00c0f0;
  --lini-sky-ink: #5ffdff;
  --lini-sky-soft: #004a65;
  --lini-sky-wash: #0a2f3a;
  --lini-stray: #ff6b6b;
  --lini-stroke: #9aa0a6;
  --lini-stroke-dark: white;
  --lini-stroke-light: rgba(255, 255, 255, 0.64);
  --lini-teal: #008b81;
  --lini-teal-deep: #00cabe;
  --lini-teal-ink: #4ffffa;
  --lini-teal-soft: #004f4a;
  --lini-teal-wash: #07312e;
  --lini-text-color: var(--lini-fg);
  --lini-tip-bg: #e8e8ea;
  --lini-tip-fg: #1a1a1f;
  --lini-warn: #ffb454;
  --lini-wire: #4cc472;
  --lini-yellow: var(--lini-amber);
}
