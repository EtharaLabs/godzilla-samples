<svg xmlns="http://www.w3.org/2000/svg" viewBox="-46.675 -31.5 93.35 63" width="93.35" height="63" class="lini lini-scope-5bfcf5f8">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-5bfcf5f8 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-footer-color: light-dark(rgba(0, 0, 0, 0.5), rgba(255, 255, 255, 0.55)); --lini-text-color: var(--lini-fg); }
      .lini-scope-5bfcf5f8[data-theme="dark"], [data-theme="dark"] .lini-scope-5bfcf5f8 { color-scheme: dark; }
      .lini-scope-5bfcf5f8[data-theme="light"], [data-theme="light"] .lini-scope-5bfcf5f8 { color-scheme: light; }
    }
    .lini-scope-5bfcf5f8, .lini-scope-5bfcf5f8 text { font-family: var(--lini-font-family); }
    .lini-scope-5bfcf5f8 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-5bfcf5f8 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-5bfcf5f8 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-5bfcf5f8 .lini-footer { color: var(--lini-footer-color); }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-footer lini-cell lini-block" transform="translate(0,0)">
      <rect x="-26.675" y="-11.5" width="53.35" height="23" rx="0" ry="0"/>
      <text class="lini-text" x="0" y="0" dy="0.358em">Label</text>
    </g>
  </g>
  <g class="lini-links"/>
</svg>

