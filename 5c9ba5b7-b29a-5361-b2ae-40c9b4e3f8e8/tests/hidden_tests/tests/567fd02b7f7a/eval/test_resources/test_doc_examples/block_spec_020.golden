exit: 0
--- stdout
<svg xmlns="http://www.w3.org/2000/svg" viewBox="-41 -41 82 82" width="82" height="82" class="lini lini-scope-cbc586c8">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-cbc586c8 { color-scheme: light dark; --lini-amber-soft: light-dark(#eec978, #593900); --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-cbc586c8[data-theme="dark"], [data-theme="dark"] .lini-scope-cbc586c8 { color-scheme: dark; }
      .lini-scope-cbc586c8[data-theme="light"], [data-theme="light"] .lini-scope-cbc586c8 { color-scheme: light; }
    }
    .lini-scope-cbc586c8, .lini-scope-cbc586c8 text { font-family: var(--lini-font-family); }
    .lini-scope-cbc586c8 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-cbc586c8 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-cbc586c8 .lini-box { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-box lini-block" data-id="n" style="fill: var(--lini-amber-soft)" transform="translate(0,0)">
      <rect x="-20" y="-20" width="40" height="40" rx="8" ry="8"/>
    </g>
  </g>
  <g class="lini-links"/>
</svg>

--- stderr
