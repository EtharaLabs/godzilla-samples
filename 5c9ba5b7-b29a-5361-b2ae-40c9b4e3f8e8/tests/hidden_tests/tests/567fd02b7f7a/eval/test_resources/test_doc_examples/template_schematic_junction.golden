    @layer lini.defaults {
      :root, .lini-scope-d4d3b258 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-sheet: light-dark(#faf6ea, #22201b); --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); --lini-wire: light-dark(#0a7a2f, #4cc472); }
