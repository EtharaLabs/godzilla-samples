<svg xmlns="http://www.w3.org/2000/svg" viewBox="-59.675 -48.5 119.35 97" width="119.35" height="97" class="lini lini-scope-fad4cc1a">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-fad4cc1a { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-fad4cc1a[data-theme="dark"], [data-theme="dark"] .lini-scope-fad4cc1a { color-scheme: dark; }
      .lini-scope-fad4cc1a[data-theme="light"], [data-theme="light"] .lini-scope-fad4cc1a { color-scheme: light; }
    }
    .lini-scope-fad4cc1a, .lini-scope-fad4cc1a text { font-family: var(--lini-font-family); }
    .lini-scope-fad4cc1a { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-fad4cc1a .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-fad4cc1a .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-fad4cc1a .lini-box { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; }
    .lini-scope-fad4cc1a .lini-frame { fill: none; stroke: var(--lini-stroke); stroke-width: 2; }
  </style>
  <defs/>
  <g class="lini-scene">
