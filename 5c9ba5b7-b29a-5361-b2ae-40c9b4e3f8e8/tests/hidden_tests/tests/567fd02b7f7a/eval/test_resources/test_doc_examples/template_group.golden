    .lini-scope-8c22d61a .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-8c22d61a .lini-group { fill: var(--lini-group-fill); stroke: var(--lini-group-stroke); stroke-width: 1; stroke-dasharray: 5,4; }
    .lini-scope-8c22d61a .lini-caption { color: var(--lini-caption-color); font-size: 12px; font-weight: var(--lini-caption-font-weight); }
