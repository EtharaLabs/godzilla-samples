<svg xmlns="http://www.w3.org/2000/svg" viewBox="-60 -125 214 185" width="214" height="185" class="lini lini-scope-e4ee9d9d">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-e4ee9d9d { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke-dark: light-dark(black, white); --lini-text-color: var(--lini-fg); }
      .lini-scope-e4ee9d9d[data-theme="dark"], [data-theme="dark"] .lini-scope-e4ee9d9d { color-scheme: dark; }
      .lini-scope-e4ee9d9d[data-theme="light"], [data-theme="light"] .lini-scope-e4ee9d9d { color-scheme: light; }
    }
    .lini-scope-e4ee9d9d, .lini-scope-e4ee9d9d text { font-family: var(--lini-font-family); }
    .lini-scope-e4ee9d9d { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-e4ee9d9d .lini-sketch { fill: var(--lini-fill); stroke: var(--lini-stroke-dark); stroke-width: 2; stroke-dasharray: none; }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-sketch" data-id="n" transform="translate(0,0)">
      <path d="M 0 -34 A 34 34 0 0 1 34 0 L 34 25 A 9 9 0 0 1 16 25 L 16 0 L -16 0 L -16 25 A 9 9 0 0 1 -34 25 L -34 0 A 34 34 0 0 1 0 -34 Z" fill-rule="evenodd"/>
    </g>
    <g class="lini-node lini-sketch" data-id="dots" style="fill: none; stroke: none; stroke-width: 0; opacity: 1" transform="translate(0,0)">
      <g class="lini-node lini-sketch" transform="translate(0,0)">
        <path d="M 110 -90 L 110 -80 A 9 9 0 0 0 128 -80 L 128 -90 A 9 9 0 0 0 110 -90 Z" fill-rule="evenodd"/>
      </g>
      <g class="lini-node lini-sketch" transform="translate(0,30)">
