  <style>
    @layer lini.defaults {
      :root, .lini-scope-9c190447 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke: light-dark(#444, #9aa0a6); --lini-stroke-dark: light-dark(black, white); --lini-text-color: var(--lini-fg); }
      .lini-scope-9c190447[data-theme="dark"], [data-theme="dark"] .lini-scope-9c190447 { color-scheme: dark; }
      .lini-scope-9c190447[data-theme="light"], [data-theme="light"] .lini-scope-9c190447 { color-scheme: light; }
