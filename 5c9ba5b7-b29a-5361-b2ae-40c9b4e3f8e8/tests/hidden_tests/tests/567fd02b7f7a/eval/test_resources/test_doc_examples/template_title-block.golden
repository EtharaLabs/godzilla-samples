<svg xmlns="http://www.w3.org/2000/svg" viewBox="-68.5 -37.5 137 75" width="137" height="75" class="lini lini-scope-e2e8ed70">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-e2e8ed70 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-footer-color: light-dark(rgba(0, 0, 0, 0.5), rgba(255, 255, 255, 0.55)); --lini-group-fill: light-dark(rgba(0, 0, 0, 0.03), rgba(255, 255, 255, 0.05)); --lini-group-stroke: light-dark(rgba(0, 0, 0, 0.4), rgba(255, 255, 255, 0.4)); --lini-header-fill: light-dark(rgba(0, 0, 0, 0.06), rgba(255, 255, 255, 0.08)); --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-e2e8ed70[data-theme="dark"], [data-theme="dark"] .lini-scope-e2e8ed70 { color-scheme: dark; }
      .lini-scope-e2e8ed70[data-theme="light"], [data-theme="light"] .lini-scope-e2e8ed70 { color-scheme: light; }
    }
    .lini-scope-e2e8ed70, .lini-scope-e2e8ed70 text { font-family: var(--lini-font-family); }
    .lini-scope-e2e8ed70 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-e2e8ed70 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-e2e8ed70 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-e2e8ed70 .lini-group { fill: var(--lini-group-fill); stroke: var(--lini-group-stroke); stroke-width: 1; stroke-dasharray: 5,4; }
    .lini-scope-e2e8ed70 .lini-table { fill: none; stroke: var(--lini-stroke); stroke-width: 2; font-size: 14px; font-weight: normal; stroke-dasharray: none; }
    .lini-scope-e2e8ed70 .lini-title-block { stroke-width: 1; font-size: 14px; font-weight: 600; }
    .lini-scope-e2e8ed70 .lini-field { color: var(--lini-footer-color); font-size: 12px; font-weight: normal; }
  </style>
