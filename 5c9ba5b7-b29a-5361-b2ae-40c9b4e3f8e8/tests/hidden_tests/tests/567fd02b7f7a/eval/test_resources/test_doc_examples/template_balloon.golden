<svg xmlns="http://www.w3.org/2000/svg" viewBox="-54.695 -46.5 109.39 93" width="109.39" height="93" class="lini lini-scope-23a0e5a4">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-23a0e5a4 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-23a0e5a4[data-theme="dark"], [data-theme="dark"] .lini-scope-23a0e5a4 { color-scheme: dark; }
      .lini-scope-23a0e5a4[data-theme="light"], [data-theme="light"] .lini-scope-23a0e5a4 { color-scheme: light; }
    }
    .lini-scope-23a0e5a4, .lini-scope-23a0e5a4 text { font-family: var(--lini-font-family); }
    .lini-scope-23a0e5a4 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-23a0e5a4 .lini-oval { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-23a0e5a4 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-23a0e5a4 .lini-balloon { fill: var(--lini-fill); stroke: var(--lini-stroke); font-size: 11px; }
  </style>
