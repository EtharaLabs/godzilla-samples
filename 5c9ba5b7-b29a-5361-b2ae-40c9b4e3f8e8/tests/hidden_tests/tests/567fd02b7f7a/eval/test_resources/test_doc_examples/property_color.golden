<svg xmlns="http://www.w3.org/2000/svg" viewBox="-61.8125 -48.5 123.625 97" width="123.625" height="97" class="lini lini-scope-ec547de2">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-ec547de2 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-sky-ink: light-dark(#00547e, #5ffdff); --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-ec547de2[data-theme="dark"], [data-theme="dark"] .lini-scope-ec547de2 { color-scheme: dark; }
      .lini-scope-ec547de2[data-theme="light"], [data-theme="light"] .lini-scope-ec547de2 { color-scheme: light; }
    }
    .lini-scope-ec547de2, .lini-scope-ec547de2 text { font-family: var(--lini-font-family); }
    .lini-scope-ec547de2 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-ec547de2 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-ec547de2 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-ec547de2 .lini-box { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-box lini-block" style="color: var(--lini-sky-ink)" transform="translate(0,0)">
      <rect x="-40.8125" y="-27.5" width="81.625" height="55" rx="8" ry="8"/>
      <text class="lini-text" x="0" y="0" dy="0.358em">tinted</text>
    </g>
  </g>
  <g class="lini-links"/>
</svg>

