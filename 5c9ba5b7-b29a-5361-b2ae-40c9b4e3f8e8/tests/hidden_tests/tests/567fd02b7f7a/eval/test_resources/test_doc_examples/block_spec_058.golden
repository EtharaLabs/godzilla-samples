    .lini-scope-c750e382 .lini-ext-line { fill: none; stroke: var(--lini-stroke-light); stroke-width: 1; }
    .lini-scope-c750e382 .lini-dim-text { font-size: 12px; font-weight: var(--lini-link-font-weight); }
    .lini-scope-c750e382 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-c750e382 .lini-gutter { stroke: none; }
    .lini-scope-c750e382 .lini-cut-bg { fill: white; stroke: none; }
    .lini-scope-c750e382 .lini-halo { stroke: black; }
