    .lini-scope-c750e382 .lini-page { fill: var(--lini-bg); stroke-width: 0; }
    .lini-scope-c750e382 .lini-title-block { stroke-width: 1; font-size: 14px; font-weight: 600; }
    .lini-scope-c750e382 .lini-field { color: var(--lini-footer-color); font-size: 12px; font-weight: normal; }
    .lini-scope-c750e382 .lini-frame { fill: none; stroke: var(--lini-stroke); stroke-width: 2; }
    .lini-scope-c750e382 .lini-zone { color: var(--lini-stroke-light); font-size: 11px; }
    .lini-scope-c750e382 .lini-tick { fill: none; stroke: var(--lini-stroke); stroke-width: 1; }
    .lini-scope-c750e382 .lini-marker { fill: var(--lini-stroke); stroke: none; }
    .lini-scope-c750e382 .lini-marker-dim { fill: var(--lini-stroke-dark); }
