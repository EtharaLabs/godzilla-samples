    .lini-scope-c750e382 .lini-group { fill: var(--lini-group-fill); stroke: var(--lini-group-stroke); stroke-width: 1; stroke-dasharray: 5,4; }
    .lini-scope-c750e382 .lini-caption { color: var(--lini-caption-color); font-size: 12px; font-weight: var(--lini-caption-font-weight); }
    .lini-scope-c750e382 .lini-footnote { color: var(--lini-footer-color); font-size: 12px; }
