exit: 1
--- stdout
{
  "file": "in.lini",
  "diagnostics": [
    {
      "code": "P000",
      "family": "parse",
      "severity": "error",
      "message": "a link is drawn by an operator — '|-|' only styles links (write 'a -> b')",
      "span": {
        "start": 0,
        "end": 1,
        "line": 1,
        "col": 1,
        "endLine": 1,
        "endCol": 2
      }
    }
  ]
}

--- stderr
