exit: 0
--- stdout
<svg xmlns="http://www.w3.org/2000/svg" viewBox="-25 -25 50 50" width="50" height="50" class="lini lini-scope-dfea5eac">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-dfea5eac { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-text-color: var(--lini-fg); }
      .lini-scope-dfea5eac[data-theme="dark"], [data-theme="dark"] .lini-scope-dfea5eac { color-scheme: dark; }
      .lini-scope-dfea5eac[data-theme="light"], [data-theme="light"] .lini-scope-dfea5eac { color-scheme: light; }
    }
    .lini-scope-dfea5eac, .lini-scope-dfea5eac text { font-family: var(--lini-font-family); }
    .lini-scope-dfea5eac { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-image" transform="translate(0,0)">
    </g>
  </g>
  <g class="lini-links"/>
</svg>

--- stderr
