<svg xmlns="http://www.w3.org/2000/svg" viewBox="-122.5 -119 245 238" width="245" height="238" class="lini lini-scope-ceb66fdc">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-ceb66fdc { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-group-fill: light-dark(rgba(0, 0, 0, 0.03), rgba(255, 255, 255, 0.05)); --lini-group-stroke: light-dark(rgba(0, 0, 0, 0.4), rgba(255, 255, 255, 0.4)); --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-ceb66fdc[data-theme="dark"], [data-theme="dark"] .lini-scope-ceb66fdc { color-scheme: dark; }
      .lini-scope-ceb66fdc[data-theme="light"], [data-theme="light"] .lini-scope-ceb66fdc { color-scheme: light; }
    }
    .lini-scope-ceb66fdc, .lini-scope-ceb66fdc text { font-family: var(--lini-font-family); }
    .lini-scope-ceb66fdc { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-ceb66fdc .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-ceb66fdc .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-ceb66fdc .lini-box { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; }
    .lini-scope-ceb66fdc .lini-group { fill: var(--lini-group-fill); stroke: var(--lini-group-stroke); stroke-width: 1; stroke-dasharray: 5,4; }
  </style>
