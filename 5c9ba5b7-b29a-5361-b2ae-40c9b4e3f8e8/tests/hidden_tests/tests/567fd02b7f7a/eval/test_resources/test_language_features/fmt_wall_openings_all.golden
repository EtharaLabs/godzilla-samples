exit: 0
--- stdout
{
  layout: floorplan; unit: m; scale: 0.02;
}

|wall#o| { draw: move(0, 0) right(8):n down(5):e left(8):s close():w; } [
  |door| { on: n; at: 1; swing: left; }
  |door| { on: e; at: 1; hinge: end; swing: right; }
  |door| { on: s; at: 2; width: 1.6; symbol: double; }
  |window| { on: w; at: 1; width: 2; }
  |door| { on: n; at: 4; symbol: sliding; width: 2; }
]
|stairs| { steps: 10; translate: 5 2; }

o:n (-) o:s { side: right; }

--- stderr
