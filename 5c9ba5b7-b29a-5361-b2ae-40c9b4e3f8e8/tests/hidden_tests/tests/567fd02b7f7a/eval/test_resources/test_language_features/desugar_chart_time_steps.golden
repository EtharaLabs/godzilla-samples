exit: 0
--- stdout
{
  layout: grid; padding: 20; gap: 36; font-size: 15; columns: repeat(2);
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-chart { layout: chart; gap: 15; }
}

|block| .lini-chart.lini-block { width: 240; height: 140; } [
  |block| .lini-axis.lini-block { side: bottom; step: year; }
  |line| .lini-line { data: "2025-11-01" 1, "2026-03-15" 3, "2026-09-10" 2; }
]
|block| .lini-chart.lini-block { width: 240; height: 140; } [
  |block| .lini-axis.lini-block { side: bottom; step: month; }
  |line| .lini-line { data: "2025-11-01" 1, "2026-03-15" 3, "2026-09-10" 2; }
]
|block| .lini-chart.lini-block { width: 240; height: 140; } [
  |block| .lini-axis.lini-block { side: bottom; step: 2 week; }
  |line| .lini-line { data: "2025-11-01" 1, "2026-03-15" 3, "2026-09-10" 2; }
]
|block| .lini-chart.lini-block { width: 240; height: 140; } [
  |block| .lini-axis.lini-block { side: bottom; step: day; }
  |line| .lini-line { data: "2025-11-01" 1, "2026-03-15" 3, "2026-09-10" 2; }
]
|block| .lini-chart.lini-block { width: 240; height: 140; } [
  |block| .lini-axis.lini-block { side: bottom; step: 3 month; }
  |line| .lini-line { data: "2025-11-01" 1, "2026-03-15" 3, "2026-09-10" 2; }
]

--- stderr
