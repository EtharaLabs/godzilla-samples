exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-oval {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-badge {
    pin: top right; translate: 6 -6; radius: 8; padding: 2 6; shadow: 2 3 3; fill: --accent; color: --accent-text; font-size: 11; font-weight: normal;
  }
  .lini-stack { layout: stack; padding: 0; }
}

|block| .lini-stack.lini-block { width: 200; height: 120; px-per-unit: 1; } [
  |block| .lini-box.lini-block { width: 180; height: 100; }
  |block| .lini-badge.lini-block { pin: top right; } [ "new" ]
  |oval| .lini-oval { pin: bottom left; translate: 4 -4; }
  |block| .lini-box.lini-block { pin: center; } [ "c" ]
]

--- stderr
