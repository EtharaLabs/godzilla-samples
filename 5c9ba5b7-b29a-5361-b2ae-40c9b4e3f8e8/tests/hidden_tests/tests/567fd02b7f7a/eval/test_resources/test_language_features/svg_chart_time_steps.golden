    @layer lini.defaults {
      :root, .lini-scope-a8c7a8ed { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-grid: light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.14)); --lini-muted: light-dark(#888, #9aa0a6); --lini-rose-deep: light-dark(#b8476e, #f880a5); --lini-stroke: light-dark(#444, #9aa0a6); --lini-text-color: var(--lini-fg); }
      .lini-scope-a8c7a8ed[data-theme="dark"], [data-theme="dark"] .lini-scope-a8c7a8ed { color-scheme: dark; }
      .lini-scope-a8c7a8ed[data-theme="light"], [data-theme="light"] .lini-scope-a8c7a8ed { color-scheme: light; }
    }
    .lini-scope-a8c7a8ed, .lini-scope-a8c7a8ed text { font-family: var(--lini-font-family); }
    .lini-scope-a8c7a8ed { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-a8c7a8ed .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-a8c7a8ed .lini-line { fill: none; stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-a8c7a8ed .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-a8c7a8ed .lini-chart-text { font-size: 12px; font-weight: normal; }
