exit: 0
--- stdout
{
  layout: schematic; padding: 20; gap: 100; font-size: 15; clearance: 10; fill: --sheet;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-path { fill: --fill; stroke: --stroke; stroke-width: 2; }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-row { direction: row; }
  .lini-column { direction: column; }
  .lini-component {
    fill: --component-fill; stroke: --component-stroke; stroke-width: 1.5; radius: 0; padding: 8; prefix: "U";
  }
  .lini-pin { height: 20; padding: 0; font-size: 11; gap: 0; }
  .lini-label { shape: plain; font-size: 11; color: --label-ink; gap: 4; }
  .lini-junction { fill: --wire; stroke: none; width: 8; }
  .lini-J { prefix: "J"; }
  .lini-gnd { symbol: gnd; }
  .lini-nc { symbol: nc; }
  .lini-sch-line { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-sch-solid { fill: --component-stroke; stroke: none; }
  .lini-sch-tag-line { fill: none; stroke: --label-ink; stroke-width: 1.5; }
  .lini-pin-stub { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-pin-number { color: --pin-number; font-size: 10; }
  .lini-ref { font-size: 12; font-weight: semibold; }
  .lini-part-value { font-size: 12; }
  .lini-tag-flag-right { padding: 2 14 2 6; }
  .lini-tag-flag-both { padding: 2 14; }
  .lini-net-run-turned { height: 40; padding: 4 0; }
}

|block#U1| .lini-component.lini-block { direction: column; gap: 0; } [
  |block| .lini-row.lini-block { gap: 0; align: start; height: 20; } [
    |block#vcc| .lini-pin.lini-block {
      side: top; number: 1; width: 20; height: auto;
    } [
      "vcc"
      |line| .lini-pin-stub.lini-line {
        points: 0 0, 0 20; pin: top; translate: 0 -28;
      }
      |block| .lini-pin-number.lini-block {
        pin: top; translate: 9 -28; height: 20;
      } [ "1" ]
    ]
  ]
  |block| .lini-row.lini-block { gap: 24; align: center; } [
    |block| .lini-column.lini-block { gap: 0; align: start; } [
      |block#rst| .lini-pin.lini-block { side: left; number: 4; } [
        "rst"
        |line| .lini-pin-stub.lini-line {
          points: 0 0, 20 0; pin: left; translate: -28 0;
        }
        |block| .lini-pin-number.lini-block {
          pin: left; translate: -28 -9; width: 20;
        } [ "4" ]
      ]
    ]
    |block| .lini-column.lini-block { gap: 0; align: end; } [
      |block#io| .lini-pin.lini-block { side: right; number: 3; } [
        "io"
        |line| .lini-pin-stub.lini-line {
          points: 0 0, 20 0; pin: right; translate: 28 0;
        }
        |block| .lini-pin-number.lini-block {
          pin: right; translate: 28 -9; width: 20;
        } [ "3" ]
      ]
    ]
  ]
  |block| .lini-row.lini-block { gap: 0; align: end; height: 20; } [
    |block#gnd| .lini-pin.lini-block {
      side: bottom; number: 2; width: 20; height: auto;
    } [
      "gnd"
      |line| .lini-pin-stub.lini-line {
        points: 0 0, 0 20; pin: bottom; translate: 0 28;
      }
      |block| .lini-pin-number.lini-block {
        pin: bottom; translate: 9 28; height: 20;
      } [ "2" ]
    ]
  ]
  |block| .lini-part-value.lini-block { pin: top; translate: 0 -40; } [ "MCU" ]
  |block| .lini-ref.lini-block { pin: top; translate: 0 -56; } [ "U1" ]
]
|block#R1| .lini-R.lini-block.lini-pose-90 [
  |path| .lini-sch-line.lini-path {
    path: "M 12 0 M 0 64 M 6 0 L 6 16 M 12 16 L 12 48 L 0 48 L 0 16 Z M 6 48 L 6 64";
  }
  |block| .lini-part-value.lini-block { pin: center; translate: 24 8; } [
    "10k"
  ]
  |block#p1| .lini-block { pin: center; translate: 0 -32; }
  |block#p2| .lini-block { pin: center; translate: 0 32; }
  |block| .lini-ref.lini-block { pin: center; translate: 24 -8; } [ "R1" ]
]
|block#C1| .lini-C.lini-block.lini-pose-90 [
  |path| .lini-sch-line.lini-path {
    path: "M 24 0 M 0 64 M 12 0 L 12 29 M 12 35 L 12 64";
  }
  |path| .lini-sch-solid.lini-path {
    path: "M 24 0 M 0 64 M 24 27.5 L 24 30.5 L 0 30.5 L 0 27.5 Z M 24 33.5 L 24 36.5 L 0 36.5 L 0 33.5 Z"; pin: center;
  }
  |block| .lini-part-value.lini-block { pin: center; translate: 24 8; } [
    "100n"
  ]
  |block#p1| .lini-block { pin: center; translate: 0 -32; }
  |block#p2| .lini-block { pin: center; translate: 0 32; }
  |block| .lini-ref.lini-block { pin: center; translate: 24 -8; } [ "C1" ]
]
|block#D1| .lini-LED.lini-block.lini-pose-90 [
  |path| .lini-sch-line.lini-path {
    path: "M 28 0 M 0 64 M 14 0 L 14 24 M 22 24 L 14 40 L 6 24 Z M 22 40 L 6 40 M 14 40 L 14 64 M 22 28 L 28 34 M 25 34 L 28 34 L 28 31 M 20 36 L 26 42 M 23 42 L 26 42 L 26 39";
  }
  |block#a| .lini-block { pin: center; translate: 0 -32; }
  |block#k| .lini-block { pin: center; translate: 0 32; }
  |block| .lini-ref.lini-block { pin: center; translate: 24 -8; } [ "D1" ]
]
|block#G1| .lini-gnd.lini-label.lini-block { direction: row; } [
  |path| .lini-sch-tag-line.lini-path {
    path: "M 0 0 M 16 15 M 8 0 L 8 6 M 0 6 L 16 6 M 1 6 L 8 15 L 15 6";
  }
]
|block#J1| .lini-J.lini-component.lini-block {
  pins: 3; direction: column; gap: 0;
} [
  |block| .lini-column.lini-block { gap: 0; align: start; } [
    |block#p1| .lini-pin.lini-block { number: 1; side: left; } [
      |line| .lini-pin-stub.lini-line {
        points: 0 0, 20 0; pin: left; translate: -28 0;
      }
      |block| .lini-pin-number.lini-block {
        pin: left; translate: -28 -9; width: 20;
      } [ "1" ]
    ]
    |block#p2| .lini-pin.lini-block { number: 2; side: left; } [
      |line| .lini-pin-stub.lini-line {
        points: 0 0, 20 0; pin: left; translate: -28 0;
      }
      |block| .lini-pin-number.lini-block {
        pin: left; translate: -28 -9; width: 20;
      } [ "2" ]
    ]
    |block#p3| .lini-pin.lini-block { number: 3; side: left; } [
      |line| .lini-pin-stub.lini-line {
        points: 0 0, 20 0; pin: left; translate: -28 0;
      }
      |block| .lini-pin-number.lini-block {
        pin: left; translate: -28 -9; width: 20;
      } [ "3" ]
    ]
  ]
  |block| .lini-ref.lini-block { pin: top; translate: 0 -36; } [ "J1" ]
]
U1.vcc - lini-label-1
|block#lini-label-1| .lini-net-run-turned.lini-label.lini-block.lini-pose-90 [
  "3V3"
]
U1.gnd - G1
U1.io - R1.p1
R1.p2 - D1.a
D1.k - lini-cap-1
|block#lini-cap-1| .lini-gnd.lini-label.lini-block { direction: row; } [
  |path| .lini-sch-tag-line.lini-path {
    path: "M 0 0 M 16 15 M 8 0 L 8 6 M 0 6 L 16 6 M 1 6 L 8 15 L 15 6";
  }
]
U1.rst - C1.p1
C1.p2 - lini-cap-2
|block#lini-cap-2| .lini-gnd.lini-label.lini-block { direction: row; } [
  |path| .lini-sch-tag-line.lini-path {
    path: "M 0 0 M 16 15 M 8 0 L 8 6 M 0 6 L 16 6 M 1 6 L 8 15 L 15 6";
  }
]
J1.p1 - lini-label-2
|block#lini-label-2| .lini-tag-flag-right.lini-label.lini-block {
  shape: right;
} [
  |path| .lini-sch-tag-line.lini-path {
    chrome: tag right; pin: center; path: "M 0 0";
  }
  "TX"
]
J1.p2 - lini-label-3
|block#lini-label-3| .lini-tag-flag-both.lini-label.lini-block { shape: both; } [
  |path| .lini-sch-tag-line.lini-path {
    chrome: tag both; pin: center; path: "M 0 0";
  }
  "RX"
]
J1.p3 - lini-cap-3
|block#lini-cap-3| .lini-nc.lini-label.lini-block.lini-pose-180 {
  direction: row;
} [
  |path| .lini-sch-tag-line.lini-path {
    path: "M 12 10 M 0 0 M 12 5 L 4 5 M 8 9 L 0 1 M 0 9 L 8 1";
  }
]

--- stderr
