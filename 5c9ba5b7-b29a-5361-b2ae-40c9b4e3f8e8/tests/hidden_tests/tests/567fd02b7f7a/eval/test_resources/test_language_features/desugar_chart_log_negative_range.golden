exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-chart { layout: chart; gap: 15; }
  .lini-bars { radius: 2; stroke: auto; }
}

|block| .lini-chart.lini-block {
  width: 300; height: 200; categories: "a", "b", "c";
} [
  |block| .lini-axis.lini-block { side: left; scale: log; range: 1 auto; }
  |block| .lini-axis.lini-block { side: right; range: -10 0; }
  |block| .lini-bars.lini-block { data: 3, 300, 30000; }
  |line| .lini-line { data: -5, -2, -8; axis: 2; }
]

--- stderr
