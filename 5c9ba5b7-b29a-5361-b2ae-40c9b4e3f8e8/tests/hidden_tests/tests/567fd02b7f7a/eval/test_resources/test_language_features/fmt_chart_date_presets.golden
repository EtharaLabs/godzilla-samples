exit: 0
--- stdout
{
  layout: grid; columns: repeat(2);
}

|chart| { width: 240; height: 140; } [
  |axis| { side: bottom; format: year; }
  |line| {
    data: "2026-01-01T00:00Z" 1, "2026-01-03T12:30Z" 3, "2026-02-10T06:00Z" 2;
  }
]
|chart| { width: 240; height: 140; } [
  |axis| { side: bottom; format: month; }
  |line| {
    data: "2026-01-01T00:00Z" 1, "2026-01-03T12:30Z" 3, "2026-02-10T06:00Z" 2;
  }
]
|chart| { width: 240; height: 140; } [
  |axis| { side: bottom; format: day; }
  |line| {
    data: "2026-01-01T00:00Z" 1, "2026-01-03T12:30Z" 3, "2026-02-10T06:00Z" 2;
  }
]
|chart| { width: 240; height: 140; } [
  |axis| { side: bottom; format: hour; }
  |line| {
    data: "2026-01-01T00:00Z" 1, "2026-01-03T12:30Z" 3, "2026-02-10T06:00Z" 2;
  }
]
|chart| { width: 240; height: 140; } [
  |axis| { side: bottom; format: minute; }
  |line| {
    data: "2026-01-01T00:00Z" 1, "2026-01-03T12:30Z" 3, "2026-02-10T06:00Z" 2;
  }
]

