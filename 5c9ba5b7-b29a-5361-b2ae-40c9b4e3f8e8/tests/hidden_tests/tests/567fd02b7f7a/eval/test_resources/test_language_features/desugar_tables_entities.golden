exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-table {
    layout: grid; align: stretch; justify: stretch; gap: 1; gap-fill: --stroke; padding: 0; fill: none; stroke: --stroke; stroke-width: 2; stroke-style: solid; font-size: 14; font-weight: normal; scale: 1;
  }
  .lini-cell { padding: 4 8; }
  .lini-header { fill: --header-fill; font-weight: semibold; }
  .lini-footer { color: --footer-color; }
  .lini-entity { columns: auto, auto; }
  .lini-align-start { align: start; }
  .lini-align-end { align: end; }
  .lini-justify-start { justify: start; }
  .lini-justify-end { justify: end; }
}

|block| .lini-table.lini-group.lini-block { columns: auto, 60, auto; } [
  |block| .lini-header.lini-cell.lini-block [ "Name" "Qty" "Note" ]
  |block| .lini-cell.lini-block [ "Apple" ]
  |block| .lini-cell.lini-block [ "3" ]
  |block| .lini-cell.lini-block [ "red" ]
  |block| .lini-cell.lini-block [
    "Kiwi" { color: --green-ink; }
  ]
  |block| .lini-cell.lini-block [ "12" ]
  |block| .lini-cell.lini-block [ "green" ]
  |block| .lini-footer.lini-cell.lini-block [ "Total" "15" "" ]
]
|block#u| .lini-entity.lini-table.lini-group.lini-block [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "users" ]
  |block| .lini-cell.lini-block [ "id" ]
  |block| .lini-cell.lini-block [
    "int" { font-weight: bold; }
  ]
  |block| .lini-cell.lini-block [ "name" ]
  |block| .lini-cell.lini-block [ "text" ]
]
|block#o| .lini-entity.lini-table.lini-group.lini-block [
  |block| .lini-header.lini-cell.lini-block { cell: 1 1; } [ "orders" ]
  |block| .lini-cell.lini-block [ "id" ]
  |block| .lini-cell.lini-block [ "int" ]
  |block| .lini-cell.lini-block [ "user_id" ]
  |block| .lini-cell.lini-block [ "int" ]
]

o:left -o< u:right

--- stderr
