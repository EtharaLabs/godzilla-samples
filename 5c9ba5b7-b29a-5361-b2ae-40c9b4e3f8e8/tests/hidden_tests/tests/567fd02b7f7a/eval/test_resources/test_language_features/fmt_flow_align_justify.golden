exit: 0
--- stdout
{
  direction: column;
}

|row| { align: start; justify: start; width: 300; height: 80; } [
  |box| "a"
  |box| { height: 50; }
  |oval| "c"
]
|row| { align: center; justify: center; width: 300; height: 80; } [
  |box| "a"
  |box| { height: 50; }
  |oval| "c"
]
|row| { align: end; justify: end; width: 300; height: 80; } [
  |box| "a"
  |box| { height: 50; }
  |oval| "c"
]
|row| { align: stretch; justify: space-between; width: 300; height: 80; } [
  |box| "a"
  |box| { height: 50; }
  |oval| "c"
]
|row| { align: baseline; justify: space-around; width: 300; height: 80; } [
  |box| "a"
  |box| { height: 50; }
  |oval| "c"
]
|row| { align: center; justify: space-evenly; width: 300; height: 80; } [
  |box| "a"
  |box| { height: 50; }
  |oval| "c"
]

--- stderr
