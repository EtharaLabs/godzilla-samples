exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 120; font-size: 15; direction: row;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
}

|block#a| .lini-box.lini-block
|block#b| .lini-box.lini-block

a -> b { along: 0.1, 0.5, 0.9; } [ "start" "mid" "end" ]
a:top -> b:top { along: 0.5; stroke: --red; stroke-width: 3; } [ "over" ]

--- stderr
