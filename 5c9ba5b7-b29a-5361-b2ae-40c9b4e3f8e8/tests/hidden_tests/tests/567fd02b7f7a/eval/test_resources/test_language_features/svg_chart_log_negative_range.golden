      .lini-scope-eca5e18d[data-theme="dark"], [data-theme="dark"] .lini-scope-eca5e18d { color-scheme: dark; }
      .lini-scope-eca5e18d[data-theme="light"], [data-theme="light"] .lini-scope-eca5e18d { color-scheme: light; }
    }
    .lini-scope-eca5e18d, .lini-scope-eca5e18d text { font-family: var(--lini-font-family); }
    .lini-scope-eca5e18d { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
