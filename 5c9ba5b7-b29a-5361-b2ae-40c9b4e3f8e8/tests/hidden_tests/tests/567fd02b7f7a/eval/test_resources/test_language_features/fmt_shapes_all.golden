exit: 0
--- stdout
|row| [
  |box| "box"
  |rect| "rect"
  |oval| "oval"
  |hex| "hex"
  |slant| "slant"
  |cyl| "cyl"
  |diamond| "dia"
  |note| "note"
  |badge| "b"
  |line| { points: 0 0, 20 10, 40 0; radius: 4; }
  |poly| { points: 0 0, 20 0, 10 15; }
  |path| { path: "M0 0 L10 10 L20 0 Z"; }
]

--- stderr
