      .lini-scope-ef5c49cc[data-theme="dark"], [data-theme="dark"] .lini-scope-ef5c49cc { color-scheme: dark; }
      .lini-scope-ef5c49cc[data-theme="light"], [data-theme="light"] .lini-scope-ef5c49cc { color-scheme: light; }
