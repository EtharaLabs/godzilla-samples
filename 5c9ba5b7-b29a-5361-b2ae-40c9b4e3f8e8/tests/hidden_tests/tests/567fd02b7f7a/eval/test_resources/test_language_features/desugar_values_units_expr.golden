exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  --c: oklch(0.6, 0.15, 250);
  base = 8;
  f(n) = (base * n + 2);
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
}

|block| .lini-box.lini-block {
  width: f(5); height: (base * 6); padding: (base / 2) base; radius: max(2, min(10, 4)); fill: --c; opacity: (0.5 + 0.25);
}
|block| .lini-box.lini-block {
  width: (round(12.6) + floor(1.9)); height: (sqrt(1600)); rotate: (cos(0) * 45);
}
|block| .lini-box.lini-block {
  width: (2 ^ 5); height: (10 / 4 + 40); rotate: (abs(-10));
}

--- stderr
