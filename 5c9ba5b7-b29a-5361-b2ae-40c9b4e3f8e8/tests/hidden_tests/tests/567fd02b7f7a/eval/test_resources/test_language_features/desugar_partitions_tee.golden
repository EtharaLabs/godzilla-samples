exit: 0
--- stdout
{
  layout: floorplan; padding: 20; font-size: 15; unit: m; scale: 0.02; px-per-unit: 4000;
  .lini-sketch { fill: --fill; stroke: --stroke-dark; stroke-width: 2; }
  .lini-wall { fill: --stroke-dark; stroke: none; }
}

|sketch#o| .lini-wall.lini-sketch {
  draw: move(0, 0) right(6):n down(4):e left(6):s close():w;
  wall-thickness: 0.2;
}
|sketch| .lini-partition.lini-wall.lini-sketch {
  draw: move(3, 0) down(4);
  wall-thickness: 0.1;
}
|sketch| .lini-partition.lini-wall.lini-sketch {
  draw: move(0, 2) right(3);
  wall-thickness: 0.1;
}

--- stderr
