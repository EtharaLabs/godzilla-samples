      .lini-scope-9b42fb5d[data-theme="light"], [data-theme="light"] .lini-scope-9b42fb5d { color-scheme: light; }
    }
    .lini-scope-9b42fb5d, .lini-scope-9b42fb5d text { font-family: var(--lini-font-family); }
    .lini-scope-9b42fb5d { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-9b42fb5d .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-9b42fb5d .lini-line { fill: none; stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-9b42fb5d .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-9b42fb5d .lini-chart-text { font-size: 12px; font-weight: normal; }
    .lini-scope-9b42fb5d .lini-chart-tip { visibility: hidden; pointer-events: none; }
