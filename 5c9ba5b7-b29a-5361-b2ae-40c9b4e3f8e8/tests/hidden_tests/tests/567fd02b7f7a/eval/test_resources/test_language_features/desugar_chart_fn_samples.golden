exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  f(k) = (sin(x * k) * exp(-x / 5));
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-chart { layout: chart; gap: 15; }
}

|block| .lini-chart.lini-block { width: 300; height: 200; samples: 30; } [
  |block| .lini-axis.lini-block { side: bottom; range: 0 10; }
  |line| .lini-line { fn: f(1); }
  |line| .lini-line { fn: f(2); stroke-style: dotted; }
  |block| .lini-area.lini-block { fn: (abs(cos(x))); }
]

--- stderr
