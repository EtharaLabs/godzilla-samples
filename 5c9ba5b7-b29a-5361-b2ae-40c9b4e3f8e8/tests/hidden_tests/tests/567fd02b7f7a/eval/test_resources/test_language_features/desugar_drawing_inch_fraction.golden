exit: 0
--- stdout
{
  layout: drawing; padding: 20; font-size: 15; unit: in; px-per-unit: 101.6;
  .lini-sketch { fill: --fill; stroke: --stroke-dark; stroke-width: 2; }
}

|sketch#s| .lini-sketch {
  draw: move(0, 0) right(2.375) up(1.5) left(2.375) close();
}

s:left (-) s:right { format: fraction 16; }

--- stderr
