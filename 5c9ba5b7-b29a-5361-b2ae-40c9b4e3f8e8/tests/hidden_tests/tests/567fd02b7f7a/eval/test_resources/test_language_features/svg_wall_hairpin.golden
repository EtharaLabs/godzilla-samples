<svg xmlns="http://www.w3.org/2000/svg" viewBox="-20 -28 368 80" width="368" height="80" class="lini lini-scope-cbeea9f5">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-cbeea9f5 { color-scheme: light dark; --lini-fg: light-dark(black, #e8e8ea); --lini-fill: light-dark(white, #26262b); --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke-dark: light-dark(black, white); --lini-text-color: var(--lini-fg); }
      .lini-scope-cbeea9f5[data-theme="dark"], [data-theme="dark"] .lini-scope-cbeea9f5 { color-scheme: dark; }
      .lini-scope-cbeea9f5[data-theme="light"], [data-theme="light"] .lini-scope-cbeea9f5 { color-scheme: light; }
    }
    .lini-scope-cbeea9f5, .lini-scope-cbeea9f5 text { font-family: var(--lini-font-family); }
    .lini-scope-cbeea9f5 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-cbeea9f5 .lini-sketch { fill: var(--lini-fill); stroke: var(--lini-stroke-dark); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-cbeea9f5 .lini-wall { fill: var(--lini-stroke-dark); stroke: none; }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-wall lini-sketch" transform="translate(0,0)">
      <path d="M 0 -8 L 328 -8 L 328 32 L 0 32 L 0 16 L 312 16 L 312 8 L 0 8 Z" fill-rule="evenodd"/>
    </g>
  </g>
  <g class="lini-links"/>
</svg>

