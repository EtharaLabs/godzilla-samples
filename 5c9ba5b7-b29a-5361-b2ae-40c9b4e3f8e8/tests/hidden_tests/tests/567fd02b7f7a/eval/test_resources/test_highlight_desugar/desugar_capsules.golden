exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-cyl {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
}

|block#cat| .lini-box.lini-block [ "cat" ]
cat -> db { along: 0.5; } [ "watches" ]
|cyl#db| .lini-cyl
|block#a| .lini-box.lini-block [ "a" ]
a -> lini-cap-1
lini-cap-1 -> c
|block#lini-cap-1| .lini-box.lini-block
|block#c| .lini-box.lini-block [ "c" ]

--- stderr
