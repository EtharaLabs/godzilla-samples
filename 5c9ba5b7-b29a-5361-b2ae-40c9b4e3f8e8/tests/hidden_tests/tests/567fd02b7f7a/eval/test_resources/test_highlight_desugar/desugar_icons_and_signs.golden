exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  .lini-icon {
    fill: --icon-fill; stroke: --stroke; stroke-width: 2; width: 32; height: 32;
  }
  .lini-sign {
    width: 64; height: 64; padding: 4; stroke-width: 2; fit: contain;
  }
}

|icon| .lini-icon { symbol: star; }
|icon| .lini-sign.lini-icon { symbol: warning; } [ "Hot" ]

--- stderr
