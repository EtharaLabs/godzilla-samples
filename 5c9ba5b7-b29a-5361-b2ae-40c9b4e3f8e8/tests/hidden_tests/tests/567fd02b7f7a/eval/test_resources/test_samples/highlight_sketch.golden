exit: 0
--- stdout
<span class="lini-tok-comment">// The sketch pen [SPEC 15.3] as a specimen board — nine captioned tiles, one</span>
<span class="lini-tok-comment">// feature each. Corner modifiers (`chamfer` / `fillet`) and an even-odd</span>
<span class="lini-tok-comment">// `circle()` bore; `angle(deg, n)`'s bearing — 0 up, clockwise — walked round a</span>
<span class="lini-tok-comment">// hexagon in 60° steps, the sixth edge left to `close()`; the two-point</span>
<span class="lini-tok-comment">// `arc(dx, dy, r)` at its tightest legal radius, `r` exactly half the chord.</span>
<span class="lini-tok-comment">// Both readings of `mirror:`: an open subpath **fuses** end-to-end and generates</span>
<span class="lini-tok-comment">// its axis `|centerline|`, a closed one is **duplicated**. `pattern:`</span>
<span class="lini-tok-comment">// [SPEC 15.4] in both forms — `grid()` located by its first hole, `radial()` by</span>
<span class="lini-tok-comment">// the ring centre, which generates its `|pitch-circle|`. The line conventions</span>
<span class="lini-tok-comment">// [SPEC 15.7]: a dashed `|hidden|` cut, a manual `|centerline|` overhanging the</span>
<span class="lini-tok-comment">// profile, `stroke-style: phantom` for an alternate position. What repeats</span>
<span class="lini-tok-comment">// states once — `|view::drawing| { scale: 0.5 }` is the 1 : 2 ratio for all</span>
<span class="lini-tok-comment">// nine, `|arm::sketch|` the curve both positions wear — and `justify: end`</span>
<span class="lini-tok-comment">// bottoms every tile in its row, so the captions share a baseline. Lini's own</span>
<span class="lini-tok-comment">// wordmark drew this pen's first showcase; it lives in `logo.lini` now.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">grid</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">columns</span><span class="lini-tok-punct">:</span> <span class="lini-tok-type">repeat</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">30</span> <span class="lini-tok-number">34</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">justify</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">end</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">;</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">tile</span><span class="lini-tok-op">::</span><span class="lini-tok-type">column</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">10</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">cap</span><span class="lini-tok-op">::</span><span class="lini-tok-type">block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--muted</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">view</span><span class="lini-tok-op">::</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">arm</span><span class="lini-tok-op">::</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-30</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">8</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">16</span><span class="lini-tok-punct">)</span> curve<span class="lini-tok-punct">(</span><span class="lini-tok-number">10</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">14</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-14</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">26</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-16</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">18</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">none</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type-user">tile</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">view</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">plate</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
