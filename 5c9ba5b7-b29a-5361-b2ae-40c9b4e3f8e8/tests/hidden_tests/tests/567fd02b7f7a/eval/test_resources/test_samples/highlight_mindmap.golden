exit: 0
--- stdout
<span class="lini-tok-comment">// The mindmap preset [SPEC 8/12]: `|mindmap|` is the visible root topic and</span>
<span class="lini-tok-comment">// bundles `layout: tree; direction: bilateral; routing: natural`, the palette</span>
<span class="lini-tok-comment">// walk (one hue per first-level branch — red and grey skipped), the</span>
<span class="lini-tok-comment">// `.lini-level-N` depth ramp, and `max-width: 160` topic wrap. Branch wires</span>
<span class="lini-tok-comment">// are desugar-generated, so `lini desugar` prints them like any other link.</span>

<span class="lini-tok-punct">{</span>
  <span class="lini-tok-comment">// A topic stacks its card content by default [SPEC 11]; here the icon reads</span>
  <span class="lini-tok-comment">// as part of the title, so each branch card stays one line tall and the tier</span>
  <span class="lini-tok-comment">// sits level whether or not it carries a glyph.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">topic</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">row</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">mindmap</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Product Vision&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">16</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
