exit: 0
--- stdout
{
  layout: flow; padding: 0; gap: 36; font-size: 15; density: 5.5;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-path { fill: --fill; stroke: --stroke; stroke-width: 2; }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-rect { radius: 0; }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-caption {
    pin: top left; translate: 0 -20; color: --caption-color; font-scale: 12 15; font-weight: --caption-font-weight;
  }
  .lini-sheet-caption {
    translate: 10 10; font-scale: 16 15; font-weight: semibold;
  }
  .lini-row { direction: row; }
  .lini-column { direction: column; }
  .lini-table {
    layout: grid; align: stretch; justify: stretch; gap: 1; gap-fill: --stroke; padding: 0; fill: none; stroke: --stroke; stroke-width: 2; stroke-style: solid; font-size: 14; font-weight: normal; scale: 1;
  }
  .lini-cell { padding: 4 8; }
  .lini-header { fill: --header-fill; font-weight: semibold; }
  .lini-page { fill: --bg; stroke-width: 0; width: 210; height: 297; }
  .lini-title-block {
    font-size: 14; font-weight: semibold; stroke-width: 1; radius: 0;
  }
  .lini-field { font-size: 12; font-weight: normal; color: --footer-color; }
  .lini-frame { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-zone { font-size: 11; color: --stroke-light; }
  .lini-tick { stroke: --stroke; stroke-width: 1; fill: none; }
  .lini-component {
    fill: --component-fill; stroke: --component-stroke; stroke-width: 1.5; radius: 0; padding: 8; prefix: "U";
  }
  .lini-pin { height: 20; padding: 0; font-size: 11; gap: 0; }
  .lini-label { shape: plain; font-size: 11; color: --label-ink; gap: 4; }
  .lini-junction { fill: --wire; stroke: none; width: 8; }
  .lini-J { prefix: "J"; }
  .lini-opamp { fill: none; stroke: none; prefix: "U"; }
  .lini-gnd { symbol: gnd; }
  .lini-v24 { symbol: power; }
  .lini-v5 { symbol: power; }
  .lini-v3 { symbol: power; }
  .lini-region { layout: schematic; }
  .lini-align-start { align: start; }
  .lini-align-end { align: end; }
  .lini-justify-start { justify: start; }
  .lini-justify-end { justify: end; }
  .lini-sch-line { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-sch-solid { fill: --component-stroke; stroke: none; }
  .lini-sch-tag-line { fill: none; stroke: --label-ink; stroke-width: 1.5; }
  .lini-pin-stub { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-pin-number { color: --pin-number; font-size: 10; }
  .lini-ref { font-size: 12; font-weight: semibold; }
  .lini-part-value { font-size: 12; }
  .lini-net-run { width: 40; padding: 0 4; }
  .lini-net-run-turned { height: 40; padding: 4 0; }
}

|block| .lini-page.lini-block {
  width: 420; height: 297; layout: grid; columns: 680, 790, 610; rows: 460, 440, 500; padding: 0; gap: 24; align: stretch; justify: stretch; px-per-unit: 5.5;
} [
  |block#entry| .lini-region.lini-group.lini-block {
    gap: 100; clearance: 10; cell: 1 1;
  } [
    |block| .lini-sheet-caption.lini-caption.lini-block [ "24 V entry" ]
    |block#Q1| .lini-Q.lini-block.lini-pose-180 { symbol: pfet; cell: 2 1; } [
      |path| .lini-sch-line.lini-path {
        path: "M 56 48 M 0 0 M 46 24 A 20 20 180 1 1 6 24 A 20 20 180 1 1 46 24 M 56 24 L 36 24 M 36 34 L 36 14 M 27.5 32 L 12 32 L 12 44 L 0 44 M 27.5 16 L 12 16 L 12 4 L 0 4 M 27.5 24 L 12 24 L 12 16";
      }
      |path| .lini-sch-solid.lini-path {
        path: "M 56 48 M 0 0 M 30.5 34 L 27.5 34 L 27.5 28.7 L 30.5 28.7 Z M 30.5 26.7 L 27.5 26.7 L 27.5 21.3 L 30.5 21.3 Z M 30.5 19.3 L 27.5 19.3 L 27.5 14 L 30.5 14 Z M 19 24 L 28 20.8 L 28 27.2 Z"; pin: center;
      }
      |block| .lini-part-value.lini-block { pin: bottom; translate: 0 20; } [
        "AOD4185"
      ]
      |block#g| .lini-block { pin: center; translate: 28 0; }
      |block#d| .lini-block { pin: center; translate: -28 20; }
      |block#s| .lini-block { pin: center; translate: -28 -20; }
      |block| .lini-ref.lini-block { pin: top; translate: 0 -20; } [ "Q1" ]
    ]
    |block#J1| .lini-J.lini-component.lini-block.lini-mirror-y {
      pins: 2; cell: 1 1; direction: column; gap: 0;
    } [
      |block| .lini-column.lini-block { gap: 0; align: end; padding: 0 0 20 0; } [
        |block#p1| .lini-pin.lini-block { number: 1; side: right; } [
          |line| .lini-pin-stub.lini-line {
            points: 0 0, 20 0; pin: right; translate: 28 0;
          }
          |block| .lini-pin-number.lini-block {
            pin: right; translate: 28 -9; width: 20;
          } [ "1" ]
        ]
        |block#p2| .lini-pin.lini-block { number: 2; side: right; } [
          |line| .lini-pin-stub.lini-line {
            points: 0 0, 20 0; pin: right; translate: 28 0;
          }
          |block| .lini-pin-number.lini-block {
            pin: right; translate: 28 -9; width: 20;
          } [ "2" ]
        ]
      ]
      |block| .lini-part-value.lini-block { pin: top; translate: 0 -20; } [
        "JST XH"
      ]
      |block| .lini-ref.lini-block { pin: top; translate: 0 -36; } [ "J1" ]
    ]
    |block#F1| .lini-F.lini-block [
      |path| .lini-sch-line.lini-path {
        path: "M 0 0 M 64 12 M 0 6 L 64 6 M 16 0 L 48 0 L 48 12 L 16 12 Z";
      }
      |block| .lini-part-value.lini-block { pin: bottom; translate: 0 20; } [
        "2A"
      ]
      |block#p1| .lini-block { pin: center; translate: -32 0; }
      |block#p2| .lini-block { pin: center; translate: 32 0; }
      |block| .lini-ref.lini-block { pin: top; translate: 0 -20; } [ "F1" ]
    ]
    |block#D1| .lini-D.lini-block.lini-pose-270 { symbol: tvs; } [
      |path| .lini-sch-line.lini-path {
        path: "M 0 76 M 16 0 M 8 76 L 8 54 M 0 54 L 8 38 L 16 54 Z M 0 22 L 8 38 L 16 22 Z M 0 35 L 2 38 L 14 38 L 16 41 M 8 22 L 8 0";
      }
      |block| .lini-part-value.lini-block { pin: center; translate: 24 8; } [
        "SMAJ24A"
      ]
      |block#a| .lini-block { pin: center; translate: 0 38; }
      |block#k| .lini-block { pin: center; translate: 0 -38; }
      |block| .lini-ref.lini-block { pin: center; translate: 24 -8; } [ "D1" ]
    ]
    |block#R1| .lini-R.lini-block.lini-pose-90 [
      |path| .lini-sch-line.lini-path {
        path: "M 12 0 M 0 64 M 6 0 L 6 16 M 12 16 L 12 48 L 0 48 L 0 16 Z M 6 48 L 6 64";
      }
      |block| .lini-part-value.lini-block { pin: center; translate: 24 8; } [
        "100k"
      ]
      |block#p1| .lini-block { pin: center; translate: 0 -32; }
      |block#p2| .lini-block { pin: center; translate: 0 32; }
      |block| .lini-ref.lini-block { pin: center; translate: 24 -8; } [ "R1" ]
    ]
    |block#C1| .lini-C.lini-block.lini-pose-90 { symbol: polarized; } [
      |path| .lini-sch-line.lini-path {
        path: "M 32 0 M 0 64 M 16 0 L 16 29 M 28 39 A 18 18 90 0 0 4 39 M 16 37 L 16 64 M 30 6 L 30 12 M 32 9 L 27 9";
      }
      |path| .lini-sch-solid.lini-path {
        path: "M 32 0 M 0 64 M 28 27.5 L 28 30.5 L 4 30.5 L 4 27.5 Z"; pin: center;
      }
      |block| .lini-part-value.lini-block { pin: center; translate: 24 8; } [
        "470u"
      ]
      |block#p1| .lini-block { pin: center; translate: 0 -32; }
      |block#p2| .lini-block { pin: center; translate: 0 32; }
      |block| .lini-ref.lini-block { pin: center; translate: 24 -8; } [ "C1" ]
    ]
    J1.p1 - F1.p1
    F1.p2 - Q1.s
    J1.p2 - lini-cap-1
    |block#lini-cap-1| .lini-gnd.lini-label.lini-block { direction: row; } [
      |path| .lini-sch-tag-line.lini-path {
        path: "M 0 0 M 16 15 M 8 0 L 8 6 M 0 6 L 16 6 M 1 6 L 8 15 L 15 6";
