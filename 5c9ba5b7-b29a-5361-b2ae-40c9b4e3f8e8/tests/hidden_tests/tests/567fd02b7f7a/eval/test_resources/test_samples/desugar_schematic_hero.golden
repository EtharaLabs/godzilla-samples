  |block#ldo| .lini-region.lini-group.lini-block {
    gap: 100; clearance: 10; cell: 3 1;
  } [
    |block| .lini-sheet-caption.lini-caption.lini-block [ "3.3 V rail" ]
    |block#U2| .lini-component.lini-block { direction: column; gap: 0; } [
