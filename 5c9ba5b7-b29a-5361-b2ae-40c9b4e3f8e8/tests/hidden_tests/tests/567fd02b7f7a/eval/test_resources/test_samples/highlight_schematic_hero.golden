    <span class="lini-tok-punct">|</span><span class="lini-tok-type">label</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">pwm</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;FAN_PWM&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">label</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">tach</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;FAN_TACH&quot;</span>

    <span class="lini-tok-comment">// The gate resistor sits in the chain the net name terminates, and the</span>
