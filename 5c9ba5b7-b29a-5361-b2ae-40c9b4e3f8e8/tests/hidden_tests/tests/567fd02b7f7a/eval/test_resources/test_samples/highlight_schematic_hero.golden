    <span class="lini-tok-punct">|</span><span class="lini-tok-type">R</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">R15</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;100k&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">R</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">R16</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;10k&quot;</span>
