exit: 0
--- stdout
{
  layout: schematic; padding: 20; gap: 40; font-size: 15; clearance: 10; fill: --sheet;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-path { fill: --fill; stroke: --stroke; stroke-width: 2; }
  .lini-component {
    fill: --component-fill; stroke: --component-stroke; stroke-width: 1.5; radius: 0; padding: 8; prefix: "U";
  }
  .lini-label { shape: plain; font-size: 11; color: --label-ink; gap: 4; }
  .lini-junction { fill: --wire; stroke: none; width: 8; }
  .lini-opamp { fill: none; stroke: none; prefix: "U"; }
  .lini-gnd { symbol: gnd; }
  .lini-nc { symbol: nc; }
  .lini-head { font-size: 13; color: --muted; padding: 0 8; }
  .lini-sch-line { fill: none; stroke: --component-stroke; stroke-width: 1.5; }
  .lini-sch-solid { fill: --component-stroke; stroke: none; }
  .lini-sch-tag-line { fill: none; stroke: --label-ink; stroke-width: 1.5; }
  .lini-ref { font-size: 12; font-weight: semibold; }
  .lini-part-value { font-size: 12; }
  .lini-tag-outline { stroke: --label-ink; stroke-width: 1.5; padding: 2 6; }
  .lini-tag-round { radius: 99; }
  .lini-tag-flag-left { padding: 2 6 2 14; }
  .lini-tag-flag-right { padding: 2 14 2 6; }
  .lini-tag-flag-both { padding: 2 14; }
  .lini-net-run { width: 40; padding: 0 4; }
}

|block| .lini-head.lini-block { cell: 1 1; } [ "Passives" ]
|block#R1| .lini-R.lini-block { cell: 2 1; } [
  |path| .lini-sch-line.lini-path {
    path: "M 0 0 M 64 12 M 0 6 L 16 6 M 16 0 L 48 0 L 48 12 L 16 12 Z M 48 6 L 64 6";
