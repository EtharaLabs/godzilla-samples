      <span class="lini-tok-comment">// one rigid body: shaft + knob</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">shaft</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
        <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-60</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-10</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">64</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">26</span><span class="lini-tok-punct">)</span>:stub down<span class="lini-tok-punct">(</span><span class="lini-tok-number">20</span><span class="lini-tok-punct">)</span>
              <span class="lini-tok-const">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">26</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">:</span>underside <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">64</span><span class="lini-tok-punct">)</span> close<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
        <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--bg</span><span class="lini-tok-punct">;</span>
        <span class="lini-tok-comment">// a shaft is solid — never sectioned, never hatched</span>
      <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">steel</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">knob</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-7</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-20</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">14</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">40</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">14</span><span class="lini-tok-punct">)</span> close<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      knob<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> || shaft:<span class="lini-tok-keyword">right</span>
    <span class="lini-tok-punct">]</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">centerline</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">points</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-70</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">62</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the bore axis — redrawn over the solid shaft</span>

    bush<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> || housing:<span class="lini-tok-keyword">right</span> { gap: <span class="lini-tok-number">-20</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// pressed 20 into the counterbore — and the counterbore is void, so the</span>
    <span class="lini-tok-comment">// two materials never overlap</span>
    spindle.shaft<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> || housing:<span class="lini-tok-keyword">right</span> { gap: <span class="lini-tok-number">-50</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the shaft runs the full bore; the outer mate reaches into the child</span>
    <span class="lini-tok-comment">// |drawing| by dot-path, and moves it whole</span>

    housing<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> spindle.knob:<span class="lini-tok-keyword">right</span> { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → 114 — the overall length, as seated</span>

    <span class="lini-tok-punct">|</span><span class="lini-tok-type">balloon</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">b1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;1&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-40</span> <span class="lini-tok-number">-70</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">balloon</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">b2</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;2&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span> <span class="lini-tok-number">-70</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">balloon</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">b3</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;3&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">30</span> <span class="lini-tok-number">-70</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">balloon</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">b4</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;4&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">64</span> <span class="lini-tok-number">-70</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    b1 <span class="lini-tok-op">-*</span> <span class="lini-tok-prop-user">housing</span><span class="lini-tok-punct">:</span>boss
    b2 <span class="lini-tok-op">-*</span> <span class="lini-tok-prop-user">bush</span><span class="lini-tok-punct">:</span>face
    b3 <span class="lini-tok-op">-*</span> spindle.<span class="lini-tok-prop-user">shaft</span><span class="lini-tok-punct">:</span>stub
    b4 <span class="lini-tok-op">-*</span> spindle.knob<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">top</span>

    spindle.<span class="lini-tok-prop-user">knob</span><span class="lini-tok-punct">:</span>top-right &lt;- <span class="lini-tok-string">&quot;KNURLED&quot;</span> { side: <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// an arrow leader onto the knob's rim</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">note</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">hint</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;SHIM TO SUIT ON ASSEMBLY&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-96</span> <span class="lini-tok-number">-30</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    hint <span class="lini-tok-op">-&gt;</span> <span class="lini-tok-prop-user">housing</span><span class="lini-tok-punct">:</span>mount
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">table</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bom</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">columns</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">22</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-string">&quot;#&quot;</span> <span class="lini-tok-string">&quot;Part&quot;</span>    <span class="lini-tok-string">&quot;Qty&quot;</span>
    <span class="lini-tok-string">&quot;1&quot;</span> <span class="lini-tok-string">&quot;Housing&quot;</span> <span class="lini-tok-string">&quot;1&quot;</span>
    <span class="lini-tok-string">&quot;2&quot;</span> <span class="lini-tok-string">&quot;Bush&quot;</span>    <span class="lini-tok-string">&quot;1&quot;</span>
