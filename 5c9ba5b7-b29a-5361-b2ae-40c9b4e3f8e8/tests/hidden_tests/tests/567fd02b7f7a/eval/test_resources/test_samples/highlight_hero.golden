  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">store</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">redis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Redis&quot;</span>
