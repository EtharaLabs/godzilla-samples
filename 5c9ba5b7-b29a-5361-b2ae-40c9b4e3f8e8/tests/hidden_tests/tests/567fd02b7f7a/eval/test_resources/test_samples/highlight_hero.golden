  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">edge</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">lb</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">[</span>
