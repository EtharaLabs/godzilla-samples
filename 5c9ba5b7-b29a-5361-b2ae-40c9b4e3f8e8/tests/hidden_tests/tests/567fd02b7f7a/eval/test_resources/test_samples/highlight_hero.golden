  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">data</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">28</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
