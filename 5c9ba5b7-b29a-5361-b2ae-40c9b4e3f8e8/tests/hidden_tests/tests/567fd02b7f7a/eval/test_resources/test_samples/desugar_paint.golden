exit: 0
--- stdout
{
  layout: flow; padding: 26; gap: 26; font-size: 13; direction: column;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-cyl {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-caption {
    pin: top left; translate: 0 -20; color: --caption-color; font-scale: 12 15; font-weight: --caption-font-weight;
  }
  .lini-badge {
    pin: top right; translate: 6 -6; radius: 8; padding: 2 6; shadow: 2 3 3; fill: --accent; color: --accent-text; font-size: 11; font-weight: normal;
  }
  .lini-row { direction: row; }
  .lini-grid { layout: grid; }
  .lini-card { width: 240; height: 70; stroke: none; color: white; }
}

"Paint — gradients, gutters, themes" { font-size: 18; font-weight: bold; }
|block#r1| .lini-row.lini-block { gap: 16; } [
  |block| .lini-card.lini-box.lini-block { fill: gradient(--teal, --blue); } [
    "gradient(--teal, --blue)"
  ]
  |block| .lini-card.lini-box.lini-block {
    fill: gradient(--rose, --amber, --sky);
  } [ "three stops, auto-angled" ]
]
|block#r2| .lini-row.lini-block { gap: 16; } [
  |block| .lini-card.lini-box.lini-block {
    fill: linear-gradient(90, --blue, --purple);
  } [ "linear-gradient(90, …)" ]
  |block| .lini-card.lini-box.lini-block {
    fill: radial-gradient(--purple, --rose);
  } [ "radial-gradient(…)" ]
]
|block#r3| .lini-row.lini-block { gap: 16; } [
  |block| .lini-card.lini-box.lini-block {
    fill: --gray-wash; color: --gray-ink; stroke: gradient(--teal, --purple); stroke-width: 3;
  } [ "gradient on stroke" ]
  |block| .lini-card.lini-box.lini-block {
    fill: gradient(oklch(0.72, 0.16, 25), oklch(0.72, 0.16, 285));
  } [ "oklch stops" ]
]
|block#bands| .lini-row.lini-block { gap: 12; gap-fill: --sky-soft; } [
  |block#a| .lini-box.lini-block {
    fill: --sky-wash; stroke: --sky-ink; color: --sky-ink;
  } [ "one" ]
  |block#b| .lini-box.lini-block {
    fill: --sky-wash; stroke: --sky-ink; color: --sky-ink;
  } [ "two" ]
  |block#c| .lini-box.lini-block {
    fill: --sky-wash; stroke: --sky-ink; color: --sky-ink;
  } [ "three" ]
]
|block#week| .lini-grid.lini-block {
  columns: 80, 80, 80; gap: 8 0; gap-fill: --teal-ink;
} [
  "Mon" "Tue" "Wed"
  "Thu" "Fri" "Sat"
]
|block#service| .lini-group.lini-block { gap: 12; } [
  |block| .lini-caption.lini-block [ "Service" ]
  |block#web| .lini-box.lini-block [
    "Web"
    |block| .lini-badge.lini-block [ "v2" ]
  ]
  |block#api| .lini-box.lini-block [ "API" ]
  |cyl#db| .lini-cyl [ "Postgres" ]
  web -> api
  api -> db { along: 0.5; } [ "query" ]
]

--- stderr
