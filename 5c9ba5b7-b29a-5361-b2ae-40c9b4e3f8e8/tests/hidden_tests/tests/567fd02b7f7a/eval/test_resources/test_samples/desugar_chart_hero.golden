exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-chart { layout: chart; gap: 15; }
  .lini-pie { layout: pie; gap: 15; }
  .lini-bars { radius: 2; stroke: auto; }
  .lini-slice { stroke: auto; }
  .lini-mark { marker: dot; }
}

|block| .lini-block { layout: grid; columns: repeat(2); gap: 36; padding: 5; } [
  |block| .lini-chart.lini-block {
    width: 380; height: 270; categories: "Q1", "Q2", "Q3", "Q4";
  } [
    "Revenue by quarter ($M)"
    |block| .lini-bars.lini-block { data: 12, 19, 15, 25; fill: --orange-soft; } [
      "2023"
    ]
    |block| .lini-bars.lini-block { data: 18, 24, 22, 31; fill: --sky-soft; } [
      "2024"
    ]
  ]
  |block| .lini-chart.lini-block {
    width: 380; height: 270; categories: "Jan", "Feb", "Mar", "Apr", "May", "Jun";
  } [
    "Active users (k)"
    |block#ms| .lini-axis.lini-block { side: left; }
    |block| .lini-mark.lini-block {
      at: 48; axis: ms; stroke: --red; stroke-style: dashed;
    } [ "Goal" ]
    |line| "web" .lini-line {
      data: 16, 18, 22, 28, 35, 42; curve: smooth; marker: dot; stroke: --teal; labels: "", "UI change", "", "", "Redesign", "";
    }
    |line| "app" .lini-line {
      data: 8, 14, 20, 30, 42, 58; curve: smooth; marker: dot; stroke: --purple;
    }
  ]
  |block| .lini-chart.lini-block {
    width: 380; height: 270; direction: radial; categories: "Speed", "Range", "Armor", "Cost", "Stealth", "humor";
  } [
    "Profiles"
    |block| .lini-axis.lini-block { range: 0 6; }
    |block| .lini-area.lini-block {
      data: 3, 4, 5, 5, 4, 4; fill: --green-soft;
    } [ "Cruiser" ]
    |line| "Scout" .lini-line { data: 5, 4, 3, 4, 5, 5; stroke: --rose; }
    |line| "Truck" .lini-line { data: 4, 5, 3, 3, 4, 5; stroke: --blue; }
  ]
  |block| .lini-chart.lini-block { width: 380; height: 270; } [
    "Reactor temperature (°C)"
    |block#t| .lini-axis.lini-block { side: bottom; range: 0 6; }
    |block| .lini-axis.lini-block { side: left; }
    |block| .lini-band.lini-block { range: 0 1.5; axis: t; fill: --sky; } [
      "Warm-up"
    ]
    |block| .lini-band.lini-block { range: 1.5 4; axis: t; fill: --amber; } [
      "Hold"
    ]
    |block| .lini-band.lini-block { range: 4 6; axis: t; fill: --teal; } [
      "Cool"
    ]
    |block| .lini-area.lini-block {
      data: 0 20, 1 120, 2 300, 3 320, 4 260, 5 80; fill: --rose;
    } [ "core" ]
  ]
  |block| .lini-pie.lini-block { width: 380; height: 270; } [
    "Spend by channel"
    |block| .lini-slice.lini-block { value: 40; } [ "Ads" ]
    |block| .lini-slice.lini-block { value: 25; } [ "SEO" ]
    |block| .lini-slice.lini-block { value: 20; } [ "Email" ]
    |block| .lini-slice.lini-block { value: 15; } [ "Direct" ]
  ]
  |block| .lini-chart.lini-block { width: 380; height: 270; } [
    "Markets (share vs. growth)"
    |block| .lini-axis.lini-block { side: bottom; } [ "growth %" ]
    |block| .lini-axis.lini-block { side: left; } [ "share %" ]
    |block| .lini-bubble.lini-block { at: 12 40; value: 8; } [ "EU" ]
    |block| .lini-bubble.lini-block { at: 25 55; value: 20; } [ "US" ]
    |block| .lini-bubble.lini-block { at: 38 30; value: 14; } [ "APAC" ]
    |block| .lini-bubble.lini-block { at: 30 15; value: 6; } [ "LatAm" ]
    |block| .lini-bubble.lini-block { at: 16 22; value: 5; } [ "ME" ]
    |block| .lini-bubble.lini-block { at: 45 48; value: 17; } [ "China" ]
  ]
]

--- stderr
