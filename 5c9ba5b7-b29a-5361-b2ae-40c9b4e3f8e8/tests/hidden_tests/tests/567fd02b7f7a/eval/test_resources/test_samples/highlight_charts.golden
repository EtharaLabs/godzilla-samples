exit: 0
--- stdout
<span class="lini-tok-comment">// Series kinds and per-datum paint [SPEC 14.2, 14.6] — the half of the chart</span>
<span class="lini-tok-comment">// family the hero board doesn't carry: `bars: stacked` laid on its side by</span>
<span class="lini-tok-comment">// `direction: row` and `bars: overlay` stacked front-to-back, `curve: step`</span>
<span class="lini-tok-comment">// against a plain `linear` line with marker-only |dots| scattered over both,</span>
<span class="lini-tok-comment">// an |area| floated on an explicit `baseline:` instead of zero, `fill:` and</span>
<span class="lini-tok-comment">// `stroke:` comma lists pulling one bar and one point out of the walk,</span>
<span class="lini-tok-comment">// `tooltip:` forced on and held back to hover, radial |bars|, the donut's</span>
<span class="lini-tok-comment">// `hole:`.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">grid</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">columns</span><span class="lini-tok-punct">:</span> <span class="lini-tok-type">repeat</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">2</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">36</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Revenue by region ($k)&quot;</span> <span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">row</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">bars</span><span class="lini-tok-punct">:</span> stacked<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">categories</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;Q1&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Q2&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Q3&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Q4&quot;</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">bars</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;NA&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">40</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">45</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">50</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">60</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">bars</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;EU&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">35</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">33</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">40</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">bars</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;APAC&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">20</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">25</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">38</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// Overlay puts v2 in front of v1, so the time saved is the exposed collar; the</span>
<span class="lini-tok-comment">// per-datum `fill:` [SPEC 14.6] flags the stage that didn't get faster, and</span>
<span class="lini-tok-comment">// the deltas ride `labels:` under `tooltip: hover` — read on the point, not</span>
<span class="lini-tok-comment">// printed over the bars.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Deploy time (s)&quot;</span> <span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">bars</span><span class="lini-tok-punct">:</span> overlay<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">tooltip</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">hover</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">categories</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;build&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;test&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;ship&quot;</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">bars</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;v1&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">96</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">154</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">41</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">bars</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;v2&quot;</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">63</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">148</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">38</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-var">--red</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">labels</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;-34%&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;-4%&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;-7%&quot;</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// `tooltip: always` forces every account's overpay onto the plot rather than</span>
<span class="lini-tok-comment">// letting the crowded ones fall to hover — the export setting [SPEC 14.8].</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Plan price vs. usage ($)&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">tooltip</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">always</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;GB transferred&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">40</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;monthly bill&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;list price&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">5</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">10</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">25</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">40</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">curve</span><span class="lini-tok-punct">:</span> step<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;metered&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">40</span> <span class="lini-tok-number">34</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">curve</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">linear</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">dots</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;accounts&quot;</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6</span> <span class="lini-tok-number">5</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">13</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">19</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">29</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">34</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-var">--red</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">,</span> <span class="lini-tok-var">--red-ink</span><span class="lini-tok-punct">,</span> <span class="lini-tok-keyword">auto</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">labels</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;-$0&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;+$1&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;-$4&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&qu