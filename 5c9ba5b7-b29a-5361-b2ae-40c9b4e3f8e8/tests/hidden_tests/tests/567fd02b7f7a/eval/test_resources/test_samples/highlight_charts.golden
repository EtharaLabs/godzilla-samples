<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">m</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">20</span> <span class="lini-tok-number">60</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">mark</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;target&quot;</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">40</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">axis</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">m</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--gray-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke-style</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">dashed</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
