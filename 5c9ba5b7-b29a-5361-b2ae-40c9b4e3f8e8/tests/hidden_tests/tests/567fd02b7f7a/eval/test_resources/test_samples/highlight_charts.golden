<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">100</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">step</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">50</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
