exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 40; font-size: 15; clearance: 12;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-oval {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20; direction: column;
  }
  .lini-caption {
    pin: top left; translate: 0 -20; color: --caption-color; font-scale: 12 15; font-weight: --caption-font-weight;
  }
  .lini-badge {
    pin: top right; translate: 6 -6; radius: 8; padding: 2 6; shadow: 2 3 3; fill: --accent; color: --accent-text; font-size: 11; font-weight: normal;
  }
  .lini-treat { radius: 6; }
  .loud { stroke: --red; }
  .quiet { stroke: --blue; }
  .happy { stroke: --green; }
}

|oval#cat| .lini-oval [ "Cat" ]
|block#kitchen| .lini-group.lini-block [
  |block| .lini-caption.lini-block [ "Kitchen" ]
  |block#bowl| .lini-treat.lini-box.lini-block [ "Bowl" ]
  |block#water| .lini-treat.lini-box.lini-block [ "Water" ]
]
|block#garden| .lini-group.lini-block [
  |block| .lini-caption.lini-block [ "Garden" ]
  |block#dog| .lini-treat.lini-box.lini-block [ "Dog" ]
  |block#bird| .lini-treat.lini-box.lini-block [ "Bird" ]
]
|block#roof| .lini-treat.lini-box.lini-block [
  "Roof"
  |block| .lini-badge.lini-block [ "new" ]
]

cat -> kitchen.bowl & kitchen.water .loud
cat -> roof .loud
kitchen.bowl -> garden.dog .loud { along: 0.35; } [ "X" ]
kitchen.bowl -> garden.dog .loud
kitchen.water <--- garden.dog .quiet
kitchen.water <- garden.dog .quiet
kitchen.water <- garden.dog .quiet
garden.bird -> roof
garden.bird -> roof
kitchen.water <-> garden.bird .quiet
kitchen.water -> roof .happy
kitchen.water -> roof .happy
garden ~> kitchen.bowl .loud

--- stderr
