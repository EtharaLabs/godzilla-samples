exit: 0
--- stdout
<span class="lini-tok-comment">// Turned parts [SPEC 15.3]: two revolved half-profiles on one board. The</span>
<span class="lini-tok-comment">// edge-line law draws every sharp diameter change to its axis twin (shoulders,</span>
<span class="lini-tok-comment">// groove lips, chamfer edges) while tangent fillets draw none; `thread:` adds</span>
<span class="lini-tok-comment">// the ISO minor and thread-end lines; `break:` folds a boring middle out of</span>
<span class="lini-tok-comment">// the view with the measured length still true across it; interior geometry</span>
<span class="lini-tok-comment">// rides a dashed |hidden| child; and a station `⌀` reads the revolved surface</span>
<span class="lini-tok-comment">// doubled about the axis.</span>

<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">column</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">48</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-comment">// two long parts, stacked down the board</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">hidden</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">centerline</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">none</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// a bore's axis — the part's own serves</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-comment">// A 300 mm tie bar with chamfered ends: `thread:` composes the M20×1.5 spec</span>
<span class="lini-tok-comment">// the bare leader calls out, and `break:` cuts the featureless middle.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">tiebar-view</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;TIE BAR&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.75</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">unit</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">mm</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bar</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-150</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">10</span><span class="lini-tok-punct">)</span> chamfer<span class="lini-tok-punct">(</span><span class="lini-tok-number">1.5</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">40</span><span class="lini-tok-punct">)</span>:m20 point<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span>:a <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">260</span><span class="lini-tok-punct">)</span>
          chamfer<span class="lini-tok-punct">(</span><span class="lini-tok-number">1.5</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">10</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-prop">revolve</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">thread</span><span class="lini-tok-punct">:</span> m20 <span class="lini-tok-number">1.5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">break</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-90</span> <span class="lini-tok-number">90</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">hidden</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">centre</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-comment">// the ⌀8 centre bore, drilled 14 deep — the origin sits on the end</span>
      <span class="lini-tok-comment">// face, in the far piece, so the bore rides the break with it</span>
      <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">150</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">10</span><span class="lini-tok-punct">)</span> line<span class="lini-tok-punct">(</span><span class="lini-tok-number">-4</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-4</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-prop">mirror</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>

  bar<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> bar:<span class="lini-tok-keyword">right</span> { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 300 mm — true, across the break</span>
  bar<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> bar:a { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 40 mm — ':a' is a point() station</span>
  <span class="lini-tok-prop-user">bar</span><span class="lini-tok-punct">:</span>m20 <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span> { side: <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">tol</span><span class="lini-tok-punct">:</span> h6<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → ⌀20 h6 — doubled about the axis</span>
  <span class="lini-tok-prop-user">bar</span><span class="lini-tok-punct">:</span>m20 &lt;- { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → M20×1.5 — the thread composes its spec</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// The multi-section barrel — one named profile carries every value: stations</span>
<span class="lini-tok-comment">// chain on one row, ⌀ fits stack at the left in source order, datum A sits on</span>
<span class="lini-tok-comment">// the land, and the patterned M8 holes take a typed thread callout.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">barrel-view</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;BARREL&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">body</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-242.5</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">21</span><span class="lini-tok-punct">)</span> chamfer<span class="lini-tok-punct">(</span><span class="lini-tok-number">1.5</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">38</span><span class="lini-tok-punct">)</span>:m42 point<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span>:tl
          <span class="lini-tok-const">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">32</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">:</span>land up<span class="lini-tok-punct">(</span><span class="lini-tok-number">1.5</span><span class="lini-tok-punct">)</span>:sh1 <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">14</span><span class="lini-tok-punct">)</span>:port down<span class="lini-tok-punct">(</span><span class="lini-tok-number">6</span><span class="lini-tok-punct">)</span>:sh2 fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">2</span><span class="lini-tok-punct">)</span>:r1
          <span class="lini-tok-const">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">10</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">:</span>groove fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">2</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">6</span><span class="lini-tok-punct">)</span>:sh3 <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">10</span><span class="lini-tok-punct">)</span>:collar up<span class="lini-tok-punct">(</span><span class="lini-tok-number">2.5</span><span class="lini-tok-punct">)</span>
          <span class="lini-tok-const">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">381</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">:</span>tube chamfer<span class="lini-tok-punct">(</span><span class="lini-tok-number">1.5</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">25</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-prop">revolve</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">thread</span><span class="lini-tok-punct">:</span> m42 <span class="lini-tok-number">1.5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">break</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-40</span> <span class="lini-tok-number">215</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">hole</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">m8</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">8</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-120</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">pattern</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">grid</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">35</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">thread</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.25</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>

  body<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> body:tl { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 38 — ':tl' is a point() station</span>
  <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>sh1 <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> body:sh2 <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> body:sh3 { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 14 · 10 — a chain seats one row</span>
  body<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> body:<span class="lini-tok-keyword">right</span> { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 485 — true, across the break</span>
  <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>m42 &lt;- { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → M42×1.5</span>
  <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>r1 <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span> { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → R2 — the groove root is tangent, so it draws no edge line; the sharp</span>
  <span class="lini-tok-comment">// lips either side of it do</span>
  <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>land &gt;- <span class="lini-tok-string">&quot;A&quot;</span>
  <span class="lini-tok-comment">// datum A on the ⌀42 land</span>
  <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>land <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span> { tol: h6<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → ⌀42 h6</span>
  <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>collar <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span> { tol: f7<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → ⌀45 f7</span>
  <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>tube <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span> { side: <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → ⌀50</span>
  body.m8 <span class="lini-tok-op">&lt;-</span> <span class="lini-tok-string">&quot;3× M8×1.25, 10 DEEP&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// typed thread callout</span>
<span class="lini-tok-punct">]</span>

--- stderr
