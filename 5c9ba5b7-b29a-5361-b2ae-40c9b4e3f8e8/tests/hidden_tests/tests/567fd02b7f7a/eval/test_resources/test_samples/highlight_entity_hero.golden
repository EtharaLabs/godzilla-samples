user.pk <span class="lini-tok-op">-</span>o&lt; order.user_fk<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span>
<span class="lini-tok-comment">// a user's key appears in zero-or-many orders — both ends name a |cell#id|, so</span>
<span class="lini-tok-comment">// the wire leaves and lands on those rows; `:left` picks the wall it lands on</span>
user <span class="lini-tok-op">-</span>o+ cart
<span class="lini-tok-comment">// a user owns zero-or-one cart</span>
order <span class="lini-tok-op">-</span>+&lt; item<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">right</span>
<span class="lini-tok-comment">// an order contains one-or-many line items</span>
product.pk <span class="lini-tok-op">-</span>o&lt; item.product_fk
<span class="lini-tok-comment">// a product's key appears in zero-or-many line items — a wire anchored to one</span>
<span class="lini-tok-comment">// field leaves each card at that field's row [SPEC 8]; the rest tie card to card</span>
category <span class="lini-tok-op">-</span>o&lt; product
<span class="lini-tok-comment">// a category groups zero-or-many products</span>

