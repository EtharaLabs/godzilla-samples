exit: 0
--- stdout
{
  layout: sequence; padding: 20; gap: 32 32; font-size: 15;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-slant {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; direction: column; gap: 12; skew: 15;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-icon {
    fill: --icon-fill; stroke: --stroke; stroke-width: 2; width: 32; height: 32;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-loop {
    fill: none; stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; radius: 4; padding: 24; font-size: 12;
  }
  .lini-note { fill: --fill; stroke: --stroke; padding: 20; scale: 1; }
  .lini-sequence .lini-note { padding: 6 10; font-size: 13; }
  .lini-drawing .lini-note { padding: 6 10; font-size: 13; }
}

|icon#user| .lini-icon {
  width: 62; stroke: --rose-deep; fill: --rose-wash; symbol: user;
}
|block#shop| .lini-box.lini-block {
  fill: --sky-wash; stroke: --sky-deep; padding: 18;
} [ "Storefront" ]
|block#pay| .lini-box.lini-block {
  fill: --green-wash; stroke: --green-deep; padding: 18;
} [ "Payments" ]
|slant#db| .lini-slant {
  fill: --orange-wash; stroke: --orange-deep; padding: 18;
} [ "Orders" ]
|block| .lini-note.lini-block {
  place: over user; fill: --rose-soft; stroke: --rose-deep;
} [ "starts checkout" ]
user -> shop { along: 0.5; } [ "place order" ]
shop -> pay { along: 0.5; } [ "charge $42" ]
pay -> pay { along: 0.5; } [ "verify card" ]
pay --> shop { along: 0.5; } [ "receipt" ]
|block| .lini-loop.lini-block {
  fill: --purple-wash; stroke: --purple-ink; color: --gray-deep;
} [
  "each item"
  shop -> db { along: 0.5; } [ "reserve stock" ]
  db --> shop { along: 0.5; } [ "in stock" ]
]
shop --> user { along: 0.5; } [ "order #1024" ]
user ~> shop { along: 0.5; } [ "track parcel" ]

--- stderr
