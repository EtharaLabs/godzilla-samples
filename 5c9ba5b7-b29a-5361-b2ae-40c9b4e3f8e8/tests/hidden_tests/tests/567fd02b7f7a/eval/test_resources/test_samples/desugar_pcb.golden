exit: 0
--- stdout
{
  layout: grid; padding: 34; gap: 20; font-size: 12; fill: gradient(#029045, #008046); columns: repeat(5, 80); rows: repeat(5, 60); clearance: 10;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-chip {
    width: 60; height: 60; stroke: none; radius: 5; color: white; padding: 0;
  }
  .lini-pad {
    width: 150; height: 56; stroke: none; fill: --amber-soft; color: --amber-ink;
  }
  .lini-passive {
    width: 54; height: 42; stroke: none; fill: #303030; color: white; radius: 5; padding: 0;
  }
  .lini-link { stroke: #f4c450; stroke-width: 2; }
}

|block#mcu| .lini-chip.lini-box.lini-block {
  cell: 2 2; span: 3 3; width: 180; height: 180; fill: gradient(--blue, --purple); font-size: 24;
} [ "MCU" ]
|block#c1| .lini-passive.lini-box.lini-block { cell: 1 1; } [ "C" ]
|block#usb| .lini-pad.lini-box.lini-block { cell: 2 1; span: 2 1; } [ "USB-C" ]
|block#r1| .lini-passive.lini-box.lini-block { cell: 4 1; } [ "R" ]
|block#rf| .lini-chip.lini-box.lini-block { cell: 5 1; fill: --purple; } [
  "RF"
]
|block#flash| .lini-chip.lini-box.lini-block { cell: 1 2; fill: --indigo; } [
  "FLASH"
]
|block#pwr| .lini-chip.lini-box.lini-block { cell: 1 3; fill: --rose; } [
  "PWR"
]
|block#c2| .lini-passive.lini-box.lini-block { cell: 1 4; } [ "C" ]
|block#osc| .lini-passive.lini-box.lini-block { cell: 5 2; } [ "OSC" ]
|block#motor| .lini-chip.lini-box.lini-block { cell: 5 3; fill: --sky; } [
  "MOTOR"
]
|block#r2| .lini-passive.lini-box.lini-block { cell: 5 4; } [ "R" ]
|block#c3| .lini-passive.lini-box.lini-block { cell: 1 5; } [ "C" ]
|block#adc| .lini-chip.lini-box.lini-block { cell: 2 5; fill: --gray; } [
  "ADC"
]
|block#sens| .lini-chip.lini-box.lini-block { cell: 3 5; fill: --teal; } [
  "SENS"
]
|block#r3| .lini-passive.lini-box.lini-block { cell: 4 5; } [ "R" ]
|block#imu| .lini-chip.lini-box.lini-block {
  cell: 5 5; fill: --amber; color: --amber-ink;
} [ "IMU" ]

usb:bottom - mcu:top
usb:bottom - mcu:top
usb:bottom - mcu:top
usb:bottom - mcu:top
mcu:top - rf:bottom
rf:bottom - r1:bottom
pwr:right - mcu:left
pwr:right - mcu:left
pwr:right - mcu:left
pwr:right - mcu:left
flash:right - mcu:left
flash:right - mcu:left
flash:right - mcu:left
mcu:right - motor:left
mcu:right - motor:left
mcu:right - motor:left
mcu:right - motor:left
osc - motor:top
osc:left - mcu:right
mcu:bottom - sens:top
mcu:bottom - sens:top
mcu:bottom - adc:top
mcu:bottom - adc:top
usb:left - c1:right
pwr:bottom - c2:top
pwr:bottom - c2:top
motor:bottom - r2:top
imu:top - r2:bottom
imu - mcu:right
imu - mcu:right
adc:left - c3:right
adc:left - c3:right
sens - r3:top

--- stderr
