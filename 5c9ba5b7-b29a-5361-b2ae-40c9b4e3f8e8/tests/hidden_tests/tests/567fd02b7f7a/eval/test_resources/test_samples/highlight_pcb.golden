<span class="lini-tok-punct">|</span><span class="lini-tok-type-user">passive</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">c1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;C&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
