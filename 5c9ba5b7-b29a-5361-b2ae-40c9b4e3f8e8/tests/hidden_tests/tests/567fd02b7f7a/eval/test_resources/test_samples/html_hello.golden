<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>lini</title>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="-57.665 -48.5 115.33 97" width="115.33" height="97" class="lini lini-scope-c85fceb4">
  <style>
    @layer lini.defaults {
      :root, .lini-scope-c85fceb4 { --lini-fg: #e8e8ea; --lini-fill: #26262b; --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; --lini-font-weight: 500; --lini-stroke: #9aa0a6; --lini-text-color: var(--lini-fg); }
    }
    .lini-scope-c85fceb4, .lini-scope-c85fceb4 text { font-family: var(--lini-font-family); }
    .lini-scope-c85fceb4 { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-c85fceb4 .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-c85fceb4 .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-c85fceb4 .lini-box { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; }
  </style>
  <defs/>
  <g class="lini-scene">
    <g class="lini-node lini-box lini-block" transform="translate(0,0)">
      <rect x="-36.665" y="-27.5" width="73.33" height="55" rx="8" ry="8"/>
      <text class="lini-text" x="0" y="0" dy="0.358em">hello</text>
    </g>
  </g>
  <g class="lini-links"/>
</svg>
</body>
</html>

