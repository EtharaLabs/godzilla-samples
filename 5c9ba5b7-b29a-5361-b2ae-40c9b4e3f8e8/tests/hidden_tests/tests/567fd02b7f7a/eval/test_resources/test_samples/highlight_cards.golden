<span class="lini-tok-comment">// Proportional type [SPEC 5, 6]: `font-family: &quot;Google Sans&quot;` swaps the scene</span>
<span class="lini-tok-comment">// onto the bundled proportional family — measured from its real per-glyph</span>
<span class="lini-tok-comment">// metrics, so boxes hug their text exactly as in mono. The widened weight set</span>
<span class="lini-tok-comment">// (`medium`, `semibold`, and the numeric 400–700) grades the hierarchy, and</span>
<span class="lini-tok-comment">// `max-width` wraps body copy at its true rendered width.</span>

<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">font-family</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;Google Sans&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">column</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">26</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">15</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// a card stacks by default [SPEC 11]; this only opens the gutter, for</span>
  <span class="lini-tok-comment">// three lines of copy rather than an icon over a word</span>
  <span class="lini-tok-class">.card-title</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">17</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">font-weight</span><span class="lini-tok-punct">:</span> bold<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-class">.card-brief</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">15</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">font-weight</span><span class="lini-tok-punct">:</span> medium<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--teal-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">}</span>

<span class="lini-tok-string">&quot;Pick a plan&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">font-weight</span><span class="lini-tok-punct">:</span> semibold<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">row</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">plans</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">start</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
