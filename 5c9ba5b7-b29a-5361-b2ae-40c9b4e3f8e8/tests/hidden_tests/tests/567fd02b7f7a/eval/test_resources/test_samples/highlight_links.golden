exit: 0
--- stdout
<span class="lini-tok-comment">// Link markers — the arrow / dot / diamond heads and the full ER cardinality</span>
<span class="lini-tok-comment">// set (on any |line| via marker-*, or composed by the crow's-foot operators on</span>
<span class="lini-tok-comment">// either end) — plus template-internal links: a |define| whose body links its own</span>
<span class="lini-tok-comment">// children, so every instance routes itself.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">column</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">24</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">start</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">column</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// one specimen line per marker</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-op">::</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">points</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-70</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">70</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke-width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">port</span><span class="lini-tok-op">::</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--teal-soft</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--teal-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--teal-ink</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>

  <span class="lini-tok-comment">// each |room| materialises its own inlet -&gt; outlet link from the define body</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">room</span><span class="lini-tok-op">::</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">row</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">60</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--teal-wash</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--teal-ink</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">port</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">inlet</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;in&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">port</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">outlet</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;out&quot;</span>
    inlet <span class="lini-tok-op">-&gt;</span> outlet <span class="lini-tok-string">&quot;flows&quot;</span>
  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Markers &amp; internal links&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">18</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">font-weight</span><span class="lini-tok-punct">:</span> bold<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">row</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">44</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">start</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">ends</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;markers&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">20</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">arrow</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-start</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">dot</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">dot</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--green-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">diamond</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--purple-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>
  <span class="lini-tok-comment">// the ER cardinality set — the `[min][max]` glyphs, as marker values</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">cardinality</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;ER cardinality&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">18</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">one</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">crow</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">exactly-one</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--blue-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">zero-or-one</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--blue-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">one-or-many</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--blue-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">spec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">marker-end</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">zero-or-many</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--blue-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">row</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">52</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-comment">// The same set composes from the crow's-foot operators on **either** end</span>
  <span class="lini-tok-comment">// [SPEC 9]: the ring `o` / bar `+` hugs the line, the max glyph (`+` one,</span>
  <span class="lini-tok-comment">// `&lt;`/`&gt;` many) is outer.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">row</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">rel</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">84</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">caption</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;cardinality operators — either end&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">author</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Author&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">book</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Book&quot;</span>
    author +<span class="lini-tok-op">-</span>o&lt; book <span class="lini-tok-string">&quot;writes&quot;</span>
    <span class="lini-tok-comment">// one author → zero-or-many books</span>
  <span class="lini-tok-punct">]</span>
  <span class="lini-tok-comment">// A chain marks every hop [SPEC 9]: `a -&gt; b &lt;-&gt; c` is exactly `a -&gt; b;</span>
  <span class="lini-tok-comment">// b &lt;-&gt; c`, both drawn, each hop carrying its own operator.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">row</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">chains</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">44</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">caption</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;chains — every hop marked&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">relay</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;relay&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">hub</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;hub&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">box</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">sink</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;sink&quot;</span>
    relay <span class="lini-tok-op">-&gt;</span> hub <span class="lini-tok-op">&lt;-&gt;</span> sink
  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">rooms</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;template-internal links&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">row</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">80</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">room</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">garden</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Garden&quot;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">room</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">kitchen</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Kitchen&quot;</span>
<span class="lini-tok-punct">]</span>

rooms.garden.outlet <span class="lini-tok-op">-&gt;</span> rooms.kitchen.inlet <span class="lini-tok-string">&quot;carries&quot;</span>

--- stderr
