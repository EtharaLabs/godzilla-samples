exit: 0
--- stdout
<span class="lini-tok-comment">// Two blocks rebuilt from a real KiCad project, wire for wire — a boost</span>
<span class="lini-tok-comment">// converter and a stepper driver — the forms a working sheet is actually</span>
<span class="lini-tok-comment">// made of: a bridge standing in its first pin's corridor with its return</span>
<span class="lini-tok-comment">// tapped into the line it feeds, a feedback divider tapped by naming the</span>
<span class="lini-tok-comment">// shared pin, net-name runs the traffic continues straight through, three</span>
<span class="lini-tok-comment">// pins tied into one net beside their part, sense shunts sharing a pin with</span>
<span class="lini-tok-comment">// the name that leaves the block, and the no-connect cross [SPEC 16].</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-comment">// `density:` is px per millimetre — screen resolution alone, so the paper</span>
  <span class="lini-tok-comment">// stays true-scale in print [SPEC 15.1]; 7 is what these two blocks need of</span>
  <span class="lini-tok-comment">// an A4, the parts being drawn in sheet px [SPEC 16.6].</span>
  <span class="lini-tok-prop">density</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4.7</span><span class="lini-tok-punct">;</span>

  <span class="lini-tok-comment">// The rails both blocks ride: power flags are one-line defines with</span>
  <span class="lini-tok-comment">// intrinsic text [SPEC 8/16.4], so a chain ending in one grows up out of</span>
  <span class="lini-tok-comment">// the pin it feeds.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">vsys</span><span class="lini-tok-op">::</span><span class="lini-tok-type">label</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> power<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-string">&quot;VSYS&quot;</span>
  <span class="lini-tok-punct">]</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">vm</span><span class="lini-tok-op">::</span><span class="lini-tok-type">label</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> power<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-string">&quot;VM&quot;</span>
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">region</span><span class="lini-tok-op">::</span><span class="lini-tok-type">group</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">schematic</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">60</span> <span class="lini-tok-number">20</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">page</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">sheet</span><span class="lini-tok-punct">:</span> a3 landscape<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">grid</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">padding</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">columns</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">800</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">1000</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">10</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">region</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">boost</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;5.5v Boost&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">component</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">U6</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;TPS61023DRLR&quot;</span> <span class="lini-tok-punct">[</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">VIN</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-comment">// A `|space|` is one empty slot on the rail of the pin before it, and</span>
      <span class="lini-tok-comment">// `span: N` makes it N [SPEC 16.2]: the switch node stands clear of the</span>
      <span class="lini-tok-comment">// input above and the enable below, the way the datasheet groups them,</span>
      <span class="lini-tok-comment">// so the inductor's readouts and the enable's name each keep a row.</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">space</span><span class="lini-tok-punct">|</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">SW</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">space</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">span</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">EN</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">GND</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">VOUT</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-comment">// …and FB stands five slots under VOUT: the room the feedback divider</span>
      <span class="lini-tok-comment">// needs to straddle FB's row, its upper resistor above and the tapped</span>
      <span class="lini-tok-comment">// one below, so the tap comes home dead straight [SPEC 16.1].</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">space</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">span</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">FB</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">]</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">C</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">C11</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;10u&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">L</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">L2</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;1uH&quot;</span>
    <span class="lini-tok-comment">// Chains off one pin take their lanes in their parts' declaration order</span>
    <span class="lini-tok-comment">// [SPEC 16.1]: the divider is declared ahead of the output bank, so it</span>
    <span class="lini-tok-comment">// stands nearest the chip and FB taps it under no cap's lead.</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">R</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">R15</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;240k&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">R</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">R16</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;30k&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">C</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">C12</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;10u&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">C</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">C13</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;10u&quot;</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">C</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">C14</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;10u&quot;</span>

    <span class="lini-tok-comment">// The input node: the flag and the bulk cap split off one trunk at a</span>
    <span class="lini-tok-comment">// T-junction — a pin's up-chain and down-chain share one column</span>
    <span class="lini-tok-comment">// [SPEC 16.1].</span>
    U6.VIN <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">vsys</span><span class="lini-tok-punct">|</span>
    U6.VIN <span class="lini-tok-op">-</span> C11 <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span>
    <span class="lini-tok-comment">// The boost inductor is a **bridge** — two placed ends on one part</span>
    <span class="lini-tok-comment">// [SPEC 16.1]: it stands in SW's own corridor, and the router merges</span>
    <span class="lini-tok-comment">// its far wire into the VIN net at a junction, the way a sheet taps</span>
    <span class="lini-tok-comment">// the line it feeds.</span>
    U6.SW <span class="lini-tok-op">-</span> L2 <span class="lini-tok-op">-</span> U6.VIN
    U6.EN <span class="lini-tok-op">-</span> <span class="lini-tok-string">&quot;EN_BSTD&quot;</span>
    U6.GND <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span>
    <span class="lini-tok-comment">// The output bank marches the VOUT rail, each cap forking down at a</span>
    <span class="lini-tok-comment">// junction dot [SPEC 16.5].</span>
    U6.VOUT <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">vm</span><span class="lini-tok-punct">|</span>
    U6.VOUT <span class="lini-tok-op">-</span> C12 <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span>
    U6.VOUT <span class="lini-tok-op">-</span> C13 <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span>
    U6.VOUT <span class="lini-tok-op">-</span> C14 <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span>
    <span class="lini-tok-comment">// The feedback divider: naming `R16.p1` in **both** statements makes</span>
    <span class="lini-tok-comment">// the midpoint a junction — explicit pins reserve first, whatever the</span>
    <span class="lini-tok-comment">// statement order [SPEC 16.5] — so FB taps between the resistors, not</span>
    <span class="lini-tok-comment">// at the rail; a bridge tapped mid-way straddles the tapping pin's row</span>
    <span class="lini-tok-comment">// [SPEC 16.1], which puts R16 on the output bank's row.</span>
    U6.VOUT <span class="lini-tok-op">-</span> R15 <span class="lini-tok-op">-</span> R16.p1 <span class="lini-tok-op">-</span> <span class="lini-tok-punct">|</span><span class="lini-tok-type">gnd</span><span class="lini-tok-punct">|</span>
    U6.FB <span class="lini-tok-op">-</span> R16.p1
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">region</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">stepper</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Stepper Driver&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">component</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">U8</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;TMC2300-LA-T&quot;</span> <span class="lini-tok-punct">[</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">VS</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">18</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">VCP</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">STEP</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">DIR</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">AD0</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;MS1_AD0&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">AD1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;MS2_AD1&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">OA1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">19</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">pin</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">OA2</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
