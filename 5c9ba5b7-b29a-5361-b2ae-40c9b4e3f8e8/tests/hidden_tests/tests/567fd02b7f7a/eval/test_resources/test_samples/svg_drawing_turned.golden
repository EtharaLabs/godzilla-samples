      .lini-scope-84b8092f[data-theme="dark"], [data-theme="dark"] .lini-scope-84b8092f { color-scheme: dark; }
      .lini-scope-84b8092f[data-theme="light"], [data-theme="light"] .lini-scope-84b8092f { color-scheme: light; }
    }
    .lini-scope-84b8092f, .lini-scope-84b8092f text { font-family: var(--lini-font-family); }
    .lini-scope-84b8092f { font-size: 15px; font-weight: var(--lini-font-weight); color: var(--lini-text-color); }
    .lini-scope-84b8092f .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-84b8092f .lini-oval { fill: var(--lini-fill); stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-84b8092f .lini-poly { stroke-dasharray: none; }
    .lini-scope-84b8092f .lini-path { stroke-dasharray: none; }
    .lini-scope-84b8092f .lini-sketch { fill: var(--lini-fill); stroke: var(--lini-stroke-dark); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-84b8092f .lini-line { fill: none; stroke: var(--lini-stroke); stroke-width: 2; stroke-dasharray: none; }
    .lini-scope-84b8092f .lini-dim-line { fill: none; stroke: var(--lini-stroke-dark); stroke-width: 1; }
    .lini-scope-84b8092f .lini-ext-line { fill: none; stroke: var(--lini-stroke-light); stroke-width: 1; }
    .lini-scope-84b8092f .lini-dim-text { font-size: 12px; font-weight: var(--lini-link-font-weight); }
    .lini-scope-84b8092f .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini-scope-84b8092f .lini-cut-bg { fill: white; stroke: none; }
    .lini-scope-84b8092f .lini-halo { stroke: black; }
    .lini-scope-84b8092f .lini-caption { color: var(--lini-caption-color); font-size: 12px; font-weight: var(--lini-caption-font-weight); }
    .lini-scope-84b8092f .lini-footnote { color: var(--lini-footer-color); font-size: 12px; }
    .lini-scope-84b8092f .lini-hole { fill: var(--lini-bg); stroke: var(--lini-stroke-dark); }
    .lini-scope-84b8092f .lini-centerline { fill: none; stroke: var(--lini-stroke-light); stroke-width: 1; stroke-dasharray: 10,3,1,3; }
