    .lini-scope-84b8092f .lini-hidden { fill: none; stroke: var(--lini-stroke-dark); stroke-width: 1; stroke-dasharray: 5,4; }
    .lini-scope-84b8092f .lini-shoulder { stroke: var(--lini-stroke-dark); }
    .lini-scope-84b8092f .lini-threadline { fill: none; stroke: var(--lini-stroke-light); stroke-width: 1; }
    .lini-scope-84b8092f .lini-marker { fill: var(--lini-stroke); stroke: none; }
    .lini-scope-84b8092f .lini-marker-dim { fill: var(--lini-stroke-dark); }
    .lini-scope-84b8092f .lini-marker-datum { fill: var(--lini-stroke-dark); }
