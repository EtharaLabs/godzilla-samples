    <span class="lini-tok-punct">|</span><span class="lini-tok-type">window</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">on</span><span class="lini-tok-punct">:</span> run<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>
