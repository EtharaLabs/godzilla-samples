  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">head</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-3.7</span> <span class="lini-tok-number">6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span> <span class="lini-tok-string">&quot;WINDOWS · STAIRS&quot;</span> <span class="lini-tok-punct">]</span>
