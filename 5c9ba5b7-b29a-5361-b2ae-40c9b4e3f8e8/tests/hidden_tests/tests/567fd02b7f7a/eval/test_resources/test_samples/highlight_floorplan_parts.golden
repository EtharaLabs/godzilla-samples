exit: 0
--- stdout
<span class="lini-tok-comment">// The architectural vocabulary at one glance [SPEC 15.11] — every wall look,</span>
<span class="lini-tok-comment">// every door pose and symbol, the windows, the flight, and all six fixture</span>
<span class="lini-tok-comment">// families with every `symbol:` variant, drawn at 1:50. A floorplan is a</span>
<span class="lini-tok-comment">// drawing scope, so there is no track grid to lay a catalogue on: each piece is</span>
<span class="lini-tok-comment">// datum-placed with `translate:` and each wall is drawn where it stands. The</span>
<span class="lini-tok-comment">// true-size law does the sizing — a tub is 1700 × 750 mm and a `|door|` left to</span>
<span class="lini-tok-comment">// itself is 900 mm wide, whatever the file drafts in.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">density</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">10</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">head</span><span class="lini-tok-op">::</span><span class="lini-tok-type">block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">flow</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">letter-spacing</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">cap</span><span class="lini-tok-op">::</span><span class="lini-tok-type">block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">flow</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">color</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--muted</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">}</span>

