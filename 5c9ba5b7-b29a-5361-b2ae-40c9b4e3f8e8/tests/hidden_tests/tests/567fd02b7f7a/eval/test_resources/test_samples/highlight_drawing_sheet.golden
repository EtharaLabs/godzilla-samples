exit: 0
--- stdout
<span class="lini-tok-comment">// The sheeted screw [SPEC 24]: an ISO 5457 |page| — frame, zone references,</span>
<span class="lini-tok-comment">// centring marks — hosting a DIN 912 socket cap screw. The side view is a</span>
<span class="lini-tok-comment">// revolved profile with a thread: dressing and a |hidden| hex socket; the</span>
<span class="lini-tok-comment">// end view is ordinary concentric geometry; the |title-block| seats itself</span>
<span class="lini-tok-comment">// flush inside the frame's bottom-right corner — its ISO 7200 field properties</span>
<span class="lini-tok-comment">// build the grid, absent fields collapsing, and an authored |image| cell</span>
<span class="lini-tok-comment">// carries the maker's mark after the generated fields.</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">page</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">sheet</span><span class="lini-tok-punct">:</span> a5 landscape<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">50</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">origin</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-comment">// the ISO sheet: frame, zones, marks — views share their axes datum-to-datum</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">side</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;DIN 912 — M8 × 40&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">screw</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">6.5</span><span class="lini-tok-punct">)</span> chamfer<span class="lini-tok-punct">(</span><span class="lini-tok-number">0.8</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">8</span><span class="lini-tok-punct">)</span>:head down<span class="lini-tok-punct">(</span><span class="lini-tok-number">2.5</span><span class="lini-tok-punct">)</span>:k <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">12</span><span class="lini-tok-punct">)</span>
            point<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">:</span>v <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">28</span><span class="lini-tok-punct">)</span>:m8 chamfer<span class="lini-tok-punct">(</span><span class="lini-tok-number">1</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">4</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-prop">revolve</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-comment">// a turned part</span>
      <span class="lini-tok-prop">thread</span><span class="lini-tok-punct">:</span> m8 <span class="lini-tok-number">1.25</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-comment">// the threaded run</span>
    <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">hidden</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">socket</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
        <span class="lini-tok-comment">// the hex socket, dashed</span>
        <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">3.5</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span> line<span class="lini-tok-punct">(</span><span class="lini-tok-number">1.5</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-3.5</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
        <span class="lini-tok-prop">mirror</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">]</span>
    <span class="lini-tok-prop-user">screw</span><span class="lini-tok-punct">:</span>head <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span> { side: <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → ⌀13</span>
    screw<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> screw:k { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → 8 — K, the head</span>
    <span class="lini-tok-prop-user">screw</span><span class="lini-tok-punct">:</span>k <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> screw:<span class="lini-tok-keyword">right</span> { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → 40 — L, under the head</span>
    <span class="lini-tok-prop-user">screw</span><span class="lini-tok-punct">:</span>v <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> screw:<span class="lini-tok-keyword">right</span> { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → 28 — the thread length</span>
    <span class="lini-tok-prop-user">screw</span><span class="lini-tok-punct">:</span>m8 &lt;- { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → M8×1.25 — composed by the thread</span>
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">end</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">oval</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">13</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">13</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">oval</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">11.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">11.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the head, end-on</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">hex</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">socket</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">7</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">rotate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">90</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the socket, visible here — turned point-up, so the key size lies across</span>
    <span class="lini-tok-comment">// the flats horizontally; the anchors turn with it, so the across-flats</span>
    <span class="lini-tok-comment">// span is the rotated :top/:bottom pair</span>
    socket<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">top</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> socket:<span class="lini-tok-keyword">bottom</span>
    <span class="lini-tok-comment">// → 6 — the hex key, across flats</span>

  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">title-block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">title</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;Socket cap screw&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">drawing-number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;DIN 912 — M8 × 40&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">revision</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;A&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">sheet-number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;1/1&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">date</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;2026-07-08&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">author</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;AM&quot;</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-comment">// the maker's mark — a local SVG, embedded id-isolated at compile [SPEC 7],</span>
    <span class="lini-tok-comment">// seated as an ordinary cell after the generated fields [SPEC 15.8]</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">image</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">src</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;assets/logo.svg&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3</span> <span class="lini-tok-number">3</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>
<span class="lini-tok-punct">]</span>

--- stderr
