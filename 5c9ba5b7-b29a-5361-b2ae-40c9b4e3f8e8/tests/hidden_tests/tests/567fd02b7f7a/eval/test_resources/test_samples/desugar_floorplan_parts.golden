    } [
      |line| .lini-window-sill.lini-line { chrome: sill 0; }
      |line| .lini-window-sill.lini-line { chrome: sill 1; }
    ]
  ]
  |block| .lini-stairs.lini-block {
    steps: 4; translate: 10.8 6.6; unit-mm: 1000;
  } [
    |line| .lini-stair-tread.lini-line { chrome: tread 0; }
    |line| .lini-stair-tread.lini-line { chrome: tread 1; }
    |line| .lini-stair-tread.lini-line { chrome: tread 2; }
    |line| .lini-stair-arrow.lini-line { chrome: arrow 0; }
  ]
  |block| .lini-stairs.lini-block {
