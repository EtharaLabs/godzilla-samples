  |sketch| .lini-partition.lini-wall.lini-sketch {
    draw: move(15, 2.9) right(2.4):run;
    wall-thickness: 0.1;
  } [
    |block| .lini-door.lini-block { on: run; at: 0.75; unit-mm: 1000; } [
      "D1"
      |line| .lini-door-leaf.lini-line { chrome: leaf 0; }
      |line| .lini-door-swing.lini-line { chrome: swing 0; }
    ]
  ]
  |block| .lini-cap.lini-block { translate: 0 4.25; } [ "start · left" ]
  |block| .lini-cap.lini-block { translate: 2.7 4.25; } [ "start · right" ]
  |block| .lini-cap.lini-block { translate: 5.4 4.25; } [ "end · left" ]
  |block| .lini-cap.lini-block { translate: 8.1 4.25; } [ "end · right" ]
  |block| .lini-cap.lini-block { translate: 10.8 4.25; } [ "symbol: double" ]
