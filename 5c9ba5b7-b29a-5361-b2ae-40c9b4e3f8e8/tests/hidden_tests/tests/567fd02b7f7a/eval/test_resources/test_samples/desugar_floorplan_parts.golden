  ]
  |block| .lini-head.lini-block { translate: -3.7 6; } [ "WINDOWS · STAIRS" ]
  |sketch| .lini-wall.lini-sketch {
    draw: move(-1.2, 6) right(2.4):run;
    wall-thickness: 0.2;
  } [
    |block| .lini-window.lini-block { on: run; at: 0.6; unit-mm: 1000; } [
      |line| .lini-window-sill.lini-line { chrome: sill 0; }
      |line| .lini-window-sill.lini-line { chrome: sill 1; }
    ]
