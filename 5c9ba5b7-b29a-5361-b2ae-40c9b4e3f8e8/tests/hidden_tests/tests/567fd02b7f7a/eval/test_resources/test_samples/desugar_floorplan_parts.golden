  |block| .lini-cap.lini-block { translate: 2.7 7.35; } [ "width: 2" ]
  |block| .lini-cap.lini-block { translate: 5.4 7.35; } [ "in a |partition|" ]
  |block| .lini-cap.lini-block { translate: 8.1 7.35; } [ "two on one run" ]
