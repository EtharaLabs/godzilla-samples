exit: 0
--- stdout
{
  layout: flow; padding: 20; gap: 36; font-size: 10; density: 4;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-line { fill: none; stroke: --stroke; stroke-width: 2; }
  .lini-sketch { fill: --fill; stroke: --stroke-dark; stroke-width: 2; }
  .lini-caption {
    pin: top left; translate: 0 -20; color: --caption-color; font-scale: 12 15; font-weight: --caption-font-weight;
  }
  .lini-footnote {
    pin: bottom; translate: 0 19; font-scale: 12 15; color: --footer-color;
  }
  .lini-drawing { layout: drawing; padding: 0; }
  .lini-floorplan { layout: floorplan; }
  .lini-wall { fill: --stroke-dark; stroke: none; }
  .lini-door-leaf { stroke: --stroke-light; stroke-width: 1; fill: none; }
  .lini-door-swing { stroke: --stroke-light; stroke-width: 1; fill: none; }
  .lini-window-sill { stroke: --stroke-light; stroke-width: 1; fill: none; }
  .lini-stair-tread { stroke: --stroke-light; stroke-width: 1; fill: none; }
  .lini-stair-arrow { stroke: --stroke-light; stroke-width: 1; fill: none; }
  .lini-bed { stroke: --stroke-dark; stroke-width: 1; fill: --bg; }
  .lini-sofa { stroke: --stroke-dark; stroke-width: 1; fill: --bg; }
  .lini-dining { stroke: --stroke-dark; stroke-width: 1; fill: --bg; }
  .lini-bath { stroke: --stroke-dark; stroke-width: 1; fill: --bg; }
  .lini-appliance { stroke: --stroke-dark; stroke-width: 1; fill: --bg; }
  .lini-stairs { stroke: --stroke-dark; stroke-width: 1; fill: --bg; }
  .lini-head { layout: flow; align: center; font-size: 12; letter-spacing: 1; }
  .lini-cap { layout: flow; align: center; color: --muted; }
}

|block#parts| .lini-floorplan.lini-drawing.lini-block {
  unit: m; scale: 0.02; px-per-unit: 4000;
} [
  |block| .lini-footnote.lini-caption.lini-block [
    "THE FLOORPLAN PARTS — SPEC 15.11"
  ]
  |block| .lini-head.lini-block { translate: -3.7 0; } [ "WALLS" ]
  |sketch| .lini-wall.lini-sketch {
    draw: move(-1.2, 0) right(2.4);
    wall-thickness: 0.2;
  }
  |sketch| .lini-partition.lini-wall.lini-sketch {
    draw: move(1.5, 0) right(2.4);
    wall-thickness: 0.1;
  }
  |sketch| .lini-wall.lini-sketch {
    draw: move(4.2, 0) right(2.4);
    thickness: 0.4;
  }
  |sketch| .lini-wall.lini-sketch {
    draw: move(6.9, 0) right(2.4);
    fill: --bg; stroke: --stroke-dark; stroke-width: 1; wall-thickness: 0.2;
  }
  |sketch| .lini-wall.lini-sketch {
    draw: move(9.6, 0) right(2.4);
    fill: hatch(45); stroke: --stroke-dark; stroke-width: 1; wall-thickness: 0.2;
  }
  |sketch| .lini-wall.lini-sketch {
    draw: move(12.9, -0.5) right(1.2) down(1);
    wall-thickness: 0.2;
  }
  |sketch| .lini-wall.lini-sketch {
    draw: move(15.1, 0.25) arc(2.2, 0, 1.8);
    wall-thickness: 0.2;
  }
  |block| .lini-cap.lini-block { translate: 0 1.3; } [ "solid · 200" ]
  |block| .lini-cap.lini-block { translate: 2.7 1.3; } [ "|partition| · 100" ]
  |block| .lini-cap.lini-block { translate: 5.4 1.3; } [ "thickness: 0.4" ]
  |block| .lini-cap.lini-block { translate: 8.1 1.3; } [ "fill: --bg" ]
  |block| .lini-cap.lini-block { translate: 10.8 1.3; } [ "hatch(45) section" ]
  |block| .lini-cap.lini-block { translate: 13.5 1.3; } [ "mitred corner" ]
  |block| .lini-cap.lini-block { translate: 16.2 1.3; } [ "arc · concentric" ]
  |block| .lini-head.lini-block { translate: -3.7 2.9; } [ "DOORS" ]
  |sketch| .lini-wall.lini-sketch {
    draw: move(-1.2, 2.9) right(2.4):run;
    wall-thickness: 0.2;
  } [
    |block| .lini-door.lini-block {
      on: run; at: 0.75; hinge: start; swing: left; unit-mm: 1000;
    } [
      |line| .lini-door-leaf.lini-line { chrome: leaf 0; }
      |line| .lini-door-swing.lini-line { chrome: swing 0; }
    ]
  ]
  |sketch| .lini-wall.lini-sketch {
    draw: move(1.5, 2.9) right(2.4):run;
    wall-thickness: 0.2;
  } [
    |block| .lini-door.lini-block {
      on: run; at: 0.75; hinge: start; swing: right; unit-mm: 1000;
    } [
      |line| .lini-door-leaf.lini-line { chrome: leaf 0; }
      |line| .lini-door-swing.lini-line { chrome: swing 0; }
    ]
  ]
  |sketch| .lini-wall.lini-sketch {
    draw: move(4.2, 2.9) right(2.4):run;
    wall-thickness: 0.2;
  } [
    |block| .lini-door.lini-block {
      on: run; at: 0.75; hinge: end; swing: left; unit-mm: 1000;
    } [
      |line| .lini-door-leaf.lini-line { chrome: leaf 0; }
      |line| .lini-door-swing.lini-line { chrome: swing 0; }
    ]
  ]
  |sketch| .lini-wall.lini-sketch {
    draw: move(6.9, 2.9) right(2.4):run;
    wall-thickness: 0.2;
  } [
    |block| .lini-door.lini-block {
      on: run; at: 0.75; hinge: end; swing: right; unit-mm: 1000;
    } [
      |line| .lini-door-leaf.lini-line { chrome: leaf 0; }
      |line| .lini-door-swing.lini-line { chrome: swing 0; }
