  <span class="lini-tok-comment">// ── Dimensions. Every named wall run answers three ways [SPEC 15.11]: the</span>
  <span class="lini-tok-comment">// bare `:segment` is the **centreline**, where a structural drawing measures,</span>
  <span class="lini-tok-comment">// and the derived `-in` / `-out` face anchors are its two offset faces — so</span>
  <span class="lini-tok-comment">// every dimension reads an **inside** face — a room its clear span, the</span>
  <span class="lini-tok-comment">// overalls the shell's clear interior: what a listing plan publishes. An</span>
  <span class="lini-tok-comment">// edge's extension line springs from the end nearest the dimension line</span>
  <span class="lini-tok-comment">// [SPEC 15.2], so every witness line here leaves a corner.</span>
  <span class="lini-tok-prop-user">outer</span><span class="lini-tok-punct">:</span>west-in <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> outer:east-in { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 9.4 — the interior overall, inner face to inner face</span>
  <span class="lini-tok-prop-user">outer</span><span class="lini-tok-punct">:</span>west-in <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> bedwall:side-out { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 4.45 — the bedroom's clear width ('side' runs south, so its 'out' face</span>
  <span class="lini-tok-comment">// is the western one, the bedroom's own)</span>
  <span class="lini-tok-prop-user">bedwall</span><span class="lini-tok-punct">:</span>side-in <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> outer:east-in { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 4.85 — hall and bath, clear to the east wall's inner face</span>
  <span class="lini-tok-prop-user">outer</span><span class="lini-tok-punct">:</span>north-in <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> bathwall:head-out { side: <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 3.85 — kitchen and living, clear to the bathroom wall</span>
  <span class="lini-tok-prop-user">bathwall</span><span class="lini-tok-punct">:</span>head-in <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> outer:south-in { side: <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 2.65 — the bathroom's clear depth</span>
  <span class="lini-tok-prop-user">outer</span><span class="lini-tok-punct">:</span>north-in <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> outer:south-in { side: <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// → 6.6 — the interior overall, stacked outside the room clears</span>
<span class="lini-tok-punct">]</span>

