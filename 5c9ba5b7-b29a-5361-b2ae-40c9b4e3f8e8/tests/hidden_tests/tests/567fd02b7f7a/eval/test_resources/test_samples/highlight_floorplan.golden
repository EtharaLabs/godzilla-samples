exit: 0
--- stdout
<span class="lini-tok-comment">// A one-bedroom condominium at 1:50 [SPEC 15.11] — the drawing engine wearing</span>
<span class="lini-tok-comment">// an architect's vocabulary. A `|wall|` traces the **centreline** and grows the</span>
<span class="lini-tok-comment">// 200 mm poché outline around it (`|partition|` is the 100 mm interior define);</span>
<span class="lini-tok-comment">// the `|door|` / `|window|` openings ride their wall's `[ ]`, stationed by</span>
<span class="lini-tok-comment">// `on:` / `at:`, and clip that outline at the jambs while drawing their own</span>
<span class="lini-tok-comment">// leaf, quarter swing arc and sill pair. The six fixture families draw</span>
<span class="lini-tok-comment">// true-size bodies — a bed is 1500 × 2000 mm whether the file drafts in `m` or</span>
<span class="lini-tok-comment">// `mm` — over a `--bg` fill, so furniture masks the floor it sits on. Counters,</span>
<span class="lini-tok-comment">// the island, casework and the balcony deck are plain `|rect|`s and the north</span>
<span class="lini-tok-comment">// arrow is a `|sketch|`: SPEC 15.11's parts-library escape.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">density</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-op">::</span><span class="lini-tok-type">rect</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--bg</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--stroke-dark</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke-width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">room</span><span class="lini-tok-op">::</span><span class="lini-tok-type">block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-comment">// the name stacks over the area, both lines centred</span>
    <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">flow</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">direction</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">column</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">center</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">font-size</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">11</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">letter-spacing</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">floorplan</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">unit</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;UNIT 12A — ONE BEDROOM · 65 m²&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">unit</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">m</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.02</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>

  <span class="lini-tok-comment">// ── The shell. One centreline loop; `close():west` mitres the seam like any</span>
  <span class="lini-tok-comment">// other corner, and every opening below cuts its own gap out of the poché.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">wall</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">outer</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">9.6</span><span class="lini-tok-punct">)</span>:north down<span class="lini-tok-punct">(</span><span class="lini-tok-number">6.8</span><span class="lini-tok-punct">)</span>:east <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">9.6</span><span class="lini-tok-punct">)</span>:south
          close<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">:</span>west<span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">door</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">entry</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;D1&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">on</span><span class="lini-tok-punct">:</span> east<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.95</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">swing</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// hinged at the north jamb, opening into the flat — stationed clear of the</span>
    <span class="lini-tok-comment">// counter run that now turns the north-east corner</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">door</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">slider</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;D2&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">on</span><span class="lini-tok-punct">:</span> west<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> sliding<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the balcony slider — two panels, no arc</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">window</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">w1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;W1&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">on</span><span class="lini-tok-punct">:</span> west<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.5</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the bedroom's own glazing onto the same balcony</span>
  <span class="lini-tok-punct">]</span>
  <span class="lini-tok-comment">// North and south are **party walls** against the neighbouring units, so</span>
  <span class="lini-tok-comment">// they carry no openings at all — blank poché, the way a condo stacks. Every</span>
  <span class="lini-tok-comment">// opening a unit gets is on the entry side (east) or the balcony side (west).</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">partition</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bedwall</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">3.8</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">4.6</span><span class="lini-tok-punct">)</span>:head down<span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span>:side<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">door</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bed-door</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;D3&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">on</span><span class="lini-tok-punct">:</span> side<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.9</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">swing</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// 'right' of the pen's travel — the leaf opens into the bedroom</span>
  <span class="lini-tok-punct">]</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">partition</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">laundry</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">6</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">6.8</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">0.8</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// a stub off the south wall: with the bathroom's own west wall it makes the</span>
  <span class="lini-tok-comment">// 600 mm open-front alcove the stacked washer/dryer is built into</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">partition</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bathwall</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">9.6</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">2.9</span><span class="lini-tok-punct">)</span>:head down<span class="lini-tok-punct">(</span><span class="lini-tok-number">2.8</span><span class="lini-tok-punct">)</span>:side<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">door</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bath-door</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;D4&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">on</span><span class="lini-tok-punct">:</span> side<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.8</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">hinge</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">end</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// hung on the far jamb, and 'swing:' left by default — into the bathroom</span>
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-comment">// ── Casework: counters, the island, the wardrobe and the balcony deck.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">deck</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6.6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-0.8</span> <span class="lini-tok-number">3.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// the balcony runs the west face between the two party walls — its ends stop</span>
  <span class="lini-tok-comment">// on their **inner** faces, so the deck is the unit's own and not a strip</span>
  <span class="lini-tok-comment">// shared with the neighbours</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3.9</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">7.55</span> <span class="lini-tok-number">0.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// the kitchen run, against the north wall and into the north-east corner</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.9</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">7.2</span> <span class="lini-tok-number">2.05</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">radius</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// the island — `radius:` is core, and sheet-space px: 4 is 50 mm at 1:50</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.55</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2</span> <span class="lini-tok-number">1.75</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// the coffee table</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.45</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.45</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.6</span> <span class="lini-tok-number">4.075</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.45</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.45</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3</span> <span class="lini-tok-number">4.075</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// a nightstand either side of the bed's head</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4.25</span> <span class="lini-tok-number">6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// the wardrobe</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">slab</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.2</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0.55</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">7.35</span> <span class="lini-tok-number">4.325</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-comment">// the vanity top</span>

  <span class="lini-tok-comment">// ── Fixtures. Each body masks what it overlaps, so the casework reads under</span>
  <span class="lini-tok-comment">// the appliances that sit in it; an `|appliance|`'s label centres **in** its</span>
  <span class="lini-tok-comment">// box (the F / DW / W/D convention), every other fixture's reads beside it.</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">appliance</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> stove<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6.4</span> <span class="lini-tok-number">0.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
