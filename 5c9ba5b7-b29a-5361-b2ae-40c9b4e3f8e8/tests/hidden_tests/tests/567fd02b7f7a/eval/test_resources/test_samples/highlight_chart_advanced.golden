exit: 0
--- stdout
<span class="lini-tok-comment">// Scales, axes and formulas [SPEC 14.3–14.5] — the domain side of a chart,</span>
<span class="lini-tok-comment">// none of it on the hero board: a `scale: log` axis's decade ticks, a time axis</span>
<span class="lini-tok-comment">// reading ISO date literals on a calendar `step:` — and annotated in the same</span>
<span class="lini-tok-comment">// literals, a |band| spanning dates and a |mark| landing on one — a `range:` that both crops</span>
<span class="lini-tok-comment">// and runs high→low, two value axes sharing one plot (each with its own</span>
<span class="lini-tok-comment">// `unit:`, the second declining gridlines so the grid stays single), `format:`</span>
<span class="lini-tok-comment">// setting a tick's presentation, a widened `clearance:` standing a chart's text</span>
<span class="lini-tok-comment">// off what it labels, a whole-domain `fn:` in `x` that two series</span>
<span class="lini-tok-comment">// share through one stylesheet function at 60 `samples:`, and a per-band `fn:`</span>
<span class="lini-tok-comment">// list clocked in local `u` across three |band|s.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">layout</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">grid</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">columns</span><span class="lini-tok-punct">:</span> <span class="lini-tok-type">repeat</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">2</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">36</span><span class="lini-tok-punct">;</span>
  cure<span class="lini-tok-punct">(</span>k<span class="lini-tok-punct">)</span> = <span class="lini-tok-punct">(</span><span class="lini-tok-number">100</span> * <span class="lini-tok-punct">(</span><span class="lini-tok-number">1</span> <span class="lini-tok-op">-</span> exp<span class="lini-tok-punct">(</span><span class="lini-tok-op">-</span>x/k<span class="lini-tok-punct">)</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Requests by tier (req/s)&quot;</span> <span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">categories</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;free&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;pro&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;team&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;ent&quot;</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">log</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">bars</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">5</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">80</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">1200</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">45000</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// Date literals make the x axis a time axis; `step: month` lands the ticks on</span>
<span class="lini-tok-comment">// calendar boundaries rather than on even spacings of the epoch. A dated domain</span>
<span class="lini-tok-comment">// is a domain like any other, so a |band| spans it and a |mark| lands on it in</span>
<span class="lini-tok-comment">// the same literals.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Weekly active users&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">t</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">step</span><span class="lini-tok-punct">:</span> month<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;users&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">unit</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;k&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">band</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;beta&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;2026-02-15&quot;</span> <span class="lini-tok-string">&quot;2026-04-01&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">mark</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;GA&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">at</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;2026-04-06&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">axis</span><span class="lini-tok-punct">:</span> t<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--red-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;wau&quot;</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;2026-01-05&quot;</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;2026-02-02&quot;</span> <span class="lini-tok-number">15</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;2026-03-02&quot;</span> <span class="lini-tok-number">21</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;2026-04-06&quot;</span> <span class="lini-tok-number">28</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;2026-05-04&quot;</span> <span class="lini-tok-number">34</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;2026-06-01&quot;</span> <span class="lini-tok-number">45</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">marker</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">dot</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// `range: 50 1` does both of its jobs at once: 1 is the top of the chart, so</span>
<span class="lini-tok-comment">// the axis runs high→low, and the album's opening week at 62 falls outside the</span>
<span class="lini-tok-comment">// window and is cropped to the plot.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Chart position&quot;</span> <span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">categories</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;Jan&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Feb&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Mar&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Apr&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;May&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Jun&quot;</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;position&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">50</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;single&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">44</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">31</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">18</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">9</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">12</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">marker</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">circle</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;album&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">62</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">48</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">35</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">22</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">16</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">11</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">marker</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">circle</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// `clearance:` is the daylight every chrome text keeps off what it labels</span>
<span class="lini-tok-comment">// [SPEC 14.6] — the one knob behind the tick rows, the two axis titles, and a</span>
<span class="lini-tok-comment">// spoke's category. Widened here so the dual-axis titles breathe; the plot</span>
<span class="lini-tok-comment">// gives up the room, never the label.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Throughput vs. error rate&quot;</span> <span class="lini-tok-punct">{</span>
  <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">clearance</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">10</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-prop">categories</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;Mon&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Tue&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Wed&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Thu&quot;</span><span class="lini-tok-punct">,</span> <span class="lini-tok-string">&quot;Fri&quot;</span><span class="lini-tok-punct">;</span>
<span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">req</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;requests&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">unit</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;/s&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">err</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;errors&quot;</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">3</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">unit</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;%&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">format</span><span class="lini-tok-punct">:</span> decimal <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gridlines</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">none</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">bars</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;requests&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">820</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">932</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">901</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">1090</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">1204</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">axis</span><span class="lini-tok-punct">:</span> req<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;error rate&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">data</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">2.1</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0.8</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">1.5</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0.4</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0.6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">axis</span><span class="lini-tok-punct">:</span> err<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">marker</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">dot</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// One `cure(k)` binding, two adhesives: the same closed form sampled twice at</span>
<span class="lini-tok-comment">// its own time constant, so the pair can never drift apart.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Cure strength&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">samples</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">60</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;minutes&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">90</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">100</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">unit</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;%&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;epoxy&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fn</span><span class="lini-tok-punct">:</span> cure<span class="lini-tok-punct">(</span><span class="lini-tok-number">18</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;acrylic&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fn</span><span class="lini-tok-punct">:</span> cure<span class="lini-tok-punct">(</span><span class="lini-tok-number">34</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke-style</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">dashed</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

<span class="lini-tok-comment">// Bands cut the domain into three segments and the series answers with a</span>
<span class="lini-tok-comment">// per-band `fn:` list — one expression each, clocked `0 → 1` in local `u`,</span>
<span class="lini-tok-comment">// the risers between them drawn because the jump is real.</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">chart</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Motor draw (A)&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">380</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">270</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;phase&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">axis</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">band</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Close&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">0</span> <span class="lini-tok-number">1.4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--sky</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">band</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Inject&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.4</span> <span class="lini-tok-number">3.1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--rose</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">band</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;Hold&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">range</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3.1</span> <span class="lini-tok-number">5.1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--amber</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type">line</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;draw&quot;</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--rose-deep</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fn</span><span class="lini-tok-punct">:</span> <span class="lini-tok-punct">(</span><span class="lini-tok-number">0.12</span> + <span class="lini-tok-number">1.2</span>*exp<span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">(</span><span class="lini-tok-punct">(</span>u-0<span class="lini-tok-number">.8</span><span class="lini-tok-punct">)</span>/<span class="lini-tok-number">0.12</span><span class="lini-tok-punct">)</span>^<span class="lini-tok-number">2</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">,</span> <span class="lini-tok-punct">(</span><span class="lini-tok-number">1.5</span> + <span class="lini-tok-number">3.0</span>*u^<span class="lini-tok-number">1.1</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0.5</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

