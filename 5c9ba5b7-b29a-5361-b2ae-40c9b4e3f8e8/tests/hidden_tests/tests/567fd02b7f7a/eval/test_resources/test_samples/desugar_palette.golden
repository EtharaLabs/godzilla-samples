exit: 0
--- stdout
{
  layout: flow; padding: 30 16; gap: 18; font-size: 13; direction: column;
  .lini-block {
    fill: none; stroke: none; stroke-width: 2; padding: 0; gap: 36;
  }
  .lini-box {
    fill: --fill; stroke: --stroke; stroke-width: 2; padding: 20; radius: 8; direction: column; gap: 12;
  }
  .lini-group {
    stroke: --group-stroke; stroke-style: dashed; stroke-width: 1; fill: --group-fill; radius: 8; padding: 20;
  }
  .lini-row { direction: row; }
  .lini-sw { width: 80; height: 34; stroke: none; }
  .lini-h { color: --muted; }
  .lini-card { stroke-width: 1.5; width: 88; padding: 15 0; }
}

|block| .lini-block { font-size: 18; } [ "Lini palette — 11 hues × 5 tiers" ]
|block#board| .lini-group.lini-block {
  layout: grid; columns: 56, 82, 82, 82, 82, 82; gap: 5; fill: none; stroke: none;
} [
  |block| .lini-h.lini-block
  |block| .lini-h.lini-block [ "wash" ]
  |block| .lini-h.lini-block [ "soft" ]
  |block| .lini-h.lini-block [ "base" ]
  |block| .lini-h.lini-block [ "deep" ]
  |block| .lini-h.lini-block [ "ink" ]
  |block| .lini-h.lini-block [ "red" ]
  |block| .lini-sw.lini-box.lini-block { fill: --red-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --red-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --red; }
  |block| .lini-sw.lini-box.lini-block { fill: --red-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --red-ink; }
  |block| .lini-h.lini-block [ "rose" ]
  |block| .lini-sw.lini-box.lini-block { fill: --rose-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --rose-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --rose; }
  |block| .lini-sw.lini-box.lini-block { fill: --rose-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --rose-ink; }
  |block| .lini-h.lini-block [ "orange" ]
  |block| .lini-sw.lini-box.lini-block { fill: --orange-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --orange-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --orange; }
  |block| .lini-sw.lini-box.lini-block { fill: --orange-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --orange-ink; }
  |block| .lini-h.lini-block [ "amber" ]
  |block| .lini-sw.lini-box.lini-block { fill: --amber-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --amber-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --amber; }
  |block| .lini-sw.lini-box.lini-block { fill: --amber-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --amber-ink; }
  |block| .lini-h.lini-block [ "lime" ]
  |block| .lini-sw.lini-box.lini-block { fill: --lime-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --lime-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --lime; }
  |block| .lini-sw.lini-box.lini-block { fill: --lime-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --lime-ink; }
  |block| .lini-h.lini-block [ "green" ]
  |block| .lini-sw.lini-box.lini-block { fill: --green-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --green-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --green; }
  |block| .lini-sw.lini-box.lini-block { fill: --green-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --green-ink; }
  |block| .lini-h.lini-block [ "teal" ]
  |block| .lini-sw.lini-box.lini-block { fill: --teal-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --teal-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --teal; }
  |block| .lini-sw.lini-box.lini-block { fill: --teal-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --teal-ink; }
  |block| .lini-h.lini-block [ "sky" ]
  |block| .lini-sw.lini-box.lini-block { fill: --sky-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --sky-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --sky; }
  |block| .lini-sw.lini-box.lini-block { fill: --sky-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --sky-ink; }
  |block| .lini-h.lini-block [ "blue" ]
  |block| .lini-sw.lini-box.lini-block { fill: --blue-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --blue-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --blue; }
  |block| .lini-sw.lini-box.lini-block { fill: --blue-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --blue-ink; }
  |block| .lini-h.lini-block [ "purple" ]
  |block| .lini-sw.lini-box.lini-block { fill: --purple-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --purple-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --purple; }
  |block| .lini-sw.lini-box.lini-block { fill: --purple-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --purple-ink; }
  |block| .lini-h.lini-block [ "gray" ]
  |block| .lini-sw.lini-box.lini-block { fill: --gray-wash; }
  |block| .lini-sw.lini-box.lini-block { fill: --gray-soft; }
  |block| .lini-sw.lini-box.lini-block { fill: --gray; }
  |block| .lini-sw.lini-box.lini-block { fill: --gray-deep; }
  |block| .lini-sw.lini-box.lini-block { fill: --gray-ink; }
]
|block#cards| .lini-row.lini-block { gap: 10; } [
  |block| .lini-card.lini-box.lini-block {
    fill: --purple-wash; stroke: --purple; color: --purple;
  } [ "Wash" ]
  |block| .lini-card.lini-box.lini-block {
    fill: --purple-soft; stroke: --purple-deep; color: --purple-deep;
  } [ "Soft" ]
  |block| .lini-card.lini-box.lini-block {
    fill: --purple; stroke: --purple-ink; color: --purple-ink;
  } [ "Base" ]
  |block| .lini-card.lini-box.lini-block {
    fill: --purple-deep; stroke: --purple-deep; color: --bg;
  } [ "Deep" ]
  |block| .lini-card.lini-box.lini-block {
    fill: --purple-ink; stroke: --purple-ink; color: --bg;
  } [ "Ink" ]
]

--- stderr
