      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">62</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-22</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">38.76</span><span class="lini-tok-punct">)</span> fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span> arc<span class="lini-tok-punct">(</span><span class="lini-tok-number">6.74</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">10.81</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">32</span><span class="lini-tok-punct">)</span> fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span>
            <span class="lini-tok-const">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">32.02</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">:</span>m24 close<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-comment">// the port wall in local section: the chamber arc, the drilled ⌀22.38,</span>
      <span class="lini-tok-comment">// the flange face — and a filleted cut boundary between them</span>
      <span class="lini-tok-prop">revolve</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-comment">// a bore of revolution about the port axis</span>
      <span class="lini-tok-prop">thread</span><span class="lini-tok-punct">:</span> m24 <span class="lini-tok-number">1.5</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-comment">// the bore is an inner subpath, so the thread reads internal</span>
    <span class="lini-tok-punct">}</span>

