exit: 0
--- stdout
<span class="lini-tok-comment">// Sourced views [SPEC 15.8] on an ISO 5457 A3 sheet: the front view carries the</span>
<span class="lini-tok-comment">// A–A cutting plane and a detail ring; `|drawing| { of: a }` authors the section</span>
<span class="lini-tok-comment">// and `{ of: c }` re-renders the ringed corner clipped to the circle at its own</span>
<span class="lini-tok-comment">// ratio. A full section is a **cut solid**, not a slice: the hatched faces are</span>
<span class="lini-tok-comment">// the material the plane cuts, and the edges **beyond** the plane — the far wall</span>
<span class="lini-tok-comment">// of the circlip groove, the chamber floor's rim, the bore's exit, the port's</span>
<span class="lini-tok-comment">// mouth — are authored at geometry weight behind them (Lini is 2D, so what</span>
<span class="lini-tok-comment">// stands behind the cut is drawn, like the cut itself). `mirror:` reflects the</span>
<span class="lini-tok-comment">// wall **and its features** [SPEC 15.3]: the coolant drilling lands in both,</span>
<span class="lini-tok-comment">// `2×` on its reading, while the bleed vent declines with `mirror: none`.</span>
<span class="lini-tok-comment">// A broken-out section at the right port cuts to its tapped bore, where</span>
<span class="lini-tok-comment">// `thread:`'s sense flips [SPEC 15.3]: on an **inner** (even-odd hole)</span>
<span class="lini-tok-comment">// subpath the run is the drilled minor and the thin line marks the **major**,</span>
<span class="lini-tok-comment">// out by 0.5413 × pitch — outside the drawn bore, not in — and the bare</span>
<span class="lini-tok-comment">// leader composes `M24×1.5` from the geometry. Adjacent parts hatch opposite</span>
<span class="lini-tok-comment">// ways, a `|hole|`'s `thread:` draws the round view's ¾ arc, annotation</span>
<span class="lini-tok-comment">// linework halos where it crosses geometry [SPEC 15.7], and the</span>
<span class="lini-tok-comment">// `|title-block|`'s ISO 7200 field properties seat themselves in the frame's</span>
<span class="lini-tok-comment">// corner.</span>
<span class="lini-tok-punct">{</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">steel</span><span class="lini-tok-op">::</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-type">hatch</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">45</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">5</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">bronze</span><span class="lini-tok-op">::</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-type">hatch</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">-45</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">}</span>

<span class="lini-tok-punct">|</span><span class="lini-tok-type">page</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">sheet</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">sheet</span><span class="lini-tok-punct">:</span> a3 landscape<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">gap</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">28</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">align</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">origin</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">front</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;PUMP BODY&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">body</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-62</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">52</span><span class="lini-tok-punct">)</span> fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">12</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">124</span><span class="lini-tok-punct">)</span> fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">12</span><span class="lini-tok-punct">)</span>:c1 down<span class="lini-tok-punct">(</span><span class="lini-tok-number">104</span><span class="lini-tok-punct">)</span>
            fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">12</span><span class="lini-tok-punct">)</span> <span class="lini-tok-const">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">124</span><span class="lini-tok-punct">)</span> fillet<span class="lini-tok-punct">(</span><span class="lini-tok-number">12</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">52</span><span class="lini-tok-punct">)</span> close<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">none</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">hole</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bolt</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
        <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">8</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-46</span> <span class="lini-tok-number">-36</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">pattern</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">grid</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">2</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">2</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">92</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">72</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">thread</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1.25</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-punct">}</span>
      <span class="lini-tok-comment">// the cover's four tapped holes — the round view's ¾ thread arc</span>
    <span class="lini-tok-punct">]</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">oval</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">chamber</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">64</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">64</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--bg</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--stroke-dark</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">oval</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">seat</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">28</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">28</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--bg</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--stroke-dark</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">oval</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">shaft</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">20</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">height</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">20</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--bg</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">stroke</span><span class="lini-tok-punct">:</span> <span class="lini-tok-var">--stroke-dark</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">hidden</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">drill</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-62</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-11.19</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">32.02</span><span class="lini-tok-punct">)</span>
            move<span class="lini-tok-punct">(</span><span class="lini-tok-op">-</span><span class="lini-tok-number">62</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">11.19</span><span class="lini-tok-punct">)</span> <span class="lini-tok-const">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">32.02</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-punct">}</span>
