    body<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">top</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> body:<span class="lini-tok-keyword">bottom</span> { side: <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// 104</span>
    chamber <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// ⌀64 — the diametral line, its value carried out past the rim</span>
    <span class="lini-tok-prop-user">port</span><span class="lini-tok-punct">:</span>m24 &lt;- <span class="lini-tok-string">&quot;THRU, 2×&quot;</span> { side: <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → M24×1.5 THRU, 2× — the spec composes from the drilled bore and the</span>
    <span class="lini-tok-comment">// pitch, the authored words following it [SPEC 15.3]</span>
    body.bolt <span class="lini-tok-op">&lt;-</span> <span class="lini-tok-string">&quot;4× M8×1.25, 16 DEEP&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">side</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">sec</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">of</span><span class="lini-tok-punct">:</span> a<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">1</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">sketch</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">beyond</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-22</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-35</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">70</span><span class="lini-tok-punct">)</span>
            move<span class="lini-tok-punct">(</span><span class="lini-tok-op">-</span><span class="lini-tok-number">19</span><span class="lini-tok-punct">,</span> <span class="lini-tok-op">-</span><span class="lini-tok-number">35</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">70</span><span class="lini-tok-punct">)</span>
            move<span class="lini-tok-punct">(</span><span class="lini-tok-number">12</span><span class="lini-tok-punct">,</span> <span class="lini-tok-op">-</span><span class="lini-tok-number">32</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">64</span><span class="lini-tok-punct">)</span>
            move<span class="lini-tok-punct">(</span><span class="lini-tok-number">26</span><span class="lini-tok-punct">,</span> <span class="lini-tok-op">-</span><span class="lini-tok-number">10</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">20</span><span class="lini-tok-punct">)</span>
            move<span class="lini-tok-punct">(</span><span class="lini-tok-op">-</span><span class="lini-tok-number">6</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">)</span> circle<span class="lini-tok-punct">(</span><span class="lini-tok-number">11.19</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-prop">fill</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">none</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// beyond the cutting plane, at geometry weight: the circlip groove's far</span>
    <span class="lini-tok-comment">// wall, the chamber floor's rim, the bore's exit, the port's mouth</span>

    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">steel</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">wall</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">-26</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-52</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">52</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">38</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">14</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">18</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">31</span><span class="lini-tok-punct">)</span> up<span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span>
            <span class="lini-tok-const">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">3</span><span class="lini-tok-punct">)</span> <span class="lini-tok-const">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">4</span><span class="lini-tok-punct">)</span> close<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-comment">// one wall: the flange, the back wall's leg, the circlip groove</span>
      <span class="lini-tok-prop">mirror</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-comment">// → both walls (the chamber between)</span>
    <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">hole</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">coolant</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-8</span> <span class="lini-tok-number">-42</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-comment">// a cross-drilled coolant hole, mid-wall — off the axis, so the mirror</span>
      <span class="lini-tok-comment">// hands it to both walls: one feature, two copies, '2×' on the reading</span>
      <span class="lini-tok-punct">|</span><span class="lini-tok-type">hole</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">vent</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">16</span> <span class="lini-tok-number">-42</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">mirror</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">none</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
      <span class="lini-tok-comment">// a bleed vent drilled in one wall only — it declines the reflection</span>
    <span class="lini-tok-punct">]</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type-user">bronze</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">bush</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
      <span class="lini-tok-prop">draw</span><span class="lini-tok-punct">:</span> move<span class="lini-tok-punct">(</span><span class="lini-tok-number">12</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">-14</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">right</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">14</span><span class="lini-tok-punct">)</span> down<span class="lini-tok-punct">(</span><span class="lini-tok-number">4</span><span class="lini-tok-punct">)</span> <span class="lini-tok-keyword">left</span><span class="lini-tok-punct">(</span><span class="lini-tok-number">14</span><span class="lini-tok-punct">)</span> close<span class="lini-tok-punct">(</span><span class="lini-tok-punct">)</span><span class="lini-tok-punct">;</span>
      <span class="lini-tok-prop">mirror</span><span class="lini-tok-punct">:</span> <span class="lini-tok-keyword">x-axis</span><span class="lini-tok-punct">;</span>
    <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the shaft bush, pressed in — adjacent parts hatch opposite ways</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">centerline</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">points</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">-34</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">,</span> <span class="lini-tok-number">34</span> <span class="lini-tok-number">0</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// the chamber axis</span>

    wall<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> wall:<span class="lini-tok-keyword">right</span> { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// 52 deep</span>
    wall<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> wall.coolant { side: <span class="lini-tok-keyword">top</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// → 18 — the extension line breaks where it crosses the hatched</span>
    <span class="lini-tok-comment">// wall [SPEC 15.7]</span>
    wall.coolant <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span>
    <span class="lini-tok-comment">// → 2× ⌀6 — the mirror's copies prefix the count; the leader breaks</span>
    <span class="lini-tok-comment">// over the wall's outer edge</span>
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">drawing</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">det</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">of</span><span class="lini-tok-punct">:</span> c<span class="lini-tok-punct">;</span> <span class="lini-tok-prop">scale</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">3</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span> <span class="lini-tok-punct">[</span>
    <span class="lini-tok-prop-user">body</span><span class="lini-tok-punct">:</span>c1 <span class="lini-tok-punct">(</span>o<span class="lini-tok-punct">)</span>
    <span class="lini-tok-comment">// → R12 — the detail dimensions the re-laid copy by the id it carries</span>
  <span class="lini-tok-punct">]</span>

  <span class="lini-tok-punct">|</span><span class="lini-tok-type">title-block</span><span class="lini-tok-punct">|</span> <span class="lini-tok-punct">{</span>
    <span class="lini-tok-prop">title</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;Pump body&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">drawing-number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;LN-PMP-24-001&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">revision</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;B&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">sheet-number</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;1/1&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">date</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;2026-08-30&quot;</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">author</span><span class="lini-tok-punct">:</span> <span class="lini-tok-string">&quot;AM&quot;</span><span class="lini-tok-punct">;</span>
  <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">]</span>

