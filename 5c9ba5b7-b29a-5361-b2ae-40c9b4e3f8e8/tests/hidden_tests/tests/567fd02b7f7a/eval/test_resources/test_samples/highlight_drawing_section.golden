    <span class="lini-tok-comment">// a vertical plane on the chamber axis, viewing right</span>
    <span class="lini-tok-punct">|</span><span class="lini-tok-type">magnifier</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">c</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;C&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">width</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">30</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">translate</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">48</span> <span class="lini-tok-number">-40</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
    <span class="lini-tok-comment">// a corner hole, ringed for detail</span>

    body<span class="lini-tok-punct">:</span><span class="lini-tok-keyword">left</span> <span class="lini-tok-punct">(</span>-<span class="lini-tok-punct">)</span> body:<span class="lini-tok-keyword">right</span> { side: <span class="lini-tok-keyword">bottom</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
