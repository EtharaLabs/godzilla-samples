<span class="lini-tok-punct">|</span><span class="lini-tok-type">I</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">I2</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;20m&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">5</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> ac<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">BT</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">BT1</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;3V&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">6</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
<span class="lini-tok-punct">|</span><span class="lini-tok-type">BT</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">BT2</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;12V&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">7</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> battery<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>
