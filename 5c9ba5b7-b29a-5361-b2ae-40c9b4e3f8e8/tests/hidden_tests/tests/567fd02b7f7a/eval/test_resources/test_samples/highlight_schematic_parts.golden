<span class="lini-tok-punct">|</span><span class="lini-tok-type">SW</span><span class="lini-tok-punct">#</span><span class="lini-tok-type">SW2</span><span class="lini-tok-punct">|</span> <span class="lini-tok-string">&quot;RST&quot;</span> <span class="lini-tok-punct">{</span> <span class="lini-tok-prop">cell</span><span class="lini-tok-punct">:</span> <span class="lini-tok-number">9</span> <span class="lini-tok-number">4</span><span class="lini-tok-punct">;</span> <span class="lini-tok-prop">symbol</span><span class="lini-tok-punct">:</span> push<span class="lini-tok-punct">;</span> <span class="lini-tok-punct">}</span>

<span class="lini-tok-comment">// A `|TP|` carries one pin — legal, and what a probe pad is [SPEC 16.2].</span>
