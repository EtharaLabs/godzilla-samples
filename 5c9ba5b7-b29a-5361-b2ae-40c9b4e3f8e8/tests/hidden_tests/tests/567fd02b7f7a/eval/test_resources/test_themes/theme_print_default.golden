exit: 0
--- stdout
/* lini theme — copy & edit. Colours; sizes are baked, not themeable. */
:root, .lini {
  color-scheme: light dark;
  --lini-accent: light-dark(#0a84ff, #4aa3ff);
  --lini-accent-text: white;
  --lini-amber: light-dark(#cb8b00, #9e6000);
  --lini-amber-deep: light-dark(#9f6900, #dba200);
  --lini-amber-ink: light-dark(#6d3b00, #ffdf5c);
  --lini-amber-soft: light-dark(#eec978, #593900);
  --lini-amber-wash: light-dark(#feedca, #35280a);
  --lini-bg: light-dark(white, #1b1b1f);
  --lini-blue: light-dark(#3f98ff, #006cd3);
  --lini-blue-deep: light-dark(#2774ce, #62aeff);
  --lini-blue-ink: light-dark(#004496, #a0ecff);
  --lini-blue-soft: light-dark(#9fd1ff, #113f75);
  --lini-blue-wash: light-dark(#daf1ff, #192b41);
  --lini-caption-color: light-dark(rgba(0, 0, 0, 0.5), rgba(255, 255, 255, 0.55));
  --lini-caption-font-weight: 400;
  --lini-component-fill: light-dark(#fdf6d8, #3a3626);
  --lini-component-stroke: light-dark(#8a1c1c, #d98f8f);
  --lini-cyan: var(--lini-teal);
  --lini-danger: light-dark(crimson, #ff6b6b);
  --lini-fg: light-dark(black, #e8e8ea);
  --lini-fill: light-dark(white, #26262b);
  /* --lini-font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; */
  --lini-font-weight: 500;
  --lini-footer-color: light-dark(rgba(0, 0, 0, 0.5), rgba(255, 255, 255, 0.55));
  --lini-gray: light-dark(#989898, #6f6f6f);
  --lini-gray-deep: light-dark(#747474, #acacac);
  --lini-gray-ink: light-dark(#484848, #e8e8e8);
  --lini-gray-soft: light-dark(#cecece, #404040);
  --lini-gray-wash: light-dark(#eeeeee, #2a2a2a);
  --lini-green: light-dark(#00b66e, #008a45);
  --lini-green-deep: light-dark(#008d51, #42c887);
  --lini-green-ink: light-dark(#005d26, #8bffc3);
  --lini-green-soft: light-dark(#94e2b5, #004f2a);
  --lini-green-wash: light-dark(#d6f8e3, #143121);
  --lini-grid: light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.14));
  --lini-group-fill: light-dark(rgba(0, 0, 0, 0.03), rgba(255, 255, 255, 0.05));
  --lini-group-stroke: light-dark(rgba(0, 0, 0, 0.4), rgba(255, 255, 255, 0.4));
  --lini-header-fill: light-dark(rgba(0, 0, 0, 0.06), rgba(255, 255, 255, 0.08));
  --lini-icon-fill: light-dark(rgba(0, 0, 0, 0.16), rgba(255, 255, 255, 0.18));
  --lini-indigo: var(--lini-purple);
  --lini-label-ink: light-dark(#0e6a6a, #57c4c4);
  --lini-lime: light-dark(#82a900, #5a7d00);
  --lini-lime-deep: light-dark(#628200, #98bc42);
  --lini-lime-ink: light-dark(#385300, #d3f986);
  --lini-lime-soft: light-dark(#c0da8f, #354800);
  --lini-lime-wash: light-dark(#e8f4d3, #252e13);
  --lini-link-font-weight: 400;
  --lini-muted: light-dark(#888, #9aa0a6);
  --lini-orange: light-dark(#e47600, #b44a00);
  --lini-orange-deep: light-dark(#b45700, #f39042);
  --lini-orange-ink: light-dark(#7e2800, #ffcd84);
  --lini-orange-soft: light-dark(#ffbd8d, #662e00);
  --lini-orange-wash: light-dark(#ffe8d2, #3b2413);
  --lini-pin-number: light-dark(#00000073, #ffffff80);
  --lini-pink: var(--lini-rose);
  --lini-purple: light-dark(#9084ff, #6858d0);
  --lini-purple-deep: light-dark(#6e62cc, #a39cff);
  --lini-purple-ink: light-dark(#443394, #ded9ff);
  --lini-purple-soft: light-dark(#c6c4ff, #3c3574);
  --lini-purple-wash: light-dark(#eaebff, #282741);
  --lini-red: light-dark(#ef675e, #bd3936);
  --lini-red-deep: light-dark(#bc4943, #fd8379);
  --lini-red-ink: light-dark(#851618, #ffc1b5);
  --lini-red-soft: light-dark(#ffb5ac, #6b2622);
  --lini-red-wash: light-dark(#ffe4df, #3e211e);
  --lini-rose: light-dark(#e96490, #b83667);
  --lini-rose-deep: light-dark(#b8476e, #f880a5);
  --lini-rose-ink: light-dark(#811442, #ffbee0);
  --lini-rose-soft: light-dark(#ffb2c9, #68243c);
  --lini-rose-wash: light-dark(#ffe3ec, #3c2028);
  --lini-shadow-color: light-dark(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.5));
  --lini-sheet: light-dark(#faf6ea, #22201b);
  --lini-sky: light-dark(#00ace2, #0080b4);
  --lini-sky-deep: light-dark(#0085b3, #00c0f0);
  --lini-sky-ink: light-dark(#00547e, #5ffdff);
  --lini-sky-soft: light-dark(#7eddfd, #004a65);
  --lini-sky-wash: light-dark(#cff6ff, #0a2f3a);
  --lini-stray: light-dark(crimson, #ff6b6b);
  --lini-stroke: light-dark(#444, #9aa0a6);
  --lini-stroke-dark: light-dark(black, white);
  --lini-stroke-light: light-dark(rgba(0, 0, 0, 0.545), rgba(255, 255, 255, 0.64));
  --lini-teal: light-dark(#00b8ac, #008b81);
  --lini-teal-deep: light-dark(#008e85, #00cabe);
  --lini-teal-ink: light-dark(#005d56, #4ffffa);
  --lini-teal-soft: light-dark(#79e3da, #004f4a);
  --lini-teal-wash: light-dark(#cdf9f4, #07312e);
  --lini-text-color: var(--lini-fg);
  --lini-tip-bg: light-dark(#333, #e8e8ea);
  --lini-tip-fg: light-dark(white, #1a1a1f);
  --lini-warn: light-dark(orange, #ffb454);
  --lini-wire: light-dark(#0a7a2f, #4cc472);
  --lini-yellow: var(--lini-amber);
}

--- stderr
