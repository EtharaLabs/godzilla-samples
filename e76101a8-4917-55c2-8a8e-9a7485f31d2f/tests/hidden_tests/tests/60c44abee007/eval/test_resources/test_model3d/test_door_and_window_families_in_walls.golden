der {"view": "{3D}", "width": 320, "height": 200, "path": "3d.png"}' --cmd 'render {"family": "Pivot Door", "type": "1200 x 2400", "mode": "plan", "wall_thickness": 300, "width": 320, "height": 200, "path": "door-plan.png"}'
