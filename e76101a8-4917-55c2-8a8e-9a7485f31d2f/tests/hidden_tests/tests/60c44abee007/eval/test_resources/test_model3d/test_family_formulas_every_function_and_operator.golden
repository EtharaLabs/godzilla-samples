$ bimcraft-cli run --cmd 'family {"name": "Maths", "category": "generic", "parameters": [{"name": "W", "kind": "length", "value": 1200}, {"name": "D", "kind": "length", "value": 450}, {"name": "A", "kind": "number", "formula": "if(W > 1000, 4, 2)"}, {"name": "B", "kind": "number", "formula": "and(W > 1000, D < 500) + or(W < 0, D = 450) * 10 + not(W)"}, {"name": "C", "kind": "number", "formula": "min(W, D, 300) + max(1, 2, 3) + abs(-7)"}, {"name": "E", "kind": "number", "formula": "sqrt(16) + round(2.5) + roundup(2.1) + rounddown(2.9)"}, {"name": "F", "kind": "number", "formula": "sin(30) + cos(60) + tan(45)"}, {"name": "G", "kind": "number", "formula": "asin(0.5) + acos(0.5) + atan(1)"}, {"name": "H", "kind": "number", "formula": "exp(1) + ln(10) + log(1000)"}, {"name": "I", "kind": "number", "formula": "pi() * 2 ^ 3 ^ 0.5"}, {"name": "J", "kind": "number", "formula": "(W >= 1200) + (D <= 449) + (W < D) + (W > D) + -(-3) + +2"}, {"name": "K", "kind": "number", "formula": "1e3 + 2.5E-1 + .5"}, {"name": "L", "kind": "number", "formula": "((W - D) / (2 * (1 + 1))) - W / 4 * 2"}, {"name": "M", "kind": "length", "formula": "A + C * 2"}], "types": {"Wide": {}, "Narrow": {"W": 800}}}' --cmd 'family {"name": "Maths", "dry_run": true}'
[exit 0]
