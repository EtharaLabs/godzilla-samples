$ bimcraft-cli run --cmd 'wall {"points": [[0,0],[6000,0],[6000,4000],[0,4000]], "closed": true}' --cmd 'roof {}' --cmd 'add_point {"id": 100006, "at": [3000, 2000], "z": 200}' --cmd 'add_split_line {"id": 100006, "a": [0, 2000], "b": [6000, 2000]}' --cmd 'edit_shape {"id": 100006}'
