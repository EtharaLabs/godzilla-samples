$ bimcraft-cli run --cmd 'wall {"points": [[0,0],[6000,0],[6000,4000],[0,4000]], "closed": true, "type": "Exterior - 300mm"}' --cmd 'wall {"points": [[3000,0],[3000,4000]], "type": "Interior - 100mm"}' --cmd 'dimension_type {"name": "Diagonal - 2.5mm Arial", "font": "IBM Plex Sans"}' --cmd 'dimension_type {"name": "Arrow - 2.5mm Arial", "font": "IBM Plex Sans"}' --cmd 'text_type {"name": "2.5mm", "font": "IBM Plex Sans"}' --cmd 'text_type {"name": "3.5mm", "font": "IBM Plex Sans"}' --cmd 'text_type {"name": "5mm", "font": "IBM Plex Sans"}' --cmd 'section {"start": [-1000, 2000], "end": [7000, 2000]}' --cmd 'sheet {"size": "A4"}' --cmd 'text {"text": "General notes:\n1. Check on site.", "at": [20, 190], "view": "A101", "type": "3.5mm"}' --cmd 'detail_line {"points": [[20, 170], [120, 170]], "view": "A101", "style": "Wide Lines"}' --cmd 'filled_region {"sketch": [[[20,150],[60,150]],[[60,150],[60,160]],[[60,160],[20,160]],[[20,160],[20,150]]], "view": "A101", "type": "Crosshatch"}' --cmd 'text {"text": "Cut here", "at": [2000, 1500], "view": "Section 1"}' --cmd 'elements {"category": "text"}' --cmd 'render {"view": "A101", "path": "a101.pdf"}' --cmd 'render {"view": "Section 1", "path": "section.png", "width": 400, "height": 300}'
[exit 0]
