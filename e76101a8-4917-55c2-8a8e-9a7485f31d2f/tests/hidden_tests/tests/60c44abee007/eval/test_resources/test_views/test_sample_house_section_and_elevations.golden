$ bimcraft-cli run --sample --cmd 'dimension_type {"name": "Diagonal - 2.5mm Arial", "font": "IBM Plex Sans"}' --cmd 'dimension_type {"name": "Arrow - 2.5mm Arial", "font": "IBM Plex Sans"}' --cmd 'text_type {"name": "2.5mm", "font": "IBM Plex Sans"}' --cmd 'text_type {"name": "3.5mm", "font": "IBM Plex Sans"}' --cmd 'text_type {"name": "5mm", "font": "IBM Plex Sans"}' --cmd 'render {"view": "Section 1", "path": "Section 1.png", "width": 400, "height": 300}' --cmd 'render {"view": "North", "path": "North.png", "width": 400, "height": 300}' --cmd 'render {"view": "South", "path": "South.png", "width": 400, "height": 300}' --cmd 'render {"view": "East", "path": "East.png", "width": 400, "height": 300}' --cmd 'render {"view": "West", "path": "West.png", "width": 400, "height": 300}'
[exit 0]
