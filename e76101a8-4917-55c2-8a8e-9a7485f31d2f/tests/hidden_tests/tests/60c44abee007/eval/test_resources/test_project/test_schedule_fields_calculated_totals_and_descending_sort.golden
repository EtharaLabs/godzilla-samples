$ bimcraft-cli run sample.bimcraft --cmd 'schedule {"name": "Paint", "category": "rooms", "fields": ["Name", "Perimeter", {"name": "Paint", "formula": "Perimeter * 2600 / 1000000", "kind": "area", "total": true, "heading": "Paint area"}, {"name": "Area", "total": true}, {"name": "Big", "formula": "Area > 15", "kind": "yesno"}, {"name": "Cost", "formula": "Area * 120", "kind": "number", "total": true}], "sort": [{"field": "Area", "descending": true}, "Name"]}' --cmd 'schedule {"name": "Paint"}'
[exit 0]
