func uses() int {
	_ = func(v any) bool { _, ok := v.(interface{ run() }); return ok }
	var _ husher
	var v struct {
		boxed
		size int
	}
	return named{}.Size + named{}.size() + len(named{}.name+named{}.Name()) + derived{}.hop + v.Size + v.size +
		amb{}.f + t{}.F + u{}.F + both{}.id + both{}.Id + pair{}.id + pair{}.Id
}

var (
	_ = asked{}.Run
	_ = quiet{}.Hush
	_ = derived{}.Hop
	_ = uses
)
