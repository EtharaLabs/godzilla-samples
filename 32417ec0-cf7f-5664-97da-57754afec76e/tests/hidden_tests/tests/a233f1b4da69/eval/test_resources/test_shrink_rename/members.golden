package r

type named struct {
	name string
	Size int
}

func (named) Name() string { return "" }

func (named) size() int { return 0 }

type asked struct{}

func (asked) Run() {}

type quiet struct{}

func (quiet) Hush() {}

type husher interface{ hush() }

type base struct{}

func (base) Hop() {}

type derived struct {
	base
	hop int
}

type boxed struct {
	Size int
}

