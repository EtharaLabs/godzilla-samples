=== .declscope.yaml
# The naming rule is off by default, and this package asserts what it does
# once a second namespace puts it in force.
rules:
  naming:
    qualify: ondemand

=== a.go
package fixsiblings

// Prefixing is not injective across namespaces: bX in namespace "a" and x in
