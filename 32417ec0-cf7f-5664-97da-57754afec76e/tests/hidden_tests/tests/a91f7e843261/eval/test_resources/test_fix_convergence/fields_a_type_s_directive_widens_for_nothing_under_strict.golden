=== user.go
package x

//declscope:shared
type account struct {
	id int

	// balance is local.
	//
	//declscope:private
	balance int
	//declscope:private
	left, right int
}

//declscope:shared
type tiny struct {
	id int
	//declscope:private
	n int
}

func userLocal(a account, t tiny) int { return a.balance + a.left + a.right + t.n }

var _ = userLocal

