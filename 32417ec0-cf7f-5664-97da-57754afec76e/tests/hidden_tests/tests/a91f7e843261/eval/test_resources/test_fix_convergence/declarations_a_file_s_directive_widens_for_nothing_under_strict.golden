//declscope:shared

package x

// userShared is called from order.go.
func userShared() int { return userLocal() }

// userLocal is not.
//
//declscope:private
func userLocal() int { return 1 }

//declscope:private
var userA, userB = 1, 2

//declscope:private
type box struct {
	n int
}

type pair struct {
	x int
	//declscope:private
	y int
}

func userPair() pair { return pair{} }

var _ = userA + userB + box{}.n + userPair().y

