package user

import "fmt"

func Load(id int) string { return format(id) }

// format renders an ID for display.
func format(id int) string { return fmt.Sprint(id) }

type Record struct {
	ID   int
	Name string
}

func Dump(r Record) { fmt.Println(r) }

