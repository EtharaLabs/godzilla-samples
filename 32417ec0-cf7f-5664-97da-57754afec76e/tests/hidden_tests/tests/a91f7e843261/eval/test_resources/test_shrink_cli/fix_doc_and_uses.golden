=== user/user.go
package user

import "fmt"

func Load(id int) string { return format(id) }

// format renders an ID for display.
func format(id int) string { return fmt.Sprint(id) }

// Record is one row.
type Record struct {
	ID   int
	Name string
}

// Counter counts.
type Counter struct{ n int }

// bump adds one.
func (c *Counter) bump() { c.n++ }

func NewCounter() *Counter { c := &Counter{}; f := c.bump; f(); return c }

func Dump(r Record) { fmt.Println(r) }

