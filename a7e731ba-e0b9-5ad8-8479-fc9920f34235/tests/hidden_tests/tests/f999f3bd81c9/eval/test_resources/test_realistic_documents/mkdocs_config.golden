site_name: My Docs
site_description: >-
  Project documentation with Markdown, written so that the description
  runs past the configured prose width.
theme:
  name: material
  features: [navigation.tabs, search.suggest]
nav:
  - Home: index.md
  - 'User Guide':
    - 'Writing your docs': user-guide/writing-your-docs.md
    - Styling: user-guide/styling-your-docs.md
  - About: about.md
markdown_extensions:
  - toc:
      permalink: true
  - admonition
plugins: [search]
extra:
  version: ~
  analytics: null
  social: []
