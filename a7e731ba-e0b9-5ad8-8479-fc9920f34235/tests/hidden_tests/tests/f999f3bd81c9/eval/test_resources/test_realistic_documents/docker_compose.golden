version: "3.9"
x-common: &common
  restart: unless-stopped
  logging:
    driver: json-file
    options: {max-size: 10m, max-file: "3"}
services:
  web:
    <<: *common
    image: nginx:1.25
    ports:
      - 80:80
      - 443:443
    volumes:
      - ./site:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on: [api]
  api:
    <<: *common
    build:
      context: ./api
      args:
        - NODE_ENV=production
    environment:
      DATABASE_URL: postgres://app:secret@db:5432/app
      FEATURE_FLAGS: yes
      TIMEOUT: "30"
  db:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: secret
    healthcheck:
      test: [CMD-SHELL, pg_isready -U app]
      interval: 10s
volumes:
  data: {}
