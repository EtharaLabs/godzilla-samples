name: CI
on:
  push:
    branches: [main, release/**]
  pull_request:
    types: [opened, synchronize]
env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: '1'
jobs:
  test:
    name: "Test (${{ matrix.os }})"
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        toolchain: [stable, "1.80"]
    steps:
      - uses: actions/checkout@v4
      - name: Install toolchain
        uses: dtolnay/rust-toolchain@master
        with: { toolchain: "${{ matrix.toolchain }}", components: "clippy, rustfmt" }
      - name: Run tests
        run: |
          cargo test --all-features
          cargo clippy -- -D warnings
      - name: >-
          Upload coverage report to the coverage service so that pull requests
          show a coverage delta comment
        if: ${{ matrix.os == 'ubuntu-latest' }}
        run: bash <(curl -s https://example.com/upload.sh) # upload
