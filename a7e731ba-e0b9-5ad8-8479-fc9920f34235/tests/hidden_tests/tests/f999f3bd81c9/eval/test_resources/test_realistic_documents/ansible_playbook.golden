---
- hosts: webservers
  become: yes
  vars:
    http_port: 80
    packages: [nginx, git]
  tasks:
  - name: ensure packages are installed
    ansible.builtin.apt:
      name: "{{ packages }}"
      state: present
  - name: write the nginx config file
    ansible.builtin.template: src=templates/nginx.j2 dest=/etc/nginx/nginx.conf
    notify:
    - restart nginx
  handlers:
  - name: restart nginx
    ansible.builtin.service: name=nginx state=restarted
