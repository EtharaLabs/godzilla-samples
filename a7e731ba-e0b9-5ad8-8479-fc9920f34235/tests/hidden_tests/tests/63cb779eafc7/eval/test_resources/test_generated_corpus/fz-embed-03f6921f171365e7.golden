{
 "status": 0,
 "stdout": "# fmt: markdown\n- \"\"\n- tail\n",
 "stderr": "",
 "files": {
  "yamark.toml": "[embedded.upper]\nformatter = { command = [\"sh\", \"-c\", \"tr a-z A-Z\", \"{path}\"], path_suffix = \".txt\" }\n[embedded.grow]\nformatter = { command = [\"sh\", \"-c\", \"cat; echo extra\", \"{path}\"], path_suffix = \".txt\" }\n[embedded.fail]\nformatter = { command = [\"sh\", \"-c\", \"echo bad >&2; exit 1\", \"{path}\"], path_suffix = \".txt\" }\n[embedded.empty]\nformatter = { command = [\"sh\", \"-c\", \"cat >/dev/null\", \"{path}\"], path_suffix = \".txt\" }\n"
 }
}
