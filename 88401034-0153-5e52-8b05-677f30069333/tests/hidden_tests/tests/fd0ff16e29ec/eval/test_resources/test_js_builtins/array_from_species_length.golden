after: [1, 2, <hole>] | {value: 3, writable: false, enumerable: false, configurable: false}
assign-len-nonwritable-strict: THROW TypeError: cannot assign to read-only property 'length'
shrink-past-nonconfig: THROW TypeError: cannot delete non-configurable array element via length
shrink-result: [1, "pinned"] | 2
