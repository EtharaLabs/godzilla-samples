species-ctor-not-obj: THROW TypeError: Array @@species is not a constructor
species-getter: "val"
truncate: [1, 2] | 2
extend: [1, 2, <hole>, <hole>]
index-extends: 10
max-index: 4294967295
not-index: 0 | ["4294967295"]
