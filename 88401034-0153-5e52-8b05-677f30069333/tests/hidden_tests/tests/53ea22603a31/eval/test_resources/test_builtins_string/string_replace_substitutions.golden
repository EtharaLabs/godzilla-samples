regex captures => ["01/2020 01 $3 | 2020 20200 $00", "a[b$2]c"]
replacer fn args => [["-", 1, "x-y-"]]
replacer fn result coerced => ["a42c", "anullc", "aTc"]
replacer not $-expanded => "a$&$&c"
search coercion => ["aXb", "a_b", "U", "a;b"]
