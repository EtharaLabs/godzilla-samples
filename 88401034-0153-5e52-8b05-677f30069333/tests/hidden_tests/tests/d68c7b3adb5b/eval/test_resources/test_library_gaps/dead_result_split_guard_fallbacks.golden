sticky $ never matches before the end: $1="-" lastMatch="-" input="-"
sticky match at the last position: $1="1" lastMatch="1" input="xa1"
sticky split: $1="2" lastMatch="2" input="p1q2r"
prototype.constructor replaced: $1="8" lastMatch="8" input="q8r"
result with replaced constructor: ["q","8","r"]
accessor global: $1=4 lastMatch=4
result: ["w","5","x"]
