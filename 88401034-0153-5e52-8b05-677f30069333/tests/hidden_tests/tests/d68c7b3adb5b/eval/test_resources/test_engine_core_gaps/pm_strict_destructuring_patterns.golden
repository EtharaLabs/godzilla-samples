# strict destructuring assignment
"\"use strict\"; var a, r; [a, , ...r] = [1, 2, 3, 4]; a + \"|\" + r" => ok "1|3,4"
"\"use strict\"; var a, b; [a = 1, b] = []; ({ k: a = 2, b = 3 } = {}); a + b" => ok 5
"\"use strict\"; var a, c, d; ({ a, b: c = 9, ...d } = { a: 1, e: 5 }); [a, c, JSON.stringify(d)].join(\"|\")" => ok "1|9|{\"e\":5}"
"\"use strict\"; var p; ({ __proto__: p } = { __proto__: null }); String(p)" => ok "undefined"
"\"use strict\"; var p2; ({ __proto__: p2 = 4 } = Object.create(null)); p2" => ok 4
"\"use strict\"; var o = {}; ({ ...o.rest } = { z: 1 }); JSON.stringify(o)" => ok "{\"rest\":{\"z\":1}}"
"\"use strict\"; var q; for ([q] of [[5]]); q" => ok 5
"\"use strict\"; [eval] = []" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; [...arguments] = []" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; [arguments = 1] = []" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; [[eval]] = [[]]" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; ({ arguments } = {})" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; ({ eval = 1 } = {})" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; ({ a: eval } = {})" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; ({ a: eval = 1 } = {})" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; ({ __proto__: eval } = {})" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; ({ __proto__: eval = 1 } = {})" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; ({ ...eval } = {})" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; for ([eval] of []);" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; for ({ x: arguments } of []);" => SyntaxError: cannot assign to 'eval' or 'arguments' in strict mode
"\"use strict\"; for ([f()] of []);" => SyntaxError: invalid for-in/of target
"\"use strict\"; for ([1] of []);" => SyntaxError: invalid for-in/of target
# pattern validity
"({ __proto__: a1 = 1 } = {}); a1" => ok [object Object]
"({ ...r4 } = { k: 1 }); JSON.stringify(r4)" => ok "{\"k\":1}"
"({ ...[a2] } = {})" => SyntaxError: invalid destructuring assignment target
"({ ...r3, a3 } = {})" => SyntaxError: invalid destructuring assignment target
"({ m() {} } = {})" => SyntaxError: invalid destructuring assignment target
"({ get g() { return 1; } } = {})" => SyntaxError: invalid destructuring assignment target
"({ a: x = { b = 1 } } = {})" => SyntaxError: invalid shorthand property initializer outside a pattern position
"({ __proto__: x = { c = 1 } } = {})" => SyntaxError: invalid shorthand property initializer outside a pattern position
"({ ...{ y = 1 }.z } = {})" => SyntaxError: invalid shorthand property initializer outside a pattern position
"[...{ w = 1 }.v] = []" => SyntaxError: invalid shorthand property initializer outside a pattern position
"var hole; for ([, hole] of [[1, 2]]); hole" => ok 2
"var o = {}; for ([o.p] of [[1]]); o.p" => ok 1
"for ({ m() {} } of []);" => SyntaxError: invalid for-in/of target
"for ({ a: 1 } of []);" => SyntaxError: invalid for-in/of target
"for ({ a, ...{ b } } of []);" => SyntaxError: invalid for-in/of target
"var { \"a\" } = {}" => SyntaxError: invalid shorthand destructuring target
"let { 1 } = {}" => SyntaxError: invalid shorthand destructuring target
"({ \"a\" } = {})" => SyntaxError: expected ':' after property key
"({ 1 })" => SyntaxError: expected ':' after property key
"({ [k] })" => SyntaxError: expected ':' after property key
# functions, classes and labels
"class C1 { #x = 5; m() { return eval(\"this.#x * 2\"); } } new C1().m()" => ok 10
"class C2 { #x = 5; m() { return eval(\"this.#y\"); } } new C2().m()" => SyntaxError: Private name '#y' is not declared in an enclosing class
"class A extends Object { constructor() { super(); var o = { m() { super(); } }; } }" => SyntaxError: a super call is not allowed here
"class A extends Object { constructor() { super(); var o = { m(a = super()) {} }; } }" => SyntaxError: a super call is not allowed here
"(async function () { for await (var x = 0 in {}) ; })" => SyntaxError: 'for await' is only valid with a for-of head
"\"use strict\"; (implements => 1)" => SyntaxError: 'implements' cannot be used as a binding in strict mode
"\"use strict\"; (yield => 1)" => SyntaxError: 'yield' cannot be used as a binding in strict mode
"(async function () { (await => 1); })" => SyntaxError: 'await' cannot be used as a binding here
"(async await => 1)" => SyntaxError: 'await' cannot be used as a binding here
"class S3 { static { (await => 1); } }" => SyntaxError: 'await' cannot be used as a binding here
"class S4 { static { (async () => await 1); } } \"static block async arrow\"" => ok "static block async arrow"
"({ set s(v) { \"use strict\"; } }) && \"strict setter\"" => ok "strict setter"
"({ set s(static) { \"use strict\"; } })" => SyntaxError: 'static' cannot be used as a binding in strict mode
"class A1 { accessor x; } Object.getOwnPropertyNames(A1.prototype).join()" => ok "constructor,x"
"function* g() { L1: yield: 1; }" => SyntaxError: 'yield' cannot be used as a label here
"async function af() { L1: L2: await: 1; }" => SyntaxError: 'await' cannot be used as a label here
"L: function f(,) {}" => SyntaxError: expected binding identifier
