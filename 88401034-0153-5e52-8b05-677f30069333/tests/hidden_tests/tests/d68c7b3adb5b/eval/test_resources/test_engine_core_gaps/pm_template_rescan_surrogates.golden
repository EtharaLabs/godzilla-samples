# template substitutions re-scanned by the lexer
"`[${ \"a\\\"}b\" }]`" => ok "[a\"}b]"
"`[${ 'c\\'{d' }]`" => ok "[c'{d]"
"`[${ `in\\`ner${ 1 + 1 }` }]`" => ok "[in`ner2]"
"`[${ /a\\/[/}]b/.source }]`" => ok "[a\\/[/}]b]"
"`[${ /x/gimsuy.flags }]`" => ok "[gimsuy]"
"`[${ 1 /* } */ + 2 }]`" => ok "[3]"
"`[${ 1 // }\n + 3 }]`" => ok "[4]"
"`${ /* never closed" => SyntaxError: unterminated comment in template
"`${ \"never closed" => SyntaxError: unterminated string in template
"`${ `never closed" => SyntaxError: unterminated nested template
"`${ /never closed" => SyntaxError: unterminated regex in template
"`${ 0x }`" => SyntaxError: invalid numeric literal
"String.raw`a${ 0b2 }b`" => SyntaxError: invalid numeric literal
"`trailing backslash\\" => SyntaxError: unterminated template literal
# template escapes
[null] raw=["\\u{123456789}"]
[null,"A"] raw=["a\\u{110000}b","\\u{00000041}"]
SyntaxError: invalid escape sequence in template literal
SyntaxError: invalid escape sequence in template literal
# surrogate escapes
"\"\\uD83D\\u{DE00}\".codePointAt(0).toString(16)" => ok "1f600"
"\"\\uD83D\\u{DE00\".length" => SyntaxError: unterminated \u{...} escape
"\"\\uD83D\\uDE0\".length" => SyntaxError: bad \u escape
"\"\\uD83D\\uZZZZ\".length" => SyntaxError: bad \u escape
"\"\\uDBFF\\uDFFF\".codePointAt(0).toString(16) + \"/\" + \"\\uDBFF\\uDFFF\".length" => ok "10ffff/2"
"\"\\uDBFF\\uDFFF\" === \"\\u{10FFFF}\"" => ok true
"\"\\uD800\\u0041\".length + \"/\" + \"\\uD800\\u0041\".charCodeAt(0).toString(16) + \"/\" + \"\\uD800\\u0041\".charCodeAt(1)" => ok "2/d800/65"
"\"\\uD800\\u{41}\".charCodeAt(1)" => ok 65
# regex literal line terminators
"/a\\\nb/" => SyntaxError: unterminated regular expression
"/a\\<LS>b/" => SyntaxError: unterminated regular expression
"/a\\ b/.source" => ok "a\\ b"
