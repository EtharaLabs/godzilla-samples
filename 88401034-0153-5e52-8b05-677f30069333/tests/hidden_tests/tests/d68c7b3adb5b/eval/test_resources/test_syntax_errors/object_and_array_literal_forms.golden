# literal forms
"({ 1.0: \"a\", 1e3: \"b\", .5: \"c\", 0x10: \"d\", 1n: \"e\", \"01\": \"f\" }) && Object.keys({ 1.0: \"a\", 1e3: \"b\", .5: \"c\", 0x10: \"d\", 1n: \"e\", \"01\": \"f\" }).join()" => ok "1,16,1000,0.5,01"
"[1, , 3,].length" => ok 3
"[, , ,].length" => ok 3
"[...[1, 2], ...[], ...[3]].join()" => ok "1,2,3"
"({ ...null, ...undefined, ...123, ...\"ab\", ...[9] })[1]" => ok "b"
"var log = []; ({ [log.push(1)]: log.push(2), [log.push(3)]: log.push(4) }); log.join()" => ok "1,2,3,4"
"({ a: 1, a: 2 }).a" => ok 2
"({ get a() { return 1; }, a: 2 }).a" => ok 2
"({ a: 2, get a() { return 1; } }).a" => ok 1
"({ set a(v) {}, get a() { return \"both\"; } }).a" => ok "both"
"({ async *gen() { yield 1; } }).gen.constructor.name" => ok "AsyncGeneratorFunction"
"({ \"constructor\"() { return 1; } }).constructor()" => ok 1
"({ __proto__() { return \"method\"; } }).__proto__()" => ok "method"
"({ get __proto__() { return \"getter\"; } }).__proto__" => ok "getter"
"Object.getPrototypeOf({ [\"__proto__\"]: null }) === Object.prototype" => ok true
"`a${1}${2}b`" => ok "a12b"
"\"\\u{10FFFF}\".codePointAt(0).toString(16)" => ok "10ffff"
"[0b11, 0o17, 0x1f, 1e2, 1E-2, .1, 1., 1_0].join()" => ok "3,15,31,100,0.01,0.1,1,10"
"typeof /regex/" => ok "object"
"(() => ({}))().constructor === Object" => ok true
"[function () {}][0].name" => ok ""
"({ f: function () {} }).f.name" => ok "f"
"({ [\"computed\" + \"Name\"]: () => {} }).computedName.name" => ok "computedName"
"({ [Symbol.iterator]: function () {} })[Symbol.iterator].name" => ok "[Symbol.iterator]"
"({ 123: function () {} })[123].name" => ok "123"
"new Function(\"a\", \"b\", \"return a + b\")(1, 2)" => ok 3
