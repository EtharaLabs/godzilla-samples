"class A { accessor x = 1; static accessor #y = 2; } new A().x" => ok 1
"class A { accessor\nx = 1 } new A().accessor" => ok
"class A { get\nx() { return 1; } } new A().x" => ok 1
"class A { static\nm() { return 2; } } A.m()" => ok 2
"class A { async\nm() {} }" => ok
"class A { \"a b\"() { return 1; } 42() { return 2; } [Symbol.iterator]() {} get [1 + 1]() { return 3; } static 0x10 = 4 } new A()[\"a b\"]() + new A()[42]() + new A()[2] + A[16]" => ok 10
"class A { x; y = 1; z } Object.keys(new A()).join()" => ok "x,y,z"
"class A { static x = this; } A.x === A" => ok true
"class A { #m() { return 1; } static has(o) { return #m in o; } } A.has(new A()) + \"\" + A.has({})" => ok "truefalse"
"class A { get #g() { return \"g\"; } t() { return this.#g; } } new A().t()" => ok "g"
"class A { static #s() { return \"s\"; } static t() { return A.#s(); } } A.t()" => ok "s"
"class A { ; ; m() {} ; } 8" => ok 8
