# assignment targets
"1 = 2" => SyntaxError: invalid assignment target
"a + 1 = 2" => SyntaxError: invalid assignment target
"f() = 1" => ReferenceError: f is not defined
"f()++" => ReferenceError: f is not defined
"++f()" => ReferenceError: f is not defined
"(a, b) = 1" => SyntaxError: invalid assignment target
"[a, ...b,] = []" => SyntaxError: invalid destructuring assignment target
"[...a, b] = []" => SyntaxError: invalid destructuring assignment target
"[...a = 1] = []" => SyntaxError: invalid destructuring assignment target
"({...{a}} = {})" => SyntaxError: invalid destructuring assignment target
"({...[a]} = {})" => SyntaxError: invalid destructuring assignment target
"({a: 1} = {})" => SyntaxError: invalid destructuring assignment target
"({a = 1})" => SyntaxError: invalid shorthand property initializer
"({a = 1}) => 1" => ok fn
"({a = 1} = {}); 1" => ok 1
"[{a = 1}] = [{}]; 2" => ok 2
"({ a: { b = 1 } }); 3" => SyntaxError: invalid shorthand property initializer
"(a = 1) = 2" => SyntaxError: invalid assignment target
"[a] = [1]; a" => ok 1
"({a: b.c} = {a: 1}); b.c" => ReferenceError: b is not defined
"var b = {}; [b[\"x\"], b.y] = [1, 2]; b.x + b.y" => ok 3
"for ([a, b = 1, ...c] of [[1]]) ; a + \"\" + b + c.length" => ok "110"
"for ({x, y: z = 2, __proto__: p, ...rest} of [{x: 1, w: 9}]) ; x + z + rest.w" => ok 12
"for ([a.b] of [[1]]) ;" => ok
"for ([x, ...[y, z]] of [[1, 2, 3]]) ; y + z" => ok 5
"for ({a = 1} in {}) ;" => ok
"for ([a, ...b, c] of []) ;" => SyntaxError: invalid for-in/of target
"for ({...{a}} of []) ;" => SyntaxError: invalid for-in/of target
"for (f() of []) ;" => ok
"for (f() in {}) ;" => ok
"for (a + 1 of []) ;" => SyntaxError: invalid for-in/of target
"for (async of []) ;" => SyntaxError: 'async' as a for-of left side must be parenthesized
"for (async of => 1;;) break" => ok
"for ((async) of []) ; 1" => ok 1
"for (let of of []) ;" => ok
"for (let in {}) ;" => ok
"++1" => SyntaxError: invalid increment/decrement operand
"x++ = 1" => SyntaxError: invalid assignment target
"new.target = 1" => SyntaxError: new.target is only valid inside a function
"this = 1" => SyntaxError: invalid assignment target
"import.meta = 1" => SyntaxError: 'import.meta' is only valid in a module
"[a, b] += 1" => SyntaxError: invalid assignment target
"({}) => {}; ({} = 1)" => ok 1
"({} = {}); 5" => ok 5
"[,] = []; 6" => ok 6
"[a.b = 1] = []; 7" => ok 7
"a?.b = 1" => SyntaxError: invalid assignment target
"a?.b++" => SyntaxError: invalid increment/decrement operand
"[a?.b] = []" => SyntaxError: invalid destructuring assignment target
"delete a?.b; 8" => ok 8
"(a?.b) = 1" => SyntaxError: invalid assignment target
"`${a}` = 1" => SyntaxError: invalid assignment target
"async () => {}++" => SyntaxError: expected ';'
