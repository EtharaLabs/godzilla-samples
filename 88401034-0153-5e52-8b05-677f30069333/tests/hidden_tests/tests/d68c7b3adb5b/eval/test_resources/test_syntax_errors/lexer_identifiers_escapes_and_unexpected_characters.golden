# identifiers
"var \\u0030x" => SyntaxError: invalid character in escaped identifier
"var a\\u002Fb" => SyntaxError: invalid character in escaped identifier
"var \\u{zz}" => SyntaxError: invalid unicode escape in identifier
"var \\u12" => SyntaxError: invalid unicode escape in identifier
"var \\x41" => SyntaxError: unexpected character '\\'
"\\u0061\\u{62}c = 1" => ok 1
"v\\u0061r x = 1" => SyntaxError: keywords must not contain escape sequences
"#" => SyntaxError: private name '#' may only be used in a member access or 'in' expression
"@" => SyntaxError: expected a decorator expression after '@'
"\u0000" => SyntaxError: unexpected character '\0'
"a ~ b" => SyntaxError: expected ';'
"a b" => ReferenceError: a is not defined
"1 +2" => ok 3
