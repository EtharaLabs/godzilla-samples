# comments and line terminators
"var a = 1, b = 2; a /* comment\n */ ++b; [a, b].join()" => ok "1,3"
"var r = (function () { return /*\n*/ 1; })(); String(r)" => ok "undefined"
"var r2 = (function () { return /* same line */ 2; })(); r2" => ok 2
"var c = 1 c" => ok 1
"var d = 1 d + 1" => ok 2
"var e = 3 // comment e" => ok 3
"/* line sep */ var f2 = 4; f2" => ok 4
"var g2 = 5;\r\ng2" => ok 5
"var h = 6;\rh" => ok 6
"var i2 = 7\n// trailing comment" => ok
"x = 1 /*\n*/ -->html comment after newline in block comment\n; x" => ok 1
"/**/ --> not at line start? ok\n1" => ok 1
"var j = 8 /*a*//*b*/; j" => ok 8
"var k = 9 /* /* nested? */ k" => SyntaxError: expected ';'
"var s = \"a\\ b\"; s.length" => ok 2
"var t = ` `; t.length" => ok 1
"throw /*\n*/ 1" => SyntaxError: illegal newline after throw
"var m = 1; m\n++\nm" => ok 2
"a = b\n(1)" => TypeError: b is not a function
"var q = [1,\n2,\n3\n]; q.length" => ok 3
