species: ["a","b"] ctor \d+ g;ctor \d+ gy
limit coercion: ["a","b","c"] ["a"] [] ["a",","] ["a","b"] ["a","b"] []
empty input: [][""][][]
captures: ["a","1",null,"b"] ["a","1","b"] ["a","b",null,"c"]
edges: ["","a",""] ["a","b","c"] ["ab"] ["a","😀"] ["a","c"]
sticky separator: ["x","y",""] ["","","a"]
matchAll iterator: 2b@3:b 3@5:undefined orig.lastIndex=2 [object RegExp String Iterator] {"done":true}
matchAll non-global stops: a,true,true
matchAll species and flags: b1,b3 g
matchAll string arg: 0,1,2,3,4 2
match non-global groups: kv k=v null
match global resets: ["o","o"] 0 null
search: 1,2,2,0,0,3
