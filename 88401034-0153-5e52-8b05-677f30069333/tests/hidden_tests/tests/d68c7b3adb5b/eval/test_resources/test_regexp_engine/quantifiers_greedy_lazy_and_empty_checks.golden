/(?:()|a)+b/                       "aab"            ["aab",null]@0
/a+b/                              "aaaaaaaaaaaaaaaaaaaaaaaa...aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"]@0
/(?:ab)*c/                         "abababc"        ["abababc"]@0
/(?:a|b){2,4}/                     "ababab"         ["abab"]@0
