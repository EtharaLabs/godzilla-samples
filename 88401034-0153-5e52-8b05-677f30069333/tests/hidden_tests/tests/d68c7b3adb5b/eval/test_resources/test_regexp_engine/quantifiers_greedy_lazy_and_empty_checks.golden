/<(.+?)>/                          "<a><b>"         ["<a>","a"]@0
/<(.+)>/                           "<a><b>"         ["<a><b>","a><b"]@0
/x*?$/                             "xx"             ["xx"]@0
/\d{3,5}/                          "12345678"       ["12345"]@0
/\d{3,5}?/                         "12345678"       ["123"]@0
/(?:ab){2}/                        "ababab"         ["abab"]@0
/(?:ab){2,}?/                      "ababab"         ["abab"]@0
/(ab|a){0,2}c/                     "abac"           ["abac","a"]@0
/(?:a{2}){2}/                      "aaaaa"          ["aaaa"]@0
/a{0}/                             "a"              [""]@0
/(a){0}/                           "a"              ["",null]@0
/a{1,1}b/                          "aab"            ["ab"]@1
/.{0,100000}/                      "abc"            ["abc"]@0
/a{2147483647,}/                   "aaa"            null
/x{9007199254740991}/              "x"              null
/[a-c]{2,}?d/                      "abcabd"         ["abcabd"]@0
/(?:x|y){3}?/                      "xyxy"           ["xyx"]@0
/(?:(?:a)|(?:b))*?c/               "ababc"          ["ababc"]@0
/(a|b)*?c/                         "abac"           ["abac","a"]@0
/(?:a*?)*?b/                       "aab"            ["aab"]@0
/(?:a?)+?b/                        "ab"             ["ab"]@0
/(a?)??b/                          "ab"             ["ab","a"]@0
/((a)|b)+/                         "ab"             ["ab","b",null]@0
/(z)((a+)?(b+)?(c))*/              "zaacbbbcac"     ["zaacbbbcac","z","ac","a",null,"c"]@0
/(a*)*/                            "b"              ["",null]@0
/(a*)+/                            "b"              ["",""]@0
/(?:a|)*b/                         "aab"            ["aab"]@0
/(a|ab)(c|bcd)(d*)/                "abcd"           ["abcd","a","bcd",""]@0
/^(?:(a)|b)*$/                     "ab"             ["ab",null]@0
/(a|b)*/                           "abab"           ["abab","b"]@0
/(?:(a)|b){2}/                     "ab"             ["ab",null]@0
/(?:(a)|(b)){1,2}?c/               "abc"            ["abc",null,"b"]@0
/([ab]){3}/                        "abba"           ["abb","b"]@0
/(?:a(b)?)+/                       "aba"            ["aba",null]@0
