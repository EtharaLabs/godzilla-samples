simple     "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 61\r\nConnection: close\r\n\r\nGET example.test /a?b=1 [] {host=example.test;x-thing=spaced}"
post       "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 55\r\nConnection: close\r\n\r\nPOST h /submit [hello world] {content-length=11;host=h}"
chunked    "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 54\r\nConnection: close\r\n\r\nPUT h /up [abcdefg] {host=h;transfer-encoding=chunked}"
absolute   "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 46\r\nConnection: close\r\n\r\nGET proxy.example /full/path?q [] {host=other}"
asterisk   "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 24\r\nConnection: close\r\n\r\nOPTIONS h /* [] {host=h}"
no-host    "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 22\r\nConnection: close\r\n\r\nGET SELF /nohost [] {}"
no-body    "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 27\r\nConnection: close\r\n\r\nDELETE h /thing [] {host=h}"
malformed  "HTTP/1.1 400 Bad Request\r\nContent-Length: 22\r\nConnection: close\r\n\r\nmalformed request line"
bad chunk  "HTTP/1.1 400 Bad Request\r\nContent-Length: 41\r\nConnection: close\r\n\r\nchunked body: bad chunk size \"nothex\\r\\n\""
empty      "HTTP/1.1 400 Bad Request\r\nContent-Length: 13\r\nConnection: close\r\n\r\nempty request"
cut head   "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 42\r\nConnection: close\r\n\r\nGET h /cut-short [] {host=h;x-partial=yes}"
after 400  "HTTP/1.1 200 OK\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nx-extra: 1\r\nContent-Length: 32\r\nConnection: close\r\n\r\nGET h /still-serving [] {host=h}"
fixed len  "HTTP/1.1 200 OK\r\ncontent-length: 3\r\ncontent-type: text/plain;charset=UTF-8\r\nserver: raw-test\r\nConnection: close\r\n\r\nabc"
